s=Path('out/src');p=s/'gen_pass5.py';t=p.read_text();t=t.replace("    box(p,'SandBlock',(0,(sy-RELIEF)/2,0),(sx,sy-RELIEF,sz))", """    if e['collidable']:
        box(p,'SandBlock',(0,(sy-RELIEF)/2,0),(sx,sy-RELIEF,sz))
