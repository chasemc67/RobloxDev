----------------------------------------------------------------------------- helpers
local function mk(class, props, parent)
	local inst = Instance.new(class)
	assert(not inst:IsA("LuaSourceContainer"), "R7: this importer must never create a script")
	for k, v in props do inst[k] = v end
	inst.Parent = parent
	return inst
end
local function c3(t) return Color3.fromRGB(t[1], t[2], t[3]) end

----------------------------------------------------------------------------- 1. terrain
local function decodeBlob(chunks)
	local enc = game:GetService("EncodingService")
	local raw = enc:Base64Decode(buffer.fromstring(table.concat(chunks)))
	return enc:DecompressBuffer(raw, Enum.CompressionAlgorithm.Zstd)
end

local MATS = {
	[1] = Enum.Material.Sand, [2] = Enum.Material.LeafyGrass, [3] = Enum.Material.Rock, [4] = Enum.Material.Slate,
	[5] = Enum.Material.Ground, [6] = Enum.Material.Grass, [7] = Enum.Material.Mud,
}
local MAT_COLORS = {
	[Enum.Material.Sand] = {226, 184, 128}, [Enum.Material.LeafyGrass] = {106, 150, 62}, [Enum.Material.Rock] = {158, 148, 116},
	[Enum.Material.Slate] = {132, 128, 110}, [Enum.Material.Ground] = {172, 142, 88}, [Enum.Material.Grass] = {120, 156, 60}, [Enum.Material.Mud] = {110, 80, 55},
}

local function stepTerrain()
	local hbuf = decodeBlob(HEIGHT_Z)
	local mbuf = decodeBlob(MATERIAL_Z)
	local q, hmin, hmax = W.height.quant, W.height.minStuds, W.height.maxStuds
	-- decode heights into a flat table of studs (row-major, z rows)
	local H = table.create(GW * GH)
	for iz = 0, GH - 1 do
		local acc = 0
		for ix = 0, GW - 1 do
			acc += buffer.readi16(hbuf, (iz * GW + ix) * 2)
			H[iz * GW + ix + 1] = hmin + (acc * q) / 65535 * (hmax - hmin)
		end
	end
	for mat, col in MAT_COLORS do Terrain:SetMaterialColor(mat, c3(col)) end
	-- (v9: left as set in Studio) Terrain.WaterColor = c3(LIGHTING.Terrain.WaterColor)
	-- (v9: left as set in Studio) Terrain.WaterTransparency = LIGHTING.Terrain.WaterTransparency
	-- (v9: left as set in Studio) Terrain.WaterReflectance = LIGHTING.Terrain.WaterReflectance

	local CH = 64                       -- cells per chunk side
	local CX, CZ = GW // CH, GH // CH   -- 16 x 10
	local start = Terrain:GetAttribute("BlockoutChunk") or 1
	if CFG.restartTerrain then start = 1 end
	local t0 = os.clock()
	local EPS = 1 / 256
	local AIR = Enum.Material.Air
	local total = CX * CZ
	for chunk = start, total do
		if os.clock() - t0 > CFG.budgetSeconds then
			Terrain:SetAttribute("BlockoutChunk", chunk)
			print(("TERRAIN paused at chunk %d/%d - run the script again to resume"):format(chunk, total))
			return false
		end
		local cx, cz = (chunk - 1) % CX, (chunk - 1) // CX
		local sm, so, lo = table.create(CH), table.create(CH), table.create(CH)
		for i = 1, CH do
			local gx = cx * CH + i - 1
			local smx, sox, lox = table.create(LAYERS), table.create(LAYERS), table.create(LAYERS)
			for k = 1, LAYERS do smx[k] = table.create(CH, AIR); sox[k] = table.create(CH, 0); lox[k] = table.create(CH, 0) end
			for j = 1, CH do
				local gz = cz * CH + j - 1
				local idx = gz * GW + gx
				local h = H[idx + 1]
				local mat = MATS[buffer.readu8(mbuf, idx)] or Enum.Material.Sand
				for k = 1, LAYERS do
					local bottom = MINY + 4 * (k - 1)
					local occ = (h - bottom) / 4
					if occ >= EPS then
						if occ > 1 - EPS then occ = 1 end
						sox[k][j] = occ
						smx[k][j] = (h - (bottom + 4) > 8) and Enum.Material.Rock or mat
					elseif bottom + 4 <= W.waterLevelY then
						lox[k][j] = 1
					end
				end
			end
			sm[i], so[i], lo[i] = smx, sox, lox
		end
		local rx, rz = X0 + cx * CH * CELL, Z0 + cz * CH * CELL
		local region = Region3.new(Vector3.new(rx, MINY, rz), Vector3.new(rx + CH * CELL, MINY + LAYERS * 4, rz + CH * CELL))
		Terrain:WriteVoxelChannels(region, 4, { SolidMaterial = sm, SolidOccupancy = so, LiquidOccupancy = lo })
		if chunk % 8 == 0 then task.wait() end
	end
	-- (no terrain pool: the cave mesh carries its own waterfall pool tub)
	Terrain:SetAttribute("BlockoutChunk", nil)
	Terrain:SetAttribute("BlockoutTerrainSource", "generated only")
	print("TERRAIN DONE")
	return true
end

----------------------------------------------------------------------------- 2. parts
local function stepParts()
	local world = Workspace:FindFirstChild("World")
	if not world then world = mk("Folder", { Name = "World" }, Workspace) end
	local old = world:FindFirstChild("Blockout")
	if old then old:Destroy() end
	local root = mk("Folder", { Name = "Blockout" }, world)
	root:SetAttribute("Blockout", true)
	local function folder(n) return mk("Folder", { Name = n }, root) end
	local function part(parent, name, size, cf, color, material, extra)
		local p = mk("Part", {
			Name = name, Size = size, CFrame = cf, Color = color, Material = material or Enum.Material.SmoothPlastic,
			Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = true,
			TopSurface = Enum.SurfaceType.Smooth, BottomSurface = Enum.SurfaceType.Smooth,
		}, parent)
		if extra then for k, v in extra do p[k] = v end end
		p:SetAttribute("Blockout", true)
		return p
	end
	local P = PLACEMENTS
	local RULES = P.padRules
	local WOOD, SLATE, FELT = c3(RULES.rimWood), c3(RULES.rimSlate), c3(RULES.feltColor)
	local lightColor = c3(RULES.padLight.color)

	-- pads
	local padsF = folder("Pads")
	for _, p in P.pads do
		local m = mk("Model", { Name = p.id }, padsF)
		local cf = CFrame.new(p.pos[1], p.pos[2], p.pos[3]) * CFrame.Angles(0, math.rad(p.yawDeg), 0)
		local rimColor = p.rim == "dark_wood" and WOOD or SLATE
		local rimMat = p.rim == "dark_wood" and Enum.Material.WoodPlanks or Enum.Material.Slate
		local fw, fl, rw = p.feltSize[1], p.feltSize[2], p.rimWidth
		local ow, ol = p.outerSize[1], p.outerSize[2]
		part(m, "Base", Vector3.new(ow, 2, ol), cf * CFrame.new(0, -1.2, 0), rimColor, rimMat)
		part(m, "Felt", Vector3.new(fw, 0.4, fl), cf * CFrame.new(0, -0.2, 0), FELT, Enum.Material.SmoothPlastic, { Reflectance = 0 })
		part(m, "RimW", Vector3.new(rw, 1, ol), cf * CFrame.new(-(fw / 2 + rw / 2), 0, 0), rimColor, rimMat)
		part(m, "RimE", Vector3.new(rw, 1, ol), cf * CFrame.new(fw / 2 + rw / 2, 0, 0), rimColor, rimMat)
		part(m, "RimN", Vector3.new(fw, 1, rw), cf * CFrame.new(0, 0, fl / 2 + rw / 2), rimColor, rimMat)
		part(m, "RimS", Vector3.new(fw, 1, rw), cf * CFrame.new(0, 0, -(fl / 2 + rw / 2)), rimColor, rimMat)
		for i, dz in { -fl * 0.25, fl * 0.25 } do
			local a = part(m, "LightAnchor" .. i, Vector3.new(1, 1, 1), cf * CFrame.new(0, 8, dz), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, { Transparency = 1, CastShadow = false })
			mk("PointLight", { Range = RULES.padLight.range, Brightness = RULES.padLight.brightness, Color = lightColor, Shadows = false }, a)
		end
		local XL = RULES.extraSoftLights
		for _, pn in XL.pads do
			if pn == p.n then
				for i, dz in { -fl * 0.25, fl * 0.25 } do
					local a = part(m, "SoftLightAnchor" .. i, Vector3.new(1, 1, 1), cf * CFrame.new(0, XL.height, dz), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, { Transparency = 1, CastShadow = false })
					mk("PointLight", { Name = "SoftPadLight", Range = XL.range, Brightness = XL.brightness, Color = c3(XL.color), Shadows = false }, a)
				end
			end
		end
		m:SetAttribute("Blockout", true); m:SetAttribute("Pad", p.n); m:SetAttribute("FeltTopY", p.pos[2])
		m:SetAttribute("Zone", p.zone); m:SetAttribute("ArtClearX", p.artClearSize[1]); m:SetAttribute("ArtClearZ", p.artClearSize[2])
	end

	-- rest stops
	local restF = folder("RestStops")
	for _, r in P.restStops do
		local isSlate = r.pos[2] > 30
		local pr = part(restF, r.id, Vector3.new(r.size[1], 1, r.size[2]), CFrame.new(r.pos[1], r.pos[2] - 0.5, r.pos[3]),
			isSlate and SLATE or c3({150, 105, 70}), isSlate and Enum.Material.Slate or Enum.Material.Ground)
		pr:SetAttribute("Gag", r.gag)
	end

	-- hero meshes: stand-ins + footprint boxes (CFG.standIns). The real wreck_v2 / cave_v1 meshes replace them.
	local heroF = folder("HeroStandIns")
	local wreck, cliff = P.heroMeshes[1], P.heroMeshes[2]
	if CFG.standIns then
	do
		local f = wreck.footprint
		local L, Wd, hullH = f.length, f.width, f.hullHeight
		local deckY = wreck.deckTopY
		-- wreck.centre is the mesh origin (local Z 0 = midship); the stern end is at local Z = sternLocalZ
		local cf = CFrame.new(wreck.centre[1], 0, wreck.centre[3]) * CFrame.Angles(0, math.rad(wreck.yawDeg), 0)
		local function at(s, y, x) return cf * CFrame.new(x or 0, y, wreck.sternLocalZ + s) end     -- s = studs from the stern end toward the bow
		local wm = mk("Model", { Name = "WreckStandIn" }, heroF)
		part(wm, "Hull", Vector3.new(Wd, hullH, L), at(L / 2, deckY - hullH / 2), c3({140, 90, 55}), Enum.Material.WoodPlanks)
		part(wm, "SternDeckFlat_Pad1", Vector3.new(54, 0.2, 84), at(50, deckY + 0.1), c3({84, 52, 34}), Enum.Material.WoodPlanks)
		local mastBase = deckY
		local mastTop = f.mastTipAboveWaterline
		local mastLen = mastTop - mastBase
		part(wm, "MainMast", Vector3.new(mastLen, 4, 4), at(210, mastBase + mastLen / 2) * CFrame.Angles(0, 0, math.pi / 2), c3({84, 52, 34}), Enum.Material.Wood, { Shape = Enum.PartType.Cylinder })
		part(wm, "MainSail", Vector3.new(50, 38, 1), at(210, mastBase + 62), c3({238, 222, 190}), Enum.Material.Fabric)
		part(wm, "MainSailRedPatch", Vector3.new(18, 14, 1.2), at(210, mastBase + 58), c3({196, 60, 50}), Enum.Material.Fabric)
		part(wm, "ForeMastSnapped", Vector3.new(52, 3.5, 3.5), at(250, mastBase + 26) * CFrame.Angles(0, 0, math.pi / 2), c3({84, 52, 34}), Enum.Material.Wood, { Shape = Enum.PartType.Cylinder })
		part(wm, "Cabin", Vector3.new(40, 22, 23), at(116, deckY + 11), c3({140, 90, 55}), Enum.Material.WoodPlanks)
		part(wm, "DuckFigurehead", Vector3.new(22, 30, 22), at(L - 8, deckY + 14, 0), c3({255, 205, 40}), Enum.Material.SmoothPlastic)
		local fb = part(heroF, "FOOTPRINT_wreck", Vector3.new(Wd, mastTop + hullH - (deckY - 0) + 0, L),
			cf * CFrame.new(0, (mastTop + (deckY - hullH)) / 2, wreck.sternLocalZ + L / 2), c3({255, 255, 255}), Enum.Material.SmoothPlastic, { Transparency = 0.9, CastShadow = false })
		fb:SetAttribute("Meaning", "Hero 1 bounding box: width x height x length (studs). Local +Z = bow (duck), stern = -Z, pad 1 deck centre is 50 studs in from the stern.")
		fb:SetAttribute("Width", Wd); fb:SetAttribute("Length", L); fb:SetAttribute("HullHeight", hullH); fb:SetAttribute("MastTipAboveWaterline", mastTop)
	end
	do
		local f = cliff.footprint
		local cf = CFrame.new(cliff.centre[1], cliff.baseY + f.height / 2, cliff.centre[3])
		local cm = mk("Model", { Name = "CaveCliffStandIn" }, heroF)
		part(cm, "CliffBlock", Vector3.new(f.width, f.height, f.depth), cf, c3({110, 92, 120}), Enum.Material.Rock)
		local fz = cliff.frontFaceZ
		part(cm, "CaveMouth", Vector3.new(cliff.mouth.width, cliff.mouth.height, 3), CFrame.new(cliff.mouth.centreX, cliff.mouth.floorY + cliff.mouth.height / 2, fz + 1.6), c3({25, 18, 30}), Enum.Material.SmoothPlastic)
		local lamp = part(cm, "MouthLanternAnchor", Vector3.new(1, 1, 1), CFrame.new(cliff.mouth.centreX, cliff.mouth.floorY + 10, fz + 10), c3({255, 190, 80}), Enum.Material.Neon, { CastShadow = false })
		mk("PointLight", { Range = LIGHTING.cliffMouthLight.Range, Brightness = 1.5, Color = c3(LIGHTING.cliffMouthLight.Color), Shadows = false }, lamp)
		local fb = part(heroF, "FOOTPRINT_cave_cliff", Vector3.new(f.width, f.height, f.depth), cf, c3({255, 255, 255}), Enum.Material.SmoothPlastic, { Transparency = 0.9, CastShadow = false })
		fb:SetAttribute("Meaning", "Hero 2 bounding box: width x height x depth (studs). Front face (cave mouth, stairs) faces +Z, base Y = " .. cliff.baseY)
		fb:SetAttribute("Width", f.width); fb:SetAttribute("Height", f.height); fb:SetAttribute("Depth", f.depth)
	end
	end

	-- hero prop footprints (placeholders for 3D Model Bot)
	local propF = folder("HeroPropFootprints")
	for _, pr in P.heroProps do
		local fp = pr.footprint
		local cf = CFrame.new(pr.anchor[1], pr.anchor[2] + fp.height / 2, pr.anchor[3]) * CFrame.Angles(0, math.rad(pr.yawDeg), 0)
		local b = part(propF, pr.id, Vector3.new(fp.x, fp.height, fp.z), cf, c3({255, 120, 200}), Enum.Material.SmoothPlastic, { Transparency = 0.5 })
		b:SetAttribute("Name", pr.name); b:SetAttribute("Where", pr.where); b:SetAttribute("Source", pr.source)
	end
	print("PARTS DONE: Workspace.World.Blockout")
end

----------------------------------------------------------------------------- 3. lighting
local function stepLighting()
	local L = LIGHTING
	for k, v in L.Lighting do
		if typeof(v) == "table" then Lighting[k] = c3(v) else Lighting[k] = v end
	end
	local function ensure(parent, class)
		local x = parent:FindFirstChildOfClass(class)
		if not x then x = mk(class, {}, parent) end
		return x
	end
	local a = ensure(Lighting, "Atmosphere")
	for k, v in L.Atmosphere do a[k] = (typeof(v) == "table") and c3(v) or v end
	local b = ensure(Lighting, "BloomEffect")
	for k, v in L.BloomEffect do b[k] = v end
	local cc = ensure(Lighting, "ColorCorrectionEffect")
	cc.Saturation = L.ColorCorrectionEffect.Saturation; cc.Contrast = L.ColorCorrectionEffect.Contrast; cc.TintColor = c3(L.ColorCorrectionEffect.TintColor)
	local sr = ensure(Lighting, "SunRaysEffect")
	sr.Intensity = L.SunRaysEffect.Intensity; sr.Spread = L.SunRaysEffect.Spread
	local dof = ensure(Lighting, "DepthOfFieldEffect"); dof.Enabled = false
	local cl = ensure(Terrain, "Clouds")
	cl.Cover = L.Clouds.Cover; cl.Density = L.Clouds.Density; cl.Color = c3(L.Clouds.Color)
	print(("LIGHTING DONE. Sun direction at ClockTime %.1f: %s (check pads 1-2 are not in the wreck's shadow)"):format(Lighting.ClockTime, tostring(Lighting:GetSunDirection())))
end

----------------------------------------------------------------------------- run
if CFG.parts then stepParts() end
if CFG.lighting then stepLighting() end
if CFG.terrain then
	local done = stepTerrain()
	print(done and "ALL DONE" or "RESUME: run this script again")
end
