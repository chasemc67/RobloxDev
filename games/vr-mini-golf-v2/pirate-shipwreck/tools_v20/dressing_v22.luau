				rp.Material = Enum.Material.Fabric; rp.Color = Color3.fromRGB(190, 160, 105); rp.Size = Vector3.new(0.25, 0.25, (tops[2] - tops[1]).Magnitude); rp.CFrame = CFrame.lookAt((tops[1] + tops[2]) / 2, tops[2]); rp.Parent = wf
			end
