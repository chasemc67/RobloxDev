 BasePart\n\tself.hum = model:WaitForChild(\"Humanoid\") :: Humanoid\n\tself.align = self.root:WaitForChild(\"FaceAlign\") :: AlignOrientation\n\tself.legs = legs\n\tself.moveInput = Vector3.zero\n\tself.airJumpsLeft = legs.AirJumps\n\tself.airDashesLeft = legs.AirDashes\n\tself.hoverLeft = legs.Hover or 0\n\tself.jumpHeld = false\n\tself.override = nil\n\tself.slowMul = 1\n\tself.slowUntil = 0\n\tself.chargeMul = 1\n\tself.locked = false\n\tself.dashReadyAt = 0\n\tself.lastJumpAt = 0\n\tself.faceDir = self.root.CFrame.LookVector\n\tself.getFacePos = nil :: (() -> Vector3?)?\n\n\tlocal hum = self.hum\n\thum.AutoRotate = false\n\thum.UseJumpPower = true\n\thum.JumpPower = legs.JumpPower\n\thum.WalkSpeed = legs.WalkSpeed\n\tfor _, st in ipairs(DISABLED_STATES) do\n\t\thum:SetStateEnabled(st, false)\n\tend\n\treturn self\nend\n\nfunction Mover:IsGrounded(): boolean\n\treturn self.hum.FloorMaterial ~= Enum.Material.Air\nend\n\nfunction Mover:SetLocked(locked: boolean)\n\tself.locked = locked\n\tif locked then\n\t\tself.override = nil\n\t\tself.hum:Move(Vector3.zero, false)\n\tend\nend\n\nfunction Mover:Slow(mul: number, duration: number)\n\tlocal now = os.clock()\n\tif now + duration > self.slowUntil or mul < self.slowMul then\n\t\tself.slowMul = mul\n\t\tself.slowUntil = now + duration\n\tend\nend\n\nfunction Mover:_startOverride(dir: Vector3, speed: number, duration: number, opts)\n\tself.override = {\n\t\tdir = dir,\n\t\tspeed = speed,\n\t\tt0 = os.clock(),\n\t\tdur = duration,\n\t\tdecay = opts and opts.decay or false,\n\t\tholdY = opts and opts.holdY or false,\n\t\tkind = opts and opts.kind or \"dash\",\n\t}\nend\n\nfunction Mover:IsDashing(): boolean\n\tlocal o = self.override\n\treturn o ~= nil and (o.kind == \"dash\" or o.kind == \"airdash\")\nend\n\nfunction Mover:_dashDir(): Vector3\n\tif self.moveInput.Magnitude > 0.2 then\n\t\treturn Util.flatUnit(self.moveInput)\n\tend\n\treturn Util.flatUnit(self.root.CFrame.LookVector)\nend\n\n-- Returns \"dash\" | \"airdash\" | nil\nfunction Mover:Dash(): string?\n\tif self.locked then\n\t\treturn nil\n\tend\n\tlocal now = os.clock()\n\tif not self:IsGrounded() then\n\t\treturn self:AirDash()\n\tend\n\tif now < self.dashReadyAt then\n\t\treturn nil\n\tend\n\tself.dashReadyAt = now + self.legs.DashCooldown\n\tself:_startOverride(self:_dashDir(), self.legs.DashSpeed, self.legs.DashTime, { kind = \"dash\" })\n\treturn \"dash\"\nend\n\nfunction Mover:AirDash(): string?\n\tif self.locked or self.airDashesLeft <= 0 then\n\t\treturn nil\n\tend\n\tself.airDashesLeft -= 1\n\tself:_startOverride(self:_dashDir(), self.legs.AirDashSpeed, self.legs.AirDashTime, { kind = \"airdash\", holdY = true })\n\treturn \"airdash\"\nend\n\n-- Returns \"jump\" | \"airjump\" | \"airdash\" | nil\nfunction Mover:Jump(): string?\n\tif self.locked then\n\t\treturn nil\n\tend\n\tlocal now = os.clock()\n\tif self:IsGrounded() and now - self.lastJumpAt > 0.15 then\n\t\tself.lastJumpAt = now\n\t\tself.hum.Jump = true\n\t\tself.hum:ChangeState(Enum.HumanoidStateType.Jumping)\n\t\tself.airJumpsLeft = self.legs.AirJumps\n\t\tself.airDashesLeft = self.legs.AirDashes\n\t\tself.hoverLeft = self.legs.Hover or 0\n\t\treturn \"jump\"\n\tend\n\tif self.airJumpsLeft > 0 then\n\t\tself.airJumpsLeft -= 1\n\t\tself.lastJumpAt = now\n\t\tlocal v = self.root.AssemblyLinearVelocity\n\t\tself.root.AssemblyLinearVelocity = Vector3.new(v.X, self.legs.JumpPower * 0.95, v.Z)\n\t\treturn \"airjump\"\n\tend\n\tif (self.legs.Hover or 0) > 0 then\n\t\treturn nil -- hover legs: holding jump handles it in Step\n\tend\n\treturn self:AirDash()\nend\n\n-- vel: horizontal knockback velocity; up: vertical pop.\nfunction Mover:Knockback(vel: Vector3, up: number, duration: number)\n\tlocal flat = Util.flat(vel)\n\tif flat.Magnitude > 0.5 then\n\t\tself:_startOverride(flat.Unit, flat.Magnitude, duration, { kind = \"knock\", decay = true })\n\tend\n\tif up > 0 then\n\t\tlocal v = self.root.AssemblyLinearVelocity\n\t\tself.hum:ChangeState(Enum.HumanoidStateType.Freefall)\n\t\tself.root.AssemblyLinearVelocity = Vector3.new(v.X, up, v.Z)\n\tend\nend\n\nfunction Mover:ResetVelocity()\n\tself.override = nil\n\tself.root.AssemblyLinearVelocity = Vector3.zero\nend\n\nfunction Mover:Step(_dt: number)\n\tlocal hum, root = self.hum, self.root\n\tlocal now = os.clock()\n\tlocal grounded = self:IsGrounded()\n\n\tif grounded and now - self.lastJumpAt > 0.2 then\n\t\tself.airJumpsLeft = self.legs.AirJumps\n\t\tself.airDashesLeft = self.legs.AirDashes\n\t\tself.hoverLeft = self.legs.Hover or 0\n\tend\n\n\tlocal o = self.override\n\tif o and now >= o.t0 + o.dur then\n\t\tself.override = nil\n\t\to = nil\n\tend\n\n\tif self.locked and not (o and o.kind == \"knock\") then\n\t\thum.WalkSpeed = 0\n\t\thum:Move(Vector3.zero, false)\n\telseif o then\n\t\tlocal a = (now - o.t0) / o.dur\n\t\tlocal spd = o.speed\n\t\tif o.decay then\n\t\t\tspd *= (1 - a * 0.75)\n\t\tend\n\t\thum.WalkSpeed = spd\n\t\thum:Move(o.dir, false)\n\t\tif o.holdY then\n\t\t\troot.AssemblyLinearVelocity = Vector3.new(o.dir.X * spd, 0, o.dir.Z * spd)\n\t\tend\n\telse\n\t\tlocal mul = self.chargeMul\n\t\tif now < self.slowUntil then\n\t\t\tmul *= self.slowMul\n\t\tend\n\t\thum.WalkSpeed = self.legs.WalkSpeed * mul\n\t\thum:Move(self.moveInput, false)\n\tend\n\n\t-- Hover legs: hold jump while falling to float.\n\tif self.jumpHeld and not grounded and not self.locked and self.hoverLeft > 0 then\n\t\tlocal v = root.AssemblyLinearVelocity\n\t\tlocal maxFall = self.legs.HoverFall or 3\n\t\tif v.Y < -maxFall then\n\t\t\troot.AssemblyLinearVelocity = Vector3.new(v.X, -maxFall, v.Z)\n\t\t\tself.hoverLeft -= _dt\n\t\t\tself.hovering = true\n\t\telse\n\t\t\tself.hovering = false\n\t\tend\n\telse\n\t\tself.hovering = false\n\tend\n\n\t-- Facing: lock-on toward the target, else toward movement.\n\tlocal facePos = self.getFacePos and self.getFacePos()\n\tlocal dir\n\tif facePos then\n\t\tdir = Util.flat(facePos - root.Position)\n\telseif self.moveInput.Magnitude > 0.1 then\n\t\tdir = Util.flat(self.moveInput)\n\tend\n\tif dir and dir.Magnitude > 0.05 then\n\t\tself.faceDir = dir.Unit\n\tend\n\tself.align.CFrame = CFrame.lookAt(Vector3.zero, self.faceDir)\nend\n\nreturn Mover\n","message":"Wrote contents to /Users/chase-mini/src/rca-work/src/ReplicatedStorage/RoboClash/Shared/Mover.luau"}}},"hookAdditionalContexts":[],"toolCallId":"toolu_016MsGckD2nncZrCfJU7e2tR","startedAtMs":"1791073300250","completedAtMs":"1791073319341"},"model_call_id":"f6f75537-51d9-46fb-a6c9-81f06ac674d8-25-7zdx","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791073319373}
