bots) do\n\tr.Index = i\n\tConfig.RobotById[r.Id] = r\nend\n\nfunction Config.GetLoadout(robotId)\n\tlocal r = Config.RobotById[robotId] or Config.Robots[1]\n\treturn {\n\t\tRobot = r,\n\t\tBody = Config.Bodies[r.Body],\n\t\tGun = Config.Guns[r.Gun],\n\t\tBomb = Config.Bombs[r.Bomb],\n\t\tPod = Config.Pods[r.Pod],\n\t\tLegs = Config.Legs[r.Legs],\n\t}\nend\n\n-- Sound ids (rbxassetid). Filled in from Creator Store / Roblox official audio.\nConfig.Sounds = {\n\tBlaster = \"\",","isEmpty":false,"exceededLimit":false,"totalLines":423,"fileSize":8901,"path":"/Users/chase-mini/src/rca-work/src/ReplicatedStorage/RoboClash/Config.luau","readRange":{"startLine":325,"endLine":399},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"toolu_01Jufg5trSwVPTPiWmdSZVdU","startedAtMs":"1791074629327","completedAtMs":"1791074629960"},"model_call_id":"f6f75537-51d9-46fb-a6c9-81f06ac674d8-73-mruj","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791074629989}
