local c1 = p1 + d1 * s\n\tlocal c2 = p2 + d2 * t\n\treturn (c1 - c2).Magnitude\nend\n\nfunction Util.lerp(a: number, b: number, t: number): number\n\treturn a + (b - a) * t\nend\n\nfunction Util.fmtTime(sec: number): string\n\tsec = math.max(0, math.ceil(sec))\n\treturn string.format(\"%d:%02d\", sec // 60, sec % 60)\nend\n\nreturn Util\n"},"result":{"success":{"path":"/Users/chase-mini/src/rca-work/src/ReplicatedStorage/RoboClash/Shared/Util.luau","linesAdded":84,"linesRemoved":0,"diffString":"--- /dev/null\n+++ b//Users/chase-mini/src/rca-work/src/ReplicatedStorage/RoboClash/Shared/Util.luau\n@@ -1,0 +1,84 @@\n+local Util = {}\n+\n+function Util.flat(v: Vector3): Vector3\n+\treturn Vector3.new(v.X, 0, v.Z)\n+end\n+\n+function Util.flatUnit(v: Vector3, fallback: Vector3?): Vector3\n+\tlocal f = Vector3.new(v.X, 0, v.Z)\n+\tif f.Magnitude < 1e-4 then\n+\t\treturn fallback or Vector3.new(0, 0, -1)\n+\tend\n+\treturn f.Unit\n+end\n+\n+-- Rotate unit vector `from` toward unit vector `to` by at most maxAngle radians.\n+function Util.rotateTowards(from: Vector3, to: Vector3, maxAngle: number): Vector3\n+\tlocal d = math.clamp(from:Dot(to), -1, 1)\n+\tlocal angle = math.acos(d)\n+\tif angle <= maxAngle or angle < 1e-5 then\n+\t\treturn to\n+\tend\n+\tlocal axis = from:Cross(to)\n+\tif axis.Magnitude < 1e-5 then\n+\t\taxis = Vector3.yAxis\n+\telse\n+\t\taxis = axis.Unit\n+\tend\n+\treturn (CFrame.fromAxisAngle(axis, maxAngle) * from).Unit\n+end\n+\n+-- Closest distance between segments p1-q1 and p2-q2.\n+function Util.segSegDist(p1: Vector3, q1: Vector3, p2: Vector3, q2: Vector3): number\n+\tlocal d1 = q1 - p1\n+\tlocal d2 = q2 - p2\n+\tlocal r = p1 - p2\n+\tlocal a = d1:Dot(d1)\n+\tlocal e = d2:Dot(d2)\n+\tlocal f = d2:Dot(r)\n+\tlocal s, t\n+\tlocal eps = 1e-6\n+\tif a <= eps and e <= eps then\n+\t\treturn (p1 - p2).Magnitude\n+\tend\n+\tif a <= eps then\n+\t\ts = 0\n+\t\tt = math.clamp(f / e, 0, 1)\n+\telse\n+\t\tlocal c = d1:Dot(r)\n+\t\tif e <= eps then\n+\t\t\tt = 0\n+\t\t\ts = math.clamp(-c / a, 0, 1)\n+\t\telse\n+\t\t\tlocal b = d1:Dot(d2)\n+\t\t\tlocal denom = a * e - b * b\n+\t\t\tif denom ~= 0 then\n+\t\t\t\ts = math.clamp((b * f - c * e) / denom, 0, 1)\n+\t\t\telse\n+\t\t\t\ts = 0\n+\t\t\tend\n+\t\t\tt = (b * s + f) / e\n+\t\t\tif t < 0 then\n+\t\t\t\tt = 0\n+\t\t\t\ts = math.clamp(-c / a, 0, 1)\n+\t\t\telseif t > 1 then\n+\t\t\t\tt = 1\n+\t\t\t\ts = math.clamp((b - c) / a, 0, 1)\n+\t\t\tend\n+\t\tend\n+\tend\n+\tlocal c1 = p1 + d1 * s\n+\tlocal c2 = p2 + d2 * t\n+\treturn (c1 - c2).Magnitude\n+end\n+\n+function Util.lerp(a: number, b: number, t: number): number\n+\treturn a + (b - a) * t\n+end\n+\n+function Util.fmtTime(sec: number): string\n+\tsec = math.max(0, math.ceil(sec))\n+\treturn string.format(\"%d:%02d\", sec // 60, sec % 60)\n+end\n+\n+return Util","afterFullFileContent":"local Util = {}\n\nfunction Util.flat(v: Vector3): Vector3\n\treturn Vector3.new(v.X, 0, v.Z)\nend\n\nfunction Util.flatUnit(v: Vector3, fallback: Vector3?): Vector3\n\tlocal f = Vector3.new(v.X, 0, v.Z)\n\tif f.Magnitude < 1e-4 then\n\t\treturn fallback or Vector3.new(0, 0, -1)\n\tend\n\treturn f.Unit\nend\n\n-- Rotate unit vector `from` toward unit vector `to` by at most maxAngle radians.\nfunction Util.rotateTowards(from: Vector3, to: Vector3, maxAngle: number): Vector3\n\tlocal d = math.clamp(from:Dot(to), -1, 1)\n\tlocal angle = math.acos(d)\n\tif angle <= maxAngle or angle < 1e-5 then\n\t\treturn to\n\tend\n\tlocal axis = from:Cross(to)\n\tif axis.Magnitude < 1e-5 then\n\t\taxis = Vector3.yAxis\n\telse\n\t\taxis = axis.Unit\n\tend\n\treturn (CFrame.fromAxisAngle(axis, maxAngle) * from).Unit\nend\n\n-- Closest distance between segments p1-q1 and p2-q2.\nfunction Util.segSegDist(p1: Vector3, q1: Vector3, p2: Vector3, q2: Vector3): number\n\tlocal d1 = q1 - p1\n\tlocal d2 = q2 - p2\n\tlocal r = p1 - p2\n\tlocal a = d1:Dot(d1)\n\tlocal e = d2:Dot(d2)\n\tlocal f = d2:Dot(r)\n\tlocal s, t\n\tlocal eps = 1e-6\n\tif a <= eps and e <= eps then\n\t\treturn (p1 - p2).Magnitude\n\tend\n\tif a <= eps then\n\t\ts = 0\n\t\tt = math.clamp(f / e, 0, 1)\n\telse\n\t\tlocal c = d1:Dot(r)\n\t\tif e <= eps then\n\t\t\tt = 0\n\t\t\ts = math.clamp(-c / a, 0, 1)\n\t\telse\n\t\t\tlocal b = d1:Dot(d2)\n\t\t\tlocal denom = a * e - b * b\n\t\t\tif denom ~= 0 then\n\t\t\t\ts = math.clamp((b * f - c * e) / denom, 0, 1)\n\t\t\telse\n\t\t\t\ts = 0\n\t\t\tend\n\t\t\tt = (b * s + f) / e\n\t\t\tif t < 0 then\n\t\t\t\tt = 0\n\t\t\t\ts = math.clamp(-c / a, 0, 1)\n\t\t\telseif t > 1 then\n\t\t\t\tt = 1\n\t\t\t\ts = math.clamp((b - c) / a, 0, 1)\n\t\t\tend\n\t\tend\n\tend\n\tlocal c1 = p1 + d1 * s\n\tlocal c2 = p2 + d2 * t\n\treturn (c1 - c2).Magnitude\nend\n\nfunction Util.lerp(a: number, b: number, t: number): number\n\treturn a + (b - a) * t\nend\n\nfunction Util.fmtTime(sec: number): string\n\tsec = math.max(0, math.ceil(sec))\n\treturn string.format(\"%d:%02d\", sec // 60, sec % 60)\nend\n\nreturn Util\n","message":"Wrote contents to /Users/chase-mini/src/rca-work/src/ReplicatedStorage/RoboClash/Shared/Util.luau"}}},"hookAdditionalContexts":[],"toolCallId":"toolu_0116ToXGk7HHv9nM4eHq4vTA","startedAtMs":"1791073259758","completedAtMs":"1791073267332"},"model_call_id":"f6f75537-51d9-46fb-a6c9-81f06ac674d8-23-srcz","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791073267364}
