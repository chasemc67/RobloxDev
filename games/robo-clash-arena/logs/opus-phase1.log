{"type":"tool_call","subtype":"started","call_id":"toolu_01JrVRzy9pTDG7LTC3tdp9hA","tool_call":{"editToolCall":{"args":{"path":"/Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/HUD.luau","streamContent":"\tannounce.TextSize = size\n\tlocal bandH = math.floor(size * 1.15)\n\tannounceBand.Visible = true\n\tannounceBand.Size = UDim2.new(1.4, 0, 0, 0)\n\tTweenService:Create(announceBand, TweenInfo.new(0.14, Enum.EasingStyle.Quad), { Size = UDim2.new(1.4, 0, 0, bandH) }):Play()\n\tif opts.hold ~= math.huge then\n\t\ttask.delay(opts.hold or 0.7, function()\n\t\t\tif announceSeq == seq then\n\t\t\t\tTweenService:Create(announce, TweenInfo.new(0.2), { TextTransparency = 1 }):Play()\n\t\t\t\tTweenService:Create(announce:FindFirstChildOfClass(\"UIStroke\"), TweenInfo.new(0.2), { Transparency = 1 }):Play()\n\t\t\t\tlocal close = TweenService:Create(announceBand, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { Size = UDim2.new(1.4, 0, 0, 0) })\n\t\t\t\tclose.Completed:Connect(function()\n\t\t\t\t\tif announceSeq == seq then\n\t\t\t\t\t\tannounceBand.Visible = false\n\t\t\t\t\tend\n\t\t\t\tend)\n\t\t\t\tclose:Play()\n\t\t\tend\n\t\tend)\n\tend\nend\n\nfunction HUD.ClearAnnounce()\n\tannounceSeq += 1\n\tannounce.TextTransparency = 1\n\t(announce:FindFirstChildOfClass(\"UIStroke\") :: UIStroke).Transparency = 1\n\tannounceBand.Visible = false\nend"}},"hookAdditionalContexts":[],"toolCallId":"toolu_01JrVRzy9pTDG7LTC3tdp9hA","startedAtMs":"1791075935664"},"model_call_id":"9f87d2a3-a097-4b92-978f-ec64b826b4ce-61-wccv","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791075941641}
{"type":"tool_call","subtype":"completed","call_id":"toolu_01JrVRzy9pTDG7LTC3tdp9hA","tool_call":{"editToolCall":{"args":{"path":"/Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/HUD.luau","streamContent":"\tannounce.TextSize = size\n\tlocal bandH = math.floor(size * 1.15)\n\tannounceBand.Visible = true\n\tannounceBand.Size = UDim2.new(1.4, 0, 0, 0)\n\tTweenService:Create(announceBand, TweenInfo.new(0.14, Enum.EasingStyle.Quad), { Size = UDim2.new(1.4, 0, 0, bandH) }):Play()\n\tif opts.hold ~= math.huge then\n\t\ttask.delay(opts.hold or 0.7, function()\n\t\t\tif announceSeq == seq then\n\t\t\t\tTweenService:Create(announce, TweenInfo.new(0.2), { TextTransparency = 1 }):Play()\n\t\t\t\tTweenService:Create(announce:FindFirstChildOfClass(\"UIStroke\"), TweenInfo.new(0.2), { Transparency = 1 }):Play()\n\t\t\t\tlocal close = TweenService:Create(announceBand, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { Size = UDim2.new(1.4, 0, 0, 0) })\n\t\t\t\tclose.Completed:Connect(function()\n\t\t\t\t\tif announceSeq == seq then\n\t\t\t\t\t\tannounceBand.Visible = false\n\t\t\t\t\tend\n\t\t\t\tend)\n\t\t\t\tclose:Play()\n\t\t\tend\n\t\tend)\n\tend\nend\n\nfunction HUD.ClearAnnounce()\n\tannounceSeq += 1\n\tannounce.TextTransparency = 1\n\t(announce:FindFirstChildOfClass(\"UIStroke\") :: UIStroke).Transparency = 1\n\tannounceBand.Visible = false\nend"},"result":{"success":{"path":"/Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/HUD.luau","linesAdded":12,"linesRemoved":0,"diffString":"--- a//Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/HUD.luau\n+++ b//Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/HUD.luau\n@@ -309,11 +309,22 @@\n \t\tTweenService:Create(sc, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()\n \tend\n \tannounce.TextSize = size\n+\tlocal bandH = math.floor(size * 1.15)\n+\tannounceBand.Visible = true\n+\tannounceBand.Size = UDim2.new(1.4, 0, 0, 0)\n+\tTweenService:Create(announceBand, TweenInfo.new(0.14, Enum.EasingStyle.Quad), { Size = UDim2.new(1.4, 0, 0, bandH) }):Play()\n \tif opts.hold ~= math.huge then\n \t\ttask.delay(opts.hold or 0.7, function()\n \t\t\tif announceSeq == seq then\n \t\t\t\tTweenService:Create(announce, TweenInfo.new(0.2), { TextTransparency = 1 }):Play()\n \t\t\t\tTweenService:Create(announce:FindFirstChildOfClass(\"UIStroke\"), TweenInfo.new(0.2), { Transparency = 1 }):Play()\n+\t\t\t\tlocal close = TweenService:Create(announceBand, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { Size = UDim2.new(1.4, 0, 0, 0) })\n+\t\t\t\tclose.Completed:Connect(function()\n+\t\t\t\t\tif announceSeq == seq then\n+\t\t\t\t\t\tannounceBand.Visible = false\n+\t\t\t\t\tend\n+\t\t\t\tend)\n+\t\t\t\tclose:Play()\n \t\t\tend\n \t\tend)\n \tend\n@@ -323,6 +334,7 @@\n \tannounceSeq += 1\n \tannounce.TextTransparency = 1\n \t(announce:FindFirstChildOfClass(\"UIStroke\") :: UIStroke).Transparency = 1\n+\tannounceBand.Visible = false\n end\n \n ----------------------------------------------------------------------------------------------","beforeFullFileContent":"-- Battle HUD: P-panels (local bottom-left, rivals bottom-right), timer, weapon chips, floating\n-- tags with HP + DOWN pips, lock-on reticle, HIT / DAMAGE popups, announcer text.\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal TweenService = game:GetService(\"TweenService\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"RoboClash\").Config)\nlocal Util = require(ReplicatedStorage.RoboClash.Shared.Util)\nlocal Style = require(script.Parent.Style)\nlocal State = require(script.Parent.State)\n\nlocal C = Style.C\nlocal HUD = {}\n\nlocal root: Frame\nlocal bgRoot: Frame\nlocal frame: Frame\nlocal timerLabel: TextLabel\nlocal announce: TextLabel\nlocal chipsFrame: Frame\nlocal chips = {}\nlocal panels = {}\nlocal tags = {}\nlocal reticle: Frame\nlocal reticleTarget: Model? = nil\nlocal vignette: Frame\nlocal worldRoot: Frame\nlocal getScale: () -> number\n\nlocal PIP_ON = Color3.fromRGB(255, 90, 170)\nlocal PIP_OFF = Color3.fromRGB(50, 40, 70)\nlocal ITALIC = Font.new(\"rbxasset://fonts/families/GothamSSm.json\", Enum.FontWeight.Heavy, Enum.FontStyle.Italic)\n\nlocal function teamColor(model: Model): Color3\n\tlocal idx = model:GetAttribute(\"Index\") or 1\n\treturn Config.TeamColors[idx] or C.Accent\nend\n\nlocal function makePips(parent: Instance, size: number, pos: UDim2, anchor: Vector2?)\n\tlocal holder = Style.new(\"Frame\", {\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(size * 3 + 12, size + 4),\n\t\tPosition = pos,\n\t\tAnchorPoint = anchor or Vector2.zero,\n\t\tParent = parent,\n\t})\n\tStyle.new(\"UIListLayout\", { SortOrder = Enum.SortOrder.LayoutOrder,\n\t\tFillDirection = Enum.FillDirection.Horizontal,\n\t\tPadding = UDim.new(0, 6),\n\t\tVerticalAlignment = Enum.VerticalAlignment.Center,\n\t\tParent = holder,\n\t})\n\tlocal pips = {}\n\tfor i = 1, 3 do\n\t\tlocal outer = Style.new(\"Frame\", {\n\t\t\tBackgroundTransparency = 1,\n\t\t\tSize = UDim2.fromOffset(size, size),\n\t\t\tLayoutOrder = i,\n\t\t\tParent = holder,\n\t\t})\n\t\tlocal d = Style.new(\"Frame\", {\n\t\t\tBackgroundColor3 = PIP_ON,\n\t\t\tBorderSizePixel = 0,\n\t\t\tSize = UDim2.fromScale(0.72, 0.72),\n\t\t\tPosition = UDim2.fromScale(0.5, 0.5),\n\t\t\tAnchorPoint = Vector2.new(0.5, 0.5),\n\t\t\tRotation = 45,\n\t\t\tParent = outer,\n\t\t})\n\t\tStyle.new(\"UIStroke\", { Color = Color3.new(1, 1, 1), Thickness = 1.5, Transparency = 0.3, Parent = d })\n\t\tpips[i] = d\n\tend\n\treturn pips\nend\n\nlocal function setPips(pips, n: number)\n\tfor i, d in ipairs(pips) do\n\t\td.BackgroundColor3 = i <= n and PIP_ON or PIP_OFF\n\tend\nend\n\n----------------------------------------------------------------------------------------------\n-- Panels\n----------------------------------------------------------------------------------------------\nlocal function makePanel(model: Model, slotIndex: number, isLocal: boolean)\n\tlocal right = not isLocal\n\tlocal tcolor = teamColor(model)\n\tlocal robot = Config.RobotById[model:GetAttribute(\"RobotId\") or \"Bolt\"]\n\tlocal w, h = 440, 118\n\tlocal yOff = -18 - (slotIndex - 1) * (h + 10)\n\tlocal p = Style.panel(frame, {\n\t\tName = \"Panel_\" .. model.Name,\n\t\tSize = UDim2.fromOffset(w, h),\n\t\tAnchorPoint = right and Vector2.new(1, 1) or Vector2.new(0, 1),\n\t\tPosition = right and UDim2.new(1, -18, 1, yOff) or UDim2.new(0, 18, 1, yOff),\n\t})\n\tp:FindFirstChildOfClass(\"UIStroke\").Color = tcolor\n\tp:FindFirstChildOfClass(\"UIStroke\").Transparency = 0.1\n\tlocal badge = Style.new(\"Frame\", {\n\t\tBackgroundColor3 = tcolor,\n\t\tSize = UDim2.fromOffset(78, h - 20),\n\t\tPosition = right and UDim2.new(1, -88, 0, 10) or UDim2.fromOffset(10, 10),\n\t\tParent = p,\n\t})\n\tStyle.corner(badge, 10)\n\tStyle.label(badge, tostring(model:GetAttribute(\"Tag\") or \"P?\"), 38, { Size = UDim2.fromScale(1, 1), TextColor3 = Color3.new(1, 1, 1) })\n\tStyle.textStroke(badge:FindFirstChildOfClass(\"TextLabel\"), Color3.fromRGB(0, 0, 40), 2)\n\n\tlocal x0 = right and 12 or 100\n\tlocal name = Style.label(p, robot.DisplayName .. \"  \" .. string.upper(tostring(model:GetAttribute(\"DisplayName\") or \"\")), 20, {\n\t\tFont = Style.Body,\n\t\tTextColor3 = C.Dim,\n\t\tTextXAlignment = right and Enum.TextXAlignment.Right or Enum.TextXAlignment.Left,\n\t\tTextTruncate = Enum.TextTruncate.AtEnd,\n\t\tSize = UDim2.fromOffset(w - 112 - 120, 26),\n\t\tPosition = right and UDim2.fromOffset(x0 + 120, 10) or UDim2.fromOffset(x0, 10),\n\t})\n\tlocal hpText = Style.label(p, \"1000\", 50, {\n\t\tTextXAlignment = right and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right,\n\t\tSize = UDim2.fromOffset(150, 52),\n\t\tPosition = right and UDim2.fromOffset(x0, 4) or UDim2.new(1, -164, 0, 4),\n\t})\n\tStyle.textStroke(hpText, Color3.fromRGB(0, 0, 30), 2)\n\tlocal barBg = Style.new(\"Frame\", {\n\t\tBackgroundColor3 = Color3.fromRGB(20, 18, 36),\n\t\tBorderSizePixel = 0,\n\t\tSize = UDim2.fromOffset(w - 112 - 14, 26),\n\t\tPosition = UDim2.fromOffset(x0, h - 40),\n\t\tParent = p,\n\t})\n\tStyle.corner(barBg, 8)\n\tStyle.stroke(barBg, Color3.new(1, 1, 1), 1.5, 0.6)\n\tlocal trail = Style.new(\"Frame\", {\n\t\tBackgroundColor3 = Color3.fromRGB(255, 255, 255),\n\t\tBorderSizePixel = 0,\n\t\tSize = UDim2.fromScale(1, 1),\n\t\tAnchorPoint = right and Vector2.new(1, 0) or Vector2.zero,\n\t\tPosition = right and UDim2.fromScale(1, 0) or UDim2.fromScale(0, 0),\n\t\tParent = barBg,\n\t})\n\tStyle.corner(trail, 8)\n\tlocal fill = Style.new(\"Frame\", {\n\t\tBackgroundColor3 = Color3.new(1, 1, 1),\n\t\tBorderSizePixel = 0,\n\t\tSize = UDim2.fromScale(1, 1),\n\t\tAnchorPoint = right and Vector2.new(1, 0) or Vector2.zero,\n\t\tPosition = right and UDim2.fromScale(1, 0) or UDim2.fromScale(0, 0),\n\t\tParent = barBg,\n\t})\n\tStyle.corner(fill, 8)\n\tlocal grad = Style.new(\"UIGradient\", {\n\t\tColor = ColorSequence.new(tcolor:Lerp(Color3.new(1, 1, 1), 0.35), tcolor),\n\t\tRotation = 90,\n\t\tParent = fill,\n\t})\n\tlocal pips = makePips(p, 22, right and UDim2.new(1, -112 - 88, 0, 40) or UDim2.fromOffset(x0, 40))\n\tpanels[model] = {\n\t\tframe = p,\n\t\thpText = hpText,\n\t\tfill = fill,\n\t\ttrail = trail,\n\t\tgrad = grad,\n\t\tpips = pips,\n\t\tname = name,\n\t\tshownHp = 1000,\n\t\ttrailHp = 1000,\n\t\tlastHp = 1000,\n\t}\nend\n\n----------------------------------------------------------------------------------------------\n-- Floating tags\n----------------------------------------------------------------------------------------------\nlocal function makeTag(model: Model, isLocal: boolean)\n\tlocal head = model:FindFirstChild(\"Head\") or model:FindFirstChild(\"HumanoidRootPart\")\n\tlocal tcolor = teamColor(model)\n\tlocal bb = Style.new(\"Frame\", {\n\t\tName = \"Tag_\" .. model.Name,\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(150, 96),\n\t\tAnchorPoint = Vector2.new(0.5, 1),\n\t\tVisible = false,\n\t\tParent = worldRoot,\n\t})\n\tlocal row = Style.new(\"Frame\", {\n\t\tBackgroundColor3 = Color3.fromRGB(10, 12, 28),\n\t\tBackgroundTransparency = 0.25,\n\t\tSize = UDim2.fromOffset(120, 30),\n\t\tPosition = UDim2.new(0.5, 0, 1, -24),\n\t\tAnchorPoint = Vector2.new(0.5, 1),\n\t\tParent = bb,\n\t})\n\tStyle.corner(row, 8)\n\tStyle.stroke(row, tcolor, 2, 0)\n\tlocal badge = Style.label(row, tostring(model:GetAttribute(\"Tag\") or \"P?\"), 18, {\n\t\tBackgroundTransparency = 0,\n\t\tBackgroundColor3 = tcolor,\n\t\tSize = UDim2.fromOffset(36, 30),\n\t\tTextColor3 = Color3.new(1, 1, 1),\n\t})\n\tStyle.corner(badge, 8)\n\tlocal hp = Style.label(row, \"1000\", 20, {\n\t\tSize = UDim2.new(1, -42, 1, 0),\n\t\tPosition = UDim2.fromOffset(40, 0),\n\t\tTextXAlignment = Enum.TextXAlignment.Left,\n\t})\n\tlocal pips = makePips(bb, 14, UDim2.new(0.5, 0, 1, -2), Vector2.new(0.5, 1))\n\tlocal pop = Style.label(bb, \"\", 26, {\n\t\tFontFace = ITALIC,\n\t\tTextColor3 = C.Pink,\n\t\tSize = UDim2.new(1, 0, 0, 28),\n\t\tPosition = UDim2.fromOffset(0, 0),\n\t\tTextTransparency = 1,\n\t})\n\tlocal popStroke = Style.textStroke(pop, Color3.new(0, 0, 0), 2)\n\tpopStroke.Transparency = 1\n\tlocal combo = Style.label(bb, \"\", 22, {\n\t\tFontFace = ITALIC,\n\t\tTextColor3 = Color3.fromRGB(255, 60, 60),\n\t\tSize = UDim2.new(1, 0, 0, 24),\n\t\tPosition = UDim2.fromOffset(0, 26),\n\t\tTextTransparency = 1,\n\t})\n\tlocal comboStroke = Style.textStroke(combo, Color3.new(1, 1, 1), 1.5)\n\tcomboStroke.Transparency = 1\n\ttags[model] = { bb = bb, adornee = head, hp = hp, pips = pips, pop = pop, popStroke = popStroke, combo = combo, comboStroke = comboStroke, comboUntil = 0, popSeq = 0 }\nend\n\nfunction HUD.TagText(model: Model?, text: string, color: Color3?)\n\tlocal t = model and tags[model]\n\tif not t then\n\t\treturn\n\tend\n\tt.popSeq += 1\n\tlocal seq = t.popSeq\n\tt.pop.Text = text\n\tt.pop.TextColor3 = color or C.Pink\n\tt.pop.TextTransparency = 0\n\tt.popStroke.Transparency = 0\n\tt.pop.Position = UDim2.fromOffset(0, 6)\n\tTweenService:Create(t.pop, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Position = UDim2.fromOffset(0, 0) }):Play()\n\ttask.delay(1.4, function()\n\t\tif t.popSeq == seq and t.pop.Parent then\n\t\t\tTweenService:Create(t.pop, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()\n\t\t\tTweenService:Create(t.popStroke, TweenInfo.new(0.3), { Transparency = 1 }):Play()\n\t\tend\n\tend)\nend\n\n----------------------------------------------------------------------------------------------\n-- Hit popups\n----------------------------------------------------------------------------------------------\nlocal popups = {}\nlocal function popupAt(pos: Vector3, text: string, color: Color3, size: number, strokeColor: Color3)\n\tlocal f = Style.new(\"Frame\", {\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(160, 50),\n\t\tAnchorPoint = Vector2.new(0.5, 0.5),\n\t\tVisible = false,\n\t\tParent = worldRoot,\n\t})\n\tlocal l = Style.label(f, text, size, { FontFace = ITALIC, TextColor3 = color, Size = UDim2.fromScale(1, 1) })\n\tlocal st = Style.textStroke(l, strokeColor, 2.5)\n\tl.Rotation = math.random(-8, 8)\n\ttable.insert(popups, { frame = f, pos = pos, t0 = os.clock() })\n\ttask.delay(0.35, function()\n\t\tTweenService:Create(l, TweenInfo.new(0.35), { TextTransparency = 1 }):Play()\n\t\tTweenService:Create(st, TweenInfo.new(0.35), { Transparency = 1 }):Play()\n\tend)\nend\n\nfunction HUD.ShowHit(victim: Model?, pos: Vector3, amount: number, combo: number, heavy: boolean)\n\tpopupAt(pos + Vector3.new(math.random() * 2 - 1, 0, 0), \"HIT\", Color3.new(1, 1, 1), heavy and 34 or 26, Color3.fromRGB(255, 140, 0))\n\tlocal t = victim and tags[victim]\n\tif t then\n\t\tt.combo.Text = \"DAMAGE \" .. tostring(combo)\n\t\tt.combo.TextTransparency = 0\n\t\tt.comboStroke.Transparency = 0.2\n\t\tt.comboUntil = os.clock() + Config.Match.ComboWindow + 0.4\n\t\tt.combo.TextSize = heavy and 28 or 22\n\t\tTweenService:Create(t.combo, TweenInfo.new(0.15), { TextSize = 22 }):Play()\n\tend\nend\n\nfunction HUD.DamageVignette(heavy: boolean)\n\tvignette.BackgroundTransparency = heavy and 0.55 or 0.75\n\tTweenService:Create(vignette, TweenInfo.new(heavy and 0.5 or 0.3), { BackgroundTransparency = 1 }):Play()\nend\n\n----------------------------------------------------------------------------------------------\n-- Announcer\n----------------------------------------------------------------------------------------------\nlocal announceSeq = 0\n-- opts: { color, size, hold, slam, sub }\nfunction HUD.Announce(text: string, opts)\n\topts = opts or {}\n\tannounceSeq += 1\n\tlocal seq = announceSeq\n\tannounce.Text = text\n\tannounce.TextColor3 = opts.color or Color3.new(1, 1, 1)\n\tlocal size = opts.size or 130\n\tannounce.TextTransparency = 0\n\t(announce:FindFirstChildOfClass(\"UIStroke\") :: UIStroke).Transparency = 0\n\tlocal sc = announce:FindFirstChildOfClass(\"UIScale\")\n\tif opts.slam then\n\t\tsc.Scale = 3\n\t\tTweenService:Create(sc, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()\n\telse\n\t\tsc.Scale = 0.6\n\t\tTweenService:Create(sc, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()\n\tend\n\tannounce.TextSize = size\n\tif opts.hold ~= math.huge then\n\t\ttask.delay(opts.hold or 0.7, function()\n\t\t\tif announceSeq == seq then\n\t\t\t\tTweenService:Create(announce, TweenInfo.new(0.2), { TextTransparency = 1 }):Play()\n\t\t\t\tTweenService:Create(announce:FindFirstChildOfClass(\"UIStroke\"), TweenInfo.new(0.2), { Transparency = 1 }):Play()\n\t\t\tend\n\t\tend)\n\tend\nend\n\nfunction HUD.ClearAnnounce()\n\tannounceSeq += 1\n\tannounce.TextTransparency = 1\n\t(announce:FindFirstChildOfClass(\"UIStroke\") :: UIStroke).Transparency = 1\nend\n\n----------------------------------------------------------------------------------------------\n-- Weapon chips (local robot)\n----------------------------------------------------------------------------------------------\nlocal KEYS = {\n\tKeyboard = { Gun = \"LMB/J\", Bomb = \"RMB/K\", Pod = \"E/L\", Dash = \"SHIFT\" },\n\tGamepad = { Gun = \"RT\", Bomb = \"LT/X\", Pod = \"RB/Y\", Dash = \"B/LB\" },\n\tTouch = { Gun = \"\", Bomb = \"\", Pod = \"\", Dash = \"\" },\n}\n\nlocal function makeChip(name: string, order: number, color: Color3)\n\tlocal chip = Style.new(\"Frame\", {\n\t\tBackgroundColor3 = Color3.fromRGB(14, 18, 40),\n\t\tBackgroundTransparency = 0.15,\n\t\tSize = UDim2.fromOffset(100, 44),\n\t\tLayoutOrder = order,\n\t\tClipsDescendants = true,\n\t\tParent = chipsFrame,\n\t})\n\tStyle.corner(chip, 8)\n\tlocal st = Style.stroke(chip, color, 2, 0.3)\n\tlocal fill = Style.new(\"Frame\", {\n\t\tBackgroundColor3 = color,\n\t\tBackgroundTransparency = 0.55,\n\t\tBorderSizePixel = 0,\n\t\tSize = UDim2.fromScale(1, 1),\n\t\tParent = chip,\n\t})\n\tlocal label = Style.label(chip, name, 18, { Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 3) })\n\tlocal sub = Style.label(chip, \"\", 13, { Font = Style.Body, TextColor3 = C.Dim, Size = UDim2.new(1, 0, 0, 14), Position = UDim2.fromOffset(0, 25) })\n\tchips[name] = { frame = chip, fill = fill, label = label, sub = sub, stroke = st, color = color }\nend\n\nlocal function setChip(name: string, ready01: number, text: string?)\n\tlocal c = chips[name]\n\tif not c then\n\t\treturn\n\tend\n\tc.fill.Size = UDim2.fromScale(math.clamp(ready01, 0, 1), 1)\n\tlocal ready = ready01 >= 1\n\tc.fill.BackgroundTransparency = ready and 0.45 or 0.75\n\tc.stroke.Transparency = ready and 0 or 0.6\n\tc.label.TextTransparency = ready and 0 or 0.45\n\tif text then\n\t\tc.sub.Text = text\n\tend\nend\n\n----------------------------------------------------------------------------------------------\n-- Public lifecycle\n----------------------------------------------------------------------------------------------\nfunction HUD.Init(uiRoot: Frame, backgroundRoot: Frame, overlayRoot: Frame, scaleGetter: () -> number)\n\troot = uiRoot\n\tbgRoot = backgroundRoot\n\tworldRoot = overlayRoot\n\tgetScale = scaleGetter\n\tframe = Style.new(\"Frame\", { Name = \"HUD\", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = root })\n\tlocal timerPanel = Style.panel(frame, {\n\t\tName = \"Timer\",\n\t\tSize = UDim2.fromOffset(170, 70),\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0, 14),\n\t})\n\ttimerLabel = Style.label(timerPanel, \"3:00\", 52, { Size = UDim2.fromScale(1, 1) })\n\tannounceBand = Style.new(\"Frame\", {\n\t\tName = \"AnnounceBand\",\n\t\tBackgroundColor3 = Color3.fromRGB(10, 8, 36),\n\t\tBackgroundTransparency = 0.2,\n\t\tBorderSizePixel = 0,\n\t\tVisible = false,\n\t\tSize = UDim2.new(1.4, 0, 0, 0),\n\t\tAnchorPoint = Vector2.new(0.5, 0.5),\n\t\tPosition = UDim2.fromScale(0.5, 0.4),\n\t\tRotation = ANNOUNCE_TILT,\n\t\tZIndex = 4,\n\t\tParent = frame,\n\t})\n\tStyle.new(\"UIGradient\", {\n\t\tTransparency = NumberSequence.new({\n\t\t\tNumberSequenceKeypoint.new(0, 1),\n\t\t\tNumberSequenceKeypoint.new(0.25, 0.1),\n\t\t\tNumberSequenceKeypoint.new(0.75, 0.1),\n\t\t\tNumberSequenceKeypoint.new(1, 1),\n\t\t}),\n\t\tParent = announceBand,\n\t})\n\tfor i, y in { 0, 1 } do\n\t\tlocal edge = Style.new(\"Frame\", {\n\t\t\tName = \"Edge\" .. i,\n\t\t\tBackgroundColor3 = C.Pink,\n\t\t\tBorderSizePixel = 0,\n\t\t\tSize = UDim2.new(1, 0, 0, 4),\n\t\t\tAnchorPoint = Vector2.new(0, y),\n\t\t\tPosition = UDim2.fromScale(0, y),\n\t\t\tZIndex = 4,\n\t\t\tParent = announceBand,\n\t\t})\n\t\tStyle.new(\"UIGradient\", {\n\t\t\tTransparency = NumberSequence.new({\n\t\t\t\tNumberSequenceKeypoint.new(0, 1),\n\t\t\t\tNumberSequenceKeypoint.new(0.3, 0),\n\t\t\t\tNumberSequenceKeypoint.new(0.7, 0),\n\t\t\t\tNumberSequenceKeypoint.new(1, 1),\n\t\t\t}),\n\t\t\tParent = edge,\n\t\t})\n\tend\n\tannounce = Style.label(frame, \"\", 130, {\n\t\tName = \"Announce\",\n\t\tFontFace = ITALIC,\n\t\tSize = UDim2.new(1, 0, 0, 160),\n\t\tAnchorPoint = Vector2.new(0.5, 0.5),\n\t\tPosition = UDim2.fromScale(0.5, 0.4),\n\t\tRotation = ANNOUNCE_TILT,\n\t\tTextTransparency = 1,\n\t\tZIndex = 5,\n\t})\n\tlocal ast = Style.textStroke(announce, Color3.fromRGB(20, 0, 60), 5)\n\tast.Transparency = 1\n\tStyle.new(\"UIScale\", { Parent = announce })\n\tchipsFrame = Style.new(\"Frame\", {\n\t\tName = \"Chips\",\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(440, 44),\n\t\tAnchorPoint = Vector2.new(0, 1),\n\t\tPosition = UDim2.new(0, 18, 1, -146),\n\t\tParent = frame,\n\t})\n\tStyle.new(\"UIListLayout\", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = chipsFrame })\n\tmakeChip(\"GUN\", 1, Color3.fromRGB(90, 220, 255))\n\tmakeChip(\"BOMB\", 2, Color3.fromRGB(255, 160, 60))\n\tmakeChip(\"POD\", 3, Color3.fromRGB(190, 255, 90))\n\tmakeChip(\"DASH\", 4, Color3.fromRGB(255, 255, 255))\n\n\tvignette = Style.new(\"Frame\", {\n\t\tName = \"Vignette\",\n\t\tBackgroundColor3 = Color3.fromRGB(255, 0, 40),\n\t\tBackgroundTransparency = 1,\n\t\tBorderSizePixel = 0,\n\t\tSize = UDim2.fromScale(1, 1),\n\t\tParent = bgRoot,\n\t})\n\tStyle.new(\"UIGradient\", {\n\t\tTransparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 1), NumberSequenceKeypoint.new(1, 0) }),\n\t\tParent = vignette,\n\t})\n\n\treticle = Style.new(\"Frame\", {\n\t\tName = \"Reticle\",\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(84, 84),\n\t\tAnchorPoint = Vector2.new(0.5, 0.5),\n\t\tVisible = false,\n\t\tParent = worldRoot,\n\t})\n\tlocal ring = Style.new(\"Frame\", {\n\t\tName = \"Ring\",\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromScale(0.8, 0.8),\n\t\tPosition = UDim2.fromScale(0.5, 0.5),\n\t\tAnchorPoint = Vector2.new(0.5, 0.5),\n\t\tParent = reticle,\n\t})\n\tStyle.corner(ring, 100)\n\tStyle.new(\"UIStroke\", { Color = Color3.fromRGB(255, 70, 140), Thickness = 4, Parent = ring })\n\tfor i = 0, 3 do\n\t\tlocal tick = Style.new(\"Frame\", {\n\t\t\tBackgroundColor3 = Color3.fromRGB(255, 70, 140),\n\t\t\tBorderSizePixel = 0,\n\t\t\tSize = UDim2.fromOffset(6, 18),\n\t\t\tAnchorPoint = Vector2.new(0.5, 0.5),\n\t\t\tPosition = UDim2.fromScale(0.5 + 0.5 * math.sin(i * math.pi / 2), 0.5 - 0.5 * math.cos(i * math.pi / 2)),\n\t\t\tRotation = i * 90,\n\t\t\tParent = ring,\n\t\t})\n\t\tStyle.corner(tick, 3)\n\tend\nend\n\nfunction HUD.Start(info)\n\tHUD.Stop()\n\tframe.Visible = true\n\tlocal localModel = info.localModel\n\tlocal rivalSlot = 0\n\tfor _, r in ipairs(info.roster) do\n\t\tlocal model = r.model\n\t\tif model then\n\t\t\tlocal isLocal = model == localModel\n\t\t\tif isLocal then\n\t\t\t\tmakePanel(model, 1, true)\n\t\t\telse\n\t\t\t\trivalSlot += 1\n\t\t\t\tmakePanel(model, rivalSlot, false)\n\t\t\tend\n\t\t\tmakeTag(model, isLocal)\n\t\tend\n\tend\n\ttimerLabel.Text = Util.fmtTime(info.duration)\n\tHUD.ClearAnnounce()\nend\n\nfunction HUD.Stop()\n\tframe.Visible = false\n\tfor _, p in pairs(panels) do\n\t\tp.frame:Destroy()\n\tend\n\tpanels = {}\n\tfor _, t in pairs(tags) do\n\t\tt.bb:Destroy()\n\tend\n\ttags = {}\n\treticle.Visible = false\n\treticleTarget = nil\n\tfor _, p in ipairs(popups) do\n\t\tp.frame:Destroy()\n\tend\n\ttable.clear(popups)\n\tHUD.ClearAnnounce()\nend\n\nfunction HUD.SetTarget(model: Model?)\n\treticleTarget = model\nend\n\nlocal function place(frame: GuiObject, worldPos: Vector3, camera: Camera, scale: number)\n\tlocal v = camera:WorldToViewportPoint(worldPos)\n\tif v.Z <= 0 then\n\t\tframe.Visible = false\n\t\treturn\n\tend\n\tframe.Visible = true\n\tframe.Position = UDim2.fromOffset(v.X / scale, v.Y / scale)\nend\n\n-- Call after the camera has been positioned for this frame.\nfunction HUD.UpdateWorld()\n\tif not frame.Visible then\n\t\treturn\n\tend\n\tlocal camera = workspace.CurrentCamera\n\tlocal scale = getScale()\n\tfor model, t in pairs(tags) do\n\t\tlocal a = t.adornee\n\t\tif model.Parent and a and a.Parent then\n\t\t\tplace(t.bb, a.Position + Vector3.new(0, 3.4, 0), camera, scale)\n\t\telse\n\t\t\tt.bb.Visible = false\n\t\tend\n\tend\n\tlocal tr = reticleTarget and reticleTarget.Parent and reticleTarget:FindFirstChild(\"HumanoidRootPart\") :: BasePart?\n\tif reticleTarget and tr then\n\t\tplace(reticle, tr.Position + Vector3.new(0, tonumber(reticleTarget:GetAttribute(\"AimY\")) or 0, 0), camera, scale)\n\telse\n\t\treticle.Visible = false\n\tend\n\tlocal clock = os.clock()\n\tfor i = #popups, 1, -1 do\n\t\tlocal p = popups[i]\n\t\tlocal a = (clock - p.t0) / 0.75\n\t\tif a >= 1 then\n\t\t\tp.frame:Destroy()\n\t\t\ttable.remove(popups, i)\n\t\telse\n\t\t\tlocal rise = 1 + 3.2 * (1 - (1 - a) * (1 - a))\n\t\t\tplace(p.frame, p.pos + Vector3.new(0, rise, 0), camera, scale)\n\t\tend\n\tend\nend\n\nfunction HUD.Update(dt: number, endTime: number?, lockedTimer: number?)\n\tif not frame.Visible then\n\t\treturn\n\tend\n\tlocal serverNow = workspace:GetServerTimeNow()\n\tif lockedTimer then\n\t\ttimerLabel.Text = Util.fmtTime(lockedTimer)\n\telseif endTime then\n\t\tlocal remain = endTime - serverNow\n\t\ttimerLabel.Text = Util.fmtTime(remain)\n\t\ttimerLabel.TextColor3 = remain <= 10 and C.Red or Color3.new(1, 1, 1)\n\tend\n\tlocal tk = 1 - math.exp(-dt * 10)\n\tfor model, p in pairs(panels) do\n\t\tif model.Parent then\n\t\t\tlocal hp = model:GetAttribute(\"HP\") or 1000\n\t\t\tlocal maxHp = model:GetAttribute(\"MaxHP\") or 1000\n\t\t\tif hp < p.lastHp then\n\t\t\t\tp.trailHold = os.clock() + 0.45\n\t\t\tend\n\t\t\tp.lastHp = hp\n\t\t\tp.shownHp += (hp - p.shownHp) * tk\n\t\t\tif math.abs(hp - p.shownHp) < 1 then\n\t\t\t\tp.shownHp = hp\n\t\t\tend\n\t\t\tif not p.trailHold or os.clock() > p.trailHold then\n\t\t\t\tp.trailHp += (hp - p.trailHp) * (1 - math.exp(-dt * 4))\n\t\t\tend\n\t\t\tp.hpText.Text = tostring(math.floor(p.shownHp + 0.5))\n\t\t\tp.fill.Size = UDim2.fromScale(math.clamp(p.shownHp / maxHp, 0, 1), 1)\n\t\t\tp.trail.Size = UDim2.fromScale(math.clamp(p.trailHp / maxHp, 0, 1), 1)\n\t\t\tlocal pct = hp / maxHp\n\t\t\tp.hpText.TextColor3 = pct <= 0.25 and C.Red or Color3.new(1, 1, 1)\n\t\t\tsetPips(p.pips, model:GetAttribute(\"Pips\") or 3)\n\t\tend\n\tend\n\tlocal clock = os.clock()\n\tfor model, t in pairs(tags) do\n\t\tif model.Parent then\n\t\t\tt.hp.Text = tostring(model:GetAttribute(\"HP\") or 1000)\n\t\t\tsetPips(t.pips, model:GetAttribute(\"Pips\") or 3)\n\t\t\tif t.comboUntil > 0 and clock > t.comboUntil then\n\t\t\t\tt.comboUntil = 0\n\t\t\t\tTweenService:Create(t.combo, TweenInfo.new(0.25), { TextTransparency = 1 }):Play()\n\t\t\t\tTweenService:Create(t.comboStroke, TweenInfo.new(0.25), { Transparency = 1 }):Play()\n\t\t\tend\n\t\tend\n\tend\n\tif reticle.Visible then\n\t\tlocal ring = reticle:FindFirstChild(\"Ring\") :: Frame\n\t\tring.Rotation = (clock * 90) % 360\n\t\tlocal s = 1 + 0.06 * math.sin(clock * 8)\n\t\tring.Size = UDim2.fromScale(0.8 * s, 0.8 * s)\n\tend\n\n\t-- Local weapon readiness\n\tlocal m = State.localModel\n\tif m and m.Parent then\n\t\tlocal loadout = Config.GetLoadout(m:GetAttribute(\"RobotId\") or \"Bolt\")\n\t\tlocal keys = KEYS[State.lastInput] or KEYS.Keyboard\n\t\tlocal reloadUntil = m:GetAttribute(\"ReloadUntil\") or 0\n\t\tlocal gunReadyAt = m:GetAttribute(\"GunReadyAt\") or 0\n\t\tlocal gun = loadout.Gun\n\t\tif serverNow < reloadUntil then\n\t\t\tlocal k = 1 - (reloadUntil - serverNow) / (gun.Reload + gun.Cooldown)\n\t\t\tsetChip(\"GUN\", k, \"RELOAD\")\n\t\telseif serverNow < gunReadyAt then\n\t\t\tsetChip(\"GUN\", 1 - (gunReadyAt - serverNow) / gun.Cooldown, keys.Gun)\n\t\telse\n\t\t\tlocal ammo = m:GetAttribute(\"Ammo\")\n\t\t\tlocal clip = m:GetAttribute(\"Clip\") or 0\n\t\t\tsetChip(\"GUN\", 1, clip > 0 and (string.rep(\"•\", ammo or clip) .. \"  \" .. keys.Gun) or keys.Gun)\n\t\tend\n\t\tlocal b = m:GetAttribute(\"BombReadyAt\") or 0\n\t\tsetChip(\"BOMB\", 1 - math.max(0, b - serverNow) / loadout.Bomb.Cooldown, keys.Bomb)\n\t\tlocal pd = m:GetAttribute(\"PodReadyAt\") or 0\n\t\tsetChip(\"POD\", 1 - math.max(0, pd - serverNow) / loadout.Pod.Cooldown, keys.Pod)\n\t\tlocal dashK = State.dashReady01 or 1\n\t\tsetChip(\"DASH\", dashK, keys.Dash)\n\tend\nend\n\nfunction HUD.SetChipsVisible(v: boolean)\n\tchipsFrame.Visible = v\nend\n\nreturn HUD\n","afterFullFileContent":"-- Battle HUD: P-panels (local bottom-left, rivals bottom-right), timer, weapon chips, floating\n-- tags with HP + DOWN pips, lock-on reticle, HIT / DAMAGE popups, announcer text.\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal TweenService = game:GetService(\"TweenService\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"RoboClash\").Config)\nlocal Util = require(ReplicatedStorage.RoboClash.Shared.Util)\nlocal Style = require(script.Parent.Style)\nlocal State = require(script.Parent.State)\n\nlocal C = Style.C\nlocal HUD = {}\n\nlocal root: Frame\nlocal bgRoot: Frame\nlocal frame: Frame\nlocal timerLabel: TextLabel\nlocal announce: TextLabel\nlocal chipsFrame: Frame\nlocal chips = {}\nlocal panels = {}\nlocal tags = {}\nlocal reticle: Frame\nlocal reticleTarget: Model? = nil\nlocal vignette: Frame\nlocal worldRoot: Frame\nlocal getScale: () -> number\n\nlocal PIP_ON = Color3.fromRGB(255, 90, 170)\nlocal PIP_OFF = Color3.fromRGB(50, 40, 70)\nlocal ITALIC = Font.new(\"rbxasset://fonts/families/GothamSSm.json\", Enum.FontWeight.Heavy, Enum.FontStyle.Italic)\n\nlocal function teamColor(model: Model): Color3\n\tlocal idx = model:GetAttribute(\"Index\") or 1\n\treturn Config.TeamColors[idx] or C.Accent\nend\n\nlocal function makePips(parent: Instance, size: number, pos: UDim2, anchor: Vector2?)\n\tlocal holder = Style.new(\"Frame\", {\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(size * 3 + 12, size + 4),\n\t\tPosition = pos,\n\t\tAnchorPoint = anchor or Vector2.zero,\n\t\tParent = parent,\n\t})\n\tStyle.new(\"UIListLayout\", { SortOrder = Enum.SortOrder.LayoutOrder,\n\t\tFillDirection = Enum.FillDirection.Horizontal,\n\t\tPadding = UDim.new(0, 6),\n\t\tVerticalAlignment = Enum.VerticalAlignment.Center,\n\t\tParent = holder,\n\t})\n\tlocal pips = {}\n\tfor i = 1, 3 do\n\t\tlocal outer = Style.new(\"Frame\", {\n\t\t\tBackgroundTransparency = 1,\n\t\t\tSize = UDim2.fromOffset(size, size),\n\t\t\tLayoutOrder = i,\n\t\t\tParent = holder,\n\t\t})\n\t\tlocal d = Style.new(\"Frame\", {\n\t\t\tBackgroundColor3 = PIP_ON,\n\t\t\tBorderSizePixel = 0,\n\t\t\tSize = UDim2.fromScale(0.72, 0.72),\n\t\t\tPosition = UDim2.fromScale(0.5, 0.5),\n\t\t\tAnchorPoint = Vector2.new(0.5, 0.5),\n\t\t\tRotation = 45,\n\t\t\tParent = outer,\n\t\t})\n\t\tStyle.new(\"UIStroke\", { Color = Color3.new(1, 1, 1), Thickness = 1.5, Transparency = 0.3, Parent = d })\n\t\tpips[i] = d\n\tend\n\treturn pips\nend\n\nlocal function setPips(pips, n: number)\n\tfor i, d in ipairs(pips) do\n\t\td.BackgroundColor3 = i <= n and PIP_ON or PIP_OFF\n\tend\nend\n\n----------------------------------------------------------------------------------------------\n-- Panels\n----------------------------------------------------------------------------------------------\nlocal function makePanel(model: Model, slotIndex: number, isLocal: boolean)\n\tlocal right = not isLocal\n\tlocal tcolor = teamColor(model)\n\tlocal robot = Config.RobotById[model:GetAttribute(\"RobotId\") or \"Bolt\"]\n\tlocal w, h = 440, 118\n\tlocal yOff = -18 - (slotIndex - 1) * (h + 10)\n\tlocal p = Style.panel(frame, {\n\t\tName = \"Panel_\" .. model.Name,\n\t\tSize = UDim2.fromOffset(w, h),\n\t\tAnchorPoint = right and Vector2.new(1, 1) or Vector2.new(0, 1),\n\t\tPosition = right and UDim2.new(1, -18, 1, yOff) or UDim2.new(0, 18, 1, yOff),\n\t})\n\tp:FindFirstChildOfClass(\"UIStroke\").Color = tcolor\n\tp:FindFirstChildOfClass(\"UIStroke\").Transparency = 0.1\n\tlocal badge = Style.new(\"Frame\", {\n\t\tBackgroundColor3 = tcolor,\n\t\tSize = UDim2.fromOffset(78, h - 20),\n\t\tPosition = right and UDim2.new(1, -88, 0, 10) or UDim2.fromOffset(10, 10),\n\t\tParent = p,\n\t})\n\tStyle.corner(badge, 10)\n\tStyle.label(badge, tostring(model:GetAttribute(\"Tag\") or \"P?\"), 38, { Size = UDim2.fromScale(1, 1), TextColor3 = Color3.new(1, 1, 1) })\n\tStyle.textStroke(badge:FindFirstChildOfClass(\"TextLabel\"), Color3.fromRGB(0, 0, 40), 2)\n\n\tlocal x0 = right and 12 or 100\n\tlocal name = Style.label(p, robot.DisplayName .. \"  \" .. string.upper(tostring(model:GetAttribute(\"DisplayName\") or \"\")), 20, {\n\t\tFont = Style.Body,\n\t\tTextColor3 = C.Dim,\n\t\tTextXAlignment = right and Enum.TextXAlignment.Right or Enum.TextXAlignment.Left,\n\t\tTextTruncate = Enum.TextTruncate.AtEnd,\n\t\tSize = UDim2.fromOffset(w - 112 - 120, 26),\n\t\tPosition = right and UDim2.fromOffset(x0 + 120, 10) or UDim2.fromOffset(x0, 10),\n\t})\n\tlocal hpText = Style.label(p, \"1000\", 50, {\n\t\tTextXAlignment = right and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right,\n\t\tSize = UDim2.fromOffset(150, 52),\n\t\tPosition = right and UDim2.fromOffset(x0, 4) or UDim2.new(1, -164, 0, 4),\n\t})\n\tStyle.textStroke(hpText, Color3.fromRGB(0, 0, 30), 2)\n\tlocal barBg = Style.new(\"Frame\", {\n\t\tBackgroundColor3 = Color3.fromRGB(20, 18, 36),\n\t\tBorderSizePixel = 0,\n\t\tSize = UDim2.fromOffset(w - 112 - 14, 26),\n\t\tPosition = UDim2.fromOffset(x0, h - 40),\n\t\tParent = p,\n\t})\n\tStyle.corner(barBg, 8)\n\tStyle.stroke(barBg, Color3.new(1, 1, 1), 1.5, 0.6)\n\tlocal trail = Style.new(\"Frame\", {\n\t\tBackgroundColor3 = Color3.fromRGB(255, 255, 255),\n\t\tBorderSizePixel = 0,\n\t\tSize = UDim2.fromScale(1, 1),\n\t\tAnchorPoint = right and Vector2.new(1, 0) or Vector2.zero,\n\t\tPosition = right and UDim2.fromScale(1, 0) or UDim2.fromScale(0, 0),\n\t\tParent = barBg,\n\t})\n\tStyle.corner(trail, 8)\n\tlocal fill = Style.new(\"Frame\", {\n\t\tBackgroundColor3 = Color3.new(1, 1, 1),\n\t\tBorderSizePixel = 0,\n\t\tSize = UDim2.fromScale(1, 1),\n\t\tAnchorPoint = right and Vector2.new(1, 0) or Vector2.zero,\n\t\tPosition = right and UDim2.fromScale(1, 0) or UDim2.fromScale(0, 0),\n\t\tParent = barBg,\n\t})\n\tStyle.corner(fill, 8)\n\tlocal grad = Style.new(\"UIGradient\", {\n\t\tColor = ColorSequence.new(tcolor:Lerp(Color3.new(1, 1, 1), 0.35), tcolor),\n\t\tRotation = 90,\n\t\tParent = fill,\n\t})\n\tlocal pips = makePips(p, 22, right and UDim2.new(1, -112 - 88, 0, 40) or UDim2.fromOffset(x0, 40))\n\tpanels[model] = {\n\t\tframe = p,\n\t\thpText = hpText,\n\t\tfill = fill,\n\t\ttrail = trail,\n\t\tgrad = grad,\n\t\tpips = pips,\n\t\tname = name,\n\t\tshownHp = 1000,\n\t\ttrailHp = 1000,\n\t\tlastHp = 1000,\n\t}\nend\n\n----------------------------------------------------------------------------------------------\n-- Floating tags\n----------------------------------------------------------------------------------------------\nlocal function makeTag(model: Model, isLocal: boolean)\n\tlocal head = model:FindFirstChild(\"Head\") or model:FindFirstChild(\"HumanoidRootPart\")\n\tlocal tcolor = teamColor(model)\n\tlocal bb = Style.new(\"Frame\", {\n\t\tName = \"Tag_\" .. model.Name,\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(150, 96),\n\t\tAnchorPoint = Vector2.new(0.5, 1),\n\t\tVisible = false,\n\t\tParent = worldRoot,\n\t})\n\tlocal row = Style.new(\"Frame\", {\n\t\tBackgroundColor3 = Color3.fromRGB(10, 12, 28),\n\t\tBackgroundTransparency = 0.25,\n\t\tSize = UDim2.fromOffset(120, 30),\n\t\tPosition = UDim2.new(0.5, 0, 1, -24),\n\t\tAnchorPoint = Vector2.new(0.5, 1),\n\t\tParent = bb,\n\t})\n\tStyle.corner(row, 8)\n\tStyle.stroke(row, tcolor, 2, 0)\n\tlocal badge = Style.label(row, tostring(model:GetAttribute(\"Tag\") or \"P?\"), 18, {\n\t\tBackgroundTransparency = 0,\n\t\tBackgroundColor3 = tcolor,\n\t\tSize = UDim2.fromOffset(36, 30),\n\t\tTextColor3 = Color3.new(1, 1, 1),\n\t})\n\tStyle.corner(badge, 8)\n\tlocal hp = Style.label(row, \"1000\", 20, {\n\t\tSize = UDim2.new(1, -42, 1, 0),\n\t\tPosition = UDim2.fromOffset(40, 0),\n\t\tTextXAlignment = Enum.TextXAlignment.Left,\n\t})\n\tlocal pips = makePips(bb, 14, UDim2.new(0.5, 0, 1, -2), Vector2.new(0.5, 1))\n\tlocal pop = Style.label(bb, \"\", 26, {\n\t\tFontFace = ITALIC,\n\t\tTextColor3 = C.Pink,\n\t\tSize = UDim2.new(1, 0, 0, 28),\n\t\tPosition = UDim2.fromOffset(0, 0),\n\t\tTextTransparency = 1,\n\t})\n\tlocal popStroke = Style.textStroke(pop, Color3.new(0, 0, 0), 2)\n\tpopStroke.Transparency = 1\n\tlocal combo = Style.label(bb, \"\", 22, {\n\t\tFontFace = ITALIC,\n\t\tTextColor3 = Color3.fromRGB(255, 60, 60),\n\t\tSize = UDim2.new(1, 0, 0, 24),\n\t\tPosition = UDim2.fromOffset(0, 26),\n\t\tTextTransparency = 1,\n\t})\n\tlocal comboStroke = Style.textStroke(combo, Color3.new(1, 1, 1), 1.5)\n\tcomboStroke.Transparency = 1\n\ttags[model] = { bb = bb, adornee = head, hp = hp, pips = pips, pop = pop, popStroke = popStroke, combo = combo, comboStroke = comboStroke, comboUntil = 0, popSeq = 0 }\nend\n\nfunction HUD.TagText(model: Model?, text: string, color: Color3?)\n\tlocal t = model and tags[model]\n\tif not t then\n\t\treturn\n\tend\n\tt.popSeq += 1\n\tlocal seq = t.popSeq\n\tt.pop.Text = text\n\tt.pop.TextColor3 = color or C.Pink\n\tt.pop.TextTransparency = 0\n\tt.popStroke.Transparency = 0\n\tt.pop.Position = UDim2.fromOffset(0, 6)\n\tTweenService:Create(t.pop, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Position = UDim2.fromOffset(0, 0) }):Play()\n\ttask.delay(1.4, function()\n\t\tif t.popSeq == seq and t.pop.Parent then\n\t\t\tTweenService:Create(t.pop, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()\n\t\t\tTweenService:Create(t.popStroke, TweenInfo.new(0.3), { Transparency = 1 }):Play()\n\t\tend\n\tend)\nend\n\n----------------------------------------------------------------------------------------------\n-- Hit popups\n----------------------------------------------------------------------------------------------\nlocal popups = {}\nlocal function popupAt(pos: Vector3, text: string, color: Color3, size: number, strokeColor: Color3)\n\tlocal f = Style.new(\"Frame\", {\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(160, 50),\n\t\tAnchorPoint = Vector2.new(0.5, 0.5),\n\t\tVisible = false,\n\t\tParent = worldRoot,\n\t})\n\tlocal l = Style.label(f, text, size, { FontFace = ITALIC, TextColor3 = color, Size = UDim2.fromScale(1, 1) })\n\tlocal st = Style.textStroke(l, strokeColor, 2.5)\n\tl.Rotation = math.random(-8, 8)\n\ttable.insert(popups, { frame = f, pos = pos, t0 = os.clock() })\n\ttask.delay(0.35, function()\n\t\tTweenService:Create(l, TweenInfo.new(0.35), { TextTransparency = 1 }):Play()\n\t\tTweenService:Create(st, TweenInfo.new(0.35), { Transparency = 1 }):Play()\n\tend)\nend\n\nfunction HUD.ShowHit(victim: Model?, pos: Vector3, amount: number, combo: number, heavy: boolean)\n\tpopupAt(pos + Vector3.new(math.random() * 2 - 1, 0, 0), \"HIT\", Color3.new(1, 1, 1), heavy and 34 or 26, Color3.fromRGB(255, 140, 0))\n\tlocal t = victim and tags[victim]\n\tif t then\n\t\tt.combo.Text = \"DAMAGE \" .. tostring(combo)\n\t\tt.combo.TextTransparency = 0\n\t\tt.comboStroke.Transparency = 0.2\n\t\tt.comboUntil = os.clock() + Config.Match.ComboWindow + 0.4\n\t\tt.combo.TextSize = heavy and 28 or 22\n\t\tTweenService:Create(t.combo, TweenInfo.new(0.15), { TextSize = 22 }):Play()\n\tend\nend\n\nfunction HUD.DamageVignette(heavy: boolean)\n\tvignette.BackgroundTransparency = heavy and 0.55 or 0.75\n\tTweenService:Create(vignette, TweenInfo.new(heavy and 0.5 or 0.3), { BackgroundTransparency = 1 }):Play()\nend\n\n----------------------------------------------------------------------------------------------\n-- Announcer\n----------------------------------------------------------------------------------------------\nlocal announceSeq = 0\n-- opts: { color, size, hold, slam, sub }\nfunction HUD.Announce(text: string, opts)\n\topts = opts or {}\n\tannounceSeq += 1\n\tlocal seq = announceSeq\n\tannounce.Text = text\n\tannounce.TextColor3 = opts.color or Color3.new(1, 1, 1)\n\tlocal size = opts.size or 130\n\tannounce.TextTransparency = 0\n\t(announce:FindFirstChildOfClass(\"UIStroke\") :: UIStroke).Transparency = 0\n\tlocal sc = announce:FindFirstChildOfClass(\"UIScale\")\n\tif opts.slam then\n\t\tsc.Scale = 3\n\t\tTweenService:Create(sc, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()\n\telse\n\t\tsc.Scale = 0.6\n\t\tTweenService:Create(sc, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()\n\tend\n\tannounce.TextSize = size\n\tlocal bandH = math.floor(size * 1.15)\n\tannounceBand.Visible = true\n\tannounceBand.Size = UDim2.new(1.4, 0, 0, 0)\n\tTweenService:Create(announceBand, TweenInfo.new(0.14, Enum.EasingStyle.Quad), { Size = UDim2.new(1.4, 0, 0, bandH) }):Play()\n\tif opts.hold ~= math.huge then\n\t\ttask.delay(opts.hold or 0.7, function()\n\t\t\tif announceSeq == seq then\n\t\t\t\tTweenService:Create(announce, TweenInfo.new(0.2), { TextTransparency = 1 }):Play()\n\t\t\t\tTweenService:Create(announce:FindFirstChildOfClass(\"UIStroke\"), TweenInfo.new(0.2), { Transparency = 1 }):Play()\n\t\t\t\tlocal close = TweenService:Create(announceBand, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { Size = UDim2.new(1.4, 0, 0, 0) })\n\t\t\t\tclose.Completed:Connect(function()\n\t\t\t\t\tif announceSeq == seq then\n\t\t\t\t\t\tannounceBand.Visible = false\n\t\t\t\t\tend\n\t\t\t\tend)\n\t\t\t\tclose:Play()\n\t\t\tend\n\t\tend)\n\tend\nend\n\nfunction HUD.ClearAnnounce()\n\tannounceSeq += 1\n\tannounce.TextTransparency = 1\n\t(announce:FindFirstChildOfClass(\"UIStroke\") :: UIStroke).Transparency = 1\n\tannounceBand.Visible = false\nend\n\n----------------------------------------------------------------------------------------------\n-- Weapon chips (local robot)\n----------------------------------------------------------------------------------------------\nlocal KEYS = {\n\tKeyboard = { Gun = \"LMB/J\", Bomb = \"RMB/K\", Pod = \"E/L\", Dash = \"SHIFT\" },\n\tGamepad = { Gun = \"RT\", Bomb = \"LT/X\", Pod = \"RB/Y\", Dash = \"B/LB\" },\n\tTouch = { Gun = \"\", Bomb = \"\", Pod = \"\", Dash = \"\" },\n}\n\nlocal function makeChip(name: string, order: number, color: Color3)\n\tlocal chip = Style.new(\"Frame\", {\n\t\tBackgroundColor3 = Color3.fromRGB(14, 18, 40),\n\t\tBackgroundTransparency = 0.15,\n\t\tSize = UDim2.fromOffset(100, 44),\n\t\tLayoutOrder = order,\n\t\tClipsDescendants = true,\n\t\tParent = chipsFrame,\n\t})\n\tStyle.corner(chip, 8)\n\tlocal st = Style.stroke(chip, color, 2, 0.3)\n\tlocal fill = Style.new(\"Frame\", {\n\t\tBackgroundColor3 = color,\n\t\tBackgroundTransparency = 0.55,\n\t\tBorderSizePixel = 0,\n\t\tSize = UDim2.fromScale(1, 1),\n\t\tParent = chip,\n\t})\n\tlocal label = Style.label(chip, name, 18, { Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 3) })\n\tlocal sub = Style.label(chip, \"\", 13, { Font = Style.Body, TextColor3 = C.Dim, Size = UDim2.new(1, 0, 0, 14), Position = UDim2.fromOffset(0, 25) })\n\tchips[name] = { frame = chip, fill = fill, label = label, sub = sub, stroke = st, color = color }\nend\n\nlocal function setChip(name: string, ready01: number, text: string?)\n\tlocal c = chips[name]\n\tif not c then\n\t\treturn\n\tend\n\tc.fill.Size = UDim2.fromScale(math.clamp(ready01, 0, 1), 1)\n\tlocal ready = ready01 >= 1\n\tc.fill.BackgroundTransparency = ready and 0.45 or 0.75\n\tc.stroke.Transparency = ready and 0 or 0.6\n\tc.label.TextTransparency = ready and 0 or 0.45\n\tif text then\n\t\tc.sub.Text = text\n\tend\nend\n\n----------------------------------------------------------------------------------------------\n-- Public lifecycle\n----------------------------------------------------------------------------------------------\nfunction HUD.Init(uiRoot: Frame, backgroundRoot: Frame, overlayRoot: Frame, scaleGetter: () -> number)\n\troot = uiRoot\n\tbgRoot = backgroundRoot\n\tworldRoot = overlayRoot\n\tgetScale = scaleGetter\n\tframe = Style.new(\"Frame\", { Name = \"HUD\", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = root })\n\tlocal timerPanel = Style.panel(frame, {\n\t\tName = \"Timer\",\n\t\tSize = UDim2.fromOffset(170, 70),\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0, 14),\n\t})\n\ttimerLabel = Style.label(timerPanel, \"3:00\", 52, { Size = UDim2.fromScale(1, 1) })\n\tannounceBand = Style.new(\"Frame\", {\n\t\tName = \"AnnounceBand\",\n\t\tBackgroundColor3 = Color3.fromRGB(10, 8, 36),\n\t\tBackgroundTransparency = 0.2,\n\t\tBorderSizePixel = 0,\n\t\tVisible = false,\n\t\tSize = UDim2.new(1.4, 0, 0, 0),\n\t\tAnchorPoint = Vector2.new(0.5, 0.5),\n\t\tPosition = UDim2.fromScale(0.5, 0.4),\n\t\tRotation = ANNOUNCE_TILT,\n\t\tZIndex = 4,\n\t\tParent = frame,\n\t})\n\tStyle.new(\"UIGradient\", {\n\t\tTransparency = NumberSequence.new({\n\t\t\tNumberSequenceKeypoint.new(0, 1),\n\t\t\tNumberSequenceKeypoint.new(0.25, 0.1),\n\t\t\tNumberSequenceKeypoint.new(0.75, 0.1),\n\t\t\tNumberSequenceKeypoint.new(1, 1),\n\t\t}),\n\t\tParent = announceBand,\n\t})\n\tfor i, y in { 0, 1 } do\n\t\tlocal edge = Style.new(\"Frame\", {\n\t\t\tName = \"Edge\" .. i,\n\t\t\tBackgroundColor3 = C.Pink,\n\t\t\tBorderSizePixel = 0,\n\t\t\tSize = UDim2.new(1, 0, 0, 4),\n\t\t\tAnchorPoint = Vector2.new(0, y),\n\t\t\tPosition = UDim2.fromScale(0, y),\n\t\t\tZIndex = 4,\n\t\t\tParent = announceBand,\n\t\t})\n\t\tStyle.new(\"UIGradient\", {\n\t\t\tTransparency = NumberSequence.new({\n\t\t\t\tNumberSequenceKeypoint.new(0, 1),\n\t\t\t\tNumberSequenceKeypoint.new(0.3, 0),\n\t\t\t\tNumberSequenceKeypoint.new(0.7, 0),\n\t\t\t\tNumberSequenceKeypoint.new(1, 1),\n\t\t\t}),\n\t\t\tParent = edge,\n\t\t})\n\tend\n\tannounce = Style.label(frame, \"\", 130, {\n\t\tName = \"Announce\",\n\t\tFontFace = ITALIC,\n\t\tSize = UDim2.new(1, 0, 0, 160),\n\t\tAnchorPoint = Vector2.new(0.5, 0.5),\n\t\tPosition = UDim2.fromScale(0.5, 0.4),\n\t\tRotation = ANNOUNCE_TILT,\n\t\tTextTransparency = 1,\n\t\tZIndex = 5,\n\t})\n\tlocal ast = Style.textStroke(announce, Color3.fromRGB(20, 0, 60), 5)\n\tast.Transparency = 1\n\tStyle.new(\"UIScale\", { Parent = announce })\n\tchipsFrame = Style.new(\"Frame\", {\n\t\tName = \"Chips\",\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(440, 44),\n\t\tAnchorPoint = Vector2.new(0, 1),\n\t\tPosition = UDim2.new(0, 18, 1, -146),\n\t\tParent = frame,\n\t})\n\tStyle.new(\"UIListLayout\", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = chipsFrame })\n\tmakeChip(\"GUN\", 1, Color3.fromRGB(90, 220, 255))\n\tmakeChip(\"BOMB\", 2, Color3.fromRGB(255, 160, 60))\n\tmakeChip(\"POD\", 3, Color3.fromRGB(190, 255, 90))\n\tmakeChip(\"DASH\", 4, Color3.fromRGB(255, 255, 255))\n\n\tvignette = Style.new(\"Frame\", {\n\t\tName = \"Vignette\",\n\t\tBackgroundColor3 = Color3.fromRGB(255, 0, 40),\n\t\tBackgroundTransparency = 1,\n\t\tBorderSizePixel = 0,\n\t\tSize = UDim2.fromScale(1, 1),\n\t\tParent = bgRoot,\n\t})\n\tStyle.new(\"UIGradient\", {\n\t\tTransparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 1), NumberSequenceKeypoint.new(1, 0) }),\n\t\tParent = vignette,\n\t})\n\n\treticle = Style.new(\"Frame\", {\n\t\tName = \"Reticle\",\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(84, 84),\n\t\tAnchorPoint = Vector2.new(0.5, 0.5),\n\t\tVisible = false,\n\t\tParent = worldRoot,\n\t})\n\tlocal ring = Style.new(\"Frame\", {\n\t\tName = \"Ring\",\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromScale(0.8, 0.8),\n\t\tPosition = UDim2.fromScale(0.5, 0.5),\n\t\tAnchorPoint = Vector2.new(0.5, 0.5),\n\t\tParent = reticle,\n\t})\n\tStyle.corner(ring, 100)\n\tStyle.new(\"UIStroke\", { Color = Color3.fromRGB(255, 70, 140), Thickness = 4, Parent = ring })\n\tfor i = 0, 3 do\n\t\tlocal tick = Style.new(\"Frame\", {\n\t\t\tBackgroundColor3 = Color3.fromRGB(255, 70, 140),\n\t\t\tBorderSizePixel = 0,\n\t\t\tSize = UDim2.fromOffset(6, 18),\n\t\t\tAnchorPoint = Vector2.new(0.5, 0.5),\n\t\t\tPosition = UDim2.fromScale(0.5 + 0.5 * math.sin(i * math.pi / 2), 0.5 - 0.5 * math.cos(i * math.pi / 2)),\n\t\t\tRotation = i * 90,\n\t\t\tParent = ring,\n\t\t})\n\t\tStyle.corner(tick, 3)\n\tend\nend\n\nfunction HUD.Start(info)\n\tHUD.Stop()\n\tframe.Visible = true\n\tlocal localModel = info.localModel\n\tlocal rivalSlot = 0\n\tfor _, r in ipairs(info.roster) do\n\t\tlocal model = r.model\n\t\tif model then\n\t\t\tlocal isLocal = model == localModel\n\t\t\tif isLocal then\n\t\t\t\tmakePanel(model, 1, true)\n\t\t\telse\n\t\t\t\trivalSlot += 1\n\t\t\t\tmakePanel(model, rivalSlot, false)\n\t\t\tend\n\t\t\tmakeTag(model, isLocal)\n\t\tend\n\tend\n\ttimerLabel.Text = Util.fmtTime(info.duration)\n\tHUD.ClearAnnounce()\nend\n\nfunction HUD.Stop()\n\tframe.Visible = false\n\tfor _, p in pairs(panels) do\n\t\tp.frame:Destroy()\n\tend\n\tpanels = {}\n\tfor _, t in pairs(tags) do\n\t\tt.bb:Destroy()\n\tend\n\ttags = {}\n\treticle.Visible = false\n\treticleTarget = nil\n\tfor _, p in ipairs(popups) do\n\t\tp.frame:Destroy()\n\tend\n\ttable.clear(popups)\n\tHUD.ClearAnnounce()\nend\n\nfunction HUD.SetTarget(model: Model?)\n\treticleTarget = model\nend\n\nlocal function place(frame: GuiObject, worldPos: Vector3, camera: Camera, scale: number)\n\tlocal v = camera:WorldToViewportPoint(worldPos)\n\tif v.Z <= 0 then\n\t\tframe.Visible = false\n\t\treturn\n\tend\n\tframe.Visible = true\n\tframe.Position = UDim2.fromOffset(v.X / scale, v.Y / scale)\nend\n\n-- Call after the camera has been positioned for this frame.\nfunction HUD.UpdateWorld()\n\tif not frame.Visible then\n\t\treturn\n\tend\n\tlocal camera = workspace.CurrentCamera\n\tlocal scale = getScale()\n\tfor model, t in pairs(tags) do\n\t\tlocal a = t.adornee\n\t\tif model.Parent and a and a.Parent then\n\t\t\tplace(t.bb, a.Position + Vector3.new(0, 3.4, 0), camera, scale)\n\t\telse\n\t\t\tt.bb.Visible = false\n\t\tend\n\tend\n\tlocal tr = reticleTarget and reticleTarget.Parent and reticleTarget:FindFirstChild(\"HumanoidRootPart\") :: BasePart?\n\tif reticleTarget and tr then\n\t\tplace(reticle, tr.Position + Vector3.new(0, tonumber(reticleTarget:GetAttribute(\"AimY\")) or 0, 0), camera, scale)\n\telse\n\t\treticle.Visible = false\n\tend\n\tlocal clock = os.clock()\n\tfor i = #popups, 1, -1 do\n\t\tlocal p = popups[i]\n\t\tlocal a = (clock - p.t0) / 0.75\n\t\tif a >= 1 then\n\t\t\tp.frame:Destroy()\n\t\t\ttable.remove(popups, i)\n\t\telse\n\t\t\tlocal rise = 1 + 3.2 * (1 - (1 - a) * (1 - a))\n\t\t\tplace(p.frame, p.pos + Vector3.new(0, rise, 0), camera, scale)\n\t\tend\n\tend\nend\n\nfunction HUD.Update(dt: number, endTime: number?, lockedTimer: number?)\n\tif not frame.Visible then\n\t\treturn\n\tend\n\tlocal serverNow = workspace:GetServerTimeNow()\n\tif lockedTimer then\n\t\ttimerLabel.Text = Util.fmtTime(lockedTimer)\n\telseif endTime then\n\t\tlocal remain = endTime - serverNow\n\t\ttimerLabel.Text = Util.fmtTime(remain)\n\t\ttimerLabel.TextColor3 = remain <= 10 and C.Red or Color3.new(1, 1, 1)\n\tend\n\tlocal tk = 1 - math.exp(-dt * 10)\n\tfor model, p in pairs(panels) do\n\t\tif model.Parent then\n\t\t\tlocal hp = model:GetAttribute(\"HP\") or 1000\n\t\t\tlocal maxHp = model:GetAttribute(\"MaxHP\") or 1000\n\t\t\tif hp < p.lastHp then\n\t\t\t\tp.trailHold = os.clock() + 0.45\n\t\t\tend\n\t\t\tp.lastHp = hp\n\t\t\tp.shownHp += (hp - p.shownHp) * tk\n\t\t\tif math.abs(hp - p.shownHp) < 1 then\n\t\t\t\tp.shownHp = hp\n\t\t\tend\n\t\t\tif not p.trailHold or os.clock() > p.trailHold then\n\t\t\t\tp.trailHp += (hp - p.trailHp) * (1 - math.exp(-dt * 4))\n\t\t\tend\n\t\t\tp.hpText.Text = tostring(math.floor(p.shownHp + 0.5))\n\t\t\tp.fill.Size = UDim2.fromScale(math.clamp(p.shownHp / maxHp, 0, 1), 1)\n\t\t\tp.trail.Size = UDim2.fromScale(math.clamp(p.trailHp / maxHp, 0, 1), 1)\n\t\t\tlocal pct = hp / maxHp\n\t\t\tp.hpText.TextColor3 = pct <= 0.25 and C.Red or Color3.new(1, 1, 1)\n\t\t\tsetPips(p.pips, model:GetAttribute(\"Pips\") or 3)\n\t\tend\n\tend\n\tlocal clock = os.clock()\n\tfor model, t in pairs(tags) do\n\t\tif model.Parent then\n\t\t\tt.hp.Text = tostring(model:GetAttribute(\"HP\") or 1000)\n\t\t\tsetPips(t.pips, model:GetAttribute(\"Pips\") or 3)\n\t\t\tif t.comboUntil > 0 and clock > t.comboUntil then\n\t\t\t\tt.comboUntil = 0\n\t\t\t\tTweenService:Create(t.combo, TweenInfo.new(0.25), { TextTransparency = 1 }):Play()\n\t\t\t\tTweenService:Create(t.comboStroke, TweenInfo.new(0.25), { Transparency = 1 }):Play()\n\t\t\tend\n\t\tend\n\tend\n\tif reticle.Visible then\n\t\tlocal ring = reticle:FindFirstChild(\"Ring\") :: Frame\n\t\tring.Rotation = (clock * 90) % 360\n\t\tlocal s = 1 + 0.06 * math.sin(clock * 8)\n\t\tring.Size = UDim2.fromScale(0.8 * s, 0.8 * s)\n\tend\n\n\t-- Local weapon readiness\n\tlocal m = State.localModel\n\tif m and m.Parent then\n\t\tlocal loadout = Config.GetLoadout(m:GetAttribute(\"RobotId\") or \"Bolt\")\n\t\tlocal keys = KEYS[State.lastInput] or KEYS.Keyboard\n\t\tlocal reloadUntil = m:GetAttribute(\"ReloadUntil\") or 0\n\t\tlocal gunReadyAt = m:GetAttribute(\"GunReadyAt\") or 0\n\t\tlocal gun = loadout.Gun\n\t\tif serverNow < reloadUntil then\n\t\t\tlocal k = 1 - (reloadUntil - serverNow) / (gun.Reload + gun.Cooldown)\n\t\t\tsetChip(\"GUN\", k, \"RELOAD\")\n\t\telseif serverNow < gunReadyAt then\n\t\t\tsetChip(\"GUN\", 1 - (gunReadyAt - serverNow) / gun.Cooldown, keys.Gun)\n\t\telse\n\t\t\tlocal ammo = m:GetAttribute(\"Ammo\")\n\t\t\tlocal clip = m:GetAttribute(\"Clip\") or 0\n\t\t\tsetChip(\"GUN\", 1, clip > 0 and (string.rep(\"•\", ammo or clip) .. \"  \" .. keys.Gun) or keys.Gun)\n\t\tend\n\t\tlocal b = m:GetAttribute(\"BombReadyAt\") or 0\n\t\tsetChip(\"BOMB\", 1 - math.max(0, b - serverNow) / loadout.Bomb.Cooldown, keys.Bomb)\n\t\tlocal pd = m:GetAttribute(\"PodReadyAt\") or 0\n\t\tsetChip(\"POD\", 1 - math.max(0, pd - serverNow) / loadout.Pod.Cooldown, keys.Pod)\n\t\tlocal dashK = State.dashReady01 or 1\n\t\tsetChip(\"DASH\", dashK, keys.Dash)\n\tend\nend\n\nfunction HUD.SetChipsVisible(v: boolean)\n\tchipsFrame.Visible = v\nend\n\nreturn HUD\n","message":"The file /Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/HUD.luau has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"toolu_01JrVRzy9pTDG7LTC3tdp9hA","startedAtMs":"1791075935664","completedAtMs":"1791075941715"},"model_call_id":"9f87d2a3-a097-4b92-978f-ec64b826b4ce-61-wccv","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791075941721}
