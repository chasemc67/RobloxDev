ction(player, action, arg)\n\tif typeof(action) ~= \"string\" or not allow(player) then\n\t\treturn\n\tend\n\tlocal s = MatchService.GetSession(player)\n\tif action == \"Select\" then\n\t\tif typeof(arg) == \"string\" and Config.RobotById[arg] and s.status ~= \"Match\" then\n\t\t\ts.robotId = arg\n\t\tend\n\telseif action == \"Queue\" then\n\t\tMatchmaking.Enqueue(player)\n\telseif action == \"CancelQueue\" then\n\t\tMatchmaking.Dequeue(player)\n\telseif action == \"Bot\" then\n\t\tif s.status == \"Queue\" then\n\t\t\tMatchmaking.Dequeue(player)\n\t\tend\n\t\tMatchService.StartBotMatch(player)\n\telseif action == \"Rematch\" then\n\t\tMatchService.RequestRematch(player)\n\telseif action == \"Back\" then\n\t\tif s.status == \"Queue\" then\n\t\t\tMatchmaking.Dequeue(player)\n\t\tend\n\t\tMatchService.LeaveResults(player)\n\tend\nend)\n\nPlayers.PlayerAdded:Connect(function(player)\n\tMatchService.GetSession(player)\nend)\nfor _, p in ipairs(Players:GetPlayers()) do\n\tMatchService.GetSession(p)\nend\nPlayers.PlayerRemoving:Connect(function(player)\n\tbuckets[player] = nil\nend)\n\nRunService.Heartbeat:Connect(function(dt)\n\tMatchService.Step(math.min(dt, 1 / 20))\nend)\n\n-- Studio-only test hook (used by MCP playtests); never active in live servers.\nif RunService:IsStudio() then\n\tlocal hook = Instance.new(\"BindableFunction\")\n\thook.Name = \"RoboClashDebug\"\n\thook.OnInvoke = function(cmd, ...)\n\t\tlocal args = { ... }\n\t\tif cmd == \"fake\" then\n\t\t\tMatchmaking.EnqueueFake(args[1] or \"Crusher\", args[2])\n\t\t\treturn \"fake queued\"\n\t\telseif cmd == \"state\" then\n\t\t\tlocal out = {}\n\t\t\tfor id, m in pairs(MatchService.matches) do\n\t\t\t\tlocal cs = {}\n\t\t\t\tfor _, c in ipairs(m.combatants) do\n\t\t\t\t\ttable.insert(cs, string.format(\"%s %s hp=%d st=%s pips=%d alive=%s\", c.tag, c.participant.robotId, c.hp, c.state, math.ceil(c.endurance / 100), tostring(c.alive)))\n\t\t\t\tend\n\t\t\t\ttable.insert(out, string.format(\"match %d mode=%s state=%s :: %s\", id, m.mode, m.state, table.concat(cs, \" | \")))\n\t\t\tend\n\t\t\tlocal q = {}\n\t\t\tfor _, e in ipairs(Matchmaking.queue) do\n\t\t\t\ttable.insert(q, e.player and e.player.Name or (\"fake:\" .. e.robotId))\n\t\t\tend\n\t\t\tlocal ss = {}\n\t\t\tfor p, s in pairs(MatchService.sessions) do\n\t\t\t\ttable.insert(ss, p.Name .. \"=\" .. s.status .. \"/\" .. s.robotId)\n\t\t\tend\n\t\t\treturn table.concat(out, \"\\n\") .. \"\\nqueue: \" .. table.concat(q, \",\") .. \"\\nsessions: \" .. table.concat(ss, \",\")\n\t\telseif cmd == \"damage\" then\n\t\t\tfor _, m in pairs(MatchService.matches) do\n\t\t\t\tfor _, c in ipairs(m.combatants) do\n\t\t\t\t\tif (args[1] == \"bot\" and c.participant.kind == \"Bot\") or (args[1] == \"player\" and c.participant.kind == \"Player\") then\n\t\t\t\t\t\tCombat.Damage(m, c, args[2] or 100, nil, { downPower = args[3] or 0, knock = 20, up = 10 })\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\treturn \"ok\"\n\t\telseif cmd == \"time\" then\n\t\t\tfor _, m in pairs(MatchService.matches) do\n\t\t\t\tif m.endTime then\n\t\t\t\t\tm.endTime = Combat.now() + (args[1] or 3)\n\t\t\t\tend\n\t\t\tend\n\t\t\treturn \"ok\"\n\t\telseif cmd == \"botidle\" then\n\t\t\tfor _, m in pairs(MatchService.matches) do\n\t\t\t\tfor _, c in ipairs(m.combatants) do\n\t\t\t\t\tif c.ai then\n\t\t\t\t\t\tc.ai.idle = args[1] == true\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\treturn \"ok\"\n\t\tend\n\t\treturn \"unknown\"\n\tend\n\thook.Parent = game:GetService(\"ServerScriptService\")\nend\n"},"result":{"success":{"path":"/Users/chase-mini/src/rca-work/src/ServerScriptService/RoboClash/Main.server.luau","linesAdded":152,"linesRemoved":0,"diffString":"--- /dev/null\n+++ b//Users/chase-mini/src/rca-work/src/ServerScriptService/RoboClash/Main.server.luau\n@@ -1,0 +1,152 @@\n+-- Robo Clash Arena server entry: wires remotes to services and steps matches.\n+local Players = game:GetService(\"Players\")\n+local ReplicatedStorage = game:GetService(\"ReplicatedS