{"type":"tool_call","subtype":"completed","call_id":"toolu_01CRMan8wmYcMxMHfqxDnbsz","tool_call":{"readToolCall":{"args":{"path":"/Users/chase-mini/src/rca-work/src/ReplicatedStorage/RoboClash/Config.luau","limit":20},"result":{"success":{"content":"--!nocheck\n-- Robo Clash Arena: all tunables. Parts (Bodies/Guns/Bombs/Pods/Legs) are separate tables so\n-- part customization can mix and match later; Robots just reference part ids.\n\nlocal Config = {}\n\nConfig.Match = {\n\tMaxHP = 1000,\n\tDuration = 180, -- seconds\n\tIntroTime = 4.4, -- from match start until LAUNCH! (controls locked)\n\tKOFreezeTime = 1.2, -- time freeze after KO before the victory pose\n\tResultsDelay = 4.2, -- KO -> results screen\n\tDownTime = 1.7,\n\tRebirthTime = 2.6,\n\tDownDamageMult = 0.15,\n\tEnduranceMax = 300, -- 3 DOWN pips x 100\n\tEndurancePerPip = 100,\n\tEnduranceRegenDelay = 2.2,\n\tEnduranceRegenRate = 40, -- per second\n\tFlinchTime = 0.18,","isEmpty":false,"exceededLimit":false,"totalLines":425,"fileSize":9590,"path":"/Users/chase-mini/src/rca-work/src/ReplicatedStorage/RoboClash/Config.luau","readRange":{"startLine":1,"endLine":20},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"toolu_01CRMan8wmYcMxMHfqxDnbsz","startedAtMs":"1791076781231","completedAtMs":"1791076781937"},"model_call_id":"9f87d2a3-a097-4b92-978f-ec64b826b4ce-140-kfhd","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791076781943}
{"type":"tool_call","subtype":"started","call_id":"toolu_01GPvvupsWcU5F6RZVZSZRMs","tool_call":{"editToolCall":{"args":{"path":"/Users/chase-mini/src/rca-work/src/ReplicatedStorage/RoboClash/Config.luau","streamContent":"\tDamageScale = 0.7, -- global pacing knob: aim for 45-60 s matches between active players\n\tDownDamageMult = 0.15,"}},"hookAdditionalContexts":[],"toolCallId":"toolu_01GPvvupsWcU5F6RZVZSZRMs","startedAtMs":"1791076784034"},"model_call_id":"9f87d2a3-a097-4b92-978f-ec64b826b4ce-141-2tkh","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791076785477}
{"type":"tool_call","subtype":"completed","call_id":"toolu_01GPvvupsWcU5F6RZVZSZRMs","tool_call":{"editToolCall":{"args":{"path":"/Users/chase-mini/src/rca-work/src/ReplicatedStorage/RoboClash/Config.luau","streamContent":"\tDamageScale = 0.7, -- global pacing knob: aim for 45-60 s matches between active players\n\tDownDamageMult = 0.15,"},"result":{"success":{"path":"/Users/chase-mini/src/rca-work/src/ReplicatedStorage/RoboClash/Config.luau","linesAdded":1,"linesRemoved":0,"diffString":"--- a//Users/chase-mini/src/rca-work/src/ReplicatedStorage/RoboClash/Config.luau\n+++ b//Users/chase-mini/src/rca-work/src/ReplicatedStorage/RoboClash/Config.luau\n@@ -12,6 +12,7 @@\n \tResultsDelay = 4.2, -- KO -> results screen\n \tDownTime = 1.7,\n \tRebirthTime = 2.6,\n+\tDamageScale = 0.7, -- global pacing knob: aim for 45-60 s matches between active players\n \tDownDamageMult = 0.15,\n \tEnduranceMax = 300, -- 3 DOWN pips x 100\n \tEndurancePerPip = 100,","beforeFullFileContent":"--!nocheck\n-- Robo Clash Arena: all tunables. Parts (Bodies/Guns/Bombs/Pods/Legs) are separate tables so\n-- part customization can mix and match later; Robots just reference part ids.\n\nlocal Config = {}\n\nConfig.Match = {\n\tMaxHP = 1000,\n\tDuration = 180, -- seconds\n\tIntroTime = 4.4, -- from match start until LAUNCH! (controls locked)\n\tKOFreezeTime = 1.2, -- time freeze after KO before the victory pose\n\tResultsDelay = 4.2, -- KO -> results screen\n\tDownTime = 1.7,\n\tRebirthTime = 2.6,\n\tDownDamageMult = 0.15,\n\tEnduranceMax = 300, -- 3 DOWN pips x 100\n\tEndurancePerPip = 100,\n\tEnduranceRegenDelay = 2.2,\n\tEnduranceRegenRate = 40, -- per second\n\tFlinchTime = 0.18,\n\tPitDamage = 100,\n\tPitInvuln = 1.5,\n\tPitFallDepth = 22, -- studs below floor that counts as fallen\n\tArenaSpacing = 500,\n\tArenaBaseX = 1000,\n\tArenaHeight = 300,\n\tSpawnRadius = 40,\n\tComboWindow = 1.3,\n\tGravity = 60,\n\tRobotRadius = 2.3, -- hit capsule radius\n\tRobotCapsuleDown = 3.2, -- capsule from root - this ...\n\tRobotCapsuleUp = 2.8, -- ... to root + this\n\tRematchTimeout = 30,\n\tIntentRateLimit = 30, -- max intents per second per player\n}\n\nConfig.Arena = {\n\tHalf = 55, -- arena is 110 x 110 studs\n\tWallHeight = 9,\n\tBarrierHeight = 70,\n}\n\nConfig.TeamColors = {\n\tColor3.fromRGB(70, 170, 255), -- P1\n\tColor3.fromRGB(255, 70, 95), -- P2\n\tColor3.fromRGB(255, 205, 60), -- P3\n\tColor3.fromRGB(90, 235, 120), -- P4\n}\n\n-- Bodies: chassis stats + body dash attack.\nConfig.Bodies = {\n\tBoltFrame = {\n\t\tName = \"Bolt Frame\",\n\t\tKnockbackMult = 1.0,\n\t\tDashAttack = { Name = \"Shoulder Charge\", Damage = 45, Knock = 55, Up = 18, DownPower = 60 },\n\t},\n\tCrusherHull = {\n\t\tName = \"Crusher Hull\",\n\t\tKnockbackMult = 0.7,\n\t\tDashAttack = { Name = \"Iron Ram\", Damage = 75, Knock = 75, Up = 24, DownPower = 110 },\n\t},\n\tLancerSpire = {\n\t\tName = \"Lancer Spire\",\n\t\tKnockbackMult = 1.2,\n\t\tDashAttack = { Name = \"Lance Thrust\", Damage = 40, Knock = 50, Up = 16, DownPower = 50 },\n\t},\n}\n\n-- Legs: movement. JumpPower is jump velocity (studs/s) under Config.Match.Gravity.\nConfig.Legs = {\n\tStrikerLegs = {\n\t\tName = \"Striker Legs\",\n\t\tBlurb = \"Double jump\",\n\t\tWalkSpeed = 24,\n\t\tJumpPower = 40,\n\t\tAirJumps = 1,\n\t\tAirDashes = 1,\n\t\tAirDashSpeed = 52,\n\t\tAirDashTime = 0.22,\n\t\tHover = 0,\n\t\tDashSpeed = 72,\n\t\tDashTime = 0.24,\n\t\tDashCooldown = 0.75,\n\t},\n\tTankLegs = {\n\t\tName = \"Tank Legs\",\n\t\tBlurb = \"Hold jump to hover\",\n\t\tWalkSpeed = 20,\n\t\tJumpPower = 37,\n\t\tAirJumps = 0,\n\t\tAirDashes = 0,\n\t\tAirDashSpeed = 0,\n\t\tAirDashTime = 0,\n\t\tHover = 1.4, -- seconds of hover per jump\n\t\tHoverFall = 2.5, -- max fall speed while hovering\n\t\tDashSpeed = 88,\n\t\tDashTime = 0.3,\n\t\tDashCooldown = 0.95,\n\t},\n\tGlideLegs = {\n\t\tName = \"Glide Legs\",\n\t\tBlurb = \"Two fast air dashes\",\n\t\tWalkSpeed = 23,\n\t\tJumpPower = 42,\n\t\tAirJumps = 0,\n\t\tAirDashes = 2,\n\t\tAirDashSpeed = 78,\n\t\tAirDashTime = 0.24,\n\t\tHover = 0,\n\t\tDashSpeed = 68,\n\t\tDashTime = 0.22,\n\t\tDashCooldown = 0.7,\n\t},\n}\n\n-- Guns (right hand). Turn = homing in degrees/second toward the locked target.\nConfig.Guns = {\n\tRapidBlaster = {\n\t\tName = \"Rapid Blaster\",\n\t\tBlurb = \"3-round homing bursts\",\n\t\tType = \"Burst\",\n\t\tShots = 3,\n\t\tShotInterval = 0.1,\n\t\tDamage = 28,\n\t\tSpeed = 110,\n\t\tTurn = 95,\n\t\tLife = 1.4,\n\t\tRadius = 0.7,\n\t\tDownPower = 24,\n\t\tKnock = 10,\n\t\tUp = 4,\n\t\tClip = 3,\n\t\tReload = 1.4,\n\t\tCooldown = 0.5,\n\t\tMoveSlow = 0.55,\n\t\tSlowTime = 0.35,\n\t\tColor = Color3.fromRGB(90, 220, 255),\n\t\tSize = 0.9,\n\t},\n\tScatterCannon = {\n\t\tName = \"Scatter Cannon\",\n\t\tBlurb = \"5-way close-range spread\",\n\t\tType = \"Spread\",\n\t\tPellets = 5,\n\t\tSpreadDeg = 46,\n\t\tDamage = 26,\n\t\tSpeed = 92,\n\t\tTurn = 22,\n\t\tLife = 0.6,\n\t\tRadius = 0.9,\n\t\tDownPower = 28,\n\t\tKnock = 26,\n\t\tUp = 8,\n\t\tClip = 2,\n\t\tReload = 1.5,\n\t\tCooldown = 0.8,\n\t\tMoveSlow = 0.35,\n\t\tSlowTime = 0.4,\n\t\tColor = Color3.fromRGB(255, 150, 60),\n\t\tSize = 1.0,\n\t},\n\tChargeLaser = {\n\t\tName = \"Charge Laser\",\n\t\tBlurb = \"Hold to charge a piercing beam\",\n\t\tType = \"Charge\",\n\t\tChargeTime = 0.8,\n\t\tChargeMoveSlow = 0.45,\n\t\tCooldown = 0.45,\n\t\tMoveSlow = 0.3,\n\t\tSlowTime = 0.35,\n\t\tTap = {\n\t\t\tDamage = 34,\n\t\t\tSpeed = 150,\n\t\t\tTurn = 70,\n\t\t\tLife = 1.0,\n\t\t\tRadius = 0.7,\n\t\t\tDownPower = 35,\n\t\t\tKnock = 14,\n\t\t\tUp = 5,\n\t\t\tSize = 0.8,\n\t\t},\n\t\tFull = {\n\t\t\tDamage = 150,\n\t\t\tSpeed = 250,\n\t\t\tTurn = 22,\n\t\t\tLife = 0.75,\n\t\t\tRadius = 1.4,\n\t\t\tDownPower = 300,\n\t\t\tForceDown = true,\n\t\t\tKnock = 60,\n\t\t\tUp = 22,\n\t\t\tSize = 1.6,\n\t\t},\n\t\tColor = Color3.fromRGB(170, 255, 90),\n\t},\n}\n\n-- Bombs (left hand): high arc toward the target that clears walls, lingering blast.\nConfig.Bombs = {\n\tArcBomb = {\n\t\tName = \"Arc Bomb\",\n\t\tBlurb = \"Lingering splash blast\",\n\t\tCount = 1,\n\t\tSpread = 0,\n\t\tDamage = 90,\n\t\tRadius = 10,\n\t\tLinger = 0.9,\n\t\tFlightTime = 1.15,\n\t\tApex = 24,\n\t\tMaxRange = 78,\n\t\tMinRange = 10,\n\t\tLead = 0.5,\n\t\tCooldown = 2.6,\n\t\tDownPower = 75,\n\t\tKnock = 40,\n\t\tUp = 26,\n\t\tStall = 0.25,\n\t\tColor = Color3.fromRGB(80, 160, 255),\n\t},\n\tQuakeBomb = {\n\t\tName = \"Quake Bomb\",\n\t\tBlurb = \"Slow, huge heavy blast\",\n\t\tCount = 1,\n\t\tSpread = 0,\n\t\tDamage = 120,\n\t\tRadius = 13.5,\n\t\tLinger = 1.0,\n\t\tFlightTime = 1.45,\n\t\tApex = 28,\n\t\tMaxRange = 68,\n\t\tMinRange = 8,\n\t\tLead = 0.35,\n\t\tCooldown = 3.2,\n\t\tDownPower = 110,\n\t\tKnock = 52,\n\t\tUp = 30,\n\t\tStall = 0.35,\n\t\tColor = Color3.fromRGB(255, 90, 40),\n\t},\n\tTripleBomb = {\n\t\tName = \"Triple Bomb\",\n\t\tBlurb = \"Three small lobs in a line\",\n\t\tCount = 3,\n\t\tSpread = 9,\n\t\tDamage = 50,\n\t\tRadius = 7,\n\t\tLinger = 0.8,\n\t\tFlightTime = 1.05,\n\t\tApex = 22,\n\t\tMaxRange = 85,\n\t\tMinRange = 10,\n\t\tLead = 0.5,\n\t\tCooldown = 2.8,\n\t\tDownPower = 45,\n\t\tKnock = 30,\n\t\tUp = 20,\n\t\tStall = 0.25,\n\t\tColor = Color3.fromRGB(230, 255, 80),\n\t},\n}\n\n-- Pods (back): slow deployables.\nConfig.Pods = {\n\tSeekerPod = {\n\t\tName = \"Seeker Pod\",\n\t\tBlurb = \"Slow, relentless homing orb\",\n\t\tType = \"Seeker\",\n\t\tCount = 1,\n\t\tSpeed = 15,\n\t\tTurn = 200,\n\t\tClimbRate = 6,\n\t\tLife = 5,\n\t\tDamage = 80,\n\t\tRadius = 7,\n\t\tTriggerRadius = 3.4,\n\t\tDownPower = 70,\n\t\tKnock = 36,\n\t\tUp = 22,\n\t\tCooldown = 4.5,\n\t\tMaxActive = 2,\n\t\tHoverHeight = 3,\n\t\tColor = Color3.fromRGB(120, 200, 255),\n\t\tSize = 2.2,\n\t},\n\tMinePod = {\n\t\tName = \"Mine Pod\",\n\t\tBlurb = \"Proximity mine trap\",\n\t\tType = \"Mine\",\n\t\tCount = 1,\n\t\tLife = 8,\n\t\tArmTime = 0.7,\n\t\tThrowDist = 10,\n\t\tThrowTime = 0.45,\n\t\tDamage = 100,\n\t\tRadius = 9,\n\t\tTriggerRadius = 7.5,\n\t\tDownPower = 110,\n\t\tKnock = 46,\n\t\tUp = 30,\n\t\tCooldown = 4.0,\n\t\tMaxActive = 2,\n\t\tColor = Color3.fromRGB(255, 70, 50),\n\t\tSize = 2.4,\n\t},\n\tOrbitPod = {\n\t\tName = \"Orbit Pod\",\n\t\tBlurb = \"Twin drifting orbs\",\n\t\tType = \"Orbit\",\n\t\tCount = 2,\n\t\tSpeed = 13,\n\t\tTurn = 150,\n\t\tLaunchSide = 7,\n\t\tLaunchTime = 0.45,\n\t\tLife = 6,\n\t\tDamage = 50,\n\t\tRadius = 6,\n\t\tTriggerRadius = 3.2,\n\t\tDownPower = 50,\n\t\tKnock = 28,\n\t\tUp = 18,\n\t\tCooldown = 5,\n\t\tMaxActive = 4,\n\t\tColor = Color3.fromRGB(220, 255, 120),\n\t\tSize = 1.8,\n\t},\n}\n\nConfig.Robots = {\n\t{\n\t\tId = \"Bolt\",\n\t\tDisplayName = \"BOLT\",\n\t\tRole = \"ALL-ROUNDER\",\n\t\tDescription = \"Sleek and nimble. Homing bursts, a reliable bomb and a seeker pod.\",\n\t\tPrimary = Color3.fromRGB(40, 110, 230),\n\t\tSecondary = Color3.fromRGB(235, 240, 250),\n\t\tNeon = Color3.fromRGB(80, 230, 255),\n\t\tBody = \"BoltFrame\",\n\t\tGun = \"RapidBlaster\",\n\t\tBomb = \"ArcBomb\",\n\t\tPod = \"SeekerPod\",\n\t\tLegs = \"StrikerLegs\",\n\t\tPreferredRange = 32,\n\t\tStats = { Power = 3, Range = 3, Speed = 4, Mobility = 4, Defense = 3 },\n\t},\n\t{\n\t\tId = \"Crusher\",\n\t\tDisplayName = \"CRUSHER\",\n\t\tRole = \"BRUISER\",\n\t\tDescription = \"Bulky close-range grappler. Shotgun spread, quake bombs, mines.\",\n\t\tPrimary = Color3.fromRGB(205, 40, 40),\n\t\tSecondary = Color3.fromRGB(60, 60, 68),\n\t\tNeon = Color3.fromRGB(255, 150, 40),\n\t\tBody = \"CrusherHull\",\n\t\tGun = \"ScatterCannon\",\n\t\tBomb = \"QuakeBomb\",\n\t\tPod = \"MinePod\",\n\t\tLegs = \"TankLegs\",\n\t\tPreferredRange = 15,\n\t\tStats = { Power = 5, Range = 1, Speed = 2, Mobility = 2, Defense = 5 },\n\t},\n\t{\n\t\tId = \"Lancer\",\n\t\tDisplayName = \"LANCER\",\n\t\tRole = \"SNIPER\",\n\t\tDescription = \"Tall long-range sniper. Charge laser, triple bombs, twin orbs.\",\n\t\tPrimary = Color3.fromRGB(70, 190, 70),\n\t\tSecondary = Color3.fromRGB(245, 215, 50),\n\t\tNeon = Color3.fromRGB(190, 255, 90),\n\t\tBody = \"LancerSpire\",\n\t\tGun = \"ChargeLaser\",\n\t\tBomb = \"TripleBomb\",\n\t\tPod = \"OrbitPod\",\n\t\tLegs = \"GlideLegs\",\n\t\tPreferredRange = 52,\n\t\tStats = { Power = 4, Range = 5, Speed = 3, Mobility = 5, Defense = 2 },\n\t},\n}\n\nConfig.RobotById = {}\nfor i, r in ipairs(Config.Robots) do\n\tr.Index = i\n\tConfig.RobotById[r.Id] = r\nend\n\nfunction Config.GetLoadout(robotId)\n\tlocal r = Config.RobotById[robotId] or Config.Robots[1]\n\treturn {\n\t\tRobot = r,\n\t\tBody = Config.Bodies[r.Body],\n\t\tGun = Config.Guns[r.Gun],\n\t\tBomb = Config.Bombs[r.Bomb],\n\t\tPod = Config.Pods[r.Pod],\n\t\tLegs = Config.Legs[r.Legs],\n\t}\nend\n\n-- Sound ids (rbxassetid). Filled in from Creator Store / Roblox official audio.\n-- Free Creator Store audio (mostly Pro Sound Effects / APM Music / Roblox uploads), each verified to\n-- load via ContentProvider. Empty ids fall back to built-in rbxasset sounds (see Sound.luau).\nConfig.Sounds = {\n\tBlaster = \"rbxassetid://127890377497804\",\n\tShotgun = \"rbxassetid://113620717067633\",\n\tLaser = \"rbxassetid://126902544332139\",\n\tCharge = \"rbxassetid://9125973984\",\n\tBombThrow = \"rbxassetid://9120704940\",\n\tExplosion = \"rbxassetid://129993092121020\",\n\tPod = \"rbxassetid://9125648149\",\n\tHit = \"rbxassetid://9118269934\",\n\tHeavyHit = \"rbxassetid://9116673678\",\n\tDash = \"rbxassetid://9120704978\",\n\tJump = \"\",\n\tDown = \"rbxassetid://9125672726\",\n\tCountdown = \"rbxassetid://9117060349\",\n\tLaunch = \"rbxassetid://9047102381\",\n\tKO = \"rbxassetid://104577593010326\",\n\tUIMove = \"rbxassetid://139719503904449\",\n\tUISelect = \"rbxassetid://15675059323\",\n\tUIBack = \"rbxassetid://15675059323\",\n\tWin = \"rbxassetid://9045751375\",\n\tLose = \"rbxassetid://9042410252\",\n\tMusic = \"rbxassetid://9044832945\",\n}\n\nreturn Config\n","afterFullFileContent":"--!nocheck\n-- Robo Clash Arena: all tunables. Parts (Bodies/Guns/Bombs/Pods/Legs) are separate tables so\n-- part customization can mix and match later; Robots just reference part ids.\n\nlocal Config = {}\n\nConfig.Match = {\n\tMaxHP = 1000,\n\tDuration = 180, -- seconds\n\tIntroTime = 4.4, -- from match start until LAUNCH! (controls locked)\n\tKOFreezeTime = 1.2, -- time freeze after KO before the victory pose\n\tResultsDelay = 4.2, -- KO -> results screen\n\tDownTime = 1.7,\n\tRebirthTime = 2.6,\n\tDamageScale = 0.7, -- global pacing knob: aim for 45-60 s matches between active players\n\tDownDamageMult = 0.15,\n\tEnduranceMax = 300, -- 3 DOWN pips x 100\n\tEndurancePerPip = 100,\n\tEnduranceRegenDelay = 2.2,\n\tEnduranceRegenRate = 40, -- per second\n\tFlinchTime = 0.18,\n\tPitDamage = 100,\n\tPitInvuln = 1.5,\n\tPitFallDepth = 22, -- studs below floor that counts as fallen\n\tArenaSpacing = 500,\n\tArenaBaseX = 1000,\n\tArenaHeight = 300,\n\tSpawnRadius = 40,\n\tComboWindow = 1.3,\n\tGravity = 60,\n\tRobotRadius = 2.3, -- hit capsule radius\n\tRobotCapsuleDown = 3.2, -- capsule from root - this ...\n\tRobotCapsuleUp = 2.8, -- ... to root + this\n\tRematchTimeout = 30,\n\tIntentRateLimit = 30, -- max intents per second per player\n}\n\nConfig.Arena = {\n\tHalf = 55, -- arena is 110 x 110 studs\n\tWallHeight = 9,\n\tBarrierHeight = 70,\n}\n\nConfig.TeamColors = {\n\tColor3.fromRGB(70, 170, 255), -- P1\n\tColor3.fromRGB(255, 70, 95), -- P2\n\tColor3.fromRGB(255, 205, 60), -- P3\n\tColor3.fromRGB(90, 235, 120), -- P4\n}\n\n-- Bodies: chassis stats + body dash attack.\nConfig.Bodies = {\n\tBoltFrame = {\n\t\tName = \"Bolt Frame\",\n\t\tKnockbackMult = 1.0,\n\t\tDashAttack = { Name = \"Shoulder Charge\", Damage = 45, Knock = 55, Up = 18, DownPower = 60 },\n\t},\n\tCrusherHull = {\n\t\tName = \"Crusher Hull\",\n\t\tKnockbackMult = 0.7,\n\t\tDashAttack = { Name = \"Iron Ram\", Damage = 75, Knock = 75, Up = 24, DownPower = 110 },\n\t},\n\tLancerSpire = {\n\t\tName = \"Lancer Spire\",\n\t\tKnockbackMult = 1.2,\n\t\tDashAttack = { Name = \"Lance Thrust\", Damage = 40, Knock = 50, Up = 16, DownPower = 50 },\n\t},\n}\n\n-- Legs: movement. JumpPower is jump velocity (studs/s) under Config.Match.Gravity.\nConfig.Legs = {\n\tStrikerLegs = {\n\t\tName = \"Striker Legs\",\n\t\tBlurb = \"Double jump\",\n\t\tWalkSpeed = 24,\n\t\tJumpPower = 40,\n\t\tAirJumps = 1,\n\t\tAirDashes = 1,\n\t\tAirDashSpeed = 52,\n\t\tAirDashTime = 0.22,\n\t\tHover = 0,\n\t\tDashSpeed = 72,\n\t\tDashTime = 0.24,\n\t\tDashCooldown = 0.75,\n\t},\n\tTankLegs = {\n\t\tName = \"Tank Legs\",\n\t\tBlurb = \"Hold jump to hover\",\n\t\tWalkSpeed = 20,\n\t\tJumpPower = 37,\n\t\tAirJumps = 0,\n\t\tAirDashes = 0,\n\t\tAirDashSpeed = 0,\n\t\tAirDashTime = 0,\n\t\tHover = 1.4, -- seconds of hover per jump\n\t\tHoverFall = 2.5, -- max fall speed while hovering\n\t\tDashSpeed = 88,\n\t\tDashTime = 0.3,\n\t\tDashCooldown = 0.95,\n\t},\n\tGlideLegs = {\n\t\tName = \"Glide Legs\",\n\t\tBlurb = \"Two fast air dashes\",\n\t\tWalkSpeed = 23,\n\t\tJumpPower = 42,\n\t\tAirJumps = 0,\n\t\tAirDashes = 2,\n\t\tAirDashSpeed = 78,\n\t\tAirDashTime = 0.24,\n\t\tHover = 0,\n\t\tDashSpeed = 68,\n\t\tDashTime = 0.22,\n\t\tDashCooldown = 0.7,\n\t},\n}\n\n-- Guns (right hand). Turn = homing in degrees/second toward the locked target.\nConfig.Guns = {\n\tRapidBlaster = {\n\t\tName = \"Rapid Blaster\",\n\t\tBlurb = \"3-round homing bursts\",\n\t\tType = \"Burst\",\n\t\tShots = 3,\n\t\tShotInterval = 0.1,\n\t\tDamage = 28,\n\t\tSpeed = 110,\n\t\tTurn = 95,\n\t\tLife = 1.4,\n\t\tRadius = 0.7,\n\t\tDownPower = 24,\n\t\tKnock = 10,\n\t\tUp = 4,\n\t\tClip = 3,\n\t\tReload = 1.4,\n\t\tCooldown = 0.5,\n\t\tMoveSlow = 0.55,\n\t\tSlowTime = 0.35,\n\t\tColor = Color3.fromRGB(90, 220, 255),\n\t\tSize = 0.9,\n\t},\n\tScatterCannon = {\n\t\tName = \"Scatter Cannon\",\n\t\tBlurb = \"5-way close-range spread\",\n\t\tType = \"Spread\",\n\t\tPellets = 5,\n\t\tSpreadDeg = 46,\n\t\tDamage = 26,\n\t\tSpeed = 92,\n\t\tTurn = 22,\n\t\tLife = 0.6,\n\t\tRadius = 0.9,\n\t\tDownPower = 28,\n\t\tKnock = 26,\n\t\tUp = 8,\n\t\tClip = 2,\n\t\tReload = 1.5,\n\t\tCooldown = 0.8,\n\t\tMoveSlow = 0.35,\n\t\tSlowTime = 0.4,\n\t\tColor = Color3.fromRGB(255, 150, 60),\n\t\tSize = 1.0,\n\t},\n\tChargeLaser = {\n\t\tName = \"Charge Laser\",\n\t\tBlurb = \"Hold to charge a piercing beam\",\n\t\tType = \"Charge\",\n\t\tChargeTime = 0.8,\n\t\tChargeMoveSlow = 0.45,\n\t\tCooldown = 0.45,\n\t\tMoveSlow = 0.3,\n\t\tSlowTime = 0.35,\n\t\tTap = {\n\t\t\tDamage = 34,\n\t\t\tSpeed = 150,\n\t\t\tTurn = 70,\n\t\t\tLife = 1.0,\n\t\t\tRadius = 0.7,\n\t\t\tDownPower = 35,\n\t\t\tKnock = 14,\n\t\t\tUp = 5,\n\t\t\tSize = 0.8,\n\t\t},\n\t\tFull = {\n\t\t\tDamage = 150,\n\t\t\tSpeed = 250,\n\t\t\tTurn = 22,\n\t\t\tLife = 0.75,\n\t\t\tRadius = 1.4,\n\t\t\tDownPower = 300,\n\t\t\tForceDown = true,\n\t\t\tKnock = 60,\n\t\t\tUp = 22,\n\t\t\tSize = 1.6,\n\t\t},\n\t\tColor = Color3.fromRGB(170, 255, 90),\n\t},\n}\n\n-- Bombs (left hand): high arc toward the target that clears walls, lingering blast.\nConfig.Bombs = {\n\tArcBomb = {\n\t\tName = \"Arc Bomb\",\n\t\tBlurb = \"Lingering splash blast\",\n\t\tCount = 1,\n\t\tSpread = 0,\n\t\tDamage = 90,\n\t\tRadius = 10,\n\t\tLinger = 0.9,\n\t\tFlightTime = 1.15,\n\t\tApex = 24,\n\t\tMaxRange = 78,\n\t\tMinRange = 10,\n\t\tLead = 0.5,\n\t\tCooldown = 2.6,\n\t\tDownPower = 75,\n\t\tKnock = 40,\n\t\tUp = 26,\n\t\tStall = 0.25,\n\t\tColor = Color3.fromRGB(80, 160, 255),\n\t},\n\tQuakeBomb = {\n\t\tName = \"Quake Bomb\",\n\t\tBlurb = \"Slow, huge heavy blast\",\n\t\tCount = 1,\n\t\tSpread = 0,\n\t\tDamage = 120,\n\t\tRadius = 13.5,\n\t\tLinger = 1.0,\n\t\tFlightTime = 1.45,\n\t\tApex = 28,\n\t\tMaxRange = 68,\n\t\tMinRange = 8,\n\t\tLead = 0.35,\n\t\tCooldown = 3.2,\n\t\tDownPower = 110,\n\t\tKnock = 52,\n\t\tUp = 30,\n\t\tStall = 0.35,\n\t\tColor = Color3.fromRGB(255, 90, 40),\n\t},\n\tTripleBomb = {\n\t\tName = \"Triple Bomb\",\n\t\tBlurb = \"Three small lobs in a line\",\n\t\tCount = 3,\n\t\tSpread = 9,\n\t\tDamage = 50,\n\t\tRadius = 7,\n\t\tLinger = 0.8,\n\t\tFlightTime = 1.05,\n\t\tApex = 22,\n\t\tMaxRange = 85,\n\t