04-\t\tName = \"Chips\",\n405-\t\tBackgroundTransparency = 1,\n406-\t\tSize = UDim2.fromOffset(440, 44),\n407-\t\tAnchorPoint = Vector2.new(0, 1),\n","stderr":"","executionTime":73,"interleavedOutput":"391:\tannounce = Style.label(frame, \"\", 130, {\n392-\t\tName = \"Announce\",\n393-\t\tFontFace = ITALIC,\n394-\t\tSize = UDim2.new(1, 0, 0, 160),\n395-\t\tAnchorPoint = Vector2.new(0.5, 0.5),\n396-\t\tPosition = UDim2.fromScale(0.5, 0.4),\n397-\t\tTextTransparency = 1,\n398-\t\tZIndex = 5,\n399-\t})\n400-\tlocal ast = Style.textStroke(announce, Color3.fromRGB(20, 0, 60), 5)\n401-\tast.Transparency = 1\n402-\tStyle.new(\"UIScale\", { Parent = announce })\n403-\tchipsFrame = Style.new(\"Frame\", {\n404-\t\tName = \"Chips\",\n405-\t\tBackgroundTransparency = 1,\n406-\t\tSize = UDim2.fromOffset(440, 44),\n407-\t\tAnchorPoint = Vector2.new(0, 1),\n","localExecutionTimeMs":60},"isBackground":false},"description":"Find announcer creation"},"hookAdditionalContexts":[],"toolCallId":"toolu_017wbn3bbfmddHYkCgLMFPQv","startedAtMs":"1791075916071","completedAtMs":"1791075916144"},"model_call_id":"9f87d2a3-a097-4b92-978f-ec64b826b4ce-58-q413","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791075916178}
