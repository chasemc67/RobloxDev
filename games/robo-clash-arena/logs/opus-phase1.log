t + Vector3.new(0, dy, 0)\n\telseif kind == \"Orbit\" then\n\t\tif p.age < p.launchTime then\n\t\t\tp.pos += p.launchDir * p.launchSpeed * dt\n\t\telse\n\t\t\tif targetPos then\n\t\t\t\tlocal to = targetPos - p.pos\n\t\t\t\tif to.Magnitude > 0.2 then\n\t\t\t\t\tp.dir = Util.rotateTowards(p.dir, to.Unit, p.turn * dt)\n\t\t\t\tend\n\t\t\tend\n\t\t\tp.pos += p.dir * p.speed * dt\n\t\tend\n\telseif kind == \"Mine\" then\n\t\tlocal a = math.clamp(p.age / p.throwTime, 0, 1)\n\t\tp.pos = p.start:Lerp(p.finish, a) + Vector3.new(0, 4 * 5 * a * (1 - a), 0)\n\t\tp.landed = a >= 1\n\tend\n\treturn prev\nend\n\n-- Advance a freshly spawned projectile by `elapsed` seconds (latency compensation on clients).\nfunction Sim.fastForward(p, elapsed: number, targetPos: Vector3?)\n\tlocal stepSize = 1 / 60\n\tlocal remaining = math.min(elapsed, 0.3)\n\twhile remaining > 1e-4 do\n\t\tlocal dt = math.min(stepSize, remaining)\n\t\tSim.step(p, dt, targetPos)\n\t\tremaining -= dt\n\tend\nend\n\nreturn Sim\n"},"result":{"success":{"path":"/Users/chase-mini/src/rca-work/src/ReplicatedStorage/RoboClash/Shared/ProjectileSim.luau","linesAdded":79,"linesRemoved":0,"diffString":"--- /dev/null\n+++ b//Users/chase-mini/src/rca-work/src/ReplicatedStorage/RoboClash/Shared/ProjectileSim.luau\n@@ -1,0 +1,79 @@\n+-- Deterministic projectile motion shared by server (authoritative hits) and clients (visuals).\n+local Util = require(script.Parent.Util)\n+\n+local Sim = {}\n+\n+-- p fields: kind, pos, dir, speed, turn (rad/s), age, life, homing, target (Model)\n+-- Bomb: start, finish, flight, apex. Mine: start, finish, throwTime.\n+-- Seeker: floorY, hover, climb. Orbit: launchDir, launchTime, launchSpeed.\n+function Sim.step(p, dt: number, targetPos: Vector3?): Vector3\n+\tp.age += dt\n+\tlocal prev = p.pos\n+\tlocal kind = p.kind\n+\tif kind == \"Bomb\" then\n+\t\tlocal a = math.clamp(p.age / p.flight, 0, 1)\n+\t\tp.pos = p.start:Lerp(p.finish, a) + Vector3.new(0, 4 * p.apex * a * (1 - a), 0)\n+\t\tp.landed