rbxasset://fonts/families/GothamSSm.json\", Enum.FontWeight.Heavy, Enum.FontStyle.Italic)\n\nlocal UI = {}\nlocal root: Frame\nlocal screens = {}\nlocal current: string? = nil\nlocal backHandlers = {}\nlocal defaultSelect = {}\nlocal camMode = \"Title\"\nlocal camT = 0\nlocal robotButtons = {}\nlocal detail = {}\nlocal queueLabel: TextLabel\nlocal queueSub: TextLabel\nlocal results = {}\nlocal rematchBusy = false\n\nlocal function send(action: string, arg: any?)\n\tMenuRemote:FireServer(action, arg)\nend\n\nlocal function gamepadActive(): boolean\n\treturn State.lastInput == \"Gamepad\"\nend\n\nlocal function selectDefault()\n\tlocal b = current and defaultSelect[current]\n\tif b and gamepadActive() then\n\t\tGuiService.SelectedObject = b\n\tend\nend\n\nlocal function wire(b: GuiButton, fn: () -> (), soundName: string?)\n\tb.Activated:Connect(function()\n\t\tSound.Play(soundName or \"UISelect\")\n\t\tfn()\n\tend)\n\tb.SelectionGained:Connect(function()\n\t\tSound.Play(\"UIMove\", { volume = 0.2 })\n\tend)\n\tb.MouseEnter:Connect(function()\n\t\tSound.Play(\"UIMove\", { volume = 0.15 })\n\tend)\nend\n\nlocal function screen(name: string): Frame\n\tlocal f = Style.new(\"Frame\", { Name = name, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = root })\n\tscreens[name] = f\n\treturn f\nend\n\nfunction UI.Show(name: string?)\n\tfor n, f in pairs(screens) do\n\t\tf.Visible = n == name\n\tend\n\tcurrent = name\n\tGuiService.SelectedObject = nil\n\tif name then\n\t\tselectDefault()\n\tend\nend\n\nfunction UI.Current(): string?\n\treturn current\nend\n\n----------------------------------------------------------------------------------------------\n-- Title\n----------------------------------------------------------------------------------------------\nlocal function buildTitle()\n\tlocal f = screen(\"Title\")\n\tlocal logo = Style.label(f, \"ROBO CLASH\", 120, {\n\t\tFontFace = ITALIC,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0.12, 0),\n\t\tSize = UDim2.new(1, 0, 0, 130),\n\t\tTextColor3 = Color3.new(1, 1, 1),\n\t})\n\tStyle.textStroke(logo, Color3.fromRGB(30, 0, 90), 6)\n\tStyle.new(\"UIGradient\", {\n\t\tColor = ColorSequence.new(Color3.fromRGB(120, 240, 255), Color3.fromRGB(255, 90, 200)),\n\t\tRotation = 90,\n\t\tParent = logo,\n\t})\n\tlocal sub = Style.label(f, \"A R E N A\", 54, {\n\t\tFontFace = ITALIC,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0.12, 128),\n\t\tTextColor3 = C.Gold,\n\t})\n\tStyle.textStroke(sub, Color3.fromRGB(60, 20, 0), 4)\n\tStyle.label(f, \"Pick a robot. Lock on. Blast them into a DOWN.\", 22, {\n\t\tFont = Style.Body,\n\t\tTextColor3 = C.Dim,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0.12, 200),\n\t})\n\tlocal holder = Style.new(\"Frame\", {\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(380, 86),\n\t\tAnchorPoint = Vector2.new(0.5, 1),\n\t\tPosition = UDim2.new(0.5, 0, 1, -150),\n\t\tParent = f,\n\t})\n\tlocal play = Style.button(holder, \"PLAY\", { color = C.Gold, height = 86, textSize = 44 })\n\tplay.Name = \"Play\"\n\twire(play, function()\n\t\tUI.ShowSelect()\n\tend)\n\tdefaultSelect.Title = play\n\tlocal hint = Style.label(f, \"\", 18, {\n\t\tName = \"Hint\",\n\t\tFont = Style.Body,\n\t\tTextColor3 = C.Dim,\n\t\tAnchorPoint = Vector2.new(0.5, 1),\n\t\tPosition = UDim2.new(0.5, 0, 1, -40),\n\t\tSize = UDim2.new(1, -40, 0, 50),\n\t\tTextWrapped = true,\n\t})\n\tlocal function refreshHint()\n\t\tif State.lastInput == \"Gamepad\" then\n\t\t\thint.Text = \"Left stick move  •  A jump  •  B / LB dash  •  RT gun  •  LT / X bomb  •  RB / Y pod\"\n\t\telseif State.lastInput == \"Touch\" then\n\t\t\thint.Text = \"Left side: move  •  Buttons: GUN  BOMB  POD  JUMP  DASH\"\n\t\telse\n\t\t\thint.Text = \"WASD move  •  Space jump  •  Shift dash  •  LMB / J gun  •  RMB / K bomb  •  E / L pod\"\n\t\tend\n\tend\n\trefreshHint()\n\tState.InputTypeChanged:Connect(refreshHint)\nend\n\n----------------------------------------------------------------------------------------------\n-- Robot select\n----------------------------------------------------------------------------------------------\nlocal STAT_ORDER = { \"Power\", \"Range\", \"Speed\", \"Mobility\", \"Defense\" }\n\nlocal function setDetail(robotId: string)\n\tlocal r = Config.RobotById[robotId]\n\tif not r then\n\t\treturn\n\tend\n\tlocal lo = Config.GetLoadout(robotId)\n\tdetail.name.Text = r.DisplayName\n\tdetail.name.TextColor3 = r.Neon\n\tdetail.role.Text = r.Role\n\tdetail.desc.Text = r.Description\n\tdetail.panelStroke.Color = r.Neon\n\tlocal rows = {\n\t\t{ \"GUN\", lo.Gun.Name, lo.Gun.Blurb },\n\t\t{ \"BOMB\", lo.Bomb.Name, lo.Bomb.Blurb },\n\t\t{ \"POD\", lo.Pod.Name, lo.Pod.Blurb },\n\t\t{ \"LEGS\", lo.Legs.Name, lo.Legs.Blurb },\n\t\t{ \"BODY\", lo.Body.Name, lo.Body.DashAttack and (\"Dash attack: \" .. lo.Body.DashAttack.Name) or \"\" },\n\t}\n\tfor i, row in ipairs(rows) do\n\t\tlocal l = detail.rows[i]\n\t\tl.kind.Text = row[1]\n\t\tl.kind.TextColor3 = r.Neon\n\t\tl.name.Text = row[2] or \"\"\n\t\tl.blurb.Text = row[3] or \"\"\n\tend\n\tfor i, stat in ipairs(STAT_ORDER) do\n\t\tlocal v = r.Stats[stat] or 0\n\t\tfor s, seg in ipairs(detail.stats[i].segs) do\n\t\t\tseg.BackgroundColor3 = s <= v and r.Neon or Color3.fromRGB(40, 46, 80)\n\t\tend\n\tend\n\tfor id, b in pairs(robotButtons) do\n\t\tlocal chosen = id == robotId\n\t\tb.check.Visible = chosen\n\tend\nend\n\nlocal function chooseRobot(robotId: string)\n\tif State.robotId ~= robotId then\n\t\tState.robotId = robotId\n\t\tsend(\"Select\", robotId)\n\tend\n\tsetDetail(robotId)\nend\n\nlocal function buildSelect()\n\tlocal f = screen(\"Select\")\n\tStyle.label(f, \"CHOOSE YOUR ROBOT\", 46, {\n\t\tFontFace = ITALIC,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0, 24),\n\t})\n\tlocal list = Style.new(\"Frame\", {\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(340, 3 * 96 + 2 * 12),\n\t\tPosition = UDim2.new(0, 36, 0.5, -40),\n\t\tAnchorPoint = Vector2.new(0, 0.5),\n\t\tParent = f,\n\t})\n\tStyle.new(\"UIListLayout\", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })\n\tfor i, r in ipairs(Config.Robots) do\n\t\tlocal b = Style.button(list, r.DisplayName, { sub = r.Role, color = r.Neon, height = 96, textSize = 34 })\n\t\tb.LayoutOrder = i\n\t\tb.Name = \"Robot_\" .. r.Id\n\t\tlocal check = Style.label(b, \"✓\", 34, {\n\t\t\tSize = UDim2.fromOffset(40, 40),\n\t\t\tPosition = UDim2.new(1, -52, 0.5, -20),\n\t\t\tTextColor3 = r.Neon,\n\t\t\tVisible = false,\n\t\t})\n\t\trobotButtons[r.Id] = { button = b, check = check }\n\t\tb.SelectionGained:Connect(function()\n\t\t\tchooseRobot(r.Id)\n\t\tend)\n\t\tb.MouseEnter:Connect(function()\n\t\t\tchooseRobot(r.Id)\n\t\tend)\n\t\twire(b, function()\n\t\t\tchooseRobot(r.Id)\n\t\t\tUI.ShowMode()\n\t\tend)\n\tend\n\n\tlocal panel = Style.panel(f, {\n\t\tSize = UDim2.fromOffset(440, 520),\n\t\tAnchorPoint = Vector2.new(1, 0.5),\n\t\tPosition = UDim2.new(1, -36, 0.5, -10),\n\t})\n\tdetail.panelStroke = panel:FindFirstChildOfClass(\"UIStroke\")\n\tdetail.panelStroke.Transparency = 0.1\n\tdetail.name = Style.label(panel, \"\", 50, { FontFace = ITALIC, Position = UDim2.fromOffset(22, 14), Size = UDim2.new(1, -44, 0, 54), TextXAlignment = Enum.TextXAlignment.Left })\n\tdetail.role = Style.label(panel, \"\", 20, { Position = UDim2.fromOffset(24, 66), Size = UDim2.new(1, -44, 0, 24), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.Gold })\n\tdetail.desc = Style.label(panel, \"\", 17, {\n\t\tFont = Style.Body,\n\t\tTextColor3 = C.Dim,\n\t\tTextWrapped = true,\n\t\tTextXAlignment = Enum.TextXAlignment.Left,\n\t\tTextYAlignment = Enum.TextYAlignment.Top,\n\t\tPosition = UDim2.fromOffset(24, 96),\n\t\tSize = UDim2.new(1, -44, 0, 44),\n\t})\n\tdetail.rows = {}\n\tfor i = 1, 5 do\n\t\tlocal y = 146 + (i - 1) * 44\n\t\tlocal kind = Style.label(panel, \"\", 16, { Position = UDim2.fromOffset(24, y), Size = UDim2.fromOffset(60, 20), TextXAlignment = Enum.TextXAlignment.Left })\n\t\tlocal name = Style.label(panel, \"\", 19, { Position = UDim2.fromOffset(88, y - 2), Size = UDim2.new(1, -110, 0, 22), TextXAlignment = Enum.TextXAlignment.Left })\n\t\tlocal blurb = Style.label(panel, \"\", 14, {\n\t\t\tFont = Style.Body,\n\t\t\tTextColor3 = C.Dim,\n\t\t\tPosition = UDim2.fromOffset(88, y + 20),\n\t\t\tSize = UDim2.new(1, -110, 0, 16),\n\t\t\tTextXAlignment = Enum.TextXAlignment.Left,\n\t\t})\n\t\tdetail.rows[i] = { kind = kind, name = name, blurb = blurb }\n\tend\n\tdetail.stats = {}\n\tfor i, stat in ipairs(STAT_ORDER) do\n\t\tlocal y = 372 + (i - 1) * 27\n\t\tStyle.label(panel, string.upper(stat), 15, { Position = UDim2.fromOffset(24, y), Size = UDim2.fromOffset(110, 20), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.Dim })\n\t\tlocal segs = {}\n\t\tfor s = 1, 5 do\n\t\t\tlocal seg = Style.new(\"Frame\", {\n\t\t\t\tBackgroundColor3 = C.Accent,\n\t\t\t\tBorderSizePixel = 0,\n\t\t\t\tSize = UDim2.fromOffset(48, 14),\n\t\t\t\tPosition = UDim2.fromOffset(140 + (s - 1) * 54, y + 3),\n\t\t\t\tParent = panel,\n\t\t\t})\n\t\t\tStyle.corner(seg, 4)\n\t\t\tsegs[s] = seg\n\t\tend\n\t\tdetail.stats[i] = { segs = segs }\n\tend\n\n\tlocal bottom = Style.new(\"Frame\", {\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(560, 72),\n\t\tAnchorPoint = Vector2.new(0.5, 1),\n\t\tPosition = UDim2.new(0.5, 0, 1, -24),\n\t\tParent = f,\n\t})\n\tStyle.new(\"UIListLayout\", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 20), Parent = bottom })\n\tlocal back = Style.button(bottom, \"BACK\", { color = C.Dim, size = UDim2.fromOffset(200, 72) })\n\tback.LayoutOrder = 1\n\tlocal go = Style.button(bottom, \"CONFIRM\", { color = C.Gold, size = UDim2.fromOffset(340, 72), textSize = 34 })\n\tgo.LayoutOrder = 2\n\twire(back, function()\n\t\tUI.ShowTitle()\n\tend, \"UIBack\")\n\twire(go, function()\n\t\tUI.ShowMode()\n\tend)\n\tbackHandlers.Select = function()\n\t\tUI.ShowTitle()\n\tend\nend\n\n----------------------------------------------------------------------------------------------\n-- Mode select + queue\n----------------------------------------------------------------------------------------------\nlocal function buildMode()\n\tlocal f = screen(\"Mode\")\n\tlocal title = Style.label(f, \"SELECT MODE\", 46, { FontFace = ITALIC, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 24) })\n\ttitle.Name = \"Title\"\n\tlocal robotLabel = Style.label(f, \"\", 22, { Name = \"Robot\", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 80), TextColor3 = C.Gold })\n\tscreens.Mode:SetAttribute(\"Ready\", true)\n\tlocal col = Style.new(\"Frame\", {\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(470, 3 * 100 + 2 * 14),\n\t\tAnchorPoint = Vector2.new(0, 0.5),\n\t\tPosition = UDim2.new(0, 40, 0.55, 0),\n\t\tParent = f,\n\t})\n\tStyle.new(\"UIListLayout\", { Padding = UDim.new(0, 14), SortOrder = Enum.SortOrder.LayoutOrder, Parent = col })\n\tlocal mm = Style.button(col, \"MATCHMAKING\", { sub = \"Fight another player in this server\", color = C.Accent2, height = 100, textSize = 36 })\n\tmm.LayoutOrder = 1\n\tlocal bot = Style.button(col, \"BATTLE A BOT\", { sub = \"Practice against a CPU robot\", color = C.Accent, height = 100, textSize = 36 })\n\tbot.LayoutOrder = 2\n\tlocal back = Style.button(col, \"BACK\", { sub = \"Change robot\", color = C.Dim, height = 100, textSize = 36 })\n\tback.LayoutOrder = 3\n\twire(mm, function()\n\t\tsend(\"Queue\")\n\t\tUI.ShowQueue({ inQueue = true, position = 1, count = 1 })\n\tend)\n\twire(bot, function()\n\t\tsend(\"Bot\")\n\t\tUI.Show(\"Loading\")\n\tend)\n\twire(back, function()\n\t\tUI.ShowSelect()\n\tend, \"UIBack\")\n\tdefaultSelect.Mode = bot\n\tbackHandlers.Mode = function()\n\t\tUI.ShowSelect()\n\tend\n\tUI._modeRobotLabel = robotLabel\n\n\tlocal q = screen(\"Queue\")\n\tlocal qp = Style.panel(q, { Size = UDim2.fromOffset(560, 330), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) })\n\tStyle.label(qp, \"MATCHMAKING\", 40, { FontFace = ITALIC, Position = UDim2.fromOffset(0, 18), TextColor3 = C.Accent2 })\n\tqueueLabel = Style.label(qp, \"Searching for an opponent...\", 26, { Position = UDim2.fromOffset(0, 78) })\n\tqueueSub = Style.label(qp, \"\", 18, { Font = Style.Body, TextColor3 = C.Dim, Position = UDim2.fromOffset(0, 116), TextWrapped = true, Size = UDim2.new(1, -40, 0, 44) })\n\tqueueSub.Position = UDim2.fromOffset(20, 116)\n\tlocal qb = Style.new(\"Frame\", { BackgroundTransparency = 1, Size = UDim2.new(1, -60, 0, 140), Position = UDim2.fromOffset(30, 172), Parent = qp })\n\tStyle.new(\"UIListLayout\", { Padding = UDim.new(0, 12), Parent = qb })\n\tlocal qbot = Style.button(qb, \"BATTLE A BOT INSTEAD\", { color = C.Accent, height = 62, textSize = 26 })\n\tlocal qcancel = Style.button(qb, \"CANCEL\", { color = C.Dim, height = 62, textSize = 26 })\n\tqcancel.LayoutOrder = 2\n\twire(qbot, function()\n\t\tsend(\"Bot\")\n\t\tUI.Show(\"Loading\")\n\tend)\n\twire(qcancel, function()\n\t\tsend(\"CancelQueue\")\n\t\tUI.ShowMode()\n\tend, \"UIBack\")\n\tdefaultSelect.Queue = qcancel\n\tbackHandlers.Queue = function()\n\t\tsend(\"CancelQueue\")\n\t\tUI.ShowMode()\n\tend\n\n\tlocal l = screen(\"Loading\")\n\tStyle.label(l, \"LAUNCHING...\", 40, { FontFace = ITALIC, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), TextColor3 = C.Accent })\nend\n\n----------------------------------------------------------------------------------------------\n-- Results\n----------------------------------------------------------------------------------------------\nlocal function buildResults()\n\tlocal f = screen(\"Results\")\n\tStyle.new(\"Frame\", { BackgroundColor3 = C.Bg, BackgroundTransparency = 0.35, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Parent = f })\n\tresults.outcome = Style.label(f, \"\", 140, {\n\t\tFontFace = ITALIC,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0, 30),\n\t\tSize = UDim2.new(1, 0, 0, 150),\n\t})\n\tStyle.textStroke(results.outcome, Color3.fromRGB(20, 0, 60), 6)\n\tresults.reason = Style.label(f, \"\", 26, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 176), TextColor3 = C.Dim })\n\tresults.perfect = Style.label(f, \"PERFECT!\", 40, {\n\t\tFontFace = ITALIC,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0, 210),\n\t\tTextColor3 = C.Gold,\n\t\tVisible = false,\n\t})\n\tStyle.textStroke(results.perfect, Color3.fromRGB(60, 20, 0), 3)\n\tlocal panel = Style.panel(f, { Size = UDim2.fromOffset(640, 250), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 262) })\n\tresults.panel = panel\n\tlocal cols = { \"\", \"YOU\", \"RIVAL\" }\n\tresults.head = {}\n\tfor i, t in ipairs(cols) do\n\t\tresults.head[i] = Style.label(panel, t, 22, {\n\t\t\tPosition = UDim2.fromOffset(20 + (i - 1) * 205, 14),\n\t\t\tSize = UDim2.fromOffset(i == 1 and 200 or 200, 26),\n\t\t\tTextXAlignment = i == 1 and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center,\n\t\t\tTextColor3 = i == 2 and C.Accent or (i == 3 and C.Accent2 or C.Dim),\n\t\t})\n\tend\n\tresults.rows = {}\n\tlocal labels = { \"Robot\", \"HP left\", \"Damage dealt\", \"Hits landed\", \"Times DOWN\" }\n\tfor r, name in ipairs(labels) do\n\t\tlocal y = 48 + (r - 1) * 38\n\t\tlocal row = {}\n\t\trow[1] = Style.label(panel, name, 20, { Font = Style.Body, Position = UDim2.fromOffset(20, y), Size = UDim2.fromOffset(200, 28), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.Dim })\n\t\tfor c = 2, 3 do\n\t\t\trow[c] = Style.label(panel, \"\", 22, { Position = UDim2.fromOffset(20 + (c - 1) * 205, y), Size = UDim2.fromOffset(200, 28) })\n\t\tend\n\t\tresults.rows[r] = row\n\tend\n\tresults.status = Style.label(f, \"\", 20, { Font = Style.Body, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 522), TextColor3 = C.Gold })\n\tlocal bottom = Style.new(\"Frame\", {\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(640, 76),\n\t\tAnchorPoint = Vector2.new(0.5, 1),\n\t\tPosition = UDim2.new(0.5, 0, 1, -40),\n\t\tParent = f,\n\t})\n\tStyle.new(\"UIListLayout\", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 20), Parent = bottom })\n\tlocal rematch, rematchTitle = Style.button(bottom, \"REMATCH\", { color = C.Gold, size = UDim2.fromOffset(310, 76), textSize = 32 })\n\tlocal back = Style.button(bottom, \"BACK TO SELECT\", { color = C.Accent, size = UDim2.fromOffset(310, 76), textSize = 28 })\n\tback.LayoutOrder = 2\n\tresults.rematch = rematch\n\tresults.rematchTitle = rematchTitle\n\twire(rematch, function()\n\t\tif rematchBusy then\n\t\t\treturn\n\t\tend\n\t\trematchBusy = true\n\t\tresults.status.Text = \"Requesting rematch...\"\n\t\tsend(\"Rematch\")\n\tend)\n\twire(back, function()\n\t\tsend(\"Back\")\n\t\tUI.ShowSelect()\n\tend, \"UIBack\")\n\tdefaultSelect.Results = rematch\n\tbackHandlers.Results = function()\n\t\tsend(\"Back\")\n\t\tUI.ShowSelect()\n\tend\nend\n\nlocal REASONS = {\n\tKO = \"by K.O.\",\n\tTIME = \"time up: higher HP wins\",\n\tLEFT = \"opponent left the match\",\n}\n\nfunction UI.ShowResults(data)\n\trematchBusy = false\n\tlocal o = data.outcome\n\tresults.outcome.Text = o == \"WIN\" and \"YOU WIN!\" or (o == \"LOSE\" and \"YOU LOSE\" or \"DRAW\")\n\tresults.outcome.TextColor3 = o == \"WIN\" and C.Gold or (o == \"LOSE\" and Color3.fromRGB(150, 170, 215) or Color3.fromRGB(210, 210, 255))\n\tlocal reason = REASONS[data.reason] or \"\"\n\tif o == \"DRAW\" and data.reason == \"TIME\" then\n\t\treason = \"time up: equal HP\"\n\tend\n\tresults.reason.Text = string.upper(reason) .. string.format(\"   •   %d:%02d\", math.floor((data.duration or 0) / 60), math.floor((data.duration or 0) % 60))\n\tresults.perfect.Visible = data.perfect == true\n\tlocal you = data.you or {}\n\tlocal rival = (data.others or {})[1] or {}\n\tresults.head[3].Text = rival.name and string.upper(rival.name) or \"RIVAL\"\n\tlocal function robotName(id)\n\t\tlocal r = Config.RobotById[id or \"\"]\n\t\treturn r and r.DisplayName or \"-\"\n\tend\n\tlocal vals = {\n\t\t{ robotName(you.robotId), robotName(rival.robotId) },\n\t\t{ tostring(math.max(0, you.hp or 0)), tostring(math.max(0, rival.hp or 0)) },\n\t\t{ tostring(you.damageDealt or 0), tostring(rival.damageDealt or 0) },\n\t\t{ tostring(you.hits or 0), tostring(rival.hits or 0) },\n\t\t{ tostring(you.downs or 0), tostring(rival.downs or 0) },\n\t}\n\tfor r, v in ipairs(vals) do\n\t\tresults.rows[r][2].Text = v[1]\n\t\tresults.rows[r][3].Text = v[2]\n\tend\n\tresults.status.Text = \"\"\n\tresults.rematch.Visible = true\n\tUI.Show(\"Results\")\n\tSound.Play(o == \"WIN\" and \"Win\" or \"Lose\")\nend\n\nfunction UI.OnRematch(data)\n\tif current ~= \"Results\" then\n\t\treturn\n\tend\n\tif data.status == \"waiting\" then\n\t\tresults.status.Text = string.format(\"Waiting for rival... (%d/%d ready)\", data.votes or 1, data.needed or 2)\n\telseif data.status == \"starting\" then\n\t\tresults.status.Text = \"Rematch starting!\"\n\telseif data.status == \"closed\" then\n\t\trematchBusy = false\n\t\tresults.status.Text = data.reason or \"Rematch unavailable\"\n\t\tresults.rematch.Visible = false\n\t\tif gamepadActive() then\n\t\t\tGuiService.SelectedObject = results.rematch.Parent:FindFirstChildWhichIsA(\"TextButton\", false) ~= results.rematch\n\t\t\t\t\tand results.rematch.Parent:GetChildren()[3]\n\t\t\t\tor nil\n\t\tend\n\tend\nend\n\nfunction UI.OnQueue(data)\n\tif data.matched then\n\t\tUI.Show(\"Loading\")\n\t\treturn\n\tend\n\tif not data.inQueue then\n\t\tif current == \"Queue\" then\n\t\t\tUI.ShowMode()\n\t\tend\n\t\treturn\n\tend\n\tif current ~= \"Queue\" then\n\t\tUI.Show(\"Queue\")\n\tend\n\tqueueLabel.Text = \"Searching for an opponent...\"\n\tqueueSub.Text = string.format(\"Queue position %d of %d  •  %d player%s in this server\", data.position or 1, data.count or 1, data.online or 1, (data.online or 1) == 1 and \"\" or \"s\")\nend\n\nfunction UI.ShowTitle()\n\tcamMode = \"Title\"\n\tUI.Show(\"Title\")\nend\n\nfunction UI.ShowSelect()\n\tcamMode = \"Select\"\n\tsetDetail(State.robotId)\n\tUI.Show(\"Select\")\n\tif gamepadActive() then\n\t\tlocal b = robotButtons[State.robotId]\n\t\tGuiService.SelectedObject = b and b.button\n\tend\nend\n\nfunction UI.ShowMode()\n\tcamMode = \"Select\"\n\tlocal r = Config.RobotById[State.robotId]\n\tUI._modeRobotLabel.Text = r and (\"ROBOT: \" .. r.DisplayName .. \"  •  \" .. r.Role) or \"\"\n\tUI.Show(\"Mode\")\nend\n\nfunction UI.ShowQueue(data)\n\tUI.Show(\"Queue\")\n\tUI.OnQueue(data)\nend\n\n----------------------------------------------------------------------------------------------\n-- Lobby camera (menus)\n----------------------------------------------------------------------------------------------\nlocal camCF: CFrame? = nil\nlocal function lobbyStep(dt: number)\n\tif State.mode ~= \"Menu\" then\n\t\tcamCF = nil\n\t\treturn\n\tend\n\tlocal camera = workspace.CurrentCamera\n\tcamera.CameraType = Enum.CameraType.Scriptable\n\tcamera.FieldOfView = 55\n\tcamT += dt\n\tlocal stands = workspace:FindFirstChild(\"Lobby\") and workspace.Lobby:FindFirstChild(\"Stands\")\n\tlocal target: CFrame\n\tif camMode == \"Select\" and stands then\n\t\tlocal r = Config.RobotById[State.robotId]\n\t\tlocal x = ((r and r.Index or 1) - 2) * 14\n\t\tlocal focus = Vector3.new(x, 6, 0)\n\t\ttarget = CFrame.lookAt(focus + Vector3.new(0, 4, 21), focus + Vector3.new(0, 0.5, 0))\n\t\tlocal statue = stands:FindFirstChild(\"Statue\" .. State.robotId)\n\t\tif statue then\n\t\t\tlocal pivot = statue:GetPivot()\n\t\t\tstatue:PivotTo(CFrame.new(pivot.Position) * CFrame.Angles(0, math.pi + math.sin(camT * 0.8) * 0.5, 0))\n\t\tend\n\telse\n\t\tlocal a = camT * 0.12\n\t\tlocal focus = Vector3.new(0, 5, 0)\n\t\ttarget = CFrame.lookAt(focus + Vector3.new(math.sin(a) * 46, 18, math.cos(a) * 46), focus)\n\tend\n\tif not camCF then\n\t\tcamCF = target\n\tend\n\tcamCF = (camCF :: CFrame):Lerp(target, 1 - math.exp(-dt * 4))\n\tcamera.CFrame = camCF :: CFrame\nend\n\n----------------------------------------------------------------------------------------------\n-- Init\n----------------------------------------------------------------------------------------------\nlocal function onBack(_, state)\n\tif state ~= Enum.UserInputState.Begin then\n\t\treturn Enum.ContextActionResult.Pass\n\tend\n\tlocal h = current and backHandlers[current]\n\tif h then\n\t\tSound.Play(\"UIBack\")\n\t\th()\n\t\treturn Enum.ContextActionResult.Sink\n\tend\n\treturn Enum.ContextActionResult.Pass\nend\n\nfunction UI.SetMenuInput(on: boolean)\n\tif on then\n\t\tContextActionService:BindAction(\"RC_MenuBack\", onBack, false, Enum.KeyCode.ButtonB, Enum.KeyCode.Backspace)\n\telse\n\t\tContextActionService:UnbindAction(\"RC_MenuBack\")\n\t\tGuiService.SelectedObject = nil\n\tend\nend\n\nfunction UI.Init(uiRoot: Frame)\n\troot = uiRoot\n\tbuildTitle()\n\tbuildSelect()\n\tbuildMode()\n\tbuildResults()\n\tsetDetail(State.robotId)\n\tRunService:BindToRenderStep(\"RoboClashLobbyCam\", Enum.RenderPriority.Camera.Value + 2, lobbyStep)\n\tState.InputTypeChanged:Connect(function(kind)\n\t\tif kind == \"Gamepad\" and current and GuiService.SelectedObject == nil then\n\t\t\tif current == \"Select\" then\n\t\t\t\tlocal b = robotButtons[State.robotId]\n\t\t\t\tGuiService.SelectedObject = b and b.button\n\t\t\telse\n\t\t\t\tselectDefault()\n\t\t\tend\n\t\telseif kind ~= \"Gamepad\" then\n\t\t\tGuiService.SelectedObject = nil\n\t\tend\n\tend)\n\tUserInputService.GamepadConnected:Connect(function()\n\t\tselectDefault()\n\tend)\n\tUI.SetMenuInput(true)\n\tUI.ShowTitle()\nend\n\nreturn UI\n","afterFullFileContent":"-- Menu screens: Title -> Robot Select -> Mode Select (Matchmaking / Bot / Back), queue overlay,\n-- Results (Rematch / Back to Select). Works with mouse, touch and gamepad (SelectedObject + B).\nlocal ContextActionService = game:GetService(\"ContextActionService\")\nlocal GuiService = game:GetService(\"GuiService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal UserInputService = game:GetService(\"UserInputService\")\n\nlocal RC = ReplicatedStorage:WaitForChild(\"RoboClash\")\nlocal Config = require(RC.Config)\nlocal Style = require(script.Parent.Style)\nlocal State = require(script.Parent.State)\nlocal Sound = require(script.Parent.Sound)\n\nlocal MenuRemote = RC:WaitForChild(\"Remotes\"):WaitForChild(\"Menu\")\nlocal C = Style.C\nlocal ITALIC = Font.new(\"rbxasset://fonts/families/GothamSSm.json\", Enum.FontWeight.Heavy, Enum.FontStyle.Italic)\n\nlocal UI = {}\nlocal root: Frame\nlocal screens = {}\nlocal current: string? = nil\nlocal backHandlers = {}\nlocal defaultSelect = {}\nlocal camMode = \"Title\"\nlocal camT = 0\nlocal robotButtons = {}\nlocal detail = {}\nlocal queueLabel: TextLabel\nlocal queueSub: TextLabel\nlocal results = {}\nlocal rematchBusy = false\n\nlocal function send(action: string, arg: any?)\n\tMenuRemote:FireServer(action, arg)\nend\n\nlocal function gamepadActive(): boolean\n\treturn State.lastInput == \"Gamepad\"\nend\n\nlocal function selectDefault()\n\tlocal b = current and defaultSelect[current]\n\tif b and gamepadActive() then\n\t\tGuiService.SelectedObject = b\n\tend\nend\n\nlocal function wire(b: GuiButton, fn: () -> (), soundName: string?)\n\tb.Activated:Connect(function()\n\t\tSound.Play(soundName or \"UISelect\")\n\t\tfn()\n\tend)\n\tb.SelectionGained:Connect(function()\n\t\tSound.Play(\"UIMove\", { volume = 0.2 })\n\tend)\n\tb.MouseEnter:Connect(function()\n\t\tSound.Play(\"UIMove\", { volume = 0.15 })\n\tend)\nend\n\nlocal function screen(name: string): Frame\n\tlocal f = Style.new(\"Frame\", { Name = name, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = root })\n\tscreens[name] = f\n\treturn f\nend\n\nfunction UI.Show(name: string?)\n\tfor n, f in pairs(screens) do\n\t\tf.Visible = n == name\n\tend\n\tcurrent = name\n\tGuiService.SelectedObject = nil\n\tif name then\n\t\tselectDefault()\n\tend\nend\n\nfunction UI.Current(): string?\n\treturn current\nend\n\n----------------------------------------------------------------------------------------------\n-- Title\n----------------------------------------------------------------------------------------------\nlocal function buildTitle()\n\tlocal f = screen(\"Title\")\n\tlocal logo = Style.label(f, \"ROBO CLASH\", 120, {\n\t\tFontFace = ITALIC,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0.12, 0),\n\t\tSize = UDim2.new(1, 0, 0, 130),\n\t\tTextColor3 = Color3.new(1, 1, 1),\n\t})\n\tStyle.textStroke(logo, Color3.fromRGB(30, 0, 90), 6)\n\tStyle.new(\"UIGradient\", {\n\t\tColor = ColorSequence.new(Color3.fromRGB(120, 240, 255), Color3.fromRGB(255, 90, 200)),\n\t\tRotation = 90,\n\t\tParent = logo,\n\t})\n\tlocal sub = Style.label(f, \"A R E N A\", 54, {\n\t\tFontFace = ITALIC,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0.12, 128),\n\t\tTextColor3 = C.Gold,\n\t})\n\tStyle.textStroke(sub, Color3.fromRGB(60, 20, 0), 4)\n\tStyle.label(f, \"Pick a robot. Lock on. Blast them into a DOWN.\", 22, {\n\t\tFont = Style.Body,\n\t\tTextColor3 = C.Dim,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0.12, 200),\n\t})\n\tlocal holder = Style.new(\"Frame\", {\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(380, 86),\n\t\tAnchorPoint = Vector2.new(0.5, 1),\n\t\tPosition = UDim2.new(0.5, 0, 1, -150),\n\t\tParent = f,\n\t})\n\tlocal play = Style.button(holder, \"PLAY\", { color = C.Gold, height = 86, textSize = 44 })\n\tplay.Name = \"Play\"\n\twire(play, function()\n\t\tUI.ShowSelect()\n\tend)\n\tdefaultSelect.Title = play\n\tlocal hint = Style.label(f, \"\", 18, {\n\t\tName = \"Hint\",\n\t\tFont = Style.Body,\n\t\tTextColor3 = C.Dim,\n\t\tAnchorPoint = Vector2.new(0.5, 1),\n\t\tPosition = UDim2.new(0.5, 0, 1, -40),\n\t\tSize = UDim2.new(1, -40, 0, 50),\n\t\tTextWrapped = true,\n\t})\n\tlocal function refreshHint()\n\t\tif State.lastInput == \"Gamepad\" then\n\t\t\thint.Text = \"Left stick move  •  A jump  •  B / LB dash  •  RT gun  •  LT / X bomb  •  RB / Y pod\"\n\t\telseif State.lastInput == \"Touch\" then\n\t\t\thint.Text = \"Left side: move  •  Buttons: GUN  BOMB  POD  JUMP  DASH\"\n\t\telse\n\t\t\thint.Text = \"WASD move  •  Space jump  •  Shift dash  •  LMB / J gun  •  RMB / K bomb  •  E / L pod\"\n\t\tend\n\tend\n\trefreshHint()\n\tState.InputTypeChanged:Connect(refreshHint)\nend\n\n----------------------------------------------------------------------------------------------\n-- Robot select\n----------------------------------------------------------------------------------------------\nlocal STAT_ORDER = { \"Power\", \"Range\", \"Speed\", \"Mobility\", \"Defense\" }\n\nlocal function setDetail(robotId: string)\n\tlocal r = Config.RobotById[robotId]\n\tif not r then\n\t\treturn\n\tend\n\tlocal lo = Config.GetLoadout(robotId)\n\tdetail.name.Text = r.DisplayName\n\tdetail.name.TextColor3 = r.Neon\n\tdetail.role.Text = r.Role\n\tdetail.desc.Text = r.Description\n\tdetail.panelStroke.Color = r.Neon\n\tlocal rows = {\n\t\t{ \"GUN\", lo.Gun.Name, lo.Gun.Blurb },\n\t\t{ \"BOMB\", lo.Bomb.Name, lo.Bomb.Blurb },\n\t\t{ \"POD\", lo.Pod.Name, lo.Pod.Blurb },\n\t\t{ \"LEGS\", lo.Legs.Name, lo.Legs.Blurb },\n\t\t{ \"BODY\", lo.Body.Name, lo.Body.DashAttack and (\"Dash attack: \" .. lo.Body.DashAttack.Name) or \"\" },\n\t}\n\tfor i, row in ipairs(rows) do\n\t\tlocal l = detail.rows[i]\n\t\tl.kind.Text = row[1]\n\t\tl.kind.TextColor3 = r.Neon\n\t\tl.name.Text = row[2] or \"\"\n\t\tl.blurb.Text = row[3] or \"\"\n\tend\n\tfor i, stat in ipairs(STAT_ORDER) do\n\t\tlocal v = r.Stats[stat] or 0\n\t\tfor s, seg in ipairs(detail.stats[i].segs) do\n\t\t\tseg.BackgroundColor3 = s <= v and r.Neon or Color3.fromRGB(40, 46, 80)\n\t\tend\n\tend\n\tfor id, b in pairs(robotButtons) do\n\t\tlocal chosen = id == robotId\n\t\tb.check.Visible = chosen\n\tend\nend\n\nlocal function chooseRobot(robotId: string)\n\tif State.robotId ~= robotId then\n\t\tState.robotId = robotId\n\t\tsend(\"Select\", robotId)\n\tend\n\tsetDetail(robotId)\nend\n\nlocal function buildSelect()\n\tlocal f = screen(\"Select\")\n\tStyle.label(f, \"CHOOSE YOUR ROBOT\", 46, {\n\t\tFontFace = ITALIC,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0, 24),\n\t})\n\tlocal list = Style.new(\"Frame\", {\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(340, 3 * 96 + 2 * 12),\n\t\tPosition = UDim2.new(0, 36, 0.5, -40),\n\t\tAnchorPoint = Vector2.new(0, 0.5),\n\t\tParent = f,\n\t})\n\tStyle.new(\"UIListLayout\", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })\n\tfor i, r in ipairs(Config.Robots) do\n\t\tlocal b = Style.button(list, r.DisplayName, { sub = r.Role, color = r.Neon, height = 96, textSize = 34 })\n\t\tb.LayoutOrder = i\n\t\tb.Name = \"Robot_\" .. r.Id\n\t\tlocal check = Style.label(b, \"✓\", 34, {\n\t\t\tSize = UDim2.fromOffset(40, 40),\n\t\t\tPosition = UDim2.new(1, -52, 0.5, -20),\n\t\t\tTextColor3 = r.Neon,\n\t\t\tVisible = false,\n\t\t})\n\t\trobotButtons[r.Id] = { button = b, check = check }\n\t\tb.SelectionGained:Connect(function()\n\t\t\tchooseRobot(r.Id)\n\t\tend)\n\t\tb.MouseEnter:Connect(function()\n\t\t\tchooseRobot(r.Id)\n\t\tend)\n\t\twire(b, function()\n\t\t\tchooseRobot(r.Id)\n\t\t\tUI.ShowMode()\n\t\tend)\n\tend\n\n\tlocal panel = Style.panel(f, {\n\t\tSize = UDim2.fromOffset(440, 520),\n\t\tAnchorPoint = Vector2.new(1, 0.5),\n\t\tPosition = UDim2.new(1, -36, 0.5, -10),\n\t})\n\tdetail.panelStroke = panel:FindFirstChildOfClass(\"UIStroke\")\n\tdetail.panelStroke.Transparency = 0.1\n\tdetail.name = Style.label(panel, \"\", 50, { FontFace = ITALIC, Position = UDim2.fromOffset(22, 14), Size = UDim2.new(1, -44, 0, 54), TextXAlignment = Enum.TextXAlignment.Left })\n\tdetail.role = Style.label(panel, \"\", 20, { Position = UDim2.fromOffset(24, 66), Size = UDim2.new(1, -44, 0, 24), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.Gold })\n\tdetail.desc = Style.label(panel, \"\", 17, {\n\t\tFont = Style.Body,\n\t\tTextColor3 = C.Dim,\n\t\tTextWrapped = true,\n\t\tTextXAlignment = Enum.TextXAlignment.Left,\n\t\tTextYAlignment = Enum.TextYAlignment.Top,\n\t\tPosition = UDim2.fromOffset(24, 96),\n\t\tSize = UDim2.new(1, -44, 0, 44),\n\t})\n\tdetail.rows = {}\n\tfor i = 1, 5 do\n\t\tlocal y = 146 + (i - 1) * 44\n\t\tlocal kind = Style.label(panel, \"\", 16, { Position = UDim2.fromOffset(24, y), Size = UDim2.fromOffset(60, 20), TextXAlignment = Enum.TextXAlignment.Left })\n\t\tlocal name = Style.label(panel, \"\", 19, { Position = UDim2.fromOffset(88, y - 2), Size = UDim2.new(1, -110, 0, 22), TextXAlignment = Enum.TextXAlignment.Left })\n\t\tlocal blurb = Style.label(panel, \"\", 14, {\n\t\t\tFont = Style.Body,\n\t\t\tTextColor3 = C.Dim,\n\t\t\tPosition = UDim2.fromOffset(88, y + 20),\n\t\t\tSize = UDim2.new(1, -110, 0, 16),\n\t\t\tTextXAlignment = Enum.TextXAlignment.Left,\n\t\t})\n\t\tdetail.rows[i] = { kind = kind, name = name, blurb = blurb }\n\tend\n\tdetail.stats = {}\n\tfor i, stat in ipairs(STAT_ORDER) do\n\t\tlocal y = 372 + (i - 1) * 27\n\t\tStyle.label(panel, string.upper(stat), 15, { Position = UDim2.fromOffset(24, y), Size = UDim2.fromOffset(110, 20), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.Dim })\n\t\tlocal segs = {}\n\t\tfor s = 1, 5 do\n\t\t\tlocal seg = Style.new(\"Frame\", {\n\t\t\t\tBackgroundColor3 = C.Accent,\n\t\t\t\tBorderSizePixel = 0,\n\t\t\t\tSize = UDim2.fromOffset(48, 14),\n\t\t\t\tPosition = UDim2.fromOffset(140 + (s - 1) * 54, y + 3),\n\t\t\t\tParent = panel,\n\t\t\t})\n\t\t\tStyle.corner(seg, 4)\n\t\t\tsegs[s] = seg\n\t\tend\n\t\tdetail.stats[i] = { segs = segs }\n\tend\n\n\tlocal bottom = Style.new(\"Frame\", {\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(560, 72),\n\t\tAnchorPoint = Vector2.new(0.5, 1),\n\t\tPosition = UDim2.new(0.5, 0, 1, -24),\n\t\tParent = f,\n\t})\n\tStyle.new(\"UIListLayout\", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 20), Parent = bottom })\n\tlocal back = Style.button(bottom, \"BACK\", { color = C.Dim, size = UDim2.fromOffset(200, 72) })\n\tback.LayoutOrder = 1\n\tlocal go = Style.button(bottom, \"CONFIRM\", { color = C.Gold, size = UDim2.fromOffset(340, 72), textSize = 34 })\n\tgo.LayoutOrder = 2\n\twire(back, function()\n\t\tUI.ShowTitle()\n\tend, \"UIBack\")\n\twire(go, function()\n\t\tUI.ShowMode()\n\tend)\n\tbackHandlers.Select = function()\n\t\tUI.ShowTitle()\n\tend\nend\n\n----------------------------------------------------------------------------------------------\n-- Mode select + queue\n----------------------------------------------------------------------------------------------\nlocal function buildMode()\n\tlocal f = screen(\"Mode\")\n\tlocal title = Style.label(f, \"SELECT MODE\", 46, { FontFace = ITALIC, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 24) })\n\ttitle.Name = \"Title\"\n\tlocal robotLabel = Style.label(f, \"\", 22, { Name = \"Robot\", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 80), TextColor3 = C.Gold })\n\tscreens.Mode:SetAttribute(\"Ready\", true)\n\tlocal col = Style.new(\"Frame\", {\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(470, 3 * 100 + 2 * 14),\n\t\tAnchorPoint = Vector2.new(0, 0.5),\n\t\tPosition = UDim2.new(0, 40, 0.55, 0),\n\t\tParent = f,\n\t})\n\tStyle.new(\"UIListLayout\", { Padding = UDim.new(0, 14), SortOrder = Enum.SortOrder.LayoutOrder, Parent = col })\n\tlocal mm = Style.button(col, \"MATCHMAKING\", { sub = \"Fight another player in this server\", color = C.Accent2, height = 100, textSize = 36 })\n\tmm.LayoutOrder = 1\n\tlocal bot = Style.button(col, \"BATTLE A BOT\", { sub = \"Practice against a CPU robot\", color = C.Accent, height = 100, textSize = 36 })\n\tbot.LayoutOrder = 2\n\tlocal back = Style.button(col, \"BACK\", { sub = \"Change robot\", color = C.Dim, height = 100, textSize = 36 })\n\tback.LayoutOrder = 3\n\twire(mm, function()\n\t\tsend(\"Queue\")\n\t\tUI.ShowQueue({ inQueue = true, position = 1, count = 1 })\n\tend)\n\twire(bot, function()\n\t\tsend(\"Bot\")\n\t\tUI.Show(\"Loading\")\n\tend)\n\twire(back, function()\n\t\tUI.ShowSelect()\n\tend, \"UIBack\")\n\tdefaultSelect.Mode = bot\n\tbackHandlers.Mode = function()\n\t\tUI.ShowSelect()\n\tend\n\tUI._modeRobotLabel = robotLabel\n\n\tlocal q = screen(\"Queue\")\n\tlocal qp = Style.panel(q, { Size = UDim2.fromOffset(560, 330), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) })\n\tStyle.label(qp, \"MATCHMAKING\", 40, { FontFace = ITALIC, Position = UDim2.fromOffset(0, 18), TextColor3 = C.Accent2 })\n\tqueueLabel = Style.label(qp, \"Searching for an opponent...\", 26, { Position = UDim2.fromOffset(0, 78) })\n\tqueueSub = Style.label(qp, \"\", 18, { Font = Style.Body, TextColor3 = C.Dim, Position = UDim2.fromOffset(0, 116), TextWrapped = true, Size = UDim2.new(1, -40, 0, 44) })\n\tqueueSub.Position = UDim2.fromOffset(20, 116)\n\tlocal qb = Style.new(\"Frame\", { BackgroundTransparency = 1, Size = UDim2.new(1, -60, 0, 140), Position = UDim2.fromOffset(30, 172), Parent = qp })\n\tStyle.new(\"UIListLayout\", { Padding = UDim.new(0, 12), Parent = qb })\n\tlocal qbot = Style.button(qb, \"BATTLE A BOT INSTEAD\", { color = C.Accent, height = 62, textSize = 26 })\n\tlocal qcancel = Style.button(qb, \"CANCEL\", { color = C.Dim, height = 62, textSize = 26 })\n\tqcancel.LayoutOrder = 2\n\twire(qbot, function()\n\t\tsend(\"Bot\")\n\t\tUI.Show(\"Loading\")\n\tend)\n\twire(qcancel, function()\n\t\tsend(\"CancelQueue\")\n\t\tUI.ShowMode()\n\tend, \"UIBack\")\n\tdefaultSelect.Queue = qcancel\n\tbackHandlers.Queue = function()\n\t\tsend(\"CancelQueue\")\n\t\tUI.ShowMode()\n\tend\n\n\tlocal l = screen(\"Loading\")\n\tStyle.label(l, \"LAUNCHING...\", 40, { FontFace = ITALIC, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), TextColor3 = C.Accent })\nend\n\n----------------------------------------------------------------------------------------------\n-- Results\n----------------------------------------------------------------------------------------------\nlocal function buildResults()\n\tlocal f = screen(\"Results\")\n\tStyle.new(\"Frame\", { BackgroundColor3 = C.Bg, BackgroundTransparency = 0.35, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Parent = f })\n\tresults.outcome = Style.label(f, \"\", 140, {\n\t\tFontFace = ITALIC,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0, 30),\n\t\tSize = UDim2.new(1, 0, 0, 150),\n\t})\n\tStyle.textStroke(results.outcome, Color3.fromRGB(20, 0, 60), 6)\n\tresults.reason = Style.label(f, \"\", 26, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 176), TextColor3 = C.Dim })\n\tresults.perfect = Style.label(f, \"PERFECT!\", 40, {\n\t\tFontFace = ITALIC,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0, 210),\n\t\tTextColor3 = C.Gold,\n\t\tVisible = false,\n\t})\n\tStyle.textStroke(results.perfect, Color3.fromRGB(60, 20, 0), 3)\n\tlocal panel = Style.panel(f, { Size = UDim2.fromOffset(640, 250), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 262) })\n\tresults.panel = panel\n\tlocal cols = { \"\", \"YOU\", \"RIVAL\" }\n\tresults.head = {}\n\tfor i, t in ipairs(cols) do\n\t\tresults.head[i] = Style.label(panel, t, 22, {\n\t\t\tPosition = UDim2.fromOffset(20 + (i - 1) * 205, 14),\n\t\t\tSize = UDim2.fromOffset(i == 1 and 200 or 200, 26),\n\t\t\tTextXAlignment = i == 1 and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center,\n\t\t\tTextColor3 = i == 2 and C.Accent or (i == 3 and C.Accent2 or C.Dim),\n\t\t})\n\tend\n\tresults.rows = {}\n\tlocal labels = { \"Robot\", \"HP left\", \"Damage dealt\", \"Hits landed\", \"Times DOWN\" }\n\tfor r, name in ipairs(labels) do\n\t\tlocal y = 48 + (r - 1) * 38\n\t\tlocal row = {}\n\t\trow[1] = Style.label(panel, name, 20, { Font = Style.Body, Position = UDim2.fromOffset(20, y), Size = UDim2.fromOffset(200, 28), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.Dim })\n\t\tfor c = 2, 3 do\n\t\t\trow[c] = Style.label(panel, \"\", 22, { Position = UDim2.fromOffset(20 + (c - 1) * 205, y), Size = UDim2.fromOffset(200, 28) })\n\t\tend\n\t\tresults.rows[r] = row\n\tend\n\tresults.status = Style.label(f, \"\", 20, { Font = Style.Body, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 522), TextColor3 = C.Gold })\n\tlocal bottom = Style.new(\"Frame\", {\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(640, 76),\n\t\tAnchorPoint = Vector2.new(0.5, 1),\n\t\tPosition = UDim2.new(0.5, 0, 1, -40),\n\t\tParent = f,\n\t})\n\tStyle.new(\"UIListLayout\", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 20), Parent = bottom })\n\tlocal rematch, rematchTitle = Style.button(bottom, \"REMATCH\", { color = C.Gold, size = UDim2.fromOffset(310, 76), textSize = 32 })\n\tlocal back = Style.button(bottom, \"BACK TO SELECT\", { color = C.Accent, size = UDim2.fromOffset(310, 76), textSize = 28 })\n\tback.LayoutOrder = 2\n\tresults.rematch = rematch\n\tresults.rematchTitle = rematchTitle\n\twire(rematch, function()\n\t\tif rematchBusy then\n\t\t\treturn\n\t\tend\n\t\trematchBusy = true\n\t\tresults.status.Text = \"Requesting rematch...\"\n\t\tsend(\"Rematch\")\n\tend)\n\twire(back, function()\n\t\tsend(\"Back\")\n\t\tUI.ShowSelect()\n\tend, \"UIBack\")\n\tdefaultSelect.Results = rematch\n\tbackHandlers.Results = function()\n\t\tsend(\"Back\")\n\t\tUI.ShowSelect()\n\tend\nend\n\nlocal REASONS = {\n\tKO = \"by K.O.\",\n\tTIME = \"time up: higher HP wins\",\n\tLEFT = \"opponent left the match\",\n}\n\nfunction UI.ShowResults(data)\n\trematchBusy = false\n\tlocal o = data.outcome\n\tresults.outcome.Text = o == \"WIN\" and \"YOU WIN!\" or (o == \"LOSE\" and \"YOU LOSE\" or \"DRAW\")\n\tresults.outcome.TextColor3 = o == \"WIN\" and C.Gold or (o == \"LOSE\" and Color3.fromRGB(150, 170, 215) or Color3.fromRGB(210, 210, 255))\n\tlocal reason = REASONS[data.reason] or \"\"\n\tif o == \"DRAW\" and data.reason == \"TIME\" then\n\t\treason = \"time up: equal HP\"\n\tend\n\tresults.reason.Text = string.upper(reason) .. string.format(\"   •   %d:%02d\", math.floor((data.duration or 0) / 60), math.floor((data.duration or 0) % 60))\n\tresults.perfect.Visible = data.perfect == true\n\tlocal you = data.you or {}\n\tlocal rival = (data.others or {})[1] or {}\n\tresults.head[3].Text = rival.name and string.upper(rival.name) or \"RIVAL\"\n\tlocal function robotName(id)\n\t\tlocal r = Config.RobotById[id or \"\"]\n\t\treturn r and r.DisplayName or \"-\"\n\tend\n\tlocal vals = {\n\t\t{ robotName(you.robotId), robotName(rival.robotId) },\n\t\t{ tostring(math.max(0, you.hp or 0)), tostring(math.max(0, rival.hp or 0)) },\n\t\t{ tostring(you.damageDealt or 0), tostring(rival.damageDealt or 0) },\n\t\t{ tostring(you.hits or 0), tostring(rival.hits or 0) },\n\t\t{ tostring(you.downs or 0), tostring(rival.downs or 0) },\n\t}\n\tfor r, v in ipairs(vals) do\n\t\tresults.rows[r][2].Text = v[1]\n\t\tresults.rows[r][3].Text = v[2]\n\tend\n\tresults.status.Text = \"\"\n\tresults.rematch.Visible = true\n\tUI.Show(\"Results\")\n\tSound.Play(o == \"WIN\" and \"Win\" or \"Lose\")\nend\n\nfunction UI.OnRematch(data)\n\tif current ~= \"Results\" then\n\t\treturn\n\tend\n\tif data.status == \"waiting\" then\n\t\tresults.status.Text = string.format(\"Waiting for rival... (%d/%d ready)\", data.votes or 1, data.needed or 2)\n\telseif data.status == \"starting\" then\n\t\tresults.status.Text = \"Rematch starting!\"\n\telseif data.status == \"closed\" then\n\t\trematchBusy = false\n\t\tresults.status.Text = data.reason or \"Rematch unavailable\"\n\t\tresults.rematch.Visible = false\n\t\tif gamepadActive() then\n\t\t\tGuiService.SelectedObject = results.back\n\t\tend\n\tend\nend\n\nfunction UI.OnQueue(data)\n\tif data.matched then\n\t\tUI.Show(\"Loading\")\n\t\treturn\n\tend\n\tif not data.inQueue then\n\t\tif current == \"Queue\" then\n\t\t\tUI.ShowMode()\n\t\tend\n\t\treturn\n\tend\n\tif current ~= \"Queue\" then\n\t\tUI.Show(\"Queue\")\n\tend\n\tqueueLabel.Text = \"Searching for an opponent...\"\n\tqueueSub.Text = string.format(\"Queue position %d of %d  •  %d player%s in this server\", data.position or 1, data.count or 1, data.online or 1, (data.online or 1) == 1 and \"\" or \"s\")\nend\n\nfunction UI.ShowTitle()\n\tcamMode = \"Title\"\n\tUI.Show(\"Title\")\nend\n\nfunction UI.ShowSelect()\n\tcamMode = \"Select\"\n\tsetDetail(State.robotId)\n\tUI.Show(\"Select\")\n\tif gamepadActive() then\n\t\tlocal b = robotButtons[State.robotId]\n\t\tGuiService.SelectedObject = b and b.button\n\tend\nend\n\nfunction UI.ShowMode()\n\tcamMode = \"Select\"\n\tlocal r = Config.RobotById[State.robotId]\n\tUI._modeRobotLabel.Text = r and (\"ROBOT: \" .. r.DisplayName .. \"  •  \" .. r.Role) or \"\"\n\tUI.Show(\"Mode\")\nend\n\nfunction UI.ShowQueue(data)\n\tUI.Show(\"Queue\")\n\tUI.OnQueue(data)\nend\n\n----------------------------------------------------------------------------------------------\n-- Lobby camera (menus)\n----------------------------------------------------------------------------------------------\nlocal camCF: CFrame? = nil\nlocal function lobbyStep(dt: number)\n\tif State.mode ~= \"Menu\" then\n\t\tcamCF = nil\n\t\treturn\n\tend\n\tlocal camera = workspace.CurrentCamera\n\tcamera.CameraType = Enum.CameraType.Scriptable\n\tcamera.FieldOfView = 55\n\tcamT += dt\n\tlocal stands = workspace:FindFirstChild(\"Lobby\") and workspace.Lobby:FindFirstChild(\"Stands\")\n\tlocal target: CFrame\n\tif camMode == \"Select\" and stands then\n\t\tlocal r = Config.RobotById[State.robotId]\n\t\tlocal x = ((r and r.Index or 1) - 2) * 14\n\t\tlocal focus = Vector3.new(x, 6, 0)\n\t\ttarget = CFrame.lookAt(focus + Vector3.new(0, 4, 21), focus + Vector3.new(0, 0.5, 0))\n\t\tlocal statue = stands:FindFirstChild(\"Statue\" .. State.robotId)\n\t\tif statue then\n\t\t\tlocal pivot = statue:GetPivot()\n\t\t\tstatue:PivotTo(CFrame.new(pivot.Position) * CFrame.Angles(0, math.pi + math.sin(camT * 0.8) * 0.5, 0))\n\t\tend\n\telse\n\t\tlocal a = camT * 0.12\n\t\tlocal focus = Vector3.new(0, 5, 0)\n\t\ttarget = CFrame.lookAt(focus + Vector3.new(math.sin(a) * 46, 18, math.cos(a) * 46), focus)\n\tend\n\tif not camCF then\n\t\tcamCF = target\n\tend\n\tcamCF = (camCF :: CFrame):Lerp(target, 1 - math.exp(-dt * 4))\n\tcamera.CFrame = camCF :: CFrame\nend\n\n----------------------------------------------------------------------------------------------\n-- Init\n----------------------------------------------------------------------------------------------\nlocal function onBack(_, state)\n\tif state ~= Enum.UserInputState.Begin then\n\t\treturn Enum.ContextActionResult.Pass\n\tend\n\tlocal h = current and backHandlers[current]\n\tif h then\n\t\tSound.Play(\"UIBack\")\n\t\th()\n\t\treturn Enum.ContextActionResult.Sink\n\tend\n\treturn Enum.ContextActionResult.Pass\nend\n\nfunction UI.SetMenuInput(on: boolean)\n\tif on then\n\t\tContextActionService:BindAction(\"RC_MenuBack\", onBack, false, Enum.KeyCode.ButtonB, Enum.KeyCode.Backspace)\n\telse\n\t\tContextActionService:UnbindAction(\"RC_MenuBack\")\n\t\tGuiService.SelectedObject = nil\n\tend\nend\n\nfunction UI.Init(uiRoot: Frame)\n\troot = uiRoot\n\tbuildTitle()\n\tbuildSelect()\n\tbuildMode()\n\tbuildResults()\n\tsetDetail(State.robotId)\n\tRunService:BindToRenderStep(\"RoboClashLobbyCam\", Enum.RenderPriority.Camera.Value + 2, lobbyStep)\n\tState.InputTypeChanged:Connect(function(kind)\n\t\tif kind == \"Gamepad\" and current and GuiService.SelectedObject == nil then\n\t\t\tif current == \"Select\" then\n\t\t\t\tlocal b = robotButtons[State.robotId]\n\t\t\t\tGuiService.SelectedObject = b and b.button\n\t\t\telse\n\t\t\t\tselectDefault()\n\t\t\tend\n\t\telseif kind ~= \"Gamepad\" then\n\t\t\tGuiService.SelectedObject = nil\n\t\tend\n\tend)\n\tUserInputService.GamepadConnected:Connect(function()\n\t\tselectDefault()\n\tend)\n\tUI.SetMenuInput(true)\n\tUI.ShowTitle()\nend\n\nreturn UI\n","message":"The file /Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/UI.luau has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"toolu_01LsZdrZzke9nEGPdad8BWni","startedAtMs":"1791074728539","completedAtMs":"1791074730108"},"model_call_id":"f6f75537-51d9-46fb-a6c9-81f06ac674d8-75-u78q","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791074730113}
{"type":"tool_call","subtype":"started","call_id":"toolu_016FPJUuH7gf7STTa1wYUFJ1","tool_call":{"editToolCall":{"args":{"path":"/Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/UI.luau","streamContent":"\tresults.rematch = rematch\n\tresults.back = back"}},"hookAdditionalContexts":[],"toolCallId":"toolu_016FPJUuH7gf7STTa1wYUFJ1","startedAtMs":"1791074730037"},"model_call_id":"f6f75537-51d9-46fb-a6c9-81f06ac674d8-75-u78q","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791074731194}
{"type":"tool_call","subtype":"completed","call_id":"toolu_016FPJUuH7gf7STTa1wYUFJ1","tool_call":{"editToolCall":{"args":{"path":"/Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/UI.luau","streamContent":"\tresults.rematch = rematch\n\tresults.back = back"},"result":{"success":{"path":"/Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/UI.luau","linesAdded":1,"linesRemoved":1,"diffString":"--- a//Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/UI.luau\n+++ b//Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/UI.luau\n@@ -435,7 +435,7 @@\n \tlocal back = Style.button(bottom, \"BACK TO SELECT\", { color = C.Accent, size = UDim2.fromOffset(310, 76), textSize = 28 })\n \tback.LayoutOrder = 2\n \tresults.rematch = rematch\n-\tresults.rematchTitle = rematchTitle\n+\tresults.back = back\n \twire(rematch, function()\n \t\tif rematchBusy then\n \t\t\treturn","beforeFullFileContent":"-- Menu screens: Title -> Robot Select -> Mode Select (Matchmaking / Bot / Back), queue overlay,\n-- Results (Rematch / Back to Select). Works with mouse, touch and gamepad (SelectedObject + B).\nlocal ContextActionService = game:GetService(\"ContextActionService\")\nlocal GuiService = game:GetService(\"GuiService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal UserInputService = game:GetService(\"UserInputService\")\n\nlocal RC = ReplicatedStorage:WaitForChild(\"RoboClash\")\nlocal Config = require(RC.Config)\nlocal Style = require(script.Parent.Style)\nlocal State = require(script.Parent.State)\nlocal Sound = require(script.Parent.Sound)\n\nlocal MenuRemote = RC:WaitForChild(\"Remotes\"):WaitForChild(\"Menu\")\nlocal C = Style.C\nlocal ITALIC = Font.new(\"rbxasset://fonts/families/GothamSSm.json\", Enum.FontWeight.Heavy, Enum.FontStyle.Italic)\n\nlocal UI = {}\nlocal root: Frame\nlocal screens = {}\nlocal current: string? = nil\nlocal backHandlers = {}\nlocal defaultSelect = {}\nlocal camMode = \"Title\"\nlocal camT = 0\nlocal robotButtons = {}\nlocal detail = {}\nlocal queueLabel: TextLabel\nlocal queueSub: TextLabel\nlocal results = {}\nlocal rematchBusy = false\n\nlocal function send(action: string, arg: any?)\n\tMenuRemote:FireServer(action, arg)\nend\n\nlocal function gamepadActive(): boolean\n\treturn State.lastInput == \"Gamepad\"\nend\n\nlocal function selectDefault()\n\tlocal b = current and defaultSelect[current]\n\tif b and gamepadActive() then\n\t\tGuiService.SelectedObject = b\n\tend\nend\n\nlocal function wire(b: GuiButton, fn: () -> (), soundName: string?)\n\tb.Activated:Connect(function()\n\t\tSound.Play(soundName or \"UISelect\")\n\t\tfn()\n\tend)\n\tb.SelectionGained:Connect(function()\n\t\tSound.Play(\"UIMove\", { volume = 0.2 })\n\tend)\n\tb.MouseEnter:Connect(function()\n\t\tSound.Play(\"UIMove\", { volume = 0.15 })\n\tend)\nend\n\nlocal function screen(name: string): Frame\n\tlocal f = Style.new(\"Frame\", { Name = name, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = root })\n\tscreens[name] = f\n\treturn f\nend\n\nfunction UI.Show(name: string?)\n\tfor n, f in pairs(screens) do\n\t\tf.Visible = n == name\n\tend\n\tcurrent = name\n\tGuiService.SelectedObject = nil\n\tif name then\n\t\tselectDefault()\n\tend\nend\n\nfunction UI.Current(): string?\n\treturn current\nend\n\n----------------------------------------------------------------------------------------------\n-- Title\n----------------------------------------------------------------------------------------------\nlocal function buildTitle()\n\tlocal f = screen(\"Title\")\n\tlocal logo = Style.label(f, \"ROBO CLASH\", 120, {\n\t\tFontFace = ITALIC,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0.12, 0),\n\t\tSize = UDim2.new(1, 0, 0, 130),\n\t\tTextColor3 = Color3.new(1, 1, 1),\n\t})\n\tStyle.textStroke(logo, Color3.fromRGB(30, 0, 90), 6)\n\tStyle.new(\"UIGradient\", {\n\t\tColor = ColorSequence.new(Color3.fromRGB(120, 240, 255), Color3.fromRGB(255, 90, 200)),\n\t\tRotation = 90,\n\t\tParent = logo,\n\t})\n\tlocal sub = Style.label(f, \"A R E N A\", 54, {\n\t\tFontFace = ITALIC,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0.12, 128),\n\t\tTextColor3 = C.Gold,\n\t})\n\tStyle.textStroke(sub, Color3.fromRGB(60, 20, 0), 4)\n\tStyle.label(f, \"Pick a robot. Lock on. Blast them into a DOWN.\", 22, {\n\t\tFont = Style.Body,\n\t\tTextColor3 = C.Dim,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0.12, 200),\n\t})\n\tlocal holder = Style.new(\"Frame\", {\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(380, 86),\n\t\tAnchorPoint = Vector2.new(0.5, 1),\n\t\tPosition = UDim2.new(0.5, 0, 1, -150),\n\t\tParent = f,\n\t})\n\tlocal play = Style.button(holder, \"PLAY\", { color = C.Gold, height = 86, textSize = 44 })\n\tplay.Name = \"Play\"\n\twire(play, function()\n\t\tUI.ShowSelect()\n\tend)\n\tdefaultSelect.Title = play\n\tlocal hint = Style.label(f, \"\", 18, {\n\t\tName = \"Hint\",\n\t\tFont = Style.Body,\n\t\tTextColor3 = C.Dim,\n\t\tAnchorPoint = Vector2.new(0.5, 1),\n\t\tPosition = UDim2.new(0.5, 0, 1, -40),\n\t\tSize = UDim2.new(1, -40, 0, 50),\n\t\tTextWrapped = true,\n\t})\n\tlocal function refreshHint()\n\t\tif State.lastInput == \"Gamepad\" then\n\t\t\thint.Text = \"Left stick move  •  A jump  •  B / LB dash  •  RT gun  •  LT / X bomb  •  RB / Y pod\"\n\t\telseif State.lastInput == \"Touch\" then\n\t\t\thint.Text = \"Left side: move  •  Buttons: GUN  BOMB  POD  JUMP  DASH\"\n\t\telse\n\t\t\thint.Text = \"WASD move  •  Space jump  •  Shift dash  •  LMB / J gun  •  RMB / K bomb  •  E / L pod\"\n\t\tend\n\tend\n\trefreshHint()\n\tState.InputTypeChanged:Connect(refreshHint)\nend\n\n----------------------------------------------------------------------------------------------\n-- Robot select\n----------------------------------------------------------------------------------------------\nlocal STAT_ORDER = { \"Power\", \"Range\", \"Speed\", \"Mobility\", \"Defense\" }\n\nlocal function setDetail(robotId: string)\n\tlocal r = Config.RobotById[robotId]\n\tif not r then\n\t\treturn\n\tend\n\tlocal lo = Config.GetLoadout(robotId)\n\tdetail.name.Text = r.DisplayName\n\tdetail.name.TextColor3 = r.Neon\n\tdetail.role.Text = r.Role\n\tdetail.desc.Text = r.Description\n\tdetail.panelStroke.Color = r.Neon\n\tlocal rows = {\n\t\t{ \"GUN\", lo.Gun.Name, lo.Gun.Blurb },\n\t\t{ \"BOMB\", lo.Bomb.Name, lo.Bomb.Blurb },\n\t\t{ \"POD\", lo.Pod.Name, lo.Pod.Blurb },\n\t\t{ \"LEGS\", lo.Legs.Name, lo.Legs.Blurb },\n\t\t{ \"BODY\", lo.Body.Name, lo.Body.DashAttack and (\"Dash attack: \" .. lo.Body.DashAttack.Name) or \"\" },\n\t}\n\tfor i, row in ipairs(rows) do\n\t\tlocal l = detail.rows[i]\n\t\tl.kind.Text = row[1]\n\t\tl.kind.TextColor3 = r.Neon\n\t\tl.name.Text = row[2] or \"\"\n\t\tl.blurb.Text = row[3] or \"\"\n\tend\n\tfor i, stat in ipairs(STAT_ORDER) do\n\t\tlocal v = r.Stats[stat] or 0\n\t\tfor s, seg in ipairs(detail.stats[i].segs) do\n\t\t\tseg.BackgroundColor3 = s <= v and r.Neon or Color3.fromRGB(40, 46, 80)\n\t\tend\n\tend\n\tfor id, b in pairs(robotButtons) do\n\t\tlocal chosen = id == robotId\n\t\tb.check.Visible = chosen\n\tend\nend\n\nlocal function chooseRobot(robotId: string)\n\tif State.robotId ~= robotId then\n\t\tState.robotId = robotId\n\t\tsend(\"Select\", robotId)\n\tend\n\tsetDetail(robotId)\nend\n\nlocal function buildSelect()\n\tlocal f = screen(\"Select\")\n\tStyle.label(f, \"CHOOSE YOUR ROBOT\", 46, {\n\t\tFontFace = ITALIC,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0, 24),\n\t})\n\tlocal list = Style.new(\"Frame\", {\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(340, 3 * 96 + 2 * 12),\n\t\tPosition = UDim2.new(0, 36, 0.5, -40),\n\t\tAnchorPoint = Vector2.new(0, 0.5),\n\t\tParent = f,\n\t})\n\tStyle.new(\"UIListLayout\", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })\n\tfor i, r in ipairs(Config.Robots) do\n\t\tlocal b = Style.button(list, r.DisplayName, { sub = r.Role, color = r.Neon, height = 96, textSize = 34 })\n\t\tb.LayoutOrder = i\n\t\tb.Name = \"Robot_\" .. r.Id\n\t\tlocal check = Style.label(b, \"✓\", 34, {\n\t\t\tSize = UDim2.fromOffset(40, 40),\n\t\t\tPosition = UDim2.new(1, -52, 0.5, -20),\n\t\t\tTextColor3 = r.Neon,\n\t\t\tVisible = false,\n\t\t})\n\t\trobotButtons[r.Id] = { button = b, check = check }\n\t\tb.SelectionGained:Connect(function()\n\t\t\tchooseRobot(r.Id)\n\t\tend)\n\t\tb.MouseEnter:Connect(function()\n\t\t\tchooseRobot(r.Id)\n\t\tend)\n\t\twire(b, function()\n\t\t\tchooseRobot(r.Id)\n\t\t\tUI.ShowMode()\n\t\tend)\n\tend\n\n\tlocal panel = Style.panel(f, {\n\t\tSize = UDim2.fromOffset(440, 520),\n\t\tAnchorPoint = Vector2.new(1, 0.5),\n\t\tPosition = UDim2.new(1, -36, 0.5, -10),\n\t})\n\tdetail.panelStroke = panel:FindFirstChildOfClass(\"UIStroke\")\n\tdetail.panelStroke.Transparency = 0.1\n\tdetail.name = Style.label(panel, \"\", 50, { FontFace = ITALIC, Position = UDim2.fromOffset(22, 14), Size = UDim2.new(1, -44, 0, 54), TextXAlignment = Enum.TextXAlignment.Left })\n\tdetail.role = Style.label(panel, \"\", 20, { Position = UDim2.fromOffset(24, 66), Size = UDim2.new(1, -44, 0, 24), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.Gold })\n\tdetail.desc = Style.label(panel, \"\", 17, {\n\t\tFont = Style.Body,\n\t\tTextColor3 = C.Dim,\n\t\tTextWrapped = true,\n\t\tTextXAlignment = Enum.TextXAlignment.Left,\n\t\tTextYAlignment = Enum.TextYAlignment.Top,\n\t\tPosition = UDim2.fromOffset(24, 96),\n\t\tSize = UDim2.new(1, -44, 0, 44),\n\t})\n\tdetail.rows = {}\n\tfor i = 1, 5 do\n\t\tlocal y = 146 + (i - 1) * 44\n\t\tlocal kind = Style.label(panel, \"\", 16, { Position = UDim2.fromOffset(24, y), Size = UDim2.fromOffset(60, 20), TextXAlignment = Enum.TextXAlignment.Left })\n\t\tlocal name = Style.label(panel, \"\", 19, { Position = UDim2.fromOffset(88, y - 2), Size = UDim2.new(1, -110, 0, 22), TextXAlignment = Enum.TextXAlignment.Left })\n\t\tlocal blurb = Style.label(panel, \"\", 14, {\n\t\t\tFont = Style.Body,\n\t\t\tTextColor3 = C.Dim,\n\t\t\tPosition = UDim2.fromOffset(88, y + 20),\n\t\t\tSize = UDim2.new(1, -110, 0, 16),\n\t\t\tTextXAlignment = Enum.TextXAlignment.Left,\n\t\t})\n\t\tdetail.rows[i] = { kind = kind, name = name, blurb = blurb }\n\tend\n\tdetail.stats = {}\n\tfor i, stat in ipairs(STAT_ORDER) do\n\t\tlocal y = 372 + (i - 1) * 27\n\t\tStyle.label(panel, string.upper(stat), 15, { Position = UDim2.fromOffset(24, y), Size = UDim2.fromOffset(110, 20), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.Dim })\n\t\tlocal segs = {}\n\t\tfor s = 1, 5 do\n\t\t\tlocal seg = Style.new(\"Frame\", {\n\t\t\t\tBackgroundColor3 = C.Accent,\n\t\t\t\tBorderSizePixel = 0,\n\t\t\t\tSize = UDim2.fromOffset(48, 14),\n\t\t\t\tPosition = UDim2.fromOffset(140 + (s - 1) * 54, y + 3),\n\t\t\t\tParent = panel,\n\t\t\t})\n\t\t\tStyle.corner(seg, 4)\n\t\t\tsegs[s] = seg\n\t\tend\n\t\tdetail.stats[i] = { segs = segs }\n\tend\n\n\tlocal bottom = Style.new(\"Frame\", {\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(560, 72),\n\t\tAnchorPoint = Vector2.new(0.5, 1),\n\t\tPosition = UDim2.new(0.5, 0, 1, -24),\n\t\tParent = f,\n\t})\n\tStyle.new(\"UIListLayout\", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 20), Parent = bottom })\n\tlocal back = Style.button(bottom, \"BACK\", { color = C.Dim, size = UDim2.fromOffset(200, 72) })\n\tback.LayoutOrder = 1\n\tlocal go = Style.button(bottom, \"CONFIRM\", { color = C.Gold, size = UDim2.fromOffset(340, 72), textSize = 34 })\n\tgo.LayoutOrder = 2\n\twire(back, function()\n\t\tUI.ShowTitle()\n\tend, \"UIBack\")\n\twire(go, function()\n\t\tUI.ShowMode()\n\tend)\n\tbackHandlers.Select = function()\n\t\tUI.ShowTitle()\n\tend\nend\n\n----------------------------------------------------------------------------------------------\n-- Mode select + queue\n----------------------------------------------------------------------------------------------\nlocal function buildMode()\n\tlocal f = screen(\"Mode\")\n\tlocal title = Style.label(f, \"SELECT MODE\", 46, { FontFace = ITALIC, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 24) })\n\ttitle.Name = \"Title\"\n\tlocal robotLabel = Style.label(f, \"\", 22, { Name = \"Robot\", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 80), TextColor3 = C.Gold })\n\tscreens.Mode:SetAttribute(\"Ready\", true)\n\tlocal col = Style.new(\"Frame\", {\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(470, 3 * 100 + 2 * 14),\n\t\tAnchorPoint = Vector2.new(0, 0.5),\n\t\tPosition = UDim2.new(0, 40, 0.55, 0),\n\t\tParent = f,\n\t})\n\tStyle.new(\"UIListLayout\", { Padding = UDim.new(0, 14), SortOrder = Enum.SortOrder.LayoutOrder, Parent = col })\n\tlocal mm = Style.button(col, \"MATCHMAKING\", { sub = \"Fight another player in this server\", color = C.Accent2, height = 100, textSize = 36 })\n\tmm.LayoutOrder = 1\n\tlocal bot = Style.button(col, \"BATTLE A BOT\", { sub = \"Practice against a CPU robot\", color = C.Accent, height = 100, textSize = 36 })\n\tbot.LayoutOrder = 2\n\tlocal back = Style.button(col, \"BACK\", { sub = \"Change robot\", color = C.Dim, height = 100, textSize = 36 })\n\tback.LayoutOrder = 3\n\twire(mm, function()\n\t\tsend(\"Queue\")\n\t\tUI.ShowQueue({ inQueue = true, position = 1, count = 1 })\n\tend)\n\twire(bot, function()\n\t\tsend(\"Bot\")\n\t\tUI.Show(\"Loading\")\n\tend)\n\twire(back, function()\n\t\tUI.ShowSelect()\n\tend, \"UIBack\")\n\tdefaultSelect.Mode = bot\n\tbackHandlers.Mode = function()\n\t\tUI.ShowSelect()\n\tend\n\tUI._modeRobotLabel = robotLabel\n\n\tlocal q = screen(\"Queue\")\n\tlocal qp = Style.panel(q, { Size = UDim2.fromOffset(560, 330), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) })\n\tStyle.label(qp, \"MATCHMAKING\", 40, { FontFace = ITALIC, Position = UDim2.fromOffset(0, 18), TextColor3 = C.Accent2 })\n\tqueueLabel = Style.label(qp, \"Searching for an opponent...\", 26, { Position = UDim2.fromOffset(0, 78) })\n\tqueueSub = Style.label(qp, \"\", 18, { Font = Style.Body, TextColor3 = C.Dim, Position = UDim2.fromOffset(0, 116), TextWrapped = true, Size = UDim2.new(1, -40, 0, 44) })\n\tqueueSub.Position = UDim2.fromOffset(20, 116)\n\tlocal qb = Style.new(\"Frame\", { BackgroundTransparency = 1, Size = UDim2.new(1, -60, 0, 140), Position = UDim2.fromOffset(30, 172), Parent = qp })\n\tStyle.new(\"UIListLayout\", { Padding = UDim.new(0, 12), Parent = qb })\n\tlocal qbot = Style.button(qb, \"BATTLE A BOT INSTEAD\", { color = C.Accent, height = 62, textSize = 26 })\n\tlocal qcancel = Style.button(qb, \"CANCEL\", { color = C.Dim, height = 62, textSize = 26 })\n\tqcancel.LayoutOrder = 2\n\twire(qbot, function()\n\t\tsend(\"Bot\")\n\t\tUI.Show(\"Loading\")\n\tend)\n\twire(qcancel, function()\n\t\tsend(\"CancelQueue\")\n\t\tUI.ShowMode()\n\tend, \"UIBack\")\n\tdefaultSelect.Queue = qcancel\n\tbackHandlers.Queue = function()\n\t\tsend(\"CancelQueue\")\n\t\tUI.ShowMode()\n\tend\n\n\tlocal l = screen(\"Loading\")\n\tStyle.label(l, \"LAUNCHING...\", 40, { FontFace = ITALIC, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), TextColor3 = C.Accent })\nend\n\n----------------------------------------------------------------------------------------------\n-- Results\n----------------------------------------------------------------------------------------------\nlocal function buildResults()\n\tlocal f = screen(\"Results\")\n\tStyle.new(\"Frame\", { BackgroundColor3 = C.Bg, BackgroundTransparency = 0.35, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Parent = f })\n\tresults.outcome = Style.label(f, \"\", 140, {\n\t\tFontFace = ITALIC,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0, 30),\n\t\tSize = UDim2.new(1, 0, 0, 150),\n\t})\n\tStyle.textStroke(results.outcome, Color3.fromRGB(20, 0, 60), 6)\n\tresults.reason = Style.label(f, \"\", 26, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 176), TextColor3 = C.Dim })\n\tresults.perfect = Style.label(f, \"PERFECT!\", 40, {\n\t\tFontFace = ITALIC,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0, 210),\n\t\tTextColor3 = C.Gold,\n\t\tVisible = false,\n\t})\n\tStyle.textStroke(results.perfect, Color3.fromRGB(60, 20, 0), 3)\n\tlocal panel = Style.panel(f, { Size = UDim2.fromOffset(640, 250), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 262) })\n\tresults.panel = panel\n\tlocal cols = { \"\", \"YOU\", \"RIVAL\" }\n\tresults.head = {}\n\tfor i, t in ipairs(cols) do\n\t\tresults.head[i] = Style.label(panel, t, 22, {\n\t\t\tPosition = UDim2.fromOffset(20 + (i - 1) * 205, 14),\n\t\t\tSize = UDim2.fromOffset(i == 1 and 200 or 200, 26),\n\t\t\tTextXAlignment = i == 1 and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center,\n\t\t\tTextColor3 = i == 2 and C.Accent or (i == 3 and C.Accent2 or C.Dim),\n\t\t})\n\tend\n\tresults.rows = {}\n\tlocal labels = { \"Robot\", \"HP left\", \"Damage dealt\", \"Hits landed\", \"Times DOWN\" }\n\tfor r, name in ipairs(labels) do\n\t\tlocal y = 48 + (r - 1) * 38\n\t\tlocal row = {}\n\t\trow[1] = Style.label(panel, name, 20, { Font = Style.Body, Position = UDim2.fromOffset(20, y), Size = UDim2.fromOffset(200, 28), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.Dim })\n\t\tfor c = 2, 3 do\n\t\t\trow[c] = Style.label(panel, \"\", 22, { Position = UDim2.fromOffset(20 + (c - 1) * 205, y), Size = UDim2.fromOffset(200, 28) })\n\t\tend\n\t\tresults.rows[r] = row\n\tend\n\tresults.status = Style.label(f, \"\", 20, { Font = Style.Body, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 522), TextColor3 = C.Gold })\n\tlocal bottom = Style.new(\"Frame\", {\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(640, 76),\n\t\tAnchorPoint = Vector2.new(0.5, 1),\n\t\tPosition = UDim2.new(0.5, 0, 1, -40),\n\t\tParent = f,\n\t})\n\tStyle.new(\"UIListLayout\", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 20), Parent = bottom })\n\tlocal rematch, rematchTitle = Style.button(bottom, \"REMATCH\", { color = C.Gold, size = UDim2.fromOffset(310, 76), textSize = 32 })\n\tlocal back = Style.button(bottom, \"BACK TO SELECT\", { color = C.Accent, size = UDim2.fromOffset(310, 76), textSize = 28 })\n\tback.LayoutOrder = 2\n\tresults.rematch = rematch\n\tresults.rematchTitle = rematchTitle\n\twire(rematch, function()\n\t\tif rematchBusy then\n\t\t\treturn\n\t\tend\n\t\trematchBusy = true\n\t\tresults.status.Text = \"Requesting rematch...\"\n\t\tsend(\"Rematch\")\n\tend)\n\twire(back, function()\n\t\tsend(\"Back\")\n\t\tUI.ShowSelect()\n\tend, \"UIBack\")\n\tdefaultSelect.Results = rematch\n\tbackHandlers.Results = function()\n\t\tsend(\"Back\")\n\t\tUI.ShowSelect()\n\tend\nend\n\nlocal REASONS = {\n\tKO = \"by K.O.\",\n\tTIME = \"time up: higher HP wins\",\n\tLEFT = \"opponent left the match\",\n}\n\nfunction UI.ShowResults(data)\n\trematchBusy = false\n\tlocal o = data.outcome\n\tresults.outcome.Text = o == \"WIN\" and \"YOU WIN!\" or (o == \"LOSE\" and \"YOU LOSE\" or \"DRAW\")\n\tresults.outcome.TextColor3 = o == \"WIN\" and C.Gold or (o == \"LOSE\" and Color3.fromRGB(150, 170, 215) or Color3.fromRGB(210, 210, 255))\n\tlocal reason = REASONS[data.reason] or \"\"\n\tif o == \"DRAW\" and data.reason == \"TIME\" then\n\t\treason = \"time up: equal HP\"\n\tend\n\tresults.reason.Text = string.upper(reason) .. string.format(\"   •   %d:%02d\", math.floor((data.duration or 0) / 60), math.floor((data.duration or 0) % 60))\n\tresults.perfect.Visible = data.perfect == true\n\tlocal you = data.you or {}\n\tlocal rival = (data.others or {})[1] or {}\n\tresults.head[3].Text = rival.name and string.upper(rival.name) or \"RIVAL\"\n\tlocal function robotName(id)\n\t\tlocal r = Config.RobotById[id or \"\"]\n\t\treturn r and r.DisplayName or \"-\"\n\tend\n\tlocal vals = {\n\t\t{ robotName(you.robotId), robotName(rival.robotId) },\n\t\t{ tostring(math.max(0, you.hp or 0)), tostring(math.max(0, rival.hp or 0)) },\n\t\t{ tostring(you.damageDealt or 0), tostring(rival.damageDealt or 0) },\n\t\t{ tostring(you.hits or 0), tostring(rival.hits or 0) },\n\t\t{ tostring(you.downs or 0), tostring(rival.downs or 0) },\n\t}\n\tfor r, v in ipairs(vals) do\n\t\tresults.rows[r][2].Text = v[1]\n\t\tresults.rows[r][3].Text = v[2]\n\tend\n\tresults.status.Text = \"\"\n\tresults.rematch.Visible = true\n\tUI.Show(\"Results\")\n\tSound.Play(o == \"WIN\" and \"Win\" or \"Lose\")\nend\n\nfunction UI.OnRematch(data)\n\tif current ~= \"Results\" then\n\t\treturn\n\tend\n\tif data.status == \"waiting\" then\n\t\tresults.status.Text = string.format(\"Waiting for rival... (%d/%d ready)\", data.votes or 1, data.needed or 2)\n\telseif data.status == \"starting\" then\n\t\tresults.status.Text = \"Rematch starting!\"\n\telseif data.status == \"closed\" then\n\t\trematchBusy = false\n\t\tresults.status.Text = data.reason or \"Rematch unavailable\"\n\t\tresults.rematch.Visible = false\n\t\tif gamepadActive() then\n\t\t\tGuiService.SelectedObject = results.back\n\t\tend\n\tend\nend\n\nfunction UI.OnQueue(data)\n\tif data.matched then\n\t\tUI.Show(\"Loading\")\n\t\treturn\n\tend\n\tif not data.inQueue then\n\t\tif current == \"Queue\" then\n\t\t\tUI.ShowMode()\n\t\tend\n\t\treturn\n\tend\n\tif current ~= \"Queue\" then\n\t\tUI.Show(\"Queue\")\n\tend\n\tqueueLabel.Text = \"Searching for an opponent...\"\n\tqueueSub.Text = string.format(\"Queue position %d of %d  •  %d player%s in this server\", data.position or 1, data.count or 1, data.online or 1, (data.online or 1) == 1 and \"\" or \"s\")\nend\n\nfunction UI.ShowTitle()\n\tcamMode = \"Title\"\n\tUI.Show(\"Title\")\nend\n\nfunction UI.ShowSelect()\n\tcamMode = \"Select\"\n\tsetDetail(State.robotId)\n\tUI.Show(\"Select\")\n\tif gamepadActive() then\n\t\tlocal b = robotButtons[State.robotId]\n\t\tGuiService.SelectedObject = b and b.button\n\tend\nend\n\nfunction UI.ShowMode()\n\tcamMode = \"Select\"\n\tlocal r = Config.RobotById[State.robotId]\n\tUI._modeRobotLabel.Text = r and (\"ROBOT: \" .. r.DisplayName .. \"  •  \" .. r.Role) or \"\"\n\tUI.Show(\"Mode\")\nend\n\nfunction UI.ShowQueue(data)\n\tUI.Show(\"Queue\")\n\tUI.OnQueue(data)\nend\n\n----------------------------------------------------------------------------------------------\n-- Lobby camera (menus)\n----------------------------------------------------------------------------------------------\nlocal camCF: CFrame? = nil\nlocal function lobbyStep(dt: number)\n\tif State.mode ~= \"Menu\" then\n\t\tcamCF = nil\n\t\treturn\n\tend\n\tlocal camera = workspace.CurrentCamera\n\tcamera.CameraType = Enum.CameraType.Scriptable\n\tcamera.FieldOfView = 55\n\tcamT += dt\n\tlocal stands = workspace:FindFirstChild(\"Lobby\") and workspace.Lobby:FindFirstChild(\"Stands\")\n\tlocal target: CFrame\n\tif camMode == \"Select\" and stands then\n\t\tlocal r = Config.RobotById[State.robotId]\n\t\tlocal x = ((r and r.Index or 1) - 2) * 14\n\t\tlocal focus = Vector3.new(x, 6, 0)\n\t\ttarget = CFrame.lookAt(focus + Vector3.new(0, 4, 21), focus + Vector3.new(0, 0.5, 0))\n\t\tlocal statue = stands:FindFirstChild(\"Statue\" .. State.robotId)\n\t\tif statue then\n\t\t\tlocal pivot = statue:GetPivot()\n\t\t\tstatue:PivotTo(CFrame.new(pivot.Position) * CFrame.Angles(0, math.pi + math.sin(camT * 0.8) * 0.5, 0))\n\t\tend\n\telse\n\t\tlocal a = camT * 0.12\n\t\tlocal focus = Vector3.new(0, 5, 0)\n\t\ttarget = CFrame.lookAt(focus + Vector3.new(math.sin(a) * 46, 18, math.cos(a) * 46), focus)\n\tend\n\tif not camCF then\n\t\tcamCF = target\n\tend\n\tcamCF = (camCF :: CFrame):Lerp(target, 1 - math.exp(-dt * 4))\n\tcamera.CFrame = camCF :: CFrame\nend\n\n----------------------------------------------------------------------------------------------\n-- Init\n----------------------------------------------------------------------------------------------\nlocal function onBack(_, state)\n\tif state ~= Enum.UserInputState.Begin then\n\t\treturn Enum.ContextActionResult.Pass\n\tend\n\tlocal h = current and backHandlers[current]\n\tif h then\n\t\tSound.Play(\"UIBack\")\n\t\th()\n\t\treturn Enum.ContextActionResult.Sink\n\tend\n\treturn Enum.ContextActionResult.Pass\nend\n\nfunction UI.SetMenuInput(on: boolean)\n\tif on then\n\t\tContextActionService:BindAction(\"RC_MenuBack\", onBack, false, Enum.KeyCode.ButtonB, Enum.KeyCode.Backspace)\n\telse\n\t\tContextActionService:UnbindAction(\"RC_MenuBack\")\n\t\tGuiService.SelectedObject = nil\n\tend\nend\n\nfunction UI.Init(uiRoot: Frame)\n\troot = uiRoot\n\tbuildTitle()\n\tbuildSelect()\n\tbuildMode()\n\tbuildResults()\n\tsetDetail(State.robotId)\n\tRunService:BindToRenderStep(\"RoboClashLobbyCam\", Enum.RenderPriority.Camera.Value + 2, lobbyStep)\n\tState.InputTypeChanged:Connect(function(kind)\n\t\tif kind == \"Gamepad\" and current and GuiService.SelectedObject == nil then\n\t\t\tif current == \"Select\" then\n\t\t\t\tlocal b = robotButtons[State.robotId]\n\t\t\t\tGuiService.SelectedObject = b and b.button\n\t\t\telse\n\t\t\t\tselectDefault()\n\t\t\tend\n\t\telseif kind ~= \"Gamepad\" then\n\t\t\tGuiService.SelectedObject = nil\n\t\tend\n\tend)\n\tUserInputService.GamepadConnected:Connect(function()\n\t\tselectDefault()\n\tend)\n\tUI.SetMenuInput(true)\n\tUI.ShowTitle()\nend\n\nreturn UI\n","afterFullFileContent":"-- Menu screens: Title -> Robot Select -> Mode Select (Matchmaking / Bot / Back), queue overlay,\n-- Results (Rematch / Back to Select). Works with mouse, touch and gamepad (SelectedObject + B).\nlocal ContextActionService = game:GetService(\"ContextActionService\")\nlocal GuiService = game:GetService(\"GuiService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal UserInputService = game:GetService(\"UserInputService\")\n\nlocal RC = ReplicatedStorage:WaitForChild(\"RoboClash\")\nlocal Config = require(RC.Config)\nlocal Style = require(script.Parent.Style)\nlocal State = require(script.Parent.State)\nlocal Sound = require(script.Parent.Sound)\n\nlocal MenuRemote = RC:WaitForChild(\"Remotes\"):WaitForChild(\"Menu\")\nlocal C = Style.C\nlocal ITALIC = Font.new(\"rbxasset://fonts/families/GothamSSm.json\", Enum.FontWeight.Heavy, Enum.FontStyle.Italic)\n\nlocal UI = {}\nlocal root: Frame\nlocal screens = {}\nlocal current: string? = nil\nlocal backHandlers = {}\nlocal defaultSelect = {}\nlocal camMode = \"Title\"\nlocal camT = 0\nlocal robotButtons = {}\nlocal detail = {}\nlocal queueLabel: TextLabel\nlocal queueSub: TextLabel\nlocal results = {}\nlocal rematchBusy = false\n\nlocal function send(action: string, arg: any?)\n\tMenuRemote:FireServer(action, arg)\nend\n\nlocal function gamepadActive(): boolean\n\treturn State.lastInput == \"Gamepad\"\nend\n\nlocal function selectDefault()\n\tlocal b = current and defaultSelect[current]\n\tif b and gamepadActive() then\n\t\tGuiService.SelectedObject = b\n\tend\nend\n\nlocal function wire(b: GuiButton, fn: () -> (), soundName: string?)\n\tb.Activated:Connect(function()\n\t\tSound.Play(soundName or \"UISelect\")\n\t\tfn()\n\tend)\n\tb.SelectionGained:Connect(function()\n\t\tSound.Play(\"UIMove\", { volume = 0.2 })\n\tend)\n\tb.MouseEnter:Connect(function()\n\t\tSound.Play(\"UIMove\", { volume = 0.15 })\n\tend)\nend\n\nlocal function screen(name: string): Frame\n\tlocal f = Style.new(\"Frame\", { Name = name, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = root })\n\tscreens[name] = f\n\treturn f\nend\n\nfunction UI.Show(name: string?)\n\tfor n, f in pairs(screens) do\n\t\tf.Visible = n == name\n\tend\n\tcurrent = name\n\tGuiService.SelectedObject = nil\n\tif name then\n\t\tselectDefault()\n\tend\nend\n\nfunction UI.Current(): string?\n\treturn current\nend\n\n----------------------------------------------------------------------------------------------\n-- Title\n----------------------------------------------------------------------------------------------\nlocal function buildTitle()\n\tlocal f = screen(\"Title\")\n\tlocal logo = Style.label(f, \"ROBO CLASH\", 120, {\n\t\tFontFace = ITALIC,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0.12, 0),\n\t\tSize = UDim2.new(1, 0, 0, 130),\n\t\tTextColor3 = Color3.new(1, 1, 1),\n\t})\n\tStyle.textStroke(logo, Color3.fromRGB(30, 0, 90), 6)\n\tStyle.new(\"UIGradient\", {\n\t\tColor = ColorSequence.new(Color3.fromRGB(120, 240, 255), Color3.fromRGB(255, 90, 200)),\n\t\tRotation = 90,\n\t\tParent = logo,\n\t})\n\tlocal sub = Style.label(f, \"A R E N A\", 54, {\n\t\tFontFace = ITALIC,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0.12, 128),\n\t\tTextColor3 = C.Gold,\n\t})\n\tStyle.textStroke(sub, Color3.fromRGB(60, 20, 0), 4)\n\tStyle.label(f, \"Pick a robot. Lock on. Blast them into a DOWN.\", 22, {\n\t\tFont = Style.Body,\n\t\tTextColor3 = C.Dim,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0.12, 200),\n\t})\n\tlocal holder = Style.new(\"Frame\", {\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(380, 86),\n\t\tAnchorPoint = Vector2.new(0.5, 1),\n\t\tPosition = UDim2.new(0.5, 0, 1, -150),\n\t\tParent = f,\n\t})\n\tlocal play = Style.button(holder, \"PLAY\", { color = C.Gold, height = 86, textSize = 44 })\n\tplay.Name = \"Play\"\n\twire(play, function()\n\t\tUI.ShowSelect()\n\tend)\n\tdefaultSelect.Title = play\n\tlocal hint = Style.label(f, \"\", 18, {\n\t\tName = \"Hint\",\n\t\tFont = Style.Body,\n\t\tTextColor3 = C.Dim,\n\t\tAnchorPoint = Vector2.new(0.5, 1),\n\t\tPosition = UDim2.new(0.5, 0, 1, -40),\n\t\tSize = UDim2.new(1, -40, 0, 50),\n\t\tTextWrapped = true,\n\t})\n\tlocal function refreshHint()\n\t\tif State.lastInput == \"Gamepad\" then\n\t\t\thint.Text = \"Left stick move  •  A jump  •  B / LB dash  •  RT gun  •  LT / X bomb  •  RB / Y pod\"\n\t\telseif State.lastInput == \"Touch\" then\n\t\t\thint.Text = \"Left side: move  •  Buttons: GUN  BOMB  POD  JUMP  DASH\"\n\t\telse\n\t\t\thint.Text = \"WASD move  •  Space jump  •  Shift dash  •  LMB / J gun  •  RMB / K bomb  •  E / L pod\"\n\t\tend\n\tend\n\trefreshHint()\n\tState.InputTypeChanged:Connect(refreshHint)\nend\n\n----------------------------------------------------------------------------------------------\n-- Robot select\n----------------------------------------------------------------------------------------------\nlocal STAT_ORDER = { \"Power\", \"Range\", \"Speed\", \"Mobility\", \"Defense\" }\n\nlocal function setDetail(robotId: string)\n\tlocal r = Config.RobotById[robotId]\n\tif not r then\n\t\treturn\n\tend\n\tlocal lo = Config.GetLoadout(robotId)\n\tdetail.name.Text = r.DisplayName\n\tdetail.name.TextColor3 = r.Neon\n\tdetail.role.Text = r.Role\n\tdetail.desc.Text = r.Description\n\tdetail.panelStroke.Color = r.Neon\n\tlocal rows = {\n\t\t{ \"GUN\", lo.Gun.Name, lo.Gun.Blurb },\n\t\t{ \"BOMB\", lo.Bomb.Name, lo.Bomb.Blurb },\n\t\t{ \"POD\", lo.Pod.Name, lo.Pod.Blurb },\n\t\t{ \"LEGS\", lo.Legs.Name, lo.Legs.Blurb },\n\t\t{ \"BODY\", lo.Body.Name, lo.Body.DashAttack and (\"Dash attack: \" .. lo.Body.DashAttack.Name) or \"\" },\n\t}\n\tfor i, row in ipairs(rows) do\n\t\tlocal l = detail.rows[i]\n\t\tl.kind.Text = row[1]\n\t\tl.kind.TextColor3 = r.Neon\n\t\tl.name.Text = row[2] or \"\"\n\t\tl.blurb.Text = row[3] or \"\"\n\tend\n\tfor i, stat in ipairs(STAT_ORDER) do\n\t\tlocal v = r.Stats[stat] or 0\n\t\tfor s, seg in ipairs(detail.stats[i].segs) do\n\t\t\tseg.BackgroundColor3 = s <= v and r.Neon or Color3.fromRGB(40, 46, 80)\n\t\tend\n\tend\n\tfor id, b in pairs(robotButtons) do\n\t\tlocal chosen = id == robotId\n\t\tb.check.Visible = chosen\n\tend\nend\n\nlocal function chooseRobot(robotId: string)\n\tif State.robotId ~= robotId then\n\t\tState.robotId = robotId\n\t\tsend(\"Select\", robotId)\n\tend\n\tsetDetail(robotId)\nend\n\nlocal function buildSelect()\n\tlocal f = screen(\"Select\")\n\tStyle.label(f, \"CHOOSE YOUR ROBOT\", 46, {\n\t\tFontFace = ITALIC,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0, 24),\n\t})\n\tlocal list = Style.new(\"Frame\", {\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(340, 3 * 96 + 2 * 12),\n\t\tPosition = UDim2.new(0, 36, 0.5, -40),\n\t\tAnchorPoint = Vector2.new(0, 0.5),\n\t\tParent = f,\n\t})\n\tStyle.new(\"UIListLayout\", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })\n\tfor i, r in ipairs(Config.Robots) do\n\t\tlocal b = Style.button(list, r.DisplayName, { sub = r.Role, color = r.Neon, height = 96, textSize = 34 })\n\t\tb.LayoutOrder = i\n\t\tb.Name = \"Robot_\" .. r.Id\n\t\tlocal check = Style.label(b, \"✓\", 34, {\n\t\t\tSize = UDim2.fromOffset(40, 40),\n\t\t\tPosition = UDim2.new(1, -52, 0.5, -20),\n\t\t\tTextColor3 = r.Neon,\n\t\t\tVisible = false,\n\t\t})\n\t\trobotButtons[r.Id] = { button = b, check = check }\n\t\tb.SelectionGained:Connect(function()\n\t\t\tchooseRobot(r.Id)\n\t\tend)\n\t\tb.MouseEnter:Connect(function()\n\t\t\tchooseRobot(r.Id)\n\t\tend)\n\t\twire(b, function()\n\t\t\tchooseRobot(r.Id)\n\t\t\tUI.ShowMode()\n\t\tend)\n\tend\n\n\tlocal panel = Style.panel(f, {\n\t\tSize = UDim2.fromOffset(440, 520),\n\t\tAnchorPoint = Vector2.new(1, 0.5),\n\t\tPosition = UDim2.new(1, -36, 0.5, -10),\n\t})\n\tdetail.panelStroke = panel:FindFirstChildOfClass(\"UIStroke\")\n\tdetail.panelStroke.Transparency = 0.1\n\tdetail.name = Style.label(panel, \"\", 50, { FontFace = ITALIC, Position = UDim2.fromOffset(22, 14), Size = UDim2.new(1, -44, 0, 54), TextXAlignment = Enum.TextXAlignment.Left })\n\tdetail.role = Style.label(panel, \"\", 20, { Position = UDim2.fromOffset(24, 66), Size = UDim2.new(1, -44, 0, 24), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.Gold })\n\tdetail.desc = Style.label(panel, \"\", 17, {\n\t\tFont = Style.Body,\n\t\tTextColor3 = C.Dim,\n\t\tTextWrapped = true,\n\t\tTextXAlignment = Enum.TextXAlignment.Left,\n\t\tTextYAlignment = Enum.TextYAlignment.Top,\n\t\tPosition = UDim2.fromOffset(24, 96),\n\t\tSize = UDim2.new(1, -44, 0, 44),\n\t})\n\tdetail.rows = {}\n\tfor i = 1, 5 do\n\t\tlocal y = 146 + (i - 1) * 44\n\t\tlocal kind = Style.label(panel, \"\", 16, { Position = UDim2.fromOffset(24, y), Size = UDim2.fromOffset(60, 20), TextXAlignment = Enum.TextXAlignment.Left })\n\t\tlocal name = Style.label(panel, \"\", 19, { Position = UDim2.fromOffset(88, y - 2), Size = UDim2.new(1, -110, 0, 22), TextXAlignment = Enum.TextXAlignment.Left })\n\t\tlocal blurb = Style.label(panel, \"\", 14, {\n\t\t\tFont = Style.Body,\n\t\t\tTextColor3 = C.Dim,\n\t\t\tPosition = UDim2.fromOffset(88, y + 20),\n\t\t\tSize = UDim2.new(1, -110, 0, 16),\n\t\t\tTextXAlignment = Enum.TextXAlignment.Left,\n\t\t})\n\t\tdetail.rows[i] = { kind = kind, name = name, blurb = blurb }\n\tend\n\tdetail.stats = {}\n\tfor i, stat in ipairs(STAT_ORDER) do\n\t\tlocal y = 372 + (i - 1) * 27\n\t\tStyle.label(panel, string.upper(stat), 15, { Position = UDim2.fromOffset(24, y), Size = UDim2.fromOffset(110, 20), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.Dim })\n\t\tlocal segs = {}\n\t\tfor s = 1, 5 do\n\t\t\tlocal seg = Style.new(\"Frame\", {\n\t\t\t\tBackgroundColor3 = C.Accent,\n\t\t\t\tBorderSizePixel = 0,\n\t\t\t\tSize = UDim2.fromOffset(48, 14),\n\t\t\t\tPosition = UDim2.fromOffset(140 + (s - 1) * 54, y + 3),\n\t\t\t\tParent = panel,\n\t\t\t})\n\t\t\tStyle.corner(seg, 4)\n\t\t\tsegs[s] = seg\n\t\tend\n\t\tdetail.stats[i] = { segs = segs }\n\tend\n\n\tlocal bottom = Style.new(\"Frame\", {\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(560, 72),\n\t\tAnchorPoint = Vector2.new(0.5, 1),\n\t\tPosition = UDim2.new(0.5, 0, 1, -24),\n\t\tParent = f,\n\t})\n\tStyle.new(\"UIListLayout\", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 20), Parent = bottom })\n\tlocal back = Style.button(bottom, \"BACK\", { color = C.Dim, size = UDim2.fromOffset(200, 72) })\n\tback.LayoutOrder = 1\n\tlocal go = Style.button(bottom, \"CONFIRM\", { color = C.Gold, size = UDim2.fromOffset(340, 72), textSize = 34 })\n\tgo.LayoutOrder = 2\n\twire(back, function()\n\t\tUI.ShowTitle()\n\tend, \"UIBack\")\n\twire(go, function()\n\t\tUI.ShowMode()\n\tend)\n\tbackHandlers.Select = function()\n\t\tUI.ShowTitle()\n\tend\nend\n\n----------------------------------------------------------------------------------------------\n-- Mode select + queue\n----------------------------------------------------------------------------------------------\nlocal function buildMode()\n\tlocal f = screen(\"Mode\")\n\tlocal title = Style.label(f, \"SELECT MODE\", 46, { FontFace = ITALIC, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 24) })\n\ttitle.Name = \"Title\"\n\tlocal robotLabel = Style.label(f, \"\", 22, { Name = \"Robot\", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 80), TextColor3 = C.Gold })\n\tscreens.Mode:SetAttribute(\"Ready\", true)\n\tlocal col = Style.new(\"Frame\", {\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(470, 3 * 100 + 2 * 14),\n\t\tAnchorPoint = Vector2.new(0, 0.5),\n\t\tPosition = UDim2.new(0, 40, 0.55, 0),\n\t\tParent = f,\n\t})\n\tStyle.new(\"UIListLayout\", { Padding = UDim.new(0, 14), SortOrder = Enum.SortOrder.LayoutOrder, Parent = col })\n\tlocal mm = Style.button(col, \"MATCHMAKING\", { sub = \"Fight another player in this server\", color = C.Accent2, height = 100, textSize = 36 })\n\tmm.LayoutOrder = 1\n\tlocal bot = Style.button(col, \"BATTLE A BOT\", { sub = \"Practice against a CPU robot\", color = C.Accent, height = 100, textSize = 36 })\n\tbot.LayoutOrder = 2\n\tlocal back = Style.button(col, \"BACK\", { sub = \"Change robot\", color = C.Dim, height = 100, textSize = 36 })\n\tback.LayoutOrder = 3\n\twire(mm, function()\n\t\tsend(\"Queue\")\n\t\tUI.ShowQueue({ inQueue = true, position = 1, count = 1 })\n\tend)\n\twire(bot, function()\n\t\tsend(\"Bot\")\n\t\tUI.Show(\"Loading\")\n\tend)\n\twire(back, function()\n\t\tUI.ShowSelect()\n\tend, \"UIBack\")\n\tdefaultSelect.Mode = bot\n\tbackHandlers.Mode = function()\n\t\tUI.ShowSelect()\n\tend\n\tUI._modeRobotLabel = robotLabel\n\n\tlocal q = screen(\"Queue\")\n\tlocal qp = Style.panel(q, { Size = UDim2.fromOffset(560, 330), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) })\n\tStyle.label(qp, \"MATCHMAKING\", 40, { FontFace = ITALIC, Position = UDim2.fromOffset(0, 18), TextColor3 = C.Accent2 })\n\tqueueLabel = Style.label(qp, \"Searching for an opponent...\", 26, { Position = UDim2.fromOffset(0, 78) })\n\tqueueSub = Style.label(qp, \"\", 18, { Font = Style.Body, TextColor3 = C.Dim, Position = UDim2.fromOffset(0, 116), TextWrapped = true, Size = UDim2.new(1, -40, 0, 44) })\n\tqueueSub.Position = UDim2.fromOffset(20, 116)\n\tlocal qb = Style.new(\"Frame\", { BackgroundTransparency = 1, Size = UDim2.new(1, -60, 0, 140), Position = UDim2.fromOffset(30, 172), Parent = qp })\n\tStyle.new(\"UIListLayout\", { Padding = UDim.new(0, 12), Parent = qb })\n\tlocal qbot = Style.button(qb, \"BATTLE A BOT INSTEAD\", { color = C.Accent, height = 62, textSize = 26 })\n\tlocal qcancel = Style.button(qb, \"CANCEL\", { color = C.Dim, height = 62, textSize = 26 })\n\tqcancel.LayoutOrder = 2\n\twire(qbot, function()\n\t\tsend(\"Bot\")\n\t\tUI.Show(\"Loading\")\n\tend)\n\twire(qcancel, function()\n\t\tsend(\"CancelQueue\")\n\t\tUI.ShowMode()\n\tend, \"UIBack\")\n\tdefaultSelect.Queue = qcancel\n\tbackHandlers.Queue = function()\n\t\tsend(\"CancelQueue\")\n\t\tUI.ShowMode()\n\tend\n\n\tlocal l = screen(\"Loading\")\n\tStyle.label(l, \"LAUNCHING...\", 40, { FontFace = ITALIC, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), TextColor3 = C.Accent })\nend\n\n----------------------------------------------------------------------------------------------\n-- Results\n----------------------------------------------------------------------------------------------\nlocal function buildResults()\n\tlocal f = screen(\"Results\")\n\tStyle.new(\"Frame\", { BackgroundColor3 = C.Bg, BackgroundTransparency = 0.35, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Parent = f })\n\tresults.outcome = Style.label(f, \"\", 140, {\n\t\tFontFace = ITALIC,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0, 30),\n\t\tSize = UDim2.new(1, 0, 0, 150),\n\t})\n\tStyle.textStroke(results.outcome, Color3.fromRGB(20, 0, 60), 6)\n\tresults.reason = Style.label(f, \"\", 26, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 176), TextColor3 = C.Dim })\n\tresults.perfect = Style.label(f, \"PERFECT!\", 40, {\n\t\tFontFace = ITALIC,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0, 210),\n\t\tTextColor3 = C.Gold,\n\t\tVisible = false,\n\t})\n\tStyle.textStroke(results.perfect, Color3.fromRGB(60, 20, 0), 3)\n\tlocal panel = Style.panel(f, { Size = UDim2.fromOffset(640, 250), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 262) })\n\tresults.panel = panel\n\tlocal cols = { \"\", \"YOU\", \"RIVAL\" }\n\tresults.head = {}\n\tfor i, t in ipairs(cols) do\n\t\tresults.head[i] = Style.label(panel, t, 22, {\n\t\t\tPosition = UDim2.fromOffset(20 + (i - 1) * 205, 14),\n\t\t\tSize = UDim2.fromOffset(i == 1 and 200 or 200, 26),\n\t\t\tTextXAlignment = i == 1 and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center,\n\t\t\tTextColor3 = i == 2 and C.Accent or (i == 3 and C.Accent2 or C.Dim),\n\t\t})\n\tend\n\tresults.rows = {}\n\tlocal labels = { \"Robot\", \"HP left\", \"Damage dealt\", \"Hits landed\", \"Times DOWN\" }\n\tfor r, name in ipairs(labels) do\n\t\tlocal y = 48 + (r - 1) * 38\n\t\tlocal row = {}\n\t\trow[1] = Style.label(panel, name, 20, { Font = Style.Body, Position = UDim2.fromOffset(20, y), Size = UDim2.fromOffset(200, 28), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.Dim })\n\t\tfor c = 2, 3 do\n\t\t\trow[c] = Style.label(panel, \"\", 22, { Position = UDim2.fromOffset(20 + (c - 1) * 205, y), Size = UDim2.fromOffset(200, 28) })\n\t\tend\n\t\tresults.rows[r] = row\n\tend\n\tresults.status = Style.label(f, \"\", 20, { Font = Style.Body, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 522), TextColor3 = C.Gold })\n\tlocal bottom = Style.new(\"Frame\", {\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(640, 76),\n\t\tAnchorPoint = Vector2.new(0.5, 1),\n\t\tPosition = UDim2.new(0.5, 0, 1, -40),\n\t\tParent = f,\n\t})\n\tStyle.new(\"UIListLayout\", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 20), Parent = bottom })\n\tlocal rematch, rematchTitle = Style.button(bottom, \"REMATCH\", { color = C.Gold, size = UDim2.fromOffset(310, 76), textSize = 32 })\n\tlocal back = Style.button(bottom, \"BACK TO SELECT\", { color = C.Accent, size = UDim2.fromOffset(310, 76), textSize = 28 })\n\tback.LayoutOrder = 2\n\tresults.rematch = rematch\n\tresults.back = back\n\twire(rematch, function()\n\t\tif rematchBusy then\n\t\t\treturn\n\t\tend\n\t\trematchBusy = true\n\t\tresults.status.Text = \"Requesting rematch...\"\n\t\tsend(\"Rematch\")\n\tend)\n\twire(back, function()\n\t\tsend(\"Back\")\n\t\tUI.ShowSelect()\n\tend, \"UIBack\")\n\tdefaultSelect.Results = rematch\n\tbackHandlers.Results = function()\n\t\tsend(\"Back\")\n\t\tUI.ShowSelect()\n\tend\nend\n\nlocal REASONS = {\n\tKO = \"by K.O.\",\n\tTIME = \"time up: higher HP wins\",\n\tLEFT = \"opponent left the match\",\n}\n\nfunction UI.ShowResults(data)\n\trematchBusy = false\n\tlocal o = data.outcome\n\tresults.outcome.Text = o == \"WIN\" and \"YOU WIN!\" or (o == \"LOSE\" and \"YOU LOSE\" or \"DRAW\")\n\tresults.outcome.TextColor3 = o == \"WIN\" and C.Gold or (o == \"LOSE\" and Color3.fromRGB(150, 170, 215) or Color3.fromRGB(210, 210, 255))\n\tlocal reason = REASONS[data.reason] or \"\"\n\tif o == \"DRAW\" and data.reason == \"TIME\" then\n\t\treason = \"time up: equal HP\"\n\tend\n\tresults.reason.Text = string.upper(reason) .. string.format(\"   •   %d:%02d\", math.floor((data.duration or 0) / 60), math.floor((data.duration or 0) % 60))\n\tresults.perfect.Visible = data.perfect == true\n\tlocal you = data.you or {}\n\tlocal rival = (data.others or {})[1] or {}\n\tresults.head[3].Text = rival.name and string.upper(rival.name) or \"RIVAL\"\n\tlocal function robotName(id)\n\t\tlocal r = Config.RobotById[id or \"\"]\n\t\treturn r and r.DisplayName or \"-\"\n\tend\n\tlocal vals = {\n\t\t{ robotName(you.robotId), robotName(rival.robotId) },\n\t\t{ tostring(math.max(0, you.hp or 0)), tostring(math.max(0, rival.hp or 0)) },\n\t\t{ tostring(you.damageDealt or 0), tostring(rival.damageDealt or 0) },\n\t\t{ tostring(you.hits or 0), tostring(rival.hits or 0) },\n\t\t{ tostring(you.downs or 0), tostring(rival.downs or 0) },\n\t}\n\tfor r, v in ipairs(vals) do\n\t\tresults.rows[r][2].Text = v[1]\n\t\tresults.rows[r][3].Text = v[2]\n\tend\n\tresults.status.Text = \"\"\n\tresults.rematch.Visible = true\n\tUI.Show(\"Results\")\n\tSound.Play(o == \"WIN\" and \"Win\" or \"Lose\")\nend\n\nfunction UI.OnRematch(data)\n\tif current ~= \"Results\" then\n\t\treturn\n\tend\n\tif data.status == \"waiting\" then\n\t\tresults.status.Text = string.format(\"Waiting for rival... (%d/%d ready)\", data.votes or 1, data.needed or 2)\n\telseif data.status == \"starting\" then\n\t\tresults.status.Text = \"Rematch starting!\"\n\telseif data.status == \"closed\" then\n\t\trematchBusy = false\n\t\tresults.status.Text = data.reason or \"Rematch unavailable\"\n\t\tresults.rematch.Visible = false\n\t\tif gamepadActive() then\n\t\t\tGuiService.SelectedObject = results.back\n\t\tend\n\tend\nend\n\nfunction UI.OnQueue(data)\n\tif data.matched then\n\t\tUI.Show(\"Loading\")\n\t\treturn\n\tend\n\tif not data.inQueue then\n\t\tif current == \"Queue\" then\n\t\t\tUI.ShowMode()\n\t\tend\n\t\treturn\n\tend\n\tif current ~= \"Queue\" then\n\t\tUI.Show(\"Queue\")\n\tend\n\tqueueLabel.Text = \"Searching for an opponent...\"\n\tqueueSub.Text = string.format(\"Queue position %d of %d  •  %d player%s in this server\", data.position or 1, data.count or 1, data.online or 1, (data.online or 1) == 1 and \"\" or \"s\")\nend\n\nfunction UI.ShowTitle()\n\tcamMode = \"Title\"\n\tUI.Show(\"Title\")\nend\n\nfunction UI.ShowSelect()\n\tcamMode = \"Select\"\n\tsetDetail(State.robotId)\n\tUI.Show(\"Select\")\n\tif gamepadActive() then\n\t\tlocal b = robotButtons[State.robotId]\n\t\tGuiService.SelectedObject = b and b.button\n\tend\nend\n\nfunction UI.ShowMode()\n\tcamMode = \"Select\"\n\tlocal r = Config.RobotById[State.robotId]\n\tUI._modeRobotLabel.Text = r and (\"ROBOT: \" .. r.DisplayName .. \"  •  \" .. r.Role) or \"\"\n\tUI.Show(\"Mode\")\nend\n\nfunction UI.ShowQueue(data)\n\tUI.Show(\"Queue\")\n\tUI.OnQueue(data)\nend\n\n----------------------------------------------------------------------------------------------\n-- Lobby camera (menus)\n----------------------------------------------------------------------------------------------\nlocal camCF: CFrame? = nil\nlocal function lobbyStep(dt: number)\n\tif State.mode ~= \"Menu\" then\n\t\tcamCF = nil\n\t\treturn\n\tend\n\tlocal camera = workspace.CurrentCamera\n\tcamera.CameraType = Enum.CameraType.Scriptable\n\tcamera.FieldOfView = 55\n\tcamT += dt\n\tlocal stands = workspace:FindFirstChild(\"Lobby\") and workspace.Lobby:FindFirstChild(\"Stands\")\n\tlocal target: CFrame\n\tif camMode == \"Select\" and stands then\n\t\tlocal r = Config.RobotById[State.robotId]\n\t\tlocal x = ((r and r.Index or 1) - 2) * 14\n\t\tlocal focus = Vector3.new(x, 6, 0)\n\t\ttarget = CFrame.lookAt(focus + Vector3.new(0, 4, 21), focus + Vector3.new(0, 0.5, 0))\n\t\tlocal statue = stands:FindFirstChild(\"Statue\" .. State.robotId)\n\t\tif statue then\n\t\t\tlocal pivot = statue:GetPivot()\n\t\t\tstatue:PivotTo(CFrame.new(pivot.Position) * CFrame.Angles(0, math.pi + math.sin(camT * 0.8) * 0.5, 0))\n\t\tend\n\telse\n\t\tlocal a = camT * 0.12\n\t\tlocal focus = Vector3.new(0, 5, 0)\n\t\ttarget = CFrame.lookAt(focus + Vector3.new(math.sin(a) * 46, 18, math.cos(a) * 46), focus)\n\tend\n\tif not camCF then\n\t\tcamCF = target\n\tend\n\tcamCF = (camCF :: CFrame):Lerp(target, 1 - math.exp(-dt * 4))\n\tcamera.CFrame = camCF :: CFrame\nend\n\n----------------------------------------------------------------------------------------------\n-- Init\n----------------------------------------------------------------------------------------------\nlocal function onBack(_, state)\n\tif state ~= Enum.UserInputState.Begin then\n\t\treturn Enum.ContextActionResult.Pass\n\tend\n\tlocal h = current and backHandlers[current]\n\tif h then\n\t\tSound.Play(\"UIBack\")\n\t\th()\n\t\treturn Enum.ContextActionResult.Sink\n\tend\n\treturn Enum.ContextActionResult.Pass\nend\n\nfunction UI.SetMenuInput(on: boolean)\n\tif on then\n\t\tContextActionService:BindAction(\"RC_MenuBack\", onBack, false, Enum.KeyCode.ButtonB, Enum.KeyCode.Backspace)\n\telse\n\t\tContextActionService:UnbindAction(\"RC_MenuBack\")\n\t\tGuiService.SelectedObject = nil\n\tend\nend\n\nfunction UI.Init(uiRoot: Frame)\n\troot = uiRoot\n\tbuildTitle()\n\tbuildSelect()\n\tbuildMode()\n\tbuildResults()\n\tsetDetail(State.robotId)\n\tRunService:BindToRenderStep(\"RoboClashLobbyCam\", Enum.RenderPriority.Camera.Value + 2, lobbyStep)\n\tState.InputTypeChanged:Connect(function(kind)\n\t\tif kind == \"Gamepad\" and current and GuiService.SelectedObject == nil then\n\t\t\tif current == \"Select\" then\n\t\t\t\tlocal b = robotButtons[State.robotId]\n\t\t\t\tGuiService.SelectedObject = b and b.button\n\t\t\telse\n\t\t\t\tselectDefault()\n\t\t\tend\n\t\telseif kind ~= \"Gamepad\" then\n\t\t\tGuiService.SelectedObject = nil\n\t\tend\n\tend)\n\tUserInputService.GamepadConnected:Connect(function()\n\t\tselectDefault()\n\tend)\n\tUI.SetMenuInput(true)\n\tUI.ShowTitle()\nend\n\nreturn UI\n","message":"The file /Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/UI.luau has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"toolu_016FPJUuH7gf7STTa1wYUFJ1","startedAtMs":"1791074730037","completedAtMs":"1791074731247"},"model_call_id":"f6f75537-51d9-46fb-a6c9-81f06ac674d8-75-u78q","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791074731252}
{"type":"tool_call","subtype":"started","call_id":"toolu_01QtS3g2vn8iHk4HyinKrHQv","tool_call":{"editToolCall":{"args":{"path":"/Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/UI.luau","streamContent":"\tlocal rematch = Style.button("}},"hookAdditionalContexts":[],"toolCallId":"toolu_01QtS3g2vn8iHk4HyinKrHQv","startedAtMs":"1791074731189"},"model_call_id":"f6f75537-51d9-46fb-a6c9-81f06ac674d8-75-u78q","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791074732395}
{"type":"tool_call","subtype":"completed","call_id":"toolu_01QtS3g2vn8iHk4HyinKrHQv","tool_call":{"editToolCall":{"args":{"path":"/Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/UI.luau","streamContent":"\tlocal rematch = Style.button("},"result":{"success":{"path":"/Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/UI.luau","linesAdded":1,"linesRemoved":1,"diffString":"--- a//Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/UI.luau\n+++ b//Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/UI.luau\n@@ -431,7 +431,7 @@\n \t\tParent = f,\n \t})\n \tStyle.new(\"UIListLayout\", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 20), Parent = bottom })\n-\tlocal rematch, rematchTitle = Style.button(bottom, \"REMATCH\", { color = C.Gold, size = UDim2.fromOffset(310, 76), textSize = 32 })\n+\tlocal rematch = Style.button(bottom, \"REMATCH\", { color = C.Gold, size = UDim2.fromOffset(310, 76), textSize = 32 })\n \tlocal back = Style.button(bottom, \"BACK TO SELECT\", { color = C.Accent, size = UDim2.fromOffset(310, 76), textSize = 28 })\n \tback.LayoutOrder = 2\n \tresults.rematch = rematch","beforeFullFileContent":"-- Menu screens: Title -> Robot Select -> Mode Select (Matchmaking / Bot / Back), queue overlay,\n-- Results (Rematch / Back to Select). Works with mouse, touch and gamepad (SelectedObject + B).\nlocal ContextActionService = game:GetService(\"ContextActionService\")\nlocal GuiService = game:GetService(\"GuiService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal UserInputService = game:GetService(\"UserInputService\")\n\nlocal RC = ReplicatedStorage:WaitForChild(\"RoboClash\")\nlocal Config = require(RC.Config)\nlocal Style = require(script.Parent.Style)\nlocal State = require(script.Parent.State)\nlocal Sound = require(script.Parent.Sound)\n\nlocal MenuRemote = RC:WaitForChild(\"Remotes\"):WaitForChild(\"Menu\")\nlocal C = Style.C\nlocal ITALIC = Font.new(\"rbxasset://fonts/families/GothamSSm.json\", Enum.FontWeight.Heavy, Enum.FontStyle.Italic)\n\nlocal UI = {}\nlocal root: Frame\nlocal screens = {}\nlocal current: string? = nil\nlocal backHandlers = {}\nlocal defaultSelect = {}\nlocal camMode = \"Title\"\nlocal camT = 0\nlocal robotButtons = {}\nlocal detail = {}\nlocal queueLabel: TextLabel\nlocal queueSub: TextLabel\nlocal results = {}\nlocal rematchBusy = false\n\nlocal function send(action: string, arg: any?)\n\tMenuRemote:FireServer(action, arg)\nend\n\nlocal function gamepadActive(): boolean\n\treturn State.lastInput == \"Gamepad\"\nend\n\nlocal function selectDefault()\n\tlocal b = current and defaultSelect[current]\n\tif b and gamepadActive() then\n\t\tGuiService.SelectedObject = b\n\tend\nend\n\nlocal function wire(b: GuiButton, fn: () -> (), soundName: string?)\n\tb.Activated:Connect(function()\n\t\tSound.Play(soundName or \"UISelect\")\n\t\tfn()\n\tend)\n\tb.SelectionGained:Connect(function()\n\t\tSound.Play(\"UIMove\", { volume = 0.2 })\n\tend)\n\tb.MouseEnter:Connect(function()\n\t\tSound.Play(\"UIMove\", { volume = 0.15 })\n\tend)\nend\n\nlocal function screen(name: string): Frame\n\tlocal f = Style.new(\"Frame\", { Name = name, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = root })\n\tscreens[name] = f\n\treturn f\nend\n\nfunction UI.Show(name: string?)\n\tfor n, f in pairs(screens) do\n\t\tf.Visible = n == name\n\tend\n\tcurrent = name\n\tGuiService.SelectedObject = nil\n\tif name then\n\t\tselectDefault()\n\tend\nend\n\nfunction UI.Current(): string?\n\treturn current\nend\n\n----------------------------------------------------------------------------------------------\n-- Title\n----------------------------------------------------------------------------------------------\nlocal function buildTitle()\n\tlocal f = screen(\"Title\")\n\tlocal logo = Style.label(f, \"ROBO CLASH\", 120, {\n\t\tFontFace = ITALIC,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0.12, 0),\n\t\tSize = UDim2.new(1, 0, 0, 130),\n\t\tTextColor3 = Color3.new(1, 1, 1),\n\t})\n\tStyle.textStroke(logo, Color3.fromRGB(30, 0, 90), 6)\n\tStyle.new(\"UIGradient\", {\n\t\tColor = ColorSequence.new(Color3.fromRGB(120, 240, 255), Color3.fromRGB(255, 90, 200)),\n\t\tRotation = 90,\n\t\tParent = logo,\n\t})\n\tlocal sub = Style.label(f, \"A R E N A\", 54, {\n\t\tFontFace = ITALIC,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0.12, 128),\n\t\tTextColor3 = C.Gold,\n\t})\n\tStyle.textStroke(sub, Color3.fromRGB(60, 20, 0), 4)\n\tStyle.label(f, \"Pick a robot. Lock on. Blast them into a DOWN.\", 22, {\n\t\tFont = Style.Body,\n\t\tTextColor3 = C.Dim,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0.12, 200),\n\t})\n\tlocal holder = Style.new(\"Frame\", {\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(380, 86),\n\t\tAnchorPoint = Vector2.new(0.5, 1),\n\t\tPosition = UDim2.new(0.5, 0, 1, -150),\n\t\tParent = f,\n\t})\n\tlocal play = Style.button(holder, \"PLAY\", { color = C.Gold, height = 86, textSize = 44 })\n\tplay.Name = \"Play\"\n\twire(play, function()\n\t\tUI.ShowSelect()\n\tend)\n\tdefaultSelect.Title = play\n\tlocal hint = Style.label(f, \"\", 18, {\n\t\tName = \"Hint\",\n\t\tFont = Style.Body,\n\t\tTextColor3 = C.Dim,\n\t\tAnchorPoint = Vector2.new(0.5, 1),\n\t\tPosition = UDim2.new(0.5, 0, 1, -40),\n\t\tSize = UDim2.new(1, -40, 0, 50),\n\t\tTextWrapped = true,\n\t})\n\tlocal function refreshHint()\n\t\tif State.lastInput == \"Gamepad\" then\n\t\t\thint.Text = \"Left stick move  •  A jump  •  B / LB dash  •  RT gun  •  LT / X bomb  •  RB / Y pod\"\n\t\telseif State.lastInput == \"Touch\" then\n\t\t\thint.Text = \"Left side: move  •  Buttons: GUN  BOMB  POD  JUMP  DASH\"\n\t\telse\n\t\t\thint.Text = \"WASD move  •  Space jump  •  Shift dash  •  LMB / J gun  •  RMB / K bomb  •  E / L pod\"\n\t\tend\n\tend\n\trefreshHint()\n\tState.InputTypeChanged:Connect(refreshHint)\nend\n\n----------------------------------------------------------------------------------------------\n-- Robot select\n----------------------------------------------------------------------------------------------\nlocal STAT_ORDER = { \"Power\", \"Range\", \"Speed\", \"Mobility\", \"Defense\" }\n\nlocal function setDetail(robotId: string)\n\tlocal r = Config.RobotById[robotId]\n\tif not r then\n\t\treturn\n\tend\n\tlocal lo = Config.GetLoadout(robotId)\n\tdetail.name.Text = r.DisplayName\n\tdetail.name.TextColor3 = r.Neon\n\tdetail.role.Text = r.Role\n\tdetail.desc.Text = r.Description\n\tdetail.panelStroke.Color = r.Neon\n\tlocal rows = {\n\t\t{ \"GUN\", lo.Gun.Name, lo.Gun.Blurb },\n\t\t{ \"BOMB\", lo.Bomb.Name, lo.Bomb.Blurb },\n\t\t{ \"POD\", lo.Pod.Name, lo.Pod.Blurb },\n\t\t{ \"LEGS\", lo.Legs.Name, lo.Legs.Blurb },\n\t\t{ \"BODY\", lo.Body.Name, lo.Body.DashAttack and (\"Dash attack: \" .. lo.Body.DashAttack.Name) or \"\" },\n\t}\n\tfor i, row in ipairs(rows) do\n\t\tlocal l = detail.rows[i]\n\t\tl.kind.Text = row[1]\n\t\tl.kind.TextColor3 = r.Neon\n\t\tl.name.Text = row[2] or \"\"\n\t\tl.blurb.Text = row[3] or \"\"\n\tend\n\tfor i, stat in ipairs(STAT_ORDER) do\n\t\tlocal v = r.Stats[stat] or 0\n\t\tfor s, seg in ipairs(detail.stats[i].segs) do\n\t\t\tseg.BackgroundColor3 = s <= v and r.Neon or Color3.fromRGB(40, 46, 80)\n\t\tend\n\tend\n\tfor id, b in pairs(robotButtons) do\n\t\tlocal chosen = id == robotId\n\t\tb.check.Visible = chosen\n\tend\nend\n\nlocal function chooseRobot(robotId: string)\n\tif State.robotId ~= robotId then\n\t\tState.robotId = robotId\n\t\tsend(\"Select\", robotId)\n\tend\n\tsetDetail(robotId)\nend\n\nlocal function buildSelect()\n\tlocal f = screen(\"Select\")\n\tStyle.label(f, \"CHOOSE YOUR ROBOT\", 46, {\n\t\tFontFace = ITALIC,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0, 24),\n\t})\n\tlocal list = Style.new(\"Frame\", {\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(340, 3 * 96 + 2 * 12),\n\t\tPosition = UDim2.new(0, 36, 0.5, -40),\n\t\tAnchorPoint = Vector2.new(0, 0.5),\n\t\tParent = f,\n\t})\n\tStyle.new(\"UIListLayout\", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })\n\tfor i, r in ipairs(Config.Robots) do\n\t\tlocal b = Style.button(list, r.DisplayName, { sub = r.Role, color = r.Neon, height = 96, textSize = 34 })\n\t\tb.LayoutOrder = i\n\t\tb.Name = \"Robot_\" .. r.Id\n\t\tlocal check = Style.label(b, \"✓\", 34, {\n\t\t\tSize = UDim2.fromOffset(40, 40),\n\t\t\tPosition = UDim2.new(1, -52, 0.5, -20),\n\t\t\tTextColor3 = r.Neon,\n\t\t\tVisible = false,\n\t\t})\n\t\trobotButtons[r.Id] = { button = b, check = check }\n\t\tb.SelectionGained:Connect(function()\n\t\t\tchooseRobot(r.Id)\n\t\tend)\n\t\tb.MouseEnter:Connect(function()\n\t\t\tchooseRobot(r.Id)\n\t\tend)\n\t\twire(b, function()\n\t\t\tchooseRobot(r.Id)\n\t\t\tUI.ShowMode()\n\t\tend)\n\tend\n\n\tlocal panel = Style.panel(f, {\n\t\tSize = UDim2.fromOffset(440, 520),\n\t\tAnchorPoint = Vector2.new(1, 0.5),\n\t\tPosition = UDim2.new(1, -36, 0.5, -10),\n\t})\n\tdetail.panelStroke = panel:FindFirstChildOfClass(\"UIStroke\")\n\tdetail.panelStroke.Transparency = 0.1\n\tdetail.name = Style.label(panel, \"\", 50, { FontFace = ITALIC, Position = UDim2.fromOffset(22, 14), Size = UDim2.new(1, -44, 0, 54), TextXAlignment = Enum.TextXAlignment.Left })\n\tdetail.role = Style.label(panel, \"\", 20, { Position = UDim2.fromOffset(24, 66), Size = UDim2.new(1, -44, 0, 24), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.Gold })\n\tdetail.desc = Style.label(panel, \"\", 17, {\n\t\tFont = Style.Body,\n\t\tTextColor3 = C.Dim,\n\t\tTextWrapped = true,\n\t\tTextXAlignment = Enum.TextXAlignment.Left,\n\t\tTextYAlignment = Enum.TextYAlignment.Top,\n\t\tPosition = UDim2.fromOffset(24, 96),\n\t\tSize = UDim2.new(1, -44, 0, 44),\n\t})\n\tdetail.rows = {}\n\tfor i = 1, 5 do\n\t\tlocal y = 146 + (i - 1) * 44\n\t\tlocal kind = Style.label(panel, \"\", 16, { Position = UDim2.fromOffset(24, y), Size = UDim2.fromOffset(60, 20), TextXAlignment = Enum.TextXAlignment.Left })\n\t\tlocal name = Style.label(panel, \"\", 19, { Position = UDim2.fromOffset(88, y - 2), Size = UDim2.new(1, -110, 0, 22), TextXAlignment = Enum.TextXAlignment.Left })\n\t\tlocal blurb = Style.label(panel, \"\", 14, {\n\t\t\tFont = Style.Body,\n\t\t\tTextColor3 = C.Dim,\n\t\t\tPosition = UDim2.fromOffset(88, y + 20),\n\t\t\tSize = UDim2.new(1, -110, 0, 16),\n\t\t\tTextXAlignment = Enum.TextXAlignment.Left,\n\t\t})\n\t\tdetail.rows[i] = { kind = kind, name = name, blurb = blurb }\n\tend\n\tdetail.stats = {}\n\tfor i, stat in ipairs(STAT_ORDER) do\n\t\tlocal y = 372 + (i - 1) * 27\n\t\tStyle.label(panel, string.upper(stat), 15, { Position = UDim2.fromOffset(24, y), Size = UDim2.fromOffset(110, 20), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.Dim })\n\t\tlocal segs = {}\n\t\tfor s = 1, 5 do\n\t\t\tlocal seg = Style.new(\"Frame\", {\n\t\t\t\tBackgroundColor3 = C.Accent,\n\t\t\t\tBorderSizePixel = 0,\n\t\t\t\tSize = UDim2.fromOffset(48, 14),\n\t\t\t\tPosition = UDim2.fromOffset(140 + (s - 1) * 54, y + 3),\n\t\t\t\tParent = panel,\n\t\t\t})\n\t\t\tStyle.corner(seg, 4)\n\t\t\tsegs[s] = seg\n\t\tend\n\t\tdetail.stats[i] = { segs = segs }\n\tend\n\n\tlocal bottom = Style.new(\"Frame\", {\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(560, 72),\n\t\tAnchorPoint = Vector2.new(0.5, 1),\n\t\tPosition = UDim2.new(0.5, 0, 1, -24),\n\t\tParent = f,\n\t})\n\tStyle.new(\"UIListLayout\", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 20), Parent = bottom })\n\tlocal back = Style.button(bottom, \"BACK\", { color = C.Dim, size = UDim2.fromOffset(200, 72) })\n\tback.LayoutOrder = 1\n\tlocal go = Style.button(bottom, \"CONFIRM\", { color = C.Gold, size = UDim2.fromOffset(340, 72), textSize = 34 })\n\tgo.LayoutOrder = 2\n\twire(back, function()\n\t\tUI.ShowTitle()\n\tend, \"UIBack\")\n\twire(go, function()\n\t\tUI.ShowMode()\n\tend)\n\tbackHandlers.Select = function()\n\t\tUI.ShowTitle()\n\tend\nend\n\n----------------------------------------------------------------------------------------------\n-- Mode select + queue\n----------------------------------------------------------------------------------------------\nlocal function buildMode()\n\tlocal f = screen(\"Mode\")\n\tlocal title = Style.label(f, \"SELECT MODE\", 46, { FontFace = ITALIC, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 24) })\n\ttitle.Name = \"Title\"\n\tlocal robotLabel = Style.label(f, \"\", 22, { Name = \"Robot\", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 80), TextColor3 = C.Gold })\n\tscreens.Mode:SetAttribute(\"Ready\", true)\n\tlocal col = Style.new(\"Frame\", {\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(470, 3 * 100 + 2 * 14),\n\t\tAnchorPoint = Vector2.new(0, 0.5),\n\t\tPosition = UDim2.new(0, 40, 0.55, 0),\n\t\tParent = f,\n\t})\n\tStyle.new(\"UIListLayout\", { Padding = UDim.new(0, 14), SortOrder = Enum.SortOrder.LayoutOrder, Parent = col })\n\tlocal mm = Style.button(col, \"MATCHMAKING\", { sub = \"Fight another player in this server\", color = C.Accent2, height = 100, textSize = 36 })\n\tmm.LayoutOrder = 1\n\tlocal bot = Style.button(col, \"BATTLE A BOT\", { sub = \"Practice against a CPU robot\", color = C.Accent, height = 100, textSize = 36 })\n\tbot.LayoutOrder = 2\n\tlocal back = Style.button(col, \"BACK\", { sub = \"Change robot\", color = C.Dim, height = 100, textSize = 36 })\n\tback.LayoutOrder = 3\n\twire(mm, function()\n\t\tsend(\"Queue\")\n\t\tUI.ShowQueue({ inQueue = true, position = 1, count = 1 })\n\tend)\n\twire(bot, function()\n\t\tsend(\"Bot\")\n\t\tUI.Show(\"Loading\")\n\tend)\n\twire(back, function()\n\t\tUI.ShowSelect()\n\tend, \"UIBack\")\n\tdefaultSelect.Mode = bot\n\tbackHandlers.Mode = function()\n\t\tUI.ShowSelect()\n\tend\n\tUI._modeRobotLabel = robotLabel\n\n\tlocal q = screen(\"Queue\")\n\tlocal qp = Style.panel(q, { Size = UDim2.fromOffset(560, 330), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) })\n\tStyle.label(qp, \"MATCHMAKING\", 40, { FontFace = ITALIC, Position = UDim2.fromOffset(0, 18), TextColor3 = C.Accent2 })\n\tqueueLabel = Style.label(qp, \"Searching for an opponent...\", 26, { Position = UDim2.fromOffset(0, 78) })\n\tqueueSub = Style.label(qp, \"\", 18, { Font = Style.Body, TextColor3 = C.Dim, Position = UDim2.fromOffset(0, 116), TextWrapped = true, Size = UDim2.new(1, -40, 0, 44) })\n\tqueueSub.Position = UDim2.fromOffset(20, 116)\n\tlocal qb = Style.new(\"Frame\", { BackgroundTransparency = 1, Size = UDim2.new(1, -60, 0, 140), Position = UDim2.fromOffset(30, 172), Parent = qp })\n\tStyle.new(\"UIListLayout\", { Padding = UDim.new(0, 12), Parent = qb })\n\tlocal qbot = Style.button(qb, \"BATTLE A BOT INSTEAD\", { color = C.Accent, height = 62, textSize = 26 })\n\tlocal qcancel = Style.button(qb, \"CANCEL\", { color = C.Dim, height = 62, textSize = 26 })\n\tqcancel.LayoutOrder = 2\n\twire(qbot, function()\n\t\tsend(\"Bot\")\n\t\tUI.Show(\"Loading\")\n\tend)\n\twire(qcancel, function()\n\t\tsend(\"CancelQueue\")\n\t\tUI.ShowMode()\n\tend, \"UIBack\")\n\tdefaultSelect.Queue = qcancel\n\tbackHandlers.Queue = function()\n\t\tsend(\"CancelQueue\")\n\t\tUI.ShowMode()\n\tend\n\n\tlocal l = screen(\"Loading\")\n\tStyle.label(l, \"LAUNCHING...\", 40, { FontFace = ITALIC, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), TextColor3 = C.Accent })\nend\n\n----------------------------------------------------------------------------------------------\n-- Results\n----------------------------------------------------------------------------------------------\nlocal function buildResults()\n\tlocal f = screen(\"Results\")\n\tStyle.new(\"Frame\", { BackgroundColor3 = C.Bg, BackgroundTransparency = 0.35, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Parent = f })\n\tresults.outcome = Style.label(f, \"\", 140, {\n\t\tFontFace = ITALIC,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0, 30),\n\t\tSize = UDim2.new(1, 0, 0, 150),\n\t})\n\tStyle.textStroke(results.outcome, Color3.fromRGB(20, 0, 60), 6)\n\tresults.reason = Style.label(f, \"\", 26, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 176), TextColor3 = C.Dim })\n\tresults.perfect = Style.label(f, \"PERFECT!\", 40, {\n\t\tFontFace = ITALIC,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0, 210),\n\t\tTextColor3 = C.Gold,\n\t\tVisible = false,\n\t})\n\tStyle.textStroke(results.perfect, Color3.fromRGB(60, 20, 0), 3)\n\tlocal panel = Style.panel(f, { Size = UDim2.fromOffset(640, 250), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 262) })\n\tresults.panel = panel\n\tlocal cols = { \"\", \"YOU\", \"RIVAL\" }\n\tresults.head = {}\n\tfor i, t in ipairs(cols) do\n\t\tresults.head[i] = Style.label(panel, t, 22, {\n\t\t\tPosition = UDim2.fromOffset(20 + (i - 1) * 205, 14),\n\t\t\tSize = UDim2.fromOffset(i == 1 and 200 or 200, 26),\n\t\t\tTextXAlignment = i == 1 and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center,\n\t\t\tTextColor3 = i == 2 and C.Accent or (i == 3 and C.Accent2 or C.Dim),\n\t\t})\n\tend\n\tresults.rows = {}\n\tlocal labels = { \"Robot\", \"HP left\", \"Damage dealt\", \"Hits landed\", \"Times DOWN\" }\n\tfor r, name in ipairs(labels) do\n\t\tlocal y = 48 + (r - 1) * 38\n\t\tlocal row = {}\n\t\trow[1] = Style.label(panel, name, 20, { Font = Style.Body, Position = UDim2.fromOffset(20, y), Size = UDim2.fromOffset(200, 28), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.Dim })\n\t\tfor c = 2, 3 do\n\t\t\trow[c] = Style.label(panel, \"\", 22, { Position = UDim2.fromOffset(20 + (c - 1) * 205, y), Size = UDim2.fromOffset(200, 28) })\n\t\tend\n\t\tresults.rows[r] = row\n\tend\n\tresults.status = Style.label(f, \"\", 20, { Font = Style.Body, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 522), TextColor3 = C.Gold })\n\tlocal bottom = Style.new(\"Frame\", {\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(640, 76),\n\t\tAnchorPoint = Vector2.new(0.5, 1),\n\t\tPosition = UDim2.new(0.5, 0, 1, -40),\n\t\tParent = f,\n\t})\n\tStyle.new(\"UIListLayout\", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 20), Parent = bottom })\n\tlocal rematch, rematchTitle = Style.button(bottom, \"REMATCH\", { color = C.Gold, size = UDim2.fromOffset(310, 76), textSize = 32 })\n\tlocal back = Style.button(bottom, \"BACK TO SELECT\", { color = C.Accent, size = UDim2.fromOffset(310, 76), textSize = 28 })\n\tback.LayoutOrder = 2\n\tresults.rematch = rematch\n\tresults.back = back\n\twire(rematch, function()\n\t\tif rematchBusy then\n\t\t\treturn\n\t\tend\n\t\trematchBusy = true\n\t\tresults.status.Text = \"Requesting rematch...\"\n\t\tsend(\"Rematch\")\n\tend)\n\twire(back, function()\n\t\tsend(\"Back\")\n\t\tUI.ShowSelect()\n\tend, \"UIBack\")\n\tdefaultSelect.Results = rematch\n\tbackHandlers.Results = function()\n\t\tsend(\"Back\")\n\t\tUI.ShowSelect()\n\tend\nend\n\nlocal REASONS = {\n\tKO = \"by K.O.\",\n\tTIME = \"time up: higher HP wins\",\n\tLEFT = \"opponent left the match\",\n}\n\nfunction UI.ShowResults(data)\n\trematchBusy = false\n\tlocal o = data.outcome\n\tresults.outcome.Text = o == \"WIN\" and \"YOU WIN!\" or (o == \"LOSE\" and \"YOU LOSE\" or \"DRAW\")\n\tresults.outcome.TextColor3 = o == \"WIN\" and C.Gold or (o == \"LOSE\" and Color3.fromRGB(150, 170, 215) or Color3.fromRGB(210, 210, 255))\n\tlocal reason = REASONS[data.reason] or \"\"\n\tif o == \"DRAW\" and data.reason == \"TIME\" then\n\t\treason = \"time up: equal HP\"\n\tend\n\tresults.reason.Text = string.upper(reason) .. string.format(\"   •   %d:%02d\", math.floor((data.duration or 0) / 60), math.floor((data.duration or 0) % 60))\n\tresults.perfect.Visible = data.perfect == true\n\tlocal you = data.you or {}\n\tlocal rival = (data.others or {})[1] or {}\n\tresults.head[3].Text = rival.name and string.upper(rival.name) or \"RIVAL\"\n\tlocal function robotName(id)\n\t\tlocal r = Config.RobotById[id or \"\"]\n\t\treturn r and r.DisplayName or \"-\"\n\tend\n\tlocal vals = {\n\t\t{ robotName(you.robotId), robotName(rival.robotId) },\n\t\t{ tostring(math.max(0, you.hp or 0)), tostring(math.max(0, rival.hp or 0)) },\n\t\t{ tostring(you.damageDealt or 0), tostring(rival.damageDealt or 0) },\n\t\t{ tostring(you.hits or 0), tostring(rival.hits or 0) },\n\t\t{ tostring(you.downs or 0), tostring(rival.downs or 0) },\n\t}\n\tfor r, v in ipairs(vals) do\n\t\tresults.rows[r][2].Text = v[1]\n\t\tresults.rows[r][3].Text = v[2]\n\tend\n\tresults.status.Text = \"\"\n\tresults.rematch.Visible = true\n\tUI.Show(\"Results\")\n\tSound.Play(o == \"WIN\" and \"Win\" or \"Lose\")\nend\n\nfunction UI.OnRematch(data)\n\tif current ~= \"Results\" then\n\t\treturn\n\tend\n\tif data.status == \"waiting\" then\n\t\tresults.status.Text = string.format(\"Waiting for rival... (%d/%d ready)\", data.votes or 1, data.needed or 2)\n\telseif data.status == \"starting\" then\n\t\tresults.status.Text = \"Rematch starting!\"\n\telseif data.status == \"closed\" then\n\t\trematchBusy = false\n\t\tresults.status.Text = data.reason or \"Rematch unavailable\"\n\t\tresults.rematch.Visible = false\n\t\tif gamepadActive() then\n\t\t\tGuiService.SelectedObject = results.back\n\t\tend\n\tend\nend\n\nfunction UI.OnQueue(data)\n\tif data.matched then\n\t\tUI.Show(\"Loading\")\n\t\treturn\n\tend\n\tif not data.inQueue then\n\t\tif current == \"Queue\" then\n\t\t\tUI.ShowMode()\n\t\tend\n\t\treturn\n\tend\n\tif current ~= \"Queue\" then\n\t\tUI.Show(\"Queue\")\n\tend\n\tqueueLabel.Text = \"Searching for an opponent...\"\n\tqueueSub.Text = string.format(\"Queue position %d of %d  •  %d player%s in this server\", data.position or 1, data.count or 1, data.online or 1, (data.online or 1) == 1 and \"\" or \"s\")\nend\n\nfunction UI.ShowTitle()\n\tcamMode = \"Title\"\n\tUI.Show(\"Title\")\nend\n\nfunction UI.ShowSelect()\n\tcamMode = \"Select\"\n\tsetDetail(State.robotId)\n\tUI.Show(\"Select\")\n\tif gamepadActive() then\n\t\tlocal b = robotButtons[State.robotId]\n\t\tGuiService.SelectedObject = b and b.button\n\tend\nend\n\nfunction UI.ShowMode()\n\tcamMode = \"Select\"\n\tlocal r = Config.RobotById[State.robotId]\n\tUI._modeRobotLabel.Text = r and (\"ROBOT: \" .. r.DisplayName .. \"  •  \" .. r.Role) or \"\"\n\tUI.Show(\"Mode\")\nend\n\nfunction UI.ShowQueue(data)\n\tUI.Show(\"Queue\")\n\tUI.OnQueue(data)\nend\n\n----------------------------------------------------------------------------------------------\n-- Lobby camera (menus)\n----------------------------------------------------------------------------------------------\nlocal camCF: CFrame? = nil\nlocal function lobbyStep(dt: number)\n\tif State.mode ~= \"Menu\" then\n\t\tcamCF = nil\n\t\treturn\n\tend\n\tlocal camera = workspace.CurrentCamera\n\tcamera.CameraType = Enum.CameraType.Scriptable\n\tcamera.FieldOfView = 55\n\tcamT += dt\n\tlocal stands = workspace:FindFirstChild(\"Lobby\") and workspace.Lobby:FindFirstChild(\"Stands\")\n\tlocal target: CFrame\n\tif camMode == \"Select\" and stands then\n\t\tlocal r = Config.RobotById[State.robotId]\n\t\tlocal x = ((r and r.Index or 1) - 2) * 14\n\t\tlocal focus = Vector3.new(x, 6, 0)\n\t\ttarget = CFrame.lookAt(focus + Vector3.new(0, 4, 21), focus + Vector3.new(0, 0.5, 0))\n\t\tlocal statue = stands:FindFirstChild(\"Statue\" .. State.robotId)\n\t\tif statue then\n\t\t\tlocal pivot = statue:GetPivot()\n\t\t\tstatue:PivotTo(CFrame.new(pivot.Position) * CFrame.Angles(0, math.pi + math.sin(camT * 0.8) * 0.5, 0))\n\t\tend\n\telse\n\t\tlocal a = camT * 0.12\n\t\tlocal focus = Vector3.new(0, 5, 0)\n\t\ttarget = CFrame.lookAt(focus + Vector3.new(math.sin(a) * 46, 18, math.cos(a) * 46), focus)\n\tend\n\tif not camCF then\n\t\tcamCF = target\n\tend\n\tcamCF = (camCF :: CFrame):Lerp(target, 1 - math.exp(-dt * 4))\n\tcamera.CFrame = camCF :: CFrame\nend\n\n----------------------------------------------------------------------------------------------\n-- Init\n----------------------------------------------------------------------------------------------\nlocal function onBack(_, state)\n\tif state ~= Enum.UserInputState.Begin then\n\t\treturn Enum.ContextActionResult.Pass\n\tend\n\tlocal h = current and backHandlers[current]\n\tif h then\n\t\tSound.Play(\"UIBack\")\n\t\th()\n\t\treturn Enum.ContextActionResult.Sink\n\tend\n\treturn Enum.ContextActionResult.Pass\nend\n\nfunction UI.SetMenuInput(on: boolean)\n\tif on then\n\t\tContextActionService:BindAction(\"RC_MenuBack\", onBack, false, Enum.KeyCode.ButtonB, Enum.KeyCode.Backspace)\n\telse\n\t\tContextActionService:UnbindAction(\"RC_MenuBack\")\n\t\tGuiService.SelectedObject = nil\n\tend\nend\n\nfunction UI.Init(uiRoot: Frame)\n\troot = uiRoot\n\tbuildTitle()\n\tbuildSelect()\n\tbuildMode()\n\tbuildResults()\n\tsetDetail(State.robotId)\n\tRunService:BindToRenderStep(\"RoboClashLobbyCam\", Enum.RenderPriority.Camera.Value + 2, lobbyStep)\n\tState.InputTypeChanged:Connect(function(kind)\n\t\tif kind == \"Gamepad\" and current and GuiService.SelectedObject == nil then\n\t\t\tif current == \"Select\" then\n\t\t\t\tlocal b = robotButtons[State.robotId]\n\t\t\t\tGuiService.SelectedObject = b and b.button\n\t\t\telse\n\t\t\t\tselectDefault()\n\t\t\tend\n\t\telseif kind ~= \"Gamepad\" then\n\t\t\tGuiService.SelectedObject = nil\n\t\tend\n\tend)\n\tUserInputService.GamepadConnected:Connect(function()\n\t\tselectDefault()\n\tend)\n\tUI.SetMenuInput(true)\n\tUI.ShowTitle()\nend\n\nreturn UI\n","afterFullFileContent":"-- Menu screens: Title -> Robot Select -> Mode Select (Matchmaking / Bot / Back), queue overlay,\n-- Results (Rematch / Back to Select). Works with mouse, touch and gamepad (SelectedObject + B).\nlocal ContextActionService = game:GetService(\"ContextActionService\")\nlocal GuiService = game:GetService(\"GuiService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal UserInputService = game:GetService(\"UserInputService\")\n\nlocal RC = ReplicatedStorage:WaitForChild(\"RoboClash\")\nlocal Config = require(RC.Config)\nlocal Style = require(script.Parent.Style)\nlocal State = require(script.Parent.State)\nlocal Sound = require(script.Parent.Sound)\n\nlocal MenuRemote = RC:WaitForChild(\"Remotes\"):WaitForChild(\"Menu\")\nlocal C = Style.C\nlocal ITALIC = Font.new(\"rbxasset://fonts/families/GothamSSm.json\", Enum.FontWeight.Heavy, Enum.FontStyle.Italic)\n\nlocal UI = {}\nlocal root: Frame\nlocal screens = {}\nlocal current: string? = nil\nlocal backHandlers = {}\nlocal defaultSelect = {}\nlocal camMode = \"Title\"\nlocal camT = 0\nlocal robotButtons = {}\nlocal detail = {}\nlocal queueLabel: TextLabel\nlocal queueSub: TextLabel\nlocal results = {}\nlocal rematchBusy = false\n\nlocal function send(action: string, arg: any?)\n\tMenuRemote:FireServer(action, arg)\nend\n\nlocal function gamepadActive(): boolean\n\treturn State.lastInput == \"Gamepad\"\nend\n\nlocal function selectDefault()\n\tlocal b = current and defaultSelect[current]\n\tif b and gamepadActive() then\n\t\tGuiService.SelectedObject = b\n\tend\nend\n\nlocal function wire(b: GuiButton, fn: () -> (), soundName: string?)\n\tb.Activated:Connect(function()\n\t\tSound.Play(soundName or \"UISelect\")\n\t\tfn()\n\tend)\n\tb.SelectionGained:Connect(function()\n\t\tSound.Play(\"UIMove\", { volume = 0.2 })\n\tend)\n\tb.MouseEnter:Connect(function()\n\t\tSound.Play(\"UIMove\", { volume = 0.15 })\n\tend)\nend\n\nlocal function screen(name: string): Frame\n\tlocal f = Style.new(\"Frame\", { Name = name, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = root })\n\tscreens[name] = f\n\treturn f\nend\n\nfunction UI.Show(name: string?)\n\tfor n, f in pairs(screens) do\n\t\tf.Visible = n == name\n\tend\n\tcurrent = name\n\tGuiService.SelectedObject = nil\n\tif name then\n\t\tselectDefault()\n\tend\nend\n\nfunction UI.Current(): string?\n\treturn current\nend\n\n----------------------------------------------------------------------------------------------\n-- Title\n----------------------------------------------------------------------------------------------\nlocal function buildTitle()\n\tlocal f = screen(\"Title\")\n\tlocal logo = Style.label(f, \"ROBO CLASH\", 120, {\n\t\tFontFace = ITALIC,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0.12, 0),\n\t\tSize = UDim2.new(1, 0, 0, 130),\n\t\tTextColor3 = Color3.new(1, 1, 1),\n\t})\n\tStyle.textStroke(logo, Color3.fromRGB(30, 0, 90), 6)\n\tStyle.new(\"UIGradient\", {\n\t\tColor = ColorSequence.new(Color3.fromRGB(120, 240, 255), Color3.fromRGB(255, 90, 200)),\n\t\tRotation = 90,\n\t\tParent = logo,\n\t})\n\tlocal sub = Style.label(f, \"A R E N A\", 54, {\n\t\tFontFace = ITALIC,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0.12, 128),\n\t\tTextColor3 = C.Gold,\n\t})\n\tStyle.textStroke(sub, Color3.fromRGB(60, 20, 0), 4)\n\tStyle.label(f, \"Pick a robot. Lock on. Blast them into a DOWN.\", 22, {\n\t\tFont = Style.Body,\n\t\tTextColor3 = C.Dim,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0.12, 200),\n\t})\n\tlocal holder = Style.new(\"Frame\", {\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(380, 86),\n\t\tAnchorPoint = Vector2.new(0.5, 1),\n\t\tPosition = UDim2.new(0.5, 0, 1, -150),\n\t\tParent = f,\n\t})\n\tlocal play = Style.button(holder, \"PLAY\", { color = C.Gold, height = 86, textSize = 44 })\n\tplay.Name = \"Play\"\n\twire(play, function()\n\t\tUI.ShowSelect()\n\tend)\n\tdefaultSelect.Title = play\n\tlocal hint = Style.label(f, \"\", 18, {\n\t\tName = \"Hint\",\n\t\tFont = Style.Body,\n\t\tTextColor3 = C.Dim,\n\t\tAnchorPoint = Vector2.new(0.5, 1),\n\t\tPosition = UDim2.new(0.5, 0, 1, -40),\n\t\tSize = UDim2.new(1, -40, 0, 50),\n\t\tTextWrapped = true,\n\t})\n\tlocal function refreshHint()\n\t\tif State.lastInput == \"Gamepad\" then\n\t\t\thint.Text = \"Left stick move  •  A jump  •  B / LB dash  •  RT gun  •  LT / X bomb  •  RB / Y pod\"\n\t\telseif State.lastInput == \"Touch\" then\n\t\t\thint.Text = \"Left side: move  •  Buttons: GUN  BOMB  POD  JUMP  DASH\"\n\t\telse\n\t\t\thint.Text = \"WASD move  •  Space jump  •  Shift dash  •  LMB / J gun  •  RMB / K bomb  •  E / L pod\"\n\t\tend\n\tend\n\trefreshHint()\n\tState.InputTypeChanged:Connect(refreshHint)\nend\n\n----------------------------------------------------------------------------------------------\n-- Robot select\n----------------------------------------------------------------------------------------------\nlocal STAT_ORDER = { \"Power\", \"Range\", \"Speed\", \"Mobility\", \"Defense\" }\n\nlocal function setDetail(robotId: string)\n\tlocal r = Config.RobotById[robotId]\n\tif not r then\n\t\treturn\n\tend\n\tlocal lo = Config.GetLoadout(robotId)\n\tdetail.name.Text = r.DisplayName\n\tdetail.name.TextColor3 = r.Neon\n\tdetail.role.Text = r.Role\n\tdetail.desc.Text = r.Description\n\tdetail.panelStroke.Color = r.Neon\n\tlocal rows = {\n\t\t{ \"GUN\", lo.Gun.Name, lo.Gun.Blurb },\n\t\t{ \"BOMB\", lo.Bomb.Name, lo.Bomb.Blurb },\n\t\t{ \"POD\", lo.Pod.Name, lo.Pod.Blurb },\n\t\t{ \"LEGS\", lo.Legs.Name, lo.Legs.Blurb },\n\t\t{ \"BODY\", lo.Body.Name, lo.Body.DashAttack and (\"Dash attack: \" .. lo.Body.DashAttack.Name) or \"\" },\n\t}\n\tfor i, row in ipairs(rows) do\n\t\tlocal l = detail.rows[i]\n\t\tl.kind.Text = row[1]\n\t\tl.kind.TextColor3 = r.Neon\n\t\tl.name.Text = row[2] or \"\"\n\t\tl.blurb.Text = row[3] or \"\"\n\tend\n\tfor i, stat in ipairs(STAT_ORDER) do\n\t\tlocal v = r.Stats[stat] or 0\n\t\tfor s, seg in ipairs(detail.stats[i].segs) do\n\t\t\tseg.BackgroundColor3 = s <= v and r.Neon or Color3.fromRGB(40, 46, 80)\n\t\tend\n\tend\n\tfor id, b in pairs(robotButtons) do\n\t\tlocal chosen = id == robotId\n\t\tb.check.Visible = chosen\n\tend\nend\n\nlocal function chooseRobot(robotId: string)\n\tif State.robotId ~= robotId then\n\t\tState.robotId = robotId\n\t\tsend(\"Select\", robotId)\n\tend\n\tsetDetail(robotId)\nend\n\nlocal function buildSelect()\n\tlocal f = screen(\"Select\")\n\tStyle.label(f, \"CHOOSE YOUR ROBOT\", 46, {\n\t\tFontFace = ITALIC,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0, 24),\n\t})\n\tlocal list = Style.new(\"Frame\", {\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(340, 3 * 96 + 2 * 12),\n\t\tPosition = UDim2.new(0, 36, 0.5, -40),\n\t\tAnchorPoint = Vector2.new(0, 0.5),\n\t\tParent = f,\n\t})\n\tStyle.new(\"UIListLayout\", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })\n\tfor i, r in ipairs(Config.Robots) do\n\t\tlocal b = Style.button(list, r.DisplayName, { sub = r.Role, color = r.Neon, height = 96, textSize = 34 })\n\t\tb.LayoutOrder = i\n\t\tb.Name = \"Robot_\" .. r.Id\n\t\tlocal check = Style.label(b, \"✓\", 34, {\n\t\t\tSize = UDim2.fromOffset(40, 40),\n\t\t\tPosition = UDim2.new(1, -52, 0.5, -20),\n\t\t\tTextColor3 = r.Neon,\n\t\t\tVisible = false,\n\t\t})\n\t\trobotButtons[r.Id] = { button = b, check = check }\n\t\tb.SelectionGained:Connect(function()\n\t\t\tchooseRobot(r.Id)\n\t\tend)\n\t\tb.MouseEnter:Connect(function()\n\t\t\tchooseRobot(r.Id)\n\t\tend)\n\t\twire(b, function()\n\t\t\tchooseRobot(r.Id)\n\t\t\tUI.ShowMode()\n\t\tend)\n\tend\n\n\tlocal panel = Style.panel(f, {\n\t\tSize = UDim2.fromOffset(440, 520),\n\t\tAnchorPoint = Vector2.new(1, 0.5),\n\t\tPosition = UDim2.new(1, -36, 0.5, -10),\n\t})\n\tdetail.panelStroke = panel:FindFirstChildOfClass(\"UIStroke\")\n\tdetail.panelStroke.Transparency = 0.1\n\tdetail.name = Style.label(panel, \"\", 50, { FontFace = ITALIC, Position = UDim2.fromOffset(22, 14), Size = UDim2.new(1, -44, 0, 54), TextXAlignment = Enum.TextXAlignment.Left })\n\tdetail.role = Style.label(panel, \"\", 20, { Position = UDim2.fromOffset(24, 66), Size = UDim2.new(1, -44, 0, 24), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.Gold })\n\tdetail.desc = Style.label(panel, \"\", 17, {\n\t\tFont = Style.Body,\n\t\tTextColor3 = C.Dim,\n\t\tTextWrapped = true,\n\t\tTextXAlignment = Enum.TextXAlignment.Left,\n\t\tTextYAlignment = Enum.TextYAlignment.Top,\n\t\tPosition = UDim2.fromOffset(24, 96),\n\t\tSize = UDim2.new(1, -44, 0, 44),\n\t})\n\tdetail.rows = {}\n\tfor i = 1, 5 do\n\t\tlocal y = 146 + (i - 1) * 44\n\t\tlocal kind = Style.label(panel, \"\", 16, { Position = UDim2.fromOffset(24, y), Size = UDim2.fromOffset(60, 20), TextXAlignment = Enum.TextXAlignment.Left })\n\t\tlocal name = Style.label(panel, \"\", 19, { Position = UDim2.fromOffset(88, y - 2), Size = UDim2.new(1, -110, 0, 22), TextXAlignment = Enum.TextXAlignment.Left })\n\t\tlocal blurb = Style.label(panel, \"\", 14, {\n\t\t\tFont = Style.Body,\n\t\t\tTextColor3 = C.Dim,\n\t\t\tPosition = UDim2.fromOffset(88, y + 20),\n\t\t\tSize = UDim2.new(1, -110, 0, 16),\n\t\t\tTextXAlignment = Enum.TextXAlignment.Left,\n\t\t})\n\t\tdetail.rows[i] = { kind = kind, name = name, blurb = blurb }\n\tend\n\tdetail.stats = {}\n\tfor i, stat in ipairs(STAT_ORDER) do\n\t\tlocal y = 372 + (i - 1) * 27\n\t\tStyle.label(panel, string.upper(stat), 15, { Position = UDim2.fromOffset(24, y), Size = UDim2.fromOffset(110, 20), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.Dim })\n\t\tlocal segs = {}\n\t\tfor s = 1, 5 do\n\t\t\tlocal seg = Style.new(\"Frame\", {\n\t\t\t\tBackgroundColor3 = C.Accent,\n\t\t\t\tBorderSizePixel = 0,\n\t\t\t\tSize = UDim2.fromOffset(48, 14),\n\t\t\t\tPosition = UDim2.fromOffset(140 + (s - 1) * 54, y + 3),\n\t\t\t\tParent = panel,\n\t\t\t})\n\t\t\tStyle.corner(seg, 4)\n\t\t\tsegs[s] = seg\n\t\tend\n\t\tdetail.stats[i] = { segs = segs }\n\tend\n\n\tlocal bottom = Style.new(\"Frame\", {\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(560, 72),\n\t\tAnchorPoint = Vector2.new(0.5, 1),\n\t\tPosition = UDim2.new(0.5, 0, 1, -24),\n\t\tParent = f,\n\t})\n\tStyle.new(\"UIListLayout\", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 20), Parent = bottom })\n\tlocal back = Style.button(bottom, \"BACK\", { color = C.Dim, size = UDim2.fromOffset(200, 72) })\n\tback.LayoutOrder = 1\n\tlocal go = Style.button(bottom, \"CONFIRM\", { color = C.Gold, size = UDim2.fromOffset(340, 72), textSize = 34 })\n\tgo.LayoutOrder = 2\n\twire(back, function()\n\t\tUI.ShowTitle()\n\tend, \"UIBack\")\n\twire(go, function()\n\t\tUI.ShowMode()\n\tend)\n\tbackHandlers.Select = function()\n\t\tUI.ShowTitle()\n\tend\nend\n\n----------------------------------------------------------------------------------------------\n-- Mode select + queue\n----------------------------------------------------------------------------------------------\nlocal function buildMode()\n\tlocal f = screen(\"Mode\")\n\tlocal title = Style.label(f, \"SELECT MODE\", 46, { FontFace = ITALIC, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 24) })\n\ttitle.Name = \"Title\"\n\tlocal robotLabel = Style.label(f, \"\", 22, { Name = \"Robot\", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 80), TextColor3 = C.Gold })\n\tscreens.Mode:SetAttribute(\"Ready\", true)\n\tlocal col = Style.new(\"Frame\", {\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(470, 3 * 100 + 2 * 14),\n\t\tAnchorPoint = Vector2.new(0, 0.5),\n\t\tPosition = UDim2.new(0, 40, 0.55, 0),\n\t\tParent = f,\n\t})\n\tStyle.new(\"UIListLayout\", { Padding = UDim.new(0, 14), SortOrder = Enum.SortOrder.LayoutOrder, Parent = col })\n\tlocal mm = Style.button(col, \"MATCHMAKING\", { sub = \"Fight another player in this server\", color = C.Accent2, height = 100, textSize = 36 })\n\tmm.LayoutOrder = 1\n\tlocal bot = Style.button(col, \"BATTLE A BOT\", { sub = \"Practice against a CPU robot\", color = C.Accent, height = 100, textSize = 36 })\n\tbot.LayoutOrder = 2\n\tlocal back = Style.button(col, \"BACK\", { sub = \"Change robot\", color = C.Dim, height = 100, textSize = 36 })\n\tback.LayoutOrder = 3\n\twire(mm, function()\n\t\tsend(\"Queue\")\n\t\tUI.ShowQueue({ inQueue = true, position = 1, count = 1 })\n\tend)\n\twire(bot, function()\n\t\tsend(\"Bot\")\n\t\tUI.Show(\"Loading\")\n\tend)\n\twire(back, function()\n\t\tUI.ShowSelect()\n\tend, \"UIBack\")\n\tdefaultSelect.Mode = bot\n\tbackHandlers.Mode = function()\n\t\tUI.ShowSelect()\n\tend\n\tUI._modeRobotLabel = robotLabel\n\n\tlocal q = screen(\"Queue\")\n\tlocal qp = Style.panel(q, { Size = UDim2.fromOffset(560, 330), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) })\n\tStyle.label(qp, \"MATCHMAKING\", 40, { FontFace = ITALIC, Position = UDim2.fromOffset(0, 18), TextColor3 = C.Accent2 })\n\tqueueLabel = Style.label(qp, \"Searching for an opponent...\", 26, { Position = UDim2.fromOffset(0, 78) })\n\tqueueSub = Style.label(qp, \"\", 18, { Font = Style.Body, TextColor3 = C.Dim, Position = UDim2.fromOffset(0, 116), TextWrapped = true, Size = UDim2.new(1, -40, 0, 44) })\n\tqueueSub.Position = UDim2.fromOffset(20, 116)\n\tlocal qb = Style.new(\"Frame\", { BackgroundTransparency = 1, Size = UDim2.new(1, -60, 0, 140), Position = UDim2.fromOffset(30, 172), Parent = qp })\n\tStyle.new(\"UIListLayout\", { Padding = UDim.new(0, 12), Parent = qb })\n\tlocal qbot = Style.button(qb, \"BATTLE A BOT INSTEAD\", { color = C.Accent, height = 62, textSize = 26 })\n\tlocal qcancel = Style.button(qb, \"CANCEL\", { color = C.Dim, height = 62, textSize = 26 })\n\tqcancel.LayoutOrder = 2\n\twire(qbot, function()\n\t\tsend(\"Bot\")\n\t\tUI.Show(\"Loading\")\n\tend)\n\twire(qcancel, function()\n\t\tsend(\"CancelQueue\")\n\t\tUI.ShowMode()\n\tend, \"UIBack\")\n\tdefaultSelect.Queue = qcancel\n\tbackHandlers.Queue = function()\n\t\tsend(\"CancelQueue\")\n\t\tUI.ShowMode()\n\tend\n\n\tlocal l = screen(\"Loading\")\n\tStyle.label(l, \"LAUNCHING...\", 40, { FontFace = ITALIC, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), TextColor3 = C.Accent })\nend\n\n----------------------------------------------------------------------------------------------\n-- Results\n----------------------------------------------------------------------------------------------\nlocal function buildResults()\n\tlocal f = screen(\"Results\")\n\tStyle.new(\"Frame\", { BackgroundColor3 = C.Bg, BackgroundTransparency = 0.35, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Parent = f })\n\tresults.outcome = Style.label(f, \"\", 140, {\n\t\tFontFace = ITALIC,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0, 30),\n\t\tSize = UDim2.new(1, 0, 0, 150),\n\t})\n\tStyle.textStroke(results.outcome, Color3.fromRGB(20, 0, 60), 6)\n\tresults.reason = Style.label(f, \"\", 26, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 176), TextColor3 = C.Dim })\n\tresults.perfect = Style.label(f, \"PERFECT!\", 40, {\n\t\tFontFace = ITALIC,\n\t\tAnchorPoint = Vector2.new(0.5, 0),\n\t\tPosition = UDim2.new(0.5, 0, 0, 210),\n\t\tTextColor3 = C.Gold,\n\t\tVisible = false,\n\t})\n\tStyle.textStroke(results.perfect, Color3.fromRGB(60, 20, 0), 3)\n\tlocal panel = Style.panel(f, { Size = UDim2.fromOffset(640, 250), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 262) })\n\tresults.panel = panel\n\tlocal cols = { \"\", \"YOU\", \"RIVAL\" }\n\tresults.head = {}\n\tfor i, t in ipairs(cols) do\n\t\tresults.head[i] = Style.label(panel, t, 22, {\n\t\t\tPosition = UDim2.fromOffset(20 + (i - 1) * 205, 14),\n\t\t\tSize = UDim2.fromOffset(i == 1 and 200 or 200, 26),\n\t\t\tTextXAlignment = i == 1 and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center,\n\t\t\tTextColor3 = i == 2 and C.Accent or (i == 3 and C.Accent2 or C.Dim),\n\t\t})\n\tend\n\tresults.rows = {}\n\tlocal labels = { \"Robot\", \"HP left\", \"Damage dealt\", \"Hits landed\", \"Times DOWN\" }\n\tfor r, name in ipairs(labels) do\n\t\tlocal y = 48 + (r - 1) * 38\n\t\tlocal row = {}\n\t\trow[1] = Style.label(panel, name, 20, { Font = Style.Body, Position = UDim2.fromOffset(20, y), Size = UDim2.fromOffset(200, 28), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.Dim })\n\t\tfor c = 2, 3 do\n\t\t\trow[c] = Style.label(panel, \"\", 22, { Position = UDim2.fromOffset(20 + (c - 1) * 205, y), Size = UDim2.fromOffset(200, 28) })\n\t\tend\n\t\tresults.rows[r] = row\n\tend\n\tresults.status = Style.label(f, \"\", 20, { Font = Style.Body, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 522), TextColor3 = C.Gold })\n\tlocal bottom = Style.new(\"Frame\", {\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.fromOffset(640, 76),\n\t\tAnchorPoint = Vector2.new(0.5, 1),\n\t\tPosition = UDim2.new(0.5, 0, 1, -40),\n\t\tParent = f,\n\t})\n\tStyle.new(\"UIListLayout\", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 20), Parent = bottom })\n\tlocal rematch = Style.button(bottom, \"REMATCH\", { color = C.Gold, size = UDim2.fromOffset(310, 76), textSize = 32 })\n\tlocal back = Style.button(bottom, \"BACK TO SELECT\", { color = C.Accent, size = UDim2.fromOffset(310, 76), textSize = 28 })\n\tback.LayoutOrder = 2\n\tresults.rematch = rematch\n\tresults.back = back\n\twire(rematch, function()\n\t\tif rematchBusy then\n\t\t\treturn\n\t\tend\n\t\trematchBusy = true\n\t\tresults.status.Text = \"Requesting rematch...\"\n\t\tsend(\"Rematch\")\n\tend)\n\twire(back, function()\n\t\tsend(\"Back\")\n\t\tUI.ShowSelect()\n\tend, \"UIBack\")\n\tdefaultSelect.Results = rematch\n\tbackHandlers.Results = function()\n\t\tsend(\"Back\")\n\t\tUI.ShowSelect()\n\tend\nend\n\nlocal REASONS = {\n\tKO = \"by K.O.\",\n\tTIME = \"time up: higher HP wins\",\n\tLEFT = \"opponent left the match\",\n}\n\nfunction UI.ShowResults(data)\n\trematchBusy = false\n\tlocal o = data.outcome\n\tresults.outcome.Text = o == \"WIN\" and \"YOU WIN!\" or (o == \"LOSE\" and \"YOU LOSE\" or \"DRAW\")\n\tresults.outcome.TextColor3 = o == \"WIN\" and C.Gold or (o == \"LOSE\" and Color3.fromRGB(150, 170, 215) or Color3.fromRGB(210, 210, 255))\n\tlocal reason = REASONS[data.reason] or \"\"\n\tif o == \"DRAW\" and data.reason == \"TIME\" then\n\t\treason = \"time up: equal HP\"\n\tend\n\tresults.reason.Text = string.upper(reason) .. string.format(\"   •   %d:%02d\", math.floor((data.duration or 0) / 60), math.floor((data.duration or 0) % 60))\n\tresults.perfect.Visible = data.perfect == true\n\tlocal you = data.you or {}\n\tlocal rival = (data.others or {})[1] or {}\n\tresults.head[3].Text = rival.name and string.upper(rival.name) or \"RIVAL\"\n\tlocal function robotName(id)\n\t\tlocal r = Config.RobotById[id or \"\"]\n\t\treturn r and r.DisplayName or \"-\"\n\tend\n\tlocal vals = {\n\t\t{ robotName(you.robotId), robotName(rival.robotId) },\n\t\t{ tostring(math.max(0, you.hp or 0)), tostring(math.max(0, rival.hp or 0)) },\n\t\t{ tostring(you.damageDealt or 0), tostring(rival.damageDealt or 0) },\n\t\t{ tostring(you.hits or 0), tostring(rival.hits or 0) },\n\t\t{ tostring(you.downs or 0), tostring(rival.downs or 0) },\n\t}\n\tfor r, v in ipairs(vals) do\n\t\tresults.rows[r][2].Text = v[1]\n\t\tresults.rows[r][3].Text = v[2]\n\tend\n\tresults.status.Text = \"\"\n\tresults.rematch.Visible = true\n\tUI.Show(\"Results\")\n\tSound.Play(o == \"WIN\" and \"Win\" or \"Lose\")\nend\n\nfunction UI.OnRematch(data)\n\tif current ~= \"Results\" then\n\t\treturn\n\tend\n\tif data.status == \"waiting\" then\n\t\tresults.status.Text = string.format(\"Waiting for rival... (%d/%d ready)\", data.votes or 1, data.needed or 2)\n\telseif data.status == \"starting\" then\n\t\tresults.status.Text = \"Rematch starting!\"\n\telseif data.status == \"closed\" then\n\t\trematchBusy = false\n\t\tresults.status.Text = data.reason or \"Rematch unavailable\"\n\t\tresults.rematch.Visible = false\n\t\tif gamepadActive() then\n\t\t\tGuiService.SelectedObject = results.back\n\t\tend\n\tend\nend\n\nfunction UI.OnQueue(data)\n\tif data.matched then\n\t\tUI.Show(\"Loading\")\n\t\treturn\n\tend\n\tif not data.inQueue then\n\t\tif current == \"Queue\" then\n\t\t\tUI.ShowMode()\n\t\tend\n\t\treturn\n\tend\n\tif current ~= \"Queue\" then\n\t\tUI.Show(\"Queue\")\n\tend\n\tqueueLabel.Text = \"Searching for an opponent...\"\n\tqueueSub.Text = string.format(\"Queue position %d of %d  •  %d player%s in this server\", data.position or 1, data.count or 1, data.online or 1, (data.online or 1) == 1 and \"\" or \"s\")\nend\n\nfunction UI.ShowTitle()\n\tcamMode = \"Title\"\n\tUI.Show(\"Title\")\nend\n\nfunction UI.ShowSelect()\n\tcamMode = \"Select\"\n\tsetDetail(State.robotId)\n\tUI.Show(\"Select\")\n\tif gamepadActive() then\n\t\tlocal b = robotButtons[State.robotId]\n\t\tGuiService.SelectedObject = b and b.button\n\tend\nend\n\nfunction UI.ShowMode()\n\tcamMode = \"Select\"\n\tlocal r = Config.RobotById[State.robotId]\n\tUI._modeRobotLabel.Text = r and (\"ROBOT: \" .. r.DisplayName .. \"  •  \" .. r.Role) or \"\"\n\tUI.Show(\"Mode\")\nend\n\nfunction UI.ShowQueue(data)\n\tUI.Show(\"Queue\")\n\tUI.OnQueue(data)\nend\n\n----------------------------------------------------------------------------------------------\n-- Lobby camera (menus)\n----------------------------------------------------------------------------------------------\nlocal camCF: CFrame? = nil\nlocal function lobbyStep(dt: number)\n\tif State.mode ~= \"Menu\" then\n\t\tcamCF = nil\n\t\treturn\n\tend\n\tlocal camera = workspace.CurrentCamera\n\tcamera.CameraType = Enum.CameraType.Scriptable\n\tcamera.FieldOfView = 55\n\tcamT += dt\n\tlocal stands = workspace:FindFirstChild(\"Lobby\") and workspace.Lobby:FindFirstChild(\"Stands\")\n\tlocal target: CFrame\n\tif camMode == \"Select\" and stands then\n\t\tlocal r = Config.RobotById[State.robotId]\n\t\tlocal x = ((r and r.Index or 1) - 2) * 14\n\t\tlocal focus = Vector3.new(x, 6, 0)\n\t\ttarget = CFrame.lookAt(focus + Vector3.new(0, 4, 21), focus + Vector3.new(0, 0.5, 0))\n\t\tlocal statue = stands:FindFirstChild(\"Statue\" .. State.robotId)\n\t\tif statue then\n\t\t\tlocal pivot = statue:GetPivot()\n\t\t\tstatue:PivotTo(CFrame.new(pivot.Position) * CFrame.Angles(0, math.pi + math.sin(camT * 0.8) * 0.5, 0))\n\t\tend\n\telse\n\t\tlocal a = camT * 0.12\n\t\tlocal focus = Vector3.new(0, 5, 0)\n\t\ttarget = CFrame.lookAt(focus + Vector3.new(math.sin(a) * 46, 18, math.cos(a) * 46), focus)\n\tend\n\tif not camCF then\n\t\tcamCF = target\n\tend\n\tcamCF = (camCF :: CFrame):Lerp(target, 1 - math.exp(-dt * 4))\n\tcamera.CFrame = camCF :: CFrame\nend\n\n----------------------------------------------------------------------------------------------\n-- Init\n----------------------------------------------------------------------------------------------\nlocal function onBack(_, state)\n\tif state ~= Enum.UserInputState.Begin then\n\t\treturn Enum.ContextActionResult.Pass\n\tend\n\tlocal h = current and backHandlers[current]\n\tif h then\n\t\tSound.Play(\"UIBack\")\n\t\th()\n\t\treturn Enum.ContextActionResult.Sink\n\tend\n\treturn Enum.ContextActionResult.Pass\nend\n\nfunction UI.SetMenuInput(on: boolean)\n\tif on then\n\t\tContextActionService:BindAction(\"RC_MenuBack\", onBack, false, Enum.KeyCode.ButtonB, Enum.KeyCode.Backspace)\n\telse\n\t\tContextActionService:UnbindAction(\"RC_MenuBack\")\n\t\tGuiService.SelectedObject = nil\n\tend\nend\n\nfunction UI.Init(uiRoot: Frame)\n\troot = uiRoot\n\tbuildTitle()\n\tbuildSelect()\n\tbuildMode()\n\tbuildResults()\n\tsetDetail(State.robotId)\n\tRunService:BindToRenderStep(\"RoboClashLobbyCam\", Enum.RenderPriority.Camera.Value + 2, lobbyStep)\n\tState.InputTypeChanged:Connect(function(kind)\n\t\tif kind == \"Gamepad\" and current and GuiService.SelectedObject == nil then\n\t\t\tif current == \"Select\" then\n\t\t\t\tlocal b = robotButtons[State.robotId]\n\t\t\t\tGuiService.SelectedObject = b and b.button\n\t\t\telse\n\t\t\t\tselectDefault()\n\t\t\tend\n\t\telseif kind ~= \"Gamepad\" then\n\t\t\tGuiService.SelectedObject = nil\n\t\tend\n\tend)\n\tUserInputService.GamepadConnected:Connect(function()\n\t\tselectDefault()\n\tend)\n\tUI.SetMenuInput(true)\n\tUI.ShowTitle()\nend\n\nreturn UI\n","message":"The file /Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/UI.luau has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"toolu_01QtS3g2vn8iHk4HyinKrHQv","startedAtMs":"1791074731189","completedAtMs":"1791074732451"},"model_call_id":"f6f75537-51d9-46fb-a6c9-81f06ac674d8-75-u78q","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791074732456}
