oints,\n+\t\tparts = parts,\n+\t\thighlight = hl,\n+\t\tphase = 0,\n+\t\tfireR = 0,\n+\t\tfireL = 0,\n+\t\tfirePod = 0,\n+\t\tflinch = 0,\n+\t\tposeStart = nil,\n+\t\tlie = 0,\n+\t\tltm = -1,\n+\t\thiddenUntil = hiddenUntil,\n+\t\trootY = (hum and hum.HipHeight or 2.5) + root.Size.Y / 2,\n+\t\tcur = {},\n+\t}\n+\tfor name in pairs(joints) do\n+\t\trec.cur[name] = CFrame.identity\n+\tend\n+\trobots[model] = rec\n+\treturn rec\n+end\n+\n+function RobotAnim.Clear()\n+\tfor model, rec in pairs(robots) do\n+\t\tif rec.highlight then\n+\t\t\trec.highlight:Destroy()\n+\t\tend\n+\t\trobots[model] = nil\n+\tend\n+end\n+\n+function RobotAnim.Reveal(model: Model)\n+\tlocal rec = robots[model]\n+\tif rec then\n+\t\trec.hiddenUntil = nil\n+\tend\n+end\n+\n+function RobotAnim.OnFire(model: Model, weapon: string)\n+\tlocal rec = robots[model]\n+\tif not rec then\n+\t\treturn\n+\tend\n+\tlocal t = os.clock()\n+\tif weapon == \"Gun\" then\n+\t\trec.fireR = t\n+\telseif weapon == \"Bomb\" then\n+\t\trec.fireL = t\n+\telse\n+\t\trec.firePod = t\n+\tend\n+end\n+\n+function RobotAnim.Flinch(model: Model?)\n+\tlocal rec = model and robots[model]\n+\tif rec then\n+\t\trec.flinch = os.clock()\n+\tend\n+end\n+\n+local function setLTM(rec, v: number)\n+\tif rec.ltm == v then\n+\t\treturn\n+\tend\n+\trec.ltm = v\n+\tfor _, p in ipairs(rec.parts) do\n+\t\tp.LocalTransparencyModifier = v\n+\tend\n+end\n+\n+local function pulse(t0: number, dur: number, now: number): number\n+\tlocal a = (now - t0) / dur\n+\tif a < 0 or a > 1 then\n+\t\treturn 0\n+\tend\n+\treturn math.sin(a * math.pi)\n+end\n+\n+local function step(dt: number)\n+\tlocal now = os.clock()\n+\tlocal k = 1 - math.exp(-dt * 16)\n+\tfor model, rec in pairs(robots) do\n+\t\tif not model.Parent or not rec.root.Parent then\n+\t\t\trobots[model] = nil\n+\t\t\tcontinue\n+\t\tend\n+\t\tlocal root = rec.root\n+\t\tlocal state = model:GetAttribute(\"State\")\n+\t\tlocal pose = model:GetAttribute(\"Pose\")\n+\t\tlocal vel = root.AssemblyLinearVelocity\n+\t\tif root.Anchored then\n+\t\t\tvel = Vector3.zero\n+\t\tend\n+\t\tlocal lv = root.CFrame:VectorToObjectSpace(vel)\n+\t\tlocal flat = Vector3.new(vel.X, 0, vel.Z).Magnitude\n+\t\tlocal ground = workspace:Raycast(root.Position, Vector3.new(0, -(rec.rootY + 0.8), 0), rayParams)\n+\t\tlocal grounded = ground ~= nil or root.Anchored\n+\t\tlocal speedK = math.clamp(flat / 22, 0, 1)\n+\t\trec.phase += dt * flat * 0.36\n+\n+\t\tlocal T = {\n+\t\t\tRootJoint = CFrame.identity,\n+\t\t\tNeck = CFrame.identity,\n+\t\t\tRShoulder = CFrame.identity,\n+\t\t\tLShoulder = CFrame.identity,\n+\t\t\tRHip = CFrame.identity,\n+\t\t\tLHip = CFrame.identity,\n+\t\t}\n+\t\tlocal lying = state == \"Down\" or state == \"KO\" or pose == \"Defeat\"\n+\t\trec.lie += ((lying and 1 or 0) - rec.lie) * (1 - math.exp(-dt * (lying and 12 or 6)))\n+\n+\t\tif pose == \"Victory\" then\n+\t\t\trec.poseStart = rec.poseStart or now\n+\t\t\tlocal tt = now - rec.poseStart\n+\t\t\tlocal spin = tt < 0.7 and (tt / 0.7) * math.pi * 2 or 0\n+\t\t\tlocal hop = math.abs(math.sin(tt * 4.5)) * 1.2\n+\t\t\tT.RootJoint = CFrame.new(0, hop, 0) * CFrame.Angles(0, spin, 0)\n+\t\t\tT.RShoulder = CFrame.Angles(rad(160) + math.sin(tt * 9) * 0.2, 0, rad(-12))\n+\t\t\tT.LShoulder = CFrame.Angles(rad(160) - math.sin(tt * 9) * 0.2, 0, rad(12))\n+\t\t\tT.Neck = CFrame.Angles(rad(-10), 0, 0)\n+\t\telse\n+\t\t\trec.poseStart = nil\n+\t\t\tlocal fwd = math.clamp(-lv.Z / 30, -1, 1)\n+\t\t\tlocal right = math.clamp(lv.X / 30, -1, 1)\n+\t\t\tlocal bob = grounded and math.abs(math.sin(rec.phase)) * 0.18 * speedK or 0\n+\t\t\tlocal fl = pulse(rec.flinch, 0.22, now)\n+\t\t\tT.RootJoint = CFrame.new(0, bob, 0) * CFrame.Angles(-fwd * rad(14) + fl * rad(16), 0, -right * rad(10))\n+\t\t\tif grounded then\n+\t\t\t\tlocal swing = math.sin(rec.phase) * speedK * rad(34)\n+\t\t\t\tT.RHip = CFrame.Angles(swing, 0, 0)\n+\t\t\t\tT.LHip = CFrame.Angles(-swing, 0, 0)\n+\t\t\t\tT.LShoulder = CFrame.Angles(swing * 0.4, 0, 0)\n+\t\t\t\tT.RShoulder = CFrame.Angles(-swing * 0.15, 0, 0)\n+\t\t\telse\n+\t\t\t\tT.RHip = CFrame.Angles(rad(35), 0, 0)\n+\t\t\t\tT.LHip = CFrame.Angles(rad(10), 0, 0)\n+\t\t\t\tT.LShoulder = CFrame.Angles(rad(20), 0, rad(15))\n+\t\t\t\tT.RShoulder = CFrame.Angles(rad(10), 0, rad(-8))\n+\t\t\tend\n+\t\t\tlocal recoil = pulse(rec.fireR, 0.14, now)\n+\t\t\tif recoil > 0 then\n+\t\t\t\tT.RShoulder = T.RShoulder * CFrame.Angles(rad(-22) * recoil, 0, 0)\n+\t\t\tend\n+\t\t\tlocal throw = pulse(rec.fireL, 0.35, now)\n+\t\t\tif throw > 0 then\n+\t\t\t\tT.LShoulder = CFrame.Angles(rad(130) * throw, 0, 0)\n+\t\t\tend\n+\t\t\tlocal podK = pulse(rec.firePod, 0.25, now)\n+\t\t\tif podK > 0 then\n+\t\t\t\tT.RootJoint = T.RootJoint * CFrame.Angles(rad(-12) * podK, 0, 0)\n+\t\t\tend\n+\t\tend\n+\n+\t\tif rec.lie > 0.001 then\n+\t\t\tlocal lieCF = CFrame.new(0, -(rec.rootY - 1.1), 0.6) * CFrame.Angles(rad(86), 0, 0)\n+\t\t\tT.RootJoint = T.RootJoint:Lerp(lieCF, rec.lie)\n+\t\t\tT.RShoulder = T.RShoulder:Lerp(CFrame.Angles(0, 0, rad(-50)), rec.lie)\n+\t\t\tT.LShoulder = T.LShoulder:Lerp(CFrame.Angles(0, 0, rad(50)), rec.lie)\n+\t\t\tT.RHip = T.RHip:Lerp(CFrame.Angles(0, 0, rad(-12)), rec.lie)\n+\t\t\tT.LHip = T.LHip:Lerp(CFrame.Angles(0, 0, rad(12)), rec.lie)\n+\t\tend\n+\n+\t\tfor name, j in pairs(rec.joints) do\n+\t\t\tlocal cur = rec.cur[name]:Lerp(T[name], name == \"RootJoint\" and k * 0.9 or k)\n+\t\t\trec.cur[name] = cur\n+\t\t\tj.Transform = cur\n+\t\tend\n+\n+\t\t-- Visibility: intro hide, rebirth flashing.\n+\t\tif rec.hiddenUntil and now < rec.hiddenUntil then\n+\t\t\tsetLTM(rec, 1)\n+\t\t\trec.highlight.Enabled = false\n+\t\telseif state == \"Rebirth\" then\n+\t\t\tlocal on = math.floor(now * 14) % 2 == 0\n+\t\t\tsetLTM(rec, on and 0.7 or 0)\n+\t\t\trec.highlight.Enabled = true\n+\t\t\trec.highlight.FillTransparency = on and 0.25 or 0.85\n+\t\telse\n+\t\t\tsetLTM(rec, 0)\n+\t\t\trec.highlight.Enabled = false\n+\t\tend\n+\tend\n+end\n+\n+RunService:BindToRenderStep(\"RoboClashAnim\", Enum.RenderPriority.Character.Value + 1, step)\n+\n+return RobotAnim","afterFullFileContent":"-- Procedural robot animation via Motor6D.Transform (local to each client, so every client poses\n-- every robot itself from replicated velocity + attributes): run cycle, lean, air tuck, recoil,\n-- bomb throw, flinch, DOWN (lie flat), REBIRTH flashing, intro hide, victory pose.\nlocal RunService = game:GetService(\"RunService\")\n\nlocal RobotAnim = {}\n\nlocal robots = {}\nlocal rayParams = RaycastParams.new()\nrayParams.FilterType = Enum.RaycastFilterType.Include\nrayParams.FilterDescendantsInstances = {}\n\nlocal rad = math.rad\n\nfunction RobotAnim.SetGeometry(folder: Instance?)\n\trayParams.FilterDescendantsInstances = folder and { folder } or {}\nend\n\nlocal JOINTS = { \"RootJoint\", \"Neck\", \"RShoulder\", \"LShoulder\", \"RHip\", \"LHip\" }\n\nfunction RobotAnim.Register(model: Model, hiddenUntil: number?)\n\tif robots[model] then\n\t\treturn robots[model]\n\tend\n\tlocal root = model:WaitForChild(\"HumanoidRootPart\", 5) :: BasePart?\n\tif not root then\n\t\treturn nil\n\tend\n\tlocal joints = {}\n\tfor _, name in ipairs(JOINTS) do\n\t\tlocal j = model:FindFirstChild(name, true)\n\t\tif j and j:IsA(\"Motor6D\") then\n\t\t\tjoints[name] = j\n\t\tend\n\tend\n\tlocal parts = {}\n\tfor _, d in ipairs(model:GetDescendants()) do\n\t\tif d:IsA(\"BasePart\") and d ~= root then\n\t\t\ttable.insert(parts, d)\n\t\tend\n\tend\n\tlocal hl = Instance.new(\"Highlight\")\n\thl.FillColor = Color3.new(1, 1, 1)\n\thl.OutlineColor = Color3.new(1, 1, 1)\n\thl.FillTransparency = 1\n\thl.OutlineTransparency = 1\n\thl.DepthMode = Enum.HighlightDepthMode.Occluded\n\thl.Enabled = false\n\thl.Parent = model\n\tlocal hum = model:FindFirstChildOfClass(\"Humanoid\")\n\tlocal rec = {\n\t\tmodel = model,\n\t\troot = root,\n\t\tjoints = joints,\n\t\tparts = parts,\n\t\thighlight = hl,\n\t\tphase = 0,\n\t\tfireR = 0,\n\t\tfireL = 0,\n\t\tfirePod = 0,\n\t\tflinch = 0,\n\t\tposeStart = nil,\n\t\tlie = 0,\n\t\tltm = -1,\n\t\thiddenUntil = hiddenUntil,\n\t\trootY = (hum and hum.HipHeight or 2.5) + root.Size.Y / 2,\n\t\tcur = {},\n\t}\n\tfor name in pairs(joints) do\n\t\trec.cur[name] = CFrame.identity\n\tend\n\trobots[model] = rec\n\treturn rec\nend\n\nfunction RobotAnim.Clear()\n\tfor model, rec in pairs(robots) do\n\t\tif rec.highlight then\n\t\t\trec.highlight:Destroy()\n\t\tend\n\t\trobots[model] = nil\n\tend\nend\n\nfunction RobotAnim.Reveal(model: Model)\n\tlocal rec = robots[model]\n\tif rec then\n\t\trec.hiddenUntil = nil\n\tend\nend\n\nfunction RobotAnim.OnFire(model: Model, weapon: string)\n\tlocal rec = robots[model]\n\tif not rec then\n\t\treturn\n\tend\n\tlocal t = os.clock()\n\tif weapon == \"Gun\" then\n\t\trec.fireR = t\n\telseif weapon == \"Bomb\" then\n\t\trec.fireL = t\n\telse\n\t\trec.firePod = t\n\tend\nend\n\nfunction RobotAnim.Flinch(model: Model?)\n\tlocal rec = model and robots[model]\n\tif rec then\n\t\trec.flinch = os.clock()\n\tend\nend\n\nlocal function setLTM(rec, v: number)\n\tif rec.ltm == v then\n\t\treturn\n\tend\n\trec.ltm = v\n\tfor _, p in ipairs(rec.parts) do\n\t\tp.LocalTransparencyModifier = v\n\tend\nend\n\nlocal function pulse(t0: number, dur: number, now: number): number\n\tlocal a = (now - t0) / dur\n\tif a < 0 or a > 1 then\n\t\treturn 0\n\tend\n\treturn math.sin(a * math.pi)\nend\n\nlocal function step(dt: number)\n\tlocal now = os.clock()\n\tlocal k = 1 - math.exp(-dt * 16)\n\tfor model, rec in pairs(robots) do\n\t\tif not model.Parent or not rec.root.Parent then\n\t\t\trobots[model] = nil\n\t\t\tcontinue\n\t\tend\n\t\tlocal root = rec.root\n\t\tlocal state = model:GetAttribute(\"State\")\n\t\tlocal pose = model:GetAttribute(\"Pose\")\n\t\tlocal vel = root.AssemblyLinearVelocity\n\t\tif root.Anchored then\n\t\t\tvel = Vector3.zero\n\t\tend\n\t\tlocal lv = root.CFrame:VectorToObjectSpace(vel)\n\t\tlocal flat = Vector3.new(vel.X, 0, vel.Z).Magnitude\n\t\tlocal ground = workspace:Raycast(root.Position, Vector3.new(0, -(rec.rootY + 0.8), 0), rayParams)\n\t\tlocal grounded = ground ~= nil or root.Anchored\n\t\tlocal speedK = math.clamp(flat / 22, 0, 1)\n\t\trec.phase += dt * flat * 0.36\n\n\t\tlocal T = {\n\t\t\tRootJoint = CFrame.identity,\n\t\t\tNeck = CFrame.identity,\n\t\t\tRShoulder = CFrame.identity,\n\t\t\tLShoulder = CFrame.identity,\n\t\t\tRHip = CFrame.identity,\n\t\t\tLHip = CFrame.identity,\n\t\t}\n\t\tlocal lying = state == \"Down\" or state == \"KO\" or pose == \"Defeat\"\n\t\trec.lie += ((lying and 1 or 0) - rec.lie) * (1 - math.exp(-dt * (lying and 12 or 6)))\n\n\t\tif pose == \"Victory\" then\n\t\t\trec.poseStart = rec.poseStart or now\n\t\t\tlocal tt = now - rec.poseStart\n\t\t\tlocal spin = tt < 0.7 and (tt / 0.7) * math.pi * 2 or 0\n\t\t\tlocal hop = math.abs(math.sin(tt * 4.5)) * 1.2\n\t\t\tT.RootJoint = CFrame.new(0, hop, 0) * CFrame.Angles(0, spin, 0)\n\t\t\tT.RShoulder = CFrame.Angles(rad(160) + math.sin(tt * 9) * 0.2, 0, rad(-12))\n\t\t\tT.LShoulder = CFrame.Angles(rad(160) - math.sin(tt * 9) * 0.2, 0, rad(12))\n\t\t\tT.Neck = CFrame.Angles(rad(-10), 0, 0)\n\t\telse\n\t\t\trec.poseStart = nil\n\t\t\tlocal fwd = math.clamp(-lv.Z / 30, -1, 1)\n\t\t\tlocal right = math.clamp(lv.X / 30, -1, 1)\n\t\t\tlocal bob = grounded and math.abs(math.sin(rec.phase)) * 0.18 * speedK or 0\n\t\t\tlocal fl = pulse(rec.flinch, 0.22, now)\n\t\t\tT.RootJoint = CFrame.new(0, bob, 0) * CFrame.Angles(-fwd * rad(14) + fl * rad(16), 0, -right * rad(10))\n\t\t\tif grounded then\n\t\t\t\tlocal swing = math.sin(rec.phase) * speedK * rad(34)\n\t\t\t\tT.RHip = CFrame.Angles(swing, 0, 0)\n\t\t\t\tT.LHip = CFrame.Angles(-swing, 0, 0)\n\t\t\t\tT.LShoulder = CFrame.Angles(swing * 0.4, 0, 0)\n\t\t\t\tT.RShoulder = CFrame.Angles(-swing * 0.15, 0, 0)\n\t\t\telse\n\t\t\t\tT.RHip = CFrame.Angles(rad(35), 0, 0)\n\t\t\t\tT.LHip = CFrame.Angles(rad(10), 0, 0)\n\t\t\t\tT.LShoulder = CFrame.Angles(rad(20), 0, rad(15))\n\t\t\t\tT.RShoulder = CFrame.Angles(rad(10), 0, rad(-8))\n\t\t\tend\n\t\t\tlocal recoil = pulse(rec.fireR, 0.14, now)\n\t\t\tif recoil > 0 then\n\t\t\t\tT.RShoulder = T.RShoulder * CFrame.Angles(rad(-22) * recoil, 0, 0)\n\t\t\tend\n\t\t\tlocal throw = pulse(rec.fireL, 0.35, now)\n\t\t\tif throw > 0 then\n\t\t\t\tT.LShoulder = CFrame.Angles(rad(130) * throw, 0, 0)\n\t\t\tend\n\t\t\tlocal podK = pulse(rec.firePod, 0.25, now)\n\t\t\tif podK > 0 then\n\t\t\t\tT.RootJoint = T.RootJoint * CFrame.Angles(rad(-12) * podK, 0, 0)\n\t\t\tend\n\t\tend\n\n\t\tif rec.lie > 0.001 then\n\t\t\tlocal lieCF = CFrame.new(0, -(rec.rootY - 1.1), 0.6) * CFrame.Angles(rad(86), 0, 0)\n\t\t\tT.RootJoint = T.RootJoint:Lerp(lieCF, rec.lie)\n\t\t\tT.RShoulder = T.RShoulder:Lerp(CFrame.Angles(0, 0, rad(-50)), rec.lie)\n\t\t\tT.LShoulder = T.LShoulder:Lerp(CFrame.Angles(0, 0, rad(50)), rec.lie)\n\t\t\tT.RHip = T.RHip:Lerp(CFrame.Angles(0, 0, rad(-12)), rec.lie)\n\t\t\tT.LHip = T.LHip:Lerp(CFrame.Angles(0, 0, rad(12)), rec.lie)\n\t\tend\n\n\t\tfor name, j in pairs(rec.joints) do\n\t\t\tlocal cur = rec.cur[name]:Lerp(T[name], name == \"RootJoint\" and k * 0.9 or k)\n\t\t\trec.cur[name] = cur\n\t\t\tj.Transform = cur\n\t\tend\n\n\t\t-- Visibility: intro hide, rebirth flashing.\n\t\tif rec.hiddenUntil and now < rec.hiddenUntil then\n\t\t\tsetLTM(rec, 1)\n\t\t\trec.highlight.Enabled = false\n\t\telseif state == \"Rebirth\" then\n\t\t\tlocal on = math.floor(now * 14) % 2 == 0\n\t\t\tsetLTM(rec, on and 0.7 or 0)\n\t\t\trec.highlight.Enabled = true\n\t\t\trec.highlight.FillTransparency = on and 0.25 or 0.85\n\t\telse\n\t\t\tsetLTM(rec, 0)\n\t\t\trec.highlight.Enabled = false\n\t\tend\n\tend\nend\n\nRunService:BindToRenderStep(\"RoboClashAnim\", Enum.RenderPriority.Character.Value + 1, step)\n\nreturn RobotAnim\n","message":"Wrote contents to /Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/RobotAnim.luau"}}},"hookAdditionalContexts":[],"toolCallId":"toolu_01YXcVKLc6vHGiPsx6YLoMWE","startedAtMs":"1791074277689","completedAtMs":"1791074302904"},"model_call_