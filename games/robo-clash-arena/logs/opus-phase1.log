{"type":"tool_call","subtype":"completed","call_id":"toolu_01D7z5z5cCBr3jun6ZtFDS8v","tool_call":{"editToolCall":{"args":{"path":"/Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/FX.luau","streamContent":"return FX"},"result":{"success":{"path":"/Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/FX.luau","linesAdded":0,"linesRemoved":3,"diffString":"--- a//Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/FX.luau\n+++ b//Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/FX.luau\n@@ -641,7 +641,4 @@\n \treturn folder\n end\n \n--- Silence unused warning for Players (kept for future per-player FX filtering).\n-local _ = Players\n-\n return FX","beforeFullFileContent":"-- Client visuals for server-authoritative combat: projectiles (simulated locally with the shared\n-- ProjectileSim, corrected by ProjSync/ProjEnd), blasts, sparks, muzzle flashes, charge glow,\n-- dash trails, and screen shake. All instances here are local-only.\nlocal Debris = game:GetService(\"Debris\")\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal TweenService = game:GetService(\"TweenService\")\n\nlocal RC = ReplicatedStorage:WaitForChild(\"RoboClash\")\nlocal Config = require(RC.Config)\nlocal Sim = require(RC.Shared.ProjectileSim)\nlocal State = require(script.Parent.State)\nlocal Sound = require(script.Parent.Sound)\n\nlocal FX = {}\nlocal HUD, RobotAnim, Battle -- injected\n\nlocal folder = Instance.new(\"Folder\")\nfolder.Name = \"RoboClashFX\"\nfolder.Parent = workspace\n\nlocal visuals = {}\nlocal charges = {}\nlocal trails = {}\nlocal shakeAmp, shakeUntil, shakeDur = 0, 0, 0.001\n\nlocal SPARK = \"rbxasset://textures/particles/sparkles_main.dds\"\nlocal SMOKE = \"rbxasset://textures/particles/smoke_main.dds\"\nlocal FIRE = \"rbxasset://textures/particles/fire_main.dds\"\n\nlocal function ball(size: number, color: Color3, transparency: number?): Part\n\tlocal p = Instance.new(\"Part\")\n\tp.Shape = Enum.PartType.Ball\n\tp.Size = Vector3.one * size\n\tp.Color = color\n\tp.Material = Enum.Material.Neon\n\tp.Transparency = transparency or 0\n\tp.Anchored = true\n\tp.CanCollide = false\n\tp.CanQuery = false\n\tp.CanTouch = false\n\tp.CastShadow = false\n\tp.Parent = folder\n\treturn p\nend\n\nlocal function block(size: Vector3, color: Color3, shape: Enum.PartType?, transparency: number?): Part\n\tlocal p = Instance.new(\"Part\")\n\tp.Size = size\n\tif shape then\n\t\tp.Shape = shape\n\tend\n\tp.Color = color\n\tp.Material = Enum.Material.Neon\n\tp.Transparency = transparency or 0\n\tp.Anchored = true\n\tp.CanCollide = false\n\tp.CanQuery = false\n\tp.CanTouch = false\n\tp.CastShadow = false\n\tp.Parent = folder\n\treturn p\nend\n\nlocal function trail(part: BasePart, color: Color3, width: number, lifetime: number)\n\tlocal a0 = Instance.new(\"Attachment\")\n\ta0.Position = Vector3.new(0, width / 2, 0)\n\ta0.Parent = part\n\tlocal a1 = Instance.new(\"Attachment\")\n\ta1.Position = Vector3.new(0, -width / 2, 0)\n\ta1.Parent = part\n\tlocal t = Instance.new(\"Trail\")\n\tt.Attachment0 = a0\n\tt.Attachment1 = a1\n\tt.Lifetime = lifetime\n\tt.Color = ColorSequence.new(color)\n\tt.LightEmission = 1\n\tt.LightInfluence = 0\n\tt.FaceCamera = true\n\tt.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })\n\tt.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.1) })\n\tt.Parent = part\n\treturn t\nend\n\nlocal function emitter(parent: Instance, props)\n\tlocal e = Instance.new(\"ParticleEmitter\")\n\te.Enabled = false\n\te.LightEmission = 1\n\te.LightInfluence = 0\n\tfor k, v in pairs(props) do\n\t\t(e :: any)[k] = v\n\tend\n\te.Parent = parent\n\treturn e\nend\n\nlocal function burstAt(pos: Vector3, color: Color3, count: number, speed: number, size: number, life: number?)\n\tlocal holder = Instance.new(\"Part\")\n\tholder.Anchored = true\n\tholder.CanCollide = false\n\tholder.CanQuery = false\n\tholder.CanTouch = false\n\tholder.Transparency = 1\n\tholder.Size = Vector3.one * 0.2\n\tholder.CFrame = CFrame.new(pos)\n\tholder.Parent = folder\n\tlocal e = emitter(holder, {\n\t\tTexture = SPARK,\n\t\tColor = ColorSequence.new(Color3.new(1, 1, 1), color),\n\t\tSize = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) }),\n\t\tSpeed = NumberRange.new(speed * 0.5, speed),\n\t\tSpreadAngle = Vector2.new(180, 180),\n\t\tLifetime = NumberRange.new((life or 0.35) * 0.6, life or 0.35),\n\t\tDrag = 4,\n\t\tRate = 0,\n\t})\n\te:Emit(count)\n\tDebris:AddItem(holder, 1.5)\nend\n\nlocal function smokeAt(pos: Vector3, color: Color3, count: number, size: number)\n\tlocal holder = Instance.new(\"Part\")\n\tholder.Anchored = true\n\tholder.CanCollide = false\n\tholder.CanQuery = false\n\tholder.CanTouch = false\n\tholder.Transparency = 1\n\tholder.Size = Vector3.one * 0.2\n\tholder.CFrame = CFrame.new(pos)\n\tholder.Parent = folder\n\tlocal e = emitter(holder, {\n\t\tTexture = SMOKE,\n\t\tLightEmission = 0.3,\n\t\tColor = ColorSequence.new(color),\n\t\tTransparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) }),\n\t\tSize = NumberSequence.new({ NumberSequenceKeypoint.new(0, size * 0.5), NumberSequenceKeypoint.new(1, size) }),\n\t\tSpeed = NumberRange.new(2, 6),\n\t\tSpreadAngle = Vector2.new(180, 30),\n\t\tLifetime = NumberRange.new(0.5, 0.9),\n\t\tRate = 0,\n\t})\n\te:Emit(count)\n\tDebris:AddItem(holder, 2)\nend\n\nlocal function flash(pos: Vector3, color: Color3, size: number, time: number)\n\tlocal b = ball(size, color, 0.1)\n\tb.CFrame = CFrame.new(pos)\n\tlocal l = Instance.new(\"PointLight\")\n\tl.Color = color\n\tl.Range = size * 4\n\tl.Brightness = 3\n\tl.Parent = b\n\tTweenService:Create(b, TweenInfo.new(time), { Transparency = 1, Size = Vector3.one * size * 1.6 }):Play()\n\tTweenService:Create(l, TweenInfo.new(time), { Brightness = 0 }):Play()\n\tDebris:AddItem(b, time + 0.05)\nend\nFX.Flash = flash\n\nfunction FX.Shake(amp: number, dur: number)\n\tlocal t = os.clock()\n\tlocal remaining = math.max(0, shakeUntil - t) / shakeDur * shakeAmp\n\tif amp >= remaining then\n\t\tshakeAmp = amp\n\t\tshakeDur = dur\n\t\tshakeUntil = t + dur\n\tend\nend\n\nfunction FX.ShakeCFrame(): CFrame\n\tlocal t = os.clock()\n\tif t >= shakeUntil then\n\t\treturn CFrame.identity\n\tend\n\tlocal k = (shakeUntil - t) / shakeDur\n\tlocal a = shakeAmp * k\n\treturn CFrame.new((math.random() - 0.5) * a, (math.random() - 0.5) * a, (math.random() - 0.5) * a * 0.5)\n\t\t* CFrame.Angles(0, 0, (math.random() - 0.5) * a * 0.02)\nend\n\nlocal function localModel(): Model?\n\treturn State.localModel\nend\n\nlocal function distToLocal(pos: Vector3): number\n\tlocal m = localModel()\n\tlocal root = m and m:FindFirstChild(\"HumanoidRootPart\")\n\tif root then\n\t\treturn (root.Position - pos).Magnitude\n\tend\n\treturn 999\nend\n\nlocal function aimPos(model: Model?): Vector3?\n\tif not model or not model.Parent then\n\t\treturn nil\n\tend\n\tlocal root = model:FindFirstChild(\"HumanoidRootPart\") :: BasePart?\n\tif not root then\n\t\treturn nil\n\tend\n\treturn root.Position + Vector3.new(0, model:GetAttribute(\"AimY\") or 0, 0)\nend\n\n----------------------------------------------------------------------------------------------\n-- Projectiles\n----------------------------------------------------------------------------------------------\nlocal function removeVisual(id: number, fade: boolean?)\n\tlocal v = visuals[id]\n\tif not v then\n\t\treturn\n\tend\n\tvisuals[id] = nil\n\tfor _, part in ipairs(v.parts) do\n\t\tif fade then\n\t\t\tTweenService:Create(part, TweenInfo.new(0.15), { Transparency = 1 }):Play()\n\t\t\tDebris:AddItem(part, 0.4)\n\t\telse\n\t\t\t-- let trails finish\n\t\t\tpart.Transparency = 1\n\t\t\tDebris:AddItem(part, 0.35)\n\t\tend\n\tend\nend\n\nlocal function makeVisual(p)\n\tlocal parts = {}\n\tlocal main\n\tlocal color = p.color or Color3.new(1, 1, 1)\n\tlocal kind = p.kind\n\tif kind == \"Bullet\" then\n\t\tif p.style == \"Beam\" then\n\t\t\tmain = block(Vector3.new(7, 1.3, 1.3), color, Enum.PartType.Cylinder)\n\t\t\tlocal glow = block(Vector3.new(8, 2.6, 2.6), color, Enum.PartType.Cylinder, 0.7)\n\t\t\ttable.insert(parts, glow)\n\t\t\ttrail(main, color, 1.6, 0.25)\n\t\t\tlocal l = Instance.new(\"PointLight\")\n\t\t\tl.Color = color\n\t\t\tl.Range = 14\n\t\t\tl.Brightness = 2\n\t\t\tl.Parent = main\n\t\t\tp.glow = glow\n\t\telseif p.style == \"Pellet\" then\n\t\t\tmain = ball(p.size * 0.9, color)\n\t\t\ttrail(main, color, 0.6, 0.12)\n\t\telse\n\t\t\tmain = ball(p.size, color)\n\t\t\tlocal core = ball(p.size * 0.55, Color3.new(1, 1, 1))\n\t\t\ttable.insert(parts, core)\n\t\t\tp.core = core\n\t\t\ttrail(main, color, p.size * 0.8, 0.18)\n\t\tend\n\telseif kind == \"Bomb\" then\n\t\tmain = ball(p.size, color)\n\t\tlocal ring = block(Vector3.new(0.2, p.size * 1.7, p.size * 1.7), Color3.new(1, 1, 1), Enum.PartType.Cylinder, 0.3)\n\t\ttable.insert(parts, ring)\n\t\tp.ring = ring\n\t\ttrail(main, color, p.size * 0.6, 0.35)\n\t\t-- landing marker telegraph\n\t\tif p.finish then\n\t\t\tlocal r = (p.radius or 8) * 2\n\t\t\tlocal marker = block(Vector3.new(0.15, r, r), Config.Match and color or color, Enum.PartType.Cylinder, 0.65)\n\t\t\tmarker.CFrame = CFrame.new(p.finish + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, 0, math.rad(90))\n\t\t\ttable.insert(parts, marker)\n\t\t\tp.marker = marker\n\t\tend\n\telseif kind == \"Seeker\" or kind == \"Orbit\" then\n\t\tmain = ball(p.size, color, 0.15)\n\t\tlocal core = ball(p.size * 0.5, Color3.new(1, 1, 1))\n\t\ttable.insert(parts, core)\n\t\tp.core = core\n\t\tlocal l = Instance.new(\"PointLight\")\n\t\tl.Color = color\n\t\tl.Range = 10\n\t\tl.Brightness = 1.5\n\t\tl.Parent = main\n\t\ttrail(main, color, p.size * 0.5, 0.4)\n\telseif kind == \"Mine\" then\n\t\tmain = block(Vector3.new(0.7, p.size, p.size), Color3.fromRGB(40, 40, 50), Enum.PartType.Cylinder)\n\t\tmain.Material = Enum.Material.Metal\n\t\tlocal light = ball(0.9, color)\n\t\ttable.insert(parts, light)\n\t\tp.light = light\n\t\tlocal r = (p.radius or 9) * 2\n\t\tlocal ring = block(Vector3.new(0.12, r, r), color, Enum.PartType.Cylinder, 1)\n\t\ttable.insert(parts, ring)\n\t\tp.triggerRing = ring\n\tend\n\ttable.insert(parts, 1, main)\n\treturn { p = p, main = main, parts = parts, prevPos = p.pos }\nend\n\nlocal function onProj(data)\n\tlocal p = table.clone(data)\n\tp.age = 0\n\tlocal targetModel = p.target\n\tp.target = nil\n\tp.targetModel = targetModel\n\tif p.kind == \"Bomb\" then\n\t\tp.radius = data.radius\n\tend\n\tlocal v = makeVisual(p)\n\tlocal elapsed = workspace:GetServerTimeNow() - (data.t0 or workspace:GetServerTimeNow())\n\tif elapsed > 0 then\n\t\tSim.fastForward(p, elapsed, aimPos(targetModel))\n\tend\n\tvisuals[p.id] = v\nend\n\nlocal function updateVisual(v, dt: number, tclock: number)\n\tlocal p = v.p\n\tlocal prev = p.pos\n\tSim.step(p, dt, aimPos(p.targetModel))\n\tif v.syncPos then\n\t\tlocal k = 1 - math.exp(-dt * 10)\n\t\tp.pos = p.pos:Lerp(v.syncPos, k)\n\t\tv.syncPos = v.syncPos + (p.pos - prev)\n\t\tif (v.syncPos - p.pos).Magnitude < 0.05 then\n\t\t\tv.syncPos = nil\n\t\tend\n\tend\n\tlocal vel = p.pos - prev\n\tlocal look = vel.Magnitude > 1e-4 and vel.Unit or (p.dir or Vector3.zAxis)\n\tlocal main = v.main\n\tif p.kind == \"Bullet\" and p.style == \"Beam\" then\n\t\tlocal cf = CFrame.lookAt(p.pos, p.pos + look) * CFrame.Angles(0, math.rad(90), 0)\n\t\tmain.CFrame = cf\n\t\tp.glow.CFrame = cf\n\telseif p.kind == \"Mine\" then\n\t\tmain.CFrame = CFrame.new(p.pos) * CFrame.Angles(0, 0, math.rad(90))\n\t\tp.light.CFrame = CFrame.new(p.pos + Vector3.new(0, 0.5, 0))\n\t\tlocal armed = p.landed and p.age >= (p.throwTime or 0) + (p.armTime or 0)\n\t\tlocal blink = armed and (math.floor(tclock * 6) % 2 == 0) or (math.floor(tclock * 2) % 2 == 0)\n\t\tp.light.Transparency = blink and 0 or 0.7\n\t\tp.triggerRing.CFrame = CFrame.new(Vector3.new(p.pos.X, p.floorRingY or (p.pos.Y - 0.8), p.pos.Z)) * CFrame.Angles(0, 0, math.rad(90))\n\t\tp.triggerRing.Transparency = armed and 0.75 or 1\n\telse\n\t\tmain.CFrame = CFrame.lookAt(p.pos, p.pos + look)\n\t\tif p.core then\n\t\t\tp.core.CFrame = main.CFrame\n\t\t\tif p.kind ~= \"Bullet\" then\n\t\t\t\tlocal s = p.size * (0.45 + 0.15 * math.sin(tclock * 12))\n\t\t\t\tp.core.Size = Vector3.one * s\n\t\t\tend\n\t\tend\n\t\tif p.ring then\n\t\t\tp.ring.CFrame = CFrame.new(p.pos) * CFrame.Angles(tclock * 6, tclock * 4, 0)\n\t\tend\n\tend\n\tif p.age > (p.life or 3) + 2 then\n\t\treturn false\n\tend\n\treturn true\nend\n\nlocal function onProjEnd(data)\n\tlocal v = visuals[data.id]\n\tlocal pos = data.pos\n\tif v then\n\t\tlocal color = v.p.color or Color3.new(1, 1, 1)\n\t\tif data.reason == \"wall\" then\n\t\t\tburstAt(pos, color, 8, 18, 0.6)\n\t\t\tflash(pos, color, 1.4, 0.12)\n\t\telseif data.reason == \"expire\" then\n\t\t\tremoveVisual(data.id, true)\n\t\t\treturn\n\t\tend\n\tend\n\tremoveVisual(data.id, false)\nend\n\nlocal function onProjSync(list)\n\tfor _, e in ipairs(list) do\n\t\tlocal v = visuals[e[1]]\n\t\tif v then\n\t\t\tv.syncPos = e[2]\n\t\t\tif e[3] then\n\t\t\t\tv.p.dir = e[3]\n\t\t\tend\n\t\tend\n\tend\nend\n\nlocal function clearAll()\n\tfor id in pairs(visuals) do\n\t\tremoveVisual(id, true)\n\tend\n\tfor model in pairs(charges) do\n\t\tFX.StopCharge(model)\n\tend\nend\nFX.ClearAll = clearAll\n\n----------------------------------------------------------------------------------------------\n-- Blasts / hits / misc\n----------------------------------------------------------------------------------------------\nlocal function onBlast(data)\n\tlocal pos, r, linger, color = data.pos, data.radius, data.linger, data.color or Color3.fromRGB(255, 140, 60)\n\tlocal sphere = ball(r * 0.6, color, 0.15)\n\tsphere.CFrame = CFrame.new(pos)\n\tlocal core = ball(r * 0.35, Color3.new(1, 1, 1), 0.05)\n\tcore.CFrame = CFrame.new(pos)\n\tlocal ring = block(Vector3.new(0.3, r * 1.2, r * 1.2), Color3.new(1, 1, 1), Enum.PartType.Cylinder, 0.2)\n\tring.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))\n\tlocal light = Instance.new(\"PointLight\")\n\tlight.Color = color\n\tlight.Range = r * 3.5\n\tlight.Brightness = 5\n\tlight.Parent = sphere\n\tTweenService:Create(sphere, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.one * r * 2 }):Play()\n\tTweenService:Create(core, TweenInfo.new(0.2), { Size = Vector3.one * r * 1.2, Transparency = 0.6 }):Play()\n\tTweenService:Create(ring, TweenInfo.new(0.35), { Size = Vector3.new(0.3, r * 3.2, r * 3.2), Transparency = 1 }):Play()\n\tTweenService:Create(light, TweenInfo.new(linger + 0.2), { Brightness = 0 }):Play()\n\tburstAt(pos, color, 30, 45, 1.6, 0.6)\n\tsmokeAt(pos, Color3.fromRGB(70, 60, 90), 10, r * 0.9)\n\ttask.spawn(function()\n\t\tlocal t0 = os.clock()\n\t\twhile os.clock() - t0 < linger do\n\t\t\tsphere.Transparency = 0.25 + math.random() * 0.2\n\t\t\ttask.wait(0.05)\n\t\tend\n\t\tTweenService:Create(sphere, TweenInfo.new(0.25), { Transparency = 1, Size = Vector3.one * r * 2.2 }):Play()\n\t\tTweenService:Create(core, TweenInfo.new(0.2), { Transparency = 1 }):Play()\n\t\ttask.wait(0.3)\n\t\tsphere:Destroy()\n\t\tcore:Destroy()\n\t\tring:Destroy()\n\tend)\n\tlocal d = distToLocal(pos)\n\tlocal amp = (data.big and 2.2 or 1.4) * math.clamp(1 - d / 70, 0.15, 1)\n\tFX.Shake(amp, 0.35)\n\tSound.Play(\"Explosion\", { volume = data.big and 1.2 or 0.9, pitch = data.big and 0.8 or 1 })\nend\n\nlocal function onHit(data)\n\tlocal victim = data.victim\n\tlocal color = Color3.fromRGB(255, 230, 120)\n\tburstAt(data.pos, color, data.heavy and 26 or 14, data.heavy and 40 or 28, data.heavy and 1.4 or 0.9)\n\tflash(data.pos, Color3.new(1, 1, 1), data.heavy and 3 or 1.8, 0.12)\n\tif HUD then\n\t\tHUD.ShowHit(victim, data.pos, data.amount, data.combo, data.heavy)\n\tend\n\tif RobotAnim then\n\t\tRobotAnim.Flinch(victim)\n\tend\n\tif victim == localModel() then\n\t\tFX.Shake(data.heavy and 2.6 or 0.9, data.heavy and 0.45 or 0.2)\n\t\tif HUD then\n\t\t\tHUD.DamageVignette(data.heavy)\n\t\tend\n\telseif data.attacker == localModel() and data.heavy then\n\t\tFX.Shake(1.0, 0.2)\n\tend\n\tSound.Play(data.heavy and \"HeavyHit\" or \"Hit\")\nend\n\nlocal WEAPON_ATT = { Gun = \"GunTip\", Bomb = \"BombTip\", Pod = \"PodTip\" }\nlocal function onFire(data)\n\tlocal model = data.model\n\tif not model or not model.Parent then\n\t\treturn\n\tend\n\tlocal att = model:FindFirstChild(WEAPON_ATT[data.weapon] or \"GunTip\", true)\n\tlocal robot = Config.RobotById[model:GetAttribute(\"RobotId\") or \"Bolt\"]\n\tlocal loadout = Config.GetLoadout(robot.Id)\n\tlocal color = data.weapon == \"Gun\" and loadout.Gun.Color or (data.weapon == \"Bomb\" and loadout.Bomb.Color or loadout.Pod.Color)\n\tif att and att:IsA(\"Attachment\") then\n\t\tflash(att.WorldPosition, color, data.weapon == \"Gun\" and 1.8 or 2.4, 0.1)\n\tend\n\tif RobotAnim then\n\t\tRobotAnim.OnFire(model, data.weapon)\n\tend\n\tif model == localModel() and Battle then\n\t\tBattle.OnLocalFire(data)\n\tend\n\tif data.weapon == \"Gun\" then\n\t\tSound.Play(data.gunType == \"Spread\" and \"Shotgun\" or (data.gunType == \"Charge\" and \"Laser\" or \"Blaster\"))\n\telseif data.weapon == \"Bomb\" then\n\t\tSound.Play(\"BombThrow\")\n\telse\n\t\tSound.Play(\"Pod\")\n\tend\nend\n\nfunction FX.StopCharge(model)\n\tlocal ch = charges[model]\n\tif ch then\n\t\tcharges[model] = nil\n\t\tch.orb:Destroy()\n\t\tif ch.sound then\n\t\t\tch.sound:Destroy()\n\t\tend\n\tend\nend\n\nlocal function onCharge(data)\n\tlocal model = data.model\n\tif not model then\n\t\treturn\n\tend\n\tif data.on then\n\t\tFX.StopCharge(model)\n\t\tlocal robot = Config.RobotById[model:GetAttribute(\"RobotId\") or \"Lancer\"]\n\t\tlocal color = Config.GetLoadout(robot.Id).Gun.Color\n\t\tlocal orb = ball(0.4, color, 0.1)\n\t\tlocal l = Instance.new(\"PointLight\")\n\t\tl.Color = color\n\t\tl.Range = 8\n\t\tl.Brightness = 2\n\t\tl.Parent = orb\n\t\tcharges[model] = { orb = orb, t0 = os.clock(), dur = data.chargeTime or 0.8, color = color, sound = Sound.Play(\"Charge\", { vary = 0 }) }\n\telse\n\t\tFX.StopCharge(model)\n\tend\nend\n\nlocal function trailFor(model: Model)\n\tlocal t = trails[model]\n\tif t and t.Parent then\n\t\treturn t\n\tend\n\tlocal torso = model:FindFirstChild(\"Torso\")\n\tif not torso then\n\t\treturn nil\n\tend\n\tlocal robot = Config.RobotById[model:GetAttribute(\"RobotId\") or \"Bolt\"]\n\tlocal a0 = Instance.new(\"Attachment\")\n\ta0.Name = \"RCTrailTop\"\n\ta0.Position = Vector3.new(0, 1.2, 0.5)\n\ta0.Parent = torso\n\tlocal a1 = Instance.new(\"Attachment\")\n\ta1.Name = \"RCTrailBottom\"\n\ta1.Position = Vector3.new(0, -2.5, 0.5)\n\ta1.Parent = torso\n\tlocal tr = Instance.new(\"Trail\")\n\ttr.Attachment0 = a0\n\ttr.Attachment1 = a1\n\ttr.Lifetime = 0.22\n\ttr.Color = ColorSequence.new(robot.Neon)\n\ttr.LightEmission = 1\n\ttr.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })\n\ttr.Enabled = false\n\ttr.Parent = torso\n\ttrails[model] = tr\n\treturn tr\nend\n\nlocal function onDash(data)\n\tlocal model = data.model\n\tif not model or not model.Parent then\n\t\treturn\n\tend\n\tlocal tr = trailFor(model)\n\tif tr then\n\t\ttr.Enabled = true\n\t\ttask.delay(0.32, function()\n\t\t\tif tr.Parent then\n\t\t\t\ttr.Enabled = false\n\t\t\tend\n\t\tend)\n\tend\n\tlocal root = model:FindFirstChild(\"HumanoidRootPart\")\n\tif root and not data.air then\n\t\tsmokeAt(root.Position - Vector3.new(0, 3.5, 0), Color3.fromRGB(150, 160, 200), 6, 2.5)\n\tend\n\tSound.Play(\"Dash\")\nend\n\nlocal handlers = {\n\tProj = onProj,\n\tProjEnd = onProjEnd,\n\tProjSync = onProjSync,\n\tClearProj = clearAll,\n\tBlast = onBlast,\n\tHit = onHit,\n\tFire = onFire,\n\tCharge = onCharge,\n\tDash = onDash,\n\tDown = function(data)\n\t\tif HUD then\n\t\t\tHUD.TagText(data.model, \"DOWN\", Color3.fromRGB(255, 90, 170))\n\t\tend\n\t\tSound.Play(\"Down\")\n\t\tif data.model == localModel() then\n\t\t\tFX.Shake(2.2, 0.4)\n\t\tend\n\tend,\n\tRebirth = function(data)\n\t\tif HUD then\n\t\t\tHUD.TagText(data.model, \"REBIRTH\", Color3.fromRGB(255, 255, 255))\n\t\tend\n\tend,\n\tPit = function(data)\n\t\tif HUD then\n\t\t\tHUD.TagText(data.model, \"PIT  -\" .. tostring(data.amount), Color3.fromRGB(255, 80, 80))\n\t\tend\n\t\tSound.Play(\"HeavyHit\")\n\tend,\n}\n\nfunction FX.Init(deps)\n\tHUD = deps.HUD\n\tRobotAnim = deps.RobotAnim\n\tBattle = deps.Battle\n\tRC.Remotes.FX.OnClientEvent:Connect(function(kind, data)\n\t\tlocal h = handlers[kind]\n\t\tif h then\n\t\t\tlocal ok, err = pcall(h, data)\n\t\t\tif not ok then\n\t\t\t\twarn(\"[RoboClash FX] \" .. tostring(kind) .. \": \" .. tostring(err))\n\t\t\tend\n\t\tend\n\tend)\n\tRunService.RenderStepped:Connect(function(dt)\n\t\tlocal tclock = os.clock()\n\t\tfor id, v in pairs(visuals) do\n\t\t\tlocal ok, keep = pcall(updateVisual, v, dt, tclock)\n\t\t\tif not ok or not keep then\n\t\t\t\tremoveVisual(id, true)\n\t\t\tend\n\t\tend\n\t\tfor model, ch in pairs(charges) do\n\t\t\tlocal att = model.Parent and model:FindFirstChild(\"GunTip\", true)\n\t\t\tif not att then\n\t\t\t\tFX.StopCharge(model)\n\t\t\telse\n\t\t\t\tlocal k = math.clamp((tclock - ch.t0) / ch.dur, 0, 1)\n\t\t\t\tlocal full = k >= 1\n\t\t\t\tlocal s = 0.4 + 1.6 * k + (full and 0.25 * math.sin(tclock * 30) or 0)\n\t\t\t\tch.orb.Size = Vector3.one * s\n\t\t\t\tch.orb.CFrame = CFrame.new((att :: Attachment).WorldPosition)\n\t\t\t\tch.orb.Color = full and Color3.new(1, 1, 1) or ch.color\n\t\t\tend\n\t\tend\n\tend)\nend\n\nfunction FX.Folder()\n\treturn folder\nend\n\n-- Silence unused warning for Players (kept for future per-player FX filtering).\nlocal _ = Players\n\nreturn FX\n","afterFullFileContent":"-- Client visuals for server-authoritative combat: projectiles (simulated locally with the shared\n-- ProjectileSim, corrected by ProjSync/ProjEnd), blasts, sparks, muzzle flashes, charge glow,\n-- dash trails, and screen shake. All instances here are local-only.\nlocal Debris = game:GetService(\"Debris\")\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal TweenService = game:GetService(\"TweenService\")\n\nlocal RC = ReplicatedStorage:WaitForChild(\"RoboClash\")\nlocal Config = require(RC.Config)\nlocal Sim = require(RC.Shared.ProjectileSim)\nlocal State = require(script.Parent.State)\nlocal Sound = require(script.Parent.Sound)\n\nlocal FX = {}\nlocal HUD, RobotAnim, Battle -- injected\n\nlocal folder = Instance.new(\"Folder\")\nfolder.Name = \"RoboClashFX\"\nfolder.Parent = workspace\n\nlocal visuals = {}\nlocal charges = {}\nlocal trails = {}\nlocal shakeAmp, shakeUntil, shakeDur = 0, 0, 0.001\n\nlocal SPARK = \"rbxasset://textures/particles/sparkles_main.dds\"\nlocal SMOKE = \"rbxasset://textures/particles/smoke_main.dds\"\nlocal FIRE = \"rbxasset://textures/particles/fire_main.dds\"\n\nlocal function ball(size: number, color: Color3, transparency: number?): Part\n\tlocal p = Instance.new(\"Part\")\n\tp.Shape = Enum.PartType.Ball\n\tp.Size = Vector3.one * size\n\tp.Color = color\n\tp.Material = Enum.Material.Neon\n\tp.Transparency = transparency or 0\n\tp.Anchored = true\n\tp.CanCollide = false\n\tp.CanQuery = false\n\tp.CanTouch = false\n\tp.CastShadow = false\n\tp.Parent = folder\n\treturn p\nend\n\nlocal function block(size: Vector3, color: Color3, shape: Enum.PartType?, transparency: number?): Part\n\tlocal p = Instance.new(\"Part\")\n\tp.Size = size\n\tif shape then\n\t\tp.Shape = shape\n\tend\n\tp.Color = color\n\tp.Material = Enum.Material.Neon\n\tp.Transparency = transparency or 0\n\tp.Anchored = true\n\tp.CanCollide = false\n\tp.CanQuery = false\n\tp.CanTouch = false\n\tp.CastShadow = false\n\tp.Parent = folder\n\treturn p\nend\n\nlocal function trail(part: BasePart, color: Color3, width: number, lifetime: number)\n\tlocal a0 = Instance.new(\"Attachment\")\n\ta0.Position = Vector3.new(0, width / 2, 0)\n\ta0.Parent = part\n\tlocal a1 = Instance.new(\"Attachment\")\n\ta1.Position = Vector3.new(0, -width / 2, 0)\n\ta1.Parent = part\n\tlocal t = Instance.new(\"Trail\")\n\tt.Attachment0 = a0\n\tt.Attachment1 = a1\n\tt.Lifetime = lifetime\n\tt.Color = ColorSequence.new(color)\n\tt.LightEmission = 1\n\tt.LightInfluence = 0\n\tt.FaceCamera = true\n\tt.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })\n\tt.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.1) })\n\tt.Parent = part\n\treturn t\nend\n\nlocal function emitter(parent: Instance, props)\n\tlocal e = Instance.new(\"ParticleEmitter\")\n\te.Enabled = false\n\te.LightEmission = 1\n\te.LightInfluence = 0\n\tfor k, v in pairs(props) do\n\t\t(e :: any)[k] = v\n\tend\n\te.Parent = parent\n\treturn e\nend\n\nlocal function burstAt(pos: Vector3, color: Color3, count: number, speed: number, size: number, life: number?)\n\tlocal holder = Instance.new(\"Part\")\n\tholder.Anchored = true\n\tholder.CanCollide = false\n\tholder.CanQuery = false\n\tholder.CanTouch = false\n\tholder.Transparency = 1\n\tholder.Size = Vector3.one * 0.2\n\tholder.CFrame = CFrame.new(pos)\n\tholder.Parent = folder\n\tlocal e = emitter(holder, {\n\t\tTexture = SPARK,\n\t\tColor = ColorSequence.new(Color3.new(1, 1, 1), color),\n\t\tSize = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) }),\n\t\tSpeed = NumberRange.new(speed * 0.5, speed),\n\t\tSpreadAngle = Vector2.new(180, 180),\n\t\tLifetime = NumberRange.new((life or 0.35) * 0.6, life or 0.35),\n\t\tDrag = 4,\n\t\tRate = 0,\n\t})\n\te:Emit(count)\n\tDebris:AddItem(holder, 1.5)\nend\n\nlocal function smokeAt(pos: Vector3, color: Color3, count: number, size: number)\n\tlocal holder = Instance.new(\"Part\")\n\tholder.Anchored = true\n\tholder.CanCollide = false\n\tholder.CanQuery = false\n\tholder.CanTouch = false\n\tholder.Transparency = 1\n\tholder.Size = Vector3.one * 0.2\n\tholder.CFrame = CFrame.new(pos)\n\tholder.Parent = folder\n\tlocal e = emitter(holder, {\n\t\tTexture = SMOKE,\n\t\tLightEmission = 0.3,\n\t\tColor = ColorSequence.new(color),\n\t\tTransparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) }),\n\t\tSize = NumberSequence.new({ NumberSequenceKeypoint.new(0, size * 0.5), NumberSequenceKeypoint.new(1, size) }),\n\t\tSpeed = NumberRange.new(2, 6),\n\t\tSpreadAngle = Vector2.new(180, 30),\n\t\tLifetime = NumberRange.new(0.5, 0.9),\n\t\tRate = 0,\n\t})\n\te:Emit(count)\n\tDebris:AddItem(holder, 2)\nend\n\nlocal function flash(pos: Vector3, color: Color3, size: number, time: number)\n\tlocal b = ball(size, color, 0.1)\n\tb.CFrame = CFrame.new(pos)\n\tlocal l = Instance.new(\"PointLight\")\n\tl.Color = color\n\tl.Range = size * 4\n\tl.Brightness = 3\n\tl.Parent = b\n\tTweenService:Create(b, TweenInfo.new(time), { Transparency = 1, Size = Vector3.one * size * 1.6 }):Play()\n\tTweenService:Create(l, TweenInfo.new(time), { Brightness = 0 }):Play()\n\tDebris:AddItem(b, time + 0.05)\nend\nFX.Flash = flash\n\nfunction FX.Shake(amp: number, dur: number)\n\tlocal t = os.clock()\n\tlocal remaining = math.max(0, shakeUntil - t) / shakeDur * shakeAmp\n\tif amp >= remaining then\n\t\tshakeAmp = amp\n\t\tshakeDur = dur\n\t\tshakeUntil = t + dur\n\tend\nend\n\nfunction FX.ShakeCFrame(): CFrame\n\tlocal t = os.clock()\n\tif t >= shakeUntil then\n\t\treturn CFrame.identity\n\tend\n\tlocal k = (shakeUntil - t) / shakeDur\n\tlocal a = shakeAmp * k\n\treturn CFrame.new((math.random() - 0.5) * a, (math.random() - 0.5) * a, (math.random() - 0.5) * a * 0.5)\n\t\t* CFrame.Angles(0, 0, (math.random() - 0.5) * a * 0.02)\nend\n\nlocal function localModel(): Model?\n\treturn State.localModel\nend\n\nlocal function distToLocal(pos: Vector3): number\n\tlocal m = localModel()\n\tlocal root = m and m:FindFirstChild(\"HumanoidRootPart\")\n\tif root then\n\t\treturn (root.Position - pos).Magnitude\n\tend\n\treturn 999\nend\n\nlocal function aimPos(model: Model?): Vector3?\n\tif not model or not model.Parent then\n\t\treturn nil\n\tend\n\tlocal root = model:FindFirstChild(\"HumanoidRootPart\") :: BasePart?\n\tif not root then\n\t\treturn nil\n\tend\n\treturn root.Position + Vector3.new(0, model:GetAttribute(\"AimY\") or 0, 0)\nend\n\n----------------------------------------------------------------------------------------------\n-- Projectiles\n----------------------------------------------------------------------------------------------\nlocal function removeVisual(id: number, fade: boolean?)\n\tlocal v = visuals[id]\n\tif not v then\n\t\treturn\n\tend\n\tvisuals[id] = nil\n\tfor _, part in ipairs(v.parts) do\n\t\tif fade then\n\t\t\tTweenService:Create(part, TweenInfo.new(0.15), { Transparency = 1 }):Play()\n\t\t\tDebris:AddItem(part, 0.4)\n\t\telse\n\t\t\t-- let trails finish\n\t\t\tpart.Transparency = 1\n\t\t\tDebris:AddItem(part, 0.35)\n\t\tend\n\tend\nend\n\nlocal function makeVisual(p)\n\tlocal parts = {}\n\tlocal main\n\tlocal color = p.color or Color3.new(1, 1, 1)\n\tlocal kind = p.kind\n\tif kind == \"Bullet\" then\n\t\tif p.style == \"Beam\" then\n\t\t\tmain = block(Vector3.new(7, 1.3, 1.3), color, Enum.PartType.Cylinder)\n\t\t\tlocal glow = block(Vector3.new(8, 2.6, 2.6), color, Enum.PartType.Cylinder, 0.7)\n\t\t\ttable.insert(parts, glow)\n\t\t\ttrail(main, color, 1.6, 0.25)\n\t\t\tlocal l = Instance.new(\"PointLight\")\n\t\t\tl.Color = color\n\t\t\tl.Range = 14\n\t\t\tl.Brightness = 2\n\t\t\tl.Parent = main\n\t\t\tp.glow = glow\n\t\telseif p.style == \"Pellet\" then\n\t\t\tmain = ball(p.size * 0.9, color)\n\t\t\ttrail(main, color, 0.6, 0.12)\n\t\telse\n\t\t\tmain = ball(p.size, color)\n\t\t\tlocal core = ball(p.size * 0.55, Color3.new(1, 1, 1))\n\t\t\ttable.insert(parts, core)\n\t\t\tp.core = core\n\t\t\ttrail(main, color, p.size * 0.8, 0.18)\n\t\tend\n\telseif kind == \"Bomb\" then\n\t\tmain = ball(p.size, color)\n\t\tlocal ring = block(Vector3.new(0.2, p.size * 1.7, p.size * 1.7), Color3.new(1, 1, 1), Enum.PartType.Cylinder, 0.3)\n\t\ttable.insert(parts, ring)\n\t\tp.ring = ring\n\t\ttrail(main, color, p.size * 0.6, 0.35)\n\t\t-- landing marker telegraph\n\t\tif p.finish then\n\t\t\tlocal r = (p.radius or 8) * 2\n\t\t\tlocal marker = block(Vector3.new(0.15, r, r), Config.Match and color or color, Enum.PartType.Cylinder, 0.65)\n\t\t\tmarker.CFrame = CFrame.new(p.finish + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, 0, math.rad(90))\n\t\t\ttable.insert(parts, marker)\n\t\t\tp.marker = marker\n\t\tend\n\telseif kind == \"Seeker\" or kind == \"Orbit\" then\n\t\tmain = ball(p.size, color, 0.15)\n\t\tlocal core = ball(p.size * 0.5, Color3.new(1, 1, 1))\n\t\ttable.insert(parts, core)\n\t\tp.core = core\n\t\tlocal l = Instance.new(\"PointLight\")\n\t\tl.Color = color\n\t\tl.Range = 10\n\t\tl.Brightness = 1.5\n\t\tl.Parent = main\n\t\ttrail(main, color, p.size * 0.5, 0.4)\n\telseif kind == \"Mine\" then\n\t\tmain = block(Vector3.new(0.7, p.size, p.size), Color3.fromRGB(40, 40, 50), Enum.PartType.Cylinder)\n\t\tmain.Material = Enum.Material.Metal\n\t\tlocal light = ball(0.9, color)\n\t\ttable.insert(parts, light)\n\t\tp.light = light\n\t\tlocal r = (p.radius or 9) * 2\n\t\tlocal ring = block(Vector3.new(0.12, r, r), color, Enum.PartType.Cylinder, 1)\n\t\ttable.insert(parts, ring)\n\t\tp.triggerRing = ring\n\tend\n\ttable.insert(parts, 1, main)\n\treturn { p = p, main = main, parts = parts, prevPos = p.pos }\nend\n\nlocal function onProj(data)\n\tlocal p = table.clone(data)\n\tp.age = 0\n\tlocal targetModel = p.target\n\tp.target = nil\n\tp.targetModel = targetModel\n\tif p.kind == \"Bomb\" then\n\t\tp.radius = data.radius\n\tend\n\tlocal v = makeVisual(p)\n\tlocal elapsed = workspace:GetServerTimeNow() - (data.t0 or workspace:GetServerTimeNow())\n\tif elapsed > 0 then\n\t\tSim.fastForward(p, elapsed, aimPos(targetModel))\n\tend\n\tvisuals[p.id] = v\nend\n\nlocal function updateVisual(v, dt: number, tclock: number)\n\tlocal p = v.p\n\tlocal prev = p.pos\n\tSim.step(p, dt, aimPos(p.targetModel))\n\tif v.syncPos then\n\t\tlocal k = 1 - math.exp(-dt * 10)\n\t\tp.pos = p.pos:Lerp(v.syncPos, k)\n\t\tv.syncPos = v.syncPos + (p.pos - prev)\n\t\tif (v.syncPos - p.pos).Magnitude < 0.05 then\n\t\t\tv.syncPos = nil\n\t\tend\n\tend\n\tlocal vel = p.pos - prev\n\tlocal look = vel.Magnitude > 1e-4 and vel.Unit or (p.dir or Vector3.zAxis)\n\tlocal main = v.main\n\tif p.kind == \"Bullet\" and p.style == \"Beam\" then\n\t\tlocal cf = CFrame.lookAt(p.pos, p.pos + look) * CFrame.Angles(0, math.rad(90), 0)\n\t\tmain.CFrame = cf\n\t\tp.glow.CFrame = cf\n\telseif p.kind == \"Mine\" then\n\t\tmain.CFrame = CFrame.new(p.pos) * CFrame.Angles(0, 0, math.rad(90))\n\t\tp.light.CFrame = CFrame.new(p.pos + Vector3.new(0, 0.5, 0))\n\t\tlocal armed = p.landed and p.age >= (p.throwTime or 0) + (p.armTime or 0)\n\t\tlocal blink = armed and (math.floor(tclock * 6) % 2 == 0) or (math.floor(tclock * 2) % 2 == 0)\n\t\tp.light.Transparency = blink and 0 or 0.7\n\t\tp.triggerRing.CFrame = CFrame.new(Vector3.new(p.pos.X, p.floorRingY or (p.pos.Y - 0.8), p.pos.Z)) * CFrame.Angles(0, 0, math.rad(90))\n\t\tp.triggerRing.Transparency = armed and 0.75 or 1\n\telse\n\t\tmain.CFrame = CFrame.lookAt(p.pos, p.pos + look)\n\t\tif p.core then\n\t\t\tp.core.CFrame = main.CFrame\n\t\t\tif p.kind ~= \"Bullet\" then\n\t\t\t\tlocal s = p.size * (0.45 + 0.15 * math.sin(tclock * 12))\n\t\t\t\tp.core.Size = Vector3.one * s\n\t\t\tend\n\t\tend\n\t\tif p.ring then\n\t\t\tp.ring.CFrame = CFrame.new(p.pos) * CFrame.Angles(tclock * 6, tclock * 4, 0)\n\t\tend\n\tend\n\tif p.age > (p.life or 3) + 2 then\n\t\treturn false\n\tend\n\treturn true\nend\n\nlocal function onProjEnd(data)\n\tlocal v = visuals[data.id]\n\tlocal pos = data.pos\n\tif v then\n\t\tlocal color = v.p.color or Color3.new(1, 1, 1)\n\t\tif data.reason == \"wall\" then\n\t\t\tburstAt(pos, color, 8, 18, 0.6)\n\t\t\tflash(pos, color, 1.4, 0.12)\n\t\telseif data.reason == \"expire\" then\n\t\t\tremoveVisual(data.id, true)\n\t\t\treturn\n\t\tend\n\tend\n\tremoveVisual(data.id, false)\nend\n\nlocal function onProjSync(list)\n\tfor _, e in ipairs(list) do\n\t\tlocal v = visuals[e[1]]\n\t\tif v then\n\t\t\tv.syncPos = e[2]\n\t\t\tif e[3] then\n\t\t\t\tv.p.dir = e[3]\n\t\t\tend\n\t\tend\n\tend\nend\n\nlocal function clearAll()\n\tfor id in pairs(visuals) do\n\t\tremoveVisual(id, true)\n\tend\n\tfor model in pairs(charges) do\n\t\tFX.StopCharge(model)\n\tend\nend\nFX.ClearAll = clearAll\n\n----------------------------------------------------------------------------------------------\n-- Blasts / hits / misc\n----------------------------------------------------------------------------------------------\nlocal function onBlast(data)\n\tlocal pos, r, linger, color = data.pos, data.radius, data.linger, data.color or Color3.fromRGB(255, 140, 60)\n\tlocal sphere = ball(r * 0.6, color, 0.15)\n\tsphere.CFrame = CFrame.new(pos)\n\tlocal core = ball(r * 0.35, Color3.new(1, 1, 1), 0.05)\n\tcore.CFrame = CFrame.new(pos)\n\tlocal ring = block(Vector3.new(0.3, r * 1.2, r * 1.2), Color3.new(1, 1, 1), Enum.PartType.Cylinder, 0.2)\n\tring.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))\n\tlocal light = Instance.new(\"PointLight\")\n\tlight.Color = color\n\tlight.Range = r * 3.5\n\tlight.Brightness = 5\n\tlight.Parent = sphere\n\tTweenService:Create(sphere, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.one * r * 2 }):Play()\n\tTweenService:Create(core, TweenInfo.new(0.2), { Size = Vector3.one * r * 1.2, Transparency = 0.6 }):Play()\n\tTweenService:Create(ring, TweenInfo.new(0.35), { Size = Vector3.new(0.3, r * 3.2, r * 3.2), Transparency = 1 }):Play()\n\tTweenService:Create(light, TweenInfo.new(linger + 0.2), { Brightness = 0 }):Play()\n\tburstAt(pos, color, 30, 45, 1.6, 0.6)\n\tsmokeAt(pos, Color3.fromRGB(70, 60, 90), 10, r * 0.9)\n\ttask.spawn(function()\n\t\tlocal t0 = os.clock()\n\t\twhile os.clock() - t0 < linger do\n\t\t\tsphere.Transparency = 0.25 + math.random() * 0.2\n\t\t\ttask.wait(0.05)\n\t\tend\n\t\tTweenService:Create(sphere, TweenInfo.new(0.25), { Transparency = 1, Size = Vector3.one * r * 2.2 }):Play()\n\t\tTweenService:Create(core, TweenInfo.new(0.2), { Transparency = 1 }):Play()\n\t\ttask.wait(0.3)\n\t\tsphere:Destroy()\n\t\tcore:Destroy()\n\t\tring:Destroy()\n\tend)\n\tlocal d = distToLocal(pos)\n\tlocal amp = (data.big and 2.2 or 1.4) * math.clamp(1 - d / 70, 0.15, 1)\n\tFX.Shake(amp, 0.35)\n\tSound.Play(\"Explosion\", { volume = data.big and 1.2 or 0.9, pitch = data.big and 0.8 or 1 })\nend\n\nlocal function onHit(data)\n\tlocal victim = data.victim\n\tlocal color = Color3.fromRGB(255, 230, 120)\n\tburstAt(data.pos, color, data.heavy and 26 or 14, data.heavy and 40 or 28, data.heavy and 1.4 or 0.9)\n\tflash(data.pos, Color3.new(1, 1, 1), data.heavy and 3 or 1.8, 0.12)\n\tif HUD then\n\t\tHUD.ShowHit(victim, data.pos, data.amount, data.combo, data.heavy)\n\tend\n\tif RobotAnim then\n\t\tRobotAnim.Flinch(victim)\n\tend\n\tif victim == localModel() then\n\t\tFX.Shake(data.heavy and 2.6 or 0.9, data.heavy and 0.45 or 0.2)\n\t\tif HUD then\n\t\t\tHUD.DamageVignette(data.heavy)\n\t\tend\n\telseif data.attacker == localModel() and data.heavy then\n\t\tFX.Shake(1.0, 0.2)\n\tend\n\tSound.Play(data.heavy and \"HeavyHit\" or \"Hit\")\nend\n\nlocal WEAPON_ATT = { Gun = \"GunTip\", Bomb = \"BombTip\", Pod = \"PodTip\" }\nlocal function onFire(data)\n\tlocal model = data.model\n\tif not model or not model.Parent then\n\t\treturn\n\tend\n\tlocal att = model:FindFirstChild(WEAPON_ATT[data.weapon] or \"GunTip\", true)\n\tlocal robot = Config.RobotById[model:GetAttribute(\"RobotId\") or \"Bolt\"]\n\tlocal loadout = Config.GetLoadout(robot.Id)\n\tlocal color = data.weapon == \"Gun\" and loadout.Gun.Color or (data.weapon == \"Bomb\" and loadout.Bomb.Color or loadout.Pod.Color)\n\tif att and att:IsA(\"Attachment\") then\n\t\tflash(att.WorldPosition, color, data.weapon == \"Gun\" and 1.8 or 2.4, 0.1)\n\tend\n\tif RobotAnim then\n\t\tRobotAnim.OnFire(model, data.weapon)\n\tend\n\tif model == localModel() and Battle then\n\t\tBattle.OnLocalFire(data)\n\tend\n\tif data.weapon == \"Gun\" then\n\t\tSound.Play(data.gunType == \"Spread\" and \"Shotgun\" or (data.gunType == \"Charge\" and \"Laser\" or \"Blaster\"))\n\telseif data.weapon == \"Bomb\" then\n\t\tSound.Play(\"BombThrow\")\n\telse\n\t\tSound.Play(\"Pod\")\n\tend\nend\n\nfunction FX.StopCharge(model)\n\tlocal ch = charges[model]\n\tif ch then\n\t\tcharges[model] = nil\n\t\tch.orb:Destroy()\n\t\tif ch.sound then\n\t\t\tch.sound:Destroy()\n\t\tend\n\tend\nend\n\nlocal function onCharge(data)\n\tlocal model = data.model\n\tif not model then\n\t\treturn\n\tend\n\tif data.on then\n\t\tFX.StopCharge(model)\n\t\tlocal robot = Config.RobotById[model:GetAttribute(\"RobotId\") or \"Lancer\"]\n\t\tlocal color = Config.GetLoadout(robot.Id).Gun.Color\n\t\tlocal orb = ball(0.4, color, 0.1)\n\t\tlocal l = Instance.new(\"PointLight\")\n\t\tl.Color = color\n\t\tl.Range = 8\n\t\tl.Brightness = 2\n\t\tl.Parent = orb\n\t\tcharges[model] = { orb = orb, t0 = os.clock(), dur = data.chargeTime or 0.8, color = color, sound = Sound.Play(\"Charge\", { vary = 0 }) }\n\telse\n\t\tFX.StopCharge(model)\n\tend\nend\n\nlocal function trailFor(model: Model)\n\tlocal t = trails[model]\n\tif t and t.Parent then\n\t\treturn t\n\tend\n\tlocal torso = model:FindFirstChild(\"Torso\")\n\tif not torso then\n\t\treturn nil\n\tend\n\tlocal robot = Config.RobotById[model:GetAttribute(\"RobotId\") or \"Bolt\"]\n\tlocal a0 = Instance.new(\"Attachment\")\n\ta0.Name = \"RCTrailTop\"\n\ta0.Position = Vector3.new(0, 1.2, 0.5)\n\ta0.Parent = torso\n\tlocal a1 = Instance.new(\"Attachment\")\n\ta1.Name = \"RCTrailBottom\"\n\ta1.Position = Vector3.new(0, -2.5, 0.5)\n\ta1.Parent = torso\n\tlocal tr = Instance.new(\"Trail\")\n\ttr.Attachment0 = a0\n\ttr.Attachment1 = a1\n\ttr.Lifetime = 0.22\n\ttr.Color = ColorSequence.new(robot.Neon)\n\ttr.LightEmission = 1\n\ttr.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })\n\ttr.Enabled = false\n\ttr.Parent = torso\n\ttrails[model] = tr\n\treturn tr\nend\n\nlocal function onDash(data)\n\tlocal model = data.model\n\tif not model or not model.Parent then\n\t\treturn\n\tend\n\tlocal tr = trailFor(model)\n\tif tr then\n\t\ttr.Enabled = true\n\t\ttask.delay(0.32, function()\n\t\t\tif tr.Parent then\n\t\t\t\ttr.Enabled = false\n\t\t\tend\n\t\tend)\n\tend\n\tlocal root = model:FindFirstChild(\"HumanoidRootPart\")\n\tif root and not data.air then\n\t\tsmokeAt(root.Position - Vector3.new(0, 3.5, 0), Color3.fromRGB(150, 160, 200), 6, 2.5)\n\tend\n\tSound.Play(\"Dash\")\nend\n\nlocal handlers = {\n\tProj = onProj,\n\tProjEnd = onProjEnd,\n\tProjSync = onProjSync,\n\tClearProj = clearAll,\n\tBlast = onBlast,\n\tHit = onHit,\n\tFire = onFire,\n\tCharge = onCharge,\n\tDash = onDash,\n\tDown = function(data)\n\t\tif HUD then\n\t\t\tHUD.TagText(data.model, \"DOWN\", Color3.fromRGB(255, 90, 170))\n\t\tend\n\t\tSound.Play(\"Down\")\n\t\tif data.model == localModel() then\n\t\t\tFX.Shake(2.2, 0.4)\n\t\tend\n\tend,\n\tRebirth = function(data)\n\t\tif HUD then\n\t\t\tHUD.TagText(data.model, \"REBIRTH\", Color3.fromRGB(255, 255, 255))\n\t\tend\n\tend,\n\tPit = function(data)\n\t\tif HUD then\n\t\t\tHUD.TagText(data.model, \"PIT  -\" .. tostring(data.amount), Color3.fromRGB(255, 80, 80))\n\t\tend\n\t\tSound.Play(\"HeavyHit\")\n\tend,\n}\n\nfunction FX.Init(deps)\n\tHUD = deps.HUD\n\tRobotAnim = deps.RobotAnim\n\tBattle = deps.Battle\n\tRC.Remotes.FX.OnClientEvent:Connect(function(kind, data)\n\t\tlocal h = handlers[kind]\n\t\tif h then\n\t\t\tlocal ok, err = pcall(h, data)\n\t\t\tif not ok then\n\t\t\t\twarn(\"[RoboClash FX] \" .. tostring(kind) .. \": \" .. tostring(err))\n\t\t\tend\n\t\tend\n\tend)\n\tRunService.RenderStepped:Connect(function(dt)\n\t\tlocal tclock = os.clock()\n\t\tfor id, v in pairs(visuals) do\n\t\t\tlocal ok, keep = pcall(updateVisual, v, dt, tclock)\n\t\t\tif not ok or not keep then\n\t\t\t\tremoveVisual(id, true)\n\t\t\tend\n\t\tend\n\t\tfor model, ch in pairs(charges) do\n\t\t\tlocal att = model.Parent and model:FindFirstChild(\"GunTip\", true)\n\t\t\tif not att then\n\t\t\t\tFX.StopCharge(model)\n\t\t\telse\n\t\t\t\tlocal k = math.clamp((tclock - ch.t0) / ch.dur, 0, 1)\n\t\t\t\tlocal full = k >= 1\n\t\t\t\tlocal s = 0.4 + 1.6 * k + (full and 0.25 * math.sin(tclock * 30) or 0)\n\t\t\t\tch.orb.Size = Vector3.one * s\n\t\t\t\tch.orb.CFrame = CFrame.new((att :: Attachment).WorldPosition)\n\t\t\t\tch.orb.Color = full and Color3.new(1, 1, 1) or ch.color\n\t\t\tend\n\t\tend\n\tend)\nend\n\nfunction FX.Folder()\n\treturn folder\nend\n\nreturn FX\n","message":"The file /Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/FX.luau has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"toolu_01D7z5z5cCBr3jun6ZtFDS8v","startedAtMs":"1791074249525","completedAtMs":"1791074249594"},"model_call_id":"f6f75537-51d9-46fb-a6c9-81f06ac674d8-54-e109","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791074249600}
{"type":"tool_call","subtype":"started","call_id":"toolu_01RAhKejRz1cVonCXs8MLni6","tool_call":{"editToolCall":{"args":{"path":"/Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/FX.luau","streamContent":"local Debris = game:GetService(\"Debris\")\nlocal ReplicatedStorage"}},"hookAdditionalContexts":[],"toolCallId":"toolu_01RAhKejRz1cVonCXs8MLni6","startedAtMs":"1791074249537"},"model_call_id":"f6f75537-51d9-46fb-a6c9-81f06ac674d8-54-e109","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791074250722}
{"type":"tool_call","subtype":"completed","call_id":"toolu_01RAhKejRz1cVonCXs8MLni6","tool_call":{"editToolCall":{"args":{"path":"/Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/FX.luau","streamContent":"local Debris = game:GetService(\"Debris\")\nlocal ReplicatedStorage"},"result":{"success":{"path":"/Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/FX.luau","linesAdded":0,"linesRemoved":1,"diffString":"--- a//Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/FX.luau\n+++ b//Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/FX.luau\n@@ -2,7 +2,6 @@\n -- ProjectileSim, corrected by ProjSync/ProjEnd), blasts, sparks, muzzle flashes, charge glow,\n -- dash trails, and screen shake. All instances here are local-only.\n local Debris = game:GetService(\"Debris\")\n-local Players = game:GetService(\"Players\")\n local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n local RunService = game:GetService(\"RunService\")\n local TweenService = game:GetService(\"TweenService\")","beforeFullFileContent":"-- Client visuals for server-authoritative combat: projectiles (simulated locally with the shared\n-- ProjectileSim, corrected by ProjSync/ProjEnd), blasts, sparks, muzzle flashes, charge glow,\n-- dash trails, and screen shake. All instances here are local-only.\nlocal Debris = game:GetService(\"Debris\")\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal TweenService = game:GetService(\"TweenService\")\n\nlocal RC = ReplicatedStorage:WaitForChild(\"RoboClash\")\nlocal Config = require(RC.Config)\nlocal Sim = require(RC.Shared.ProjectileSim)\nlocal State = require(script.Parent.State)\nlocal Sound = require(script.Parent.Sound)\n\nlocal FX = {}\nlocal HUD, RobotAnim, Battle -- injected\n\nlocal folder = Instance.new(\"Folder\")\nfolder.Name = \"RoboClashFX\"\nfolder.Parent = workspace\n\nlocal visuals = {}\nlocal charges = {}\nlocal trails = {}\nlocal shakeAmp, shakeUntil, shakeDur = 0, 0, 0.001\n\nlocal SPARK = \"rbxasset://textures/particles/sparkles_main.dds\"\nlocal SMOKE = \"rbxasset://textures/particles/smoke_main.dds\"\nlocal FIRE = \"rbxasset://textures/particles/fire_main.dds\"\n\nlocal function ball(size: number, color: Color3, transparency: number?): Part\n\tlocal p = Instance.new(\"Part\")\n\tp.Shape = Enum.PartType.Ball\n\tp.Size = Vector3.one * size\n\tp.Color = color\n\tp.Material = Enum.Material.Neon\n\tp.Transparency = transparency or 0\n\tp.Anchored = true\n\tp.CanCollide = false\n\tp.CanQuery = false\n\tp.CanTouch = false\n\tp.CastShadow = false\n\tp.Parent = folder\n\treturn p\nend\n\nlocal function block(size: Vector3, color: Color3, shape: Enum.PartType?, transparency: number?): Part\n\tlocal p = Instance.new(\"Part\")\n\tp.Size = size\n\tif shape then\n\t\tp.Shape = shape\n\tend\n\tp.Color = color\n\tp.Material = Enum.Material.Neon\n\tp.Transparency = transparency or 0\n\tp.Anchored = true\n\tp.CanCollide = false\n\tp.CanQuery = false\n\tp.CanTouch = false\n\tp.CastShadow = false\n\tp.Parent = folder\n\treturn p\nend\n\nlocal function trail(part: BasePart, color: Color3, width: number, lifetime: number)\n\tlocal a0 = Instance.new(\"Attachment\")\n\ta0.Position = Vector3.new(0, width / 2, 0)\n\ta0.Parent = part\n\tlocal a1 = Instance.new(\"Attachment\")\n\ta1.Position = Vector3.new(0, -width / 2, 0)\n\ta1.Parent = part\n\tlocal t = Instance.new(\"Trail\")\n\tt.Attachment0 = a0\n\tt.Attachment1 = a1\n\tt.Lifetime = lifetime\n\tt.Color = ColorSequence.new(color)\n\tt.LightEmission = 1\n\tt.LightInfluence = 0\n\tt.FaceCamera = true\n\tt.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })\n\tt.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.1) })\n\tt.Parent = part\n\treturn t\nend\n\nlocal function emitter(parent: Instance, props)\n\tlocal e = Instance.new(\"ParticleEmitter\")\n\te.Enabled = false\n\te.LightEmission = 1\n\te.LightInfluence = 0\n\tfor k, v in pairs(props) do\n\t\t(e :: any)[k] = v\n\tend\n\te.Parent = parent\n\treturn e\nend\n\nlocal function burstAt(pos: Vector3, color: Color3, count: number, speed: number, size: number, life: number?)\n\tlocal holder = Instance.new(\"Part\")\n\tholder.Anchored = true\n\tholder.CanCollide = false\n\tholder.CanQuery = false\n\tholder.CanTouch = false\n\tholder.Transparency = 1\n\tholder.Size = Vector3.one * 0.2\n\tholder.CFrame = CFrame.new(pos)\n\tholder.Parent = folder\n\tlocal e = emitter(holder, {\n\t\tTexture = SPARK,\n\t\tColor = ColorSequence.new(Color3.new(1, 1, 1), color),\n\t\tSize = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) }),\n\t\tSpeed = NumberRange.new(speed * 0.5, speed),\n\t\tSpreadAngle = Vector2.new(180, 180),\n\t\tLifetime = NumberRange.new((life or 0.35) * 0.6, life or 0.35),\n\t\tDrag = 4,\n\t\tRate = 0,\n\t})\n\te:Emit(count)\n\tDebris:AddItem(holder, 1.5)\nend\n\nlocal function smokeAt(pos: Vector3, color: Color3, count: number, size: number)\n\tlocal holder = Instance.new(\"Part\")\n\tholder.Anchored = true\n\tholder.CanCollide = false\n\tholder.CanQuery = false\n\tholder.CanTouch = false\n\tholder.Transparency = 1\n\tholder.Size = Vector3.one * 0.2\n\tholder.CFrame = CFrame.new(pos)\n\tholder.Parent = folder\n\tlocal e = emitter(holder, {\n\t\tTexture = SMOKE,\n\t\tLightEmission = 0.3,\n\t\tColor = ColorSequence.new(color),\n\t\tTransparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) }),\n\t\tSize = NumberSequence.new({ NumberSequenceKeypoint.new(0, size * 0.5), NumberSequenceKeypoint.new(1, size) }),\n\t\tSpeed = NumberRange.new(2, 6),\n\t\tSpreadAngle = Vector2.new(180, 30),\n\t\tLifetime = NumberRange.new(0.5, 0.9),\n\t\tRate = 0,\n\t})\n\te:Emit(count)\n\tDebris:AddItem(holder, 2)\nend\n\nlocal function flash(pos: Vector3, color: Color3, size: number, time: number)\n\tlocal b = ball(size, color, 0.1)\n\tb.CFrame = CFrame.new(pos)\n\tlocal l = Instance.new(\"PointLight\")\n\tl.Color = color\n\tl.Range = size * 4\n\tl.Brightness = 3\n\tl.Parent = b\n\tTweenService:Create(b, TweenInfo.new(time), { Transparency = 1, Size = Vector3.one * size * 1.6 }):Play()\n\tTweenService:Create(l, TweenInfo.new(time), { Brightness = 0 }):Play()\n\tDebris:AddItem(b, time + 0.05)\nend\nFX.Flash = flash\n\nfunction FX.Shake(amp: number, dur: number)\n\tlocal t = os.clock()\n\tlocal remaining = math.max(0, shakeUntil - t) / shakeDur * shakeAmp\n\tif amp >= remaining then\n\t\tshakeAmp = amp\n\t\tshakeDur = dur\n\t\tshakeUntil = t + dur\n\tend\nend\n\nfunction FX.ShakeCFrame(): CFrame\n\tlocal t = os.clock()\n\tif t >= shakeUntil then\n\t\treturn CFrame.identity\n\tend\n\tlocal k = (shakeUntil - t) / shakeDur\n\tlocal a = shakeAmp * k\n\treturn CFrame.new((math.random() - 0.5) * a, (math.random() - 0.5) * a, (math.random() - 0.5) * a * 0.5)\n\t\t* CFrame.Angles(0, 0, (math.random() - 0.5) * a * 0.02)\nend\n\nlocal function localModel(): Model?\n\treturn State.localModel\nend\n\nlocal function distToLocal(pos: Vector3): number\n\tlocal m = localModel()\n\tlocal root = m and m:FindFirstChild(\"HumanoidRootPart\")\n\tif root then\n\t\treturn (root.Position - pos).Magnitude\n\tend\n\treturn 999\nend\n\nlocal function aimPos(model: Model?): Vector3?\n\tif not model or not model.Parent then\n\t\treturn nil\n\tend\n\tlocal root = model:FindFirstChild(\"HumanoidRootPart\") :: BasePart?\n\tif not root then\n\t\treturn nil\n\tend\n\treturn root.Position + Vector3.new(0, model:GetAttribute(\"AimY\") or 0, 0)\nend\n\n----------------------------------------------------------------------------------------------\n-- Projectiles\n----------------------------------------------------------------------------------------------\nlocal function removeVisual(id: number, fade: boolean?)\n\tlocal v = visuals[id]\n\tif not v then\n\t\treturn\n\tend\n\tvisuals[id] = nil\n\tfor _, part in ipairs(v.parts) do\n\t\tif fade then\n\t\t\tTweenService:Create(part, TweenInfo.new(0.15), { Transparency = 1 }):Play()\n\t\t\tDebris:AddItem(part, 0.4)\n\t\telse\n\t\t\t-- let trails finish\n\t\t\tpart.Transparency = 1\n\t\t\tDebris:AddItem(part, 0.35)\n\t\tend\n\tend\nend\n\nlocal function makeVisual(p)\n\tlocal parts = {}\n\tlocal main\n\tlocal color = p.color or Color3.new(1, 1, 1)\n\tlocal kind = p.kind\n\tif kind == \"Bullet\" then\n\t\tif p.style == \"Beam\" then\n\t\t\tmain = block(Vector3.new(7, 1.3, 1.3), color, Enum.PartType.Cylinder)\n\t\t\tlocal glow = block(Vector3.new(8, 2.6, 2.6), color, Enum.PartType.Cylinder, 0.7)\n\t\t\ttable.insert(parts, glow)\n\t\t\ttrail(main, color, 1.6, 0.25)\n\t\t\tlocal l = Instance.new(\"PointLight\")\n\t\t\tl.Color = color\n\t\t\tl.Range = 14\n\t\t\tl.Brightness = 2\n\t\t\tl.Parent = main\n\t\t\tp.glow = glow\n\t\telseif p.style == \"Pellet\" then\n\t\t\tmain = ball(p.size * 0.9, color)\n\t\t\ttrail(main, color, 0.6, 0.12)\n\t\telse\n\t\t\tmain = ball(p.size, color)\n\t\t\tlocal core = ball(p.size * 0.55, Color3.new(1, 1, 1))\n\t\t\ttable.insert(parts, core)\n\t\t\tp.core = core\n\t\t\ttrail(main, color, p.size * 0.8, 0.18)\n\t\tend\n\telseif kind == \"Bomb\" then\n\t\tmain = ball(p.size, color)\n\t\tlocal ring = block(Vector3.new(0.2, p.size * 1.7, p.size * 1.7), Color3.new(1, 1, 1), Enum.PartType.Cylinder, 0.3)\n\t\ttable.insert(parts, ring)\n\t\tp.ring = ring\n\t\ttrail(main, color, p.size * 0.6, 0.35)\n\t\t-- landing marker telegraph\n\t\tif p.finish then\n\t\t\tlocal r = (p.radius or 8) * 2\n\t\t\tlocal marker = block(Vector3.new(0.15, r, r), Config.Match and color or color, Enum.PartType.Cylinder, 0.65)\n\t\t\tmarker.CFrame = CFrame.new(p.finish + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, 0, math.rad(90))\n\t\t\ttable.insert(parts, marker)\n\t\t\tp.marker = marker\n\t\tend\n\telseif kind == \"Seeker\" or kind == \"Orbit\" then\n\t\tmain = ball(p.size, color, 0.15)\n\t\tlocal core = ball(p.size * 0.5, Color3.new(1, 1, 1))\n\t\ttable.insert(parts, core)\n\t\tp.core = core\n\t\tlocal l = Instance.new(\"PointLight\")\n\t\tl.Color = color\n\t\tl.Range = 10\n\t\tl.Brightness = 1.5\n\t\tl.Parent = main\n\t\ttrail(main, color, p.size * 0.5, 0.4)\n\telseif kind == \"Mine\" then\n\t\tmain = block(Vector3.new(0.7, p.size, p.size), Color3.fromRGB(40, 40, 50), Enum.PartType.Cylinder)\n\t\tmain.Material = Enum.Material.Metal\n\t\tlocal light = ball(0.9, color)\n\t\ttable.insert(parts, light)\n\t\tp.light = light\n\t\tlocal r = (p.radius or 9) * 2\n\t\tlocal ring = block(Vector3.new(0.12, r, r), color, Enum.PartType.Cylinder, 1)\n\t\ttable.insert(parts, ring)\n\t\tp.triggerRing = ring\n\tend\n\ttable.insert(parts, 1, main)\n\treturn { p = p, main = main, parts = parts, prevPos = p.pos }\nend\n\nlocal function onProj(data)\n\tlocal p = table.clone(data)\n\tp.age = 0\n\tlocal targetModel = p.target\n\tp.target = nil\n\tp.targetModel = targetModel\n\tif p.kind == \"Bomb\" then\n\t\tp.radius = data.radius\n\tend\n\tlocal v = makeVisual(p)\n\tlocal elapsed = workspace:GetServerTimeNow() - (data.t0 or workspace:GetServerTimeNow())\n\tif elapsed > 0 then\n\t\tSim.fastForward(p, elapsed, aimPos(targetModel))\n\tend\n\tvisuals[p.id] = v\nend\n\nlocal function updateVisual(v, dt: number, tclock: number)\n\tlocal p = v.p\n\tlocal prev = p.pos\n\tSim.step(p, dt, aimPos(p.targetModel))\n\tif v.syncPos then\n\t\tlocal k = 1 - math.exp(-dt * 10)\n\t\tp.pos = p.pos:Lerp(v.syncPos, k)\n\t\tv.syncPos = v.syncPos + (p.pos - prev)\n\t\tif (v.syncPos - p.pos).Magnitude < 0.05 then\n\t\t\tv.syncPos = nil\n\t\tend\n\tend\n\tlocal vel = p.pos - prev\n\tlocal look = vel.Magnitude > 1e-4 and vel.Unit or (p.dir or Vector3.zAxis)\n\tlocal main = v.main\n\tif p.kind == \"Bullet\" and p.style == \"Beam\" then\n\t\tlocal cf = CFrame.lookAt(p.pos, p.pos + look) * CFrame.Angles(0, math.rad(90), 0)\n\t\tmain.CFrame = cf\n\t\tp.glow.CFrame = cf\n\telseif p.kind == \"Mine\" then\n\t\tmain.CFrame = CFrame.new(p.pos) * CFrame.Angles(0, 0, math.rad(90))\n\t\tp.light.CFrame = CFrame.new(p.pos + Vector3.new(0, 0.5, 0))\n\t\tlocal armed = p.landed and p.age >= (p.throwTime or 0) + (p.armTime or 0)\n\t\tlocal blink = armed and (math.floor(tclock * 6) % 2 == 0) or (math.floor(tclock * 2) % 2 == 0)\n\t\tp.light.Transparency = blink and 0 or 0.7\n\t\tp.triggerRing.CFrame = CFrame.new(Vector3.new(p.pos.X, p.floorRingY or (p.pos.Y - 0.8), p.pos.Z)) * CFrame.Angles(0, 0, math.rad(90))\n\t\tp.triggerRing.Transparency = armed and 0.75 or 1\n\telse\n\t\tmain.CFrame = CFrame.lookAt(p.pos, p.pos + look)\n\t\tif p.core then\n\t\t\tp.core.CFrame = main.CFrame\n\t\t\tif p.kind ~= \"Bullet\" then\n\t\t\t\tlocal s = p.size * (0.45 + 0.15 * math.sin(tclock * 12))\n\t\t\t\tp.core.Size = Vector3.one * s\n\t\t\tend\n\t\tend\n\t\tif p.ring then\n\t\t\tp.ring.CFrame = CFrame.new(p.pos) * CFrame.Angles(tclock * 6, tclock * 4, 0)\n\t\tend\n\tend\n\tif p.age > (p.life or 3) + 2 then\n\t\treturn false\n\tend\n\treturn true\nend\n\nlocal function onProjEnd(data)\n\tlocal v = visuals[data.id]\n\tlocal pos = data.pos\n\tif v then\n\t\tlocal color = v.p.color or Color3.new(1, 1, 1)\n\t\tif data.reason == \"wall\" then\n\t\t\tburstAt(pos, color, 8, 18, 0.6)\n\t\t\tflash(pos, color, 1.4, 0.12)\n\t\telseif data.reason == \"expire\" then\n\t\t\tremoveVisual(data.id, true)\n\t\t\treturn\n\t\tend\n\tend\n\tremoveVisual(data.id, false)\nend\n\nlocal function onProjSync(list)\n\tfor _, e in ipairs(list) do\n\t\tlocal v = visuals[e[1]]\n\t\tif v then\n\t\t\tv.syncPos = e[2]\n\t\t\tif e[3] then\n\t\t\t\tv.p.dir = e[3]\n\t\t\tend\n\t\tend\n\tend\nend\n\nlocal function clearAll()\n\tfor id in pairs(visuals) do\n\t\tremoveVisual(id, true)\n\tend\n\tfor model in pairs(charges) do\n\t\tFX.StopCharge(model)\n\tend\nend\nFX.ClearAll = clearAll\n\n----------------------------------------------------------------------------------------------\n-- Blasts / hits / misc\n----------------------------------------------------------------------------------------------\nlocal function onBlast(data)\n\tlocal pos, r, linger, color = data.pos, data.radius, data.linger, data.color or Color3.fromRGB(255, 140, 60)\n\tlocal sphere = ball(r * 0.6, color, 0.15)\n\tsphere.CFrame = CFrame.new(pos)\n\tlocal core = ball(r * 0.35, Color3.new(1, 1, 1), 0.05)\n\tcore.CFrame = CFrame.new(pos)\n\tlocal ring = block(Vector3.new(0.3, r * 1.2, r * 1.2), Color3.new(1, 1, 1), Enum.PartType.Cylinder, 0.2)\n\tring.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))\n\tlocal light = Instance.new(\"PointLight\")\n\tlight.Color = color\n\tlight.Range = r * 3.5\n\tlight.Brightness = 5\n\tlight.Parent = sphere\n\tTweenService:Create(sphere, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.one * r * 2 }):Play()\n\tTweenService:Create(core, TweenInfo.new(0.2), { Size = Vector3.one * r * 1.2, Transparency = 0.6 }):Play()\n\tTweenService:Create(ring, TweenInfo.new(0.35), { Size = Vector3.new(0.3, r * 3.2, r * 3.2), Transparency = 1 }):Play()\n\tTweenService:Create(light, TweenInfo.new(linger + 0.2), { Brightness = 0 }):Play()\n\tburstAt(pos, color, 30, 45, 1.6, 0.6)\n\tsmokeAt(pos, Color3.fromRGB(70, 60, 90), 10, r * 0.9)\n\ttask.spawn(function()\n\t\tlocal t0 = os.clock()\n\t\twhile os.clock() - t0 < linger do\n\t\t\tsphere.Transparency = 0.25 + math.random() * 0.2\n\t\t\ttask.wait(0.05)\n\t\tend\n\t\tTweenService:Create(sphere, TweenInfo.new(0.25), { Transparency = 1, Size = Vector3.one * r * 2.2 }):Play()\n\t\tTweenService:Create(core, TweenInfo.new(0.2), { Transparency = 1 }):Play()\n\t\ttask.wait(0.3)\n\t\tsphere:Destroy()\n\t\tcore:Destroy()\n\t\tring:Destroy()\n\tend)\n\tlocal d = distToLocal(pos)\n\tlocal amp = (data.big and 2.2 or 1.4) * math.clamp(1 - d / 70, 0.15, 1)\n\tFX.Shake(amp, 0.35)\n\tSound.Play(\"Explosion\", { volume = data.big and 1.2 or 0.9, pitch = data.big and 0.8 or 1 })\nend\n\nlocal function onHit(data)\n\tlocal victim = data.victim\n\tlocal color = Color3.fromRGB(255, 230, 120)\n\tburstAt(data.pos, color, data.heavy and 26 or 14, data.heavy and 40 or 28, data.heavy and 1.4 or 0.9)\n\tflash(data.pos, Color3.new(1, 1, 1), data.heavy and 3 or 1.8, 0.12)\n\tif HUD then\n\t\tHUD.ShowHit(victim, data.pos, data.amount, data.combo, data.heavy)\n\tend\n\tif RobotAnim then\n\t\tRobotAnim.Flinch(victim)\n\tend\n\tif victim == localModel() then\n\t\tFX.Shake(data.heavy and 2.6 or 0.9, data.heavy and 0.45 or 0.2)\n\t\tif HUD then\n\t\t\tHUD.DamageVignette(data.heavy)\n\t\tend\n\telseif data.attacker == localModel() and data.heavy then\n\t\tFX.Shake(1.0, 0.2)\n\tend\n\tSound.Play(data.heavy and \"HeavyHit\" or \"Hit\")\nend\n\nlocal WEAPON_ATT = { Gun = \"GunTip\", Bomb = \"BombTip\", Pod = \"PodTip\" }\nlocal function onFire(data)\n\tlocal model = data.model\n\tif not model or not model.Parent then\n\t\treturn\n\tend\n\tlocal att = model:FindFirstChild(WEAPON_ATT[data.weapon] or \"GunTip\", true)\n\tlocal robot = Config.RobotById[model:GetAttribute(\"RobotId\") or \"Bolt\"]\n\tlocal loadout = Config.GetLoadout(robot.Id)\n\tlocal color = data.weapon == \"Gun\" and loadout.Gun.Color or (data.weapon == \"Bomb\" and loadout.Bomb.Color or loadout.Pod.Color)\n\tif att and att:IsA(\"Attachment\") then\n\t\tflash(att.WorldPosition, color, data.weapon == \"Gun\" and 1.8 or 2.4, 0.1)\n\tend\n\tif RobotAnim then\n\t\tRobotAnim.OnFire(model, data.weapon)\n\tend\n\tif model == localModel() and Battle then\n\t\tBattle.OnLocalFire(data)\n\tend\n\tif data.weapon == \"Gun\" then\n\t\tSound.Play(data.gunType == \"Spread\" and \"Shotgun\" or (data.gunType == \"Charge\" and \"Laser\" or \"Blaster\"))\n\telseif data.weapon == \"Bomb\" then\n\t\tSound.Play(\"BombThrow\")\n\telse\n\t\tSound.Play(\"Pod\")\n\tend\nend\n\nfunction FX.StopCharge(model)\n\tlocal ch = charges[model]\n\tif ch then\n\t\tcharges[model] = nil\n\t\tch.orb:Destroy()\n\t\tif ch.sound then\n\t\t\tch.sound:Destroy()\n\t\tend\n\tend\nend\n\nlocal function onCharge(data)\n\tlocal model = data.model\n\tif not model then\n\t\treturn\n\tend\n\tif data.on then\n\t\tFX.StopCharge(model)\n\t\tlocal robot = Config.RobotById[model:GetAttribute(\"RobotId\") or \"Lancer\"]\n\t\tlocal color = Config.GetLoadout(robot.Id).Gun.Color\n\t\tlocal orb = ball(0.4, color, 0.1)\n\t\tlocal l = Instance.new(\"PointLight\")\n\t\tl.Color = color\n\t\tl.Range = 8\n\t\tl.Brightness = 2\n\t\tl.Parent = orb\n\t\tcharges[model] = { orb = orb, t0 = os.clock(), dur = data.chargeTime or 0.8, color = color, sound = Sound.Play(\"Charge\", { vary = 0 }) }\n\telse\n\t\tFX.StopCharge(model)\n\tend\nend\n\nlocal function trailFor(model: Model)\n\tlocal t = trails[model]\n\tif t and t.Parent then\n\t\treturn t\n\tend\n\tlocal torso = model:FindFirstChild(\"Torso\")\n\tif not torso then\n\t\treturn nil\n\tend\n\tlocal robot = Config.RobotById[model:GetAttribute(\"RobotId\") or \"Bolt\"]\n\tlocal a0 = Instance.new(\"Attachment\")\n\ta0.Name = \"RCTrailTop\"\n\ta0.Position = Vector3.new(0, 1.2, 0.5)\n\ta0.Parent = torso\n\tlocal a1 = Instance.new(\"Attachment\")\n\ta1.Name = \"RCTrailBottom\"\n\ta1.Position = Vector3.new(0, -2.5, 0.5)\n\ta1.Parent = torso\n\tlocal tr = Instance.new(\"Trail\")\n\ttr.Attachment0 = a0\n\ttr.Attachment1 = a1\n\ttr.Lifetime = 0.22\n\ttr.Color = ColorSequence.new(robot.Neon)\n\ttr.LightEmission = 1\n\ttr.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })\n\ttr.Enabled = false\n\ttr.Parent = torso\n\ttrails[model] = tr\n\treturn tr\nend\n\nlocal function onDash(data)\n\tlocal model = data.model\n\tif not model or not model.Parent then\n\t\treturn\n\tend\n\tlocal tr = trailFor(model)\n\tif tr then\n\t\ttr.Enabled = true\n\t\ttask.delay(0.32, function()\n\t\t\tif tr.Parent then\n\t\t\t\ttr.Enabled = false\n\t\t\tend\n\t\tend)\n\tend\n\tlocal root = model:FindFirstChild(\"HumanoidRootPart\")\n\tif root and not data.air then\n\t\tsmokeAt(root.Position - Vector3.new(0, 3.5, 0), Color3.fromRGB(150, 160, 200), 6, 2.5)\n\tend\n\tSound.Play(\"Dash\")\nend\n\nlocal handlers = {\n\tProj = onProj,\n\tProjEnd = onProjEnd,\n\tProjSync = onProjSync,\n\tClearProj = clearAll,\n\tBlast = onBlast,\n\tHit = onHit,\n\tFire = onFire,\n\tCharge = onCharge,\n\tDash = onDash,\n\tDown = function(data)\n\t\tif HUD then\n\t\t\tHUD.TagText(data.model, \"DOWN\", Color3.fromRGB(255, 90, 170))\n\t\tend\n\t\tSound.Play(\"Down\")\n\t\tif data.model == localModel() then\n\t\t\tFX.Shake(2.2, 0.4)\n\t\tend\n\tend,\n\tRebirth = function(data)\n\t\tif HUD then\n\t\t\tHUD.TagText(data.model, \"REBIRTH\", Color3.fromRGB(255, 255, 255))\n\t\tend\n\tend,\n\tPit = function(data)\n\t\tif HUD then\n\t\t\tHUD.TagText(data.model, \"PIT  -\" .. tostring(data.amount), Color3.fromRGB(255, 80, 80))\n\t\tend\n\t\tSound.Play(\"HeavyHit\")\n\tend,\n}\n\nfunction FX.Init(deps)\n\tHUD = deps.HUD\n\tRobotAnim = deps.RobotAnim\n\tBattle = deps.Battle\n\tRC.Remotes.FX.OnClientEvent:Connect(function(kind, data)\n\t\tlocal h = handlers[kind]\n\t\tif h then\n\t\t\tlocal ok, err = pcall(h, data)\n\t\t\tif not ok then\n\t\t\t\twarn(\"[RoboClash FX] \" .. tostring(kind) .. \": \" .. tostring(err))\n\t\t\tend\n\t\tend\n\tend)\n\tRunService.RenderStepped:Connect(function(dt)\n\t\tlocal tclock = os.clock()\n\t\tfor id, v in pairs(visuals) do\n\t\t\tlocal ok, keep = pcall(updateVisual, v, dt, tclock)\n\t\t\tif not ok or not keep then\n\t\t\t\tremoveVisual(id, true)\n\t\t\tend\n\t\tend\n\t\tfor model, ch in pairs(charges) do\n\t\t\tlocal att = model.Parent and model:FindFirstChild(\"GunTip\", true)\n\t\t\tif not att then\n\t\t\t\tFX.StopCharge(model)\n\t\t\telse\n\t\t\t\tlocal k = math.clamp((tclock - ch.t0) / ch.dur, 0, 1)\n\t\t\t\tlocal full = k >= 1\n\t\t\t\tlocal s = 0.4 + 1.6 * k + (full and 0.25 * math.sin(tclock * 30) or 0)\n\t\t\t\tch.orb.Size = Vector3.one * s\n\t\t\t\tch.orb.CFrame = CFrame.new((att :: Attachment).WorldPosition)\n\t\t\t\tch.orb.Color = full and Color3.new(1, 1, 1) or ch.color\n\t\t\tend\n\t\tend\n\tend)\nend\n\nfunction FX.Folder()\n\treturn folder\nend\n\nreturn FX\n","afterFullFileContent":"-- Client visuals for server-authoritative combat: projectiles (simulated locally with the shared\n-- ProjectileSim, corrected by ProjSync/ProjEnd), blasts, sparks, muzzle flashes, charge glow,\n-- dash trails, and screen shake. All instances here are local-only.\nlocal Debris = game:GetService(\"Debris\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal TweenService = game:GetService(\"TweenService\")\n\nlocal RC = ReplicatedStorage:WaitForChild(\"RoboClash\")\nlocal Config = require(RC.Config)\nlocal Sim = require(RC.Shared.ProjectileSim)\nlocal State = require(script.Parent.State)\nlocal Sound = require(script.Parent.Sound)\n\nlocal FX = {}\nlocal HUD, RobotAnim, Battle -- injected\n\nlocal folder = Instance.new(\"Folder\")\nfolder.Name = \"RoboClashFX\"\nfolder.Parent = workspace\n\nlocal visuals = {}\nlocal charges = {}\nlocal trails = {}\nlocal shakeAmp, shakeUntil, shakeDur = 0, 0, 0.001\n\nlocal SPARK = \"rbxasset://textures/particles/sparkles_main.dds\"\nlocal SMOKE = \"rbxasset://textures/particles/smoke_main.dds\"\nlocal FIRE = \"rbxasset://textures/particles/fire_main.dds\"\n\nlocal function ball(size: number, color: Color3, transparency: number?): Part\n\tlocal p = Instance.new(\"Part\")\n\tp.Shape = Enum.PartType.Ball\n\tp.Size = Vector3.one * size\n\tp.Color = color\n\tp.Material = Enum.Material.Neon\n\tp.Transparency = transparency or 0\n\tp.Anchored = true\n\tp.CanCollide = false\n\tp.CanQuery = false\n\tp.CanTouch = false\n\tp.CastShadow = false\n\tp.Parent = folder\n\treturn p\nend\n\nlocal function block(size: Vector3, color: Color3, shape: Enum.PartType?, transparency: number?): Part\n\tlocal p = Instance.new(\"Part\")\n\tp.Size = size\n\tif shape then\n\t\tp.Shape = shape\n\tend\n\tp.Color = color\n\tp.Material = Enum.Material.Neon\n\tp.Transparency = transparency or 0\n\tp.Anchored = true\n\tp.CanCollide = false\n\tp.CanQuery = false\n\tp.CanTouch = false\n\tp.CastShadow = false\n\tp.Parent = folder\n\treturn p\nend\n\nlocal function trail(part: BasePart, color: Color3, width: number, lifetime: number)\n\tlocal a0 = Instance.new(\"Attachment\")\n\ta0.Position = Vector3.new(0, width / 2, 0)\n\ta0.Parent = part\n\tlocal a1 = Instance.new(\"Attachment\")\n\ta1.Position = Vector3.new(0, -width / 2, 0)\n\ta1.Parent = part\n\tlocal t = Instance.new(\"Trail\")\n\tt.Attachment0 = a0\n\tt.Attachment1 = a1\n\tt.Lifetime = lifetime\n\tt.Color = ColorSequence.new(color)\n\tt.LightEmission = 1\n\tt.LightInfluence = 0\n\tt.FaceCamera = true\n\tt.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })\n\tt.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.1) })\n\tt.Parent = part\n\treturn t\nend\n\nlocal function emitter(parent: Instance, props)\n\tlocal e = Instance.new(\"ParticleEmitter\")\n\te.Enabled = false\n\te.LightEmission = 1\n\te.LightInfluence = 0\n\tfor k, v in pairs(props) do\n\t\t(e :: any)[k] = v\n\tend\n\te.Parent = parent\n\treturn e\nend\n\nlocal function burstAt(pos: Vector3, color: Color3, count: number, speed: number, size: number, life: number?)\n\tlocal holder = Instance.new(\"Part\")\n\tholder.Anchored = true\n\tholder.CanCollide = false\n\tholder.CanQuery = false\n\tholder.CanTouch = false\n\tholder.Transparency = 1\n\tholder.Size = Vector3.one * 0.2\n\tholder.CFrame = CFrame.new(pos)\n\tholder.Parent = folder\n\tlocal e = emitter(holder, {\n\t\tTexture = SPARK,\n\t\tColor = ColorSequence.new(Color3.new(1, 1, 1), color),\n\t\tSize = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) }),\n\t\tSpeed = NumberRange.new(speed * 0.5, speed),\n\t\tSpreadAngle = Vector2.new(180, 180),\n\t\tLifetime = NumberRange.new((life or 0.35) * 0.6, life or 0.35),\n\t\tDrag = 4,\n\t\tRate = 0,\n\t})\n\te:Emit(count)\n\tDebris:AddItem(holder, 1.5)\nend\n\nlocal function smokeAt(pos: Vector3, color: Color3, count: number, size: number)\n\tlocal holder = Instance.new(\"Part\")\n\tholder.Anchored = true\n\tholder.CanCollide = false\n\tholder.CanQuery = false\n\tholder.CanTouch = false\n\tholder.Transparency = 1\n\tholder.Size = Vector3.one * 0.2\n\tholder.CFrame = CFrame.new(pos)\n\tholder.Parent = folder\n\tlocal e = emitter(holder, {\n\t\tTexture = SMOKE,\n\t\tLightEmission = 0.3,\n\t\tColor = ColorSequence.new(color),\n\t\tTransparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) }),\n\t\tSize = NumberSequence.new({ NumberSequenceKeypoint.new(0, size * 0.5), NumberSequenceKeypoint.new(1, size) }),\n\t\tSpeed = NumberRange.new(2, 6),\n\t\tSpreadAngle = Vector2.new(180, 30),\n\t\tLifetime = NumberRange.new(0.5, 0.9),\n\t\tRate = 0,\n\t})\n\te:Emit(count)\n\tDebris:AddItem(holder, 2)\nend\n\nlocal function flash(pos: Vector3, color: Color3, size: number, time: number)\n\tlocal b = ball(size, color, 0.1)\n\tb.CFrame = CFrame.new(pos)\n\tlocal l = Instance.new(\"PointLight\")\n\tl.Color = color\n\tl.Range = size * 4\n\tl.Brightness = 3\n\tl.Parent = b\n\tTweenService:Create(b, TweenInfo.new(time), { Transparency = 1, Size = Vector3.one * size * 1.6 }):Play()\n\tTweenService:Create(l, TweenInfo.new(time), { Brightness = 0 }):Play()\n\tDebris:AddItem(b, time + 0.05)\nend\nFX.Flash = flash\n\nfunction FX.Shake(amp: number, dur: number)\n\tlocal t = os.clock()\n\tlocal remaining = math.max(0, shakeUntil - t) / shakeDur * shakeAmp\n\tif amp >= remaining then\n\t\tshakeAmp = amp\n\t\tshakeDur = dur\n\t\tshakeUntil = t + dur\n\tend\nend\n\nfunction FX.ShakeCFrame(): CFrame\n\tlocal t = os.clock()\n\tif t >= shakeUntil then\n\t\treturn CFrame.identity\n\tend\n\tlocal k = (shakeUntil - t) / shakeDur\n\tlocal a = shakeAmp * k\n\treturn CFrame.new((math.random() - 0.5) * a, (math.random() - 0.5) * a, (math.random() - 0.5) * a * 0.5)\n\t\t* CFrame.Angles(0, 0, (math.random() - 0.5) * a * 0.02)\nend\n\nlocal function localModel(): Model?\n\treturn State.localModel\nend\n\nlocal function distToLocal(pos: Vector3): number\n\tlocal m = localModel()\n\tlocal root = m and m:FindFirstChild(\"HumanoidRootPart\")\n\tif root then\n\t\treturn (root.Position - pos).Magnitude\n\tend\n\treturn 999\nend\n\nlocal function aimPos(model: Model?): Vector3?\n\tif not model or not model.Parent then\n\t\treturn nil\n\tend\n\tlocal root = model:FindFirstChild(\"HumanoidRootPart\") :: BasePart?\n\tif not root then\n\t\treturn nil\n\tend\n\treturn root.Position + Vector3.new(0, model:GetAttribute(\"AimY\") or 0, 0)\nend\n\n----------------------------------------------------------------------------------------------\n-- Projectiles\n----------------------------------------------------------------------------------------------\nlocal function removeVisual(id: number, fade: boolean?)\n\tlocal v = visuals[id]\n\tif not v then\n\t\treturn\n\tend\n\tvisuals[id] = nil\n\tfor _, part in ipairs(v.parts) do\n\t\tif fade then\n\t\t\tTweenService:Create(part, TweenInfo.new(0.15), { Transparency = 1 }):Play()\n\t\t\tDebris:AddItem(part, 0.4)\n\t\telse\n\t\t\t-- let trails finish\n\t\t\tpart.Transparency = 1\n\t\t\tDebris:AddItem(part, 0.35)\n\t\tend\n\tend\nend\n\nlocal function makeVisual(p)\n\tlocal parts = {}\n\tlocal main\n\tlocal color = p.color or Color3.new(1, 1, 1)\n\tlocal kind = p.kind\n\tif kind == \"Bullet\" then\n\t\tif p.style == \"Beam\" then\n\t\t\tmain = block(Vector3.new(7, 1.3, 1.3), color, Enum.PartType.Cylinder)\n\t\t\tlocal glow = block(Vector3.new(8, 2.6, 2.6), color, Enum.PartType.Cylinder, 0.7)\n\t\t\ttable.insert(parts, glow)\n\t\t\ttrail(main, color, 1.6, 0.25)\n\t\t\tlocal l = Instance.new(\"PointLight\")\n\t\t\tl.Color = color\n\t\t\tl.Range = 14\n\t\t\tl.Brightness = 2\n\t\t\tl.Parent = main\n\t\t\tp.glow = glow\n\t\telseif p.style == \"Pellet\" then\n\t\t\tmain = ball(p.size * 0.9, color)\n\t\t\ttrail(main, color, 0.6, 0.12)\n\t\telse\n\t\t\tmain = ball(p.size, color)\n\t\t\tlocal core = ball(p.size * 0.55, Color3.new(1, 1, 1))\n\t\t\ttable.insert(parts, core)\n\t\t\tp.core = core\n\t\t\ttrail(main, color, p.size * 0.8, 0.18)\n\t\tend\n\telseif kind == \"Bomb\" then\n\t\tmain = ball(p.size, color)\n\t\tlocal ring = block(Vector3.new(0.2, p.size * 1.7, p.size * 1.7), Color3.new(1, 1, 1), Enum.PartType.Cylinder, 0.3)\n\t\ttable.insert(parts, ring)\n\t\tp.ring = ring\n\t\ttrail(main, color, p.size * 0.6, 0.35)\n\t\t-- landing marker telegraph\n\t\tif p.finish then\n\t\t\tlocal r = (p.radius or 8) * 2\n\t\t\tlocal marker = block(Vector3.new(0.15, r, r), Config.Match and color or color, Enum.PartType.Cylinder, 0.65)\n\t\t\tmarker.CFrame = CFrame.new(p.finish + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, 0, math.rad(90))\n\t\t\ttable.insert(parts, marker)\n\t\t\tp.marker = marker\n\t\tend\n\telseif kind == \"Seeker\" or kind == \"Orbit\" then\n\t\tmain = ball(p.size, color, 0.15)\n\t\tlocal core = ball(p.size * 0.5, Color3.new(1, 1, 1))\n\t\ttable.insert(parts, core)\n\t\tp.core = core\n\t\tlocal l = Instance.new(\"PointLight\")\n\t\tl.Color = color\n\t\tl.Range = 10\n\t\tl.Brightness = 1.5\n\t\tl.Parent = main\n\t\ttrail(main, color, p.size * 0.5, 0.4)\n\telseif kind == \"Mine\" then\n\t\tmain = block(Vector3.new(0.7, p.size, p.size), Color3.fromRGB(40, 40, 50), Enum.PartType.Cylinder)\n\t\tmain.Material = Enum.Material.Metal\n\t\tlocal light = ball(0.9, color)\n\t\ttable.insert(parts, light)\n\t\tp.light = light\n\t\tlocal r = (p.radius or 9) * 2\n\t\tlocal ring = block(Vector3.new(0.12, r, r), color, Enum.PartType.Cylinder, 1)\n\t\ttable.insert(parts, ring)\n\t\tp.triggerRing = ring\n\tend\n\ttable.insert(parts, 1, main)\n\treturn { p = p, main = main, parts = parts, prevPos = p.pos }\nend\n\nlocal function onProj(data)\n\tlocal p = table.clone(data)\n\tp.age = 0\n\tlocal targetModel = p.target\n\tp.target = nil\n\tp.targetModel = targetModel\n\tif p.kind == \"Bomb\" then\n\t\tp.radius = data.radius\n\tend\n\tlocal v = makeVisual(p)\n\tlocal elapsed = workspace:GetServerTimeNow() - (data.t0 or workspace:GetServerTimeNow())\n\tif elapsed > 0 then\n\t\tSim.fastForward(p, elapsed, aimPos(targetModel))\n\tend\n\tvisuals[p.id] = v\nend\n\nlocal function updateVisual(v, dt: number, tclock: number)\n\tlocal p = v.p\n\tlocal prev = p.pos\n\tSim.step(p, dt, aimPos(p.targetModel))\n\tif v.syncPos then\n\t\tlocal k = 1 - math.exp(-dt * 10)\n\t\tp.pos = p.pos:Lerp(v.syncPos, k)\n\t\tv.syncPos = v.syncPos + (p.pos - prev)\n\t\tif (v.syncPos - p.pos).Magnitude < 0.05 then\n\t\t\tv.syncPos = nil\n\t\tend\n\tend\n\tlocal vel = p.pos - prev\n\tlocal look = vel.Magnitude > 1e-4 and vel.Unit or (p.dir or Vector3.zAxis)\n\tlocal main = v.main\n\tif p.kind == \"Bullet\" and p.style == \"Beam\" then\n\t\tlocal cf = CFrame.lookAt(p.pos, p.pos + look) * CFrame.Angles(0, math.rad(90), 0)\n\t\tmain.CFrame = cf\n\t\tp.glow.CFrame = cf\n\telseif p.kind == \"Mine\" then\n\t\tmain.CFrame = CFrame.new(p.pos) * CFrame.Angles(0, 0, math.rad(90))\n\t\tp.light.CFrame = CFrame.new(p.pos + Vector3.new(0, 0.5, 0))\n\t\tlocal armed = p.landed and p.age >= (p.throwTime or 0) + (p.armTime or 0)\n\t\tlocal blink = armed and (math.floor(tclock * 6) % 2 == 0) or (math.floor(tclock * 2) % 2 == 0)\n\t\tp.light.Transparency = blink and 0 or 0.7\n\t\tp.triggerRing.CFrame = CFrame.new(Vector3.new(p.pos.X, p.floorRingY or (p.pos.Y - 0.8), p.pos.Z)) * CFrame.Angles(0, 0, math.rad(90))\n\t\tp.triggerRing.Transparency = armed and 0.75 or 1\n\telse\n\t\tmain.CFrame = CFrame.lookAt(p.pos, p.pos + look)\n\t\tif p.core then\n\t\t\tp.core.CFrame = main.CFrame\n\t\t\tif p.kind ~= \"Bullet\" then\n\t\t\t\tlocal s = p.size * (0.45 + 0.15 * math.sin(tclock * 12))\n\t\t\t\tp.core.Size = Vector3.one * s\n\t\t\tend\n\t\tend\n\t\tif p.ring then\n\t\t\tp.ring.CFrame = CFrame.new(p.pos) * CFrame.Angles(tclock * 6, tclock * 4, 0)\n\t\tend\n\tend\n\tif p.age > (p.life or 3) + 2 then\n\t\treturn false\n\tend\n\treturn true\nend\n\nlocal function onProjEnd(data)\n\tlocal v = visuals[data.id]\n\tlocal pos = data.pos\n\tif v then\n\t\tlocal color = v.p.color or Color3.new(1, 1, 1)\n\t\tif data.reason == \"wall\" then\n\t\t\tburstAt(pos, color, 8, 18, 0.6)\n\t\t\tflash(pos, color, 1.4, 0.12)\n\t\telseif data.reason == \"expire\" then\n\t\t\tremoveVisual(data.id, true)\n\t\t\treturn\n\t\tend\n\tend\n\tremoveVisual(data.id, false)\nend\n\nlocal function onProjSync(list)\n\tfor _, e in ipairs(list) do\n\t\tlocal v = visuals[e[1]]\n\t\tif v then\n\t\t\tv.syncPos = e[2]\n\t\t\tif e[3] then\n\t\t\t\tv.p.dir = e[3]\n\t\t\tend\n\t\tend\n\tend\nend\n\nlocal function clearAll()\n\tfor id in pairs(visuals) do\n\t\tremoveVisual(id, true)\n\tend\n\tfor model in pairs(charges) do\n\t\tFX.StopCharge(model)\n\tend\nend\nFX.ClearAll = clearAll\n\n----------------------------------------------------------------------------------------------\n-- Blasts / hits / misc\n----------------------------------------------------------------------------------------------\nlocal function onBlast(data)\n\tlocal pos, r, linger, color = data.pos, data.radius, data.linger, data.color or Color3.fromRGB(255, 140, 60)\n\tlocal sphere = ball(r * 0.6, color, 0.15)\n\tsphere.CFrame = CFrame.new(pos)\n\tlocal core = ball(r * 0.35, Color3.new(1, 1, 1), 0.05)\n\tcore.CFrame = CFrame.new(pos)\n\tlocal ring = block(Vector3.new(0.3, r * 1.2, r * 1.2), Color3.new(1, 1, 1), Enum.PartType.Cylinder, 0.2)\n\tring.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))\n\tlocal light = Instance.new(\"PointLight\")\n\tlight.Color = color\n\tlight.Range = r * 3.5\n\tlight.Brightness = 5\n\tlight.Parent = sphere\n\tTweenService:Create(sphere, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.one * r * 2 }):Play()\n\tTweenService:Create(core, TweenInfo.new(0.2), { Size = Vector3.one * r * 1.2, Transparency = 0.6 }):Play()\n\tTweenService:Create(ring, TweenInfo.new(0.35), { Size = Vector3.new(0.3, r * 3.2, r * 3.2), Transparency = 1 }):Play()\n\tTweenService:Create(light, TweenInfo.new(linger + 0.2), { Brightness = 0 }):Play()\n\tburstAt(pos, color, 30, 45, 1.6, 0.6)\n\tsmokeAt(pos, Color3.fromRGB(70, 60, 90), 10, r * 0.9)\n\ttask.spawn(function()\n\t\tlocal t0 = os.clock()\n\t\twhile os.clock() - t0 < linger do\n\t\t\tsphere.Transparency = 0.25 + math.random() * 0.2\n\t\t\ttask.wait(0.05)\n\t\tend\n\t\tTweenService:Create(sphere, TweenInfo.new(0.25), { Transparency = 1, Size = Vector3.one * r * 2.2 }):Play()\n\t\tTweenService:Create(core, TweenInfo.new(0.2), { Transparency = 1 }):Play()\n\t\ttask.wait(0.3)\n\t\tsphere:Destroy()\n\t\tcore:Destroy()\n\t\tring:Destroy()\n\tend)\n\tlocal d = distToLocal(pos)\n\tlocal amp = (data.big and 2.2 or 1.4) * math.clamp(1 - d / 70, 0.15, 1)\n\tFX.Shake(amp, 0.35)\n\tSound.Play(\"Explosion\", { volume = data.big and 1.2 or 0.9, pitch = data.big and 0.8 or 1 })\nend\n\nlocal function onHit(data)\n\tlocal victim = data.victim\n\tlocal color = Color3.fromRGB(255, 230, 120)\n\tburstAt(data.pos, color, data.heavy and 26 or 14, data.heavy and 40 or 28, data.heavy and 1.4 or 0.9)\n\tflash(data.pos, Color3.new(1, 1, 1), data.heavy and 3 or 1.8, 0.12)\n\tif HUD then\n\t\tHUD.ShowHit(victim, data.pos, data.amount, data.combo, data.heavy)\n\tend\n\tif RobotAnim then\n\t\tRobotAnim.Flinch(victim)\n\tend\n\tif victim == localModel() then\n\t\tFX.Shake(data.heavy and 2.6 or 0.9, data.heavy and 0.45 or 0.2)\n\t\tif HUD then\n\t\t\tHUD.DamageVignette(data.heavy)\n\t\tend\n\telseif data.attacker == localModel() and data.heavy then\n\t\tFX.Shake(1.0, 0.2)\n\tend\n\tSound.Play(data.heavy and \"HeavyHit\" or \"Hit\")\nend\n\nlocal WEAPON_ATT = { Gun = \"GunTip\", Bomb = \"BombTip\", Pod = \"PodTip\" }\nlocal function onFire(data)\n\tlocal model = data.model\n\tif not model or not model.Parent then\n\t\treturn\n\tend\n\tlocal att = model:FindFirstChild(WEAPON_ATT[data.weapon] or \"GunTip\", true)\n\tlocal robot = Config.RobotById[model:GetAttribute(\"RobotId\") or \"Bolt\"]\n\tlocal loadout = Config.GetLoadout(robot.Id)\n\tlocal color = data.weapon == \"Gun\" and loadout.Gun.Color or (data.weapon == \"Bomb\" and loadout.Bomb.Color or loadout.Pod.Color)\n\tif att and att:IsA(\"Attachment\") then\n\t\tflash(att.WorldPosition, color, data.weapon == \"Gun\" and 1.8 or 2.4, 0.1)\n\tend\n\tif RobotAnim then\n\t\tRobotAnim.OnFire(model, data.weapon)\n\tend\n\tif model == localModel() and Battle then\n\t\tBattle.OnLocalFire(data)\n\tend\n\tif data.weapon == \"Gun\" then\n\t\tSound.Play(data.gunType == \"Spread\" and \"Shotgun\" or (data.gunType == \"Charge\" and \"Laser\" or \"Blaster\"))\n\telseif data.weapon == \"Bomb\" then\n\t\tSound.Play(\"BombThrow\")\n\telse\n\t\tSound.Play(\"Pod\")\n\tend\nend\n\nfunction FX.StopCharge(model)\n\tlocal ch = charges[model]\n\tif ch then\n\t\tcharges[model] = nil\n\t\tch.orb:Destroy()\n\t\tif ch.sound then\n\t\t\tch.sound:Destroy()\n\t\tend\n\tend\nend\n\nlocal function onCharge(data)\n\tlocal model = data.model\n\tif not model then\n\t\treturn\n\tend\n\tif data.on then\n\t\tFX.StopCharge(model)\n\t\tlocal robot = Config.RobotById[model:GetAttribute(\"RobotId\") or \"Lancer\"]\n\t\tlocal color = Config.GetLoadout(robot.Id).Gun.Color\n\t\tlocal orb = ball(0.4, color, 0.1)\n\t\tlocal l = Instance.new(\"PointLight\")\n\t\tl.Color = color\n\t\tl.Range = 8\n\t\tl.Brightness = 2\n\t\tl.Parent = orb\n\t\tcharges[model] = { orb = orb, t0 = os.clock(), dur = data.chargeTime or 0.8, color = color, sound = Sound.Play(\"Charge\", { vary = 0 }) }\n\telse\n\t\tFX.StopCharge(model)\n\tend\nend\n\nlocal function trailFor(model: Model)\n\tlocal t = trails[model]\n\tif t and t.Parent then\n\t\treturn t\n\tend\n\tlocal torso = model:FindFirstChild(\"Torso\")\n\tif not torso then\n\t\treturn nil\n\tend\n\tlocal robot = Config.RobotById[model:GetAttribute(\"RobotId\") or \"Bolt\"]\n\tlocal a0 = Instance.new(\"Attachment\")\n\ta0.Name = \"RCTrailTop\"\n\ta0.Position = Vector3.new(0, 1.2, 0.5)\n\ta0.Parent = torso\n\tlocal a1 = Instance.new(\"Attachment\")\n\ta1.Name = \"RCTrailBottom\"\n\ta1.Position = Vector3.new(0, -2.5, 0.5)\n\ta1.Parent = torso\n\tlocal tr = Instance.new(\"Trail\")\n\ttr.Attachment0 = a0\n\ttr.Attachment1 = a1\n\ttr.Lifetime = 0.22\n\ttr.Color = ColorSequence.new(robot.Neon)\n\ttr.LightEmission = 1\n\ttr.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })\n\ttr.Enabled = false\n\ttr.Parent = torso\n\ttrails[model] = tr\n\treturn tr\nend\n\nlocal function onDash(data)\n\tlocal model = data.model\n\tif not model or not model.Parent then\n\t\treturn\n\tend\n\tlocal tr = trailFor(model)\n\tif tr then\n\t\ttr.Enabled = true\n\t\ttask.delay(0.32, function()\n\t\t\tif tr.Parent then\n\t\t\t\ttr.Enabled = false\n\t\t\tend\n\t\tend)\n\tend\n\tlocal root = model:FindFirstChild(\"HumanoidRootPart\")\n\tif root and not data.air then\n\t\tsmokeAt(root.Position - Vector3.new(0, 3.5, 0), Color3.fromRGB(150, 160, 200), 6, 2.5)\n\tend\n\tSound.Play(\"Dash\")\nend\n\nlocal handlers = {\n\tProj = onProj,\n\tProjEnd = onProjEnd,\n\tProjSync = onProjSync,\n\tClearProj = clearAll,\n\tBlast = onBlast,\n\tHit = onHit,\n\tFire = onFire,\n\tCharge = onCharge,\n\tDash = onDash,\n\tDown = function(data)\n\t\tif HUD then\n\t\t\tHUD.TagText(data.model, \"DOWN\", Color3.fromRGB(255, 90, 170))\n\t\tend\n\t\tSound.Play(\"Down\")\n\t\tif data.model == localModel() then\n\t\t\tFX.Shake(2.2, 0.4)\n\t\tend\n\tend,\n\tRebirth = function(data)\n\t\tif HUD then\n\t\t\tHUD.TagText(data.model, \"REBIRTH\", Color3.fromRGB(255, 255, 255))\n\t\tend\n\tend,\n\tPit = function(data)\n\t\tif HUD then\n\t\t\tHUD.TagText(data.model, \"PIT  -\" .. tostring(data.amount), Color3.fromRGB(255, 80, 80))\n\t\tend\n\t\tSound.Play(\"HeavyHit\")\n\tend,\n}\n\nfunction FX.Init(deps)\n\tHUD = deps.HUD\n\tRobotAnim = deps.RobotAnim\n\tBattle = deps.Battle\n\tRC.Remotes.FX.OnClientEvent:Connect(function(kind, data)\n\t\tlocal h = handlers[kind]\n\t\tif h then\n\t\t\tlocal ok, err = pcall(h, data)\n\t\t\tif not ok then\n\t\t\t\twarn(\"[RoboClash FX] \" .. tostring(kind) .. \": \" .. tostring(err))\n\t\t\tend\n\t\tend\n\tend)\n\tRunService.RenderStepped:Connect(function(dt)\n\t\tlocal tclock = os.clock()\n\t\tfor id, v in pairs(visuals) do\n\t\t\tlocal ok, keep = pcall(updateVisual, v, dt, tclock)\n\t\t\tif not ok or not keep then\n\t\t\t\tremoveVisual(id, true)\n\t\t\tend\n\t\tend\n\t\tfor model, ch in pairs(charges) do\n\t\t\tlocal att = model.Parent and model:FindFirstChild(\"GunTip\", true)\n\t\t\tif not att then\n\t\t\t\tFX.StopCharge(model)\n\t\t\telse\n\t\t\t\tlocal k = math.clamp((tclock - ch.t0) / ch.dur, 0, 1)\n\t\t\t\tlocal full = k >= 1\n\t\t\t\tlocal s = 0.4 + 1.6 * k + (full and 0.25 * math.sin(tclock * 30) or 0)\n\t\t\t\tch.orb.Size = Vector3.one * s\n\t\t\t\tch.orb.CFrame = CFrame.new((att :: Attachment).WorldPosition)\n\t\t\t\tch.orb.Color = full and Color3.new(1, 1, 1) or ch.color\n\t\t\tend\n\t\tend\n\tend)\nend\n\nfunction FX.Folder()\n\treturn folder\nend\n\nreturn FX\n","message":"The file /Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/FX.luau has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"toolu_01RAhKejRz1cVonCXs8MLni6","startedAtMs":"1791074249537","completedAtMs":"1791074250775"},"model_call_id":"f6f75537-51d9-46fb-a6c9-81f06ac674d8-54-e109","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791074250781}
{"type":"tool_call","subtype":"started","call_id":"toolu_01DRXyV66hZLbm3YexLobQFE","tool_call":{"editToolCall":{"args":{"path":"/Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/FX.luau","streamContent":"\t\t\tlocal marker = block(Vector3.new(0.15, r, r), color, Enum.PartType.Cylinder, 0.65)"}},"hookAdditionalContexts":[],"toolCallId":"toolu_01DRXyV66hZLbm3YexLobQFE","startedAtMs":"1791074250717"},"model_call_id":"f6f75537-51d9-46fb-a6c9-81f06ac674d8-54-e109","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791074252443}
{"type":"tool_call","subtype":"completed","call_id":"toolu_01DRXyV66hZLbm3YexLobQFE","tool_call":{"editToolCall":{"args":{"path":"/Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/FX.luau","streamContent":"\t\t\tlocal marker = block(Vector3.new(0.15, r, r), color, Enum.PartType.Cylinder, 0.65)"},"result":{"success":{"path":"/Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/FX.luau","linesAdded":1,"linesRemoved":1,"diffString":"--- a//Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/FX.luau\n+++ b//Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/FX.luau\n@@ -260,7 +260,7 @@\n \t\t-- landing marker telegraph\n \t\tif p.finish then\n \t\t\tlocal r = (p.radius or 8) * 2\n-\t\t\tlocal marker = block(Vector3.new(0.15, r, r), Config.Match and color or color, Enum.PartType.Cylinder, 0.65)\n+\t\t\tlocal marker = block(Vector3.new(0.15, r, r), color, Enum.PartType.Cylinder, 0.65)\n \t\t\tmarker.CFrame = CFrame.new(p.finish + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, 0, math.rad(90))\n \t\t\ttable.insert(parts, marker)\n \t\t\tp.marker = marker","beforeFullFileContent":"-- Client visuals for server-authoritative combat: projectiles (simulated locally with the shared\n-- ProjectileSim, corrected by ProjSync/ProjEnd), blasts, sparks, muzzle flashes, charge glow,\n-- dash trails, and screen shake. All instances here are local-only.\nlocal Debris = game:GetService(\"Debris\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal TweenService = game:GetService(\"TweenService\")\n\nlocal RC = ReplicatedStorage:WaitForChild(\"RoboClash\")\nlocal Config = require(RC.Config)\nlocal Sim = require(RC.Shared.ProjectileSim)\nlocal State = require(script.Parent.State)\nlocal Sound = require(script.Parent.Sound)\n\nlocal FX = {}\nlocal HUD, RobotAnim, Battle -- injected\n\nlocal folder = Instance.new(\"Folder\")\nfolder.Name = \"RoboClashFX\"\nfolder.Parent = workspace\n\nlocal visuals = {}\nlocal charges = {}\nlocal trails = {}\nlocal shakeAmp, shakeUntil, shakeDur = 0, 0, 0.001\n\nlocal SPARK = \"rbxasset://textures/particles/sparkles_main.dds\"\nlocal SMOKE = \"rbxasset://textures/particles/smoke_main.dds\"\nlocal FIRE = \"rbxasset://textures/particles/fire_main.dds\"\n\nlocal function ball(size: number, color: Color3, transparency: number?): Part\n\tlocal p = Instance.new(\"Part\")\n\tp.Shape = Enum.PartType.Ball\n\tp.Size = Vector3.one * size\n\tp.Color = color\n\tp.Material = Enum.Material.Neon\n\tp.Transparency = transparency or 0\n\tp.Anchored = true\n\tp.CanCollide = false\n\tp.CanQuery = false\n\tp.CanTouch = false\n\tp.CastShadow = false\n\tp.Parent = folder\n\treturn p\nend\n\nlocal function block(size: Vector3, color: Color3, shape: Enum.PartType?, transparency: number?): Part\n\tlocal p = Instance.new(\"Part\")\n\tp.Size = size\n\tif shape then\n\t\tp.Shape = shape\n\tend\n\tp.Color = color\n\tp.Material = Enum.Material.Neon\n\tp.Transparency = transparency or 0\n\tp.Anchored = true\n\tp.CanCollide = false\n\tp.CanQuery = false\n\tp.CanTouch = false\n\tp.CastShadow = false\n\tp.Parent = folder\n\treturn p\nend\n\nlocal function trail(part: BasePart, color: Color3, width: number, lifetime: number)\n\tlocal a0 = Instance.new(\"Attachment\")\n\ta0.Position = Vector3.new(0, width / 2, 0)\n\ta0.Parent = part\n\tlocal a1 = Instance.new(\"Attachment\")\n\ta1.Position = Vector3.new(0, -width / 2, 0)\n\ta1.Parent = part\n\tlocal t = Instance.new(\"Trail\")\n\tt.Attachment0 = a0\n\tt.Attachment1 = a1\n\tt.Lifetime = lifetime\n\tt.Color = ColorSequence.new(color)\n\tt.LightEmission = 1\n\tt.LightInfluence = 0\n\tt.FaceCamera = true\n\tt.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })\n\tt.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.1) })\n\tt.Parent = part\n\treturn t\nend\n\nlocal function emitter(parent: Instance, props)\n\tlocal e = Instance.new(\"ParticleEmitter\")\n\te.Enabled = false\n\te.LightEmission = 1\n\te.LightInfluence = 0\n\tfor k, v in pairs(props) do\n\t\t(e :: any)[k] = v\n\tend\n\te.Parent = parent\n\treturn e\nend\n\nlocal function burstAt(pos: Vector3, color: Color3, count: number, speed: number, size: number, life: number?)\n\tlocal holder = Instance.new(\"Part\")\n\tholder.Anchored = true\n\tholder.CanCollide = false\n\tholder.CanQuery = false\n\tholder.CanTouch = false\n\tholder.Transparency = 1\n\tholder.Size = Vector3.one * 0.2\n\tholder.CFrame = CFrame.new(pos)\n\tholder.Parent = folder\n\tlocal e = emitter(holder, {\n\t\tTexture = SPARK,\n\t\tColor = ColorSequence.new(Color3.new(1, 1, 1), color),\n\t\tSize = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) }),\n\t\tSpeed = NumberRange.new(speed * 0.5, speed),\n\t\tSpreadAngle = Vector2.new(180, 180),\n\t\tLifetime = NumberRange.new((life or 0.35) * 0.6, life or 0.35),\n\t\tDrag = 4,\n\t\tRate = 0,\n\t})\n\te:Emit(count)\n\tDebris:AddItem(holder, 1.5)\nend\n\nlocal function smokeAt(pos: Vector3, color: Color3, count: number, size: number)\n\tlocal holder = Instance.new(\"Part\")\n\tholder.Anchored = true\n\tholder.CanCollide = false\n\tholder.CanQuery = false\n\tholder.CanTouch = false\n\tholder.Transparency = 1\n\tholder.Size = Vector3.one * 0.2\n\tholder.CFrame = CFrame.new(pos)\n\tholder.Parent = folder\n\tlocal e = emitter(holder, {\n\t\tTexture = SMOKE,\n\t\tLightEmission = 0.3,\n\t\tColor = ColorSequence.new(color),\n\t\tTransparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) }),\n\t\tSize = NumberSequence.new({ NumberSequenceKeypoint.new(0, size * 0.5), NumberSequenceKeypoint.new(1, size) }),\n\t\tSpeed = NumberRange.new(2, 6),\n\t\tSpreadAngle = Vector2.new(180, 30),\n\t\tLifetime = NumberRange.new(0.5, 0.9),\n\t\tRate = 0,\n\t})\n\te:Emit(count)\n\tDebris:AddItem(holder, 2)\nend\n\nlocal function flash(pos: Vector3, color: Color3, size: number, time: number)\n\tlocal b = ball(size, color, 0.1)\n\tb.CFrame = CFrame.new(pos)\n\tlocal l = Instance.new(\"PointLight\")\n\tl.Color = color\n\tl.Range = size * 4\n\tl.Brightness = 3\n\tl.Parent = b\n\tTweenService:Create(b, TweenInfo.new(time), { Transparency = 1, Size = Vector3.one * size * 1.6 }):Play()\n\tTweenService:Create(l, TweenInfo.new(time), { Brightness = 0 }):Play()\n\tDebris:AddItem(b, time + 0.05)\nend\nFX.Flash = flash\n\nfunction FX.Shake(amp: number, dur: number)\n\tlocal t = os.clock()\n\tlocal remaining = math.max(0, shakeUntil - t) / shakeDur * shakeAmp\n\tif amp >= remaining then\n\t\tshakeAmp = amp\n\t\tshakeDur = dur\n\t\tshakeUntil = t + dur\n\tend\nend\n\nfunction FX.ShakeCFrame(): CFrame\n\tlocal t = os.clock()\n\tif t >= shakeUntil then\n\t\treturn CFrame.identity\n\tend\n\tlocal k = (shakeUntil - t) / shakeDur\n\tlocal a = shakeAmp * k\n\treturn CFrame.new((math.random() - 0.5) * a, (math.random() - 0.5) * a, (math.random() - 0.5) * a * 0.5)\n\t\t* CFrame.Angles(0, 0, (math.random() - 0.5) * a * 0.02)\nend\n\nlocal function localModel(): Model?\n\treturn State.localModel\nend\n\nlocal function distToLocal(pos: Vector3): number\n\tlocal m = localModel()\n\tlocal root = m and m:FindFirstChild(\"HumanoidRootPart\")\n\tif root then\n\t\treturn (root.Position - pos).Magnitude\n\tend\n\treturn 999\nend\n\nlocal function aimPos(model: Model?): Vector3?\n\tif not model or not model.Parent then\n\t\treturn nil\n\tend\n\tlocal root = model:FindFirstChild(\"HumanoidRootPart\") :: BasePart?\n\tif not root then\n\t\treturn nil\n\tend\n\treturn root.Position + Vector3.new(0, model:GetAttribute(\"AimY\") or 0, 0)\nend\n\n----------------------------------------------------------------------------------------------\n-- Projectiles\n----------------------------------------------------------------------------------------------\nlocal function removeVisual(id: number, fade: boolean?)\n\tlocal v = visuals[id]\n\tif not v then\n\t\treturn\n\tend\n\tvisuals[id] = nil\n\tfor _, part in ipairs(v.parts) do\n\t\tif fade then\n\t\t\tTweenService:Create(part, TweenInfo.new(0.15), { Transparency = 1 }):Play()\n\t\t\tDebris:AddItem(part, 0.4)\n\t\telse\n\t\t\t-- let trails finish\n\t\t\tpart.Transparency = 1\n\t\t\tDebris:AddItem(part, 0.35)\n\t\tend\n\tend\nend\n\nlocal function makeVisual(p)\n\tlocal parts = {}\n\tlocal main\n\tlocal color = p.color or Color3.new(1, 1, 1)\n\tlocal kind = p.kind\n\tif kind == \"Bullet\" then\n\t\tif p.style == \"Beam\" then\n\t\t\tmain = block(Vector3.new(7, 1.3, 1.3), color, Enum.PartType.Cylinder)\n\t\t\tlocal glow = block(Vector3.new(8, 2.6, 2.6), color, Enum.PartType.Cylinder, 0.7)\n\t\t\ttable.insert(parts, glow)\n\t\t\ttrail(main, color, 1.6, 0.25)\n\t\t\tlocal l = Instance.new(\"PointLight\")\n\t\t\tl.Color = color\n\t\t\tl.Range = 14\n\t\t\tl.Brightness = 2\n\t\t\tl.Parent = main\n\t\t\tp.glow = glow\n\t\telseif p.style == \"Pellet\" then\n\t\t\tmain = ball(p.size * 0.9, color)\n\t\t\ttrail(main, color, 0.6, 0.12)\n\t\telse\n\t\t\tmain = ball(p.size, color)\n\t\t\tlocal core = ball(p.size * 0.55, Color3.new(1, 1, 1))\n\t\t\ttable.insert(parts, core)\n\t\t\tp.core = core\n\t\t\ttrail(main, color, p.size * 0.8, 0.18)\n\t\tend\n\telseif kind == \"Bomb\" then\n\t\tmain = ball(p.size, color)\n\t\tlocal ring = block(Vector3.new(0.2, p.size * 1.7, p.size * 1.7), Color3.new(1, 1, 1), Enum.PartType.Cylinder, 0.3)\n\t\ttable.insert(parts, ring)\n\t\tp.ring = ring\n\t\ttrail(main, color, p.size * 0.6, 0.35)\n\t\t-- landing marker telegraph\n\t\tif p.finish then\n\t\t\tlocal r = (p.radius or 8) * 2\n\t\t\tlocal marker = block(Vector3.new(0.15, r, r), Config.Match and color or color, Enum.PartType.Cylinder, 0.65)\n\t\t\tmarker.CFrame = CFrame.new(p.finish + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, 0, math.rad(90))\n\t\t\ttable.insert(parts, marker)\n\t\t\tp.marker = marker\n\t\tend\n\telseif kind == \"Seeker\" or kind == \"Orbit\" then\n\t\tmain = ball(p.size, color, 0.15)\n\t\tlocal core = ball(p.size * 0.5, Color3.new(1, 1, 1))\n\t\ttable.insert(parts, core)\n\t\tp.core = core\n\t\tlocal l = Instance.new(\"PointLight\")\n\t\tl.Color = color\n\t\tl.Range = 10\n\t\tl.Brightness = 1.5\n\t\tl.Parent = main\n\t\ttrail(main, color, p.size * 0.5, 0.4)\n\telseif kind == \"Mine\" then\n\t\tmain = block(Vector3.new(0.7, p.size, p.size), Color3.fromRGB(40, 40, 50), Enum.PartType.Cylinder)\n\t\tmain.Material = Enum.Material.Metal\n\t\tlocal light = ball(0.9, color)\n\t\ttable.insert(parts, light)\n\t\tp.light = light\n\t\tlocal r = (p.radius or 9) * 2\n\t\tlocal ring = block(Vector3.new(0.12, r, r), color, Enum.PartType.Cylinder, 1)\n\t\ttable.insert(parts, ring)\n\t\tp.triggerRing = ring\n\tend\n\ttable.insert(parts, 1, main)\n\treturn { p = p, main = main, parts = parts, prevPos = p.pos }\nend\n\nlocal function onProj(data)\n\tlocal p = table.clone(data)\n\tp.age = 0\n\tlocal targetModel = p.target\n\tp.target = nil\n\tp.targetModel = targetModel\n\tif p.kind == \"Bomb\" then\n\t\tp.radius = data.radius\n\tend\n\tlocal v = makeVisual(p)\n\tlocal elapsed = workspace:GetServerTimeNow() - (data.t0 or workspace:GetServerTimeNow())\n\tif elapsed > 0 then\n\t\tSim.fastForward(p, elapsed, aimPos(targetModel))\n\tend\n\tvisuals[p.id] = v\nend\n\nlocal function updateVisual(v, dt: number, tclock: number)\n\tlocal p = v.p\n\tlocal prev = p.pos\n\tSim.step(p, dt, aimPos(p.targetModel))\n\tif v.syncPos then\n\t\tlocal k = 1 - math.exp(-dt * 10)\n\t\tp.pos = p.pos:Lerp(v.syncPos, k)\n\t\tv.syncPos = v.syncPos + (p.pos - prev)\n\t\tif (v.syncPos - p.pos).Magnitude < 0.05 then\n\t\t\tv.syncPos = nil\n\t\tend\n\tend\n\tlocal vel = p.pos - prev\n\tlocal look = vel.Magnitude > 1e-4 and vel.Unit or (p.dir or Vector3.zAxis)\n\tlocal main = v.main\n\tif p.kind == \"Bullet\" and p.style == \"Beam\" then\n\t\tlocal cf = CFrame.lookAt(p.pos, p.pos + look) * CFrame.Angles(0, math.rad(90), 0)\n\t\tmain.CFrame = cf\n\t\tp.glow.CFrame = cf\n\telseif p.kind == \"Mine\" then\n\t\tmain.CFrame = CFrame.new(p.pos) * CFrame.Angles(0, 0, math.rad(90))\n\t\tp.light.CFrame = CFrame.new(p.pos + Vector3.new(0, 0.5, 0))\n\t\tlocal armed = p.landed and p.age >= (p.throwTime or 0) + (p.armTime or 0)\n\t\tlocal blink = armed and (math.floor(tclock * 6) % 2 == 0) or (math.floor(tclock * 2) % 2 == 0)\n\t\tp.light.Transparency = blink and 0 or 0.7\n\t\tp.triggerRing.CFrame = CFrame.new(Vector3.new(p.pos.X, p.floorRingY or (p.pos.Y - 0.8), p.pos.Z)) * CFrame.Angles(0, 0, math.rad(90))\n\t\tp.triggerRing.Transparency = armed and 0.75 or 1\n\telse\n\t\tmain.CFrame = CFrame.lookAt(p.pos, p.pos + look)\n\t\tif p.core then\n\t\t\tp.core.CFrame = main.CFrame\n\t\t\tif p.kind ~= \"Bullet\" then\n\t\t\t\tlocal s = p.size * (0.45 + 0.15 * math.sin(tclock * 12))\n\t\t\t\tp.core.Size = Vector3.one * s\n\t\t\tend\n\t\tend\n\t\tif p.ring then\n\t\t\tp.ring.CFrame = CFrame.new(p.pos) * CFrame.Angles(tclock * 6, tclock * 4, 0)\n\t\tend\n\tend\n\tif p.age > (p.life or 3) + 2 then\n\t\treturn false\n\tend\n\treturn true\nend\n\nlocal function onProjEnd(data)\n\tlocal v = visuals[data.id]\n\tlocal pos = data.pos\n\tif v then\n\t\tlocal color = v.p.color or Color3.new(1, 1, 1)\n\t\tif data.reason == \"wall\" then\n\t\t\tburstAt(pos, color, 8, 18, 0.6)\n\t\t\tflash(pos, color, 1.4, 0.12)\n\t\telseif data.reason == \"expire\" then\n\t\t\tremoveVisual(data.id, true)\n\t\t\treturn\n\t\tend\n\tend\n\tremoveVisual(data.id, false)\nend\n\nlocal function onProjSync(list)\n\tfor _, e in ipairs(list) do\n\t\tlocal v = visuals[e[1]]\n\t\tif v then\n\t\t\tv.syncPos = e[2]\n\t\t\tif e[3] then\n\t\t\t\tv.p.dir = e[3]\n\t\t\tend\n\t\tend\n\tend\nend\n\nlocal function clearAll()\n\tfor id in pairs(visuals) do\n\t\tremoveVisual(id, true)\n\tend\n\tfor model in pairs(charges) do\n\t\tFX.StopCharge(model)\n\tend\nend\nFX.ClearAll = clearAll\n\n----------------------------------------------------------------------------------------------\n-- Blasts / hits / misc\n----------------------------------------------------------------------------------------------\nlocal function onBlast(data)\n\tlocal pos, r, linger, color = data.pos, data.radius, data.linger, data.color or Color3.fromRGB(255, 140, 60)\n\tlocal sphere = ball(r * 0.6, color, 0.15)\n\tsphere.CFrame = CFrame.new(pos)\n\tlocal core = ball(r * 0.35, Color3.new(1, 1, 1), 0.05)\n\tcore.CFrame = CFrame.new(pos)\n\tlocal ring = block(Vector3.new(0.3, r * 1.2, r * 1.2), Color3.new(1, 1, 1), Enum.PartType.Cylinder, 0.2)\n\tring.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))\n\tlocal light = Instance.new(\"PointLight\")\n\tlight.Color = color\n\tlight.Range = r * 3.5\n\tlight.Brightness = 5\n\tlight.Parent = sphere\n\tTweenService:Create(sphere, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.one * r * 2 }):Play()\n\tTweenService:Create(core, TweenInfo.new(0.2), { Size = Vector3.one * r * 1.2, Transparency = 0.6 }):Play()\n\tTweenService:Create(ring, TweenInfo.new(0.35), { Size = Vector3.new(0.3, r * 3.2, r * 3.2), Transparency = 1 }):Play()\n\tTweenService:Create(light, TweenInfo.new(linger + 0.2), { Brightness = 0 }):Play()\n\tburstAt(pos, color, 30, 45, 1.6, 0.6)\n\tsmokeAt(pos, Color3.fromRGB(70, 60, 90), 10, r * 0.9)\n\ttask.spawn(function()\n\t\tlocal t0 = os.clock()\n\t\twhile os.clock() - t0 < linger do\n\t\t\tsphere.Transparency = 0.25 + math.random() * 0.2\n\t\t\ttask.wait(0.05)\n\t\tend\n\t\tTweenService:Create(sphere, TweenInfo.new(0.25), { Transparency = 1, Size = Vector3.one * r * 2.2 }):Play()\n\t\tTweenService:Create(core, TweenInfo.new(0.2), { Transparency = 1 }):Play()\n\t\ttask.wait(0.3)\n\t\tsphere:Destroy()\n\t\tcore:Destroy()\n\t\tring:Destroy()\n\tend)\n\tlocal d = distToLocal(pos)\n\tlocal amp = (data.big and 2.2 or 1.4) * math.clamp(1 - d / 70, 0.15, 1)\n\tFX.Shake(amp, 0.35)\n\tSound.Play(\"Explosion\", { volume = data.big and 1.2 or 0.9, pitch = data.big and 0.8 or 1 })\nend\n\nlocal function onHit(data)\n\tlocal victim = data.victim\n\tlocal color = Color3.fromRGB(255, 230, 120)\n\tburstAt(data.pos, color, data.heavy and 26 or 14, data.heavy and 40 or 28, data.heavy and 1.4 or 0.9)\n\tflash(data.pos, Color3.new(1, 1, 1), data.heavy and 3 or 1.8, 0.12)\n\tif HUD then\n\t\tHUD.ShowHit(victim, data.pos, data.amount, data.combo, data.heavy)\n\tend\n\tif RobotAnim then\n\t\tRobotAnim.Flinch(victim)\n\tend\n\tif victim == localModel() then\n\t\tFX.Shake(data.heavy and 2.6 or 0.9, data.heavy and 0.45 or 0.2)\n\t\tif HUD then\n\t\t\tHUD.DamageVignette(data.heavy)\n\t\tend\n\telseif data.attacker == localModel() and data.heavy then\n\t\tFX.Shake(1.0, 0.2)\n\tend\n\tSound.Play(data.heavy and \"HeavyHit\" or \"Hit\")\nend\n\nlocal WEAPON_ATT = { Gun = \"GunTip\", Bomb = \"BombTip\", Pod = \"PodTip\" }\nlocal function onFire(data)\n\tlocal model = data.model\n\tif not model or not model.Parent then\n\t\treturn\n\tend\n\tlocal att = model:FindFirstChild(WEAPON_ATT[data.weapon] or \"GunTip\", true)\n\tlocal robot = Config.RobotById[model:GetAttribute(\"RobotId\") or \"Bolt\"]\n\tlocal loadout = Config.GetLoadout(robot.Id)\n\tlocal color = data.weapon == \"Gun\" and loadout.Gun.Color or (data.weapon == \"Bomb\" and loadout.Bomb.Color or loadout.Pod.Color)\n\tif att and att:IsA(\"Attachment\") then\n\t\tflash(att.WorldPosition, color, data.weapon == \"Gun\" and 1.8 or 2.4, 0.1)\n\tend\n\tif RobotAnim then\n\t\tRobotAnim.OnFire(model, data.weapon)\n\tend\n\tif model == localModel() and Battle then\n\t\tBattle.OnLocalFire(data)\n\tend\n\tif data.weapon == \"Gun\" then\n\t\tSound.Play(data.gunType == \"Spread\" and \"Shotgun\" or (data.gunType == \"Charge\" and \"Laser\" or \"Blaster\"))\n\telseif data.weapon == \"Bomb\" then\n\t\tSound.Play(\"BombThrow\")\n\telse\n\t\tSound.Play(\"Pod\")\n\tend\nend\n\nfunction FX.StopCharge(model)\n\tlocal ch = charges[model]\n\tif ch then\n\t\tcharges[model] = nil\n\t\tch.orb:Destroy()\n\t\tif ch.sound then\n\t\t\tch.sound:Destroy()\n\t\tend\n\tend\nend\n\nlocal function onCharge(data)\n\tlocal model = data.model\n\tif not model then\n\t\treturn\n\tend\n\tif data.on then\n\t\tFX.StopCharge(model)\n\t\tlocal robot = Config.RobotById[model:GetAttribute(\"RobotId\") or \"Lancer\"]\n\t\tlocal color = Config.GetLoadout(robot.Id).Gun.Color\n\t\tlocal orb = ball(0.4, color, 0.1)\n\t\tlocal l = Instance.new(\"PointLight\")\n\t\tl.Color = color\n\t\tl.Range = 8\n\t\tl.Brightness = 2\n\t\tl.Parent = orb\n\t\tcharges[model] = { orb = orb, t0 = os.clock(), dur = data.chargeTime or 0.8, color = color, sound = Sound.Play(\"Charge\", { vary = 0 }) }\n\telse\n\t\tFX.StopCharge(model)\n\tend\nend\n\nlocal function trailFor(model: Model)\n\tlocal t = trails[model]\n\tif t and t.Parent then\n\t\treturn t\n\tend\n\tlocal torso = model:FindFirstChild(\"Torso\")\n\tif not torso then\n\t\treturn nil\n\tend\n\tlocal robot = Config.RobotById[model:GetAttribute(\"RobotId\") or \"Bolt\"]\n\tlocal a0 = Instance.new(\"Attachment\")\n\ta0.Name = \"RCTrailTop\"\n\ta0.Position = Vector3.new(0, 1.2, 0.5)\n\ta0.Parent = torso\n\tlocal a1 = Instance.new(\"Attachment\")\n\ta1.Name = \"RCTrailBottom\"\n\ta1.Position = Vector3.new(0, -2.5, 0.5)\n\ta1.Parent = torso\n\tlocal tr = Instance.new(\"Trail\")\n\ttr.Attachment0 = a0\n\ttr.Attachment1 = a1\n\ttr.Lifetime = 0.22\n\ttr.Color = ColorSequence.new(robot.Neon)\n\ttr.LightEmission = 1\n\ttr.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })\n\ttr.Enabled = false\n\ttr.Parent = torso\n\ttrails[model] = tr\n\treturn tr\nend\n\nlocal function onDash(data)\n\tlocal model = data.model\n\tif not model or not model.Parent then\n\t\treturn\n\tend\n\tlocal tr = trailFor(model)\n\tif tr then\n\t\ttr.Enabled = true\n\t\ttask.delay(0.32, function()\n\t\t\tif tr.Parent then\n\t\t\t\ttr.Enabled = false\n\t\t\tend\n\t\tend)\n\tend\n\tlocal root = model:FindFirstChild(\"HumanoidRootPart\")\n\tif root and not data.air then\n\t\tsmokeAt(root.Position - Vector3.new(0, 3.5, 0), Color3.fromRGB(150, 160, 200), 6, 2.5)\n\tend\n\tSound.Play(\"Dash\")\nend\n\nlocal handlers = {\n\tProj = onProj,\n\tProjEnd = onProjEnd,\n\tProjSync = onProjSync,\n\tClearProj = clearAll,\n\tBlast = onBlast,\n\tHit = onHit,\n\tFire = onFire,\n\tCharge = onCharge,\n\tDash = onDash,\n\tDown = function(data)\n\t\tif HUD then\n\t\t\tHUD.TagText(data.model, \"DOWN\", Color3.fromRGB(255, 90, 170))\n\t\tend\n\t\tSound.Play(\"Down\")\n\t\tif data.model == localModel() then\n\t\t\tFX.Shake(2.2, 0.4)\n\t\tend\n\tend,\n\tRebirth = function(data)\n\t\tif HUD then\n\t\t\tHUD.TagText(data.model, \"REBIRTH\", Color3.fromRGB(255, 255, 255))\n\t\tend\n\tend,\n\tPit = function(data)\n\t\tif HUD then\n\t\t\tHUD.TagText(data.model, \"PIT  -\" .. tostring(data.amount), Color3.fromRGB(255, 80, 80))\n\t\tend\n\t\tSound.Play(\"HeavyHit\")\n\tend,\n}\n\nfunction FX.Init(deps)\n\tHUD = deps.HUD\n\tRobotAnim = deps.RobotAnim\n\tBattle = deps.Battle\n\tRC.Remotes.FX.OnClientEvent:Connect(function(kind, data)\n\t\tlocal h = handlers[kind]\n\t\tif h then\n\t\t\tlocal ok, err = pcall(h, data)\n\t\t\tif not ok then\n\t\t\t\twarn(\"[RoboClash FX] \" .. tostring(kind) .. \": \" .. tostring(err))\n\t\t\tend\n\t\tend\n\tend)\n\tRunService.RenderStepped:Connect(function(dt)\n\t\tlocal tclock = os.clock()\n\t\tfor id, v in pairs(visuals) do\n\t\t\tlocal ok, keep = pcall(updateVisual, v, dt, tclock)\n\t\t\tif not ok or not keep then\n\t\t\t\tremoveVisual(id, true)\n\t\t\tend\n\t\tend\n\t\tfor model, ch in pairs(charges) do\n\t\t\tlocal att = model.Parent and model:FindFirstChild(\"GunTip\", true)\n\t\t\tif not att then\n\t\t\t\tFX.StopCharge(model)\n\t\t\telse\n\t\t\t\tlocal k = math.clamp((tclock - ch.t0) / ch.dur, 0, 1)\n\t\t\t\tlocal full = k >= 1\n\t\t\t\tlocal s = 0.4 + 1.6 * k + (full and 0.25 * math.sin(tclock * 30) or 0)\n\t\t\t\tch.orb.Size = Vector3.one * s\n\t\t\t\tch.orb.CFrame = CFrame.new((att :: Attachment).WorldPosition)\n\t\t\t\tch.orb.Color = full and Color3.new(1, 1, 1) or ch.color\n\t\t\tend\n\t\tend\n\tend)\nend\n\nfunction FX.Folder()\n\treturn folder\nend\n\nreturn FX\n","afterFullFileContent":"-- Client visuals for server-authoritative combat: projectiles (simulated locally with the shared\n-- ProjectileSim, corrected by ProjSync/ProjEnd), blasts, sparks, muzzle flashes, charge glow,\n-- dash trails, and screen shake. All instances here are local-only.\nlocal Debris = game:GetService(\"Debris\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal TweenService = game:GetService(\"TweenService\")\n\nlocal RC = ReplicatedStorage:WaitForChild(\"RoboClash\")\nlocal Config = require(RC.Config)\nlocal Sim = require(RC.Shared.ProjectileSim)\nlocal State = require(script.Parent.State)\nlocal Sound = require(script.Parent.Sound)\n\nlocal FX = {}\nlocal HUD, RobotAnim, Battle -- injected\n\nlocal folder = Instance.new(\"Folder\")\nfolder.Name = \"RoboClashFX\"\nfolder.Parent = workspace\n\nlocal visuals = {}\nlocal charges = {}\nlocal trails = {}\nlocal shakeAmp, shakeUntil, shakeDur = 0, 0, 0.001\n\nlocal SPARK = \"rbxasset://textures/particles/sparkles_main.dds\"\nlocal SMOKE = \"rbxasset://textures/particles/smoke_main.dds\"\nlocal FIRE = \"rbxasset://textures/particles/fire_main.dds\"\n\nlocal function ball(size: number, color: Color3, transparency: number?): Part\n\tlocal p = Instance.new(\"Part\")\n\tp.Shape = Enum.PartType.Ball\n\tp.Size = Vector3.one * size\n\tp.Color = color\n\tp.Material = Enum.Material.Neon\n\tp.Transparency = transparency or 0\n\tp.Anchored = true\n\tp.CanCollide = false\n\tp.CanQuery = false\n\tp.CanTouch = false\n\tp.CastShadow = false\n\tp.Parent = folder\n\treturn p\nend\n\nlocal function block(size: Vector3, color: Color3, shape: Enum.PartType?, transparency: number?): Part\n\tlocal p = Instance.new(\"Part\")\n\tp.Size = size\n\tif shape then\n\t\tp.Shape = shape\n\tend\n\tp.Color = color\n\tp.Material = Enum.Material.Neon\n\tp.Transparency = transparency or 0\n\tp.Anchored = true\n\tp.CanCollide = false\n\tp.CanQuery = false\n\tp.CanTouch = false\n\tp.CastShadow = false\n\tp.Parent = folder\n\treturn p\nend\n\nlocal function trail(part: BasePart, color: Color3, width: number, lifetime: number)\n\tlocal a0 = Instance.new(\"Attachment\")\n\ta0.Position = Vector3.new(0, width / 2, 0)\n\ta0.Parent = part\n\tlocal a1 = Instance.new(\"Attachment\")\n\ta1.Position = Vector3.new(0, -width / 2, 0)\n\ta1.Parent = part\n\tlocal t = Instance.new(\"Trail\")\n\tt.Attachment0 = a0\n\tt.Attachment1 = a1\n\tt.Lifetime = lifetime\n\tt.Color = ColorSequence.new(color)\n\tt.LightEmission = 1\n\tt.LightInfluence = 0\n\tt.FaceCamera = true\n\tt.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })\n\tt.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.1) })\n\tt.Parent = part\n\treturn t\nend\n\nlocal function emitter(parent: Instance, props)\n\tlocal e = Instance.new(\"ParticleEmitter\")\n\te.Enabled = false\n\te.LightEmission = 1\n\te.LightInfluence = 0\n\tfor k, v in pairs(props) do\n\t\t(e :: any)[k] = v\n\tend\n\te.Parent = parent\n\treturn e\nend\n\nlocal function burstAt(pos: Vector3, color: Color3, count: number, speed: number, size: number, life: number?)\n\tlocal holder = Instance.new(\"Part\")\n\tholder.Anchored = true\n\tholder.CanCollide = false\n\tholder.CanQuery = false\n\tholder.CanTouch = false\n\tholder.Transparency = 1\n\tholder.Size = Vector3.one * 0.2\n\tholder.CFrame = CFrame.new(pos)\n\tholder.Parent = folder\n\tlocal e = emitter(holder, {\n\t\tTexture = SPARK,\n\t\tColor = ColorSequence.new(Color3.new(1, 1, 1), color),\n\t\tSize = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) }),\n\t\tSpeed = NumberRange.new(speed * 0.5, speed),\n\t\tSpreadAngle = Vector2.new(180, 180),\n\t\tLifetime = NumberRange.new((life or 0.35) * 0.6, life or 0.35),\n\t\tDrag = 4,\n\t\tRate = 0,\n\t})\n\te:Emit(count)\n\tDebris:AddItem(holder, 1.5)\nend\n\nlocal function smokeAt(pos: Vector3, color: Color3, count: number, size: number)\n\tlocal holder = Instance.new(\"Part\")\n\tholder.Anchored = true\n\tholder.CanCollide = false\n\tholder.CanQuery = false\n\tholder.CanTouch = false\n\tholder.Transparency = 1\n\tholder.Size = Vector3.one * 0.2\n\tholder.CFrame = CFrame.new(pos)\n\tholder.Parent = folder\n\tlocal e = emitter(holder, {\n\t\tTexture = SMOKE,\n\t\tLightEmission = 0.3,\n\t\tColor = ColorSequence.new(color),\n\t\tTransparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) }),\n\t\tSize = NumberSequence.new({ NumberSequenceKeypoint.new(0, size * 0.5), NumberSequenceKeypoint.new(1, size) }),\n\t\tSpeed = NumberRange.new(2, 6),\n\t\tSpreadAngle = Vector2.new(180, 30),\n\t\tLifetime = NumberRange.new(0.5, 0.9),\n\t\tRate = 0,\n\t})\n\te:Emit(count)\n\tDebris:AddItem(holder, 2)\nend\n\nlocal function flash(pos: Vector3, color: Color3, size: number, time: number)\n\tlocal b = ball(size, color, 0.1)\n\tb.CFrame = CFrame.new(pos)\n\tlocal l = Instance.new(\"PointLight\")\n\tl.Color = color\n\tl.Range = size * 4\n\tl.Brightness = 3\n\tl.Parent = b\n\tTweenService:Create(b, TweenInfo.new(time), { Transparency = 1, Size = Vector3.one * size * 1.6 }):Play()\n\tTweenService:Create(l, TweenInfo.new(time), { Brightness = 0 }):Play()\n\tDebris:AddItem(b, time + 0.05)\nend\nFX.Flash = flash\n\nfunction FX.Shake(amp: number, dur: number)\n\tlocal t = os.clock()\n\tlocal remaining = math.max(0, shakeUntil - t) / shakeDur * shakeAmp\n\tif amp >= remaining then\n\t\tshakeAmp = amp\n\t\tshakeDur = dur\n\t\tshakeUntil = t + dur\n\tend\nend\n\nfunction FX.ShakeCFrame(): CFrame\n\tlocal t = os.clock()\n\tif t >= shakeUntil then\n\t\treturn CFrame.identity\n\tend\n\tlocal k = (shakeUntil - t) / shakeDur\n\tlocal a = shakeAmp * k\n\treturn CFrame.new((math.random() - 0.5) * a, (math.random() - 0.5) * a, (math.random() - 0.5) * a * 0.5)\n\t\t* CFrame.Angles(0, 0, (math.random() - 0.5) * a * 0.02)\nend\n\nlocal function localModel(): Model?\n\treturn State.localModel\nend\n\nlocal function distToLocal(pos: Vector3): number\n\tlocal m = localModel()\n\tlocal root = m and m:FindFirstChild(\"HumanoidRootPart\")\n\tif root then\n\t\treturn (root.Position - pos).Magnitude\n\tend\n\treturn 999\nend\n\nlocal function aimPos(model: Model?): Vector3?\n\tif not model or not model.Parent then\n\t\treturn nil\n\tend\n\tlocal root = model:FindFirstChild(\"HumanoidRootPart\") :: BasePart?\n\tif not root then\n\t\treturn nil\n\tend\n\treturn root.Position + Vector3.new(0, model:GetAttribute(\"AimY\") or 0, 0)\nend\n\n----------------------------------------------------------------------------------------------\n-- Projectiles\n----------------------------------------------------------------------------------------------\nlocal function removeVisual(id: number, fade: boolean?)\n\tlocal v = visuals[id]\n\tif not v then\n\t\treturn\n\tend\n\tvisuals[id] = nil\n\tfor _, part in ipairs(v.parts) do\n\t\tif fade then\n\t\t\tTweenService:Create(part, TweenInfo.new(0.15), { Transparency = 1 }):Play()\n\t\t\tDebris:AddItem(part, 0.4)\n\t\telse\n\t\t\t-- let trails finish\n\t\t\tpart.Transparency = 1\n\t\t\tDebris:AddItem(part, 0.35)\n\t\tend\n\tend\nend\n\nlocal function makeVisual(p)\n\tlocal parts = {}\n\tlocal main\n\tlocal color = p.color or Color3.new(1, 1, 1)\n\tlocal kind = p.kind\n\tif kind == \"Bullet\" then\n\t\tif p.style == \"Beam\" then\n\t\t\tmain = block(Vector3.new(7, 1.3, 1.3), color, Enum.PartType.Cylinder)\n\t\t\tlocal glow = block(Vector3.new(8, 2.6, 2.6), color, Enum.PartType.Cylinder, 0.7)\n\t\t\ttable.insert(parts, glow)\n\t\t\ttrail(main, color, 1.6, 0.25)\n\t\t\tlocal l = Instance.new(\"PointLight\")\n\t\t\tl.Color = color\n\t\t\tl.Range = 14\n\t\t\tl.Brightness = 2\n\t\t\tl.Parent = main\n\t\t\tp.glow = glow\n\t\telseif p.style == \"Pellet\" then\n\t\t\tmain = ball(p.size * 0.9, color)\n\t\t\ttrail(main, color, 0.6, 0.12)\n\t\telse\n\t\t\tmain = ball(p.size, color)\n\t\t\tlocal core = ball(p.size * 0.55, Color3.new(1, 1, 1))\n\t\t\ttable.insert(parts, core)\n\t\t\tp.core = core\n\t\t\ttrail(main, color, p.size * 0.8, 0.18)\n\t\tend\n\telseif kind == \"Bomb\" then\n\t\tmain = ball(p.size, color)\n\t\tlocal ring = block(Vector3.new(0.2, p.size * 1.7, p.size * 1.7), Color3.new(1, 1, 1), Enum.PartType.Cylinder, 0.3)\n\t\ttable.insert(parts, ring)\n\t\tp.ring = ring\n\t\ttrail(main, color, p.size * 0.6, 0.35)\n\t\t-- landing marker telegraph\n\t\tif p.finish then\n\t\t\tlocal r = (p.radius or 8) * 2\n\t\t\tlocal marker = block(Vector3.new(0.15, r, r), color, Enum.PartType.Cylinder, 0.65)\n\t\t\tmarker.CFrame = CFrame.new(p.finish + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, 0, math.rad(90))\n\t\t\ttable.insert(parts, marker)\n\t\t\tp.marker = marker\n\t\tend\n\telseif kind == \"Seeker\" or kind == \"Orbit\" then\n\t\tmain = ball(p.size, color, 0.15)\n\t\tlocal core = ball(p.size * 0.5, Color3.new(1, 1, 1))\n\t\ttable.insert(parts, core)\n\t\tp.core = core\n\t\tlocal l = Instance.new(\"PointLight\")\n\t\tl.Color = color\n\t\tl.Range = 10\n\t\tl.Brightness = 1.5\n\t\tl.Parent = main\n\t\ttrail(main, color, p.size * 0.5, 0.4)\n\telseif kind == \"Mine\" then\n\t\tmain = block(Vector3.new(0.7, p.size, p.size), Color3.fromRGB(40, 40, 50), Enum.PartType.Cylinder)\n\t\tmain.Material = Enum.Material.Metal\n\t\tlocal light = ball(0.9, color)\n\t\ttable.insert(parts, light)\n\t\tp.light = light\n\t\tlocal r = (p.radius or 9) * 2\n\t\tlocal ring = block(Vector3.new(0.12, r, r), color, Enum.PartType.Cylinder, 1)\n\t\ttable.insert(parts, ring)\n\t\tp.triggerRing = ring\n\tend\n\ttable.insert(parts, 1, main)\n\treturn { p = p, main = main, parts = parts, prevPos = p.pos }\nend\n\nlocal function onProj(data)\n\tlocal p = table.clone(data)\n\tp.age = 0\n\tlocal targetModel = p.target\n\tp.target = nil\n\tp.targetModel = targetModel\n\tif p.kind == \"Bomb\" then\n\t\tp.radius = data.radius\n\tend\n\tlocal v = makeVisual(p)\n\tlocal elapsed = workspace:GetServerTimeNow() - (data.t0 or workspace:GetServerTimeNow())\n\tif elapsed > 0 then\n\t\tSim.fastForward(p, elapsed, aimPos(targetModel))\n\tend\n\tvisuals[p.id] = v\nend\n\nlocal function updateVisual(v, dt: number, tclock: number)\n\tlocal p = v.p\n\tlocal prev = p.pos\n\tSim.step(p, dt, aimPos(p.targetModel))\n\tif v.syncPos then\n\t\tlocal k = 1 - math.exp(-dt * 10)\n\t\tp.pos = p.pos:Lerp(v.syncPos, k)\n\t\tv.syncPos = v.syncPos + (p.pos - prev)\n\t\tif (v.syncPos - p.pos).Magnitude < 0.05 then\n\t\t\tv.syncPos = nil\n\t\tend\n\tend\n\tlocal vel = p.pos - prev\n\tlocal look = vel.Magnitude > 1e-4 and vel.Unit or (p.dir or Vector3.zAxis)\n\tlocal main = v.main\n\tif p.kind == \"Bullet\" and p.style == \"Beam\" then\n\t\tlocal cf = CFrame.lookAt(p.pos, p.pos + look) * CFrame.Angles(0, math.rad(90), 0)\n\t\tmain.CFrame = cf\n\t\tp.glow.CFrame = cf\n\telseif p.kind == \"Mine\" then\n\t\tmain.CFrame = CFrame.new(p.pos) * CFrame.Angles(0, 0, math.rad(90))\n\t\tp.light.CFrame = CFrame.new(p.pos + Vector3.new(0, 0.5, 0))\n\t\tlocal armed = p.landed and p.age >= (p.throwTime or 0) + (p.armTime or 0)\n\t\tlocal blink = armed and (math.floor(tclock * 6) % 2 == 0) or (math.floor(tclock * 2) % 2 == 0)\n\t\tp.light.Transparency = blink and 0 or 0.7\n\t\tp.triggerRing.CFrame = CFrame.new(Vector3.new(p.pos.X, p.floorRingY or (p.pos.Y - 0.8), p.pos.Z)) * CFrame.Angles(0, 0, math.rad(90))\n\t\tp.triggerRing.Transparency = armed and 0.75 or 1\n\telse\n\t\tmain.CFrame = CFrame.lookAt(p.pos, p.pos + look)\n\t\tif p.core then\n\t\t\tp.core.CFrame = main.CFrame\n\t\t\tif p.kind ~= \"Bullet\" then\n\t\t\t\tlocal s = p.size * (0.45 + 0.15 * math.sin(tclock * 12))\n\t\t\t\tp.core.Size = Vector3.one * s\n\t\t\tend\n\t\tend\n\t\tif p.ring then\n\t\t\tp.ring.CFrame = CFrame.new(p.pos) * CFrame.Angles(tclock * 6, tclock * 4, 0)\n\t\tend\n\tend\n\tif p.age > (p.life or 3) + 2 then\n\t\treturn false\n\tend\n\treturn true\nend\n\nlocal function onProjEnd(data)\n\tlocal v = visuals[data.id]\n\tlocal pos = data.pos\n\tif v then\n\t\tlocal color = v.p.color or Color3.new(1, 1, 1)\n\t\tif data.reason == \"wall\" then\n\t\t\tburstAt(pos, color, 8, 18, 0.6)\n\t\t\tflash(pos, color, 1.4, 0.12)\n\t\telseif data.reason == \"expire\" then\n\t\t\tremoveVisual(data.id, true)\n\t\t\treturn\n\t\tend\n\tend\n\tremoveVisual(data.id, false)\nend\n\nlocal function onProjSync(list)\n\tfor _, e in ipairs(list) do\n\t\tlocal v = visuals[e[1]]\n\t\tif v then\n\t\t\tv.syncPos = e[2]\n\t\t\tif e[3] then\n\t\t\t\tv.p.dir = e[3]\n\t\t\tend\n\t\tend\n\tend\nend\n\nlocal function clearAll()\n\tfor id in pairs(visuals) do\n\t\tremoveVisual(id, true)\n\tend\n\tfor model in pairs(charges) do\n\t\tFX.StopCharge(model)\n\tend\nend\nFX.ClearAll = clearAll\n\n----------------------------------------------------------------------------------------------\n-- Blasts / hits / misc\n----------------------------------------------------------------------------------------------\nlocal function onBlast(data)\n\tlocal pos, r, linger, color = data.pos, data.radius, data.linger, data.color or Color3.fromRGB(255, 140, 60)\n\tlocal sphere = ball(r * 0.6, color, 0.15)\n\tsphere.CFrame = CFrame.new(pos)\n\tlocal core = ball(r * 0.35, Color3.new(1, 1, 1), 0.05)\n\tcore.CFrame = CFrame.new(pos)\n\tlocal ring = block(Vector3.new(0.3, r * 1.2, r * 1.2), Color3.new(1, 1, 1), Enum.PartType.Cylinder, 0.2)\n\tring.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))\n\tlocal light = Instance.new(\"PointLight\")\n\tlight.Color = color\n\tlight.Range = r * 3.5\n\tlight.Brightness = 5\n\tlight.Parent = sphere\n\tTweenService:Create(sphere, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.one * r * 2 }):Play()\n\tTweenService:Create(core, TweenInfo.new(0.2), { Size = Vector3.one * r * 1.2, Transparency = 0.6 }):Play()\n\tTweenService:Create(ring, TweenInfo.new(0.35), { Size = Vector3.new(0.3, r * 3.2, r * 3.2), Transparency = 1 }):Play()\n\tTweenService:Create(light, TweenInfo.new(linger + 0.2), { Brightness = 0 }):Play()\n\tburstAt(pos, color, 30, 45, 1.6, 0.6)\n\tsmokeAt(pos, Color3.fromRGB(70, 60, 90), 10, r * 0.9)\n\ttask.spawn(function()\n\t\tlocal t0 = os.clock()\n\t\twhile os.clock() - t0 < linger do\n\t\t\tsphere.Transparency = 0.25 + math.random() * 0.2\n\t\t\ttask.wait(0.05)\n\t\tend\n\t\tTweenService:Create(sphere, TweenInfo.new(0.25), { Transparency = 1, Size = Vector3.one * r * 2.2 }):Play()\n\t\tTweenService:Create(core, TweenInfo.new(0.2), { Transparency = 1 }):Play()\n\t\ttask.wait(0.3)\n\t\tsphere:Destroy()\n\t\tcore:Destroy()\n\t\tring:Destroy()\n\tend)\n\tlocal d = distToLocal(pos)\n\tlocal amp = (data.big and 2.2 or 1.4) * math.clamp(1 - d / 70, 0.15, 1)\n\tFX.Shake(amp, 0.35)\n\tSound.Play(\"Explosion\", { volume = data.big and 1.2 or 0.9, pitch = data.big and 0.8 or 1 })\nend\n\nlocal function onHit(data)\n\tlocal victim = data.victim\n\tlocal color = Color3.fromRGB(255, 230, 120)\n\tburstAt(data.pos, color, data.heavy and 26 or 14, data.heavy and 40 or 28, data.heavy and 1.4 or 0.9)\n\tflash(data.pos, Color3.new(1, 1, 1), data.heavy and 3 or 1.8, 0.12)\n\tif HUD then\n\t\tHUD.ShowHit(victim, data.pos, data.amount, data.combo, data.heavy)\n\tend\n\tif RobotAnim then\n\t\tRobotAnim.Flinch(victim)\n\tend\n\tif victim == localModel() then\n\t\tFX.Shake(data.heavy and 2.6 or 0.9, data.heavy and 0.45 or 0.2)\n\t\tif HUD then\n\t\t\tHUD.DamageVignette(data.heavy)\n\t\tend\n\telseif data.attacker == localModel() and data.heavy then\n\t\tFX.Shake(1.0, 0.2)\n\tend\n\tSound.Play(data.heavy and \"HeavyHit\" or \"Hit\")\nend\n\nlocal WEAPON_ATT = { Gun = \"GunTip\", Bomb = \"BombTip\", Pod = \"PodTip\" }\nlocal function onFire(data)\n\tlocal model = data.model\n\tif not model or not model.Parent then\n\t\treturn\n\tend\n\tlocal att = model:FindFirstChild(WEAPON_ATT[data.weapon] or \"GunTip\", true)\n\tlocal robot = Config.RobotById[model:GetAttribute(\"RobotId\") or \"Bolt\"]\n\tlocal loadout = Config.GetLoadout(robot.Id)\n\tlocal color = data.weapon == \"Gun\" and loadout.Gun.Color or (data.weapon == \"Bomb\" and loadout.Bomb.Color or loadout.Pod.Color)\n\tif att and att:IsA(\"Attachment\") then\n\t\tflash(att.WorldPosition, color, data.weapon == \"Gun\" and 1.8 or 2.4, 0.1)\n\tend\n\tif RobotAnim then\n\t\tRobotAnim.OnFire(model, data.weapon)\n\tend\n\tif model == localModel() and Battle then\n\t\tBattle.OnLocalFire(data)\n\tend\n\tif data.weapon == \"Gun\" then\n\t\tSound.Play(data.gunType == \"Spread\" and \"Shotgun\" or (data.gunType == \"Charge\" and \"Laser\" or \"Blaster\"))\n\telseif data.weapon == \"Bomb\" then\n\t\tSound.Play(\"BombThrow\")\n\telse\n\t\tSound.Play(\"Pod\")\n\tend\nend\n\nfunction FX.StopCharge(model)\n\tlocal ch = charges[model]\n\tif ch then\n\t\tcharges[model] = nil\n\t\tch.orb:Destroy()\n\t\tif ch.sound then\n\t\t\tch.sound:Destroy()\n\t\tend\n\tend\nend\n\nlocal function onCharge(data)\n\tlocal model = data.model\n\tif not model then\n\t\treturn\n\tend\n\tif data.on then\n\t\tFX.StopCharge(model)\n\t\tlocal robot = Config.RobotById[model:GetAttribute(\"RobotId\") or \"Lancer\"]\n\t\tlocal color = Config.GetLoadout(robot.Id).Gun.Color\n\t\tlocal orb = ball(0.4, color, 0.1)\n\t\tlocal l = Instance.new(\"PointLight\")\n\t\tl.Color = color\n\t\tl.Range = 8\n\t\tl.Brightness = 2\n\t\tl.Parent = orb\n\t\tcharges[model] = { orb = orb, t0 = os.clock(), dur = data.chargeTime or 0.8, color = color, sound = Sound.Play(\"Charge\", { vary = 0 }) }\n\telse\n\t\tFX.StopCharge(model)\n\tend\nend\n\nlocal function trailFor(model: Model)\n\tlocal t = trails[model]\n\tif t and t.Parent then\n\t\treturn t\n\tend\n\tlocal torso = model:FindFirstChild(\"Torso\")\n\tif not torso then\n\t\treturn nil\n\tend\n\tlocal robot = Config.RobotById[model:GetAttribute(\"RobotId\") or \"Bolt\"]\n\tlocal a0 = Instance.new(\"Attachment\")\n\ta0.Name = \"RCTrailTop\"\n\ta0.Position = Vector3.new(0, 1.2, 0.5)\n\ta0.Parent = torso\n\tlocal a1 = Instance.new(\"Attachment\")\n\ta1.Name = \"RCTrailBottom\"\n\ta1.Position = Vector3.new(0, -2.5, 0.5)\n\ta1.Parent = torso\n\tlocal tr = Instance.new(\"Trail\")\n\ttr.Attachment0 = a0\n\ttr.Attachment1 = a1\n\ttr.Lifetime = 0.22\n\ttr.Color = ColorSequence.new(robot.Neon)\n\ttr.LightEmission = 1\n\ttr.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })\n\ttr.Enabled = false\n\ttr.Parent = torso\n\ttrails[model] = tr\n\treturn tr\nend\n\nlocal function onDash(data)\n\tlocal model = data.model\n\tif not model or not model.Parent then\n\t\treturn\n\tend\n\tlocal tr = trailFor(model)\n\tif tr then\n\t\ttr.Enabled = true\n\t\ttask.delay(0.32, function()\n\t\t\tif tr.Parent then\n\t\t\t\ttr.Enabled = false\n\t\t\tend\n\t\tend)\n\tend\n\tlocal root = model:FindFirstChild(\"HumanoidRootPart\")\n\tif root and not data.air then\n\t\tsmokeAt(root.Position - Vector3.new(0, 3.5, 0), Color3.fromRGB(150, 160, 200), 6, 2.5)\n\tend\n\tSound.Play(\"Dash\")\nend\n\nlocal handlers = {\n\tProj = onProj,\n\tProjEnd = onProjEnd,\n\tProjSync = onProjSync,\n\tClearProj = clearAll,\n\tBlast = onBlast,\n\tHit = onHit,\n\tFire = onFire,\n\tCharge = onCharge,\n\tDash = onDash,\n\tDown = function(data)\n\t\tif HUD then\n\t\t\tHUD.TagText(data.model, \"DOWN\", Color3.fromRGB(255, 90, 170))\n\t\tend\n\t\tSound.Play(\"Down\")\n\t\tif data.model == localModel() then\n\t\t\tFX.Shake(2.2, 0.4)\n\t\tend\n\tend,\n\tRebirth = function(data)\n\t\tif HUD then\n\t\t\tHUD.TagText(data.model, \"REBIRTH\", Color3.fromRGB(255, 255, 255))\n\t\tend\n\tend,\n\tPit = function(data)\n\t\tif HUD then\n\t\t\tHUD.TagText(data.model, \"PIT  -\" .. tostring(data.amount), Color3.fromRGB(255, 80, 80))\n\t\tend\n\t\tSound.Play(\"HeavyHit\")\n\tend,\n}\n\nfunction FX.Init(deps)\n\tHUD = deps.HUD\n\tRobotAnim = deps.RobotAnim\n\tBattle = deps.Battle\n\tRC.Remotes.FX.OnClientEvent:Connect(function(kind, data)\n\t\tlocal h = handlers[kind]\n\t\tif h then\n\t\t\tlocal ok, err = pcall(h, data)\n\t\t\tif not ok then\n\t\t\t\twarn(\"[RoboClash FX] \" .. tostring(kind) .. \": \" .. tostring(err))\n\t\t\tend\n\t\tend\n\tend)\n\tRunService.RenderStepped:Connect(function(dt)\n\t\tlocal tclock = os.clock()\n\t\tfor id, v in pairs(visuals) do\n\t\t\tlocal ok, keep = pcall(updateVisual, v, dt, tclock)\n\t\t\tif not ok or not keep then\n\t\t\t\tremoveVisual(id, true)\n\t\t\tend\n\t\tend\n\t\tfor model, ch in pairs(charges) do\n\t\t\tlocal att = model.Parent and model:FindFirstChild(\"GunTip\", true)\n\t\t\tif not att then\n\t\t\t\tFX.StopCharge(model)\n\t\t\telse\n\t\t\t\tlocal k = math.clamp((tclock - ch.t0) / ch.dur, 0, 1)\n\t\t\t\tlocal full = k >= 1\n\t\t\t\tlocal s = 0.4 + 1.6 * k + (full and 0.25 * math.sin(tclock * 30) or 0)\n\t\t\t\tch.orb.Size = Vector3.one * s\n\t\t\t\tch.orb.CFrame = CFrame.new((att :: Attachment).WorldPosition)\n\t\t\t\tch.orb.Color = full and Color3.new(1, 1, 1) or ch.color\n\t\t\tend\n\t\tend\n\tend)\nend\n\nfunction FX.Folder()\n\treturn folder\nend\n\nreturn FX\n","message":"The file /Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/FX.luau has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"toolu_01DRXyV66hZLbm3YexLobQFE","startedAtMs":"1791074250717","completedAtMs":"1791074252493"},"model_call_id":"f6f75537-51d9-46fb-a6c9-81f06ac674d8-54-e109","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791074252499}
{"type":"tool_call","subtype":"started","call_id":"toolu_01CpwTkTiWP8QuMzNU9fGsuM","tool_call":{"editToolCall":{"args":{"path":"/Users/chase-mini/src/rca-work/src/ServerScriptService/RoboClash/CombatService.luau","streamContent":"\t\t\tradius = 2.2,\n\t\t\tblast = bomb,\n\t\t\tblastRadius = bomb.Radius,\n\t\t})"}},"hookAdditionalContexts":[],"toolCallId":"toolu_01CpwTkTiWP8QuMzNU9fGsuM","startedAtMs":"1791074252438"},"model_call_id":"f6f75537-51d9-46fb-a6c9-81f06ac674d8-54-e109","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791074253561}
{"type":"tool_call","subtype":"completed","call_id":"toolu_01CpwTkTiWP8QuMzNU9fGsuM","tool_call":{"editToolCall":{"args":{"path":"/Users/chase-mini/src/rca-work/src/ServerScriptService/RoboClash/CombatService.luau","streamContent":"\t\t\tradius = 2.2,\n\t\t\tblast = bomb,\n\t\t\tblastRadius = bomb.Radius,\n\t\t})"},"result":{"success":{"path":"/Users/chase-mini/src/rca-work/src/ServerScriptService/RoboClash/CombatService.luau","linesAdded":1,"linesRemoved":0,"diffString":"--- a//Users/chase-mini/src/rca-work/src/ServerScriptService/RoboClash/CombatService.luau\n+++ b//Users/chase-mini/src/rca-work/src/ServerScriptService/RoboClash/CombatService.luau\n@@ -442,6 +442,7 @@\n \t\t\tcolor = bomb.Color,\n \t\t\tradius = 2.2,\n \t\t\tblast = bomb,\n+\t\t\tblastRadius = bomb.Radius,\n \t\t})\n \tend\n \tmatch:FireAll(\"FX\", \"Fire\", { model = c.model, weapon = \"Bomb\", slow = 0.2, slowTime = bomb.Stall })","beforeFullFileContent":"-- Server-authoritative combat: weapon intents, projectile simulation, blasts, damage,\n-- endurance -> DOWN -> REBIRTH, body dash attacks, pits. Operates on match objects owned by\n-- MatchService; works for any number of combatants (nearest enemy = lock-on target).\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal RC = ReplicatedStorage:WaitForChild(\"RoboClash\")\nlocal Config = require(RC.Config)\nlocal Util = require(RC.Shared.Util)\nlocal Sim = require(RC.Shared.ProjectileSim)\n\nlocal M = Config.Match\nlocal Combat = {}\n\nlocal function now(): number\n\treturn workspace:GetServerTimeNow()\nend\nCombat.now = now\n\nlocal POD_KINDS = { Seeker = true, Mine = true, Orbit = true }\n\n----------------------------------------------------------------------------------------------\n-- Combatant setup\n----------------------------------------------------------------------------------------------\nfunction Combat.NewCombatant(match, participant, model: Model, info, spawnCF: CFrame)\n\tlocal loadout = Config.GetLoadout(participant.robotId)\n\tlocal c = {\n\t\tmatch = match,\n\t\tparticipant = participant,\n\t\tindex = participant.index,\n\t\tteam = participant.team,\n\t\ttag = participant.tag,\n\t\tmodel = model,\n\t\troot = model:FindFirstChild(\"HumanoidRootPart\"),\n\t\thum = model:FindFirstChildOfClass(\"Humanoid\"),\n\t\tloadout = loadout,\n\t\tinfo = info,\n\t\tspawnCF = spawnCF,\n\t\thp = M.MaxHP,\n\t\tmaxHp = M.MaxHP,\n\t\tendurance = M.EnduranceMax,\n\t\tstate = \"Normal\",\n\t\tstateUntil = 0,\n\t\tinvulnUntil = 0,\n\t\tgunReadyAt = 0,\n\t\tammo = loadout.Gun.Clip or 0,\n\t\treloadUntil = 0,\n\t\tgunHeld = false,\n\t\tchargeStart = nil,\n\t\tburstLeft = 0,\n\t\tnextShotAt = 0,\n\t\tbombReadyAt = 0,\n\t\tpodReadyAt = 0,\n\t\tdashUntil = 0,\n\t\tdashDir = Vector3.zero,\n\t\tdashHit = {},\n\t\tlastDashIntent = 0,\n\t\tlastDashHitAt = 0,\n\t\tlastHitAt = 0,\n\t\tcomboDamage = 0,\n\t\tcomboUntil = 0,\n\t\talive = true,\n\t\tstats = { damageDealt = 0, damageTaken = 0, downs = 0, hits = 0 },\n\t}\n\tCombat.SyncAttributes(c)\n\treturn c\nend\n\nfunction Combat.SyncAttributes(c)\n\tlocal m = c.model\n\tif not m or not m.Parent then\n\t\treturn\n\tend\n\tm:SetAttribute(\"HP\", c.hp)\n\tm:SetAttribute(\"MaxHP\", c.maxHp)\n\tm:SetAttribute(\"Pips\", math.clamp(math.ceil(c.endurance / M.EndurancePerPip - 1e-6), 0, 3))\n\tm:SetAttribute(\"Ammo\", c.ammo)\n\tm:SetAttribute(\"Clip\", c.loadout.Gun.Clip or 0)\n\tm:SetAttribute(\"ReloadUntil\", c.reloadUntil)\n\tm:SetAttribute(\"GunReadyAt\", c.gunReadyAt)\n\tm:SetAttribute(\"BombReadyAt\", c.bombReadyAt)\n\tm:SetAttribute(\"PodReadyAt\", c.podReadyAt)\nend\n\nlocal function setState(c, state: string, untilT: number)\n\tc.state = state\n\tc.stateUntil = untilT\n\tif c.model and c.model.Parent then\n\t\tc.model:SetAttribute(\"State\", state)\n\t\tc.model:SetAttribute(\"StateUntil\", untilT)\n\tend\nend\nCombat.SetState = setState\n\nfunction Combat.AimPoint(c): Vector3\n\treturn c.root.Position + Vector3.new(0, c.info.aimY, 0)\nend\n\nfunction Combat.GetTarget(match, c)\n\tlocal best, bestD = nil, math.huge\n\tfor _, o in ipairs(match.combatants) do\n\t\tif o ~= c and o.alive and o.team ~= c.team and o.root then\n\t\t\tlocal d = (o.root.Position - c.root.Position).Magnitude\n\t\t\tif d < bestD then\n\t\t\t\tbest, bestD = o, d\n\t\t\tend\n\t\tend\n\tend\n\treturn best, bestD\nend\n\nlocal function isInvulnerable(c, t: number): boolean\n\treturn c.state == \"Rebirth\" or t < c.invulnUntil or not c.alive\nend\nCombat.IsInvulnerable = isInvulnerable\n\nlocal function canAct(match, c): boolean\n\treturn match.state == \"Fight\" and c.alive and c.state ~= \"Down\"\nend\n\n----------------------------------------------------------------------------------------------\n-- Knockback / state changes\n----------------------------------------------------------------------------------------------\nlocal function applyKnock(c, dir: Vector3, speed: number, up: number, dur: number)\n\tspeed *= c.loadout.Body.KnockbackMult\n\tlocal vel = Util.flatUnit(dir, c.root.CFrame.LookVector * -1) * speed\n\tif c.participant.kind == \"Player\" then\n\t\tlocal p = c.participant.player\n\t\tif p.Parent then\n\t\t\tc.match.remotes.Match:FireClient(p, \"Knock\", vel, up, dur)\n\t\tend\n\telseif c.mover then\n\t\tc.mover:Knockback(vel, up, dur)\n\tend\nend\nCombat.ApplyKnock = applyKnock\n\nfunction Combat.KnockDown(match, victim, attacker, dir: Vector3)\n\tlocal t = now()\n\tsetState(victim, \"Down\", t + M.DownTime)\n\tvictim.endurance = M.EnduranceMax\n\tvictim.gunHeld = false\n\tvictim.chargeStart = nil\n\tvictim.burstLeft = 0\n\tvictim.dashUntil = 0\n\tif attacker then\n\t\tattacker.stats.downs += 1\n\tend\n\tapplyKnock(victim, dir, 48, 26, 0.45)\n\tmatch:FireAll(\"FX\", \"Down\", { model = victim.model })\nend\n\n----------------------------------------------------------------------------------------------\n-- Damage\n----------------------------------------------------------------------------------------------\n-- info: { downPower, knock, up, forceDown, dir (Vector3), pos (Vector3), source }\nfunction Combat.Damage(match, victim, amount: number, attacker, info)\n\tif match.state ~= \"Fight\" or not victim.alive then\n\t\treturn false\n\tend\n\tlocal t = now()\n\tif isInvulnerable(victim, t) then\n\t\treturn false\n\tend\n\tlocal wasDown = victim.state == \"Down\"\n\tif wasDown then\n\t\tamount *= M.DownDamageMult\n\tend\n\tamount = math.max(1, math.floor(amount + 0.5))\n\tvictim.hp = math.max(0, victim.hp - amount)\n\tvictim.stats.damageTaken += amount\n\tvictim.lastHitAt = t\n\tif attacker then\n\t\tattacker.stats.damageDealt += amount\n\t\tattacker.stats.hits += 1\n\tend\n\n\tlocal dir = info.dir or (attacker and Util.flat(victim.root.Position - attacker.root.Position)) or Vector3.zAxis\n\tlocal heavy = false\n\tif not wasDown then\n\t\tvictim.endurance -= info.downPower or 0\n\t\tif victim.hp > 0 and (info.forceDown or victim.endurance <= 0) then\n\t\t\tCombat.KnockDown(match, victim, attacker, dir)\n\t\t\theavy = true\n\t\telse\n\t\t\tif (info.knock or 0) > 0 or (info.up or 0) > 0 then\n\t\t\t\tapplyKnock(victim, dir, info.knock or 0, info.up or 0, 0.22)\n\t\t\tend\n\t\t\theavy = amount >= 70\n\t\tend\n\tend\n\n\tif t < victim.comboUntil then\n\t\tvictim.comboDamage += amount\n\telse\n\t\tvictim.comboDamage = amount\n\tend\n\tvictim.comboUntil = t + M.ComboWindow\n\n\tCombat.SyncAttributes(victim)\n\tmatch:FireAll(\"FX\", \"Hit\", {\n\t\tvictim = victim.model,\n\t\tattacker = attacker and attacker.model,\n\t\tpos = info.pos or Combat.AimPoint(victim),\n\t\tamount = amount,\n\t\tcombo = victim.comboDamage,\n\t\theavy = heavy,\n\t\tdown = wasDown,\n\t\tsource = info.source,\n\t})\n\n\tif victim.hp <= 0 then\n\t\tmatch:OnKO(victim, attacker)\n\tend\n\treturn true\nend\n\n----------------------------------------------------------------------------------------------\n-- Projectiles\n----------------------------------------------------------------------------------------------\nlocal function tipPos(c, attName: string): Vector3\n\tlocal att = c.model:FindFirstChild(attName, true)\n\tif att and att:IsA(\"Attachment\") then\n\t\treturn att.WorldPosition\n\tend\n\treturn c.root.Position\nend\n\nlocal function serializeProj(p)\n\treturn {\n\t\tid = p.id,\n\t\tkind = p.kind,\n\t\tstyle = p.style,\n\t\tpos = p.pos,\n\t\tdir = p.dir,\n\t\tspeed = p.speed,\n\t\tturn = p.turn,\n\t\taccel = p.accel,\n\t\tlife = p.life,\n\t\tsize = p.size,\n\t\tcolor = p.color,\n\t\ttarget = p.target and p.target.model,\n\t\towner = p.owner.model,\n\t\thoming = p.homing,\n\t\tstart = p.start,\n\t\tfinish = p.finish,\n\t\tflight = p.flight,\n\t\tapex = p.apex,\n\t\tfloorY = p.floorY,\n\t\thover = p.hover,\n\t\tclimb = p.climb,\n\t\tlaunchDir = p.launchDir,\n\t\tlaunchTime = p.launchTime,\n\t\tlaunchSpeed = p.launchSpeed,\n\t\tthrowTime = p.throwTime,\n\t\tarmTime = p.armTime,\n\t\tradius = p.blastRadius,\n\t\tt0 = p.t0,\n\t}\nend\n\nlocal function spawnProj(match, owner, p)\n\tmatch.nextProjId += 1\n\tp.id = match.nextProjId\n\tp.owner = owner\n\tp.age = 0\n\tp.t0 = now()\n\tmatch.projectiles[p.id] = p\n\tmatch:FireAll(\"FX\", \"Proj\", serializeProj(p))\n\treturn p\nend\n\nlocal function endProj(match, p, reason: string, pos: Vector3?)\n\tmatch.projectiles[p.id] = nil\n\tmatch:FireAll(\"FX\", \"ProjEnd\", { id = p.id, pos = pos or p.pos, reason = reason })\nend\n\nlocal function spawnBlast(match, owner, pos: Vector3, w, color: Color3)\n\tlocal b = {\n\t\towner = owner,\n\t\tpos = pos,\n\t\tradius = w.Radius,\n\t\tt0 = now(),\n\t\tuntilT = now() + (w.Linger or 0.6),\n\t\tdamage = w.Damage,\n\t\tdownPower = w.DownPower,\n\t\tknock = w.Knock,\n\t\tup = w.Up,\n\t\thit = {},\n\t\tsource = w.Name,\n\t}\n\ttable.insert(match.blasts, b)\n\tmatch:FireAll(\"FX\", \"Blast\", { pos = pos, radius = w.Radius, linger = w.Linger or 0.6, color = color, big = w.Radius >= 12 })\nend\n\nlocal function aimDir(c, from: Vector3, target): Vector3\n\tif target then\n\t\tlocal to = Combat.AimPoint(target) - from\n\t\tif to.Magnitude > 0.1 then\n\t\t\treturn to.Unit\n\t\tend\n\tend\n\treturn c.root.CFrame.LookVector\nend\n\nlocal function jitter(dir: Vector3, deg: number): Vector3\n\tif deg <= 0 then\n\t\treturn dir\n\tend\n\tlocal yaw = math.rad((math.random() * 2 - 1) * deg)\n\tlocal pitch = math.rad((math.random() * 2 - 1) * deg * 0.4)\n\treturn (CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0) * dir).Unit\nend\n\nlocal function fireBullet(match, c, target, spec, color: Color3, dir: Vector3, style: string?)\n\tlocal turnMul = c.aiTurnMul or 1\n\tspawnProj(match, c, {\n\t\tkind = \"Bullet\",\n\t\tstyle = style or \"Bullet\",\n\t\tpos = tipPos(c, \"GunTip\"),\n\t\tdir = dir,\n\t\tspeed = spec.Speed,\n\t\tturn = math.rad(spec.Turn) * turnMul,\n\t\taccel = spec.Accel,\n\t\tlife = spec.Life,\n\t\tradius = spec.Radius,\n\t\tsize = spec.Size or 0.9,\n\t\tcolor = color,\n\t\ttarget = target,\n\t\thoming = true,\n\t\tdamage = spec.Damage,\n\t\tdownPower = spec.DownPower,\n\t\tknock = spec.Knock,\n\t\tup = spec.Up,\n\t\tforceDown = spec.ForceDown,\n\t\tsource = style,\n\t})\nend\n\nlocal function onGunFired(match, c, gun)\n\tif c.mover then\n\t\tc.mover:Slow(gun.MoveSlow, gun.SlowTime)\n\tend\n\tmatch:FireAll(\"FX\", \"Fire\", { model = c.model, weapon = \"Gun\", gunType = gun.Type, slow = gun.MoveSlow, slowTime = gun.SlowTime })\nend\n\nlocal function triggerGun(match, c)\n\tlocal gun = c.loadout.Gun\n\tlocal t = now()\n\tif gun.Type == \"Charge\" then\n\t\treturn\n\tend\n\tif t < c.gunReadyAt or t < c.reloadUntil or c.burstLeft > 0 then\n\t\treturn\n\tend\n\tif c.ammo <= 0 then\n\t\tc.ammo = gun.Clip\n\tend\n\tc.ammo -= 1\n\tc.gunReadyAt = t + gun.Cooldown\n\tif c.ammo <= 0 then\n\t\tc.reloadUntil = t + gun.Cooldown + gun.Reload\n\t\tc.ammo = gun.Clip\n\t\tc.gunReadyAt = c.reloadUntil\n\tend\n\tlocal target = Combat.GetTarget(match, c)\n\tif gun.Type == \"Burst\" then\n\t\tc.burstLeft = gun.Shots\n\t\tc.nextShotAt = t\n\telseif gun.Type == \"Spread\" then\n\t\tlocal from = tipPos(c, \"GunTip\")\n\t\tlocal base = jitter(aimDir(c, from, target), c.aiAimError or 0)\n\t\tlocal n = gun.Pellets\n\t\tfor i = 1, n do\n\t\t\tlocal a = math.rad(-gun.SpreadDeg / 2 + gun.SpreadDeg * (i - 1) / math.max(1, n - 1))\n\t\t\tfireBullet(match, c, target, gun, gun.Color, (CFrame.Angles(0, a, 0) * base).Unit, \"Pellet\")\n\t\tend\n\t\tonGunFired(match, c, gun)\n\tend\n\tCombat.SyncAttributes(c)\nend\n\nlocal function releaseCharge(match, c)\n\tlocal gun = c.loadout.Gun\n\tlocal t = now()\n\tlocal started = c.chargeStart\n\tc.chargeStart = nil\n\tmatch:FireAll(\"FX\", \"Charge\", { model = c.model, on = false })\n\tif not started or t < c.gunReadyAt then\n\t\treturn\n\tend\n\tlocal full = (t - started) >= gun.ChargeTime\n\tlocal spec = full and gun.Full or gun.Tap\n\tlocal target = Combat.GetTarget(match, c)\n\tlocal from = tipPos(c, \"GunTip\")\n\tfireBullet(match, c, target, spec, gun.Color, jitter(aimDir(c, from, target), c.aiAimError or 0), full and \"Beam\" or \"Bolt\")\n\tc.gunReadyAt = t + gun.Cooldown\n\tonGunFired(match, c, gun)\n\tCombat.SyncAttributes(c)\nend\n\nlocal function fireBomb(match, c)\n\tlocal bomb = c.loadout.Bomb\n\tlocal t = now()\n\tif t < c.bombReadyAt then\n\t\treturn\n\tend\n\tc.bombReadyAt = t + bomb.Cooldown\n\tlocal target = Combat.GetTarget(match, c)\n\tlocal from = tipPos(c, \"BombTip\")\n\tlocal myFlat = Util.flat(c.root.Position)\n\tlocal aim\n\tif target then\n\t\tlocal tv = Util.flat(target.root.AssemblyLinearVelocity)\n\t\taim = Util.flat(target.root.Position) + tv * bomb.FlightTime * bomb.Lead\n\t\tif c.aiAimError then\n\t\t\taim += Vector3.new(math.random() * 2 - 1, 0, math.random() * 2 - 1) * c.aiAimError * 0.6\n\t\tend\n\telse\n\t\taim = myFlat + Util.flatUnit(c.root.CFrame.LookVector) * 30\n\tend\n\tlocal off = aim - myFlat\n\tlocal dist = math.clamp(off.Magnitude, bomb.MinRange, bomb.MaxRange)\n\tlocal fwd = Util.flatUnit(off, Util.flatUnit(c.root.CFrame.LookVector))\n\tlocal right = Vector3.new(-fwd.Z, 0, fwd.X)\n\tfor i = 1, bomb.Count do\n\t\tlocal lateral = (i - (bomb.Count + 1) / 2) * bomb.Spread\n\t\tlocal land = myFlat + fwd * dist + right * lateral\n\t\tland = Vector3.new(land.X, match.floorY, land.Z)\n\t\tlocal hit = workspace:Raycast(land + Vector3.new(0, 40, 0), Vector3.new(0, -60, 0), match.rayParams)\n\t\tif hit then\n\t\t\tland = hit.Position\n\t\tend\n\t\tspawnProj(match, c, {\n\t\t\tkind = \"Bomb\",\n\t\t\tpos = from,\n\t\t\tstart = from,\n\t\t\tfinish = land,\n\t\t\tflight = bomb.FlightTime * (0.85 + 0.15 * dist / bomb.MaxRange),\n\t\t\tapex = bomb.Apex + math.max(0, from.Y - land.Y) * 0.25,\n\t\t\tlife = bomb.FlightTime + 1,\n\t\t\tsize = 1.6 + bomb.Radius * 0.06,\n\t\t\tcolor = bomb.Color,\n\t\t\tradius = 2.2,\n\t\t\tblast = bomb,\n\t\t})\n\tend\n\tmatch:FireAll(\"FX\", \"Fire\", { model = c.model, weapon = \"Bomb\", slow = 0.2, slowTime = bomb.Stall })\n\tCombat.SyncAttributes(c)\nend\n\nlocal function activePods(match, c): number\n\tlocal n = 0\n\tfor _, p in pairs(match.projectiles) do\n\t\tif p.owner == c and POD_KINDS[p.kind] then\n\t\t\tn += 1\n\t\tend\n\tend\n\treturn n\nend\n\nlocal function firePod(match, c)\n\tlocal pod = c.loadout.Pod\n\tlocal t = now()\n\tif t < c.podReadyAt or activePods(match, c) + pod.Count > pod.MaxActive then\n\t\treturn\n\tend\n\tc.podReadyAt = t + pod.Cooldown\n\tlocal target = Combat.GetTarget(match, c)\n\tlocal from = tipPos(c, \"PodTip\")\n\tlocal fwd = target and Util.flatUnit(target.root.Position - c.root.Position) or Util.flatUnit(c.root.CFrame.LookVector)\n\tlocal right = Vector3.new(-fwd.Z, 0, fwd.X)\n\tlocal common = {\n\t\tsize = pod.Size,\n\t\tcolor = pod.Color,\n\t\ttarget = target,\n\t\tlife = pod.Life,\n\t\tradius = pod.TriggerRadius,\n\t\tblast = pod,\n\t\tblastRadius = pod.Radius,\n\t}\n\tlocal function spawnOne(extra)\n\t\tlocal p = table.clone(common)\n\t\tfor k, v in pairs(extra) do\n\t\t\tp[k] = v\n\t\tend\n\t\tspawnProj(match, c, p)\n\tend\n\tif pod.Type == \"Seeker\" then\n\t\tspawnOne({\n\t\t\tkind = \"Seeker\",\n\t\t\tpos = from,\n\t\t\tdir = fwd,\n\t\t\tspeed = pod.Speed,\n\t\t\tturn = math.rad(pod.Turn),\n\t\t\tfloorY = match.floorY,\n\t\t\thover = pod.HoverHeight,\n\t\t\tclimb = pod.ClimbRate,\n\t\t})\n\telseif pod.Type == \"Mine\" then\n\t\tlocal land = Util.flat(c.root.Position) + fwd * pod.ThrowDist\n\t\tland = Vector3.new(land.X, match.floorY + 0.9, land.Z)\n\t\tlocal hit = workspace:Raycast(land + Vector3.new(0, 30, 0), Vector3.new(0, -50, 0), match.rayParams)\n\t\tif hit then\n\t\t\tland = hit.Position + Vector3.new(0, 0.9, 0)\n\t\tend\n\t\tspawnOne({\n\t\t\tkind = \"Mine\",\n\t\t\tpos = from,\n\t\t\tstart = from,\n\t\t\tfinish = land,\n\t\t\tthrowTime = pod.ThrowTime,\n\t\t\tarmTime = pod.ArmTime,\n\t\t})\n\telseif pod.Type == \"Orbit\" then\n\t\tfor _, s in ipairs({ -1, 1 }) do\n\t\t\tspawnOne({\n\t\t\t\tkind = \"Orbit\",\n\t\t\t\tpos = from,\n\t\t\t\tdir = fwd,\n\t\t\t\tspeed = pod.Speed,\n\t\t\t\tturn = math.rad(pod.Turn),\n\t\t\t\tlaunchDir = (right * s + Vector3.new(0, 0.35, 0)).Unit,\n\t\t\t\tlaunchTime = pod.LaunchTime,\n\t\t\t\tlaunchSpeed = pod.LaunchSide / pod.LaunchTime,\n\t\t\t})\n\t\tend\n\tend\n\tmatch:FireAll(\"FX\", \"Fire\", { model = c.model, weapon = \"Pod\", slow = 0.6, slowTime = 0.2 })\n\tCombat.SyncAttributes(c)\nend\n\n----------------------------------------------------------------------------------------------\n-- Intents (from player clients via Main, or from BotAI)\n----------------------------------------------------------------------------------------------\nfunction Combat.HandleIntent(match, c, action: string, payload)\n\tif not match or not c or not c.alive then\n\t\treturn\n\tend\n\tif action == \"GunUp\" then\n\t\tc.gunHeld = false\n\t\tif c.chargeStart then\n\t\t\tif canAct(match, c) then\n\t\t\t\treleaseCharge(match, c)\n\t\t\telse\n\t\t\t\tc.chargeStart = nil\n\t\t\tend\n\t\tend\n\t\treturn\n\tend\n\tif not canAct(match, c) then\n\t\treturn\n\tend\n\tlocal t = now()\n\tif action == \"GunDown\" then\n\t\tc.gunHeld = true\n\t\tif c.loadout.Gun.Type == \"Charge\" then\n\t\t\tif not c.chargeStart and t >= c.gunReadyAt - 0.05 then\n\t\t\t\tc.chargeStart = t\n\t\t\t\tmatch:FireAll(\"FX\", \"Charge\", { model = c.model, on = true, chargeTime = c.loadout.Gun.ChargeTime })\n\t\t\tend\n\t\telse\n\t\t\ttriggerGun(match, c)\n\t\tend\n\telseif action == \"Bomb\" then\n\t\tfireBomb(match, c)\n\telseif action == \"Pod\" then\n\t\tfirePod(match, c)\n\telseif action == \"Dash\" then\n\t\tif t - c.lastDashIntent < 0.18 then\n\t\t\treturn\n\t\tend\n\t\tc.lastDashIntent = t\n\t\tlocal dir = typeof(payload) == \"table\" and typeof(payload.dir) == \"Vector3\" and payload.dir or c.root.CFrame.LookVector\n\t\tc.dashDir = Util.flatUnit(dir, Util.flatUnit(c.root.CFrame.LookVector))\n\t\tc.dashUntil = t + math.max(c.loadout.Legs.DashTime, c.loadout.Legs.AirDashTime) + 0.08\n\t\tc.dashHit = {}\n\t\tmatch:FireAll(\"FX\", \"Dash\", { model = c.model, air = typeof(payload) == \"table\" and payload.air == true })\n\tend\nend\n\n----------------------------------------------------------------------------------------------\n-- Per-frame step\n----------------------------------------------------------------------------------------------\nlocal function capsule(c): (Vector3, Vector3)\n\tlocal p = c.root.Position\n\treturn p - Vector3.new(0, c.info.capDown, 0), p + Vector3.new(0, c.info.capUp, 0)\nend\n\nlocal function distToCapsule(c, a: Vector3, b: Vector3): number\n\tlocal lo, hi = capsule(c)\n\treturn Util.segSegDist(a, b, lo, hi) - c.info.hitRadius\nend\n\nlocal function explodePod(match, p)\n\tendProj(match, p, \"explode\", p.pos)\n\tspawnBlast(match, p.owner, p.pos, p.blast, p.color)\nend\n\nlocal function stepProjectiles(match, dt: number, t: number)\n\tfor _, p in pairs(match.projectiles) do\n\t\tlocal target = p.target\n\t\tlocal tpos = (target and target.alive and target.root) and Combat.AimPoint(target) or nil\n\t\tlocal prev = Sim.step(p, dt, tpos)\n\t\tlocal kind = p.kind\n\t\tlocal owner = p.owner\n\n\t\tif kind == \"Bullet\" then\n\t\t\tlocal seg = p.pos - prev\n\t\t\tlocal wall = seg.Magnitude > 0 and workspace:Raycast(prev, seg, match.rayParams)\n\t\t\tlocal hitC, hitDist = nil, math.huge\n\t\t\tfor _, e in ipairs(match.combatants) do\n\t\t\t\tif e ~= owner and e.alive and e.team ~= owner.team and not isInvulnerable(e, t) then\n\t\t\t\t\tlocal d = distToCapsule(e, prev, p.pos) - p.radius\n\t\t\t\t\tif d <= 0 then\n\t\t\t\t\t\tlocal along = (e.root.Position - prev).Magnitude\n\t\t\t\t\t\tif along < hitDist then\n\t\t\t\t\t\t\thitC, hitDist = e, along\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\tif hitC and (not wall or (wall.Position - prev).Magnitude >= hitDist - 1) then\n\t\t\t\tendProj(match, p, \"hit\", p.pos)\n\t\t\t\tCombat.Damage(match, hitC, p.damage, owner, {\n\t\t\t\t\tdownPower = p.downPower,\n\t\t\t\t\tknock = p.knock,\n\t\t\t\t\tup = p.up,\n\t\t\t\t\tforceDown = p.forceDown,\n\t\t\t\t\tdir = Util.flat(p.dir),\n\t\t\t\t\tpos = p.pos,\n\t\t\t\t\tsource = p.source,\n\t\t\t\t})\n\t\t\telseif wall then\n\t\t\t\tendProj(match, p, \"wall\", wall.Position)\n\t\t\telseif p.age >= p.life then\n\t\t\t\tendProj(match, p, \"expire\", p.pos)\n\t\t\tend\n\t\telseif kind == \"Bomb\" then\n\t\t\tlocal direct = false\n\t\t\tfor _, e in ipairs(match.combatants) do\n\t\t\t\tif e ~= owner and e.alive and e.team ~= owner.team and not isInvulnerable(e, t) then\n\t\t\t\t\tif distToCapsule(e, prev, p.pos) <= p.radius then\n\t\t\t\t\t\tdirect = true\n\t\t\t\t\t\tbreak\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\tif direct or p.landed then\n\t\t\t\tendProj(match, p, \"explode\", p.pos)\n\t\t\t\tspawnBlast(match, owner, p.pos, p.blast, p.color)\n\t\t\tend\n\t\telseif kind == \"Seeker\" or kind == \"Orbit\" then\n\t\t\tlocal seg = p.pos - prev\n\t\t\tlocal wall = seg.Magnitude > 0 and workspace:Raycast(prev, seg, match.rayParams)\n\t\t\tlocal triggered = false\n\t\t\tfor _, e in ipairs(match.combatants) do\n\t\t\t\tif e ~= owner and e.alive and e.team ~= owner.team and not isInvulnerable(e, t) then\n\t\t\t\t\tif distToCapsule(e, prev, p.pos) <= p.radius then\n\t\t\t\t\t\ttriggered = true\n\t\t\t\t\t\tbreak\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\tif wall and not triggered then\n\t\t\t\tp.pos = wall.Position + wall.Normal * 0.5\n\t\t\tend\n\t\t\tif triggered or wall or p.age >= p.life then\n\t\t\t\texplodePod(match, p)\n\t\t\tend\n\t\telseif kind == \"Mine\" then\n\t\t\tlocal armed = p.landed and p.age >= p.throwTime + p.armTime\n\t\t\tlocal triggered = false\n\t\t\tif armed then\n\t\t\t\tfor _, e in ipairs(match.combatants) do\n\t\t\t\t\tif e ~= owner and e.alive and e.team ~= owner.team and not isInvulnerable(e, t) then\n\t\t\t\t\t\tif (e.root.Position - p.pos).Magnitude - e.info.hitRadius <= p.radius then\n\t\t\t\t\t\t\ttriggered = true\n\t\t\t\t\t\t\tbreak\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\tif triggered or p.age >= p.life then\n\t\t\t\texplodePod(match, p)\n\t\t\tend\n\t\tend\n\tend\n\n\t-- Periodic position sync for slow, long-lived pods so client visuals don't drift.\n\tif t - (match.lastPodSync or 0) > 0.25 then\n\t\tmatch.lastPodSync = t\n\t\tlocal sync = {}\n\t\tfor id, p in pairs(match.projectiles) do\n\t\t\tif p.kind == \"Seeker\" or p.kind == \"Orbit\" then\n\t\t\t\ttable.insert(sync, { id, p.pos, p.dir })\n\t\t\tend\n\t\tend\n\t\tif #sync > 0 then\n\t\t\tmatch:FireAll(\"FX\", \"ProjSync\", sync)\n\t\tend\n\tend\nend\n\nlocal function stepBlasts(match, t: number)\n\tlocal i = 1\n\tlocal blasts = match.blasts\n\twhile i <= #blasts do\n\t\tlocal b = blasts[i]\n\t\tif t >= b.untilT then\n\t\t\ttable.remove(blasts, i)\n\t\telse\n\t\t\tlocal grow = math.clamp((t - b.t0) / 0.15, 0.45, 1)\n\t\t\tlocal r = b.radius * grow\n\t\t\tfor _, e in ipairs(match.combatants) do\n\t\t\t\tif not b.hit[e] and e ~= b.owner and e.alive and e.team ~= b.owner.team and not isInvulnerable(e, t) then\n\t\t\t\t\tlocal lo, hi = capsule(e)\n\t\t\t\t\tlocal d = Util.segSegDist(b.pos, b.pos, lo, hi) - e.info.hitRadius\n\t\t\t\t\tif d <= r then\n\t\t\t\t\t\tb.hit[e] = true\n\t\t\t\t\t\tCombat.Damage(match, e, b.damage, b.owner, {\n\t\t\t\t\t\t\tdownPower = b.downPower,\n\t\t\t\t\t\t\tknock = b.knock,\n\t\t\t\t\t\t\tup = b.up,\n\t\t\t\t\t\t\tdir = Util.flat(e.root.Position - b.pos),\n\t\t\t\t\t\t\tpos = Combat.AimPoint(e),\n\t\t\t\t\t\t\tsource = b.source,\n\t\t\t\t\t\t})\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\ti += 1\n\t\tend\n\tend\nend\n\nlocal function stepCombatant(match, c, dt: number, t: number)\n\tif not c.alive or not c.root or not c.root.Parent then\n\t\treturn\n\tend\n\tlocal gun = c.loadout.Gun\n\n\t-- Down -> Rebirth -> Normal\n\tif c.state == \"Down\" and t >= c.stateUntil then\n\t\tsetState(c, \"Rebirth\", t + M.RebirthTime)\n\t\tc.invulnUntil = t + M.RebirthTime\n\t\tCombat.SyncAttributes(c)\n\t\tmatch:FireAll(\"FX\", \"Rebirth\", { model = c.model })\n\telseif c.state == \"Rebirth\" and t >= c.stateUntil then\n\t\tsetState(c, \"Normal\", 0)\n\tend\n\n\t-- Endurance regen\n\tif c.state ~= \"Down\" and c.endurance < M.EnduranceMax and t - c.lastHitAt > M.EnduranceRegenDelay then\n\t\tlocal before = math.ceil(c.endurance / M.EndurancePerPip)\n\t\tc.endurance = math.min(M.EnduranceMax, c.endurance + M.EnduranceRegenRate * dt)\n\t\tif math.ceil(c.endurance / M.EndurancePerPip) ~= before then\n\t\t\tCombat.SyncAttributes(c)\n\t\tend\n\tend\n\n\tif match.state ~= \"Fight\" then\n\t\treturn\n\tend\n\n\t-- Burst fire + held trigger auto-repeat\n\tif c.burstLeft > 0 and t >= c.nextShotAt and c.state ~= \"Down\" then\n\t\tlocal target = Combat.GetTarget(match, c)\n\t\tlocal from = tipPos(c, \"GunTip\")\n\t\tfireBullet(match, c, target, gun, gun.Color, jitter(aimDir(c, from, target), c.aiAimError or 0), \"Bullet\")\n\t\tif c.burstLeft == gun.Shots then\n\t\t\tonGunFired(match, c, gun)\n\t\tend\n\t\tc.burstLeft -= 1\n\t\tc.nextShotAt = t + gun.ShotInterval\n\tend\n\tif c.gunHeld and gun.Type ~= \"Charge\" and c.state ~= \"Down\" then\n\t\ttriggerGun(match, c)\n\tend\n\n\t-- Body dash attack\n\tif t < c.dashUntil and t - c.lastDashHitAt > 0.6 then\n\t\tfor _, e in ipairs(match.combatants) do\n\t\t\tif e ~= c and e.alive and e.team ~= c.team and not c.dashHit[e] and not isInvulnerable(e, t) then\n\t\t\t\tlocal d = (Util.flat(e.root.Position - c.root.Position)).Magnitude\n\t\t\t\tlocal dy = math.abs(e.root.Position.Y - c.root.Position.Y)\n\t\t\t\tif d <= c.info.hitRadius + e.info.hitRadius + 1.0 and dy < 5 then\n\t\t\t\t\tc.dashHit[e] = true\n\t\t\t\t\tc.lastDashHitAt = t\n\t\t\t\t\tlocal da = c.loadout.Body.DashAttack\n\t\t\t\t\tCombat.Damage(match, e, da.Damage, c, {\n\t\t\t\t\t\tdownPower = da.DownPower,\n\t\t\t\t\t\tknock = da.Knock,\n\t\t\t\t\t\tup = da.Up,\n\t\t\t\t\t\tdir = c.dashDir,\n\t\t\t\t\t\tpos = Combat.AimPoint(e),\n\t\t\t\t\t\tsource = da.Name,\n\t\t\t\t\t})\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\n\t-- Pits\n\tif c.root.Position.Y < match.floorY - M.PitFallDepth then\n\t\tc.hp = math.max(0, c.hp - M.PitDamage)\n\t\tc.stats.damageTaken += M.PitDamage\n\t\tc.invulnUntil = t + M.PitInvuln\n\t\tc.model:PivotTo(c.spawnCF * CFrame.new(0, c.info.rootY + 8, 0))\n\t\tc.root.AssemblyLinearVelocity = Vector3.zero\n\t\tif c.participant.kind == \"Player\" and c.participant.player.Parent then\n\t\t\tmatch.remotes.Match:FireClient(c.participant.player, \"Teleported\")\n\t\telseif c.mover then\n\t\t\tc.mover:ResetVelocity()\n\t\tend\n\t\tCombat.SyncAttributes(c)\n\t\tmatch:FireAll(\"FX\", \"Pit\", { model = c.model, amount = M.PitDamage })\n\t\tif c.hp <= 0 then\n\t\t\tmatch:OnKO(c, nil)\n\t\tend\n\tend\nend\n\nfunction Combat.Step(match, dt: number)\n\tlocal t = now()\n\tfor _, c in ipairs(match.combatants) do\n\t\tstepCombatant(match, c, dt, t)\n\tend\n\tif match.state == \"Fight\" then\n\t\tstepProjectiles(match, dt, t)\n\t\tstepBlasts(match, t)\n\tend\nend\n\nfunction Combat.ClearProjectiles(match)\n\tmatch.projectiles = {}\n\tmatch.blasts = {}\n\tmatch:FireAll(\"FX\", \"ClearProj\", {})\nend\n\nreturn Combat\n","afterFullFileContent":"-- Server-authoritative combat: weapon intents, projectile simulation, blasts, damage,\n-- endurance -> DOWN -> REBIRTH, body dash attacks, pits. Operates on match objects owned by\n-- MatchService; works for any number of combatants (nearest enemy = lock-on target).\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal RC = ReplicatedStorage:WaitForChild(\"RoboClash\")\nlocal Config = require(RC.Config)\nlocal Util = require(RC.Shared.Util)\nlocal Sim = require(RC.Shared.ProjectileSim)\n\nlocal M = Config.Match\nlocal Combat = {}\n\nlocal function now(): number\n\treturn workspace:GetServerTimeNow()\nend\nCombat.now = now\n\nlocal POD_KINDS = { Seeker = true, Mine = true, Orbit = true }\n\n----------------------------------------------------------------------------------------------\n-- Combatant setup\n----------------------------------------------------------------------------------------------\nfunction Combat.NewCombatant(match, participant, model: Model, info, spawnCF: CFrame)\n\tlocal loadout = Config.GetLoadout(participant.robotId)\n\tlocal c = {\n\t\tmatch = match,\n\t\tparticipant = participant,\n\t\tindex = participant.index,\n\t\tteam = participant.team,\n\t\ttag = participant.tag,\n\t\tmodel = model,\n\t\troot = model:FindFirstChild(\"HumanoidRootPart\"),\n\t\thum = model:FindFirstChildOfClass(\"Humanoid\"),\n\t\tloadout = loadout,\n\t\tinfo = info,\n\t\tspawnCF = spawnCF,\n\t\thp = M.MaxHP,\n\t\tmaxHp = M.MaxHP,\n\t\tendurance = M.EnduranceMax,\n\t\tstate = \"Normal\",\n\t\tstateUntil = 0,\n\t\tinvulnUntil = 0,\n\t\tgunReadyAt = 0,\n\t\tammo = loadout.Gun.Clip or 0,\n\t\treloadUntil = 0,\n\t\tgunHeld = false,\n\t\tchargeStart = nil,\n\t\tburstLeft = 0,\n\t\tnextShotAt = 0,\n\t\tbombReadyAt = 0,\n\t\tpodReadyAt = 0,\n\t\tdashUntil = 0,\n\t\tdashDir = Vector3.zero,\n\t\tdashHit = {},\n\t\tlastDashIntent = 0,\n\t\tlastDashHitAt = 0,\n\t\tlastHitAt = 0,\n\t\tcomboDamage = 0,\n\t\tcomboUntil = 0,\n\t\talive = true,\n\t\tstats = { damageDealt = 0, damageTaken = 0, downs = 0, hits = 0 },\n\t}\n\tCombat.SyncAttributes(c)\n\treturn c\nend\n\nfunction Combat.SyncAttributes(c)\n\tlocal m = c.model\n\tif not m or not m.Parent then\n\t\treturn\n\tend\n\tm:SetAttribute(\"HP\", c.hp)\n\tm:SetAttribute(\"MaxHP\", c.maxHp)\n\tm:SetAttribute(\"Pips\", math.clamp(math.ceil(c.endurance / M.EndurancePerPip - 1e-6), 0, 3))\n\tm:SetAttribute(\"Ammo\", c.ammo)\n\tm:SetAttribute(\"Clip\", c.loadout.Gun.Clip or 0)\n\tm:SetAttribute(\"ReloadUntil\", c.reloadUntil)\n\tm:SetAttribute(\"GunReadyAt\", c.gunReadyAt)\n\tm:SetAttribute(\"BombReadyAt\", c.bombReadyAt)\n\tm:SetAttribute(\"PodReadyAt\", c.podReadyAt)\nend\n\nlocal function setState(c, state: string, untilT: number)\n\tc.state = state\n\tc.stateUntil = untilT\n\tif c.model and c.model.Parent then\n\t\tc.model:SetAttribute(\"State\", state)\n\t\tc.model:SetAttribute(\"StateUntil\", untilT)\n\tend\nend\nCombat.SetState = setState\n\nfunction Combat.AimPoint(c): Vector3\n\treturn c.root.Position + Vector3.new(0, c.info.aimY, 0)\nend\n\nfunction Combat.GetTarget(match, c)\n\tlocal best, bestD = nil, math.huge\n\tfor _, o in ipairs(match.combatants) do\n\t\tif o ~= c and o.alive and o.team ~= c.team and o.root then\n\t\t\tlocal d = (o.root.Position - c.root.Position).Magnitude\n\t\t\tif d < bestD then\n\t\t\t\tbest, bestD = o, d\n\t\t\tend\n\t\tend\n\tend\n\treturn best, bestD\nend\n\nlocal function isInvulnerable(c, t: number): boolean\n\treturn c.state == \"Rebirth\" or t < c.invulnUntil or not c.alive\nend\nCombat.IsInvulnerable = isInvulnerable\n\nlocal function canAct(match, c): boolean\n\treturn match.state == \"Fight\" and c.alive and c.state ~= \"Down\"\nend\n\n----------------------------------------------------------------------------------------------\n-- Knockback / state changes\n----------------------------------------------------------------------------------------------\nlocal function applyKnock(c, dir: Vector3, speed: number, up: number, dur: number)\n\tspeed *= c.loadout.Body.KnockbackMult\n\tlocal vel = Util.flatUnit(dir, c.root.CFrame.LookVector * -1) * speed\n\tif c.participant.kind == \"Player\" then\n\t\tlocal p = c.participant.player\n\t\tif p.Parent then\n\t\t\tc.match.remotes.Match:FireClient(p, \"Knock\", vel, up, dur)\n\t\tend\n\telseif c.mover then\n\t\tc.mover:Knockback(vel, up, dur)\n\tend\nend\nCombat.ApplyKnock = applyKnock\n\nfunction Combat.KnockDown(match, victim, attacker, dir: Vector3)\n\tlocal t = now()\n\tsetState(victim, \"Down\", t + M.DownTime)\n\tvictim.endurance = M.EnduranceMax\n\tvictim.gunHeld = false\n\tvictim.chargeStart = nil\n\tvictim.burstLeft = 0\n\tvictim.dashUntil = 0\n\tif attacker then\n\t\tattacker.stats.downs += 1\n\tend\n\tapplyKnock(victim, dir, 48, 26, 0.45)\n\tmatch:FireAll(\"FX\", \"Down\", { model = victim.model })\nend\n\n----------------------------------------------------------------------------------------------\n-- Damage\n----------------------------------------------------------------------------------------------\n-- info: { downPower, knock, up, forceDown, dir (Vector3), pos (Vector3), source }\nfunction Combat.Damage(match, victim, amount: number, attacker, info)\n\tif match.state ~= \"Fight\" or not victim.alive then\n\t\treturn false\n\tend\n\tlocal t = now()\n\tif isInvulnerable(victim, t) then\n\t\treturn false\n\tend\n\tlocal wasDown = victim.state == \"Down\"\n\tif wasDown then\n\t\tamount *= M.DownDamageMult\n\tend\n\tamount = math.max(1, math.floor(amount + 0.5))\n\tvictim.hp = math.max(0, victim.hp - amount)\n\tvictim.stats.damageTaken += amount\n\tvictim.lastHitAt = t\n\tif attacker then\n\t\tattacker.stats.damageDealt += amount\n\t\tattacker.stats.hits += 1\n\tend\n\n\tlocal dir = info.dir or (attacker and Util.flat(victim.root.Position - attacker.root.Position)) or Vector3.zAxis\n\tlocal heavy = false\n\tif not wasDown then\n\t\tvictim.endurance -= info.downPower or 0\n\t\tif victim.hp > 0 and (info.forceDown or victim.endurance <= 0) then\n\t\t\tCombat.KnockDown(match, victim, attacker, dir)\n\t\t\theavy = true\n\t\telse\n\t\t\tif (info.knock or 0) > 0 or (info.up or 0) > 0 then\n\t\t\t\tapplyKnock(victim, dir, info.knock or 0, info.up or 0, 0.22)\n\t\t\tend\n\t\t\theavy = amount >= 70\n\t\tend\n\tend\n\n\tif t < victim.comboUntil then\n\t\tvictim.comboDamage += amount\n\telse\n\t\tvictim.comboDamage = amount\n\tend\n\tvictim.comboUntil = t + M.ComboWindow\n\n\tCombat.SyncAttributes(victim)\n\tmatch:FireAll(\"FX\", \"Hit\", {\n\t\tvictim = victim.model,\n\t\tattacker = attacker and attacker.model,\n\t\tpos = info.pos or Combat.AimPoint(victim),\n\t\tamount = amount,\n\t\tcombo = victim.comboDamage,\n\t\theavy = heavy,\n\t\tdown = wasDown,\n\t\tsource = info.source,\n\t})\n\n\tif victim.hp <= 0 then\n\t\tmatch:OnKO(victim, attacker)\n\tend\n\treturn true\nend\n\n----------------------------------------------------------------------------------------------\n-- Projectiles\n----------------------------------------------------------------------------------------------\nlocal function tipPos(c, attName: string): Vector3\n\tlocal att = c.model:FindFirstChild(attName, true)\n\tif att and att:IsA(\"Attachment\") then\n\t\treturn att.WorldPosition\n\tend\n\treturn c.root.Position\nend\n\nlocal function serializeProj(p)\n\treturn {\n\t\tid = p.id,\n\t\tkind = p.kind,\n\t\tstyle = p.style,\n\t\tpos = p.pos,\n\t\tdir = p.dir,\n\t\tspeed = p.speed,\n\t\tturn = p.turn,\n\t\taccel = p.accel,\n\t\tlife = p.life,\n\t\tsize = p.size,\n\t\tcolor = p.color,\n\t\ttarget = p.target and p.target.model,\n\t\towner = p.owner.model,\n\t\thoming = p.homing,\n\t\tstart = p.start,\n\t\tfinish = p.finish,\n\t\tflight = p.flight,\n\t\tapex = p.apex,\n\t\tfloorY = p.floorY,\n\t\thover = p.hover,\n\t\tclimb = p.climb,\n\t\tlaunchDir = p.launchDir,\n\t\tlaunchTime = p.launchTime,\n\t\tlaunchSpeed = p.launchSpeed,\n\t\tthrowTime = p.throwTime,\n\t\tarmTime = p.armTime,\n\t\tradius = p.blastRadius,\n\t\tt0 = p.t0,\n\t}\nend\n\nlocal function spawnProj(match, owner, p)\n\tmatch.nextProjId += 1\n\tp.id = match.nextProjId\n\tp.owner = owner\n\tp.age = 0\n\tp.t0 = now()\n\tmatch.projectiles[p.id] = p\n\tmatch:FireAll(\"FX\", \"Proj\", serializeProj(p))\n\treturn p\nend\n\nlocal function endProj(match, p, reason: string, pos: Vector3?)\n\tmatch.projectiles[p.id] = nil\n\tmatch:FireAll(\"FX\", \"ProjEnd\", { id = p.id, pos = pos or p.pos, reason = reason })\nend\n\nlocal function spawnBlast(match, owner, pos: Vector3, w, color: Color3)\n\tlocal b = {\n\t\towner = owner,\n\t\tpos = pos,\n\t\tradius = w.Radius,\n\t\tt0 = now(),\n\t\tuntilT = now() + (w.Linger or 0.6),\n\t\tdamage = w.Damage,\n\t\tdownPower = w.DownPower,\n\t\tknock = w.Knock,\n\t\tup = w.Up,\n\t\thit = {},\n\t\tsource = w.Name,\n\t}\n\ttable.insert(match.blasts, b)\n\tmatch:FireAll(\"FX\", \"Blast\", { pos = pos, radius = w.Radius, linger = w.Linger or 0.6, color = color, big = w.Radius >= 12 })\nend\n\nlocal function aimDir(c, from: Vector3, target): Vector3\n\tif target then\n\t\tlocal to = Combat.AimPoint(target) - from\n\t\tif to.Magnitude > 0.1 then\n\t\t\treturn to.Unit\n\t\tend\n\tend\n\treturn c.root.CFrame.LookVector\nend\n\nlocal function jitter(dir: Vector3, deg: number): Vector3\n\tif deg <= 0 then\n\t\treturn dir\n\tend\n\tlocal yaw = math.rad((math.random() * 2 - 1) * deg)\n\tlocal pitch = math.rad((math.random() * 2 - 1) * deg * 0.4)\n\treturn (CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0) * dir).Unit\nend\n\nlocal function fireBullet(match, c, target, spec, color: Color3, dir: Vector3, style: string?)\n\tlocal turnMul = c.aiTurnMul or 1\n\tspawnProj(match, c, {\n\t\tkind = \"Bullet\",\n\t\tstyle = style or \"Bullet\",\n\t\tpos = tipPos(c, \"GunTip\"),\n\t\tdir = dir,\n\t\tspeed = spec.Speed,\n\t\tturn = math.rad(spec.Turn) * turnMul,\n\t\taccel = spec.Accel,\n\t\tlife = spec.Life,\n\t\tradius = spec.Radius,\n\t\tsize = spec.Size or 0.9,\n\t\tcolor = color,\n\t\ttarget = target,\n\t\thoming = true,\n\t\tdamage = spec.Damage,\n\t\tdownPower = spec.DownPower,\n\t\tknock = spec.Knock,\n\t\tup = spec.Up,\n\t\tforceDown = spec.ForceDown,\n\t\tsource = style,\n\t})\nend\n\nlocal function onGunFired(match, c, gun)\n\tif c.mover then\n\t\tc.mover:Slow(gun.MoveSlow, gun.SlowTime)\n\tend\n\tmatch:FireAll(\"FX\", \"Fire\", { model = c.model, weapon = \"Gun\", gunType = gun.Type, slow = gun.MoveSlow, slowTime = gun.SlowTime })\nend\n\nlocal function triggerGun(match, c)\n\tlocal gun = c.loadout.Gun\n\tlocal t = now()\n\tif gun.Type == \"Charge\" then\n\t\treturn\n\tend\n\tif t < c.gunReadyAt or t < c.reloadUntil or c.burstLeft > 0 then\n\t\treturn\n\tend\n\tif c.ammo <= 0 then\n\t\tc.ammo = gun.Clip\n\tend\n\tc.ammo -= 1\n\tc.gunReadyAt = t + gun.Cooldown\n\tif c.ammo <= 0 then\n\t\tc.reloadUntil = t + gun.Cooldown + gun.Reload\n\t\tc.ammo = gun.Clip\n\t\tc.gunReadyAt = c.reloadUntil\n\tend\n\tlocal target = Combat.GetTarget(match, c)\n\tif gun.Type == \"Burst\" then\n\t\tc.burstLeft = gun.Shots\n\t\tc.nextShotAt = t\n\telseif gun.Type == \"Spread\" then\n\t\tlocal from = tipPos(c, \"GunTip\")\n\t\tlocal base = jitter(aimDir(c, from, target), c.aiAimError or 0)\n\t\tlocal n = gun.Pellets\n\t\tfor i = 1, n do\n\t\t\tlocal a = math.rad(-gun.SpreadDeg / 2 + gun.SpreadDeg * (i - 1) / math.max(1, n - 1))\n\t\t\tfireBullet(match, c, target, gun, gun.Color, (CFrame.Angles(0, a, 0) * base).Unit, \"Pellet\")\n\t\tend\n\t\tonGunFired(match, c, gun)\n\tend\n\tCombat.SyncAttributes(c)\nend\n\nlocal function releaseCharge(match, c)\n\tlocal gun = c.loadout.Gun\n\tlocal t = now()\n\tlocal started = c.chargeStart\n\tc.chargeStart = nil\n\tmatch:FireAll(\"FX\", \"Charge\", { model = c.model, on = false })\n\tif not started or t < c.gunReadyAt then\n\t\treturn\n\tend\n\tlocal full = (t - started) >= gun.ChargeTime\n\tlocal spec = full and gun.Full or gun.Tap\n\tlocal target = Combat.GetTarget(match, c)\n\tlocal from = tipPos(c, \"GunTip\")\n\tfireBullet(match, c, target, spec, gun.Color, jitter(aimDir(c, from, target), c.aiAimError or 0), full and \"Beam\" or \"Bolt\")\n\tc.gunReadyAt = t + gun.Cooldown\n\tonGunFired(match, c, gun)\n\tCombat.SyncAttributes(c)\nend\n\nlocal function fireBomb(match, c)\n\tlocal bomb = c.loadout.Bomb\n\tlocal t = now()\n\tif t < c.bombReadyAt then\n\t\treturn\n\tend\n\tc.bombReadyAt = t + bomb.Cooldown\n\tlocal target = Combat.GetTarget(match, c)\n\tlocal from = tipPos(c, \"BombTip\")\n\tlocal myFlat = Util.flat(c.root.Position)\n\tlocal aim\n\tif target then\n\t\tlocal tv = Util.flat(target.root.AssemblyLinearVelocity)\n\t\taim = Util.flat(target.root.Position) + tv * bomb.FlightTime * bomb.Lead\n\t\tif c.aiAimError then\n\t\t\taim += Vector3.new(math.random() * 2 - 1, 0, math.random() * 2 - 1) * c.aiAimError * 0.6\n\t\tend\n\telse\n\t\taim = myFlat + Util.flatUnit(c.root.CFrame.LookVector) * 30\n\tend\n\tlocal off = aim - myFlat\n\tlocal dist = math.clamp(off.Magnitude, bomb.MinRange, bomb.MaxRange)\n\tlocal fwd = Util.flatUnit(off, Util.flatUnit(c.root.CFrame.LookVector))\n\tlocal right = Vector3.new(-fwd.Z, 0, fwd.X)\n\tfor i = 1, bomb.Count do\n\t\tlocal lateral = (i - (bomb.Count + 1) / 2) * bomb.Spread\n\t\tlocal land = myFlat + fwd * dist + right * lateral\n\t\tland = Vector3.new(land.X, match.floorY, land.Z)\n\t\tlocal hit = workspace:Raycast(land + Vector3.new(0, 40, 0), Vector3.new(0, -60, 0), match.rayParams)\n\t\tif hit then\n\t\t\tland = hit.Position\n\t\tend\n\t\tspawnProj(match, c, {\n\t\t\tkind = \"Bomb\",\n\t\t\tpos = from,\n\t\t\tstart = from,\n\t\t\tfinish = land,\n\t\t\tflight = bomb.FlightTime * (0.85 + 0.15 * dist / bomb.MaxRange),\n\t\t\tapex = bomb.Apex + math.max(0, from.Y - land.Y) * 0.25,\n\t\t\tlife = bomb.FlightTime + 1,\n\t\t\tsize = 1.6 + bomb.Radius * 0.06,\n\t\t\tcolor = bomb.Color,\n\t\t\tradius = 2.2,\n\t\t\tblast = bomb,\n\t\t\tblastRadius = bomb.Radius,\n\t\t})\n\tend\n\tmatch:FireAll(\"FX\", \"Fire\", { model = c.model, weapon = \"Bomb\", slow = 0.2, slowTime = bomb.Stall })\n\tCombat.SyncAttributes(c)\nend\n\nlocal function activePods(match, c): number\n\tlocal n = 0\n\tfor _, p in pairs(match.projectiles) do\n\t\tif p.owner == c and POD_KINDS[p.kind] then\n\t\t\tn += 1\n\t\tend\n\tend\n\treturn n\nend\n\nlocal function firePod(match, c)\n\tlocal pod = c.loadout.Pod\n\tlocal t = now()\n\tif t < c.podReadyAt or activePods(match, c) + pod.Count > pod.MaxActive then\n\t\treturn\n\tend\n\tc.podReadyAt = t + pod.Cooldown\n\tlocal target = Combat.GetTarget(match, c)\n\tlocal from = tipPos(c, \"PodTip\")\n\tlocal fwd = target and Util.flatUnit(target.root.Position - c.root.Position) or Util.flatUnit(c.root.CFrame.LookVector)\n\tlocal right = Vector3.new(-fwd.Z, 0, fwd.X)\n\tlocal common = {\n\t\tsize = pod.Size,\n\t\tcolor = pod.Color,\n\t\ttarget = target,\n\t\tlife = pod.Life,\n\t\tradius = pod.TriggerRadius,\n\t\tblast = pod,\n\t\tblastRadius = pod.Radius,\n\t}\n\tlocal function spawnOne(extra)\n\t\tlocal p = table.clone(common)\n\t\tfor k, v in pairs(extra) do\n\t\t\tp[k] = v\n\t\tend\n\t\tspawnProj(match, c, p)\n\tend\n\tif pod.Type == \"Seeker\" then\n\t\tspawnOne({\n\t\t\tkind = \"Seeker\",\n\t\t\tpos = from,\n\t\t\tdir = fwd,\n\t\t\tspeed = pod.Speed,\n\t\t\tturn = math.rad(pod.Turn),\n\t\t\tfloorY = match.floorY,\n\t\t\thover = pod.HoverHeight,\n\t\t\tclimb = pod.ClimbRate,\n\t\t})\n\telseif pod.Type == \"Mine\" then\n\t\tlocal land = Util.flat(c.root.Position) + fwd * pod.ThrowDist\n\t\tland = Vector3.new(land.X, match.floorY + 0.9, land.Z)\n\t\tlocal hit = workspace:Raycast(land + Vector3.new(0, 30, 0), Vector3.new(0, -50, 0), match.rayParams)\n\t\tif hit then\n\t\t\tland = hit.Position + Vector3.new(0, 0.9, 0)\n\t\tend\n\t\tspawnOne({\n\t\t\tkind = \"Mine\",\n\t\t\tpos = from,\n\t\t\tstart = from,\n\t\t\tfinish = land,\n\t\t\tthrowTime = pod.ThrowTime,\n\t\t\tarmTime = pod.ArmTime,\n\t\t})\n\telseif pod.Type == \"Orbit\" then\n\t\tfor _, s in ipairs({ -1, 1 }) do\n\t\t\tspawnOne({\n\t\t\t\tkind = \"Orbit\",\n\t\t\t\tpos = from,\n\t\t\t\tdir = fwd,\n\t\t\t\tspeed = pod.Speed,\n\t\t\t\tturn = math.rad(pod.Turn),\n\t\t\t\tlaunchDir = (right * s + Vector3.new(0, 0.35, 0)).Unit,\n\t\t\t\tlaunchTime = pod.LaunchTime,\n\t\t\t\tlaunchSpeed = pod.LaunchSide / pod.LaunchTime,\n\t\t\t})\n\t\tend\n\tend\n\tmatch:FireAll(\"FX\", \"Fire\", { model = c.model, weapon = \"Pod\", slow = 0.6, slowTime = 0.2 })\n\tCombat.SyncAttributes(c)\nend\n\n----------------------------------------------------------------------------------------------\n-- Intents (from player clients via Main, or from BotAI)\n----------------------------------------------------------------------------------------------\nfunction Combat.HandleIntent(match, c, action: string, payload)\n\tif not match or not c or not c.alive then\n\t\treturn\n\tend\n\tif action == \"GunUp\" then\n\t\tc.gunHeld = false\n\t\tif c.chargeStart then\n\t\t\tif canAct(match, c) then\n\t\t\t\treleaseCharge(match, c)\n\t\t\telse\n\t\t\t\tc.chargeStart = nil\n\t\t\tend\n\t\tend\n\t\treturn\n\tend\n\tif not canAct(match, c) then\n\t\treturn\n\tend\n\tlocal t = now()\n\tif action == \"GunDown\" then\n\t\tc.gunHeld = true\n\t\tif c.loadout.Gun.Type == \"Charge\" then\n\t\t\tif not c.chargeStart and t >= c.gunReadyAt - 0.05 then\n\t\t\t\tc.chargeStart = t\n\t\t\t\tmatch:FireAll(\"FX\", \"Charge\", { model = c.model, on = true, chargeTime = c.loadout.Gun.ChargeTime })\n\t\t\tend\n\t\telse\n\t\t\ttriggerGun(match, c)\n\t\tend\n\telseif action == \"Bomb\" then\n\t\tfireBomb(match, c)\n\telseif action == \"Pod\" then\n\t\tfirePod(match, c)\n\telseif action == \"Dash\" then\n\t\tif t - c.lastDashIntent < 0.18 then\n\t\t\treturn\n\t\tend\n\t\tc.lastDashIntent = t\n\t\tlocal dir = typeof(payload) == \"table\" and typeof(payload.dir) == \"Vector3\" and payload.dir or c.root.CFrame.LookVector\n\t\tc.dashDir = Util.flatUnit(dir, Util.flatUnit(c.root.CFrame.LookVector))\n\t\tc.dashUntil = t + math.max(c.loadout.Legs.DashTime, c.loadout.Legs.AirDashTime) + 0.08\n\t\tc.dashHit = {}\n\t\tmatch:FireAll(\"FX\", \"Dash\", { model = c.model, air = typeof(payload) == \"table\" and payload.air == true })\n\tend\nend\n\n----------------------------------------------------------------------------------------------\n-- Per-frame step\n----------------------------------------------------------------------------------------------\nlocal function capsule(c): (Vector3, Vector3)\n\tlocal p = c.root.Position\n\treturn p - Vector3.new(0, c.info.capDown, 0), p + Vector3.new(0, c.info.capUp, 0)\nend\n\nlocal function distToCapsule(c, a: Vector3, b: Vector3): number\n\tlocal lo, hi = capsule(c)\n\treturn Util.segSegDist(a, b, lo, hi) - c.info.hitRadius\nend\n\nlocal function explodePod(match, p)\n\tendProj(match, p, \"explode\", p.pos)\n\tspawnBlast(match, p.owner, p.pos, p.blast, p.color)\nend\n\nlocal function stepProjectiles(match, dt: number, t: number)\n\tfor _, p in pairs(match.projectiles) do\n\t\tlocal target = p.target\n\t\tlocal tpos = (target and target.alive and target.root) and Combat.AimPoint(target) or nil\n\t\tlocal prev = Sim.step(p, dt, tpos)\n\t\tlocal kind = p.kind\n\t\tlocal owner = p.owner\n\n\t\tif kind == \"Bullet\" then\n\t\t\tlocal seg = p.pos - prev\n\t\t\tlocal wall = seg.Magnitude > 0 and workspace:Raycast(prev, seg, match.rayParams)\n\t\t\tlocal hitC, hitDist = nil, math.huge\n\t\t\tfor _, e in ipairs(match.combatants) do\n\t\t\t\tif e ~= owner and e.alive and e.team ~= owner.team and not isInvulnerable(e, t) then\n\t\t\t\t\tlocal d = distToCapsule(e, prev, p.pos) - p.radius\n\t\t\t\t\tif d <= 0 then\n\t\t\t\t\t\tlocal along = (e.root.Position - prev).Magnitude\n\t\t\t\t\t\tif along < hitDist then\n\t\t\t\t\t\t\thitC, hitDist = e, along\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\tif hitC and (not wall or (wall.Position - prev).Magnitude >= hitDist - 1) then\n\t\t\t\tendProj(match, p, \"hit\", p.pos)\n\t\t\t\tCombat.Damage(match, hitC, p.damage, owner, {\n\t\t\t\t\tdownPower = p.downPower,\n\t\t\t\t\tknock = p.knock,\n\t\t\t\t\tup = p.up,\n\t\t\t\t\tforceDown = p.forceDown,\n\t\t\t\t\tdir = Util.flat(p.dir),\n\t\t\t\t\tpos = p.pos,\n\t\t\t\t\tsource = p.source,\n\t\t\t\t})\n\t\t\telseif wall then\n\t\t\t\tendProj(match, p, \"wall\", wall.Position)\n\t\t\telseif p.age >= p.life then\n\t\t\t\tendProj(match, p, \"expire\", p.pos)\n\t\t\tend\n\t\telseif kind == \"Bomb\" then\n\t\t\tlocal direct = false\n\t\t\tfor _, e in ipairs(match.combatants) do\n\t\t\t\tif e ~= owner and e.alive and e.team ~= owner.team and not isInvulnerable(e, t) then\n\t\t\t\t\tif distToCapsule(e, prev, p.pos) <= p.radius then\n\t\t\t\t\t\tdirect = true\n\t\t\t\t\t\tbreak\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\tif direct or p.landed then\n\t\t\t\tendProj(match, p, \"explode\", p.pos)\n\t\t\t\tspawnBlast(match, owner, p.pos, p.blast, p.color)\n\t\t\tend\n\t\telseif kind == \"Seeker\" or kind == \"Orbit\" then\n\t\t\tlocal seg = p.pos - prev\n\t\t\tlocal wall = seg.Magnitude > 0 and workspace:Raycast(prev, seg, match.rayParams)\n\t\t\tlocal triggered = false\n\t\t\tfor _, e in ipairs(match.combatants) do\n\t\t\t\tif e ~= owner and e.alive and e.team ~= owner.team and not isInvulnerable(e, t) then\n\t\t\t\t\tif distToCapsule(e, prev, p.pos) <= p.radius then\n\t\t\t\t\t\ttriggered = true\n\t\t\t\t\t\tbreak\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\tif wall and not triggered then\n\t\t\t\tp.pos = wall.Position + wall.Normal * 0.5\n\t\t\tend\n\t\t\tif triggered or wall or p.age >= p.life then\n\t\t\t\texplodePod(match, p)\n\t\t\tend\n\t\telseif kind == \"Mine\" then\n\t\t\tlocal armed = p.landed and p.age >= p.throwTime + p.armTime\n\t\t\tlocal triggered = false\n\t\t\tif armed then\n\t\t\t\tfor _, e in ipairs(match.combatants) do\n\t\t\t\t\tif e ~= owner and e.alive and e.team ~= owner.team and not isInvulnerable(e, t) then\n\t\t\t\t\t\tif (e.root.Position - p.pos).Magnitude - e.info.hitRadius <= p.radius then\n\t\t\t\t\t\t\ttriggered = true\n\t\t\t\t\t\t\tbreak\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\tif triggered or p.age >= p.life then\n\t\t\t\texplodePod(match, p)\n\t\t\tend\n\t\tend\n\tend\n\n\t-- Periodic position sync for slow, long-lived pods so client visuals don't drift.\n\tif t - (match.lastPodSync or 0) > 0.25 then\n\t\tmatch.lastPodSync = t\n\t\tlocal sync = {}\n\t\tfor id, p in pairs(match.projectiles) do\n\t\t\tif p.kind == \"Seeker\" or p.kind == \"Orbit\" then\n\t\t\t\ttable.insert(sync, { id, p.pos, p.dir })\n\t\t\tend\n\t\tend\n\t\tif #sync > 0 then\n\t\t\tmatch:FireAll(\"FX\", \"ProjSync\", sync)\n\t\tend\n\tend\nend\n\nlocal function stepBlasts(match, t: number)\n\tlocal i = 1\n\tlocal blasts = match.blasts\n\twhile i <= #blasts do\n\t\tlocal b = blasts[i]\n\t\tif t >= b.untilT then\n\t\t\ttable.remove(blasts, i)\n\t\telse\n\t\t\tlocal grow = math.clamp((t - b.t0) / 0.15, 0.45, 1)\n\t\t\tlocal r = b.radius * grow\n\t\t\tfor _, e in ipairs(match.combatants) do\n\t\t\t\tif not b.hit[e] and e ~= b.owner and e.alive and e.team ~= b.owner.team and not isInvulnerable(e, t) then\n\t\t\t\t\tlocal lo, hi = capsule(e)\n\t\t\t\t\tlocal d = Util.segSegDist(b.pos, b.pos, lo, hi) - e.info.hitRadius\n\t\t\t\t\tif d <= r then\n\t\t\t\t\t\tb.hit[e] = true\n\t\t\t\t\t\tCombat.Damage(match, e, b.damage, b.owner, {\n\t\t\t\t\t\t\tdownPower = b.downPower,\n\t\t\t\t\t\t\tknock = b.knock,\n\t\t\t\t\t\t\tup = b.up,\n\t\t\t\t\t\t\tdir = Util.flat(e.root.Position - b.pos),\n\t\t\t\t\t\t\tpos = Combat.AimPoint(e),\n\t\t\t\t\t\t\tsource = b.source,\n\t\t\t\t\t\t})\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\ti += 1\n\t\tend\n\tend\nend\n\nlocal function stepCombatant(match, c, dt: number, t: number)\n\tif not c.alive or not c.root or not c.root.Parent then\n\t\treturn\n\tend\n\tlocal gun = c.loadout.Gun\n\n\t-- Down -> Rebirth -> Normal\n\tif c.state == \"Down\" and t >= c.stateUntil then\n\t\tsetState(c, \"Rebirth\", t + M.RebirthTime)\n\t\tc.invulnUntil = t + M.RebirthTime\n\t\tCombat.SyncAttributes(c)\n\t\tmatch:FireAll(\"FX\", \"Rebirth\", { model = c.model })\n\telseif c.state == \"Rebirth\" and t >= c.stateUntil then\n\t\tsetState(c, \"Normal\", 0)\n\tend\n\n\t-- Endurance regen\n\tif c.state ~= \"Down\" and c.endurance < M.EnduranceMax and t - c.lastHitAt > M.EnduranceRegenDelay then\n\t\tlocal before = math.ceil(c.endurance / M.EndurancePerPip)\n\t\tc.endurance = math.min(M.EnduranceMax, c.endurance + M.EnduranceRegenRate * dt)\n\t\tif math.ceil(c.endurance / M.EndurancePerPip) ~= before then\n\t\t\tCombat.SyncAttributes(c)\n\t\tend\n\tend\n\n\tif match.state ~= \"Fight\" then\n\t\treturn\n\tend\n\n\t-- Burst fire + held trigger auto-repeat\n\tif c.burstLeft > 0 and t >= c.nextShotAt and c.state ~= \"Down\" then\n\t\tlocal target = Combat.GetTarget(match, c)\n\t\tlocal from = tipPos(c, \"GunTip\")\n\t\tfireBullet(match, c, target, gun, gun.Color, jitter(aimDir(c, from, target), c.aiAimError or 0), \"Bullet\")\n\t\tif c.burstLeft == gun.Shots then\n\t\t\tonGunFired(match, c, gun)\n\t\tend\n\t\tc.burstLeft -= 1\n\t\tc.nextShotAt = t + gun.ShotInterval\n\tend\n\tif c.gunHeld and gun.Type ~= \"Charge\" and c.state ~= \"Down\" then\n\t\ttriggerGun(match, c)\n\tend\n\n\t-- Body dash attack\n\tif t < c.dashUntil and t - c.lastDashHitAt > 0.6 then\n\t\tfor _, e in ipairs(match.combatants) do\n\t\t\tif e ~= c and e.alive and e.team ~= c.team and not c.dashHit[e] and not isInvulnerable(e, t) then\n\t\t\t\tlocal d = (Util.flat(e.root.Position - c.root.Position)).Magnitude\n\t\t\t\tlocal dy = math.abs(e.root.Position.Y - c.root.Position.Y)\n\t\t\t\tif d <= c.info.hitRadius + e.info.hitRadius + 1.0 and dy < 5 then\n\t\t\t\t\tc.dashHit[e] = true\n\t\t\t\t\tc.lastDashHitAt = t\n\t\t\t\t\tlocal da = c.loadout.Body.DashAttack\n\t\t\t\t\tCombat.Damage(match, e, da.Damage, c, {\n\t\t\t\t\t\tdownPower = da.DownPower,\n\t\t\t\t\t\tknock = da.Knock,\n\t\t\t\t\t\tup = da.Up,\n\t\t\t\t\t\tdir = c.dashDir,\n\t\t\t\t\t\tpos = Combat.AimPoint(e),\n\t\t\t\t\t\tsource = da.Name,\n\t\t\t\t\t})\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\n\t-- Pits\n\tif c.root.Position.Y < match.floorY - M.PitFallDepth then\n\t\tc.hp = math.max(0, c.hp - M.PitDamage)\n\t\tc.stats.damageTaken += M.PitDamage\n\t\tc.invulnUntil = t + M.PitInvuln\n\t\tc.model:PivotTo(c.spawnCF * CFrame.new(0, c.info.rootY + 8, 0))\n\t\tc.root.AssemblyLinearVelocity = Vector3.zero\n\t\tif c.participant.kind == \"Player\" and c.participant.player.Parent then\n\t\t\tmatch.remotes.Match:FireClient(c.participant.player, \"Teleported\")\n\t\telseif c.mover then\n\t\t\tc.mover:ResetVelocity()\n\t\tend\n\t\tCombat.SyncAttributes(c)\n\t\tmatch:FireAll(\"FX\", \"Pit\", { model = c.model, amount = M.PitDamage })\n\t\tif c.hp <= 0 then\n\t\t\tmatch:OnKO(c, nil)\n\t\tend\n\tend\nend\n\nfunction Combat.Step(match, dt: number)\n\tlocal t = now()\n\tfor _, c in ipairs(match.combatants) do\n\t\tstepCombatant(match, c, dt, t)\n\tend\n\tif match.state == \"Fight\" then\n\t\tstepProjectiles(match, dt, t)\n\t\tstepBlasts(match, t)\n\tend\nend\n\nfunction Combat.ClearProjectiles(match)\n\tmatch.projectiles = {}\n\tmatch.blasts = {}\n\tmatch:FireAll(\"FX\", \"ClearProj\", {})\nend\n\nreturn Combat\n","message":"The file /Users/chase-mini/src/rca-work/src/ServerScriptService/RoboClash/CombatService.luau has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"toolu_01CpwTkTiWP8QuMzNU9fGsuM","startedAtMs":"1791074252438","completedAtMs":"1791074253620"},"model_call_id":"f6f75537-51d9-46fb-a6c9-81f06ac674d8-54-e109","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791074253680}
