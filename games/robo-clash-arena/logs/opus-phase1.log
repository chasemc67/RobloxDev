cipant.player)\n+\t\t\tend)\n+\t\tend\n+\telse\n+\t\tpcall(function()\n+\t\t\troot:SetNetworkOwner(nil)\n+\t\tend)\n+\tend\n+end\n+\n+function RobotSpawner.Despawn(participant, model: Model?)\n+\tif participant.kind == \"Player\" and participant.player.Character == model then\n+\t\tparticipant.player.Character = nil\n+\tend\n+\tif model then\n+\t\tmodel:Destroy()\n+\tend\n+end\n+\n+return RobotSpawner","afterFullFileContent":"-- Clones robot models from ServerStorage and turns them into player characters or bot bodies.\nlocal ServerStorage = game:GetService(\"ServerStorage\")\n\nlocal Config = require(game:GetService(\"ReplicatedStorage\").RoboClash.Config)\n\nlocal RobotSpawner = {}\n\nlocal robotsFolder = ServerStorage:WaitForChild(\"RoboClash\"):WaitForChild(\"Robots\")\n\n-- Returns model, info {rootY, hitRadius, capDown, capUp, aimY}\nfunction RobotSpawner.Spawn(participant, spawnCF: CFrame, parent: Instance)\n\tlocal def = Config.RobotById[participant.robotId] or Config.Robots[1]\n\tlocal template = robotsFolder:FindFirstChild(def.Id)\n\tassert(template, \"missing robot model \" .. def.Id)\n\tlocal model = template:Clone()\n\tmodel.Name = participant.kind == \"Player\" and participant.player.Name or (\"CPU_\" .. def.Id)\n\n\tlocal root = model:FindFirstChild(\"HumanoidRootPart\") :: BasePart\n\tlocal hum = model:FindFirstChildOfClass(\"Humanoid\") :: Humanoid\n\tlocal rootY = hum.HipHeight + root.Size.Y / 2\n\n\t-- Measure the hit capsule from the default pose.\n\tlocal _, size = model:GetBoundingBox()\n\tlocal height = size.Y\n\tlocal hitRadius = math.clamp(math.min(size.X, size.Z) * 0.42, 1.9, 3.0)\n\tlocal capDown = math.max(0.2, rootY - hitRadius)\n\tlocal capUp = math.max(0.5, (height - rootY) - hitRadius)\n\tlocal aimY = (capUp - capDown) / 2\n\n\tmodel:SetAttribute(\"RobotId\", def.Id)\n\tmodel:SetAttribute(\"DisplayName\", participant.name)\n\tmodel:SetAttribute(\"Tag\", participant.tag)\n\tmodel:SetAttribute(\"Team\", participant.team)\n\tmodel:SetAttribute(\"Index\", participant.index)\n\tmodel:SetAttribute(\"IsBot\", participant.kind == \"Bot\")\n\tmodel:SetAttribute(\"AimY\", aimY)\n\tmodel:SetAttribute(\"State\", \"Intro\")\n\tmodel:SetAttribute(\"Locked\", true)\n\n\thum.MaxHealth = 100\n\thum.Health = 100\n\n\tmodel:PivotTo(spawnCF * CFrame.new(0, rootY + 0.05, 0))\n\troot.Anchored = true\n\tif participant.kind == \"Player\" then\n\t\tparticipant.player.Character = model\n\tend\n\tmodel.Parent = parent\n\n\treturn model, {\n\t\trootY = rootY,\n\t\thitRadius = hitRadius,\n\t\tcapDown = capDown,\n\t\tcapUp = capUp,\n\t\taimY = aimY,\n\t}\nend\n\nfunction RobotSpawner.Release(participant, model: Model)\n\tlocal root = model:FindFirstChild(\"HumanoidRootPart\") :: BasePart?\n\tif not root then\n\t\treturn\n\tend\n\troot.Anchored = false\n\tif participant.kind == \"Player\" then\n\t\tif participant.player.Parent then\n\t\t\tpcall(function()\n\t\t\t\troot:SetNetworkOwner(participant.player)\n\t\t\tend)\n\t\tend\n\telse\n\t\tpcall(function()\n\t\t\troot:SetNetworkOwner(nil)\n\t\tend)\n\tend\nend\n\nfunction RobotSpawner.Despawn(participant, model: Model?)\n\tif participant.kind == \"Player\" and participant.player.Character == model then\n\t\tparticipant.player.Character = nil\n\tend\n\tif model then\n\t\tmodel:Destroy()\n\tend\nend\n\nreturn RobotSpawner\n","message":"Wrote contents to /Users/chase-mini/src/rca-work/src/ServerScriptService/RoboClash/RobotSpawner.luau"}}},"hookAdditionalContexts":[],"toolCallId":"toolu_01D4yhybSZr4KE9YxMT1VL3v","startedAtMs":"1791073717702","completedAtMs":"1791073725240"},"model_call_id":"f6f75537-51d9-46fb-a6c9-81f06ac674d8-41-dx48","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791073725285}
