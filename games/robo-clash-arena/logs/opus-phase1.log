{"type":"tool_call","subtype":"started","call_id":"toolu_0118LJwnM2Teqjfb59Tvm9M9","tool_call":{"editToolCall":{"args":{"path":"/Users/chase-mini/src/rca-work/src/ReplicatedStorage/RoboClash/Config.luau","streamContent":"--!nocheck\n-- Robo Clash Arena: all tunables. Parts (Bodies/Guns/Bombs/Pods/Legs) are separate tables so\n-- part customization can mix and match later; Robots just reference part ids.\n\nlocal Config = {}\n\nConfig.Match = {\n\tMaxHP = 1000,\n\tDuration = 180, -- seconds\n\tIntroTime = 4.4, -- from match start until LAUNCH! (controls locked)\n\tKOFreezeTime = 1.2, -- time freeze after KO before the victory pose\n\tResultsDelay = 4.2, -- KO -> results screen\n\tDownTime = 1.7,\n\tRebirthTime = 2.6,\n\tDownDamageMult = 0.15,\n\tEnduranceMax = 300, -- 3 DOWN pips x 100\n\tEndurancePerPip = 100,\n\tEnduranceRegenDelay = 2.2,\n\tEnduranceRegenRate = 40, -- per second\n\tFlinchTime = 0.18,\n\tPitDamage = 100,\n\tPitInvuln = 1.5,\n\tPitFallDepth = 22, -- studs below floor that counts as fallen\n\tArenaSpacing = 500,\n\tArenaBaseX = 1000,\n\tArenaHeight = 300,\n\tSpawnRadius = 40,\n\tComboWindow = 1.3,\n\tGravity = 60,\n\tRobotRadius = 2.3, -- hit capsule radius\n\tRobotCapsuleDown = 3.2, -- capsule from root - this ...\n\tRobotCapsuleUp = 2.8, -- ... to root + this\n\tRematchTimeout = 30,\n\tIntentRateLimit = 30, -- max intents per second per player\n}\n\nConfig.Arena = {\n\tHalf = 55, -- arena is 110 x 110 studs\n\tWallHeight = 9,\n\tBarrierHeight = 70,\n}\n\nConfig.TeamColors = {\n\tColor3.fromRGB(70, 170, 255), -- P1\n\tColor3.fromRGB(255, 70, 95), -- P2\n\tColor3.fromRGB(255, 205, 60), -- P3\n\tColor3.fromRGB(90, 235, 120), -- P4\n}\n\n-- Bodies: chassis stats + body dash attack.\nConfig.Bodies = {\n\tBoltFrame = {\n\t\tName = \"Bolt Frame\",\n\t\tKnockbackMult = 1.0,\n\t\tDashAttack = { Name = \"Shoulder Charge\", Damage = 45, Knock = 55, Up = 18, DownPower = 60 },\n\t},\n\tCrusherHull = {\n\t\tName = \"Crusher Hull\",\n\t\tKnockbackMult = 0.7,\n\t\tDashAttack = { Name = \"Iron Ram\", Damage = 75, Knock = 75, Up = 24, DownPower = 110 },\n\t},\n\tLancerSpire = {\n\t\tName = \"Lancer Spire\",\n\t\tKnockbackMult = 1.2,\n\t\tDashAttack = { Name = \"Lance Thrust\", Damage = 40, Knock = 50, Up = 16, DownPower = 50 },\n\t},\n}\n\n-- Legs: movement. JumpPower is jump velocity (studs/s) under Config.Match.Gravity.\nConfig.Legs = {\n\tStrikerLegs = {\n\t\tName = \"Striker Legs\",\n\t\tBlurb = \"Double jump\",\n\t\tWalkSpeed = 24,\n\t\tJumpPower = 40,\n\t\tAirJumps = 1,\n\t\tAirDashes = 1,\n\t\tAirDashSpeed = 52,\n\t\tAirDashTime = 0.22,\n\t\tHover = 0,\n\t\tDashSpeed = 72,\n\t\tDashTime = 0.24,\n\t\tDashCooldown = 0.75,\n\t},\n\tTankLegs = {\n\t\tName = \"Tank Legs\",\n\t\tBlurb = \"Hold jump to hover\",\n\t\tWalkSpeed = 20,\n\t\tJumpPower = 37,\n\t\tAirJumps = 0,\n\t\tAirDashes = 0,\n\t\tAirDashSpeed = 0,\n\t\tAirDashTime = 0,\n\t\tHover = 1.4, -- seconds of hover per jump\n\t\tHoverFall = 2.5, -- max fall speed while hovering\n\t\tDashSpeed = 88,\n\t\tDashTime = 0.3,\n\t\tDashCooldown = 0.95,\n\t},\n\tGlideLegs = {\n\t\tName = \"Glide Legs\",\n\t\tBlurb = \"Two fast air dashes\",\n\t\tWalkSpeed = 23,\n\t\tJumpPower = 42,\n\t\tAirJumps = 0,\n\t\tAirDashes = 2,\n\t\tAirDashSpeed = 78,\n\t\tAirDashTime = 0.24,\n\t\tHover = 0,\n\t\tDashSpeed = 68,\n\t\tDashTime = 0.22,\n\t\tDashCooldown = 0.7,\n\t},\n}\n\n-- Guns (right hand). Turn = homing in degrees/second toward the locked target.\nConfig.Guns = {\n\tRapidBlaster = {\n\t\tName = \"Rapid Blaster\",\n\t\tBlurb = \"3-round homing bursts\",\n\t\tType = \"Burst\",\n\t\tShots = 3,\n\t\tShotInterval = 0.1,\n\t\tDamage = 28,\n\t\tSpeed = 110,\n\t\tTurn = 95,\n\t\tLife = 1.4,\n\t\tRadius = 0.7,\n\t\tDownPower = 24,\n\t\tKnock = 10,\n\t\tUp = 4,\n\t\tClip = 3,\n\t\tReload = 1.4,\n\t\tCooldown = 0.5,\n\t\tMoveSlow = 0.55,\n\t\tSlowTime = 0.35,\n\t\tColor = Color3.fromRGB(90, 220, 255),\n\t\tSize = 0.9,\n\t},\n\tScatterCannon = {\n\t\tName = \"Scatter Cannon\",\n\t\tBlurb = \"5-way close-range spread\",\n\t\tType = \"Spread\",\n\t\tPellets = 5,\n\t\tSpreadDeg = 46,\n\t\tDamage = 26,\n\t\tSpeed = 92,\n\t\tTurn = 22,\n\t\tLife = 0.6,\n\t\tRadius = 0.9,\n\t\tDownPower = 28,\n\t\tKnock = 26,\n\t\tUp = 8,\n\t\tClip = 2,\n\t\tReload = 1.5,\n\t\tCooldown = 0.8,\n\t\tMoveSlow = 0.35,\n\t\tSlowTime = 0.4,\n\t\tColor = Color3.fromRGB(255, 150, 60),\n\t\tSize = 1.0,\n\t},\n\tChargeLaser = {\n\t\tName = \"Charge Laser\",\n\t\tBlurb = \"Hold to charge a piercing beam\",\n\t\tType = \"Charge\",\n\t\tChargeTime = 0.8,\n\t\tChargeMoveSlow = 0.45,\n\t\tCooldown = 0.45,\n\t\tMoveSlow = 0.3,\n\t\tSlowTime = 0.35,\n\t\tTap = {\n\t\t\tDamage = 34,\n\t\t\tSpeed = 150,\n\t\t\tTurn = 70,\n\t\t\tLife = 1.0,\n\t\t\tRadius = 0.7,\n\t\t\tDownPower = 35,\n\t\t\tKnock = 14,\n\t\t\tUp = 5,\n\t\t\tSize = 0.8,\n\t\t},\n\t\tFull = {\n\t\t\tDamage = 150,\n\t\t\tSpeed = 250,\n\t\t\tTurn = 22,\n\t\t\tLife = 0.75,\n\t\t\tRadius = 1.4,\n\t\t\tDownPower = 300,\n\t\t\tForceDown = true,\n\t\t\tKnock = 60,\n\t\t\tUp = 22,\n\t\t\tSize = 1.6,\n\t\t},\n\t\tColor = Color3.fromRGB(170, 255, 90),\n\t},\n}\n\n-- Bombs (left hand): high arc toward the target that clears walls, lingering blast.\nConfig.Bombs = {\n\tArcBomb = {\n\t\tName = \"Arc Bomb\",\n\t\tBlurb = \"Lingering splash blast\",\n\t\tCount = 1,\n\t\tSpread = 0,\n\t\tDamage = 90,\n\t\tRadius = 10,\n\t\tLinger = 0.9,\n\t\tFlightTime = 1.15,\n\t\tApex = 24,\n\t\tMaxRange = 78,\n\t\tMinRange = 10,\n\t\tLead = 0.5,\n\t\tCooldown = 2.6,\n\t\tDownPower = 75,\n\t\tKnock = 40,\n\t\tUp = 26,\n\t\tStall = 0.25,\n\t\tColor = Color3.fromRGB(80, 160, 255),\n\t},\n\tQuakeBomb = {\n\t\tName = \"Quake Bomb\",\n\t\tBlurb = \"Slow, huge heavy blast\",\n\t\tCount = 1,\n\t\tSpread = 0,\n\t\tDamage = 120,\n\t\tRadius = 13.5,\n\t\tLinger = 1.0,\n\t\tFlightTime = 1.45,\n\t\tApex = 28,\n\t\tMaxRange = 68,\n\t\tMinRange = 8,\n\t\tLead = 0.35,\n\t\tCooldown = 3.2,\n\t\tDownPower = 110,\n\t\tKnock = 52,\n\t\tUp = 30,\n\t\tStall = 0.35,\n\t\tColor = Color3.