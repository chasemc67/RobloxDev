* 2, STICK_R * 2),\n\t\tAnchorPoint = Vector2.new(0.5, 0.5),\n\t\tPosition = UDim2.new(0, 170, 1, -180),\n\t\tParent = zone,\n\t})\n\tStyle.corner(stickBase, STICK_R)\n\tStyle.stroke(stickBase, Color3.fromRGB(80, 230, 255), 3, 0.3)\n\tstickKnob = Style.new(\"Frame\", {\n\t\tName = \"Knob\",\n\t\tBackgroundColor3 = Color3.fromRGB(80, 230, 255),\n\t\tBackgroundTransparency = 0.2,\n\t\tSize = UDim2.fromOffset(64, 64),\n\t\tAnchorPoint = Vector2.new(0.5, 0.5),\n\t\tPosition = UDim2.fromScale(0.5, 0.5),\n\t\tParent = stickBase,\n\t})\n\tStyle.corner(stickKnob, 32)\n\tlocal restPos = stickBase.Position\n\n\tzone.InputBegan:Connect(function(input)\n\t\tif input.UserInputType ~= Enum.UserInputType.Touch or stickInput then\n\t\t\treturn\n\t\tend\n\t\tstickInput = input\n\t\tlocal s = getScale()\n\t\tlocal p = Vector2.new(input.Position.X, input.Position.Y)\n\t\tstickOrigin = p\n\t\t-- InputObject positions exclude the top bar inset; our ScreenGuis ignore it.\n\t\tlocal rel = (p + GuiService:GetGuiInset() - zone.AbsolutePosition) / s\n\t\tstickBase.Position = UDim2.fromOffset(rel.X, rel.Y)\n\t\tstickBase.BackgroundTransparency = 0.25\n\tend)\n\tUserInputService.InputChanged:Connect(function(input)\n\t\tif input ~= stickInput then\n\t\t\treturn\n\t\tend\n\t\tlocal s = getScale()\n\t\tlocal d = (Vector2.new(input.Position.X, input.Position.Y) - stickOrigin) / s\n\t\tif d.Magnitude > STICK_R then\n\t\t\td = d.Unit * STICK_R\n\t\tend\n\t\tstickKnob.Position = UDim2.new(0.5, d.X, 0.5, d.Y)\n\t\tlocal m = d / STICK_R\n\t\tTouch.move = m.Magnitude < 0.12 and Vector2.zero or m\n\tend)\n\tUserInputService.InputEnded:Connect(function(input)\n\t\tif input ~= stickInput then\n\t\t\treturn\n\t\tend\n\t\tstickInput = nil\n\t\tTouch.move = Vector2.zero\n\t\tstickKnob.Position = UDim2.fromScale(0.5, 0.5)\n\t\tstickBase.Position = restPos\n\t\tstickBase.BackgroundTransparency = 0.45\n\tend)\n\n\tmakeButton(\"Gun\", \"GUN\", 150, UDim2.new(1, -130, 1, -150), Color3.fromRGB(90, 220, 255))\n\tmakeButton(\"Bomb\", \"BOMB\", 104, UDim2.new(1, -290, 1, -110), Color3.fromRGB(255, 160, 60))\n\tmakeButton(\"Pod\", \"POD\", 104, UDim2.new(1, -250, 1, -250), Color3.fromRGB(190, 255, 90))\n\tmakeButton(\"Jump\", \"JUMP\", 104, UDim2.new(1, -110, 1, -320), Color3.fromRGB(255, 255, 255))\n\tmakeButton(\"Dash\", \"DASH\", 92, UDim2.new(1, -400, 1, -220), Color3.fromRGB(255, 90, 170))\nend\n\nfunction Touch.SetActive(on: boolean)\n\tactive = on\n\tframe.Visible = on and Touch.Enabled()\n\tif not frame.Visible then\n\t\tTouch.move = Vector2.zero\n\tend\nend\n\nfunction Touch.Refresh()\n\tTouch.SetActive(active)\nend\n\nfunction Touch.IsVisible(): boolean\n\treturn frame and frame.Visible\nend\n\nreturn Touch\n","afterFullFileContent":"-- Touch controls: dynamic thumbstick (left half) + big action buttons (right). Shown only on\n-- touch devices (or when the player has the ForceTouch attribute, for layout testing).\nlocal GuiService = game:GetService(\"GuiService\")\nlocal Players = game:GetService(\"Players\")\nlocal UserInputService = game:GetService(\"UserInputService\")\n\nlocal Style = require(script.Parent.Style)\n\nlocal Touch = {}\nTouch.move = Vector2.zero -- x right, y down, magnitude <= 1\n\nlocal frame: Frame\nlocal stickBase: Frame\nlocal stickKnob: Frame\nlocal getScale: () -> number\nlocal onAction: (string, boolean) -> ()\nlocal active = false\nlocal stickInput: InputObject? = nil\nlocal stickOrigin = Vector2.zero\nlocal STICK_R = 70\n\nfunction Touch.Enabled(): boolean\n\treturn UserInputService.TouchEnabled or Players.LocalPlayer:GetAttribute(\"ForceTouch\") == true\nend\n\nlocal function makeButton(name: string, label: string, size: number, pos: UDim2, color: Color3)\n\tlocal b = Style.new(\"TextButton\", {\n\t\tName = name,\n\t\tAutoButtonColor = false,\n\t\tText = \"\",\n\t\tBackgroundColor3 = Color3.fromRGB(14, 18, 40),\n\t\tBackgroundTransparency = 0.25,\n\t\tSize = UDim2.fromOffset(size, size),\n\t\tAnchorPoint = Vector2.new(0.5, 0.5),\n\t\tPosition = pos,\n\t\tSelectable = false,\n\t\tParent = frame,\n\t})\n\tStyle.corner(b, size)\n\tlocal st = Style.stroke(b, color, 3, 0.1)\n\tStyle.label(b, label, math.floor(size * 0.24), { Size = UDim2.fromScale(1, 1), TextColor3 = color })\n\tlocal held: InputObject? = nil\n\tb.InputBegan:Connect(function(input)\n\t\tif input.UserInputType == Enum.UserInputType.Touch and not held then\n\t\t\theld = input\n\t\t\tb.BackgroundTransparency = 0\n\t\t\tb.BackgroundColor3 = color:Lerp(Color3.new(0, 0, 0), 0.4)\n\t\t\tst.Thickness = 5\n\t\t\tonAction(name, true)\n\t\tend\n\tend)\n\tlocal function release(input)\n\t\tif held == input then\n\t\t\theld = nil\n\t\t\tb.BackgroundTransparency = 0.25\n\t\t\tb.BackgroundColor3 = Color3.fromRGB(14, 18, 40)\n\t\t\tst.Thickness = 3\n\t\t\tonAction(name, false)\n\t\tend\n\tend\n\tb.InputEnded:Connect(release)\n\tUserInputService.InputEnded:Connect(release)\n\treturn b\nend\n\nfunction Touch.Init(uiRoot: Frame, scaleGetter: () -> number, actionHandler: (string, boolean) -> ())\n\tgetScale = scaleGetter\n\tonAction = actionHandler\n\tframe = Style.new(\"Frame\", { Name = \"Touch\", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = uiRoot })\n\tlocal zone = Style.new(\"Frame\", {\n\t\tName = \"StickZone\",\n\t\tBackgroundTransparency = 1,\n\t\tSize = UDim2.new(0.45, 0, 0.62, 0),\n\t\tAnchorPoint = Vector2.new(0, 1),\n\t\tPosition = UDim2.fromScale(0, 1),\n\t\tActive = true,\n\t\tParent = frame,\n\t})\n\tstickBase = Style.new(\"Frame\", {\n\t\tName = \"StickBase\",\n\t\tBackgroundColor3 = Color3.fromRGB(14, 18, 40),\n\t\tBackgroundTransparency = 0.45,\n\t\tSize = UDim2.fromOffset(STICK_R * 2, STICK_R * 2),\n\t\tAnchorPoint = Vector2.new(0.5, 0.5),\n\t\tPosition = UDim2.new(0, 170, 1, -180),\n\t\tParent = zone,\n\t})\n\tStyle.corner(stickBase, STICK_R)\n\tStyle.stroke(stickBase, Color3.fromRGB(80, 230, 255), 3, 0.3)\n\tstickKnob = Style.new(\"Frame\", {\n\t\tName = \"Knob\",\n\t\tBackgroundColor3 = Color3.fromRGB(80, 230, 255),\n\t\tBackgroundTransparency = 0.2,\n\t\tSize = UDim2.fromOffset(64, 64),\n\t\tAnchorPoint = Vector2.new(0.5, 0.5),\n\t\tPosition = UDim2.fromScale(0.5, 0.5),\n\t\tParent = stickBase,\n\t})\n\tStyle.corner(stickKnob, 32)\n\tlocal restPos = stickBase.Position\n\n\tzone.InputBegan:Connect(function(input)\n\t\tif input.UserInputType ~= Enum.UserInputType.Touch or stickInput then\n\t\t\treturn\n\t\tend\n\t\tstickInput = input\n\t\tlocal s = getScale()\n\t\tlocal p = Vector2.new(input.Position.X, input.Position.Y)\n\t\tstickOrigin = p\n\t\t-- InputObject positions exclude the top bar inset; our ScreenGuis ignore it.\n\t\tlocal rel = (p + GuiService:GetGuiInset() - zone.AbsolutePosition) / s\n\t\tstickBase.Position = UDim2.fromOffset(rel.X, rel.Y)\n\t\tstickBase.BackgroundTransparency = 0.25\n\tend)\n\tUserInputService.InputChanged:Connect(function(input)\n\t\tif input ~= stickInput then\n\t\t\treturn\n\t\tend\n\t\tlocal s = getScale()\n\t\tlocal d = (Vector2.new(input.Position.X, input.Position.Y) - stickOrigin) / s\n\t\tif d.Magnitude > STICK_R then\n\t\t\td = d.Unit * STICK_R\n\t\tend\n\t\tstickKnob.Position = UDim2.new(0.5, d.X, 0.5, d.Y)\n\t\tlocal m = d / STICK_R\n\t\tTouch.move = m.Magnitude < 0.12 and Vector2.zero or m\n\tend)\n\tUserInputService.InputEnded:Connect(function(input)\n\t\tif input ~= stickInput then\n\t\t\treturn\n\t\tend\n\t\tstickInput = nil\n\t\tTouch.move = Vector2.zero\n\t\tstickKnob.Position = UDim2.fromScale(0.5, 0.5)\n\t\tstickBase.Position = restPos\n\t\tstickBase.BackgroundTransparency = 0.45\n\tend)\n\n\tmakeButton(\"Gun\", \"GUN\", 150, UDim2.new(1, -130, 1, -150), Color3.fromRGB(90, 220, 255))\n\tmakeButton(\"Bomb\", \"BOMB\", 104, UDim2.new(1, -290, 1, -110), Color3.fromRGB(255, 160, 60))\n\tmakeButton(\"Pod\", \"POD\", 104, UDim2.new(1, -250, 1, -250), Color3.fromRGB(190, 255, 90))\n\tmakeButton(\"Jump\", \"JUMP\", 104, UDim2.new(1, -110, 1, -320), Color3.fromRGB(255, 255, 255))\n\tmakeButton(\"Dash\", \"DASH\", 92, UDim2.new(1, -400, 1, -220), Color3.fromRGB(255, 90, 170))\nend\n\nfunction Touch.SetActive(on: boolean)\n\tactive = on\n\tframe.Visible = on and Touch.Enabled()\n\tif not frame.Visible then\n\t\tTouch.move = Vector2.zero\n\tend\nend\n\nfunction Touch.Refresh()\n\tTouch.SetActive(active)\nend\n\nfunction Touch.IsVisible(): boolean\n\treturn frame and frame.Visible\nend\n\nreturn Touch\n","message":"The file /Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/Touch.luau has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"toolu_01KiaguMWQBL5bZwseh59rTA","startedAtMs":"1791074502463","completedAtMs":"1791074503565"},"model_call_id":"f6f75537-51d9-46fb-a6c9-81f06ac674d8-69-bbfj","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791074503590}
