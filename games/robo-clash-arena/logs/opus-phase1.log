ocal s = Instance.new(\"Sound\")\n+\t\t\ts.SoundId = id\n+\t\t\ttable.insert(list, s)\n+\t\tend\n+\tend\n+\ttask.spawn(function()\n+\t\tpcall(function()\n+\t\t\tContentProvider:PreloadAsync(list)\n+\t\tend)\n+\tend)\n+end\n+\n+local lastPlayed = {}\n+\n+function Sound.Play(name: string, opts): Sound?\n+\tlocal id = idFor(name)\n+\tif not id then\n+\t\treturn nil\n+\tend\n+\topts = opts or {}\n+\tlocal t = os.clock()\n+\tif not opts.force and lastPlayed[name] and t - lastPlayed[name] < 0.03 then\n+\t\treturn nil\n+\tend\n+\tlastPlayed[name] = t\n+\tlocal s = Instance.new(\"Sound\")\n+\ts.SoundId = id\n+\ts.Volume = (VOLUME[name] or 0.5) * (opts.volume or 1)\n+\ts.PlaybackSpeed = (opts.pitch or 1) * (1 + (math.random() - 0.5) * (opts.vary or 0.08))\n+\ts.Looped = opts.loop == true\n+\ts.SoundGroup = group\n+\ts.Parent = SoundService\n+\ts:Play()\n+\tif not s.Looped then\n+\t\ts.Ended:Connect(function()\n+\t\t\ts:Destroy()\n+\t\tend)\n+\t\ttask.delay(8, function()\n+\t\t\tif s.Parent then\n+\t\t\t\ts:Destroy()\n+\t\t\tend\n+\t\tend)\n+\tend\n+\treturn s\n+end\n+\n+return Sound","afterFullFileContent":"-- 2D sound playback by name (ids live in Config.Sounds; empty ids fall back or no-op).\nlocal ContentProvider = game:GetService(\"ContentProvider\")\nlocal SoundService = game:GetService(\"SoundService\")\n\nlocal Config = require(game:GetService(\"ReplicatedStorage\").RoboClash.Config)\n\nlocal Sound = {}\n\nlocal FALLBACK = {\n\tExplosion = \"rbxasset://sounds/impact_explosion_03.mp3\",\n\tJump = \"rbxasset://sounds/action_jump.mp3\",\n\tLand = \"rbxasset://sounds/action_jump_land.mp3\",\n}\n\nlocal VOLUME = {\n\tMusic = 0.25,\n\tExplosion = 0.55,\n\tBlaster = 0.4,\n\tShotgun = 0.5,\n\tLaser = 0.55,\n\tCharge = 0.35,\n\tHit = 0.5,\n\tHeavyHit = 0.65,\n\tJump = 0.3,\n\tDash = 0.4,\n\tUIMove = 0.3,\n\tUISelect = 0.45,\n\tUIBack = 0.4,\n}\n\nlocal group = Instance.new(\"SoundGroup\")\ngroup.Name = \"RoboClashSFX\"\ngroup.Volume = 1\ngroup.Parent = SoundService\n\nlocal function idFor(name: string): string?\n\tlocal id = Config.Sounds[name]\n\tif id and id ~= \"\" then\n\t\treturn id\n\tend\n\treturn FALLBACK[name]\nend\n\nfunction Sound.Preload()\n\tlocal list = {}\n\tfor name in pairs(Config.Sounds) do\n\t\tlocal id = idFor(name)\n\t\tif id then\n\t\t\tlocal s = Instance.new(\"Sound\")\n\t\t\ts.SoundId = id\n\t\t\ttable.insert(list, s)\n\t\tend\n\tend\n\ttask.spawn(function()\n\t\tpcall(function()\n\t\t\tContentProvider:PreloadAsync(list)\n\t\tend)\n\tend)\nend\n\nlocal lastPlayed = {}\n\nfunction Sound.Play(name: string, opts): Sound?\n\tlocal id = idFor(name)\n\tif not id then\n\t\treturn nil\n\tend\n\topts = opts or {}\n\tlocal t = os.clock()\n\tif not opts.force and lastPlayed[name] and t - lastPlayed[name] < 0.03 then\n\t\treturn nil\n\tend\n\tlastPlayed[name] = t\n\tlocal s = Instance.new(\"Sound\")\n\ts.SoundId = id\n\ts.Volume = (VOLUME[name] or 0.5) * (opts.volume or 1)\n\ts.PlaybackSpeed = (opts.pitch or 1) * (1 + (math.random() - 0.5) * (opts.vary or 0.08))\n\ts.Looped = opts.loop == true\n\ts.SoundGroup = group\n\ts.Parent = SoundService\n\ts:Play()\n\tif not s.Looped then\n\t\ts.Ended:Connect(function()\n\t\t\ts:Destroy()\n\t\tend)\n\t\ttask.delay(8, function()\n\t\t\tif s.Parent then\n\t\t\t\ts:Destroy()\n\t\t\tend\n\t\tend)\n\tend\n\treturn s\nend\n\nreturn Sound\n","message":"Wrote contents to /Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/Sound.luau"}}},"hookAdditionalContexts":[],"toolCallId":"toolu_01KLptrexASaiomH2753azdG","startedAtMs":"1791074163464","completedAtMs":"1791074169832"},"model_call_id":"f6f75537-51d9-46fb-a6c9-81f06ac674d8-52-94eu","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791074169886}
