turn Config.Match.IntroTime + rand(0.4, 0.9)\n+end\n+\n+function BotAI.Detach(c)\n+\tc.ai = nil\n+\tc.mover = nil\n+end\n+\n+local function think(match, c, ai, mover, t: number)\n+\tlocal target = Combat.GetTarget(match, c)\n+\tif not target then\n+\t\tmover.moveInput = Vector3.zero\n+\t\treturn\n+\tend\n+\tlocal pos = c.root.Position\n+\tlocal tpos = target.root.Position\n+\tlocal to = Util.flat(tpos - pos)\n+\tlocal dist = to.Magnitude\n+\tlocal dirT = Util.flatUnit(to)\n+\n+\t-- Movement: strafe around the target while holding preferred range.\n+\tif t >= ai.nextFlip then\n+\t\tai.strafeSign = -ai.strafeSign\n+\t\tai.nextFlip = t + rand(1.0, 3.2)\n+\tend\n+\tlocal perp = Vector3.new(-dirT.Z, 0, dirT.X) * ai.strafeSign\n+\tlocal radial = 0\n+\tif dist > ai.pref + 8 then\n+\t\tradial = 1\n+\telseif dist < ai.pref - 6 then\n+\t\tradial = -1\n+\tend\n+\tlocal want = perp * 0.85 + dirT * radial\n+\tlocal rel = pos - match.origin.Position\n+\tlocal half = Config.Arena.Half - 8\n+\tif rel.X > half then\n+\t\twant -= Vector3.xAxis * 1.5\n+\telseif rel.X < -half then\n+\t\twant += Vector3.xAxis * 1.5\n+\tend\n+\tif rel.Z > half then\n+\t\twant -= Vector3.zAxis * 1.5\n+\telseif rel.Z < -half then\n+\t\twant += Vector3.zAxis * 1.5\n+\tend\n+\tlocal dirW = want.Magnitude > 0.05 and Util.flatUnit(want) or Vector3.zero\n+\tif dirW.Magnitude > 0 then\n+\t\tlocal ahead = pos + dirW * 7\n+\t\tlocal ground = workspace:Raycast(ahead + Vector3.new(0, 2, 0), Vector3.new(0, -25, 0), match.rayParams)\n+\t\tif not ground then\n+\t\t\t-- pit ahead: turn around\n+\t\t\tai.strafeSign = -ai.strafeSign\n+\t\t\tai.nextFlip = t + 1.5\n+\t\t\tdirW = Util.flatUnit(-dirW + dirT * 0.3)\n+\t\tend\n+\t\tlocal wall = workspace:Raycast(pos, dirW * 5, match.rayParams)\n+\t\tif wall and wall.Instance:IsA(\"BasePart\") then\n+\t\t\tif wall.Instance.Size.Y <= 6 and mover:IsGrounded() then\n+\t\t\t\tmover:Jump()\n+\t\t\telse\n+\t\t\t\tai.strafeSign = -ai.strafeSign\n+\t\t\t\tai.nextFlip = t + 1.2\n+\t\t\tend\n+\t\tend\n+\tend\n+\tmover.moveInput = dirW\n+\n+\t-- Stuck detection\n+\tif t >= ai.stuckCheckAt then\n+\t\tif (pos - ai.lastPos).Magnitude < 2 and dirW.Magnitude > 0 then\n+\t\t\tmover:Jump()\n+\t\t\tai.strafeSign = -ai.strafeSign\n+\t\tend\n+\t\tai.lastPos = pos\n+\t\tai.stuckCheckAt = t + 1.2\n+\tend\n+\n+\t-- Line of sight + reaction delay before firing.\n+\tlocal from = Combat.AimPoint(c)\n+\tlocal los = workspace:Raycast(from, Combat.AimPoint(target) - from, match.rayParams) == nil\n+\tif los then\n+\t\tai.losSince = ai.losSince or t\n+\telse\n+\t\tai.losSince = nil\n+\tend\n+\n+\tlocal gun = c.loadout.Gun\n+\tlocal gunRange = gun.Type == \"Charge\" and 130 or gun.Speed * gun.Life * 0.9\n+\tlocal targetVulnerable = not Combat.IsInvulnerable(target, t)\n+\tif ai.losSince and t - ai.losSince >= ai.reaction and dist < gunRange and t >= ai.nextGun and targetVulnerable then\n+\t\tif gun.Type == \"Charge\" then\n+\t\t\tif not c.chargeStart then\n+\t\t\t\tCombat.HandleIntent(match, c, \"GunDown\")\n+\t\t\t\tlocal full = math.random() < 0.7\n+\t\t\t\tai.gunReleaseAt = t + (full and gun.ChargeTime + rand(0.05, 0.3) or 0.12)\n+\t\t\t\tai.nextGun = ai.gunReleaseAt + rand(0.5, 1.2)\n+\t\t\tend\n+\t\telse\n+\t\t\tCombat.HandleIntent(match, c, \"GunDown\")\n+\t\t\tai.gunReleaseAt = t + 0.12\n+\t\t\tai.nextGun = t + gun.Cooldown + rand(0.2, 0.9)\n+\t\tend\n+\tend\n+\n+\tif t >= ai.nextBomb and dist > 12 and dist < c.loadout.Bomb.MaxRange + 10 and targetVulnerable then\n+\t\tCombat.HandleIntent(match, c, \"Bomb\")\n+\t\tai.nextBomb = t + c.loadout.Bomb.Cooldown + rand(0.6, 2.2)\n+\tend\n+\tif t >= ai.nextPod and dist < 75 and targetVulnerable then\n+\t\tCombat.HandleIntent(match, c, \"Pod\")\n+\t\tai.nextPod = t + c.loadout.Pod.Cooldown + rand(0.8, 3)\n+\tend\n+\n+\t-- Close-range body dash attack (Crusher loves this).\n+\tlocal dashChance = c.loadout.Robot.Id == \"Crusher\" and 0.12 or 0.05\n+\tif dist < 14 and targetVulnerable and math.random() < dashChance then\n+\t\tmover.moveInput = dirT\n+\t\tlocal kind = mover:Dash()\n+\t\tif kind then\n+\t\t\tCombat.HandleIntent(match, c, \"Dash\", { dir = dirT, air = kind == \"airdash\" })\n+\t\tend\n+\tend\n+\n+\tif t >= ai.nextJump then\n+\t\tai.nextJump = t + rand(2.5, 6)\n+\t\tif math.random() < 0.5 then\n+\t\t\tmover:Jump()\n+\t\tend\n+\tend\n+\n+\t-- Plan a dodge against incoming fire.\n+\tif not ai.dodgeAt and t - ai.lastDodge > 1.3 then\n+\t\tfor _, p in pairs(match.projectiles) do\n+\t\t\tif p.owner ~= c and p.target == c then\n+\t\t\t\tlocal relP = pos - p.pos\n+\t\t\t\tif p.kind == \"Bullet\" and relP.Magnitude < 32 and p.dir:Dot(relP.Unit) > 0.8 then\n+\t\t\t\t\tai.lastDodge = t\n+\t\t\t\t\tif math.random() < 0.45 then\n+\t\t\t\t\t\tai.dodgeAt = t + rand(0.15, 0.35)\n+\t\t\t\t\t\tai.dodgeDir = perp\n+\t\t\t\t\tend\n+\t\t\t\t\tbreak\n+\t\t\t\telseif p.kind == \"Bomb\" and Util.flat(p.finish - pos).Magnitude < p.blast.Radius + 2 then\n+\t\t\t\t\tai.lastDodge = t\n+\t\t\t\t\tif math.random() < 0.55 then\n+\t\t\t\t\t\tai.dodgeAt = t + rand(0.2, 0.45)\n+\t\t\t\t\t\tai.dodgeDir = Util.flatUnit(pos - p.finish, perp)\n+\t\t\t\t\tend\n+\t\t\t\t\tbreak\n+\t\t\t\tend\n+\t\t\tend\n+\t\tend\n+\tend\n+end\n+\n+function BotAI.Step(match, c, dt: number)\n+\tlocal ai, mover = c.ai, c.mover\n+\tif not ai or not mover or not c.root or not c.root.Parent then\n+\t\treturn\n+\tend\n+\tlocal locked = match.state ~= \"Fight\" or c.state == \"Down\" or not c.alive\n+\tif locked ~= mover.locked then\n+\t\tmover:SetLocked(locked)\n+\tend\n+\tlocal t = now()\n+\tif not locked then\n+\t\tif t >= ai.nextThink then\n+\t\t\tai.nextThink = t + 0.1\n+\t\t\tthink(match, c, ai, mover, t)\n+\t\tend\n+\t\tif ai.dodgeAt and t >= ai.dodgeAt then\n+\t\t\tai.dodgeAt = nil\n+\t\t\tmover.moveInput = ai.dodgeDir or mover.moveInput\n+\t\t\tif math.random() < 0.65 then\n+\t\t\t\tlocal kind = mover:Dash()\n+\t\t\t\tif kind then\n+\t\t\t\t\tCombat.HandleIntent(match, c, \"Dash\", { dir = mover.moveInput, air = kind == \"airda