{"type":"tool_call","subtype":"started","call_id":"toolu_01FaFTKpJdAdPNh5Lsnv4Sz9","tool_call":{"editToolCall":{"args":{"path":"/Users/chase-mini/src/rca-work/src/ReplicatedStorage/RoboClash/Shared/ProjectileSim.luau","streamContent":"-- Deterministic projectile motion shared by server (authoritative hits) and clients (visuals).\nlocal Util = require(script.Parent.Util)\n\nlocal Sim = {}\n\n-- p fields: kind, pos, dir, speed, turn (rad/s), age, life, homing, target (Model)\n-- Bomb: start, finish, flight, apex. Mine: start, finish, throwTime.\n-- Seeker: floorY, hover, climb. Orbit: launchDir, launchTime, launchSpeed.\nfunction Sim.step(p, dt: number, targetPos: Vector3?): Vector3\n\tp.age += dt\n\tlocal prev = p.pos\n\tlocal kind = p.kind\n\tif kind == \"Bomb\" then\n\t\tlocal a = math.clamp(p.age / p.flight, 0, 1)\n\t\tp.pos = p.start:Lerp(p.finish, a) + Vector3.new(0, 4 * p.apex * a * (1 - a), 0)\n\t\tp.landed = a >= 1\n\telseif kind == \"Bullet\" then\n\t\tif p.homing and targetPos and p.turn > 0 then\n\t\t\tlocal to = targetPos - p.pos\n\t\t\tif to.Magnitude > 0.5 then\n\t\t\t\tlocal desired = to.Unit\n\t\t\t\tif desired:Dot(p.dir) < 0.15 then\n\t\t\t\t\tp.homing = false -- flew past the target: stop tracking so it can be dodged\n\t\t\t\telse\n\t\t\t\t\tp.dir = Util.rotateTowards(p.dir, desired, p.turn * dt)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\tif p.accel then\n\t\t\tp.speed += p.accel * dt\n\t\tend\n\t\tp.pos += p.dir * p.speed * dt\n\telseif kind == \"Seeker\" then\n\t\tif targetPos then\n\t\t\tlocal to = Util.flat(targetPos - p.pos)\n\t\t\tif to.Magnitude > 0.2 then\n\t\t\t\tlocal cur = Util.flatUnit(p.dir)\n\t\t\t\tp.dir = Util.rotateTowards(cur, to.Unit, p.turn * dt)\n\t\t\tend\n\t\tend\n\t\tlocal y = p.pos.Y\n\t\tlocal desiredY = p.floorY + p.hover\n\t\tif targetPos then\n\t\t\tdesiredY = math.max(desiredY, targetPos.Y - 1)\n\t\tend\n\t\tlocal dy = math.clamp(desiredY - y, -p.climb * dt, p.climb * dt)\n\t\tp.pos = p.pos + Util.flat(p.dir) * p.speed * dt + Vector3.new(0, dy, 0)\n\telseif kind == \"Orbit\" then\n\t\tif p.age < p.launchTime then\n\t\t\tp.pos += p.launchDir * p.launchSpeed * dt\n\t\telse\n\t\t\tif targetPos then\n\t\t\t\tlocal to = targetPos - p.pos\n\t\t\t\tif to.Magnitude > 0.2 then\n\t\t\t\t\tp.dir = Util.rotateTowards(p.dir, to.Unit, p.turn * dt)\n\t\t\t\tend\n\t\t\tend\n\t\t\tp.pos += p.dir * p.speed * dt\n\t\tend\n\telseif kind == \"Mine\" then\n\t\tlocal a = math.clamp(p.age / p.throwTime, 0, 1)\n\t\tp.pos = p.start:Lerp(p.finish, a) + Vector3.new(0, 4 * 5 * a * (1 - a), 0)\n\t\tp.landed = a >= 1\n\tend\n\treturn prev\nend\n\n-- Advance a freshly spawned projectile by `elapsed` seconds (latency compensation on clients).\nfunction Sim.fastForward(p, elapsed: number, targetPos: Vector3?)\n\tlocal stepSize = 1 / 60\n\tlocal remaining = math.min(elapsed, 0.3)\n\twhile remaining > 1e-4 do\n\t\tlocal dt = math.min(stepSize, remaining)\n\t\tSim.step(p, dt, targetPos)\n\t\tremaining -= dt\n\tend\nend\n\nreturn Sim\n"}},"hookAdditionalContexts":[],"toolCallId":"toolu_01FaFTKpJdAdPNh5Lsnv4Sz9","startedAtMs":"1791073277582"},"model_call_id":"f6f75537-51d9-46fb-a6c9-81f06ac674d8-24-cq4d","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791073286498}
