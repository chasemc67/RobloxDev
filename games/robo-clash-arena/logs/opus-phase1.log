{"type":"tool_call","subtype":"started","call_id":"toolu_015qfEgzZrEiJSQjcKJdrFrh","tool_call":{"editToolCall":{"args":{"path":"/Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/FX.luau","streamContent":"-- Client visuals for server-authoritative combat: projectiles (simulated locally with the shared\n-- ProjectileSim, corrected by ProjSync/ProjEnd), blasts, sparks, muzzle flashes, charge glow,\n-- dash trails, and screen shake. All instances here are local-only.\nlocal Debris = game:GetService(\"Debris\")\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal TweenService = game:GetService(\"TweenService\")\n\nlocal RC = ReplicatedStorage:WaitForChild(\"RoboClash\")\nlocal Config = require(RC.Config)\nlocal Sim = require(RC.Shared.ProjectileSim)\nlocal State = require(script.Parent.State)\nlocal Sound = require(script.Parent.Sound)\n\nlocal FX = {}\nlocal HUD, RobotAnim, Battle -- injected\n\nlocal folder = Instance.new(\"Folder\")\nfolder.Name = \"RoboClashFX\"\nfolder.Parent = workspace\n\nlocal visuals = {}\nlocal charges = {}\nlocal trails = {}\nlocal shakeAmp, shakeUntil, shakeDur = 0, 0, 0.001\n\nlocal SPARK = \"rbxasset://textures/particles/sparkles_main.dds\"\nlocal SMOKE = \"rbxasset://textures/particles/smoke_main.dds\"\nlocal FIRE = \"rbxasset://textures/particles/fire_main.dds\"\n\nlocal function ball(size: number, color: Color3, transparency: number?): Part\n\tlocal p = Instance.new(\"Part\")\n\tp.Shape = Enum.PartType.Ball\n\tp.Size = Vector3.one * size\n\tp.Color = color\n\tp.Material = Enum.Material.Neon\n\tp.Transparency = transparency or 0\n\tp.Anchored = true\n\tp.CanCollide = false\n\tp.CanQuery = false\n\tp.CanTouch = false\n\tp.CastShadow = false\n\tp.Parent = folder\n\treturn p\nend\n\nlocal function block(size: Vector3, color: Color3, shape: Enum.PartType?, transparency: number?): Part\n\tlocal p = Instance.new(\"Part\")\n\tp.Size = size\n\tif shape then\n\t\tp.Shape = shape\n\tend\n\tp.Color = color\n\tp.Material = Enum.Material.Neon\n\tp.Transparency = transparency or 0\n\tp.Anchored = true\n\tp.CanCollide = false\n\tp.CanQuery = false\n\tp.CanTouch = false\n\tp.CastShadow = false\n\tp.Parent = folder\n\treturn p\nend\n\nlocal function trail(part: BasePart, color: Color3, width: number, lifetime: number)\n\tlocal a0 = Instance.new(\"Attachment\")\n\ta0.Position = Vector3.new(0, width / 2, 0)\n\ta0.Parent = part\n\tlocal a1 = Instance.new(\"Attachment\")\n\ta1.Position = Vector3.new(0, -width / 2, 0)\n\ta1.Parent = part\n\tlocal t = Instance.new(\"Trail\")\n\tt.Attachment0 = a0\n\tt.Attachment1 = a1\n\tt.Lifetime = lifetime\n\tt.Color = ColorSequence.new(color)\n\tt.LightEmission = 1\n\tt.LightInfluence = 0\n\tt.FaceCamera = true\n\tt.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })\n\tt.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.1) })\n\tt.Parent = part\n\treturn t\nend\n\nlocal function emitter(parent: Instance, props)\n\tlocal e = Instance.new(\"ParticleEmitter\")\n\te.Enabled = false\n\te.LightEmission = 1\n\te.LightInfluence = 0\n\tfor k, v in pairs(props) do\n\t\t(e :: any)[k] = v\n\tend\n\te.Parent = parent\n\treturn e\nend\n\nlocal function burstAt(pos: Vector3, color: Color3, count: number, speed: number, size: number, life: number?)\n\tlocal holder = Instance.new(\"Part\")\n\tholder.Anchored = true\n\tholder.CanCollide = false\n\tholder.CanQuery = false\n\tholder.CanTouch = false\n\tholder.Transparency = 1\n\tholder.Size = Vector3.one * 0.2\n\tholder.CFrame = CFrame.new(pos)\n\tholder.Parent = folder\n\tlocal e = emitter(holder, {\n\t\tTexture = SPARK,\n\t\tColor = ColorSequence.new(Color3.new(1, 1, 1), color),\n\t\tSize = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) }),\n\t\tSpeed = NumberRange.new(speed * 0.5, speed),\n\t\tSpreadAngle = Vector2.new(180, 180),\n\t\tLifetime = NumberRange.new((life or 0.35) * 0.6, life or 0.35),\n\t\tDrag = 4,\n\t\tRate = 0,\n\t})\n\te:Emit(count)\n\tDebris:AddItem(holder, 1.5)\nend\n\nlocal function smokeAt(pos: Vector3, color: Color3, count: number, size: number)\n\tlocal holder = Instance.new(\"Part\")\n\tholder.Anchored = true\n\tholder.CanCollide = false\n\tholder.CanQuery = false\n\tholder.CanTouch = false\n\tholder.Transparency = 1\n\tholder.Size = Vector3.one * 0.2\n\tholder.CFrame = CFrame.new(pos)\n\tholder.Parent = folder\n\tlocal e = emitter(holder, {\n\t\tTexture = SMOKE,\n\t\tLightEmission = 0.3,\n\t\tColor = ColorSequence.new(color),\n\t\tTransparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) }),\n\t\tSize = NumberSequence.new({ NumberSequenceKeypoint.new(0, size * 0.5), NumberSequenceKeypoint.new(1, size) }),\n\t\tSpeed = NumberRange.new(2, 6),\n\t\tSpreadAngle = Vector2.new(180, 30),\n\t\tLifetime = NumberRange.new(0.5, 0.9),\n\t\tRate = 0,\n\t})\n\te:Emit(count)\n\tDebris:AddItem(holder, 2)\nend\n\nlocal function flash(pos: Vector3, color: Color3, size: number, time: number)\n\tlocal b = ball(size, color, 0.1)\n\tb.CFrame = CFrame.new(pos)\n\tlocal l = Instance.new(\"PointLight\")\n\tl.Color = color\n\tl.Range = size * 4\n\tl.Brightness = 3\n\tl.Parent = b\n\tTweenService:Create(b, TweenInfo.new(time), { Transparency = 1, Size = Vector3.one * size * 1.6 }):Play()\n\tTweenService:Create(l, TweenInfo.new(time), { Brightness = 0 }):Play()\n\tDebris:AddItem(b, time + 0.05)\nend\nFX.Flash = flash\n\nfunction FX.Shake(amp: number, dur: number)\n\tlocal t = os.clock()\n\tlocal remaining = math.max(0, shakeUntil - t) / shakeDur * shakeAmp\n\tif amp >= remaining then\n\t\tshakeAmp = amp\n\t\tshakeDur = dur\n\t\tshakeUntil = t + dur\n\tend\nend\n\nfunction FX.ShakeCFrame(): CFrame\n\tlocal t = os.clock()\n\tif t >= shakeUntil then\n\t\treturn CFrame.identity\n\tend\n\tlocal k = (shakeUntil - t) / shakeDur\n\tlocal a = shakeAmp * k\n\treturn CFrame.new((math.random() - 0.5) * a, (math.random() - 0.5) * a, (math.random() - 0.5) * a * 0.5)\n\t\t* CFrame.Angles(0, 0, (math.random() - 0.5) * a * 0.02)\nend\n\nlocal function localModel(): Model?\n\treturn State.localModel\nend\n\nlocal function distToLocal(pos: Vector3): number\n\tlocal m = localModel()\n\tlocal root = m and m:FindFirstChild(\"HumanoidRootPart\")\n\tif root then\n\t\treturn (root.Position - pos).Magnitude\n\tend\n\treturn 999\nend\n\nlocal function aimPos(model: Model?): Vector3?\n\tif not model or not model.Parent then\n\t\treturn nil\n\tend\n\tlocal root = model:FindFirstChild(\"HumanoidRootPart\") :: BasePart?\n\tif not root then\n\t\treturn nil\n\tend\n\treturn root.Position + Vector3.new(0, model:GetAttribute(\"AimY\") or 0, 0)\nend\n\n----------------------------------------------------------------------------------------------\n-- Projectiles\n----------------------------------------------------------------------------------------------\nlocal function removeVisual(id: number, fade: boolean?)\n\tlocal v = visuals[id]\n\tif not v then\n\t\treturn\n\tend\n\tvisuals[id] = nil\n\tfor _, part in ipairs(v.parts) do\n\t\tif fade then\n\t\t\tTweenService:Create(part, TweenInfo.new(0.15), { Transparency = 1 }):Play()\n\t\t\tDebris:AddItem(part, 0.4)\n\t\telse\n\t\t\t-- let trails finish\n\t\t\tpart.Transparency = 1\n\t\t\tDebris:AddItem(part, 0.35)\n\t\tend\n\tend\nend\n\nlocal function makeVisual(p)\n\tlocal parts = {}\n\tlocal main\n\tlocal color = p.color or Color3.new(1, 1, 1)\n\tlocal kind = p.kind\n\tif kind == \"Bullet\" then\n\t\tif p.style == \"Beam\" then\n\t\t\tmain = block(Vector3.new(7, 1.3, 1.3), color, Enum.PartType.Cylinder)\n\t\t\tlocal glow = block(Vector3.new(8, 2.6, 2.6), color, Enum.PartType.Cylinder, 0.7)\n\t\t\ttable.insert(parts, glow)\n\t\t\ttrail(main, color, 1.6, 0.25)\n\t\t\tlocal l = Instance.new(\"PointLight\")\n\t\t\tl.Color = color\n\t\t\tl.Range = 14\n\t\t\tl.Brightness = 2\n\t\t\tl.Parent = main\n\t\t\tp.glow = glow\n\t\telseif p.style == \"Pellet\" then\n\t\t\tmain = ball(p.size * 0.9, color)\n\t\t\ttrail(main, color, 0.6, 0.12)\n\t\telse\n\t\t\tmain = ball(p.size, color)\n\t\t\tlocal core = ball(p.size * 0.55, Color3.new(1, 1, 1))\n\t\t\ttable.insert(parts, core)\n\t\t\tp.core = core\n\t\t\ttrail(main, color, p.size * 0.8, 0.18)\n\t\tend\n\telseif kind == \"Bomb\" then\n\t\tmain = ball(p.size, color)\n\t\tlocal ring = block(Vector3.new(0.2, p.size * 1.7, p.size * 1.7), Color3.new(1, 1, 1), Enum.PartType.Cylinder, 0.3)\n\t\ttable.insert(parts, ring)\n\t\tp.ring = ring\n\t\ttrail(main, color, p.size * 0.6, 0.35)\n\t\t-- landing marker telegraph\n\t\tif p.finish then\n\t\t\tlocal r = (p.radius or 8) * 2\n\t\t\tlocal marker = block(Vector3.new(0.15, r, r), Config.Match and color or color, Enum.PartType.Cylinder, 0.65)\n\t\t\tmarker.CFrame = CFrame.new(p.finish + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, 0, math.rad(90))\n\t\t\ttable.insert(parts, marker)\n\t\t\tp.marker = marker\n\t\tend\n\telseif kind == \"Seeker\" or kind == \"Orbit\" then\n\t\tmain = ball(p.size, color, 0.15)\n\t\tlocal core = ball(p.size * 0.5, Color3.new(1, 1, 1))\n\t\ttable.insert(parts, core)\n\t\tp.core = core\n\t\tlocal l = Instance.new(\"PointLight\")\n\t\tl.Color = color\n\t\tl.Range = 10\n\t\tl.Brightness = 1.5\n\t\tl.Parent = main\n\t\ttrail(main, color, p.size * 0.5, 0.4)\n\telseif kind == \"Mine\" then\n\t\tmain = block(Vector3.new(0.7, p.size, p.size), Color3.fromRGB(40, 40, 50), Enum.PartType.Cylinder)\n\t\tmain.Material = Enum.Material.Metal\n\t\tlocal light = ball(0.9, color)\n\t\ttable.insert(parts, light)\n\t\tp.light = light\n\t\tlocal r = (p.radius or 9) * 2\n\t\tlocal ring = block(Vector3.new(0.12, r, r), color, Enum.PartType.Cylinder, 1)\n\t\ttable.insert(parts, ring)\n\t\tp.triggerRing = ring\n\tend\n\ttable.insert(parts, 1, main)\n\treturn { p = p, main = main, parts = parts, prevPos = p.pos }\nend\n\nlocal function onProj(data)\n\tlocal p = table.clone(data)\n\tp.age = 0\n\tlocal targetModel = p.target\n\tp.target = nil\n\tp.targetModel = targetModel\n\tif p.kind == \"Bomb\" then\n\t\tp.radius = data.radius\n\tend\n\tlocal v = makeVisual(p)\n\tlocal elapsed = workspace:GetServerTimeNow() - (data.t0 or workspace:GetServerTimeNow())\n\tif elapsed > 0 then\n\t\tSim.fastForward(p, elapsed, aimPos(targetModel))\n\tend\n\tvisuals[p.id] = v\nend\n\nlocal function updateVisual(v, dt: number, tclock: number)\n\tlocal p = v.p\n\tlocal prev = p.pos\n\tSim.step(p, dt, aimPos(p.targetModel))\n\tif v.syncPos then\n\t\tlocal k = 1 - math.exp(-dt * 10)\n\t\tp.pos = p.pos:Lerp(v.syncPos, k)\n\t\tv.syncPos = v.syncPos + (p.pos - prev)\n\t\tif (v.syncPos - p.pos).Magnitude < 0.05 then\n\t\t\tv.syncPos = nil\n\t\tend\n\tend\n\tlocal vel = p.pos - prev\n\tlocal look = vel.Magnitude > 1e-4 and vel.Unit or (p.dir or Vector3.zAxis)\n\tlocal main = v.main\n\tif p.kind == \"Bullet\" and p.style == \"Beam\" then\n\t\tlocal cf = CFrame.lookAt(p.pos, p.pos + look) * CFrame.Angles(0, math.rad(90), 0)\n\t\tmain.CFrame = cf\n\t\tp.glow.CFrame = cf\n\telseif p.kind == \"Mine\" then\n\t\tmain.CFrame = CFrame.new(p.pos) * CFrame.Angles(0, 0, math.rad(90))\n\t\tp.light.CFrame = CFrame.new(p.pos + Vector3.new(0, 0.5, 0))\n\t\tlocal armed = p.landed and p.age >= (p.throwTime or 0) + (p.armTime or 0)\n\t\tlocal blink = armed and (math.floor(tclock * 6) % 2 == 0) or (math.floor(tclock * 2) % 2 == 0)\n\t\tp.light.Transparency = blink and 0 or 0.7\n\t\tp.triggerRing.CFrame = CFrame.new(Vector3.new(p.pos.X, p.floorRingY or (p.pos.Y - 0.8), p.pos.Z)) * CFrame.Angles(0, 0, math.rad(90))\n\t\tp.triggerRing.Transparency = armed and 0.75 or 1\n\telse\n\t\tmain.CFrame = CFrame.lookAt(p.pos, p.pos + look)\n\t\tif p.core then\n\t\t\tp.core.CFrame = main.CFrame\n\t\t\tif p.kind ~= \"Bullet\" then\n\t\t\t\tlocal s = p.size * (0.45 + 0.15 * math.sin(tclock * 12))\n\t\t\t\tp.core.Size = Vector3.one * s\n\t\t\tend\n\t\tend\n\t\tif p.ring then\n\t\t\tp.ring.CFrame = CFrame.new(p.pos) * CFrame.Angles(tclock * 6, tclock * 4, 0)\n\t\tend\n\tend\n\tif p.age > (p.life or 3) + 2 then\n\t\treturn false\n\tend\n\treturn true\nend\n\nlocal function onProjEnd(data)\n\tlocal v = visuals[data.id]\n\tlocal pos = data.pos\n\tif v then\n\t\tlocal color = v.p.color or Color3.new(1, 1, 1)\n\t\tif data.reason == \"wall\" then\n\t\t\tburstAt(pos, color, 8, 18, 0.6)\n\t\t\tflash(pos, color, 1.4, 0.12)\n\t\telseif data.reason == \"expire\" then\n\t\t\tremoveVisual(data.id, true)\n\t\t\treturn\n\t\tend\n\tend\n\tremoveVisual(data.id, false)\nend\n\nlocal function onProjSync(list)\n\tfor _, e in ipairs(list) do\n\t\tlocal v = visuals[e[1]]\n\t\tif v then\n\t\t\tv.syncPos = e[2]\n\t\t\tif e[3] then\n\t\t\t\tv.p.dir = e[3]\n\t\t\tend\n\t\tend\n\tend\nend\n\nlocal function clearAll()\n\tfor id in pairs(visuals) do\n\t\tremoveVisual(id, true)\n\tend\n\tfor model in pairs(charges) do\n\t\tFX.StopCharge(model)\n\tend\nend\nFX.ClearAll = clearAll\n\n----------------------------------------------------------------------------------------------\n-- Blasts / hits / misc\n----------------------------------------------------------------------------------------------\nlocal function onBlast(data)\n\tlocal pos, r, linger, color = data.pos, data.radius, data.linger, data.color or Color3.fromRGB(255, 140, 60)\n\tlocal sphere = ball(r * 0.6, color, 0.15)\n\tsphere.CFrame = CFrame.new(pos)\n\tlocal core = ball(r * 0.35, Color3.new(1, 1, 1), 0.05)\n\tcore.CFrame = CFrame.new(pos)\n\tlocal ring = block(Vector3.new(0.3, r * 1.2, r * 1.2), Color3.new(1, 1, 1), Enum.PartType.Cylinder, 0.2)\n\tring.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))\n\tlocal light = Instance.new(\"PointLight\")\n\tlight.Color = color\n\tlight.Range = r * 3.5\n\tlight.Brightness = 5\n\tlight.Parent = sphere\n\tTweenService:Create(sphere, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.one * r * 2 }):Play()\n\tTweenService:Create(core, TweenInfo.new(0.2), { Size = Vector3.one * r * 1.2, Transparency = 0.6 }):Play()\n\tTweenService:Create(ring, TweenInfo.new(0.35), { Size = Vector3.new(0.3, r * 3.2, r * 3.2), Transparency = 1 }):Play()\n\tTweenService:Create(light, TweenInfo.new(linger + 0.2), { Brightness = 0 }):Play()\n\tburstAt(pos, color, 30, 45, 1.6, 0.6)\n\tsmokeAt(pos, Color3.fromRGB(70, 60, 90), 10, r * 0.9)\n\ttask.spawn(function()\n\t\tlocal t0 = os.clock()\n\t\twhile os.clock() - t0 < linger do\n\t\t\tsphere.Transparency = 0.25 + math.random() * 0.2\n\t\t\ttask.wait(0.05)\n\t\tend\n\t\tTweenService:Create(sphere, TweenInfo.new(0.25), { Transparency = 1, Size = Vector3.one * r * 2.2 }):Play()\n\t\tTweenService:Create(core, TweenInfo.new(0.2), { Transparency = 1 }):Play()\n\t\ttask.wait(0.3)\n\t\tsphere:Destroy()\n\t\tcore:Destroy()\n\t\tring:Destroy()\n\tend)\n\tlocal d = distToLocal(pos)\n\tlocal amp = (data.big and 2.2 or 1.4) * math.clamp(1 - d / 70, 0.15, 1)\n\tFX.Shake(amp, 0.35)\n\tSound.Play(\"Explosion\", { volume = data.big and 1.2 or 0.9, pitch = data.big and 0.8 or 1 })\nend\n\nlocal function onHit(data)\n\tlocal victim = data.victim\n\tlocal color = Color3.fromRGB(255, 230, 120)\n\tburstAt(data.pos, color, data.heavy and 26 or 14, data.heavy and 40 or 28, data.heavy and 1.4 or 0.9)\n\tflash(data.pos, Color3.new(1, 1, 1), data.heavy and 3 or 1.8, 0.12)\n\tif HUD then\n\t\tHUD.ShowHit(victim, data.pos, data.amount, data.combo, data.heavy)\n\tend\n\tif RobotAnim then\n\t\tRobotAnim.Flinch(victim)\n\tend\n\tif victim == localModel() then\n\t\tFX.Shake(data.heavy and 2.6 or 0.9, data.heavy and 0.45 or 0.2)\n\t\tif HUD then\n\t\t\tHUD.DamageVignette(data.heavy)\n\t\tend\n\telseif data.attacker == localModel() and data.heavy then\n\t\tFX.Shake(1.0, 0.2)\n\tend\n\tSound.Play(data.heavy and \"HeavyHit\" or \"Hit\")\nend\n\nlocal WEAPON_ATT = { Gun = \"GunTip\", Bomb = \"BombTip\", Pod = \"PodTip\" }\nlocal function onFire(data)\n\tlocal model = data.model\n\tif not model or not model.Parent then\n\t\treturn\n\tend\n\tlocal att = model:FindFirstChild(WEAPON_ATT[data.weapon] or \"GunTip\", true)\n\tlocal robot = Config.RobotById[model:GetAttribute(\"RobotId\") or \"Bolt\"]\n\tlocal loadout = Config.GetLoadout(robot.Id)\n\tlocal color = data.weapon == \"Gun\" and loadout.Gun.Color or (data.weapon == \"Bomb\" and loadout.Bomb.Color or loadout.Pod.Color)\n\tif att and att:IsA(\"Attachment\") then\n\t\tflash(att.WorldPosition, color, data.weapon == \"Gun\" and 1.8 or 2.4, 0.1)\n\tend\n\tif RobotAnim then\n\t\tRobotAnim.OnFire(model, data.weapon)\n\tend\n\tif model == localModel() and Battle then\n\t\tBattle.OnLocalFire(data)\n\tend\n\tif data.weapon == \"Gun\" then\n\t\tSound.Play(data.gunType == \"Spread\" and \"Shotgun\" or (data.gunType == \"Charge\" and \"Laser\" or \"Blaster\"))\n\telseif data.weapon == \"Bomb\" then\n\t\tSound.Play(\"BombThrow\")\n\telse\n\t\tSound.Play(\"Pod\")\n\tend\nend\n\nfunction FX.StopCharge(model)\n\tlocal ch = charges[model]\n\tif ch then\n\t\tcharges[model] = nil\n\t\tch.orb:Destroy()\n\t\tif ch.sound then\n\t\t\tch.sound:Destroy()\n\t\tend\n\tend\nend\n\nlocal function onCharge(data)\n\tlocal model = data.model\n\tif not model then\n\t\treturn\n\tend\n\tif data.on then\n\t\tFX.StopCharge(model)\n\t\tlocal robot = Config.RobotById[model:GetAttribute(\"RobotId\") or \"Lancer\"]\n\t\tlocal color = Config.GetLoadout(robot.Id).Gun.Color\n\t\tlocal orb = ball(0.4, color, 0.1)\n\t\tlocal l = Instance.new(\"PointLight\")\n\t\tl.Color = color\n\t\tl.Range = 8\n\t\tl.Brightness = 2\n\t\tl.Parent = orb\n\t\tcharges[model] = { orb = orb, t0 = os.clock(), dur = data.chargeTime or 0.8, color = color, sound = Sound.Play(\"Charge\", { vary = 0 }) }\n\telse\n\t\tFX.StopCharge(model)\n\tend\nend\n\nlocal function trailFor(model: Model)\n\tlocal t = trails[model]\n\tif t and t.Parent then\n\t\treturn t\n\tend\n\tlocal torso = model:FindFirstChild(\"Torso\")\n\tif not torso then\n\t\treturn nil\n\tend\n\tlocal robot = Config.RobotById[model:GetAttribute(\"RobotId\") or \"Bolt\"]\n\tlocal a0 = Instance.new(\"Attachment\")\n\ta0.Name = \"RCTrailTop\"\n\ta0.Position = Vector3.new(0, 1.2, 0.5)\n\ta0.Parent = torso\n\tlocal a1 = Instance.new(\"Attachment\")\n\ta1.Name = \"RCTrailBottom\"\n\ta1.Position = Vector3.new(0, -2.5, 0.5)\n\ta1.Parent = torso\n\tlocal tr = Instance.new(\"Trail\")\n\ttr.Attachment0 = a0\n\ttr.Attachment1 = a1\n\ttr.Lifetime = 0.22\n\ttr.Color = ColorSequence.new(robot.Neon)\n\ttr.LightEmission = 1\n\ttr.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })\n\ttr.Enabled = false\n\ttr.Parent = torso\n\ttrails[model] = tr\n\treturn tr\nend\n\nlocal function onDash(data)\n\tlocal model = data.model\n\tif not model or not model.Parent then\n\t\treturn\n\tend\n\tlocal tr = trailFor(model)\n\tif tr then\n\t\ttr.Enabled = true\n\t\ttask.delay(0.32, function()\n\t\t\tif tr.Parent then\n\t\t\t\ttr.Enabled = false\n\t\t\tend\n\t\tend)\n\tend\n\tlocal root = model:FindFirstChild(\"HumanoidRootPart\")\n\tif root and not data.air then\n\t\tsmokeAt(root.Position - Vector3.new(0, 3.5, 0), Color3.fromRGB(150, 160, 200), 6, 2.5)\n\tend\n\tSound.Play(\"Dash\")\nend\n\nlocal handlers = {\n\tProj = onProj,\n\tProjEnd = onProjEnd,\n\tProjSync = onProjSync,\n\tClearProj = clearAll,\n\tBlast = onBlast,\n\tHit = onHit,\n\tFire = onFire,\n\tCharge = onCharge,\n\tDash = onDash,\n\tDown = function(data)\n\t\tif HUD then\n\t\t\tHUD.TagText(data.model, \"DOWN\", Color3.fromRGB(255, 90, 170))\n\t\tend\n\t\tSound.Play(\"Down\")\n\t\tif data.model == localModel() then\n\t\t\tFX.Shake(2.2, 0.4)\n\t\tend\n\tend,\n\tRebirth = function(data)\n\t\tif HUD then\n\t\t\tHUD.TagText(data.model, \"REBIRTH\", Color3.fromRGB(255, 255, 255))\n\t\tend\n\tend,\n\tPit = function(data)\n\t\tif HUD then\n\t\t\tHUD.TagText(data.model, \"PIT  -\" .. tostring(data.amount), Color3.fromRGB(255, 80, 80))\n\t\tend\n\t\tSound.Play(\"HeavyHit\")\n\tend,\n}\n\nfunction FX.Init(deps)\n\tHUD = deps.HUD\n\tRobotAnim = deps.RobotAnim\n\tBattle = deps.Battle\n\tRC.Remotes.FX.OnClientEvent:Connect(function(kind, data)\n\t\tlocal h = handlers[kind]\n\t\tif h then\n\t\t\tlocal ok, err = pcall(h, data)\n\t\t\tif not ok then\n\t\t\t\twarn(\"[RoboClash FX] \" .. tostring(kind) .. \": \" .. tostring(err))\n\t\t\tend\n\t\tend\n\tend)\n\tRunService.RenderStepped:Connect(function(dt)\n\t\tlocal tclock = os.clock()\n\t\tfor id, v in pairs(visuals) do\n\t\t\tlocal ok, keep = pcall(updateVisual, v, dt, tclock)\n\t\t\tif not ok or not keep then\n\t\t\t\tremoveVisual(id, true)\n\t\t\tend\n\t\tend\n\t\tfor model, ch in pairs(charges) do\n\t\t\tlocal att = model.Parent and model:FindFirstChild(\"GunTip\", true)\n\t\t\tif not att then\n\t\t\t\tFX.StopCharge(model)\n\t\t\telse\n\t\t\t\tlocal k = math.clamp((tclock - ch.t0) / ch.dur, 0, 1)\n\t\t\t\tlocal full = k >= 1\n\t\t\t\tlocal s = 0.4 + 1.6 * k + (full and 0.25 * math.sin(tclock * 30) or 0)\n\t\t\t\tch.orb.Size = Vector3.one * s\n\t\t\t\tch.orb.CFrame = CFrame.new((att :: Attachment).WorldPosition)\n\t\t\t\tch.orb.Color = full and Color3.new(1, 1, 1) or ch.color\n\t\t\tend\n\t\tend\n\tend)\nend\n\nfunction FX.Folder()\n\treturn folder\nend\n\n-- Silence unused warning for Players (kept for future per-player FX filtering).\nlocal _ = Players\n\nreturn FX\n"}},"hookAdditionalContexts":[],"toolCallId":"toolu_015qfEgzZrEiJSQjcKJdrFrh","startedAtMs":"1791074173250"},"model_call_id":"f6f75537-51d9-46fb-a6c9-81f06ac674d8-53-rtkw","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791074242988}
{"type":"tool_call","subtype":"completed","call_id":"toolu_015qfEgzZrEiJSQjcKJdrFrh","tool_call":{"editToolCall":{"args":{"path":"/Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/FX.luau","streamContent":"-- Client visuals for server-authoritative combat: projectiles (simulated locally with the shared\n-- ProjectileSim, corrected by ProjSync/ProjEnd), blasts, sparks, muzzle flashes, charge glow,\n-- dash trails, and screen shake. All instances here are local-only.\nlocal Debris = game:GetService(\"Debris\")\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal TweenService = game:GetService(\"TweenService\")\n\nlocal RC = ReplicatedStorage:WaitForChild(\"RoboClash\")\nlocal Config = require(RC.Config)\nlocal Sim = require(RC.Shared.ProjectileSim)\nlocal State = require(script.Parent.State)\nlocal Sound = require(script.Parent.Sound)\n\nlocal FX = {}\nlocal HUD, RobotAnim, Battle -- injected\n\nlocal folder = Instance.new(\"Folder\")\nfolder.Name = \"RoboClashFX\"\nfolder.Parent = workspace\n\nlocal visuals = {}\nlocal charges = {}\nlocal trails = {}\nlocal shakeAmp, shakeUntil, shakeDur = 0, 0, 0.001\n\nlocal SPARK = \"rbxasset://textures/particles/sparkles_main.dds\"\nlocal SMOKE = \"rbxasset://textures/particles/smoke_main.dds\"\nlocal FIRE = \"rbxasset://textures/particles/fire_main.dds\"\n\nlocal function ball(size: number, color: Color3, transparency: number?): Part\n\tlocal p = Instance.new(\"Part\")\n\tp.Shape = Enum.PartType.Ball\n\tp.Size = Vector3.one * size\n\tp.Color = color\n\tp.Material = Enum.Material.Neon\n\tp.Transparency = transparency or 0\n\tp.Anchored = true\n\tp.CanCollide = false\n\tp.CanQuery = false\n\tp.CanTouch = false\n\tp.CastShadow = false\n\tp.Parent = folder\n\treturn p\nend\n\nlocal function block(size: Vector3, color: Color3, shape: Enum.PartType?, transparency: number?): Part\n\tlocal p = Instance.new(\"Part\")\n\tp.Size = size\n\tif shape then\n\t\tp.Shape = shape\n\tend\n\tp.Color = color\n\tp.Material = Enum.Material.Neon\n\tp.Transparency = transparency or 0\n\tp.Anchored = true\n\tp.CanCollide = false\n\tp.CanQuery = false\n\tp.CanTouch = false\n\tp.CastShadow = false\n\tp.Parent = folder\n\treturn p\nend\n\nlocal function trail(part: BasePart, color: Color3, width: number, lifetime: number)\n\tlocal a0 = Instance.new(\"Attachment\")\n\ta0.Position = Vector3.new(0, width / 2, 0)\n\ta0.Parent = part\n\tlocal a1 = Instance.new(\"Attachment\")\n\ta1.Position = Vector3.new(0, -width / 2, 0)\n\ta1.Parent = part\n\tlocal t = Instance.new(\"Trail\")\n\tt.Attachment0 = a0\n\tt.Attachment1 = a1\n\tt.Lifetime = lifetime\n\tt.Color = ColorSequence.new(color)\n\tt.LightEmission = 1\n\tt.LightInfluence = 0\n\tt.FaceCamera = true\n\tt.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })\n\tt.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.1) })\n\tt.Parent = part\n\treturn t\nend\n\nlocal function emitter(parent: Instance, props)\n\tlocal e = Instance.new(\"ParticleEmitter\")\n\te.Enabled = false\n\te.LightEmission = 1\n\te.LightInfluence = 0\n\tfor k, v in pairs(props) do\n\t\t(e :: any)[k] = v\n\tend\n\te.Parent = parent\n\treturn e\nend\n\nlocal function burstAt(pos: Vector3, color: Color3, count: number, speed: number, size: number, life: number?)\n\tlocal holder = Instance.new(\"Part\")\n\tholder.Anchored = true\n\tholder.CanCollide = false\n\tholder.CanQuery = false\n\tholder.CanTouch = false\n\tholder.Transparency = 1\n\tholder.Size = Vector3.one * 0.2\n\tholder.CFrame = CFrame.new(pos)\n\tholder.Parent = folder\n\tlocal e = emitter(holder, {\n\t\tTexture = SPARK,\n\t\tColor = ColorSequence.new(Color3.new(1, 1, 1), color),\n\t\tSize = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) }),\n\t\tSpeed = NumberRange.new(speed * 0.5, speed),\n\t\tSpreadAngle = Vector2.new(180, 180),\n\t\tLifetime = NumberRange.new((life or 0.35) * 0.6, life or 0.35),\n\t\tDrag = 4,\n\t\tRate = 0,\n\t})\n\te:Emit(count)\n\tDebris:AddItem(holder, 1.5)\nend\n\nlocal function smokeAt(pos: Vector3, color: Color3, count: number, size: number)\n\tlocal holder = Instance.new(\"Part\")\n\tholder.Anchored = true\n\tholder.CanCollide = false\n\tholder.CanQuery = false\n\tholder.CanTouch = false\n\tholder.Transparency = 1\n\tholder.Size = Vector3.one * 0.2\n\tholder.CFrame = CFrame.new(pos)\n\tholder.Parent = folder\n\tlocal e = emitter(holder, {\n\t\tTexture = SMOKE,\n\t\tLightEmission = 0.3,\n\t\tColor = ColorSequence.new(color),\n\t\tTransparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) }),\n\t\tSize = NumberSequence.new({ NumberSequenceKeypoint.new(0, size * 0.5), NumberSequenceKeypoint.new(1, size) }),\n\t\tSpeed = NumberRange.new(2, 6),\n\t\tSpreadAngle = Vector2.new(180, 30),\n\t\tLifetime = NumberRange.new(0.5, 0.9),\n\t\tRate = 0,\n\t})\n\te:Emit(count)\n\tDebris:AddItem(holder, 2)\nend\n\nlocal function flash(pos: Vector3, color: Color3, size: number, time: number)\n\tlocal b = ball(size, color, 0.1)\n\tb.CFrame = CFrame.new(pos)\n\tlocal l = Instance.new(\"PointLight\")\n\tl.Color = color\n\tl.Range = size * 4\n\tl.Brightness = 3\n\tl.Parent = b\n\tTweenService:Create(b, TweenInfo.new(time), { Transparency = 1, Size = Vector3.one * size * 1.6 }):Play()\n\tTweenService:Create(l, TweenInfo.new(time), { Brightness = 0 }):Play()\n\tDebris:AddItem(b, time + 0.05)\nend\nFX.Flash = flash\n\nfunction FX.Shake(amp: number, dur: number)\n\tlocal t = os.clock()\n\tlocal remaining = math.max(0, shakeUntil - t) / shakeDur * shakeAmp\n\tif amp >= remaining then\n\t\tshakeAmp = amp\n\t\tshakeDur = dur\n\t\tshakeUntil = t + dur\n\tend\nend\n\nfunction FX.ShakeCFrame(): CFrame\n\tlocal t = os.clock()\n\tif t >= shakeUntil then\n\t\treturn CFrame.identity\n\tend\n\tlocal k = (shakeUntil - t) / shakeDur\n\tlocal a = shakeAmp * k\n\treturn CFrame.new((math.random() - 0.5) * a, (math.random() - 0.5) * a, (math.random() - 0.5) * a * 0.5)\n\t\t* CFrame.Angles(0, 0, (math.random() - 0.5) * a * 0.02)\nend\n\nlocal function localModel(): Model?\n\treturn State.localModel\nend\n\nlocal function distToLocal(pos: Vector3): number\n\tlocal m = localModel()\n\tlocal root = m and m:FindFirstChild(\"HumanoidRootPart\")\n\tif root then\n\t\treturn (root.Position - pos).Magnitude\n\tend\n\treturn 999\nend\n\nlocal function aimPos(model: Model?): Vector3?\n\tif not model or not model.Parent then\n\t\treturn nil\n\tend\n\tlocal root = model:FindFirstChild(\"HumanoidRootPart\") :: BasePart?\n\tif not root then\n\t\treturn nil\n\tend\n\treturn root.Position + Vector3.new(0, model:GetAttribute(\"AimY\") or 0, 0)\nend\n\n----------------------------------------------------------------------------------------------\n-- Projectiles\n----------------------------------------------------------------------------------------------\nlocal function removeVisual(id: number, fade: boolean?)\n\tlocal v = visuals[id]\n\tif not v then\n\t\treturn\n\tend\n\tvisuals[id] = nil\n\tfor _, part in ipairs(v.parts) do\n\t\tif fade then\n\t\t\tTweenService:Create(part, TweenInfo.new(0.15), { Transparency = 1 }):Play()\n\t\t\tDebris:AddItem(part, 0.4)\n\t\telse\n\t\t\t-- let trails finish\n\t\t\tpart.Transparency = 1\n\t\t\tDebris:AddItem(part, 0.35)\n\t\tend\n\tend\nend\n\nlocal function makeVisual(p)\n\tlocal parts = {}\n\tlocal main\n\tlocal color = p.color or Color3.new(1, 1, 1)\n\tlocal kind = p.kind\n\tif kind == \"Bullet\" then\n\t\tif p.style == \"Beam\" then\n\t\t\tmain = block(Vector3.new(7, 1.3, 1.3), color, Enum.PartType.Cylinder)\n\t\t\tlocal glow = block(Vector3.new(8, 2.6, 2.6), color, Enum.PartType.Cylinder, 0.7)\n\t\t\ttable.insert(parts, glow)\n\t\t\ttrail(main, color, 1.6, 0.25)\n\t\t\tlocal l = Instance.new(\"PointLight\")\n\t\t\tl.Color = color\n\t\t\tl.Range = 14\n\t\t\tl.Brightness = 2\n\t\t\tl.Parent = main\n\t\t\tp.glow = glow\n\t\telseif p.style == \"Pellet\" then\n\t\t\tmain = ball(p.size * 0.9, color)\n\t\t\ttrail(main, color, 0.6, 0.12)\n\t\telse\n\t\t\tmain = ball(p.size, color)\n\t\t\tlocal core = ball(p.size * 0.55, Color3.new(1, 1, 1))\n\t\t\ttable.insert(parts, core)\n\t\t\tp.core = core\n\t\t\ttrail(main, color, p.size * 0.8, 0.18)\n\t\tend\n\telseif kind == \"Bomb\" then\n\t\tmain = ball(p.size, color)\n\t\tlocal ring = block(Vector3.new(0.2, p.size * 1.7, p.size * 1.7), Color3.new(1, 1, 1), Enum.PartType.Cylinder, 0.3)\n\t\ttable.insert(parts, ring)\n\t\tp.ring = ring\n\t\ttrail(main, color, p.size * 0.6, 0.35)\n\t\t-- landing marker telegraph\n\t\tif p.finish then\n\t\t\tlocal r = (p.radius or 8) * 2\n\t\t\tlocal marker = block(Vector3.new(0.15, r, r), Config.Match and color or color, Enum.PartType.Cylinder, 0.65)\n\t\t\tmarker.CFrame = CFrame.new(p.finish + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, 0, math.rad(90))\n\t\t\ttable.insert(parts, marker)\n\t\t\tp.marker = marker\n\t\tend\n\telseif kind == \"Seeker\" or kind == \"Orbit\" then\n\t\tmain = ball(p.size, color, 0.15)\n\t\tlocal core = ball(p.size * 0.5, Color3.new(1, 1, 1))\n\t\ttable.insert(parts, core)\n\t\tp.core = core\n\t\tlocal l = Instance.new(\"PointLight\")\n\t\tl.Color = color\n\t\tl.Range = 10\n\t\tl.Brightness = 1.5\n\t\tl.Parent = main\n\t\ttrail(main, color, p.size * 0.5, 0.4)\n\telseif kind == \"Mine\" then\n\t\tmain = block(Vector3.new(0.7, p.size, p.size), Color3.fromRGB(40, 40, 50), Enum.PartType.Cylinder)\n\t\tmain.Material = Enum.Material.Metal\n\t\tlocal light = ball(0.9, color)\n\t\ttable.insert(parts, light)\n\t\tp.light = light\n\t\tlocal r = (p.radius or 9) * 2\n\t\tlocal ring = block(Vector3.new(0.12, r, r), color, Enum.PartType.Cylinder, 1)\n\t\ttable.insert(parts, ring)\n\t\tp.triggerRing = ring\n\tend\n\ttable.insert(parts, 1, main)\n\treturn { p = p, main = main, parts = parts, prevPos = p.pos }\nend\n\nlocal function onProj(data)\n\tlocal p = table.clone(data)\n\tp.age = 0\n\tlocal targetModel = p.target\n\tp.target = nil\n\tp.targetModel = targetModel\n\tif p.kind == \"Bomb\" then\n\t\tp.radius = data.radius\n\tend\n\tlocal v = makeVisual(p)\n\tlocal elapsed = workspace:GetServerTimeNow() - (data.t0 or workspace:GetServerTimeNow())\n\tif elapsed > 0 then\n\t\tSim.fastForward(p, elapsed, aimPos(targetModel))\n\tend\n\tvisuals[p.id] = v\nend\n\nlocal function updateVisual(v, dt: number, tclock: number)\n\tlocal p = v.p\n\tlocal prev = p.pos\n\tSim.step(p, dt, aimPos(p.targetModel))\n\tif v.syncPos then\n\t\tlocal k = 1 - math.exp(-dt * 10)\n\t\tp.pos = p.pos:Lerp(v.syncPos, k)\n\t\tv.syncPos = v.syncPos + (p.pos - prev)\n\t\tif (v.syncPos - p.pos).Magnitude < 0.05 then\n\t\t\tv.syncPos = nil\n\t\tend\n\tend\n\tlocal vel = p.pos - prev\n\tlocal look = vel.Magnitude > 1e-4 and vel.Unit or (p.dir or Vector3.zAxis)\n\tlocal main = v.main\n\tif p.kind == \"Bullet\" and p.style == \"Beam\" then\n\t\tlocal cf = CFrame.lookAt(p.pos, p.pos + look) * CFrame.Angles(0, math.rad(90), 0)\n\t\tmain.CFrame = cf\n\t\tp.glow.CFrame = cf\n\telseif p.kind == \"Mine\" then\n\t\tmain.CFrame = CFrame.new(p.pos) * CFrame.Angles(0, 0, math.rad(90))\n\t\tp.light.CFrame = CFrame.new(p.pos + Vector3.new(0, 0.5, 0))\n\t\tlocal armed = p.landed and p.age >= (p.throwTime or 0) + (p.armTime or 0)\n\t\tlocal blink = armed and (math.floor(tclock * 6) % 2 == 0) or (math.floor(tclock * 2) % 2 == 0)\n\t\tp.light.Transparency = blink and 0 or 0.7\n\t\tp.triggerRing.CFrame = CFrame.new(Vector3.new(p.pos.X, p.floorRingY or (p.pos.Y - 0.8), p.pos.Z)) * CFrame.Angles(0, 0, math.rad(90))\n\t\tp.triggerRing.Transparency = armed and 0.75 or 1\n\telse\n\t\tmain.CFrame = CFrame.lookAt(p.pos, p.pos + look)\n\t\tif p.core then\n\t\t\tp.core.CFrame = main.CFrame\n\t\t\tif p.kind ~= \"Bullet\" then\n\t\t\t\tlocal s = p.size * (0.45 + 0.15 * math.sin(tclock * 12))\n\t\t\t\tp.core.Size = Vector3.one * s\n\t\t\tend\n\t\tend\n\t\tif p.ring then\n\t\t\tp.ring.CFrame = CFrame.new(p.pos) * CFrame.Angles(tclock * 6, tclock * 4, 0)\n\t\tend\n\tend\n\tif p.age > (p.life or 3) + 2 then\n\t\treturn false\n\tend\n\treturn true\nend\n\nlocal function onProjEnd(data)\n\tlocal v = visuals[data.id]\n\tlocal pos = data.pos\n\tif v then\n\t\tlocal color = v.p.color or Color3.new(1, 1, 1)\n\t\tif data.reason == \"wall\" then\n\t\t\tburstAt(pos, color, 8, 18, 0.6)\n\t\t\tflash(pos, color, 1.4, 0.12)\n\t\telseif data.reason == \"expire\" then\n\t\t\tremoveVisual(data.id, true)\n\t\t\treturn\n\t\tend\n\tend\n\tremoveVisual(data.id, false)\nend\n\nlocal function onProjSync(list)\n\tfor _, e in ipairs(list) do\n\t\tlocal v = visuals[e[1]]\n\t\tif v then\n\t\t\tv.syncPos = e[2]\n\t\t\tif e[3] then\n\t\t\t\tv.p.dir = e[3]\n\t\t\tend\n\t\tend\n\tend\nend\n\nlocal function clearAll()\n\tfor id in pairs(visuals) do\n\t\tremoveVisual(id, true)\n\tend\n\tfor model in pairs(charges) do\n\t\tFX.StopCharge(model)\n\tend\nend\nFX.ClearAll = clearAll\n\n----------------------------------------------------------------------------------------------\n-- Blasts / hits / misc\n----------------------------------------------------------------------------------------------\nlocal function onBlast(data)\n\tlocal pos, r, linger, color = data.pos, data.radius, data.linger, data.color or Color3.fromRGB(255, 140, 60)\n\tlocal sphere = ball(r * 0.6, color, 0.15)\n\tsphere.CFrame = CFrame.new(pos)\n\tlocal core = ball(r * 0.35, Color3.new(1, 1, 1), 0.05)\n\tcore.CFrame = CFrame.new(pos)\n\tlocal ring = block(Vector3.new(0.3, r * 1.2, r * 1.2), Color3.new(1, 1, 1), Enum.PartType.Cylinder, 0.2)\n\tring.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))\n\tlocal light = Instance.new(\"PointLight\")\n\tlight.Color = color\n\tlight.Range = r * 3.5\n\tlight.Brightness = 5\n\tlight.Parent = sphere\n\tTweenService:Create(sphere, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.one * r * 2 }):Play()\n\tTweenService:Create(core, TweenInfo.new(0.2), { Size = Vector3.one * r * 1.2, Transparency = 0.6 }):Play()\n\tTweenService:Create(ring, TweenInfo.new(0.35), { Size = Vector3.new(0.3, r * 3.2, r * 3.2), Transparency = 1 }):Play()\n\tTweenService:Create(light, TweenInfo.new(linger + 0.2), { Brightness = 0 }):Play()\n\tburstAt(pos, color, 30, 45, 1.6, 0.6)\n\tsmokeAt(pos, Color3.fromRGB(70, 60, 90), 10, r * 0.9)\n\ttask.spawn(function()\n\t\tlocal t0 = os.clock()\n\t\twhile os.clock() - t0 < linger do\n\t\t\tsphere.Transparency = 0.25 + math.random() * 0.2\n\t\t\ttask.wait(0.05)\n\t\tend\n\t\tTweenService:Create(sphere, TweenInfo.new(0.25), { Transparency = 1, Size = Vector3.one * r * 2.2 }):Play()\n\t\tTweenService:Create(core, TweenInfo.new(0.2), { Transparency = 1 }):Play()\n\t\ttask.wait(0.3)\n\t\tsphere:Destroy()\n\t\tcore:Destroy()\n\t\tring:Destroy()\n\tend)\n\tlocal d = distToLocal(pos)\n\tlocal amp = (data.big and 2.2 or 1.4) * math.clamp(1 - d / 70, 0.15, 1)\n\tFX.Shake(amp, 0.35)\n\tSound.Play(\"Explosion\", { volume = data.big and 1.2 or 0.9, pitch = data.big and 0.8 or 1 })\nend\n\nlocal function onHit(data)\n\tlocal victim = data.victim\n\tlocal color = Color3.fromRGB(255, 230, 120)\n\tburstAt(data.pos, color, data.heavy and 26 or 14, data.heavy and 40 or 28, data.heavy and 1.4 or 0.9)\n\tflash(data.pos, Color3.new(1, 1, 1), data.heavy and 3 or 1.8, 0.12)\n\tif HUD then\n\t\tHUD.ShowHit(victim, data.pos, data.amount, data.combo, data.heavy)\n\tend\n\tif RobotAnim then\n\t\tRobotAnim.Flinch(victim)\n\tend\n\tif victim == localModel() then\n\t\tFX.Shake(data.heavy and 2.6 or 0.9, data.heavy and 0.45 or 0.2)\n\t\tif HUD then\n\t\t\tHUD.DamageVignette(data.heavy)\n\t\tend\n\telseif data.attacker == localModel() and data.heavy then\n\t\tFX.Shake(1.0, 0.2)\n\tend\n\tSound.Play(data.heavy and \"HeavyHit\" or \"Hit\")\nend\n\nlocal WEAPON_ATT = { Gun = \"GunTip\", Bomb = \"BombTip\", Pod = \"PodTip\" }\nlocal function onFire(data)\n\tlocal model = data.model\n\tif not model or not model.Parent then\n\t\treturn\n\tend\n\tlocal att = model:FindFirstChild(WEAPON_ATT[data.weapon] or \"GunTip\", true)\n\tlocal robot = Config.RobotById[model:GetAttribute(\"RobotId\") or \"Bolt\"]\n\tlocal loadout = Config.GetLoadout(robot.Id)\n\tlocal color = data.weapon == \"Gun\" and loadout.Gun.Color or (data.weapon == \"Bomb\" and loadout.Bomb.Color or loadout.Pod.Color)\n\tif att and att:IsA(\"Attachment\") then\n\t\tflash(att.WorldPosition, color, data.weapon == \"Gun\" and 1.8 or 2.4, 0.1)\n\tend\n\tif RobotAnim then\n\t\tRobotAnim.OnFire(model, data.weapon)\n\tend\n\tif model == localModel() and Battle then\n\t\tBattle.OnLocalFire(data)\n\tend\n\tif data.weapon == \"Gun\" then\n\t\tSound.Play(data.gunType == \"Spread\" and \"Shotgun\" or (data.gunType == \"Charge\" and \"Laser\" or \"Blaster\"))\n\telseif data.weapon == \"Bomb\" then\n\t\tSound.Play(\"BombThrow\")\n\telse\n\t\tSound.Play(\"Pod\")\n\tend\nend\n\nfunction FX.StopCharge(model)\n\tlocal ch = charges[model]\n\tif ch then\n\t\tcharges[model] = nil\n\t\tch.orb:Destroy()\n\t\tif ch.sound then\n\t\t\tch.sound:Destroy()\n\t\tend\n\tend\nend\n\nlocal function onCharge(data)\n\tlocal model = data.model\n\tif not model then\n\t\treturn\n\tend\n\tif data.on then\n\t\tFX.StopCharge(model)\n\t\tlocal robot = Config.RobotById[model:GetAttribute(\"RobotId\") or \"Lancer\"]\n\t\tlocal color = Config.GetLoadout(robot.Id).Gun.Color\n\t\tlocal orb = ball(0.4, color, 0.1)\n\t\tlocal l = Instance.new(\"PointLight\")\n\t\tl.Color = color\n\t\tl.Range = 8\n\t\tl.Brightness = 2\n\t\tl.Parent = orb\n\t\tcharges[model] = { orb = orb, t0 = os.clock(), dur = data.chargeTime or 0.8, color = color, sound = Sound.Play(\"Charge\", { vary = 0 }) }\n\telse\n\t\tFX.StopCharge(model)\n\tend\nend\n\nlocal function trailFor(model: Model)\n\tlocal t = trails[model]\n\tif t and t.Parent then\n\t\treturn t\n\tend\n\tlocal torso = model:FindFirstChild(\"Torso\")\n\tif not torso then\n\t\treturn nil\n\tend\n\tlocal robot = Config.RobotById[model:GetAttribute(\"RobotId\") or \"Bolt\"]\n\tlocal a0 = Instance.new(\"Attachment\")\n\ta0.Name = \"RCTrailTop\"\n\ta0.Position = Vector3.new(0, 1.2, 0.5)\n\ta0.Parent = torso\n\tlocal a1 = Instance.new(\"Attachment\")\n\ta1.Name = \"RCTrailBottom\"\n\ta1.Position = Vector3.new(0, -2.5, 0.5)\n\ta1.Parent = torso\n\tlocal tr = Instance.new(\"Trail\")\n\ttr.Attachment0 = a0\n\ttr.Attachment1 = a1\n\ttr.Lifetime = 0.22\n\ttr.Color = ColorSequence.new(robot.Neon)\n\ttr.LightEmission = 1\n\ttr.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })\n\ttr.Enabled = false\n\ttr.Parent = torso\n\ttrails[model] = tr\n\treturn tr\nend\n\nlocal function onDash(data)\n\tlocal model = data.model\n\tif not model or not model.Parent then\n\t\treturn\n\tend\n\tlocal tr = trailFor(model)\n\tif tr then\n\t\ttr.Enabled = true\n\t\ttask.delay(0.32, function()\n\t\t\tif tr.Parent then\n\t\t\t\ttr.Enabled = false\n\t\t\tend\n\t\tend)\n\tend\n\tlocal root = model:FindFirstChild(\"HumanoidRootPart\")\n\tif root and not data.air then\n\t\tsmokeAt(root.Position - Vector3.new(0, 3.5, 0), Color3.fromRGB(150, 160, 200), 6, 2.5)\n\tend\n\tSound.Play(\"Dash\")\nend\n\nlocal handlers = {\n\tProj = onProj,\n\tProjEnd = onProjEnd,\n\tProjSync = onProjSync,\n\tClearProj = clearAll,\n\tBlast = onBlast,\n\tHit = onHit,\n\tFire = onFire,\n\tCharge = onCharge,\n\tDash = onDash,\n\tDown = function(data)\n\t\tif HUD then\n\t\t\tHUD.TagText(data.model, \"DOWN\", Color3.fromRGB(255, 90, 170))\n\t\tend\n\t\tSound.Play(\"Down\")\n\t\tif data.model == localModel() then\n\t\t\tFX.Shake(2.2, 0.4)\n\t\tend\n\tend,\n\tRebirth = function(data)\n\t\tif HUD then\n\t\t\tHUD.TagText(data.model, \"REBIRTH\", Color3.fromRGB(255, 255, 255))\n\t\tend\n\tend,\n\tPit = function(data)\n\t\tif HUD then\n\t\t\tHUD.TagText(data.model, \"PIT  -\" .. tostring(data.amount), Color3.fromRGB(255, 80, 80))\n\t\tend\n\t\tSound.Play(\"HeavyHit\")\n\tend,\n}\n\nfunction FX.Init(deps)\n\tHUD = deps.HUD\n\tRobotAnim = deps.RobotAnim\n\tBattle = deps.Battle\n\tRC.Remotes.FX.OnClientEvent:Connect(function(kind, data)\n\t\tlocal h = handlers[kind]\n\t\tif h then\n\t\t\tlocal ok, err = pcall(h, data)\n\t\t\tif not ok then\n\t\t\t\twarn(\"[RoboClash FX] \" .. tostring(kind) .. \": \" .. tostring(err))\n\t\t\tend\n\t\tend\n\tend)\n\tRunService.RenderStepped:Connect(function(dt)\n\t\tlocal tclock = os.clock()\n\t\tfor id, v in pairs(visuals) do\n\t\t\tlocal ok, keep = pcall(updateVisual, v, dt, tclock)\n\t\t\tif not ok or not keep then\n\t\t\t\tremoveVisual(id, true)\n\t\t\tend\n\t\tend\n\t\tfor model, ch in pairs(charges) do\n\t\t\tlocal att = model.Parent and model:FindFirstChild(\"GunTip\", true)\n\t\t\tif not att then\n\t\t\t\tFX.StopCharge(model)\n\t\t\telse\n\t\t\t\tlocal k = math.clamp((tclock - ch.t0) / ch.dur, 0, 1)\n\t\t\t\tlocal full = k >= 1\n\t\t\t\tlocal s = 0.4 + 1.6 * k + (full and 0.25 * math.sin(tclock * 30) or 0)\n\t\t\t\tch.orb.Size = Vector3.one * s\n\t\t\t\tch.orb.CFrame = CFrame.new((att :: Attachment).WorldPosition)\n\t\t\t\tch.orb.Color = full and Color3.new(1, 1, 1) or ch.color\n\t\t\tend\n\t\tend\n\tend)\nend\n\nfunction FX.Folder()\n\treturn folder\nend\n\n-- Silence unused warning for Players (kept for future per-player FX filtering).\nlocal _ = Players\n\nreturn FX\n"},"result":{"success":{"path":"/Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/FX.luau","linesAdded":647,"linesRemoved":0,"diffString":"--- /dev/null\n+++ b//Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/FX.luau\n@@ -1,0 +1,647 @@\n+-- Client visuals for server-authoritative combat: projectiles (simulated locally with the shared\n+-- ProjectileSim, corrected by ProjSync/ProjEnd), blasts, sparks, muzzle flashes, charge glow,\n+-- dash trails, and screen shake. All instances here are local-only.\n+local Debris = game:GetService(\"Debris\")\n+local Players = game:GetService(\"Players\")\n+local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n+local RunService = game:GetService(\"RunService\")\n+local TweenService = game:GetService(\"TweenService\")\n+\n+local RC = ReplicatedStorage:WaitForChild(\"RoboClash\")\n+local Config = require(RC.Config)\n+local Sim = require(RC.Shared.ProjectileSim)\n+local State = require(script.Parent.State)\n+local Sound = require(script.Parent.Sound)\n+\n+local FX = {}\n+local HUD, RobotAnim, Battle -- injected\n+\n+local folder = Instance.new(\"Folder\")\n+folder.Name = \"RoboClashFX\"\n+folder.Parent = workspace\n+\n+local visuals = {}\n+local charges = {}\n+local trails = {}\n+local shakeAmp, shakeUntil, shakeDur = 0, 0, 0.001\n+\n+local SPARK = \"rbxasset://textures/particles/sparkles_main.dds\"\n+local SMOKE = \"rbxasset://textures/particles/smoke_main.dds\"\n+local FIRE = \"rbxasset://textures/particles/fire_main.dds\"\n+\n+local function ball(size: number, color: Color3, transparency: number?): Part\n+\tlocal p = Instance.new(\"Part\")\n+\tp.Shape = Enum.PartType.Ball\n+\tp.Size = Vector3.one * size\n+\tp.Color = color\n+\tp.Material = Enum.Material.Neon\n+\tp.Transparency = transparency or 0\n+\tp.Anchored = true\n+\tp.CanCollide = false\n+\tp.CanQuery = false\n+\tp.CanTouch = false\n+\tp.CastShadow = false\n+\tp.Parent = folder\n+\treturn p\n+end\n+\n+local function block(size: Vector3, color: Color3, shape: Enum.PartType?, transparency: number?): Part\n+\tlocal p = Instance.new(\"Part\")\n+\tp.Size = size\n+\tif shape then\n+\t\tp.Shape = shape\n+\tend\n+\tp.Color = color\n+\tp.Material = Enum.Material.Neon\n+\tp.Transparency = transparency or 0\n+\tp.Anchored = true\n+\tp.CanCollide = false\n+\tp.CanQuery = false\n+\tp.CanTouch = false\n+\tp.CastShadow = false\n+\tp.Parent = folder\n+\treturn p\n+end\n+\n+local function trail(part: BasePart, color: Color3, width: number, lifetime: number)\n+\tlocal a0 = Instance.new(\"Attachment\")\n+\ta0.Position = Vector3.new(0, width / 2, 0)\n+\ta0.Parent = part\n+\tlocal a1 = Instance.new(\"Attachment\")\n+\ta1.Position = Vector3.new(0, -width / 2, 0)\n+\ta1.Parent = part\n+\tlocal t = Instance.new(\"Trail\")\n+\tt.Attachment0 = a0\n+\tt.Attachment1 = a1\n+\tt.Lifetime = lifetime\n+\tt.Color = ColorSequence.new(color)\n+\tt.LightEmission = 1\n+\tt.LightInfluence = 0\n+\tt.FaceCamera = true\n+\tt.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })\n+\tt.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.1) })\n+\tt.Parent = part\n+\treturn t\n+end\n+\n+local function emitter(parent: Instance, props)\n+\tlocal e = Instance.new(\"ParticleEmitter\")\n+\te.Enabled = false\n+\te.LightEmission = 1\n+\te.LightInfluence = 0\n+\tfor k, v in pairs(props) do\n+\t\t(e :: any)[k] = v\n+\tend\n+\te.Parent = parent\n+\treturn e\n+end\n+\n+local function burstAt(pos: Vector3, color: Color3, count: number, speed: number, size: number, life: number?)\n+\tlocal holder = Instance.new(\"Part\")\n+\tholder.Anchored = true\n+\tholder.CanCollide = false\n+\tholder.CanQuery = false\n+\tholder.CanTouch = false\n+\tholder.Transparency = 1\n+\tholder.Size = Vector3.one * 0.2\n+\tholder.CFrame = CFrame.new(pos)\n+\tholder.Parent = folder\n+\tlocal e = emitter(holder, {\n+\t\tTexture = SPARK,\n+\t\tColor = ColorSequence.new(Color3.new(1, 1, 1), color),\n+\t\tSize = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) }),\n+\t\tSpeed = NumberRange.new(speed * 0.5, speed),\n+\t\tSpreadAngle = Vector2.new(180, 180),\n+\t\tLifetime = NumberRange.new((life or 0.35) * 0.6, life or 0.35),\n+\t\tDrag = 4,\n+\t\tRate = 0,\n+\t})\n+\te:Emit(count)\n+\tDebris:AddItem(holder, 1.5)\n+end\n+\n+local function smokeAt(pos: Vector3, color: Color3, count: number, size: number)\n+\tlocal holder = Instance.new(\"Part\")\n+\tholder.Anchored = true\n+\tholder.CanCollide = false\n+\tholder.CanQuery = false\n+\tholder.CanTouch = false\n+\tholder.Transparency = 1\n+\tholder.Size = Vector3.one * 0.2\n+\tholder.CFrame = CFrame.new(pos)\n+\tholder.Parent = folder\n+\tlocal e = emitter(holder, {\n+\t\tTexture = SMOKE,\n+\t\tLightEmission = 0.3,\n+\t\tColor = ColorSequence.new(color),\n+\t\tTransparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) }),\n+\t\tSize = NumberSequence.new({ NumberSequenceKeypoint.new(0, size * 0.5), NumberSequenceKeypoint.new(1, size) }),\n+\t\tSpeed = NumberRange.new(2, 6),\n+\t\tSpreadAngle = Vector2.new(180, 30),\n+\t\tLifetime = NumberRange.new(0.5, 0.9),\n+\t\tRate = 0,\n+\t})\n+\te:Emit(count)\n+\tDebris:AddItem(holder, 2)\n+end\n+\n+local function flash(pos: Vector3, color: Color3, size: number, time: number)\n+\tlocal b = ball(size, color, 0.1)\n+\tb.CFrame = CFrame.new(pos)\n+\tlocal l = Instance.new(\"PointLight\")\n+\tl.Color = color\n+\tl.Range = size * 4\n+\tl.Brightness = 3\n+\tl.Parent = b\n+\tTweenService:Create(b, TweenInfo.new(time), { Transparency = 1, Size = Vector3.one * size * 1.6 }):Play()\n+\tTweenService:Create(l, TweenInfo.new(time), { Brightness = 0 }):Play()\n+\tDebris:AddItem(b, time + 0.05)\n+end\n+FX.Flash = flash\n+\n+function FX.Shake(amp: number, dur: number)\n+\tlocal t = os.clock()\n+\tlocal remaining = math.max(0, shakeUntil - t) / shakeDur * shakeAmp\n+\tif amp >= remaining then\n+\t\tshakeAmp = amp\n+\t\tshakeDur = dur\n+\t\tshakeUntil = t + dur\n+\tend\n+end\n+\n+function FX.ShakeCFrame(): CFrame\n+\tlocal t = os.clock()\n+\tif t >= shakeUntil then\n+\t\treturn CFrame.identity\n+\tend\n+\tlocal k = (shakeUntil - t) / shakeDur\n+\tlocal a = shakeAmp * k\n+\treturn CFrame.new((math.random() - 0.5) * a, (math.random() - 0.5) * a, (math.random() - 0.5) * a * 0.5)\n+\t\t* CFrame.Angles(0, 0, (math.random() - 0.5) * a * 0.02)\n+end\n+\n+local function localModel(): Model?\n+\treturn State.localModel\n+end\n+\n+local function distToLocal(pos: Vector3): number\n+\tlocal m = localModel()\n+\tlocal root = m and m:FindFirstChild(\"HumanoidRootPart\")\n+\tif root then\n+\t\treturn (root.Position - pos).Magnitude\n+\tend\n+\treturn 999\n+end\n+\n+local function aimPos(model: Model?): Vector3?\n+\tif not model or not model.Parent then\n+\t\treturn nil\n+\tend\n+\tlocal root = model:FindFirstChild(\"HumanoidRootPart\") :: BasePart?\n+\tif not root then\n+\t\treturn nil\n+\tend\n+\treturn root.Position + Vector3.new(0, model:GetAttribute(\"AimY\") or 0, 0)\n+end\n+\n+----------------------------------------------------------------------------------------------\n+-- Projectiles\n+----------------------------------------------------------------------------------------------\n+local function removeVisual(id: number, fade: boolean?)\n+\tlocal v = visuals[id]\n+\tif not v then\n+\t\treturn\n+\tend\n+\tvisuals[id] = nil\n+\tfor _, part in ipairs(v.parts) do\n+\t\tif fade then\n+\t\t\tTweenService:Create(part, TweenInfo.new(0.15), { Transparency = 1 }):Play()\n+\t\t\tDebris:AddItem(part, 0.4)\n+\t\telse\n+\t\t\t-- let trails finish\n+\t\t\tpart.Transparency = 1\n+\t\t\tDebris:AddItem(part, 0.35)\n+\t\tend\n+\tend\n+end\n+\n+local function makeVisual(p)\n+\tlocal parts = {}\n+\tlocal main\n+\tlocal color = p.color or Color3.new(1, 1, 1)\n+\tlocal kind = p.kind\n+\tif kind == \"Bullet\" then\n+\t\tif p.style == \"Beam\" then\n+\t\t\tmain = block(Vector3.new(7, 1.3, 1.3), color, Enum.PartType.Cylinder)\n+\t\t\tlocal glow = block(Vector3.new(8, 2.6, 2.6), color, Enum.PartType.Cylinder, 0.7)\n+\t\t\ttable.insert(parts, glow)\n+\t\t\ttrail(main, color, 1.6, 0.25)\n+\t\t\tlocal l = Instance.new(\"PointLight\")\n+\t\t\tl.Color = color\n+\t\t\tl.Range = 14\n+\t\t\tl.Brightness = 2\n+\t\t\tl.Parent = main\n+\t\t\tp.glow = glow\n+\t\telseif p.style == \"Pellet\" then\n+\t\t\tmain = ball(p.size * 0.9, color)\n+\t\t\ttrail(main, color, 0.6, 0.12)\n+\t\telse\n+\t\t\tmain = ball(p.size, color)\n+\t\t\tlocal core = ball(p.size * 0.55, Color3.new(1, 1, 1))\n+\t\t\ttable.insert(parts, core)\n+\t\t\tp.core = core\n+\t\t\ttrail(main, color, p.size * 0.8, 0.18)\n+\t\tend\n+\telseif kind == \"Bomb\" then\n+\t\tmain = ball(p.size, color)\n+\t\tlocal ring = block(Vector3.new(0.2, p.size * 1.7, p.size * 1.7), Color3.new(1, 1, 1), Enum.PartType.Cylinder, 0.3)\n+\t\ttable.insert(parts, ring)\n+\t\tp.ring = ring\n+\t\ttrail(main, color, p.size * 0.6, 0.35)\n+\t\t-- landing marker telegraph\n+\t\tif p.finish then\n+\t\t\tlocal r = (p.radius or 8) * 2\n+\t\t\tlocal marker = block(Vector3.new(0.15, r, r), Config.Match and color or color, Enum.PartType.Cylinder, 0.65)\n+\t\t\tmarker.CFrame = CFrame.new(p.finish + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, 0, math.rad(90))\n+\t\t\ttable.insert(parts, marker)\n+\t\t\tp.marker = marker\n+\t\tend\n+\telseif kind == \"Seeker\" or kind == \"Orbit\" then\n+\t\tmain = ball(p.size, color, 0.15)\n+\t\tlocal core = ball(p.size * 0.5, Color3.new(1, 1, 1))\n+\t\ttable.insert(parts, core)\n+\t\tp.core = core\n+\t\tlocal l = Instance.new(\"PointLight\")\n+\t\tl.Color = color\n+\t\tl.Range = 10\n+\t\tl.Brightness = 1.5\n+\t\tl.Parent = main\n+\t\ttrail(main, color, p.size * 0.5, 0.4)\n+\telseif kind == \"Mine\" then\n+\t\tmain = block(Vector3.new(0.7, p.size, p.size), Color3.fromRGB(40, 40, 50), Enum.PartType.Cylinder)\n+\t\tmain.Material = Enum.Material.Metal\n+\t\tlocal light = ball(0.9, color)\n+\t\ttable.insert(parts, light)\n+\t\tp.light = light\n+\t\tlocal r = (p.radius or 9) * 2\n+\t\tlocal ring = block(Vector3.new(0.12, r, r), color, Enum.PartType.Cylinder, 1)\n+\t\ttable.insert(parts, ring)\n+\t\tp.triggerRing = ring\n+\tend\n+\ttable.insert(parts, 1, main)\n+\treturn { p = p, main = main, parts = parts, prevPos = p.pos }\n+end\n+\n+local function onProj(data)\n+\tlocal p = table.clone(data)\n+\tp.age = 0\n+\tlocal targetModel = p.target\n+\tp.target = nil\n+\tp.targetModel = targetModel\n+\tif p.kind == \"Bomb\" then\n+\t\tp.radius = data.radius\n+\tend\n+\tlocal v = makeVisual(p)\n+\tlocal elapsed = workspace:GetServerTimeNow() - (data.t0 or workspace:GetServerTimeNow())\n+\tif elapsed > 0 then\n+\t\tSim.fastForward(p, elapsed, aimPos(targetModel))\n+\tend\n+\tvisuals[p.id] = v\n+end\n+\n+local function updateVisual(v, dt: number, tclock: number)\n+\tlocal p = v.p\n+\tlocal prev = p.pos\n+\tSim.step(p, dt, aimPos(p.targetModel))\n+\tif v.syncPos then\n+\t\tlocal k = 1 - math.exp(-dt * 10)\n+\t\tp.pos = p.pos:Lerp(v.syncPos, k)\n+\t\tv.syncPos = v.syncPos + (p.pos - prev)\n+\t\tif (v.syncPos - p.pos).Magnitude < 0.05 then\n+\t\t\tv.syncPos = nil\n+\t\tend\n+\tend\n+\tlocal vel = p.pos - prev\n+\tlocal look = vel.Magnitude > 1e-4 and vel.Unit or (p.dir or Vector3.zAxis)\n+\tlocal main = v.main\n+\tif p.kind == \"Bullet\" and p.style == \"Beam\" then\n+\t\tlocal cf = CFrame.lookAt(p.pos, p.pos + look) * CFrame.Angles(0, math.rad(90), 0)\n+\t\tmain.CFrame = cf\n+\t\tp.glow.CFrame = cf\n+\telseif p.kind == \"Mine\" then\n+\t\tmain.CFrame = CFrame.new(p.pos) * CFrame.Angles(0, 0, math.rad(90))\n+\t\tp.light.CFrame = CFrame.new(p.pos + Vector3.new(0, 0.5, 0))\n+\t\tlocal armed = p.landed and p.age >= (p.throwTime or 0) + (p.armTime or 0)\n+\t\tlocal blink = armed and (math.floor(tclock * 6) % 2 == 0) or (math.floor(tclock * 2) % 2 == 0)\n+\t\tp.light.Transparency = blink and 0 or 0.7\n+\t\tp.triggerRing.CFrame = CFrame.new(Vector3.new(p.pos.X, p.floorRingY or (p.pos.Y - 0.8), p.pos.Z)) * CFrame.Angles(0, 0, math.rad(90))\n+\t\tp.triggerRing.Transparency = armed and 0.75 or 1\n+\telse\n+\t\tmain.CFrame = CFrame.lookAt(p.pos, p.pos + look)\n+\t\tif p.core then\n+\t\t\tp.core.CFrame = main.CFrame\n+\t\t\tif p.kind ~= \"Bullet\" then\n+\t\t\t\tlocal s = p.size * (0.45 + 0.15 * math.sin(tclock * 12))\n+\t\t\t\tp.core.Size = Vector3.one * s\n+\t\t\tend\n+\t\tend\n+\t\tif p.ring then\n+\t\t\tp.ring.CFrame = CFrame.new(p.pos) * CFrame.Angles(tclock * 6, tclock * 4, 0)\n+\t\tend\n+\tend\n+\tif p.age > (p.life or 3) + 2 then\n+\t\treturn false\n+\tend\n+\treturn true\n+end\n+\n+local function onProjEnd(data)\n+\tlocal v = visuals[data.id]\n+\tlocal pos = data.pos\n+\tif v then\n+\t\tlocal color = v.p.color or Color3.new(1, 1, 1)\n+\t\tif data.reason == \"wall\" then\n+\t\t\tburstAt(pos, color, 8, 18, 0.6)\n+\t\t\tflash(pos, color, 1.4, 0.12)\n+\t\telseif data.reason == \"expire\" then\n+\t\t\tremoveVisual(data.id, true)\n+\t\t\treturn\n+\t\tend\n+\tend\n+\tremoveVisual(data.id, false)\n+end\n+\n+local function onProjSync(list)\n+\tfor _, e in ipairs(list) do\n+\t\tlocal v = visuals[e[1]]\n+\t\tif v then\n+\t\t\tv.syncPos = e[2]\n+\t\t\tif e[3] then\n+\t\t\t\tv.p.dir = e[3]\n+\t\t\tend\n+\t\tend\n+\tend\n+end\n+\n+local function clearAll()\n+\tfor id in pairs(visuals) do\n+\t\tremoveVisual(id, true)\n+\tend\n+\tfor model in pairs(charges) do\n+\t\tFX.StopCharge(model)\n+\tend\n+end\n+FX.ClearAll = clearAll\n+\n+----------------------------------------------------------------------------------------------\n+-- Blasts / hits / misc\n+----------------------------------------------------------------------------------------------\n+local function onBlast(data)\n+\tlocal pos, r, linger, color = data.pos, data.radius, data.linger, data.color or Color3.fromRGB(255, 140, 60)\n+\tlocal sphere = ball(r * 0.6, color, 0.15)\n+\tsphere.CFrame = CFrame.new(pos)\n+\tlocal core = ball(r * 0.35, Color3.new(1, 1, 1), 0.05)\n+\tcore.CFrame = CFrame.new(pos)\n+\tlocal ring = block(Vector3.new(0.3, r * 1.2, r * 1.2), Color3.new(1, 1, 1), Enum.PartType.Cylinder, 0.2)\n+\tring.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))\n+\tlocal light = Instance.new(\"PointLight\")\n+\tlight.Color = color\n+\tlight.Range = r * 3.5\n+\tlight.Brightness = 5\n+\tlight.Parent = sphere\n+\tTweenService:Create(sphere, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.one * r * 2 }):Play()\n+\tTweenService:Create(core, TweenInfo.new(0.2), { Size = Vector3.one * r * 1.2, Transparency = 0.6 }):Play()\n+\tTweenService:Create(ring, TweenInfo.new(0.35), { Size = Vector3.new(0.3, r * 3.2, r * 3.2), Transparency = 1 }):Play()\n+\tTweenService:Create(light, TweenInfo.new(linger + 0.2), { Brightness = 0 }):Play()\n+\tburstAt(pos, color, 30, 45, 1.6, 0.6)\n+\tsmokeAt(pos, Color3.fromRGB(70, 60, 90), 10, r * 0.9)\n+\ttask.spawn(function()\n+\t\tlocal t0 = os.clock()\n+\t\twhile os.clock() - t0 < linger do\n+\t\t\tsphere.Transparency = 0.25 + math.random() * 0.2\n+\t\t\ttask.wait(0.05)\n+\t\tend\n+\t\tTweenService:Create(sphere, TweenInfo.new(0.25), { Transparency = 1, Size = Vector3.one * r * 2.2 }):Play()\n+\t\tTweenService:Create(core, TweenInfo.new(0.2), { Transparency = 1 }):Play()\n+\t\ttask.wait(0.3)\n+\t\tsphere:Destroy()\n+\t\tcore:Destroy()\n+\t\tring:Destroy()\n+\tend)\n+\tlocal d = distToLocal(pos)\n+\tlocal amp = (data.big and 2.2 or 1.4) * math.clamp(1 - d / 70, 0.15, 1)\n+\tFX.Shake(amp, 0.35)\n+\tSound.Play(\"Explosion\", { volume = data.big and 1.2 or 0.9, pitch = data.big and 0.8 or 1 })\n+end\n+\n+local function onHit(data)\n+\tlocal victim = data.victim\n+\tlocal color = Color3.fromRGB(255, 230, 120)\n+\tburstAt(data.pos, color, data.heavy and 26 or 14, data.heavy and 40 or 28, data.heavy and 1.4 or 0.9)\n+\tflash(data.pos, Color3.new(1, 1, 1), data.heavy and 3 or 1.8, 0.12)\n+\tif HUD then\n+\t\tHUD.ShowHit(victim, data.pos, data.amount, data.combo, data.heavy)\n+\tend\n+\tif RobotAnim then\n+\t\tRobotAnim.Flinch(victim)\n+\tend\n+\tif victim == localModel() then\n+\t\tFX.Shake(data.heavy and 2.6 or 0.9, data.heavy and 0.45 or 0.2)\n+\t\tif HUD then\n+\t\t\tHUD.DamageVignette(data.heavy)\n+\t\tend\n+\telseif data.attacker == localModel() and data.heavy then\n+\t\tFX.Shake(1.0, 0.2)\n+\tend\n+\tSound.Play(data.heavy and \"HeavyHit\" or \"Hit\")\n+end\n+\n+local WEAPON_ATT = { Gun = \"GunTip\", Bomb = \"BombTip\", Pod = \"PodTip\" }\n+local function onFire(data)\n+\tlocal model = data.model\n+\tif not model or not model.Parent then\n+\t\treturn\n+\tend\n+\tlocal att = model:FindFirstChild(WEAPON_ATT[data.weapon] or \"GunTip\", true)\n+\tlocal robot = Config.RobotById[model:GetAttribute(\"RobotId\") or \"Bolt\"]\n+\tlocal loadout = Config.GetLoadout(robot.Id)\n+\tlocal color = data.weapon == \"Gun\" and loadout.Gun.Color or (data.weapon == \"Bomb\" and loadout.Bomb.Color or loadout.Pod.Color)\n+\tif att and att:IsA(\"Attachment\") then\n+\t\tflash(att.WorldPosition, color, data.weapon == \"Gun\" and 1.8 or 2.4, 0.1)\n+\tend\n+\tif RobotAnim then\n+\t\tRobotAnim.OnFire(model, data.weapon)\n+\tend\n+\tif model == localModel() and Battle then\n+\t\tBattle.OnLocalFire(data)\n+\tend\n+\tif data.weapon == \"Gun\" then\n+\t\tSound.Play(data.gunType == \"Spread\" and \"Shotgun\" or (data.gunType == \"Charge\" and \"Laser\" or \"Blaster\"))\n+\telseif data.weapon == \"Bomb\" then\n+\t\tSound.Play(\"BombThrow\")\n+\telse\n+\t\tSound.Play(\"Pod\")\n+\tend\n+end\n+\n+function FX.StopCharge(model)\n+\tlocal ch = charges[model]\n+\tif ch then\n+\t\tcharges[model] = nil\n+\t\tch.orb:Destroy()\n+\t\tif ch.sound then\n+\t\t\tch.sound:Destroy()\n+\t\tend\n+\tend\n+end\n+\n+local function onCharge(data)\n+\tlocal model = data.model\n+\tif not model then\n+\t\treturn\n+\tend\n+\tif data.on then\n+\t\tFX.StopCharge(model)\n+\t\tlocal robot = Config.RobotById[model:GetAttribute(\"RobotId\") or \"Lancer\"]\n+\t\tlocal color = Config.GetLoadout(robot.Id).Gun.Color\n+\t\tlocal orb = ball(0.4, color, 0.1)\n+\t\tlocal l = Instance.new(\"PointLight\")\n+\t\tl.Color = color\n+\t\tl.Range = 8\n+\t\tl.Brightness = 2\n+\t\tl.Parent = orb\n+\t\tcharges[model] = { orb = orb, t0 = os.clock(), dur = data.chargeTime or 0.8, color = color, sound = Sound.Play(\"Charge\", { vary = 0 }) }\n+\telse\n+\t\tFX.StopCharge(model)\n+\tend\n+end\n+\n+local function trailFor(model: Model)\n+\tlocal t = trails[model]\n+\tif t and t.Parent then\n+\t\treturn t\n+\tend\n+\tlocal torso = model:FindFirstChild(\"Torso\")\n+\tif not torso then\n+\t\treturn nil\n+\tend\n+\tlocal robot = Config.RobotById[model:GetAttribute(\"RobotId\") or \"Bolt\"]\n+\tlocal a0 = Instance.new(\"Attachment\")\n+\ta0.Name = \"RCTrailTop\"\n+\ta0.Position = Vector3.new(0, 1.2, 0.5)\n+\ta0.Parent = torso\n+\tlocal a1 = Instance.new(\"Attachment\")\n+\ta1.Name = \"RCTrailBottom\"\n+\ta1.Position = Vector3.new(0, -2.5, 0.5)\n+\ta1.Parent = torso\n+\tlocal tr = Instance.new(\"Trail\")\n+\ttr.Attachment0 = a0\n+\ttr.Attachment1 = a1\n+\ttr.Lifetime = 0.22\n+\ttr.Color = ColorSequence.new(robot.Neon)\n+\ttr.LightEmission = 1\n+\ttr.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })\n+\ttr.Enabled = false\n+\ttr.Parent = torso\n+\ttrails[model] = tr\n+\treturn tr\n+end\n+\n+local function onDash(data)\n+\tlocal model = data.model\n+\tif not model or not model.Parent then\n+\t\treturn\n+\tend\n+\tlocal tr = trailFor(model)\n+\tif tr then\n+\t\ttr.Enabled = true\n+\t\ttask.delay(0.32, function()\n+\t\t\tif tr.Parent then\n+\t\t\t\ttr.Enabled = false\n+\t\t\tend\n+\t\tend)\n+\tend\n+\tlocal root = model:FindFirstChild(\"HumanoidRootPart\")\n+\tif root and not data.air then\n+\t\tsmokeAt(root.Position - Vector3.new(0, 3.5, 0), Color3.fromRGB(150, 160, 200), 6, 2.5)\n+\tend\n+\tSound.Play(\"Dash\")\n+end\n+\n+local handlers = {\n+\tProj = onProj,\n+\tProjEnd = onProjEnd,\n+\tProjSync = onProjSync,\n+\tClearProj = clearAll,\n+\tBlast = onBlast,\n+\tHit = onHit,\n+\tFire = onFire,\n+\tCharge = onCharge,\n+\tDash = onDash,\n+\tDown = function(data)\n+\t\tif HUD then\n+\t\t\tHUD.TagText(data.model, \"DOWN\", Color3.fromRGB(255, 90, 170))\n+\t\tend\n+\t\tSound.Play(\"Down\")\n+\t\tif data.model == localModel() then\n+\t\t\tFX.Shake(2.2, 0.4)\n+\t\tend\n+\tend,\n+\tRebirth = function(data)\n+\t\tif HUD then\n+\t\t\tHUD.TagText(data.model, \"REBIRTH\", Color3.fromRGB(255, 255, 255))\n+\t\tend\n+\tend,\n+\tPit = function(data)\n+\t\tif HUD then\n+\t\t\tHUD.TagText(data.model, \"PIT  -\" .. tostring(data.amount), Color3.fromRGB(255, 80, 80))\n+\t\tend\n+\t\tSound.Play(\"HeavyHit\")\n+\tend,\n+}\n+\n+function FX.Init(deps)\n+\tHUD = deps.HUD\n+\tRobotAnim = deps.RobotAnim\n+\tBattle = deps.Battle\n+\tRC.Remotes.FX.OnClientEvent:Connect(function(kind, data)\n+\t\tlocal h = handlers[kind]\n+\t\tif h then\n+\t\t\tlocal ok, err = pcall(h, data)\n+\t\t\tif not ok then\n+\t\t\t\twarn(\"[RoboClash FX] \" .. tostring(kind) .. \": \" .. tostring(err))\n+\t\t\tend\n+\t\tend\n+\tend)\n+\tRunService.RenderStepped:Connect(function(dt)\n+\t\tlocal tclock = os.clock()\n+\t\tfor id, v in pairs(visuals) do\n+\t\t\tlocal ok, keep = pcall(updateVisual, v, dt, tclock)\n+\t\t\tif not ok or not keep then\n+\t\t\t\tremoveVisual(id, true)\n+\t\t\tend\n+\t\tend\n+\t\tfor model, ch in pairs(charges) do\n+\t\t\tlocal att = model.Parent and model:FindFirstChild(\"GunTip\", true)\n+\t\t\tif not att then\n+\t\t\t\tFX.StopCharge(model)\n+\t\t\telse\n+\t\t\t\tlocal k = math.clamp((tclock - ch.t0) / ch.dur, 0, 1)\n+\t\t\t\tlocal full = k >= 1\n+\t\t\t\tlocal s = 0.4 + 1.6 * k + (full and 0.25 * math.sin(tclock * 30) or 0)\n+\t\t\t\tch.orb.Size = Vector3.one * s\n+\t\t\t\tch.orb.CFrame = CFrame.new((att :: Attachment).WorldPosition)\n+\t\t\t\tch.orb.Color = full and Color3.new(1, 1, 1) or ch.color\n+\t\t\tend\n+\t\tend\n+\tend)\n+end\n+\n+function FX.Folder()\n+\treturn folder\n+end\n+\n+-- Silence unused warning for Players (kept for future per-player FX filtering).\n+local _ = Players\n+\n+return FX","afterFullFileContent":"-- Client visuals for server-authoritative combat: projectiles (simulated locally with the shared\n-- ProjectileSim, corrected by ProjSync/ProjEnd), blasts, sparks, muzzle flashes, charge glow,\n-- dash trails, and screen shake. All instances here are local-only.\nlocal Debris = game:GetService(\"Debris\")\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal TweenService = game:GetService(\"TweenService\")\n\nlocal RC = ReplicatedStorage:WaitForChild(\"RoboClash\")\nlocal Config = require(RC.Config)\nlocal Sim = require(RC.Shared.ProjectileSim)\nlocal State = require(script.Parent.State)\nlocal Sound = require(script.Parent.Sound)\n\nlocal FX = {}\nlocal HUD, RobotAnim, Battle -- injected\n\nlocal folder = Instance.new(\"Folder\")\nfolder.Name = \"RoboClashFX\"\nfolder.Parent = workspace\n\nlocal visuals = {}\nlocal charges = {}\nlocal trails = {}\nlocal shakeAmp, shakeUntil, shakeDur = 0, 0, 0.001\n\nlocal SPARK = \"rbxasset://textures/particles/sparkles_main.dds\"\nlocal SMOKE = \"rbxasset://textures/particles/smoke_main.dds\"\nlocal FIRE = \"rbxasset://textures/particles/fire_main.dds\"\n\nlocal function ball(size: number, color: Color3, transparency: number?): Part\n\tlocal p = Instance.new(\"Part\")\n\tp.Shape = Enum.PartType.Ball\n\tp.Size = Vector3.one * size\n\tp.Color = color\n\tp.Material = Enum.Material.Neon\n\tp.Transparency = transparency or 0\n\tp.Anchored = true\n\tp.CanCollide = false\n\tp.CanQuery = false\n\tp.CanTouch = false\n\tp.CastShadow = false\n\tp.Parent = folder\n\treturn p\nend\n\nlocal function block(size: Vector3, color: Color3, shape: Enum.PartType?, transparency: number?): Part\n\tlocal p = Instance.new(\"Part\")\n\tp.Size = size\n\tif shape then\n\t\tp.Shape = shape\n\tend\n\tp.Color = color\n\tp.Material = Enum.Material.Neon\n\tp.Transparency = transparency or 0\n\tp.Anchored = true\n\tp.CanCollide = false\n\tp.CanQuery = false\n\tp.CanTouch = false\n\tp.CastShadow = false\n\tp.Parent = folder\n\treturn p\nend\n\nlocal function trail(part: BasePart, color: Color3, width: number, lifetime: number)\n\tlocal a0 = Instance.new(\"Attachment\")\n\ta0.Position = Vector3.new(0, width / 2, 0)\n\ta0.Parent = part\n\tlocal a1 = Instance.new(\"Attachment\")\n\ta1.Position = Vector3.new(0, -width / 2, 0)\n\ta1.Parent = part\n\tlocal t = Instance.new(\"Trail\")\n\tt.Attachment0 = a0\n\tt.Attachment1 = a1\n\tt.Lifetime = lifetime\n\tt.Color = ColorSequence.new(color)\n\tt.LightEmission = 1\n\tt.LightInfluence = 0\n\tt.FaceCamera = true\n\tt.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })\n\tt.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.1) })\n\tt.Parent = part\n\treturn t\nend\n\nlocal function emitter(parent: Instance, props)\n\tlocal e = Instance.new(\"ParticleEmitter\")\n\te.Enabled = false\n\te.LightEmission = 1\n\te.LightInfluence = 0\n\tfor k, v in pairs(props) do\n\t\t(e :: any)[k] = v\n\tend\n\te.Parent = parent\n\treturn e\nend\n\nlocal function burstAt(pos: Vector3, color: Color3, count: number, speed: number, size: number, life: number?)\n\tlocal holder = Instance.new(\"Part\")\n\tholder.Anchored = true\n\tholder.CanCollide = false\n\tholder.CanQuery = false\n\tholder.CanTouch = false\n\tholder.Transparency = 1\n\tholder.Size = Vector3.one * 0.2\n\tholder.CFrame = CFrame.new(pos)\n\tholder.Parent = folder\n\tlocal e = emitter(holder, {\n\t\tTexture = SPARK,\n\t\tColor = ColorSequence.new(Color3.new(1, 1, 1), color),\n\t\tSize = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) }),\n\t\tSpeed = NumberRange.new(speed * 0.5, speed),\n\t\tSpreadAngle = Vector2.new(180, 180),\n\t\tLifetime = NumberRange.new((life or 0.35) * 0.6, life or 0.35),\n\t\tDrag = 4,\n\t\tRate = 0,\n\t})\n\te:Emit(count)\n\tDebris:AddItem(holder, 1.5)\nend\n\nlocal function smokeAt(pos: Vector3, color: Color3, count: number, size: number)\n\tlocal holder = Instance.new(\"Part\")\n\tholder.Anchored = true\n\tholder.CanCollide = false\n\tholder.CanQuery = false\n\tholder.CanTouch = false\n\tholder.Transparency = 1\n\tholder.Size = Vector3.one * 0.2\n\tholder.CFrame = CFrame.new(pos)\n\tholder.Parent = folder\n\tlocal e = emitter(holder, {\n\t\tTexture = SMOKE,\n\t\tLightEmission = 0.3,\n\t\tColor = ColorSequence.new(color),\n\t\tTransparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) }),\n\t\tSize = NumberSequence.new({ NumberSequenceKeypoint.new(0, size * 0.5), NumberSequenceKeypoint.new(1, size) }),\n\t\tSpeed = NumberRange.new(2, 6),\n\t\tSpreadAngle = Vector2.new(180, 30),\n\t\tLifetime = NumberRange.new(0.5, 0.9),\n\t\tRate = 0,\n\t})\n\te:Emit(count)\n\tDebris:AddItem(holder, 2)\nend\n\nlocal function flash(pos: Vector3, color: Color3, size: number, time: number)\n\tlocal b = ball(size, color, 0.1)\n\tb.CFrame = CFrame.new(pos)\n\tlocal l = Instance.new(\"PointLight\")\n\tl.Color = color\n\tl.Range = size * 4\n\tl.Brightness = 3\n\tl.Parent = b\n\tTweenService:Create(b, TweenInfo.new(time), { Transparency = 1, Size = Vector3.one * size * 1.6 }):Play()\n\tTweenService:Create(l, TweenInfo.new(time), { Brightness = 0 }):Play()\n\tDebris:AddItem(b, time + 0.05)\nend\nFX.Flash = flash\n\nfunction FX.Shake(amp: number, dur: number)\n\tlocal t = os.clock()\n\tlocal remaining = math.max(0, shakeUntil - t) / shakeDur * shakeAmp\n\tif amp >= remaining then\n\t\tshakeAmp = amp\n\t\tshakeDur = dur\n\t\tshakeUntil = t + dur\n\tend\nend\n\nfunction FX.ShakeCFrame(): CFrame\n\tlocal t = os.clock()\n\tif t >= shakeUntil then\n\t\treturn CFrame.identity\n\tend\n\tlocal k = (shakeUntil - t) / shakeDur\n\tlocal a = shakeAmp * k\n\treturn CFrame.new((math.random() - 0.5) * a, (math.random() - 0.5) * a, (math.random() - 0.5) * a * 0.5)\n\t\t* CFrame.Angles(0, 0, (math.random() - 0.5) * a * 0.02)\nend\n\nlocal function localModel(): Model?\n\treturn State.localModel\nend\n\nlocal function distToLocal(pos: Vector3): number\n\tlocal m = localModel()\n\tlocal root = m and m:FindFirstChild(\"HumanoidRootPart\")\n\tif root then\n\t\treturn (root.Position - pos).Magnitude\n\tend\n\treturn 999\nend\n\nlocal function aimPos(model: Model?): Vector3?\n\tif not model or not model.Parent then\n\t\treturn nil\n\tend\n\tlocal root = model:FindFirstChild(\"HumanoidRootPart\") :: BasePart?\n\tif not root then\n\t\treturn nil\n\tend\n\treturn root.Position + Vector3.new(0, model:GetAttribute(\"AimY\") or 0, 0)\nend\n\n----------------------------------------------------------------------------------------------\n-- Projectiles\n----------------------------------------------------------------------------------------------\nlocal function removeVisual(id: number, fade: boolean?)\n\tlocal v = visuals[id]\n\tif not v then\n\t\treturn\n\tend\n\tvisuals[id] = nil\n\tfor _, part in ipairs(v.parts) do\n\t\tif fade then\n\t\t\tTweenService:Create(part, TweenInfo.new(0.15), { Transparency = 1 }):Play()\n\t\t\tDebris:AddItem(part, 0.4)\n\t\telse\n\t\t\t-- let trails finish\n\t\t\tpart.Transparency = 1\n\t\t\tDebris:AddItem(part, 0.35)\n\t\tend\n\tend\nend\n\nlocal function makeVisual(p)\n\tlocal parts = {}\n\tlocal main\n\tlocal color = p.color or Color3.new(1, 1, 1)\n\tlocal kind = p.kind\n\tif kind == \"Bullet\" then\n\t\tif p.style == \"Beam\" then\n\t\t\tmain = block(Vector3.new(7, 1.3, 1.3), color, Enum.PartType.Cylinder)\n\t\t\tlocal glow = block(Vector3.new(8, 2.6, 2.6), color, Enum.PartType.Cylinder, 0.7)\n\t\t\ttable.insert(parts, glow)\n\t\t\ttrail(main, color, 1.6, 0.25)\n\t\t\tlocal l = Instance.new(\"PointLight\")\n\t\t\tl.Color = color\n\t\t\tl.Range = 14\n\t\t\tl.Brightness = 2\n\t\t\tl.Parent = main\n\t\t\tp.glow = glow\n\t\telseif p.style == \"Pellet\" then\n\t\t\tmain = ball(p.size * 0.9, color)\n\t\t\ttrail(main, color, 0.6, 0.12)\n\t\telse\n\t\t\tmain = ball(p.size, color)\n\t\t\tlocal core = ball(p.size * 0.55, Color3.new(1, 1, 1))\n\t\t\ttable.insert(parts, core)\n\t\t\tp.core = core\n\t\t\ttrail(main, color, p.size * 0.8, 0.18)\n\t\tend\n\telseif kind == \"Bomb\" then\n\t\tmain = ball(p.size, color)\n\t\tlocal ring = block(Vector3.new(0.2, p.size * 1.7, p.size * 1.7), Color3.new(1, 1, 1), Enum.PartType.Cylinder, 0.3)\n\t\ttable.insert(parts, ring)\n\t\tp.ring = ring\n\t\ttrail(main, color, p.size * 0.6, 0.35)\n\t\t-- landing marker telegraph\n\t\tif p.finish then\n\t\t\tlocal r = (p.radius or 8) * 2\n\t\t\tlocal marker = block(Vector3.new(0.15, r, r), Config.Match and color or color, Enum.PartType.Cylinder, 0.65)\n\t\t\tmarker.CFrame = CFrame.new(p.finish + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, 0, math.rad(90))\n\t\t\ttable.insert(parts, marker)\n\t\t\tp.marker = marker\n\t\tend\n\telseif kind == \"Seeker\" or kind == \"Orbit\" then\n\t\tmain = ball(p.size, color, 0.15)\n\t\tlocal core = ball(p.size * 0.5, Color3.new(1, 1, 1))\n\t\ttable.insert(parts, core)\n\t\tp.core = core\n\t\tlocal l = Instance.new(\"PointLight\")\n\t\tl.Color = color\n\t\tl.Range = 10\n\t\tl.Brightness = 1.5\n\t\tl.Parent = main\n\t\ttrail(main, color, p.size * 0.5, 0.4)\n\telseif kind == \"Mine\" then\n\t\tmain = block(Vector3.new(0.7, p.size, p.size), Color3.fromRGB(40, 40, 50), Enum.PartType.Cylinder)\n\t\tmain.Material = Enum.Material.Metal\n\t\tlocal light = ball(0.9, color)\n\t\ttable.insert(parts, light)\n\t\tp.light = light\n\t\tlocal r = (p.radius or 9) * 2\n\t\tlocal ring = block(Vector3.new(0.12, r, r), color, Enum.PartType.Cylinder, 1)\n\t\ttable.insert(parts, ring)\n\t\tp.triggerRing = ring\n\tend\n\ttable.insert(parts, 1, main)\n\treturn { p = p, main = main, parts = parts, prevPos = p.pos }\nend\n\nlocal function onProj(data)\n\tlocal p = table.clone(data)\n\tp.age = 0\n\tlocal targetModel = p.target\n\tp.target = nil\n\tp.targetModel = targetModel\n\tif p.kind == \"Bomb\" then\n\t\tp.radius = data.radius\n\tend\n\tlocal v = makeVisual(p)\n\tlocal elapsed = workspace:GetServerTimeNow() - (data.t0 or workspace:GetServerTimeNow())\n\tif elapsed > 0 then\n\t\tSim.fastForward(p, elapsed, aimPos(targetModel))\n\tend\n\tvisuals[p.id] = v\nend\n\nlocal function updateVisual(v, dt: number, tclock: number)\n\tlocal p = v.p\n\tlocal prev = p.pos\n\tSim.step(p, dt, aimPos(p.targetModel))\n\tif v.syncPos then\n\t\tlocal k = 1 - math.exp(-dt * 10)\n\t\tp.pos = p.pos:Lerp(v.syncPos, k)\n\t\tv.syncPos = v.syncPos + (p.pos - prev)\n\t\tif (v.syncPos - p.pos).Magnitude < 0.05 then\n\t\t\tv.syncPos = nil\n\t\tend\n\tend\n\tlocal vel = p.pos - prev\n\tlocal look = vel.Magnitude > 1e-4 and vel.Unit or (p.dir or Vector3.zAxis)\n\tlocal main = v.main\n\tif p.kind == \"Bullet\" and p.style == \"Beam\" then\n\t\tlocal cf = CFrame.lookAt(p.pos, p.pos + look) * CFrame.Angles(0, math.rad(90), 0)\n\t\tmain.CFrame = cf\n\t\tp.glow.CFrame = cf\n\telseif p.kind == \"Mine\" then\n\t\tmain.CFrame = CFrame.new(p.pos) * CFrame.Angles(0, 0, math.rad(90))\n\t\tp.light.CFrame = CFrame.new(p.pos + Vector3.new(0, 0.5, 0))\n\t\tlocal armed = p.landed and p.age >= (p.throwTime or 0) + (p.armTime or 0)\n\t\tlocal blink = armed and (math.floor(tclock * 6) % 2 == 0) or (math.floor(tclock * 2) % 2 == 0)\n\t\tp.light.Transparency = blink and 0 or 0.7\n\t\tp.triggerRing.CFrame = CFrame.new(Vector3.new(p.pos.X, p.floorRingY or (p.pos.Y - 0.8), p.pos.Z)) * CFrame.Angles(0, 0, math.rad(90))\n\t\tp.triggerRing.Transparency = armed and 0.75 or 1\n\telse\n\t\tmain.CFrame = CFrame.lookAt(p.pos, p.pos + look)\n\t\tif p.core then\n\t\t\tp.core.CFrame = main.CFrame\n\t\t\tif p.kind ~= \"Bullet\" then\n\t\t\t\tlocal s = p.size * (0.45 + 0.15 * math.sin(tclock * 12))\n\t\t\t\tp.core.Size = Vector3.one * s\n\t\t\tend\n\t\tend\n\t\tif p.ring then\n\t\t\tp.ring.CFrame = CFrame.new(p.pos) * CFrame.Angles(tclock * 6, tclock * 4, 0)\n\t\tend\n\tend\n\tif p.age > (p.life or 3) + 2 then\n\t\treturn false\n\tend\n\treturn true\nend\n\nlocal function onProjEnd(data)\n\tlocal v = visuals[data.id]\n\tlocal pos = data.pos\n\tif v then\n\t\tlocal color = v.p.color or Color3.new(1, 1, 1)\n\t\tif data.reason == \"wall\" then\n\t\t\tburstAt(pos, color, 8, 18, 0.6)\n\t\t\tflash(pos, color, 1.4, 0.12)\n\t\telseif data.reason == \"expire\" then\n\t\t\tremoveVisual(data.id, true)\n\t\t\treturn\n\t\tend\n\tend\n\tremoveVisual(data.id, false)\nend\n\nlocal function onProjSync(list)\n\tfor _, e in ipairs(list) do\n\t\tlocal v = visuals[e[1]]\n\t\tif v then\n\t\t\tv.syncPos = e[2]\n\t\t\tif e[3] then\n\t\t\t\tv.p.dir = e[3]\n\t\t\tend\n\t\tend\n\tend\nend\n\nlocal function clearAll()\n\tfor id in pairs(visuals) do\n\t\tremoveVisual(id, true)\n\tend\n\tfor model in pairs(charges) do\n\t\tFX.StopCharge(model)\n\tend\nend\nFX.ClearAll = clearAll\n\n----------------------------------------------------------------------------------------------\n-- Blasts / hits / misc\n----------------------------------------------------------------------------------------------\nlocal function onBlast(data)\n\tlocal pos, r, linger, color = data.pos, data.radius, data.linger, data.color or Color3.fromRGB(255, 140, 60)\n\tlocal sphere = ball(r * 0.6, color, 0.15)\n\tsphere.CFrame = CFrame.new(pos)\n\tlocal core = ball(r * 0.35, Color3.new(1, 1, 1), 0.05)\n\tcore.CFrame = CFrame.new(pos)\n\tlocal ring = block(Vector3.new(0.3, r * 1.2, r * 1.2), Color3.new(1, 1, 1), Enum.PartType.Cylinder, 0.2)\n\tring.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))\n\tlocal light = Instance.new(\"PointLight\")\n\tlight.Color = color\n\tlight.Range = r * 3.5\n\tlight.Brightness = 5\n\tlight.Parent = sphere\n\tTweenService:Create(sphere, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.one * r * 2 }):Play()\n\tTweenService:Create(core, TweenInfo.new(0.2), { Size = Vector3.one * r * 1.2, Transparency = 0.6 }):Play()\n\tTweenService:Create(ring, TweenInfo.new(0.35), { Size = Vector3.new(0.3, r * 3.2, r * 3.2), Transparency = 1 }):Play()\n\tTweenService:Create(light, TweenInfo.new(linger + 0.2), { Brightness = 0 }):Play()\n\tburstAt(pos, color, 30, 45, 1.6, 0.6)\n\tsmokeAt(pos, Color3.fromRGB(70, 60, 90), 10, r * 0.9)\n\ttask.spawn(function()\n\t\tlocal t0 = os.clock()\n\t\twhile os.clock() - t0 < linger do\n\t\t\tsphere.Transparency = 0.25 + math.random() * 0.2\n\t\t\ttask.wait(0.05)\n\t\tend\n\t\tTweenService:Create(sphere, TweenInfo.new(0.25), { Transparency = 1, Size = Vector3.one * r * 2.2 }):Play()\n\t\tTweenService:Create(core, TweenInfo.new(0.2), { Transparency = 1 }):Play()\n\t\ttask.wait(0.3)\n\t\tsphere:Destroy()\n\t\tcore:Destroy()\n\t\tring:Destroy()\n\tend)\n\tlocal d = distToLocal(pos)\n\tlocal amp = (data.big and 2.2 or 1.4) * math.clamp(1 - d / 70, 0.15, 1)\n\tFX.Shake(amp, 0.35)\n\tSound.Play(\"Explosion\", { volume = data.big and 1.2 or 0.9, pitch = data.big and 0.8 or 1 })\nend\n\nlocal function onHit(data)\n\tlocal victim = data.victim\n\tlocal color = Color3.fromRGB(255, 230, 120)\n\tburstAt(data.pos, color, data.heavy and 26 or 14, data.heavy and 40 or 28, data.heavy and 1.4 or 0.9)\n\tflash(data.pos, Color3.new(1, 1, 1), data.heavy and 3 or 1.8, 0.12)\n\tif HUD then\n\t\tHUD.ShowHit(victim, data.pos, data.amount, data.combo, data.heavy)\n\tend\n\tif RobotAnim then\n\t\tRobotAnim.Flinch(victim)\n\tend\n\tif victim == localModel() then\n\t\tFX.Shake(data.heavy and 2.6 or 0.9, data.heavy and 0.45 or 0.2)\n\t\tif HUD then\n\t\t\tHUD.DamageVignette(data.heavy)\n\t\tend\n\telseif data.attacker == localModel() and data.heavy then\n\t\tFX.Shake(1.0, 0.2)\n\tend\n\tSound.Play(data.heavy and \"HeavyHit\" or \"Hit\")\nend\n\nlocal WEAPON_ATT = { Gun = \"GunTip\", Bomb = \"BombTip\", Pod = \"PodTip\" }\nlocal function onFire(data)\n\tlocal model = data.model\n\tif not model or not model.Parent then\n\t\treturn\n\tend\n\tlocal att = model:FindFirstChild(WEAPON_ATT[data.weapon] or \"GunTip\", true)\n\tlocal robot = Config.RobotById[model:GetAttribute(\"RobotId\") or \"Bolt\"]\n\tlocal loadout = Config.GetLoadout(robot.Id)\n\tlocal color = data.weapon == \"Gun\" and loadout.Gun.Color or (data.weapon == \"Bomb\" and loadout.Bomb.Color or loadout.Pod.Color)\n\tif att and att:IsA(\"Attachment\") then\n\t\tflash(att.WorldPosition, color, data.weapon == \"Gun\" and 1.8 or 2.4, 0.1)\n\tend\n\tif RobotAnim then\n\t\tRobotAnim.OnFire(model, data.weapon)\n\tend\n\tif model == localModel() and Battle then\n\t\tBattle.OnLocalFire(data)\n\tend\n\tif data.weapon == \"Gun\" then\n\t\tSound.Play(data.gunType == \"Spread\" and \"Shotgun\" or (data.gunType == \"Charge\" and \"Laser\" or \"Blaster\"))\n\telseif data.weapon == \"Bomb\" then\n\t\tSound.Play(\"BombThrow\")\n\telse\n\t\tSound.Play(\"Pod\")\n\tend\nend\n\nfunction FX.StopCharge(model)\n\tlocal ch = charges[model]\n\tif ch then\n\t\tcharges[model] = nil\n\t\tch.orb:Destroy()\n\t\tif ch.sound then\n\t\t\tch.sound:Destroy()\n\t\tend\n\tend\nend\n\nlocal function onCharge(data)\n\tlocal model = data.model\n\tif not model then\n\t\treturn\n\tend\n\tif data.on then\n\t\tFX.StopCharge(model)\n\t\tlocal robot = Config.RobotById[model:GetAttribute(\"RobotId\") or \"Lancer\"]\n\t\tlocal color = Config.GetLoadout(robot.Id).Gun.Color\n\t\tlocal orb = ball(0.4, color, 0.1)\n\t\tlocal l = Instance.new(\"PointLight\")\n\t\tl.Color = color\n\t\tl.Range = 8\n\t\tl.Brightness = 2\n\t\tl.Parent = orb\n\t\tcharges[model] = { orb = orb, t0 = os.clock(), dur = data.chargeTime or 0.8, color = color, sound = Sound.Play(\"Charge\", { vary = 0 }) }\n\telse\n\t\tFX.StopCharge(model)\n\tend\nend\n\nlocal function trailFor(model: Model)\n\tlocal t = trails[model]\n\tif t and t.Parent then\n\t\treturn t\n\tend\n\tlocal torso = model:FindFirstChild(\"Torso\")\n\tif not torso then\n\t\treturn nil\n\tend\n\tlocal robot = Config.RobotById[model:GetAttribute(\"RobotId\") or \"Bolt\"]\n\tlocal a0 = Instance.new(\"Attachment\")\n\ta0.Name = \"RCTrailTop\"\n\ta0.Position = Vector3.new(0, 1.2, 0.5)\n\ta0.Parent = torso\n\tlocal a1 = Instance.new(\"Attachment\")\n\ta1.Name = \"RCTrailBottom\"\n\ta1.Position = Vector3.new(0, -2.5, 0.5)\n\ta1.Parent = torso\n\tlocal tr = Instance.new(\"Trail\")\n\ttr.Attachment0 = a0\n\ttr.Attachment1 = a1\n\ttr.Lifetime = 0.22\n\ttr.Color = ColorSequence.new(robot.Neon)\n\ttr.LightEmission = 1\n\ttr.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })\n\ttr.Enabled = false\n\ttr.Parent = torso\n\ttrails[model] = tr\n\treturn tr\nend\n\nlocal function onDash(data)\n\tlocal model = data.model\n\tif not model or not model.Parent then\n\t\treturn\n\tend\n\tlocal tr = trailFor(model)\n\tif tr then\n\t\ttr.Enabled = true\n\t\ttask.delay(0.32, function()\n\t\t\tif tr.Parent then\n\t\t\t\ttr.Enabled = false\n\t\t\tend\n\t\tend)\n\tend\n\tlocal root = model:FindFirstChild(\"HumanoidRootPart\")\n\tif root and not data.air then\n\t\tsmokeAt(root.Position - Vector3.new(0, 3.5, 0), Color3.fromRGB(150, 160, 200), 6, 2.5)\n\tend\n\tSound.Play(\"Dash\")\nend\n\nlocal handlers = {\n\tProj = onProj,\n\tProjEnd = onProjEnd,\n\tProjSync = onProjSync,\n\tClearProj = clearAll,\n\tBlast = onBlast,\n\tHit = onHit,\n\tFire = onFire,\n\tCharge = onCharge,\n\tDash = onDash,\n\tDown = function(data)\n\t\tif HUD then\n\t\t\tHUD.TagText(data.model, \"DOWN\", Color3.fromRGB(255, 90, 170))\n\t\tend\n\t\tSound.Play(\"Down\")\n\t\tif data.model == localModel() then\n\t\t\tFX.Shake(2.2, 0.4)\n\t\tend\n\tend,\n\tRebirth = function(data)\n\t\tif HUD then\n\t\t\tHUD.TagText(data.model, \"REBIRTH\", Color3.fromRGB(255, 255, 255))\n\t\tend\n\tend,\n\tPit = function(data)\n\t\tif HUD then\n\t\t\tHUD.TagText(data.model, \"PIT  -\" .. tostring(data.amount), Color3.fromRGB(255, 80, 80))\n\t\tend\n\t\tSound.Play(\"HeavyHit\")\n\tend,\n}\n\nfunction FX.Init(deps)\n\tHUD = deps.HUD\n\tRobotAnim = deps.RobotAnim\n\tBattle = deps.Battle\n\tRC.Remotes.FX.OnClientEvent:Connect(function(kind, data)\n\t\tlocal h = handlers[kind]\n\t\tif h then\n\t\t\tlocal ok, err = pcall(h, data)\n\t\t\tif not ok then\n\t\t\t\twarn(\"[RoboClash FX] \" .. tostring(kind) .. \": \" .. tostring(err))\n\t\t\tend\n\t\tend\n\tend)\n\tRunService.RenderStepped:Connect(function(dt)\n\t\tlocal tclock = os.clock()\n\t\tfor id, v in pairs(visuals) do\n\t\t\tlocal ok, keep = pcall(updateVisual, v, dt, tclock)\n\t\t\tif not ok or not keep then\n\t\t\t\tremoveVisual(id, true)\n\t\t\tend\n\t\tend\n\t\tfor model, ch in pairs(charges) do\n\t\t\tlocal att = model.Parent and model:FindFirstChild(\"GunTip\", true)\n\t\t\tif not att then\n\t\t\t\tFX.StopCharge(model)\n\t\t\telse\n\t\t\t\tlocal k = math.clamp((tclock - ch.t0) / ch.dur, 0, 1)\n\t\t\t\tlocal full = k >= 1\n\t\t\t\tlocal s = 0.4 + 1.6 * k + (full and 0.25 * math.sin(tclock * 30) or 0)\n\t\t\t\tch.orb.Size = Vector3.one * s\n\t\t\t\tch.orb.CFrame = CFrame.new((att :: Attachment).WorldPosition)\n\t\t\t\tch.orb.Color = full and Color3.new(1, 1, 1) or ch.color\n\t\t\tend\n\t\tend\n\tend)\nend\n\nfunction FX.Folder()\n\treturn folder\nend\n\n-- Silence unused warning for Players (kept for future per-player FX filtering).\nlocal _ = Players\n\nreturn FX\n","message":"Wrote contents to /Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/FX.luau"}}},"hookAdditionalContexts":[],"toolCallId":"toolu_015qfEgzZrEiJSQjcKJdrFrh","startedAtMs":"1791074173250","completedAtMs":"1791074243589"},"model_call_id":"f6f75537-51d9-46fb-a6c9-81f06ac674d8-53-rtkw","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791074243659}
