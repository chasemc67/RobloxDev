{"type":"tool_call","subtype":"started","call_id":"toolu_01MUmVDF25Vd23rGCUuyQxnE","tool_call":{"editToolCall":{"args":{"path":"/Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/Battle.luau","streamContent":"\tlocal pitch = PITCH - (focusModel and rad(6) or 0)"}},"hookAdditionalContexts":[],"toolCallId":"toolu_01MUmVDF25Vd23rGCUuyQxnE","startedAtMs":"1791075273722"},"model_call_id":"9f87d2a3-a097-4b92-978f-ec64b826b4ce-2-66a3","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791075274380}
{"type":"tool_call","subtype":"completed","call_id":"toolu_01MUmVDF25Vd23rGCUuyQxnE","tool_call":{"editToolCall":{"args":{"path":"/Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/Battle.luau","streamContent":"\tlocal pitch = PITCH - (focusModel and rad(6) or 0)"},"result":{"success":{"path":"/Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/Battle.luau","linesAdded":1,"linesRemoved":1,"diffString":"--- a//Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/Battle.luau\n+++ b//Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/Battle.luau\n@@ -295,7 +295,7 @@\n \tcam.yawNudge += (nudgeTarget - cam.yawNudge) * (1 - math.exp(-dt * 4))\n \tlocal yaw = cam.yaw + cam.yawNudge\n \tlocal back = Vector3.new(math.sin(yaw), 0, math.cos(yaw))\n-\tlocal pitch = PITCH + (focusModel and -rad(15) or 0)\n+\tlocal pitch = PITCH - (focusModel and rad(6) or 0)\n \tlocal toCam = back * math.cos(pitch) + Vector3.yAxis * math.sin(pitch)\n \tlocal look = -toCam\n \tlocal right = look:Cross(Vector3.yAxis).Unit","beforeFullFileContent":"-- In-match client controller: input (KB+M / gamepad / touch) -> local Mover + server intents,\n-- lock-on target, auto-framing high-angle camera, cube drop-in intro, KO sequence.\nlocal ContextActionService = game:GetService(\"ContextActionService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal RC = ReplicatedStorage:WaitForChild(\"RoboClash\")\nlocal Config = require(RC.Config)\nlocal Util = require(RC.Shared.Util)\nlocal Mover = require(RC.Shared.Mover)\nlocal State = require(script.Parent.State)\nlocal Sound = require(script.Parent.Sound)\nlocal Touch = require(script.Parent.Touch)\n\nlocal IntentRemote = RC:WaitForChild(\"Remotes\"):WaitForChild(\"Intent\")\nlocal M = Config.Match\nlocal rad = math.rad\n\nlocal Battle = {}\nlocal HUD, FX, RobotAnim -- injected\n\nlocal info = nil\nlocal model: Model? = nil\nlocal mover = nil\nlocal loadout = nil\nlocal active = false\nlocal launched = false\nlocal endTime: number? = nil\nlocal frozenTimer: number? = nil\nlocal lockedNow = true\nlocal keys = {}\nlocal padMove = Vector2.zero\nlocal padLook = Vector2.zero\nlocal gunHeld = false\nlocal cubes = {}\nlocal timers = {}\nlocal cam = { focus = nil :: Vector3?, dist = 130, yaw = 0, yawNudge = 0 }\nlocal ko = nil\n\nlocal PITCH = rad(47)\nlocal CUBE_FALL = 1.1\nlocal CUBE_OPEN = 1.6\nlocal CUBE_HEIGHT = 70\n\nfunction Battle.Init(deps)\n\tHUD = deps.HUD\n\tFX = deps.FX\n\tRobotAnim = deps.RobotAnim\nend\n\nlocal function serverNow(): number\n\treturn workspace:GetServerTimeNow()\nend\n\nlocal function rootOf(m: Model?): BasePart?\n\treturn m and m.Parent and m:FindFirstChild(\"HumanoidRootPart\") :: BasePart?\nend\n\nlocal function isAlive(m: Model): boolean\n\treturn m.Parent ~= nil and m:GetAttribute(\"State\") ~= \"KO\"\nend\n\nlocal function pickTarget(): Model?\n\tlocal myRoot = rootOf(model)\n\tif not myRoot or not info then\n\t\treturn nil\n\tend\n\tlocal best, bestD = nil, math.huge\n\tfor _, r in ipairs(info.roster) do\n\t\tlocal m = r.model\n\t\tif m and m ~= model and isAlive(m) then\n\t\t\tlocal rr = rootOf(m)\n\t\t\tif rr then\n\t\t\t\tlocal d = (rr.Position - myRoot.Position).Magnitude\n\t\t\t\tif d < bestD then\n\t\t\t\t\tbest, bestD = m, d\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\treturn best\nend\n\nlocal function moveVector(): Vector3\n\tlocal x, y = 0, 0\n\tif keys[Enum.KeyCode.W] or keys[Enum.KeyCode.Up] then\n\t\ty += 1\n\tend\n\tif keys[Enum.KeyCode.S] or keys[Enum.KeyCode.Down] then\n\t\ty -= 1\n\tend\n\tif keys[Enum.KeyCode.D] or keys[Enum.KeyCode.Right] then\n\t\tx += 1\n\tend\n\tif keys[Enum.KeyCode.A] or keys[Enum.KeyCode.Left] then\n\t\tx -= 1\n\tend\n\tlocal v = Vector2.new(x, y)\n\tif padMove.Magnitude > 0.18 then\n\t\tv += padMove\n\tend\n\tlocal tm = Touch.move\n\tif tm.Magnitude > 0 then\n\t\tv += Vector2.new(tm.X, -tm.Y)\n\tend\n\tif v.Magnitude > 1 then\n\t\tv = v.Unit\n\tend\n\tif v.Magnitude < 0.05 then\n\t\treturn Vector3.zero\n\tend\n\tlocal cf = workspace.CurrentCamera.CFrame\n\tlocal f = Util.flatUnit(cf.LookVector, Vector3.new(0, 0, -1))\n\tlocal r = Util.flatUnit(cf.RightVector, Vector3.new(1, 0, 0))\n\treturn r * v.X + f * v.Y\nend\n\n----------------------------------------------------------------------------------------------\n-- Actions (shared by CAS + touch)\n----------------------------------------------------------------------------------------------\nlocal function canControl(): boolean\n\treturn active and launched and mover ~= nil and not lockedNow\nend\n\nlocal function sendDash(kind: string?)\n\tif not kind or not mover then\n\t\treturn\n\tend\n\tlocal o = mover.override\n\tlocal dir = o and o.dir or mover.root.CFrame.LookVector\n\tIntentRemote:FireServer(\"Dash\", { dir = dir, air = kind == \"airdash\" })\n\tSound.Play(\"Dash\", { vary = 0.08 })\nend\n\nlocal function doAction(name: string, began: boolean)\n\tif not active or not mover then\n\t\treturn\n\tend\n\tif name == \"Jump\" then\n\t\tmover.jumpHeld = began\n\t\tif began and canControl() then\n\t\t\tlocal r = mover:Jump()\n\t\t\tif r == \"airdash\" then\n\t\t\t\tsendDash(r)\n\t\t\telseif r then\n\t\t\t\tSound.Play(\"Jump\", { vary = 0.1, volume = r == \"airjump\" and 0.35 or 0.3 })\n\t\t\tend\n\t\tend\n\telseif name == \"Dash\" then\n\t\tif began and canControl() then\n\t\t\tsendDash(mover:Dash())\n\t\tend\n\telseif name == \"Gun\" then\n\t\tif began then\n\t\t\tgunHeld = true\n\t\t\tIntentRemote:FireServer(\"GunDown\")\n\t\telseif gunHeld then\n\t\t\tgunHeld = false\n\t\t\tIntentRemote:FireServer(\"GunUp\")\n\t\tend\n\telseif name == \"Bomb\" then\n\t\tif began then\n\t\t\tIntentRemote:FireServer(\"Bomb\")\n\t\tend\n\telseif name == \"Pod\" then\n\t\tif began then\n\t\t\tIntentRemote:FireServer(\"Pod\")\n\t\tend\n\tend\nend\nBattle.DoAction = doAction\n\nlocal SINK = Enum.ContextActionResult.Sink\nlocal function began(state: Enum.UserInputState): boolean\n\treturn state == Enum.UserInputState.Begin\nend\nlocal function ended(state: Enum.UserInputState): boolean\n\treturn state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel\nend\n\nlocal function actionHandler(name: string)\n\treturn function(_, state, _input)\n\t\tif began(state) then\n\t\t\tdoAction(name, true)\n\t\telseif ended(state) then\n\t\t\tdoAction(name, false)\n\t\tend\n\t\treturn SINK\n\tend\nend\n\nlocal function onMove(_, state, input: InputObject)\n\tif input.KeyCode == Enum.KeyCode.Thumbstick1 then\n\t\tpadMove = ended(state) and Vector2.zero or Vector2.new(input.Position.X, input.Position.Y)\n\telse\n\t\tkeys[input.KeyCode] = not ended(state)\n\tend\n\treturn SINK\nend\n\nlocal function onLook(_, state, input: InputObject)\n\tpadLook = ended(state) and Vector2.zero or Vector2.new(input.Position.X, input.Position.Y)\n\treturn SINK\nend\n\nlocal BIND_PRIORITY = Enum.ContextActionPriority.High.Value + 100\nlocal function bindInputs()\n\tlocal K = Enum.KeyCode\n\tContextActionService:BindActionAtPriority(\"RC_Move\", onMove, false, BIND_PRIORITY, K.W, K.A, K.S, K.D, K.Up, K.Down, K.Left, K.Right, K.Thumbstick1)\n\tContextActionService:BindActionAtPriority(\"RC_Look\", onLook, false, BIND_PRIORITY, K.Thumbstick2)\n\tContextActionService:BindActionAtPriority(\"RC_Jump\", actionHandler(\"Jump\"), false, BIND_PRIORITY, K.Space, K.ButtonA)\n\tContextActionService:BindActionAtPriority(\"RC_Dash\", actionHandler(\"Dash\"), false, BIND_PRIORITY, K.LeftShift, K.RightShift, K.ButtonB, K.ButtonL1)\n\tContextActionService:BindActionAtPriority(\"RC_Gun\", actionHandler(\"Gun\"), false, BIND_PRIORITY, Enum.UserInputType.MouseButton1, K.J, K.ButtonR2)\n\tContextActionService:BindActionAtPriority(\"RC_Bomb\", actionHandler(\"Bomb\"), false, BIND_PRIORITY, Enum.UserInputType.MouseButton2, K.K, K.ButtonL2, K.ButtonX)\n\tContextActionService:BindActionAtPriority(\"RC_Pod\", actionHandler(\"Pod\"), false, BIND_PRIORITY, K.E, K.L, K.ButtonR1, K.ButtonY)\nend\n\nlocal function unbindInputs()\n\tfor _, n in ipairs({ \"RC_Move\", \"RC_Look\", \"RC_Jump\", \"RC_Dash\", \"RC_Gun\", \"RC_Bomb\", \"RC_Pod\" }) do\n\t\tContextActionService:UnbindAction(n)\n\tend\n\ttable.clear(keys)\n\tpadMove = Vector2.zero\n\tpadLook = Vector2.zero\n\tgunHeld = false\nend\n\n----------------------------------------------------------------------------------------------\n-- Server callbacks\n----------------------------------------------------------------------------------------------\nfunction Battle.OnLocalFire(data)\n\tif mover and data.slow and data.slowTime then\n\t\tmover:Slow(data.slow, data.slowTime)\n\tend\nend\n\nfunction Battle.OnKnock(vel: Vector3, up: number, dur: number)\n\tif mover then\n\t\tmover:Knockback(vel, up, dur)\n\tend\nend\n\nfunction Battle.OnTeleported()\n\tif mover then\n\t\tmover:ResetVelocity()\n\tend\nend\n\n----------------------------------------------------------------------------------------------\n-- Camera\n----------------------------------------------------------------------------------------------\nlocal function updateCamera(dt: number)\n\tlocal camera = workspace.CurrentCamera\n\tcamera.CameraType = Enum.CameraType.Scriptable\n\tcamera.FieldOfView = 50\n\tlocal pts = {}\n\tlocal intro = not launched and not ko\n\tlocal focusModel = nil\n\tif ko then\n\t\tlocal t = os.clock() - ko.t0\n\t\tif t < M.KOFreezeTime then\n\t\t\tfocusModel = ko.loser or ko.winner\n\t\telse\n\t\t\tfocusModel = ko.winner or ko.loser\n\t\tend\n\tend\n\tif focusModel and rootOf(focusModel) then\n\t\ttable.insert(pts, (rootOf(focusModel) :: BasePart).Position)\n\telseif intro and serverNow() < info.startTime + CUBE_OPEN then\n\t\tfor _, r in ipairs(info.roster) do\n\t\t\ttable.insert(pts, r.spawnPos)\n\t\tend\n\telse\n\t\tfor _, r in ipairs(info.roster) do\n\t\t\tlocal rr = rootOf(r.model)\n\t\t\tif rr and (isAlive(r.model) or r.model == model) then\n\t\t\t\ttable.insert(pts, rr.Position)\n\t\t\tend\n\t\tend\n\tend\n\tif #pts == 0 then\n\t\ttable.insert(pts, info.center)\n\tend\n\tlocal lo, hi = pts[1], pts[1]\n\tfor _, p in ipairs(pts) do\n\t\tlo = lo:Min(p)\n\t\thi = hi:Max(p)\n\tend\n\tlocal mid = (lo + hi) / 2\n\tlocal focusTarget = Vector3.new(mid.X, info.center.Y + 2, mid.Z)\n\tif not cam.focus then\n\t\tcam.focus = info.center\n\tend\n\tlocal nudgeTarget = padLook.Magnitude > 0.2 and padLook.X * rad(25) or 0\n\tcam.yawNudge += (nudgeTarget - cam.yawNudge) * (1 - math.exp(-dt * 4))\n\tlocal yaw = cam.yaw + cam.yawNudge\n\tlocal back = Vector3.new(math.sin(yaw), 0, math.cos(yaw))\n\tlocal pitch = PITCH + (focusModel and -rad(15) or 0)\n\tlocal toCam = back * math.cos(pitch) + Vector3.yAxis * math.sin(pitch)\n\tlocal look = -toCam\n\tlocal right = look:Cross(Vector3.yAxis).Unit\n\tlocal up = right:Cross(look)\n\n\t-- Zoom-to-fit: smallest distance that keeps every robot (feet..head) inside the frustum,\n\t-- with extra room at the bottom for the HUD panels.\n\tlocal targetDist\n\tif focusModel then\n\t\ttargetDist = 30\n\telse\n\t\tlocal tanV = math.tan(rad(camera.FieldOfView) / 2)\n\t\tlocal vp = camera.ViewportSize\n\t\tlocal tanH = tanV * (vp.X / math.max(vp.Y, 1))\n\t\tlocal tUp, tDown, tSide = tanV * 0.78, tanV * 0.5, tanH * 0.8\n\t\ttargetDist = 0\n\t\tfor _, p in ipairs(pts) do\n\t\t\tfor _, h in ipairs({ -2.5, 5 }) do\n\t\t\t\tlocal r = Vector3.new(p.X, info.center.Y + h, p.Z) - focusTarget\n\t\t\t\tlocal depth = r:Dot(look)\n\t\t\t\tlocal y = r:Dot(up)\n\t\t\t\tlocal x = r:Dot(right)\n\t\t\t\tlocal ty = y >= 0 and tUp or tDown\n\t\t\t\ttargetDist = math.max(targetDist, math.abs(y) / ty - depth, math.abs(x) / tSide - depth)\n\t\t\tend\n\t\tend\n\t\ttargetDist = math.clamp(targetDist, 40, 115)\n\tend\n\tlocal kf = 1 - math.exp(-dt * (focusModel and 3 or 5))\n\tlocal kd = 1 - math.exp(-dt * (intro and 1.6 or (targetDist > cam.dist and 4 or 2)))\n\tcam.focus = (cam.focus :: Vector3):Lerp(focusTarget, kf)\n\tcam.dist += (targetDist - cam.dist) * kd\n\tlocal focus = cam.focus :: Vector3\n\tcamera.CFrame = CFrame.lookAt(focus + toCam * cam.dist, focus) * FX.ShakeCFrame()\nend\n\n----------------------------------------------------------------------------------------------\n-- Intro: cube drop-in + READY 3-2-1 LAUNCH!\n----------------------------------------------------------------------------------------------\nlocal function makeCube(r)\n\tlocal color = Config.TeamColors[r.team] or Color3.new(1, 1, 1)\n\tlocal p = Instance.new(\"Part\")\n\tp.Name = \"DropCube\"\n\tp.Anchored = true\n\tp.CanCollide = false\n\tp.CanQuery = false\n\tp.CanTouch = false\n\tp.CastShadow = true\n\tp.Size = Vector3.new(7, 7, 7)\n\tp.Material = Enum.Material.Metal\n\tp.Color = Color3.fromRGB(30, 34, 60)\n\tp.Parent = FX.Folder()\n\tlocal inner = Instance.new(\"Part\")\n\tinner.Name = \"Core\"\n\tinner.Anchored = true\n\tinner.CanCollide = false\n\tinner.CanQuery = false\n\tinner.CanTouch = false\n\tinner.Size = Vector3.new(7.3, 2, 7.3)\n\tinner.Material = Enum.Material.Neon\n\tinner.Color = color\n\tinner.Parent = p\n\tlocal box = Instance.new(\"SelectionBox\")\n\tbox.Adornee = p\n\tbox.Color3 = color\n\tbox.LineThickness = 0.12\n\tbox.SurfaceTransparency = 1\n\tbox.Parent = p\n\tlocal light = Instance.new(\"PointLight\")\n\tlight.Color = color\n\tlight.Range = 16\n\tlight.Brightness = 2\n\tlight.Parent = p\n\treturn { part = p, core = inner, color = color, spawnPos = r.spawnPos, spin = math.random() * math.pi * 2, opened = false }\nend\n\nlocal function updateCubes()\n\tif #cubes == 0 or not info then\n\t\treturn\n\tend\n\tlocal t = serverNow() - info.startTime\n\tfor _, c in ipairs(cubes) do\n\t\tif not c.opened then\n\t\t\tlocal a = math.clamp(t / CUBE_FALL, 0, 1)\n\t\t\tlocal y = CUBE_HEIGHT * (1 - a * a)\n\t\t\tlocal landed = a >= 1\n\t\t\tlocal squash = 0\n\t\t\tif landed then\n\t\t\t\tlocal s = t - CUBE_FALL\n\t\t\t\tsquash = math.max(0, 0.6 - s * 2) * math.sin(s * 30) * 0.4\n\t\t\t\tif not c.landed then\n\t\t\t\t\tc.landed = true\n\t\t\t\t\tFX.Shake(0.9, 0.3)\n\t\t\t\t\tFX.Burst(c.spawnPos + Vector3.new(0, 0.5, 0), c.color, 18, 22, 1.2, 0.5)\n\t\t\t\t\tSound.Play(\"Explosion\", { volume = 0.25, pitch = 1.6 })\n\t\t\t\tend\n\t\t\tend\n\t\t\tlocal spin = c.spin + (1 - a) * 4\n\t\t\tlocal cf = CFrame.new(c.spawnPos + Vector3.new(0, 3.5 + y + squash, 0)) * CFrame.Angles(0, spin, 0)\n\t\t\tc.part.CFrame = cf\n\t\t\tc.core.CFrame = cf\n\t\tend\n\tend\nend\n\nlocal function openCubes()\n\tfor _, c in ipairs(cubes) do\n\t\tif not c.opened then\n\t\t\tc.opened = true\n\t\t\tFX.Flash(c.spawnPos + Vector3.new(0, 3.5, 0), c.color, 14, 0.35)\n\t\t\tFX.Burst(c.spawnPos + Vector3.new(0, 3.5, 0), c.color, 30, 40, 1.6, 0.6)\n\t\t\tc.part:Destroy()\n\t\tend\n\tend\n\ttable.clear(cubes)\n\tSound.Play(\"Explosion\", { volume = 0.35, pitch = 1.3 })\nend\n\nlocal function schedule(at: number, fn: () -> ())\n\tlocal delay = at - serverNow()\n\tif delay < -0.15 then\n\t\treturn\n\tend\n\ttable.insert(timers, task.delay(math.max(0, delay), fn))\nend\n\nlocal function cancelTimers()\n\tfor _, th in ipairs(timers) do\n\t\tpcall(task.cancel, th)\n\tend\n\ttable.clear(timers)\nend\n\n----------------------------------------------------------------------------------------------\n-- Frame step\n----------------------------------------------------------------------------------------------\nlocal function step(dt: number)\n\tif not active or not info then\n\t\treturn\n\tend\n\tupdateCubes()\n\tif model and model.Parent and mover then\n\t\tlocal st = model:GetAttribute(\"State\")\n\t\tlocal locked = model:GetAttribute(\"Locked\") == true or st == \"Down\" or st == \"KO\" or st == \"Intro\" or not launched\n\t\tif locked ~= lockedNow then\n\t\t\tlockedNow = locked\n\t\t\tmover:SetLocked(locked)\n\t\tend\n\t\tmover.moveInput = locked and Vector3.zero or moveVector()\n\t\tlocal gun = loadout.Gun\n\t\tmover.chargeMul = (gun.Type == \"Charge\" and gunHeld and not locked) and gun.ChargeMoveSlow or 1\n\t\tif not mover.root.Anchored then\n\t\t\tmover:Step(dt)\n\t\tend\n\t\tState.dashReady01 = math.clamp(1 - (mover.dashReadyAt - os.clock()) / loadout.Legs.DashCooldown, 0, 1)\n\tend\n\tlocal target = pickTarget()\n\tState.target = target\n\tHUD.SetTarget((launched and not ko) and target or nil)\n\tHUD.Update(dt, endTime, frozenTimer)\n\tupdateCamera(dt)\nend\n\n----------------------------------------------------------------------------------------------\n-- Lifecycle\n----------------------------------------------------------------------------------------------\nfunction Battle.Start(data)\n\tBattle.Stop()\n\tinfo = data\n\tState.match = data\n\tState.mode = \"Battle\"\n\tactive = true\n\tlaunched = false\n\tko = nil\n\tendTime = nil\n\tfrozenTimer = data.duration\n\tlockedNow = true\n\tmodel = data.localModel\n\tState.localModel = model\n\tcam.focus = nil\n\tcam.dist = 135\n\tcam.yawNudge = 0\n\tlocal mySpawn = data.center + Vector3.new(0, 0, 40)\n\tfor _, r in ipairs(data.roster) do\n\t\tif r.model == model then\n\t\t\tmySpawn = r.spawnPos\n\t\tend\n\tend\n\tlocal back = Util.flatUnit(mySpawn - data.center, Vector3.new(0, 0, 1))\n\tcam.yaw = math.atan2(back.X, back.Z)\n\n\tlocal geo = nil\n\tfor _, r in ipairs(data.roster) do\n\t\tif r.model and r.model.Parent then\n\t\t\tlocal arena = r.model:FindFirstAncestorWhichIsA(\"Model\")\n\t\t\twhile arena and arena.Parent and arena.Parent.Name ~= \"Arenas\" do\n\t\t\t\tarena = arena:FindFirstAncestorWhichIsA(\"Model\")\n\t\t\tend\n\t\t\tgeo = arena and arena:FindFirstChild(\"Geometry\")\n\t\t\tbreak\n\t\tend\n\tend\n\tRobotAnim.SetGeometry(geo)\n\n\tlocal revealIn = (data.startTime + CUBE_OPEN) - serverNow()\n\tfor _, r in ipairs(data.roster) do\n\t\tif r.model then\n\t\t\tRobotAnim.Register(r.model, revealIn > 0 and (os.clock() + revealIn) or nil)\n\t\tend\n\t\tif revealIn > 0 then\n\t\t\ttable.insert(cubes, makeCube(r))\n\t\tend\n\tend\n\tupdateCubes()\n\n\tif model then\n\t\tlocal robotId = model:GetAttribute(\"RobotId\") or State.robotId\n\t\tloadout = Config.GetLoadout(robotId)\n\t\tmover = Mover.new(model, loadout.Legs)\n\t\tmover.getFacePos = function()\n\t\t\tlocal t = State.target\n\t\t\tlocal rr = rootOf(t)\n\t\t\treturn rr and rr.Position or nil\n\t\tend\n\t\tmover:SetLocked(true)\n\tend\n\n\tHUD.Start(data)\n\tHUD.SetChipsVisible(not Touch.Enabled())\n\tTouch.SetActive(true)\n\tbindInputs()\n\tRunService:BindToRenderStep(\"RoboClashBattle\", Enum.RenderPriority.Camera.Value + 1, step)\n\n\tlocal st = data.startTime\n\tschedule(st + CUBE_OPEN, openCubes)\n\tschedule(st + 2.0, function()\n\t\tHUD.Announce(\"READY\", { size = 120, hold = 0.65, color = Color3.fromRGB(120, 235, 255) })\n\tend)\n\tlocal counts = { \"3\", \"2\", \"1\" }\n\tfor i, txt in ipairs(counts) do\n\t\tschedule(st + 2.8 + (i - 1) * 0.53, function()\n\t\t\tHUD.Announce(txt, { size = 150, hold = 0.4 })\n\t\t\tSound.Play(\"Countdown\", { pitch = 1 + (i - 1) * 0.04 })\n\t\tend)\n\tend\n\tschedule(data.launchTime, function()\n\t\tif not ko then\n\t\t\tHUD.Announce(\"LAUNCH!\", { size = 150, hold = 0.7, slam = true, color = Color3.fromRGB(255, 220, 80) })\n\t\t\tSound.Play(\"Launch\")\n\t\t\tFX.Shake(0.6, 0.25)\n\t\tend\n\tend)\nend\n\nfunction Battle.OnLaunch(data)\n\tif not active then\n\t\treturn\n\tend\n\tlaunched = true\n\tendTime = data.endTime\n\tfrozenTimer = nil\n\topenCubes()\n\tfor _, r in ipairs(info.roster) do\n\t\tif r.model then\n\t\t\tRobotAnim.Reveal(r.model)\n\t\tend\n\tend\nend\n\nfunction Battle.OnKO(data)\n\tif not active then\n\t\treturn\n\tend\n\tlocal remain = endTime and math.max(0, endTime - serverNow()) or info.duration\n\tfrozenTimer = remain\n\tlaunched = false\n\tlockedNow = true\n\tif mover then\n\t\tmover:SetLocked(true)\n\tend\n\tif gunHeld then\n\t\tgunHeld = false\n\tend\n\tlocal loser = nil\n\tfor _, r in ipairs(info.roster) do\n\t\tif r.model and r.model ~= data.winner then\n\t\t\tif not loser or r.model:GetAttribute(\"State\") == \"KO\" then\n\t\t\t\tloser = r.model\n\t\t\tend\n\t\tend\n\tend\n\tko = { t0 = os.clock(), winner = data.winner, loser = (not data.draw) and loser or nil, data = data }\n\tif data.draw then\n\t\tHUD.Announce(data.reason == \"TIME\" and \"TIME UP!\" or \"DRAW\", { size = 130, hold = 1.4, slam = true })\n\t\ttask.delay(1.5, function()\n\t\t\tif ko and active then\n\t\t\t\tHUD.Announce(\"DRAW\", { size = 140, hold = 1.6, color = Color3.fromRGB(200, 200, 255) })\n\t\t\tend\n\t\tend)\n\telseif data.reason == \"TIME\" then\n\t\tHUD.Announce(\"TIME UP!\", { size = 130, hold = 1.2, slam = true, color = Color3.fromRGB(255, 220, 80) })\n\telseif data.reason == \"LEFT\" then\n\t\tHUD.Announce(\"OPPONENT LEFT\", { size = 90, hold = 2.2, slam = true, color = Color3.fromRGB(200, 220, 255) })\n\telse\n\t\tHUD.Announce(\"K.O.!\", { size = 170, hold = 1.3, slam = true, color = Color3.fromRGB(255, 70, 110) })\n\t\tFX.Shake(2.2, 0.6)\n\tend\n\tSound.Play(\"KO\")\n\tif data.perfect then\n\t\ttask.delay(1.6, function()\n\t\t\tif ko and active then\n\t\t\t\tHUD.Announce(\"PERFECT!\", { size = 140, hold = 2, slam = true, color = Color3.fromRGB(255, 215, 70) })\n\t\t\tend\n\t\tend)\n\telseif not data.draw and data.winner then\n\t\ttask.delay(1.6, function()\n\t\t\tif ko and active then\n\t\t\t\tlocal isMe = data.winner == model\n\t\t\t\tHUD.Announce(isMe and \"YOU WIN!\" or \"YOU LOSE\", {\n\t\t\t\t\tsize = 120,\n\t\t\t\t\thold = 2,\n\t\t\t\t\tcolor = isMe and Color3.fromRGB(255, 215, 70) or Color3.fromRGB(150, 170, 215),\n\t\t\t\t})\n\t\t\tend\n\t\tend)\n\tend\nend\n\nfunction Battle.Stop()\n\tif not active then\n\t\treturn\n\tend\n\tactive = false\n\tlaunched = false\n\tcancelTimers()\n\tRunService:UnbindFromRenderStep(\"RoboClashBattle\")\n\tunbindInputs()\n\tTouch.SetActive(false)\n\tfor _, c in ipairs(cubes) do\n\t\tc.part:Destroy()\n\tend\n\ttable.clear(cubes)\n\tHUD.Stop()\n\tFX.ClearAll()\n\tRobotAnim.Clear()\n\tmover = nil\n\tmodel = nil\n\tinfo = nil\n\tko = nil\n\tState.localModel = nil\n\tState.match = nil\n\tState.target = nil\nend\n\nfunction Battle.IsActive(): boolean\n\treturn active\nend\n\nreturn Battle\n","afterFullFileContent":"-- In-match client controller: input (KB+M / gamepad / touch) -> local Mover + server intents,\n-- lock-on target, auto-framing high-angle camera, cube drop-in intro, KO sequence.\nlocal ContextActionService = game:GetService(\"ContextActionService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal RC = ReplicatedStorage:WaitForChild(\"RoboClash\")\nlocal Config = require(RC.Config)\nlocal Util = require(RC.Shared.Util)\nlocal Mover = require(RC.Shared.Mover)\nlocal State = require(script.Parent.State)\nlocal Sound = require(script.Parent.Sound)\nlocal Touch = require(script.Parent.Touch)\n\nlocal IntentRemote = RC:WaitForChild(\"Remotes\"):WaitForChild(\"Intent\")\nlocal M = Config.Match\nlocal rad = math.rad\n\nlocal Battle = {}\nlocal HUD, FX, RobotAnim -- injected\n\nlocal info = nil\nlocal model: Model? = nil\nlocal mover = nil\nlocal loadout = nil\nlocal active = false\nlocal launched = false\nlocal endTime: number? = nil\nlocal frozenTimer: number? = nil\nlocal lockedNow = true\nlocal keys = {}\nlocal padMove = Vector2.zero\nlocal padLook = Vector2.zero\nlocal gunHeld = false\nlocal cubes = {}\nlocal timers = {}\nlocal cam = { focus = nil :: Vector3?, dist = 130, yaw = 0, yawNudge = 0 }\nlocal ko = nil\n\nlocal PITCH = rad(47)\nlocal CUBE_FALL = 1.1\nlocal CUBE_OPEN = 1.6\nlocal CUBE_HEIGHT = 70\n\nfunction Battle.Init(deps)\n\tHUD = deps.HUD\n\tFX = deps.FX\n\tRobotAnim = deps.RobotAnim\nend\n\nlocal function serverNow(): number\n\treturn workspace:GetServerTimeNow()\nend\n\nlocal function rootOf(m: Model?): BasePart?\n\treturn m and m.Parent and m:FindFirstChild(\"HumanoidRootPart\") :: BasePart?\nend\n\nlocal function isAlive(m: Model): boolean\n\treturn m.Parent ~= nil and m:GetAttribute(\"State\") ~= \"KO\"\nend\n\nlocal function pickTarget(): Model?\n\tlocal myRoot = rootOf(model)\n\tif not myRoot or not info then\n\t\treturn nil\n\tend\n\tlocal best, bestD = nil, math.huge\n\tfor _, r in ipairs(info.roster) do\n\t\tlocal m = r.model\n\t\tif m and m ~= model and isAlive(m) then\n\t\t\tlocal rr = rootOf(m)\n\t\t\tif rr then\n\t\t\t\tlocal d = (rr.Position - myRoot.Position).Magnitude\n\t\t\t\tif d < bestD then\n\t\t\t\t\tbest, bestD = m, d\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\treturn best\nend\n\nlocal function moveVector(): Vector3\n\tlocal x, y = 0, 0\n\tif keys[Enum.KeyCode.W] or keys[Enum.KeyCode.Up] then\n\t\ty += 1\n\tend\n\tif keys[Enum.KeyCode.S] or keys[Enum.KeyCode.Down] then\n\t\ty -= 1\n\tend\n\tif keys[Enum.KeyCode.D] or keys[Enum.KeyCode.Right] then\n\t\tx += 1\n\tend\n\tif keys[Enum.KeyCode.A] or keys[Enum.KeyCode.Left] then\n\t\tx -= 1\n\tend\n\tlocal v = Vector2.new(x, y)\n\tif padMove.Magnitude > 0.18 then\n\t\tv += padMove\n\tend\n\tlocal tm = Touch.move\n\tif tm.Magnitude > 0 then\n\t\tv += Vector2.new(tm.X, -tm.Y)\n\tend\n\tif v.Magnitude > 1 then\n\t\tv = v.Unit\n\tend\n\tif v.Magnitude < 0.05 then\n\t\treturn Vector3.zero\n\tend\n\tlocal cf = workspace.CurrentCamera.CFrame\n\tlocal f = Util.flatUnit(cf.LookVector, Vector3.new(0, 0, -1))\n\tlocal r = Util.flatUnit(cf.RightVector, Vector3.new(1, 0, 0))\n\treturn r * v.X + f * v.Y\nend\n\n----------------------------------------------------------------------------------------------\n-- Actions (shared by CAS + touch)\n----------------------------------------------------------------------------------------------\nlocal function canControl(): boolean\n\treturn active and launched and mover ~= nil and not lockedNow\nend\n\nlocal function sendDash(kind: string?)\n\tif not kind or not mover then\n\t\treturn\n\tend\n\tlocal o = mover.override\n\tlocal dir = o and o.dir or mover.root.CFrame.LookVector\n\tIntentRemote:FireServer(\"Dash\", { dir = dir, air = kind == \"airdash\" })\n\tSound.Play(\"Dash\", { vary = 0.08 })\nend\n\nlocal function doAction(name: string, began: boolean)\n\tif not active or not mover then\n\t\treturn\n\tend\n\tif name == \"Jump\" then\n\t\tmover.jumpHeld = began\n\t\tif began and canControl() then\n\t\t\tlocal r = mover:Jump()\n\t\t\tif r == \"airdash\" then\n\t\t\t\tsendDash(r)\n\t\t\telseif r then\n\t\t\t\tSound.Play(\"Jump\", { vary = 0.1, volume = r == \"airjump\" and 0.35 or 0.3 })\n\t\t\tend\n\t\tend\n\telseif name == \"Dash\" then\n\t\tif began and canControl() then\n\t\t\tsendDash(mover:Dash())\n\t\tend\n\telseif name == \"Gun\" then\n\t\tif began then\n\t\t\tgunHeld = true\n\t\t\tIntentRemote:FireServer(\"GunDown\")\n\t\telseif gunHeld then\n\t\t\tgunHeld = false\n\t\t\tIntentRemote:FireServer(\"GunUp\")\n\t\tend\n\telseif name == \"Bomb\" then\n\t\tif began then\n\t\t\tIntentRemote:FireServer(\"Bomb\")\n\t\tend\n\telseif name == \"Pod\" then\n\t\tif began then\n\t\t\tIntentRemote:FireServer(\"Pod\")\n\t\tend\n\tend\nend\nBattle.DoAction = doAction\n\nlocal SINK = Enum.ContextActionResult.Sink\nlocal function began(state: Enum.UserInputState): boolean\n\treturn state == Enum.UserInputState.Begin\nend\nlocal function ended(state: Enum.UserInputState): boolean\n\treturn state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel\nend\n\nlocal function actionHandler(name: string)\n\treturn function(_, state, _input)\n\t\tif began(state) then\n\t\t\tdoAction(name, true)\n\t\telseif ended(state) then\n\t\t\tdoAction(name, false)\n\t\tend\n\t\treturn SINK\n\tend\nend\n\nlocal function onMove(_, state, input: InputObject)\n\tif input.KeyCode == Enum.KeyCode.Thumbstick1 then\n\t\tpadMove = ended(state) and Vector2.zero or Vector2.new(input.Position.X, input.Position.Y)\n\telse\n\t\tkeys[input.KeyCode] = not ended(state)\n\tend\n\treturn SINK\nend\n\nlocal function onLook(_, state, input: InputObject)\n\tpadLook = ended(state) and Vector2.zero or Vector2.new(input.Position.X, input.Position.Y)\n\treturn SINK\nend\n\nlocal BIND_PRIORITY = Enum.ContextActionPriority.High.Value + 100\nlocal function bindInputs()\n\tlocal K = Enum.KeyCode\n\tContextActionService:BindActionAtPriority(\"RC_Move\", onMove, false, BIND_PRIORITY, K.W, K.A, K.S, K.D, K.Up, K.Down, K.Left, K.Right, K.Thumbstick1)\n\tContextActionService:BindActionAtPriority(\"RC_Look\", onLook, false, BIND_PRIORITY, K.Thumbstick2)\n\tContextActionService:BindActionAtPriority(\"RC_Jump\", actionHandler(\"Jump\"), false, BIND_PRIORITY, K.Space, K.ButtonA)\n\tContextActionService:BindActionAtPriority(\"RC_Dash\", actionHandler(\"Dash\"), false, BIND_PRIORITY, K.LeftShift, K.RightShift, K.ButtonB, K.ButtonL1)\n\tContextActionService:BindActionAtPriority(\"RC_Gun\", actionHandler(\"Gun\"), false, BIND_PRIORITY, Enum.UserInputType.MouseButton1, K.J, K.ButtonR2)\n\tContextActionService:BindActionAtPriority(\"RC_Bomb\", actionHandler(\"Bomb\"), false, BIND_PRIORITY, Enum.UserInputType.MouseButton2, K.K, K.ButtonL2, K.ButtonX)\n\tContextActionService:BindActionAtPriority(\"RC_Pod\", actionHandler(\"Pod\"), false, BIND_PRIORITY, K.E, K.L, K.ButtonR1, K.ButtonY)\nend\n\nlocal function unbindInputs()\n\tfor _, n in ipairs({ \"RC_Move\", \"RC_Look\", \"RC_Jump\", \"RC_Dash\", \"RC_Gun\", \"RC_Bomb\", \"RC_Pod\" }) do\n\t\tContextActionService:UnbindAction(n)\n\tend\n\ttable.clear(keys)\n\tpadMove = Vector2.zero\n\tpadLook = Vector2.zero\n\tgunHeld = false\nend\n\n----------------------------------------------------------------------------------------------\n-- Server callbacks\n----------------------------------------------------------------------------------------------\nfunction Battle.OnLocalFire(data)\n\tif mover and data.slow and data.slowTime then\n\t\tmover:Slow(data.slow, data.slowTime)\n\tend\nend\n\nfunction Battle.OnKnock(vel: Vector3, up: number, dur: number)\n\tif mover then\n\t\tmover:Knockback(vel, up, dur)\n\tend\nend\n\nfunction Battle.OnTeleported()\n\tif mover then\n\t\tmover:ResetVelocity()\n\tend\nend\n\n----------------------------------------------------------------------------------------------\n-- Camera\n----------------------------------------------------------------------------------------------\nlocal function updateCamera(dt: number)\n\tlocal camera = workspace.CurrentCamera\n\tcamera.CameraType = Enum.CameraType.Scriptable\n\tcamera.FieldOfView = 50\n\tlocal pts = {}\n\tlocal intro = not launched and not ko\n\tlocal focusModel = nil\n\tif ko then\n\t\tlocal t = os.clock() - ko.t0\n\t\tif t < M.KOFreezeTime then\n\t\t\tfocusModel = ko.loser or ko.winner\n\t\telse\n\t\t\tfocusModel = ko.winner or ko.loser\n\t\tend\n\tend\n\tif focusModel and rootOf(focusModel) then\n\t\ttable.insert(pts, (rootOf(focusModel) :: BasePart).Position)\n\telseif intro and serverNow() < info.startTime + CUBE_OPEN then\n\t\tfor _, r in ipairs(info.roster) do\n\t\t\ttable.insert(pts, r.spawnPos)\n\t\tend\n\telse\n\t\tfor _, r in ipairs(info.roster) do\n\t\t\tlocal rr = rootOf(r.model)\n\t\t\tif rr and (isAlive(r.model) or r.model == model) then\n\t\t\t\ttable.insert(pts, rr.Position)\n\t\t\tend\n\t\tend\n\tend\n\tif #pts == 0 then\n\t\ttable.insert(pts, info.center)\n\tend\n\tlocal lo, hi = pts[1], pts[1]\n\tfor _, p in ipairs(pts) do\n\t\tlo = lo:Min(p)\n\t\thi = hi:Max(p)\n\tend\n\tlocal mid = (lo + hi) / 2\n\tlocal focusTarget = Vector3.new(mid.X, info.center.Y + 2, mid.Z)\n\tif not cam.focus then\n\t\tcam.focus = info.center\n\tend\n\tlocal nudgeTarget = padLook.Magnitude > 0.2 and padLook.X * rad(25) or 0\n\tcam.yawNudge += (nudgeTarget - cam.yawNudge) * (1 - math.exp(-dt * 4))\n\tlocal yaw = cam.yaw + cam.yawNudge\n\tlocal back = Vector3.new(math.sin(yaw), 0, math.cos(yaw))\n\tlocal pitch = PITCH - (focusModel and rad(6) or 0)\n\tlocal toCam = back * math.cos(pitch) + Vector3.yAxis * math.sin(pitch)\n\tlocal look = -toCam\n\tlocal right = look:Cross(Vector3.yAxis).Unit\n\tlocal up = right:Cross(look)\n\n\t-- Zoom-to-fit: smallest distance that keeps every robot (feet..head) inside the frustum,\n\t-- with extra room at the bottom for the HUD panels.\n\tlocal targetDist\n\tif focusModel then\n\t\ttargetDist = 30\n\telse\n\t\tlocal tanV = math.tan(rad(camera.FieldOfView) / 2)\n\t\tlocal vp = camera.ViewportSize\n\t\tlocal tanH = tanV * (vp.X / math.max(vp.Y, 1))\n\t\tlocal tUp, tDown, tSide = tanV * 0.78, tanV * 0.5, tanH * 0.8\n\t\ttargetDist = 0\n\t\tfor _, p in ipairs(pts) do\n\t\t\tfor _, h in ipairs({ -2.5, 5 }) do\n\t\t\t\tlocal r = Vector3.new(p.X, info.center.Y + h, p.Z) - focusTarget\n\t\t\t\tlocal depth = r:Dot(look)\n\t\t\t\tlocal y = r:Dot(up)\n\t\t\t\tlocal x = r:Dot(right)\n\t\t\t\tlocal ty = y >= 0 and tUp or tDown\n\t\t\t\ttargetDist = math.max(targetDist, math.abs(y) / ty - depth, math.abs(x) / tSide - depth)\n\t\t\tend\n\t\tend\n\t\ttargetDist = math.clamp(targetDist, 40, 115)\n\tend\n\tlocal kf = 1 - math.exp(-dt * (focusModel and 3 or 5))\n\tlocal kd = 1 - math.exp(-dt * (intro and 1.6 or (targetDist > cam.dist and 4 or 2)))\n\tcam.focus = (cam.focus :: Vector3):Lerp(focusTarget, kf)\n\tcam.dist += (targetDist - cam.dist) * kd\n\tlocal focus = cam.focus :: Vector3\n\tcamera.CFrame = CFrame.lookAt(focus + toCam * cam.dist, focus) * FX.ShakeCFrame()\nend\n\n----------------------------------------------------------------------------------------------\n-- Intro: cube drop-in + READY 3-2-1 LAUNCH!\n----------------------------------------------------------------------------------------------\nlocal function makeCube(r)\n\tlocal color = Config.TeamColors[r.team] or Color3.new(1, 1, 1)\n\tlocal p = Instance.new(\"Part\")\n\tp.Name = \"DropCube\"\n\tp.Anchored = true\n\tp.CanCollide = false\n\tp.CanQuery = false\n\tp.CanTouch = false\n\tp.CastShadow = true\n\tp.Size = Vector3.new(7, 7, 7)\n\tp.Material = Enum.Material.Metal\n\tp.Color = Color3.fromRGB(30, 34, 60)\n\tp.Parent = FX.Folder()\n\tlocal inner = Instance.new(\"Part\")\n\tinner.Name = \"Core\"\n\tinner.Anchored = true\n\tinner.CanCollide = false\n\tinner.CanQuery = false\n\tinner.CanTouch = false\n\tinner.Size = Vector3.new(7.3, 2, 7.3)\n\tinner.Material = Enum.Material.Neon\n\tinner.Color = color\n\tinner.Parent = p\n\tlocal box = Instance.new(\"SelectionBox\")\n\tbox.Adornee = p\n\tbox.Color3 = color\n\tbox.LineThickness = 0.12\n\tbox.SurfaceTransparency = 1\n\tbox.Parent = p\n\tlocal light = Instance.new(\"PointLight\")\n\tlight.Color = color\n\tlight.Range = 16\n\tlight.Brightness = 2\n\tlight.Parent = p\n\treturn { part = p, core = inner, color = color, spawnPos = r.spawnPos, spin = math.random() * math.pi * 2, opened = false }\nend\n\nlocal function updateCubes()\n\tif #cubes == 0 or not info then\n\t\treturn\n\tend\n\tlocal t = serverNow() - info.startTime\n\tfor _, c in ipairs(cubes) do\n\t\tif not c.opened then\n\t\t\tlocal a = math.clamp(t / CUBE_FALL, 0, 1)\n\t\t\tlocal y = CUBE_HEIGHT * (1 - a * a)\n\t\t\tlocal landed = a >= 1\n\t\t\tlocal squash = 0\n\t\t\tif landed then\n\t\t\t\tlocal s = t - CUBE_FALL\n\t\t\t\tsquash = math.max(0, 0.6 - s * 2) * math.sin(s * 30) * 0.4\n\t\t\t\tif not c.landed then\n\t\t\t\t\tc.landed = true\n\t\t\t\t\tFX.Shake(0.9, 0.3)\n\t\t\t\t\tFX.Burst(c.spawnPos + Vector3.new(0, 0.5, 0), c.color, 18, 22, 1.2, 0.5)\n\t\t\t\t\tSound.Play(\"Explosion\", { volume = 0.25, pitch = 1.6 })\n\t\t\t\tend\n\t\t\tend\n\t\t\tlocal spin = c.spin + (1 - a) * 4\n\t\t\tlocal cf = CFrame.new(c.spawnPos + Vector3.new(0, 3.5 + y + squash, 0)) * CFrame.Angles(0, spin, 0)\n\t\t\tc.part.CFrame = cf\n\t\t\tc.core.CFrame = cf\n\t\tend\n\tend\nend\n\nlocal function openCubes()\n\tfor _, c in ipairs(cubes) do\n\t\tif not c.opened then\n\t\t\tc.opened = true\n\t\t\tFX.Flash(c.spawnPos + Vector3.new(0, 3.5, 0), c.color, 14, 0.35)\n\t\t\tFX.Burst(c.spawnPos + Vector3.new(0, 3.5, 0), c.color, 30, 40, 1.6, 0.6)\n\t\t\tc.part:Destroy()\n\t\tend\n\tend\n\ttable.clear(cubes)\n\tSound.Play(\"Explosion\", { volume = 0.35, pitch = 1.3 })\nend\n\nlocal function schedule(at: number, fn: () -> ())\n\tlocal delay = at - serverNow()\n\tif delay < -0.15 then\n\t\treturn\n\tend\n\ttable.insert(timers, task.delay(math.max(0, delay), fn))\nend\n\nlocal function cancelTimers()\n\tfor _, th in ipairs(timers) do\n\t\tpcall(task.cancel, th)\n\tend\n\ttable.clear(timers)\nend\n\n----------------------------------------------------------------------------------------------\n-- Frame step\n----------------------------------------------------------------------------------------------\nlocal function step(dt: number)\n\tif not active or not info then\n\t\treturn\n\tend\n\tupdateCubes()\n\tif model and model.Parent and mover then\n\t\tlocal st = model:GetAttribute(\"State\")\n\t\tlocal locked = model:GetAttribute(\"Locked\") == true or st == \"Down\" or st == \"KO\" or st == \"Intro\" or not launched\n\t\tif locked ~= lockedNow then\n\t\t\tlockedNow = locked\n\t\t\tmover:SetLocked(locked)\n\t\tend\n\t\tmover.moveInput = locked and Vector3.zero or moveVector()\n\t\tlocal gun = loadout.Gun\n\t\tmover.chargeMul = (gun.Type == \"Charge\" and gunHeld and not locked) and gun.ChargeMoveSlow or 1\n\t\tif not mover.root.Anchored then\n\t\t\tmover:Step(dt)\n\t\tend\n\t\tState.dashReady01 = math.clamp(1 - (mover.dashReadyAt - os.clock()) / loadout.Legs.DashCooldown, 0, 1)\n\tend\n\tlocal target = pickTarget()\n\tState.target = target\n\tHUD.SetTarget((launched and not ko) and target or nil)\n\tHUD.Update(dt, endTime, frozenTimer)\n\tupdateCamera(dt)\nend\n\n----------------------------------------------------------------------------------------------\n-- Lifecycle\n----------------------------------------------------------------------------------------------\nfunction Battle.Start(data)\n\tBattle.Stop()\n\tinfo = data\n\tState.match = data\n\tState.mode = \"Battle\"\n\tactive = true\n\tlaunched = false\n\tko = nil\n\tendTime = nil\n\tfrozenTimer = data.duration\n\tlockedNow = true\n\tmodel = data.localModel\n\tState.localModel = model\n\tcam.focus = nil\n\tcam.dist = 135\n\tcam.yawNudge = 0\n\tlocal mySpawn = data.center + Vector3.new(0, 0, 40)\n\tfor _, r in ipairs(data.roster) do\n\t\tif r.model == model then\n\t\t\tmySpawn = r.spawnPos\n\t\tend\n\tend\n\tlocal back = Util.flatUnit(mySpawn - data.center, Vector3.new(0, 0, 1))\n\tcam.yaw = math.atan2(back.X, back.Z)\n\n\tlocal geo = nil\n\tfor _, r in ipairs(data.roster) do\n\t\tif r.model and r.model.Parent then\n\t\t\tlocal arena = r.model:FindFirstAncestorWhichIsA(\"Model\")\n\t\t\twhile arena and arena.Parent and arena.Parent.Name ~= \"Arenas\" do\n\t\t\t\tarena = arena:FindFirstAncestorWhichIsA(\"Model\")\n\t\t\tend\n\t\t\tgeo = arena and arena:FindFirstChild(\"Geometry\")\n\t\t\tbreak\n\t\tend\n\tend\n\tRobotAnim.SetGeometry(geo)\n\n\tlocal revealIn = (data.startTime + CUBE_OPEN) - serverNow()\n\tfor _, r in ipairs(data.roster) do\n\t\tif r.model then\n\t\t\tRobotAnim.Register(r.model, revealIn > 0 and (os.clock() + revealIn) or nil)\n\t\tend\n\t\tif revealIn > 0 then\n\t\t\ttable.insert(cubes, makeCube(r))\n\t\tend\n\tend\n\tupdateCubes()\n\n\tif model then\n\t\tlocal robotId = model:GetAttribute(\"RobotId\") or State.robotId\n\t\tloadout = Config.GetLoadout(robotId)\n\t\tmover = Mover.new(model, loadout.Legs)\n\t\tmover.getFacePos = function()\n\t\t\tlocal t = State.target\n\t\t\tlocal rr = rootOf(t)\n\t\t\treturn rr and rr.Position or nil\n\t\tend\n\t\tmover:SetLocked(true)\n\tend\n\n\tHUD.Start(data)\n\tHUD.SetChipsVisible(not Touch.Enabled())\n\tTouch.SetActive(true)\n\tbindInputs()\n\tRunService:BindToRenderStep(\"RoboClashBattle\", Enum.RenderPriority.Camera.Value + 1, step)\n\n\tlocal st = data.startTime\n\tschedule(st + CUBE_OPEN, openCubes)\n\tschedule(st + 2.0, function()\n\t\tHUD.Announce(\"READY\", { size = 120, hold = 0.65, color = Color3.fromRGB(120, 235, 255) })\n\tend)\n\tlocal counts = { \"3\", \"2\", \"1\" }\n\tfor i, txt in ipairs(counts) do\n\t\tschedule(st + 2.8 + (i - 1) * 0.53, function()\n\t\t\tHUD.Announce(txt, { size = 150, hold = 0.4 })\n\t\t\tSound.Play(\"Countdown\", { pitch = 1 + (i - 1) * 0.04 })\n\t\tend)\n\tend\n\tschedule(data.launchTime, function()\n\t\tif not ko then\n\t\t\tHUD.Announce(\"LAUNCH!\", { size = 150, hold = 0.7, slam = true, color = Color3.fromRGB(255, 220, 80) })\n\t\t\tSound.Play(\"Launch\")\n\t\t\tFX.Shake(0.6, 0.25)\n\t\tend\n\tend)\nend\n\nfunction Battle.OnLaunch(data)\n\tif not active then\n\t\treturn\n\tend\n\tlaunched = true\n\tendTime = data.endTime\n\tfrozenTimer = nil\n\topenCubes()\n\tfor _, r in ipairs(info.roster) do\n\t\tif r.model then\n\t\t\tRobotAnim.Reveal(r.model)\n\t\tend\n\tend\nend\n\nfunction Battle.OnKO(data)\n\tif not active then\n\t\treturn\n\tend\n\tlocal remain = endTime and math.max(0, endTime - serverNow()) or info.duration\n\tfrozenTimer = remain\n\tlaunched = false\n\tlockedNow = true\n\tif mover then\n\t\tmover:SetLocked(true)\n\tend\n\tif gunHeld then\n\t\tgunHeld = false\n\tend\n\tlocal loser = nil\n\tfor _, r in ipairs(info.roster) do\n\t\tif r.model and r.model ~= data.winner then\n\t\t\tif not loser or r.model:GetAttribute(\"State\") == \"KO\" then\n\t\t\t\tloser = r.model\n\t\t\tend\n\t\tend\n\tend\n\tko = { t0 = os.clock(), winner = data.winner, loser = (not data.draw) and loser or nil, data = data }\n\tif data.draw then\n\t\tHUD.Announce(data.reason == \"TIME\" and \"TIME UP!\" or \"DRAW\", { size = 130, hold = 1.4, slam = true })\n\t\ttask.delay(1.5, function()\n\t\t\tif ko and active then\n\t\t\t\tHUD.Announce(\"DRAW\", { size = 140, hold = 1.6, color = Color3.fromRGB(200, 200, 255) })\n\t\t\tend\n\t\tend)\n\telseif data.reason == \"TIME\" then\n\t\tHUD.Announce(\"TIME UP!\", { size = 130, hold = 1.2, slam = true, color = Color3.fromRGB(255, 220, 80) })\n\telseif data.reason == \"LEFT\" then\n\t\tHUD.Announce(\"OPPONENT LEFT\", { size = 90, hold = 2.2, slam = true, color = Color3.fromRGB(200, 220, 255) })\n\telse\n\t\tHUD.Announce(\"K.O.!\", { size = 170, hold = 1.3, slam = true, color = Color3.fromRGB(255, 70, 110) })\n\t\tFX.Shake(2.2, 0.6)\n\tend\n\tSound.Play(\"KO\")\n\tif data.perfect then\n\t\ttask.delay(1.6, function()\n\t\t\tif ko and active then\n\t\t\t\tHUD.Announce(\"PERFECT!\", { size = 140, hold = 2, slam = true, color = Color3.fromRGB(255, 215, 70) })\n\t\t\tend\n\t\tend)\n\telseif not data.draw and data.winner then\n\t\ttask.delay(1.6, function()\n\t\t\tif ko and active then\n\t\t\t\tlocal isMe = data.winner == model\n\t\t\t\tHUD.Announce(isMe and \"YOU WIN!\" or \"YOU LOSE\", {\n\t\t\t\t\tsize = 120,\n\t\t\t\t\thold = 2,\n\t\t\t\t\tcolor = isMe and Color3.fromRGB(255, 215, 70) or Color3.fromRGB(150, 170, 215),\n\t\t\t\t})\n\t\t\tend\n\t\tend)\n\tend\nend\n\nfunction Battle.Stop()\n\tif not active then\n\t\treturn\n\tend\n\tactive = false\n\tlaunched = false\n\tcancelTimers()\n\tRunService:UnbindFromRenderStep(\"RoboClashBattle\")\n\tunbindInputs()\n\tTouch.SetActive(false)\n\tfor _, c in ipairs(cubes) do\n\t\tc.part:Destroy()\n\tend\n\ttable.clear(cubes)\n\tHUD.Stop()\n\tFX.ClearAll()\n\tRobotAnim.Clear()\n\tmover = nil\n\tmodel = nil\n\tinfo = nil\n\tko = nil\n\tState.localModel = nil\n\tState.match = nil\n\tState.target = nil\nend\n\nfunction Battle.IsActive(): boolean\n\treturn active\nend\n\nreturn Battle\n","message":"The file /Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/Battle.luau has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"toolu_01MUmVDF25Vd23rGCUuyQxnE","startedAtMs":"1791075273722","completedAtMs":"1791075274531"},"model_call_id":"9f87d2a3-a097-4b92-978f-ec64b826b4ce-2-66a3","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791075274539}
{"type":"tool_call","subtype":"started","call_id":"toolu_01G3ixTezETvh6wtMNa6gK5Z","tool_call":{"editToolCall":{"args":{"path":"/Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/Battle.luau","streamContent":"\tif focusModel then\n\t\ttargetDist = 34\n\telse\n\t\tlocal tanV"}},"hookAdditionalContexts":[],"toolCallId":"toolu_01G3ixTezETvh6wtMNa6gK5Z","startedAtMs":"1791075274375"},"model_call_id":"9f87d2a3-a097-4b92-978f-ec64b826b4ce-2-66a3","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791075275576}
{"type":"tool_call","subtype":"completed","call_id":"toolu_01G3ixTezETvh6wtMNa6gK5Z","tool_call":{"editToolCall":{"args":{"path":"/Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/Battle.luau","streamContent":"\tif focusModel then\n\t\ttargetDist = 34\n\telse\n\t\tlocal tanV"},"result":{"success":{"path":"/Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/Battle.luau","linesAdded":1,"linesRemoved":1,"diffString":"--- a//Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/Battle.luau\n+++ b//Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/Battle.luau\n@@ -305,7 +305,7 @@\n \t-- with extra room at the bottom for the HUD panels.\n \tlocal targetDist\n \tif focusModel then\n-\t\ttargetDist = 30\n+\t\ttargetDist = 34\n \telse\n \t\tlocal tanV = math.tan(rad(camera.FieldOfView) / 2)\n \t\tlocal vp = camera.ViewportSize","beforeFullFileContent":"-- In-match client controller: input (KB+M / gamepad / touch) -> local Mover + server intents,\n-- lock-on target, auto-framing high-angle camera, cube drop-in intro, KO sequence.\nlocal ContextActionService = game:GetService(\"ContextActionService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal RC = ReplicatedStorage:WaitForChild(\"RoboClash\")\nlocal Config = require(RC.Config)\nlocal Util = require(RC.Shared.Util)\nlocal Mover = require(RC.Shared.Mover)\nlocal State = require(script.Parent.State)\nlocal Sound = require(script.Parent.Sound)\nlocal Touch = require(script.Parent.Touch)\n\nlocal IntentRemote = RC:WaitForChild(\"Remotes\"):WaitForChild(\"Intent\")\nlocal M = Config.Match\nlocal rad = math.rad\n\nlocal Battle = {}\nlocal HUD, FX, RobotAnim -- injected\n\nlocal info = nil\nlocal model: Model? = nil\nlocal mover = nil\nlocal loadout = nil\nlocal active = false\nlocal launched = false\nlocal endTime: number? = nil\nlocal frozenTimer: number? = nil\nlocal lockedNow = true\nlocal keys = {}\nlocal padMove = Vector2.zero\nlocal padLook = Vector2.zero\nlocal gunHeld = false\nlocal cubes = {}\nlocal timers = {}\nlocal cam = { focus = nil :: Vector3?, dist = 130, yaw = 0, yawNudge = 0 }\nlocal ko = nil\n\nlocal PITCH = rad(47)\nlocal CUBE_FALL = 1.1\nlocal CUBE_OPEN = 1.6\nlocal CUBE_HEIGHT = 70\n\nfunction Battle.Init(deps)\n\tHUD = deps.HUD\n\tFX = deps.FX\n\tRobotAnim = deps.RobotAnim\nend\n\nlocal function serverNow(): number\n\treturn workspace:GetServerTimeNow()\nend\n\nlocal function rootOf(m: Model?): BasePart?\n\treturn m and m.Parent and m:FindFirstChild(\"HumanoidRootPart\") :: BasePart?\nend\n\nlocal function isAlive(m: Model): boolean\n\treturn m.Parent ~= nil and m:GetAttribute(\"State\") ~= \"KO\"\nend\n\nlocal function pickTarget(): Model?\n\tlocal myRoot = rootOf(model)\n\tif not myRoot or not info then\n\t\treturn nil\n\tend\n\tlocal best, bestD = nil, math.huge\n\tfor _, r in ipairs(info.roster) do\n\t\tlocal m = r.model\n\t\tif m and m ~= model and isAlive(m) then\n\t\t\tlocal rr = rootOf(m)\n\t\t\tif rr then\n\t\t\t\tlocal d = (rr.Position - myRoot.Position).Magnitude\n\t\t\t\tif d < bestD then\n\t\t\t\t\tbest, bestD = m, d\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\treturn best\nend\n\nlocal function moveVector(): Vector3\n\tlocal x, y = 0, 0\n\tif keys[Enum.KeyCode.W] or keys[Enum.KeyCode.Up] then\n\t\ty += 1\n\tend\n\tif keys[Enum.KeyCode.S] or keys[Enum.KeyCode.Down] then\n\t\ty -= 1\n\tend\n\tif keys[Enum.KeyCode.D] or keys[Enum.KeyCode.Right] then\n\t\tx += 1\n\tend\n\tif keys[Enum.KeyCode.A] or keys[Enum.KeyCode.Left] then\n\t\tx -= 1\n\tend\n\tlocal v = Vector2.new(x, y)\n\tif padMove.Magnitude > 0.18 then\n\t\tv += padMove\n\tend\n\tlocal tm = Touch.move\n\tif tm.Magnitude > 0 then\n\t\tv += Vector2.new(tm.X, -tm.Y)\n\tend\n\tif v.Magnitude > 1 then\n\t\tv = v.Unit\n\tend\n\tif v.Magnitude < 0.05 then\n\t\treturn Vector3.zero\n\tend\n\tlocal cf = workspace.CurrentCamera.CFrame\n\tlocal f = Util.flatUnit(cf.LookVector, Vector3.new(0, 0, -1))\n\tlocal r = Util.flatUnit(cf.RightVector, Vector3.new(1, 0, 0))\n\treturn r * v.X + f * v.Y\nend\n\n----------------------------------------------------------------------------------------------\n-- Actions (shared by CAS + touch)\n----------------------------------------------------------------------------------------------\nlocal function canControl(): boolean\n\treturn active and launched and mover ~= nil and not lockedNow\nend\n\nlocal function sendDash(kind: string?)\n\tif not kind or not mover then\n\t\treturn\n\tend\n\tlocal o = mover.override\n\tlocal dir = o and o.dir or mover.root.CFrame.LookVector\n\tIntentRemote:FireServer(\"Dash\", { dir = dir, air = kind == \"airdash\" })\n\tSound.Play(\"Dash\", { vary = 0.08 })\nend\n\nlocal function doAction(name: string, began: boolean)\n\tif not active or not mover then\n\t\treturn\n\tend\n\tif name == \"Jump\" then\n\t\tmover.jumpHeld = began\n\t\tif began and canControl() then\n\t\t\tlocal r = mover:Jump()\n\t\t\tif r == \"airdash\" then\n\t\t\t\tsendDash(r)\n\t\t\telseif r then\n\t\t\t\tSound.Play(\"Jump\", { vary = 0.1, volume = r == \"airjump\" and 0.35 or 0.3 })\n\t\t\tend\n\t\tend\n\telseif name == \"Dash\" then\n\t\tif began and canControl() then\n\t\t\tsendDash(mover:Dash())\n\t\tend\n\telseif name == \"Gun\" then\n\t\tif began then\n\t\t\tgunHeld = true\n\t\t\tIntentRemote:FireServer(\"GunDown\")\n\t\telseif gunHeld then\n\t\t\tgunHeld = false\n\t\t\tIntentRemote:FireServer(\"GunUp\")\n\t\tend\n\telseif name == \"Bomb\" then\n\t\tif began then\n\t\t\tIntentRemote:FireServer(\"Bomb\")\n\t\tend\n\telseif name == \"Pod\" then\n\t\tif began then\n\t\t\tIntentRemote:FireServer(\"Pod\")\n\t\tend\n\tend\nend\nBattle.DoAction = doAction\n\nlocal SINK = Enum.ContextActionResult.Sink\nlocal function began(state: Enum.UserInputState): boolean\n\treturn state == Enum.UserInputState.Begin\nend\nlocal function ended(state: Enum.UserInputState): boolean\n\treturn state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel\nend\n\nlocal function actionHandler(name: string)\n\treturn function(_, state, _input)\n\t\tif began(state) then\n\t\t\tdoAction(name, true)\n\t\telseif ended(state) then\n\t\t\tdoAction(name, false)\n\t\tend\n\t\treturn SINK\n\tend\nend\n\nlocal function onMove(_, state, input: InputObject)\n\tif input.KeyCode == Enum.KeyCode.Thumbstick1 then\n\t\tpadMove = ended(state) and Vector2.zero or Vector2.new(input.Position.X, input.Position.Y)\n\telse\n\t\tkeys[input.KeyCode] = not ended(state)\n\tend\n\treturn SINK\nend\n\nlocal function onLook(_, state, input: InputObject)\n\tpadLook = ended(state) and Vector2.zero or Vector2.new(input.Position.X, input.Position.Y)\n\treturn SINK\nend\n\nlocal BIND_PRIORITY = Enum.ContextActionPriority.High.Value + 100\nlocal function bindInputs()\n\tlocal K = Enum.KeyCode\n\tContextActionService:BindActionAtPriority(\"RC_Move\", onMove, false, BIND_PRIORITY, K.W, K.A, K.S, K.D, K.Up, K.Down, K.Left, K.Right, K.Thumbstick1)\n\tContextActionService:BindActionAtPriority(\"RC_Look\", onLook, false, BIND_PRIORITY, K.Thumbstick2)\n\tContextActionService:BindActionAtPriority(\"RC_Jump\", actionHandler(\"Jump\"), false, BIND_PRIORITY, K.Space, K.ButtonA)\n\tContextActionService:BindActionAtPriority(\"RC_Dash\", actionHandler(\"Dash\"), false, BIND_PRIORITY, K.LeftShift, K.RightShift, K.ButtonB, K.ButtonL1)\n\tContextActionService:BindActionAtPriority(\"RC_Gun\", actionHandler(\"Gun\"), false, BIND_PRIORITY, Enum.UserInputType.MouseButton1, K.J, K.ButtonR2)\n\tContextActionService:BindActionAtPriority(\"RC_Bomb\", actionHandler(\"Bomb\"), false, BIND_PRIORITY, Enum.UserInputType.MouseButton2, K.K, K.ButtonL2, K.ButtonX)\n\tContextActionService:BindActionAtPriority(\"RC_Pod\", actionHandler(\"Pod\"), false, BIND_PRIORITY, K.E, K.L, K.ButtonR1, K.ButtonY)\nend\n\nlocal function unbindInputs()\n\tfor _, n in ipairs({ \"RC_Move\", \"RC_Look\", \"RC_Jump\", \"RC_Dash\", \"RC_Gun\", \"RC_Bomb\", \"RC_Pod\" }) do\n\t\tContextActionService:UnbindAction(n)\n\tend\n\ttable.clear(keys)\n\tpadMove = Vector2.zero\n\tpadLook = Vector2.zero\n\tgunHeld = false\nend\n\n----------------------------------------------------------------------------------------------\n-- Server callbacks\n----------------------------------------------------------------------------------------------\nfunction Battle.OnLocalFire(data)\n\tif mover and data.slow and data.slowTime then\n\t\tmover:Slow(data.slow, data.slowTime)\n\tend\nend\n\nfunction Battle.OnKnock(vel: Vector3, up: number, dur: number)\n\tif mover then\n\t\tmover:Knockback(vel, up, dur)\n\tend\nend\n\nfunction Battle.OnTeleported()\n\tif mover then\n\t\tmover:ResetVelocity()\n\tend\nend\n\n----------------------------------------------------------------------------------------------\n-- Camera\n----------------------------------------------------------------------------------------------\nlocal function updateCamera(dt: number)\n\tlocal camera = workspace.CurrentCamera\n\tcamera.CameraType = Enum.CameraType.Scriptable\n\tcamera.FieldOfView = 50\n\tlocal pts = {}\n\tlocal intro = not launched and not ko\n\tlocal focusModel = nil\n\tif ko then\n\t\tlocal t = os.clock() - ko.t0\n\t\tif t < M.KOFreezeTime then\n\t\t\tfocusModel = ko.loser or ko.winner\n\t\telse\n\t\t\tfocusModel = ko.winner or ko.loser\n\t\tend\n\tend\n\tif focusModel and rootOf(focusModel) then\n\t\ttable.insert(pts, (rootOf(focusModel) :: BasePart).Position)\n\telseif intro and serverNow() < info.startTime + CUBE_OPEN then\n\t\tfor _, r in ipairs(info.roster) do\n\t\t\ttable.insert(pts, r.spawnPos)\n\t\tend\n\telse\n\t\tfor _, r in ipairs(info.roster) do\n\t\t\tlocal rr = rootOf(r.model)\n\t\t\tif rr and (isAlive(r.model) or r.model == model) then\n\t\t\t\ttable.insert(pts, rr.Position)\n\t\t\tend\n\t\tend\n\tend\n\tif #pts == 0 then\n\t\ttable.insert(pts, info.center)\n\tend\n\tlocal lo, hi = pts[1], pts[1]\n\tfor _, p in ipairs(pts) do\n\t\tlo = lo:Min(p)\n\t\thi = hi:Max(p)\n\tend\n\tlocal mid = (lo + hi) / 2\n\tlocal focusTarget = Vector3.new(mid.X, info.center.Y + 2, mid.Z)\n\tif not cam.focus then\n\t\tcam.focus = info.center\n\tend\n\tlocal nudgeTarget = padLook.Magnitude > 0.2 and padLook.X * rad(25) or 0\n\tcam.yawNudge += (nudgeTarget - cam.yawNudge) * (1 - math.exp(-dt * 4))\n\tlocal yaw = cam.yaw + cam.yawNudge\n\tlocal back = Vector3.new(math.sin(yaw), 0, math.cos(yaw))\n\tlocal pitch = PITCH - (focusModel and rad(6) or 0)\n\tlocal toCam = back * math.cos(pitch) + Vector3.yAxis * math.sin(pitch)\n\tlocal look = -toCam\n\tlocal right = look:Cross(Vector3.yAxis).Unit\n\tlocal up = right:Cross(look)\n\n\t-- Zoom-to-fit: smallest distance that keeps every robot (feet..head) inside the frustum,\n\t-- with extra room at the bottom for the HUD panels.\n\tlocal targetDist\n\tif focusModel then\n\t\ttargetDist = 30\n\telse\n\t\tlocal tanV = math.tan(rad(camera.FieldOfView) / 2)\n\t\tlocal vp = camera.ViewportSize\n\t\tlocal tanH = tanV * (vp.X / math.max(vp.Y, 1))\n\t\tlocal tUp, tDown, tSide = tanV * 0.78, tanV * 0.5, tanH * 0.8\n\t\ttargetDist = 0\n\t\tfor _, p in ipairs(pts) do\n\t\t\tfor _, h in ipairs({ -2.5, 5 }) do\n\t\t\t\tlocal r = Vector3.new(p.X, info.center.Y + h, p.Z) - focusTarget\n\t\t\t\tlocal depth = r:Dot(look)\n\t\t\t\tlocal y = r:Dot(up)\n\t\t\t\tlocal x = r:Dot(right)\n\t\t\t\tlocal ty = y >= 0 and tUp or tDown\n\t\t\t\ttargetDist = math.max(targetDist, math.abs(y) / ty - depth, math.abs(x) / tSide - depth)\n\t\t\tend\n\t\tend\n\t\ttargetDist = math.clamp(targetDist, 40, 115)\n\tend\n\tlocal kf = 1 - math.exp(-dt * (focusModel and 3 or 5))\n\tlocal kd = 1 - math.exp(-dt * (intro and 1.6 or (targetDist > cam.dist and 4 or 2)))\n\tcam.focus = (cam.focus :: Vector3):Lerp(focusTarget, kf)\n\tcam.dist += (targetDist - cam.dist) * kd\n\tlocal focus = cam.focus :: Vector3\n\tcamera.CFrame = CFrame.lookAt(focus + toCam * cam.dist, focus) * FX.ShakeCFrame()\nend\n\n----------------------------------------------------------------------------------------------\n-- Intro: cube drop-in + READY 3-2-1 LAUNCH!\n----------------------------------------------------------------------------------------------\nlocal function makeCube(r)\n\tlocal color = Config.TeamColors[r.team] or Color3.new(1, 1, 1)\n\tlocal p = Instance.new(\"Part\")\n\tp.Name = \"DropCube\"\n\tp.Anchored = true\n\tp.CanCollide = false\n\tp.CanQuery = false\n\tp.CanTouch = false\n\tp.CastShadow = true\n\tp.Size = Vector3.new(7, 7, 7)\n\tp.Material = Enum.Material.Metal\n\tp.Color = Color3.fromRGB(30, 34, 60)\n\tp.Parent = FX.Folder()\n\tlocal inner = Instance.new(\"Part\")\n\tinner.Name = \"Core\"\n\tinner.Anchored = true\n\tinner.CanCollide = false\n\tinner.CanQuery = false\n\tinner.CanTouch = false\n\tinner.Size = Vector3.new(7.3, 2, 7.3)\n\tinner.Material = Enum.Material.Neon\n\tinner.Color = color\n\tinner.Parent = p\n\tlocal box = Instance.new(\"SelectionBox\")\n\tbox.Adornee = p\n\tbox.Color3 = color\n\tbox.LineThickness = 0.12\n\tbox.SurfaceTransparency = 1\n\tbox.Parent = p\n\tlocal light = Instance.new(\"PointLight\")\n\tlight.Color = color\n\tlight.Range = 16\n\tlight.Brightness = 2\n\tlight.Parent = p\n\treturn { part = p, core = inner, color = color, spawnPos = r.spawnPos, spin = math.random() * math.pi * 2, opened = false }\nend\n\nlocal function updateCubes()\n\tif #cubes == 0 or not info then\n\t\treturn\n\tend\n\tlocal t = serverNow() - info.startTime\n\tfor _, c in ipairs(cubes) do\n\t\tif not c.opened then\n\t\t\tlocal a = math.clamp(t / CUBE_FALL, 0, 1)\n\t\t\tlocal y = CUBE_HEIGHT * (1 - a * a)\n\t\t\tlocal landed = a >= 1\n\t\t\tlocal squash = 0\n\t\t\tif landed then\n\t\t\t\tlocal s = t - CUBE_FALL\n\t\t\t\tsquash = math.max(0, 0.6 - s * 2) * math.sin(s * 30) * 0.4\n\t\t\t\tif not c.landed then\n\t\t\t\t\tc.landed = true\n\t\t\t\t\tFX.Shake(0.9, 0.3)\n\t\t\t\t\tFX.Burst(c.spawnPos + Vector3.new(0, 0.5, 0), c.color, 18, 22, 1.2, 0.5)\n\t\t\t\t\tSound.Play(\"Explosion\", { volume = 0.25, pitch = 1.6 })\n\t\t\t\tend\n\t\t\tend\n\t\t\tlocal spin = c.spin + (1 - a) * 4\n\t\t\tlocal cf = CFrame.new(c.spawnPos + Vector3.new(0, 3.5 + y + squash, 0)) * CFrame.Angles(0, spin, 0)\n\t\t\tc.part.CFrame = cf\n\t\t\tc.core.CFrame = cf\n\t\tend\n\tend\nend\n\nlocal function openCubes()\n\tfor _, c in ipairs(cubes) do\n\t\tif not c.opened then\n\t\t\tc.opened = true\n\t\t\tFX.Flash(c.spawnPos + Vector3.new(0, 3.5, 0), c.color, 14, 0.35)\n\t\t\tFX.Burst(c.spawnPos + Vector3.new(0, 3.5, 0), c.color, 30, 40, 1.6, 0.6)\n\t\t\tc.part:Destroy()\n\t\tend\n\tend\n\ttable.clear(cubes)\n\tSound.Play(\"Explosion\", { volume = 0.35, pitch = 1.3 })\nend\n\nlocal function schedule(at: number, fn: () -> ())\n\tlocal delay = at - serverNow()\n\tif delay < -0.15 then\n\t\treturn\n\tend\n\ttable.insert(timers, task.delay(math.max(0, delay), fn))\nend\n\nlocal function cancelTimers()\n\tfor _, th in ipairs(timers) do\n\t\tpcall(task.cancel, th)\n\tend\n\ttable.clear(timers)\nend\n\n----------------------------------------------------------------------------------------------\n-- Frame step\n----------------------------------------------------------------------------------------------\nlocal function step(dt: number)\n\tif not active or not info then\n\t\treturn\n\tend\n\tupdateCubes()\n\tif model and model.Parent and mover then\n\t\tlocal st = model:GetAttribute(\"State\")\n\t\tlocal locked = model:GetAttribute(\"Locked\") == true or st == \"Down\" or st == \"KO\" or st == \"Intro\" or not launched\n\t\tif locked ~= lockedNow then\n\t\t\tlockedNow = locked\n\t\t\tmover:SetLocked(locked)\n\t\tend\n\t\tmover.moveInput = locked and Vector3.zero or moveVector()\n\t\tlocal gun = loadout.Gun\n\t\tmover.chargeMul = (gun.Type == \"Charge\" and gunHeld and not locked) and gun.ChargeMoveSlow or 1\n\t\tif not mover.root.Anchored then\n\t\t\tmover:Step(dt)\n\t\tend\n\t\tState.dashReady01 = math.clamp(1 - (mover.dashReadyAt - os.clock()) / loadout.Legs.DashCooldown, 0, 1)\n\tend\n\tlocal target = pickTarget()\n\tState.target = target\n\tHUD.SetTarget((launched and not ko) and target or nil)\n\tHUD.Update(dt, endTime, frozenTimer)\n\tupdateCamera(dt)\nend\n\n----------------------------------------------------------------------------------------------\n-- Lifecycle\n----------------------------------------------------------------------------------------------\nfunction Battle.Start(data)\n\tBattle.Stop()\n\tinfo = data\n\tState.match = data\n\tState.mode = \"Battle\"\n\tactive = true\n\tlaunched = false\n\tko = nil\n\tendTime = nil\n\tfrozenTimer = data.duration\n\tlockedNow = true\n\tmodel = data.localModel\n\tState.localModel = model\n\tcam.focus = nil\n\tcam.dist = 135\n\tcam.yawNudge = 0\n\tlocal mySpawn = data.center + Vector3.new(0, 0, 40)\n\tfor _, r in ipairs(data.roster) do\n\t\tif r.model == model then\n\t\t\tmySpawn = r.spawnPos\n\t\tend\n\tend\n\tlocal back = Util.flatUnit(mySpawn - data.center, Vector3.new(0, 0, 1))\n\tcam.yaw = math.atan2(back.X, back.Z)\n\n\tlocal geo = nil\n\tfor _, r in ipairs(data.roster) do\n\t\tif r.model and r.model.Parent then\n\t\t\tlocal arena = r.model:FindFirstAncestorWhichIsA(\"Model\")\n\t\t\twhile arena and arena.Parent and arena.Parent.Name ~= \"Arenas\" do\n\t\t\t\tarena = arena:FindFirstAncestorWhichIsA(\"Model\")\n\t\t\tend\n\t\t\tgeo = arena and arena:FindFirstChild(\"Geometry\")\n\t\t\tbreak\n\t\tend\n\tend\n\tRobotAnim.SetGeometry(geo)\n\n\tlocal revealIn = (data.startTime + CUBE_OPEN) - serverNow()\n\tfor _, r in ipairs(data.roster) do\n\t\tif r.model then\n\t\t\tRobotAnim.Register(r.model, revealIn > 0 and (os.clock() + revealIn) or nil)\n\t\tend\n\t\tif revealIn > 0 then\n\t\t\ttable.insert(cubes, makeCube(r))\n\t\tend\n\tend\n\tupdateCubes()\n\n\tif model then\n\t\tlocal robotId = model:GetAttribute(\"RobotId\") or State.robotId\n\t\tloadout = Config.GetLoadout(robotId)\n\t\tmover = Mover.new(model, loadout.Legs)\n\t\tmover.getFacePos = function()\n\t\t\tlocal t = State.target\n\t\t\tlocal rr = rootOf(t)\n\t\t\treturn rr and rr.Position or nil\n\t\tend\n\t\tmover:SetLocked(true)\n\tend\n\n\tHUD.Start(data)\n\tHUD.SetChipsVisible(not Touch.Enabled())\n\tTouch.SetActive(true)\n\tbindInputs()\n\tRunService:BindToRenderStep(\"RoboClashBattle\", Enum.RenderPriority.Camera.Value + 1, step)\n\n\tlocal st = data.startTime\n\tschedule(st + CUBE_OPEN, openCubes)\n\tschedule(st + 2.0, function()\n\t\tHUD.Announce(\"READY\", { size = 120, hold = 0.65, color = Color3.fromRGB(120, 235, 255) })\n\tend)\n\tlocal counts = { \"3\", \"2\", \"1\" }\n\tfor i, txt in ipairs(counts) do\n\t\tschedule(st + 2.8 + (i - 1) * 0.53, function()\n\t\t\tHUD.Announce(txt, { size = 150, hold = 0.4 })\n\t\t\tSound.Play(\"Countdown\", { pitch = 1 + (i - 1) * 0.04 })\n\t\tend)\n\tend\n\tschedule(data.launchTime, function()\n\t\tif not ko then\n\t\t\tHUD.Announce(\"LAUNCH!\", { size = 150, hold = 0.7, slam = true, color = Color3.fromRGB(255, 220, 80) })\n\t\t\tSound.Play(\"Launch\")\n\t\t\tFX.Shake(0.6, 0.25)\n\t\tend\n\tend)\nend\n\nfunction Battle.OnLaunch(data)\n\tif not active then\n\t\treturn\n\tend\n\tlaunched = true\n\tendTime = data.endTime\n\tfrozenTimer = nil\n\topenCubes()\n\tfor _, r in ipairs(info.roster) do\n\t\tif r.model then\n\t\t\tRobotAnim.Reveal(r.model)\n\t\tend\n\tend\nend\n\nfunction Battle.OnKO(data)\n\tif not active then\n\t\treturn\n\tend\n\tlocal remain = endTime and math.max(0, endTime - serverNow()) or info.duration\n\tfrozenTimer = remain\n\tlaunched = false\n\tlockedNow = true\n\tif mover then\n\t\tmover:SetLocked(true)\n\tend\n\tif gunHeld then\n\t\tgunHeld = false\n\tend\n\tlocal loser = nil\n\tfor _, r in ipairs(info.roster) do\n\t\tif r.model and r.model ~= data.winner then\n\t\t\tif not loser or r.model:GetAttribute(\"State\") == \"KO\" then\n\t\t\t\tloser = r.model\n\t\t\tend\n\t\tend\n\tend\n\tko = { t0 = os.clock(), winner = data.winner, loser = (not data.draw) and loser or nil, data = data }\n\tif data.draw then\n\t\tHUD.Announce(data.reason == \"TIME\" and \"TIME UP!\" or \"DRAW\", { size = 130, hold = 1.4, slam = true })\n\t\ttask.delay(1.5, function()\n\t\t\tif ko and active then\n\t\t\t\tHUD.Announce(\"DRAW\", { size = 140, hold = 1.6, color = Color3.fromRGB(200, 200, 255) })\n\t\t\tend\n\t\tend)\n\telseif data.reason == \"TIME\" then\n\t\tHUD.Announce(\"TIME UP!\", { size = 130, hold = 1.2, slam = true, color = Color3.fromRGB(255, 220, 80) })\n\telseif data.reason == \"LEFT\" then\n\t\tHUD.Announce(\"OPPONENT LEFT\", { size = 90, hold = 2.2, slam = true, color = Color3.fromRGB(200, 220, 255) })\n\telse\n\t\tHUD.Announce(\"K.O.!\", { size = 170, hold = 1.3, slam = true, color = Color3.fromRGB(255, 70, 110) })\n\t\tFX.Shake(2.2, 0.6)\n\tend\n\tSound.Play(\"KO\")\n\tif data.perfect then\n\t\ttask.delay(1.6, function()\n\t\t\tif ko and active then\n\t\t\t\tHUD.Announce(\"PERFECT!\", { size = 140, hold = 2, slam = true, color = Color3.fromRGB(255, 215, 70) })\n\t\t\tend\n\t\tend)\n\telseif not data.draw and data.winner then\n\t\ttask.delay(1.6, function()\n\t\t\tif ko and active then\n\t\t\t\tlocal isMe = data.winner == model\n\t\t\t\tHUD.Announce(isMe and \"YOU WIN!\" or \"YOU LOSE\", {\n\t\t\t\t\tsize = 120,\n\t\t\t\t\thold = 2,\n\t\t\t\t\tcolor = isMe and Color3.fromRGB(255, 215, 70) or Color3.fromRGB(150, 170, 215),\n\t\t\t\t})\n\t\t\tend\n\t\tend)\n\tend\nend\n\nfunction Battle.Stop()\n\tif not active then\n\t\treturn\n\tend\n\tactive = false\n\tlaunched = false\n\tcancelTimers()\n\tRunService:UnbindFromRenderStep(\"RoboClashBattle\")\n\tunbindInputs()\n\tTouch.SetActive(false)\n\tfor _, c in ipairs(cubes) do\n\t\tc.part:Destroy()\n\tend\n\ttable.clear(cubes)\n\tHUD.Stop()\n\tFX.ClearAll()\n\tRobotAnim.Clear()\n\tmover = nil\n\tmodel = nil\n\tinfo = nil\n\tko = nil\n\tState.localModel = nil\n\tState.match = nil\n\tState.target = nil\nend\n\nfunction Battle.IsActive(): boolean\n\treturn active\nend\n\nreturn Battle\n","afterFullFileContent":"-- In-match client controller: input (KB+M / gamepad / touch) -> local Mover + server intents,\n-- lock-on target, auto-framing high-angle camera, cube drop-in intro, KO sequence.\nlocal ContextActionService = game:GetService(\"ContextActionService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal RC = ReplicatedStorage:WaitForChild(\"RoboClash\")\nlocal Config = require(RC.Config)\nlocal Util = require(RC.Shared.Util)\nlocal Mover = require(RC.Shared.Mover)\nlocal State = require(script.Parent.State)\nlocal Sound = require(script.Parent.Sound)\nlocal Touch = require(script.Parent.Touch)\n\nlocal IntentRemote = RC:WaitForChild(\"Remotes\"):WaitForChild(\"Intent\")\nlocal M = Config.Match\nlocal rad = math.rad\n\nlocal Battle = {}\nlocal HUD, FX, RobotAnim -- injected\n\nlocal info = nil\nlocal model: Model? = nil\nlocal mover = nil\nlocal loadout = nil\nlocal active = false\nlocal launched = false\nlocal endTime: number? = nil\nlocal frozenTimer: number? = nil\nlocal lockedNow = true\nlocal keys = {}\nlocal padMove = Vector2.zero\nlocal padLook = Vector2.zero\nlocal gunHeld = false\nlocal cubes = {}\nlocal timers = {}\nlocal cam = { focus = nil :: Vector3?, dist = 130, yaw = 0, yawNudge = 0 }\nlocal ko = nil\n\nlocal PITCH = rad(47)\nlocal CUBE_FALL = 1.1\nlocal CUBE_OPEN = 1.6\nlocal CUBE_HEIGHT = 70\n\nfunction Battle.Init(deps)\n\tHUD = deps.HUD\n\tFX = deps.FX\n\tRobotAnim = deps.RobotAnim\nend\n\nlocal function serverNow(): number\n\treturn workspace:GetServerTimeNow()\nend\n\nlocal function rootOf(m: Model?): BasePart?\n\treturn m and m.Parent and m:FindFirstChild(\"HumanoidRootPart\") :: BasePart?\nend\n\nlocal function isAlive(m: Model): boolean\n\treturn m.Parent ~= nil and m:GetAttribute(\"State\") ~= \"KO\"\nend\n\nlocal function pickTarget(): Model?\n\tlocal myRoot = rootOf(model)\n\tif not myRoot or not info then\n\t\treturn nil\n\tend\n\tlocal best, bestD = nil, math.huge\n\tfor _, r in ipairs(info.roster) do\n\t\tlocal m = r.model\n\t\tif m and m ~= model and isAlive(m) then\n\t\t\tlocal rr = rootOf(m)\n\t\t\tif rr then\n\t\t\t\tlocal d = (rr.Position - myRoot.Position).Magnitude\n\t\t\t\tif d < bestD then\n\t\t\t\t\tbest, bestD = m, d\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\treturn best\nend\n\nlocal function moveVector(): Vector3\n\tlocal x, y = 0, 0\n\tif keys[Enum.KeyCode.W] or keys[Enum.KeyCode.Up] then\n\t\ty += 1\n\tend\n\tif keys[Enum.KeyCode.S] or keys[Enum.KeyCode.Down] then\n\t\ty -= 1\n\tend\n\tif keys[Enum.KeyCode.D] or keys[Enum.KeyCode.Right] then\n\t\tx += 1\n\tend\n\tif keys[Enum.KeyCode.A] or keys[Enum.KeyCode.Left] then\n\t\tx -= 1\n\tend\n\tlocal v = Vector2.new(x, y)\n\tif padMove.Magnitude > 0.18 then\n\t\tv += padMove\n\tend\n\tlocal tm = Touch.move\n\tif tm.Magnitude > 0 then\n\t\tv += Vector2.new(tm.X, -tm.Y)\n\tend\n\tif v.Magnitude > 1 then\n\t\tv = v.Unit\n\tend\n\tif v.Magnitude < 0.05 then\n\t\treturn Vector3.zero\n\tend\n\tlocal cf = workspace.CurrentCamera.CFrame\n\tlocal f = Util.flatUnit(cf.LookVector, Vector3.new(0, 0, -1))\n\tlocal r = Util.flatUnit(cf.RightVector, Vector3.new(1, 0, 0))\n\treturn r * v.X + f * v.Y\nend\n\n----------------------------------------------------------------------------------------------\n-- Actions (shared by CAS + touch)\n----------------------------------------------------------------------------------------------\nlocal function canControl(): boolean\n\treturn active and launched and mover ~= nil and not lockedNow\nend\n\nlocal function sendDash(kind: string?)\n\tif not kind or not mover then\n\t\treturn\n\tend\n\tlocal o = mover.override\n\tlocal dir = o and o.dir or mover.root.CFrame.LookVector\n\tIntentRemote:FireServer(\"Dash\", { dir = dir, air = kind == \"airdash\" })\n\tSound.Play(\"Dash\", { vary = 0.08 })\nend\n\nlocal function doAction(name: string, began: boolean)\n\tif not active or not mover then\n\t\treturn\n\tend\n\tif name == \"Jump\" then\n\t\tmover.jumpHeld = began\n\t\tif began and canControl() then\n\t\t\tlocal r = mover:Jump()\n\t\t\tif r == \"airdash\" then\n\t\t\t\tsendDash(r)\n\t\t\telseif r then\n\t\t\t\tSound.Play(\"Jump\", { vary = 0.1, volume = r == \"airjump\" and 0.35 or 0.3 })\n\t\t\tend\n\t\tend\n\telseif name == \"Dash\" then\n\t\tif began and canControl() then\n\t\t\tsendDash(mover:Dash())\n\t\tend\n\telseif name == \"Gun\" then\n\t\tif began then\n\t\t\tgunHeld = true\n\t\t\tIntentRemote:FireServer(\"GunDown\")\n\t\telseif gunHeld then\n\t\t\tgunHeld = false\n\t\t\tIntentRemote:FireServer(\"GunUp\")\n\t\tend\n\telseif name == \"Bomb\" then\n\t\tif began then\n\t\t\tIntentRemote:FireServer(\"Bomb\")\n\t\tend\n\telseif name == \"Pod\" then\n\t\tif began then\n\t\t\tIntentRemote:FireServer(\"Pod\")\n\t\tend\n\tend\nend\nBattle.DoAction = doAction\n\nlocal SINK = Enum.ContextActionResult.Sink\nlocal function began(state: Enum.UserInputState): boolean\n\treturn state == Enum.UserInputState.Begin\nend\nlocal function ended(state: Enum.UserInputState): boolean\n\treturn state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel\nend\n\nlocal function actionHandler(name: string)\n\treturn function(_, state, _input)\n\t\tif began(state) then\n\t\t\tdoAction(name, true)\n\t\telseif ended(state) then\n\t\t\tdoAction(name, false)\n\t\tend\n\t\treturn SINK\n\tend\nend\n\nlocal function onMove(_, state, input: InputObject)\n\tif input.KeyCode == Enum.KeyCode.Thumbstick1 then\n\t\tpadMove = ended(state) and Vector2.zero or Vector2.new(input.Position.X, input.Position.Y)\n\telse\n\t\tkeys[input.KeyCode] = not ended(state)\n\tend\n\treturn SINK\nend\n\nlocal function onLook(_, state, input: InputObject)\n\tpadLook = ended(state) and Vector2.zero or Vector2.new(input.Position.X, input.Position.Y)\n\treturn SINK\nend\n\nlocal BIND_PRIORITY = Enum.ContextActionPriority.High.Value + 100\nlocal function bindInputs()\n\tlocal K = Enum.KeyCode\n\tContextActionService:BindActionAtPriority(\"RC_Move\", onMove, false, BIND_PRIORITY, K.W, K.A, K.S, K.D, K.Up, K.Down, K.Left, K.Right, K.Thumbstick1)\n\tContextActionService:BindActionAtPriority(\"RC_Look\", onLook, false, BIND_PRIORITY, K.Thumbstick2)\n\tContextActionService:BindActionAtPriority(\"RC_Jump\", actionHandler(\"Jump\"), false, BIND_PRIORITY, K.Space, K.ButtonA)\n\tContextActionService:BindActionAtPriority(\"RC_Dash\", actionHandler(\"Dash\"), false, BIND_PRIORITY, K.LeftShift, K.RightShift, K.ButtonB, K.ButtonL1)\n\tContextActionService:BindActionAtPriority(\"RC_Gun\", actionHandler(\"Gun\"), false, BIND_PRIORITY, Enum.UserInputType.MouseButton1, K.J, K.ButtonR2)\n\tContextActionService:BindActionAtPriority(\"RC_Bomb\", actionHandler(\"Bomb\"), false, BIND_PRIORITY, Enum.UserInputType.MouseButton2, K.K, K.ButtonL2, K.ButtonX)\n\tContextActionService:BindActionAtPriority(\"RC_Pod\", actionHandler(\"Pod\"), false, BIND_PRIORITY, K.E, K.L, K.ButtonR1, K.ButtonY)\nend\n\nlocal function unbindInputs()\n\tfor _, n in ipairs({ \"RC_Move\", \"RC_Look\", \"RC_Jump\", \"RC_Dash\", \"RC_Gun\", \"RC_Bomb\", \"RC_Pod\" }) do\n\t\tContextActionService:UnbindAction(n)\n\tend\n\ttable.clear(keys)\n\tpadMove = Vector2.zero\n\tpadLook = Vector2.zero\n\tgunHeld = false\nend\n\n----------------------------------------------------------------------------------------------\n-- Server callbacks\n----------------------------------------------------------------------------------------------\nfunction Battle.OnLocalFire(data)\n\tif mover and data.slow and data.slowTime then\n\t\tmover:Slow(data.slow, data.slowTime)\n\tend\nend\n\nfunction Battle.OnKnock(vel: Vector3, up: number, dur: number)\n\tif mover then\n\t\tmover:Knockback(vel, up, dur)\n\tend\nend\n\nfunction Battle.OnTeleported()\n\tif mover then\n\t\tmover:ResetVelocity()\n\tend\nend\n\n----------------------------------------------------------------------------------------------\n-- Camera\n----------------------------------------------------------------------------------------------\nlocal function updateCamera(dt: number)\n\tlocal camera = workspace.CurrentCamera\n\tcamera.CameraType = Enum.CameraType.Scriptable\n\tcamera.FieldOfView = 50\n\tlocal pts = {}\n\tlocal intro = not launched and not ko\n\tlocal focusModel = nil\n\tif ko then\n\t\tlocal t = os.clock() - ko.t0\n\t\tif t < M.KOFreezeTime then\n\t\t\tfocusModel = ko.loser or ko.winner\n\t\telse\n\t\t\tfocusModel = ko.winner or ko.loser\n\t\tend\n\tend\n\tif focusModel and rootOf(focusModel) then\n\t\ttable.insert(pts, (rootOf(focusModel) :: BasePart).Position)\n\telseif intro and serverNow() < info.startTime + CUBE_OPEN then\n\t\tfor _, r in ipairs(info.roster) do\n\t\t\ttable.insert(pts, r.spawnPos)\n\t\tend\n\telse\n\t\tfor _, r in ipairs(info.roster) do\n\t\t\tlocal rr = rootOf(r.model)\n\t\t\tif rr and (isAlive(r.model) or r.model == model) then\n\t\t\t\ttable.insert(pts, rr.Position)\n\t\t\tend\n\t\tend\n\tend\n\tif #pts == 0 then\n\t\ttable.insert(pts, info.center)\n\tend\n\tlocal lo, hi = pts[1], pts[1]\n\tfor _, p in ipairs(pts) do\n\t\tlo = lo:Min(p)\n\t\thi = hi:Max(p)\n\tend\n\tlocal mid = (lo + hi) / 2\n\tlocal focusTarget = Vector3.new(mid.X, info.center.Y + 2, mid.Z)\n\tif not cam.focus then\n\t\tcam.focus = info.center\n\tend\n\tlocal nudgeTarget = padLook.Magnitude > 0.2 and padLook.X * rad(25) or 0\n\tcam.yawNudge += (nudgeTarget - cam.yawNudge) * (1 - math.exp(-dt * 4))\n\tlocal yaw = cam.yaw + cam.yawNudge\n\tlocal back = Vector3.new(math.sin(yaw), 0, math.cos(yaw))\n\tlocal pitch = PITCH - (focusModel and rad(6) or 0)\n\tlocal toCam = back * math.cos(pitch) + Vector3.yAxis * math.sin(pitch)\n\tlocal look = -toCam\n\tlocal right = look:Cross(Vector3.yAxis).Unit\n\tlocal up = right:Cross(look)\n\n\t-- Zoom-to-fit: smallest distance that keeps every robot (feet..head) inside the frustum,\n\t-- with extra room at the bottom for the HUD panels.\n\tlocal targetDist\n\tif focusModel then\n\t\ttargetDist = 34\n\telse\n\t\tlocal tanV = math.tan(rad(camera.FieldOfView) / 2)\n\t\tlocal vp = camera.ViewportSize\n\t\tlocal tanH = tanV * (vp.X / math.max(vp.Y, 1))\n\t\tlocal tUp, tDown, tSide = tanV * 0.78, tanV * 0.5, tanH * 0.8\n\t\ttargetDist = 0\n\t\tfor _, p in ipairs(pts) do\n\t\t\tfor _, h in ipairs({ -2.5, 5 }) do\n\t\t\t\tlocal r = Vector3.new(p.X, info.center.Y + h, p.Z) - focusTarget\n\t\t\t\tlocal depth = r:Dot(look)\n\t\t\t\tlocal y = r:Dot(up)\n\t\t\t\tlocal x = r:Dot(right)\n\t\t\t\tlocal ty = y >= 0 and tUp or tDown\n\t\t\t\ttargetDist = math.max(targetDist, math.abs(y) / ty - depth, math.abs(x) / tSide - depth)\n\t\t\tend\n\t\tend\n\t\ttargetDist = math.clamp(targetDist, 40, 115)\n\tend\n\tlocal kf = 1 - math.exp(-dt * (focusModel and 3 or 5))\n\tlocal kd = 1 - math.exp(-dt * (intro and 1.6 or (targetDist > cam.dist and 4 or 2)))\n\tcam.focus = (cam.focus :: Vector3):Lerp(focusTarget, kf)\n\tcam.dist += (targetDist - cam.dist) * kd\n\tlocal focus = cam.focus :: Vector3\n\tcamera.CFrame = CFrame.lookAt(focus + toCam * cam.dist, focus) * FX.ShakeCFrame()\nend\n\n----------------------------------------------------------------------------------------------\n-- Intro: cube drop-in + READY 3-2-1 LAUNCH!\n----------------------------------------------------------------------------------------------\nlocal function makeCube(r)\n\tlocal color = Config.TeamColors[r.team] or Color3.new(1, 1, 1)\n\tlocal p = Instance.new(\"Part\")\n\tp.Name = \"DropCube\"\n\tp.Anchored = true\n\tp.CanCollide = false\n\tp.CanQuery = false\n\tp.CanTouch = false\n\tp.CastShadow = true\n\tp.Size = Vector3.new(7, 7, 7)\n\tp.Material = Enum.Material.Metal\n\tp.Color = Color3.fromRGB(30, 34, 60)\n\tp.Parent = FX.Folder()\n\tlocal inner = Instance.new(\"Part\")\n\tinner.Name = \"Core\"\n\tinner.Anchored = true\n\tinner.CanCollide = false\n\tinner.CanQuery = false\n\tinner.CanTouch = false\n\tinner.Size = Vector3.new(7.3, 2, 7.3)\n\tinner.Material = Enum.Material.Neon\n\tinner.Color = color\n\tinner.Parent = p\n\tlocal box = Instance.new(\"SelectionBox\")\n\tbox.Adornee = p\n\tbox.Color3 = color\n\tbox.LineThickness = 0.12\n\tbox.SurfaceTransparency = 1\n\tbox.Parent = p\n\tlocal light = Instance.new(\"PointLight\")\n\tlight.Color = color\n\tlight.Range = 16\n\tlight.Brightness = 2\n\tlight.Parent = p\n\treturn { part = p, core = inner, color = color, spawnPos = r.spawnPos, spin = math.random() * math.pi * 2, opened = false }\nend\n\nlocal function updateCubes()\n\tif #cubes == 0 or not info then\n\t\treturn\n\tend\n\tlocal t = serverNow() - info.startTime\n\tfor _, c in ipairs(cubes) do\n\t\tif not c.opened then\n\t\t\tlocal a = math.clamp(t / CUBE_FALL, 0, 1)\n\t\t\tlocal y = CUBE_HEIGHT * (1 - a * a)\n\t\t\tlocal landed = a >= 1\n\t\t\tlocal squash = 0\n\t\t\tif landed then\n\t\t\t\tlocal s = t - CUBE_FALL\n\t\t\t\tsquash = math.max(0, 0.6 - s * 2) * math.sin(s * 30) * 0.4\n\t\t\t\tif not c.landed then\n\t\t\t\t\tc.landed = true\n\t\t\t\t\tFX.Shake(0.9, 0.3)\n\t\t\t\t\tFX.Burst(c.spawnPos + Vector3.new(0, 0.5, 0), c.color, 18, 22, 1.2, 0.5)\n\t\t\t\t\tSound.Play(\"Explosion\", { volume = 0.25, pitch = 1.6 })\n\t\t\t\tend\n\t\t\tend\n\t\t\tlocal spin = c.spin + (1 - a) * 4\n\t\t\tlocal cf = CFrame.new(c.spawnPos + Vector3.new(0, 3.5 + y + squash, 0)) * CFrame.Angles(0, spin, 0)\n\t\t\tc.part.CFrame = cf\n\t\t\tc.core.CFrame = cf\n\t\tend\n\tend\nend\n\nlocal function openCubes()\n\tfor _, c in ipairs(cubes) do\n\t\tif not c.opened then\n\t\t\tc.opened = true\n\t\t\tFX.Flash(c.spawnPos + Vector3.new(0, 3.5, 0), c.color, 14, 0.35)\n\t\t\tFX.Burst(c.spawnPos + Vector3.new(0, 3.5, 0), c.color, 30, 40, 1.6, 0.6)\n\t\t\tc.part:Destroy()\n\t\tend\n\tend\n\ttable.clear(cubes)\n\tSound.Play(\"Explosion\", { volume = 0.35, pitch = 1.3 })\nend\n\nlocal function schedule(at: number, fn: () -> ())\n\tlocal delay = at - serverNow()\n\tif delay < -0.15 then\n\t\treturn\n\tend\n\ttable.insert(timers, task.delay(math.max(0, delay), fn))\nend\n\nlocal function cancelTimers()\n\tfor _, th in ipairs(timers) do\n\t\tpcall(task.cancel, th)\n\tend\n\ttable.clear(timers)\nend\n\n----------------------------------------------------------------------------------------------\n-- Frame step\n----------------------------------------------------------------------------------------------\nlocal function step(dt: number)\n\tif not active or not info then\n\t\treturn\n\tend\n\tupdateCubes()\n\tif model and model.Parent and mover then\n\t\tlocal st = model:GetAttribute(\"State\")\n\t\tlocal locked = model:GetAttribute(\"Locked\") == true or st == \"Down\" or st == \"KO\" or st == \"Intro\" or not launched\n\t\tif locked ~= lockedNow then\n\t\t\tlockedNow = locked\n\t\t\tmover:SetLocked(locked)\n\t\tend\n\t\tmover.moveInput = locked and Vector3.zero or moveVector()\n\t\tlocal gun = loadout.Gun\n\t\tmover.chargeMul = (gun.Type == \"Charge\" and gunHeld and not locked) and gun.ChargeMoveSlow or 1\n\t\tif not mover.root.Anchored then\n\t\t\tmover:Step(dt)\n\t\tend\n\t\tState.dashReady01 = math.clamp(1 - (mover.dashReadyAt - os.clock()) / loadout.Legs.DashCooldown, 0, 1)\n\tend\n\tlocal target = pickTarget()\n\tState.target = target\n\tHUD.SetTarget((launched and not ko) and target or nil)\n\tHUD.Update(dt, endTime, frozenTimer)\n\tupdateCamera(dt)\nend\n\n----------------------------------------------------------------------------------------------\n-- Lifecycle\n----------------------------------------------------------------------------------------------\nfunction Battle.Start(data)\n\tBattle.Stop()\n\tinfo = data\n\tState.match = data\n\tState.mode = \"Battle\"\n\tactive = true\n\tlaunched = false\n\tko = nil\n\tendTime = nil\n\tfrozenTimer = data.duration\n\tlockedNow = true\n\tmodel = data.localModel\n\tState.localModel = model\n\tcam.focus = nil\n\tcam.dist = 135\n\tcam.yawNudge = 0\n\tlocal mySpawn = data.center + Vector3.new(0, 0, 40)\n\tfor _, r in ipairs(data.roster) do\n\t\tif r.model == model then\n\t\t\tmySpawn = r.spawnPos\n\t\tend\n\tend\n\tlocal back = Util.flatUnit(mySpawn - data.center, Vector3.new(0, 0, 1))\n\tcam.yaw = math.atan2(back.X, back.Z)\n\n\tlocal geo = nil\n\tfor _, r in ipairs(data.roster) do\n\t\tif r.model and r.model.Parent then\n\t\t\tlocal arena = r.model:FindFirstAncestorWhichIsA(\"Model\")\n\t\t\twhile arena and arena.Parent and arena.Parent.Name ~= \"Arenas\" do\n\t\t\t\tarena = arena:FindFirstAncestorWhichIsA(\"Model\")\n\t\t\tend\n\t\t\tgeo = arena and arena:FindFirstChild(\"Geometry\")\n\t\t\tbreak\n\t\tend\n\tend\n\tRobotAnim.SetGeometry(geo)\n\n\tlocal revealIn = (data.startTime + CUBE_OPEN) - serverNow()\n\tfor _, r in ipairs(data.roster) do\n\t\tif r.model then\n\t\t\tRobotAnim.Register(r.model, revealIn > 0 and (os.clock() + revealIn) or nil)\n\t\tend\n\t\tif revealIn > 0 then\n\t\t\ttable.insert(cubes, makeCube(r))\n\t\tend\n\tend\n\tupdateCubes()\n\n\tif model then\n\t\tlocal robotId = model:GetAttribute(\"RobotId\") or State.robotId\n\t\tloadout = Config.GetLoadout(robotId)\n\t\tmover = Mover.new(model, loadout.Legs)\n\t\tmover.getFacePos = function()\n\t\t\tlocal t = State.target\n\t\t\tlocal rr = rootOf(t)\n\t\t\treturn rr and rr.Position or nil\n\t\tend\n\t\tmover:SetLocked(true)\n\tend\n\n\tHUD.Start(data)\n\tHUD.SetChipsVisible(not Touch.Enabled())\n\tTouch.SetActive(true)\n\tbindInputs()\n\tRunService:BindToRenderStep(\"RoboClashBattle\", Enum.RenderPriority.Camera.Value + 1, step)\n\n\tlocal st = data.startTime\n\tschedule(st + CUBE_OPEN, openCubes)\n\tschedule(st + 2.0, function()\n\t\tHUD.Announce(\"READY\", { size = 120, hold = 0.65, color = Color3.fromRGB(120, 235, 255) })\n\tend)\n\tlocal counts = { \"3\", \"2\", \"1\" }\n\tfor i, txt in ipairs(counts) do\n\t\tschedule(st + 2.8 + (i - 1) * 0.53, function()\n\t\t\tHUD.Announce(txt, { size = 150, hold = 0.4 })\n\t\t\tSound.Play(\"Countdown\", { pitch = 1 + (i - 1) * 0.04 })\n\t\tend)\n\tend\n\tschedule(data.launchTime, function()\n\t\tif not ko then\n\t\t\tHUD.Announce(\"LAUNCH!\", { size = 150, hold = 0.7, slam = true, color = Color3.fromRGB(255, 220, 80) })\n\t\t\tSound.Play(\"Launch\")\n\t\t\tFX.Shake(0.6, 0.25)\n\t\tend\n\tend)\nend\n\nfunction Battle.OnLaunch(data)\n\tif not active then\n\t\treturn\n\tend\n\tlaunched = true\n\tendTime = data.endTime\n\tfrozenTimer = nil\n\topenCubes()\n\tfor _, r in ipairs(info.roster) do\n\t\tif r.model then\n\t\t\tRobotAnim.Reveal(r.model)\n\t\tend\n\tend\nend\n\nfunction Battle.OnKO(data)\n\tif not active then\n\t\treturn\n\tend\n\tlocal remain = endTime and math.max(0, endTime - serverNow()) or info.duration\n\tfrozenTimer = remain\n\tlaunched = false\n\tlockedNow = true\n\tif mover then\n\t\tmover:SetLocked(true)\n\tend\n\tif gunHeld then\n\t\tgunHeld = false\n\tend\n\tlocal loser = nil\n\tfor _, r in ipairs(info.roster) do\n\t\tif r.model and r.model ~= data.winner then\n\t\t\tif not loser or r.model:GetAttribute(\"State\") == \"KO\" then\n\t\t\t\tloser = r.model\n\t\t\tend\n\t\tend\n\tend\n\tko = { t0 = os.clock(), winner = data.winner, loser = (not data.draw) and loser or nil, data = data }\n\tif data.draw then\n\t\tHUD.Announce(data.reason == \"TIME\" and \"TIME UP!\" or \"DRAW\", { size = 130, hold = 1.4, slam = true })\n\t\ttask.delay(1.5, function()\n\t\t\tif ko and active then\n\t\t\t\tHUD.Announce(\"DRAW\", { size = 140, hold = 1.6, color = Color3.fromRGB(200, 200, 255) })\n\t\t\tend\n\t\tend)\n\telseif data.reason == \"TIME\" then\n\t\tHUD.Announce(\"TIME UP!\", { size = 130, hold = 1.2, slam = true, color = Color3.fromRGB(255, 220, 80) })\n\telseif data.reason == \"LEFT\" then\n\t\tHUD.Announce(\"OPPONENT LEFT\", { size = 90, hold = 2.2, slam = true, color = Color3.fromRGB(200, 220, 255) })\n\telse\n\t\tHUD.Announce(\"K.O.!\", { size = 170, hold = 1.3, slam = true, color = Color3.fromRGB(255, 70, 110) })\n\t\tFX.Shake(2.2, 0.6)\n\tend\n\tSound.Play(\"KO\")\n\tif data.perfect then\n\t\ttask.delay(1.6, function()\n\t\t\tif ko and active then\n\t\t\t\tHUD.Announce(\"PERFECT!\", { size = 140, hold = 2, slam = true, color = Color3.fromRGB(255, 215, 70) })\n\t\t\tend\n\t\tend)\n\telseif not data.draw and data.winner then\n\t\ttask.delay(1.6, function()\n\t\t\tif ko and active then\n\t\t\t\tlocal isMe = data.winner == model\n\t\t\t\tHUD.Announce(isMe and \"YOU WIN!\" or \"YOU LOSE\", {\n\t\t\t\t\tsize = 120,\n\t\t\t\t\thold = 2,\n\t\t\t\t\tcolor = isMe and Color3.fromRGB(255, 215, 70) or Color3.fromRGB(150, 170, 215),\n\t\t\t\t})\n\t\t\tend\n\t\tend)\n\tend\nend\n\nfunction Battle.Stop()\n\tif not active then\n\t\treturn\n\tend\n\tactive = false\n\tlaunched = false\n\tcancelTimers()\n\tRunService:UnbindFromRenderStep(\"RoboClashBattle\")\n\tunbindInputs()\n\tTouch.SetActive(false)\n\tfor _, c in ipairs(cubes) do\n\t\tc.part:Destroy()\n\tend\n\ttable.clear(cubes)\n\tHUD.Stop()\n\tFX.ClearAll()\n\tRobotAnim.Clear()\n\tmover = nil\n\tmodel = nil\n\tinfo = nil\n\tko = nil\n\tState.localModel = nil\n\tState.match = nil\n\tState.target = nil\nend\n\nfunction Battle.IsActive(): boolean\n\treturn active\nend\n\nreturn Battle\n","message":"The file /Users/chase-mini/src/rca-work/src/StarterPlayer/StarterPlayerScripts/RoboClashClient/Battle.luau has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"toolu_01G3ixTezETvh6wtMNa6gK5Z","startedAtMs":"1791075274375","completedAtMs":"1791075275628"},"model_call_id":"9f87d2a3-a097-4b92-978f-ec64b826b4ce-2-66a3","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791075275633}
