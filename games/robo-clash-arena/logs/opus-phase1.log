{"type":"tool_call","subtype":"started","call_id":"toolu_01Fiwmi4Lp4RvPa8ME2pVoFd","tool_call":{"editToolCall":{"args":{"path":"/Users/chase-mini/src/rca-work/src/ServerScriptService/RoboClash/MatchService.luau","streamContent":"\tcloseGroup(s.rematch, player, \"Opponent left\")\n\tif s.match then\n\t\tMatchService.DropCombatants(s.match, function(c)\n\t\t\treturn c.participant.player == player\n\t\tend)\n\tend\n\tMatchService.sessions[player] = nil\nend\n\n-- Removes the matching combatants from a live match (disconnect / forfeit); the last team standing\n-- wins by \"LEFT\", and a match with no humans left is torn down.\nfunction MatchService.DropCombatants(match, predicate: (any) -> boolean)\n\tif match.state == \"Ended\" then\n\t\treturn\n\tend\n\tfor _, c in ipairs(match.combatants) do\n\t\tif predicate(c) then\n\t\t\tc.participant.left = true\n\t\t\tif match.state == \"Intro\" or match.state == \"Fight\" then\n\t\t\t\tc.alive = false\n\t\t\t\tif c.model then\n\t\t\t\t\tc.model:Destroy()\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\tif match.state == \"Intro\" or match.state == \"Fight\" then\n\t\tlocal alive = aliveTeams(match)\n\t\tif #alive <= 1 then\n\t\t\tif match.state == \"Intro\" then\n\t\t\t\tmatch.state = \"Fight\"\n\t\t\tend\n\t\t\tmatch:Finish(\"LEFT\", alive[1])\n\t\tend\n\tend\n\tif #match:Humans() == 0 and match.state ~= \"Ended\" then\n\t\tmatch.state = \"Ended\"\n\t\tcleanup(match)\n\tend\nend"}},"hookAdditionalContexts":[],"toolCallId":"toolu_01Fiwmi4Lp4RvPa8ME2pVoFd","startedAtMs":"1791076369262"},"model_call_id":"9f87d2a3-a097-4b92-978f-ec64b826b4ce-109-7mdo","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791076374070}
{"type":"tool_call","subtype":"completed","call_id":"toolu_01Fiwmi4Lp4RvPa8ME2pVoFd","tool_call":{"editToolCall":{"args":{"path":"/Users/chase-mini/src/rca-work/src/ServerScriptService/RoboClash/MatchService.luau","streamContent":"\tcloseGroup(s.rematch, player, \"Opponent left\")\n\tif s.match then\n\t\tMatchService.DropCombatants(s.match, function(c)\n\t\t\treturn c.participant.player == player\n\t\tend)\n\tend\n\tMatchService.sessions[player] = nil\nend\n\n-- Removes the matching combatants from a live match (disconnect / forfeit); the last team standing\n-- wins by \"LEFT\", and a match with no humans left is torn down.\nfunction MatchService.DropCombatants(match, predicate: (any) -> boolean)\n\tif match.state == \"Ended\" then\n\t\treturn\n\tend\n\tfor _, c in ipairs(match.combatants) do\n\t\tif predicate(c) then\n\t\t\tc.participant.left = true\n\t\t\tif match.state == \"Intro\" or match.state == \"Fight\" then\n\t\t\t\tc.alive = false\n\t\t\t\tif c.model then\n\t\t\t\t\tc.model:Destroy()\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\tif match.state == \"Intro\" or match.state == \"Fight\" then\n\t\tlocal alive = aliveTeams(match)\n\t\tif #alive <= 1 then\n\t\t\tif match.state == \"Intro\" then\n\t\t\t\tmatch.state = \"Fight\"\n\t\t\tend\n\t\t\tmatch:Finish(\"LEFT\", alive[1])\n\t\tend\n\tend\n\tif #match:Humans() == 0 and match.state ~= \"Ended\" then\n\t\tmatch.state = \"Ended\"\n\t\tcleanup(match)\n\tend\nend"},"result":{"success":{"path":"/Users/chase-mini/src/rca-work/src/ServerScriptService/RoboClash/MatchService.luau","linesAdded":32,"linesRemoved":23,"diffString":"--- a//Users/chase-mini/src/rca-work/src/ServerScriptService/RoboClash/MatchService.luau\n+++ b//Users/chase-mini/src/rca-work/src/ServerScriptService/RoboClash/MatchService.luau\n@@ -488,35 +488,44 @@\n \t\treturn\n \tend\n \tcloseGroup(s.rematch, player, \"Opponent left\")\n-\tlocal match = s.match\n-\tif match and match.state ~= \"Ended\" then\n-\t\tfor _, c in ipairs(match.combatants) do\n-\t\t\tif c.participant.player == player then\n-\t\t\t\tc.participant.left = true\n-\t\t\t\tif match.state == \"Intro\" or match.state == \"Fight\" then\n-\t\t\t\t\tc.alive = false\n-\t\t\t\t\tif c.model then\n-\t\t\t\t\t\tc.model:Destroy()\n-\t\t\t\t\tend\n+\tif s.match then\n+\t\tMatchService.DropCombatants(s.match, function(c)\n+\t\t\treturn c.participant.player == player\n+\t\tend)\n+\tend\n+\tMatchService.sessions[player] = nil\n+end\n+\n+-- Removes the matching combatants from a live match (disconnect / forfeit); the last team standing\n+-- wins by \"LEFT\", and a match with no humans left is torn down.\n+function MatchService.DropCombatants(match, predicate: (any) -> boolean)\n+\tif match.state == \"Ended\" then\n+\t\treturn\n+\tend\n+\tfor _, c in ipairs(match.combatants) do\n+\t\tif predicate(c) then\n+\t\t\tc.participant.left = true\n+\t\t\tif match.state == \"Intro\" or match.state == \"Fight\" then\n+\t\t\t\tc.alive = false\n+\t\t\t\tif c.model then\n+\t\t\t\t\tc.model:Destroy()\n \t\t\t\tend\n \t\t\tend\n \t\tend\n-\t\tif match.state == \"Intro\" or match.state == \"Fight\" then\n-\t\t\tlocal alive = aliveTeams(match)\n-\t\t\tif #alive <= 1 then\n-\t\t\t\tif match.state == \"Intro\" then\n-\t\t\t\t\tmatch.state = \"Fight\"\n-\t\t\t\tend\n-\t\t\t\tmatch:Finish(\"LEFT\", alive[1])\n+\tend\n+\tif match.state == \"Intro\" or match.state == \"Fight\" then\n+\t\tlocal alive = aliveTeams(match)\n+\t\tif #alive <= 1 then\n+\t\t\tif match.state == \"Intro\" then\n+\t\t\t\tmatch.state = \"Fight\"\n \t\t\tend\n+\t\t\tmatch:Finish(\"LEFT\", alive[1])\n \t\tend\n-\t\t-- No humans left at all: tear down immediately.\n-\t\tif #match:Humans() == 0 and match.state ~= \"Ended\" then\n-\t\t\tmatch.state = \"Ended\"\n-\t\t\tcleanup(match)\n-\t\tend\n \tend\n-\tMatchService.sessions[player] = nil\n+\tif #match:Humans() == 0 and match.state ~= \"Ended\" then\n+\t\tmatch.state = \"Ended\"\n+\t\tcleanup(match)\n+\tend\n end\n \n function MatchService.Step(dt: number)","beforeFullFileContent":"-- Match lifecycle. A match clones the arena template into its own slot (offset in Workspace),\n-- spawns N participants (players or bots), runs intro -> fight -> KO/time/leave -> results,\n-- then cleans up and offers a rematch. Nothing here assumes exactly 2 participants.\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal ServerStorage = game:GetService(\"ServerStorage\")\n\nlocal RC = ReplicatedStorage:WaitForChild(\"RoboClash\")\nlocal Config = require(RC.Config)\nlocal Combat = require(script.Parent.CombatService)\nlocal RobotSpawner = require(script.Parent.RobotSpawner)\nlocal BotAI = require(script.Parent.BotAI)\n\nlocal M = Config.Match\nlocal Remotes = {\n\tMatch = RC.Remotes.Match,\n\tFX = RC.Remotes.FX,\n}\n\nlocal MatchService = {}\nMatchService.matches = {}\nMatchService.sessions = {}\n\nlocal arenaTemplate = ServerStorage:WaitForChild(\"RoboClash\"):WaitForChild(\"ArenaTemplate\")\nlocal arenasFolder = workspace:FindFirstChild(\"Arenas\")\nif not arenasFolder then\n\tarenasFolder = Instance.new(\"Folder\")\n\tarenasFolder.Name = \"Arenas\"\n\tarenasFolder.Parent = workspace\nend\n\nlocal slots = {}\nlocal nextMatchId = 0\nlocal now = Combat.now\n\n----------------------------------------------------------------------------------------------\n-- Sessions\n----------------------------------------------------------------------------------------------\nfunction MatchService.GetSession(player: Player)\n\tlocal s = MatchService.sessions[player]\n\tif not s then\n\t\ts = { player = player, robotId = Config.Robots[1].Id, status = \"Menu\", match = nil, combatant = nil, rematch = nil }\n\t\tMatchService.sessions[player] = s\n\tend\n\treturn s\nend\n\nlocal function send(player: Player, ...)\n\tif player.Parent then\n\t\tRemotes.Match:FireClient(player, ...)\n\tend\nend\nMatchService.Send = send\n\n----------------------------------------------------------------------------------------------\n-- Match object\n----------------------------------------------------------------------------------------------\nlocal Match = {}\nMatch.__index = Match\n\nfunction Match:Humans()\n\tlocal list = {}\n\tfor _, p in ipairs(self.participants) do\n\t\tif p.kind == \"Player\" and not p.left and p.player.Parent then\n\t\t\ttable.insert(list, p.player)\n\t\tend\n\tend\n\treturn list\nend\n\nfunction Match:FireAll(remoteName: string, ...)\n\tlocal remote = Remotes[remoteName]\n\tfor _, player in ipairs(self:Humans()) do\n\t\tlocal s = MatchService.sessions[player]\n\t\tif s and s.match == self then\n\t\t\tremote:FireClient(player, ...)\n\t\tend\n\tend\nend\n\nlocal function aliveTeams(match)\n\tlocal teams, list = {}, {}\n\tfor _, c in ipairs(match.combatants) do\n\t\tif c.alive and not teams[c.team] then\n\t\t\tteams[c.team] = true\n\t\t\ttable.insert(list, c)\n\t\tend\n\tend\n\treturn list\nend\n\nfunction Match:OnKO(victim, _attacker)\n\tif self.state ~= \"Fight\" then\n\t\treturn\n\tend\n\tvictim.alive = false\n\tvictim.model:SetAttribute(\"State\", \"KO\")\n\tlocal alive = aliveTeams(self)\n\tif #alive <= 1 then\n\t\tself:Finish(\"KO\", alive[1])\n\tend\nend\n\nfunction Match:Finish(reason: string, winner)\n\tif self.state == \"KO\" or self.state == \"Ended\" then\n\t\treturn\n\tend\n\tself.state = \"KO\"\n\tself.finishedAt = now()\n\tself.reason = reason\n\tself.winner = winner\n\tfor _, c in ipairs(self.combatants) do\n\t\tc.gunHeld = false\n\t\tc.chargeStart = nil\n\t\tc.burstLeft = 0\n\t\tif c.model.Parent then\n\t\t\tc.model:SetAttribute(\"Locked\", true)\n\t\t\tif c.root and c.root.Parent then\n\t\t\t\tc.root.Anchored = true\n\t\t\tend\n\t\tend\n\t\tif c.mover then\n\t\t\tc.mover:SetLocked(true)\n\t\tend\n\tend\n\tCombat.ClearProjectiles(self)\n\tlocal perfect = winner ~= nil and winner.stats.damageTaken == 0\n\tself.perfect = perfect\n\tself:FireAll(\"Match\", \"KO\", {\n\t\twinner = winner and winner.model,\n\t\treason = reason,\n\t\tperfect = perfect,\n\t\tdraw = winner == nil,\n\t})\n\ttask.delay(M.KOFreezeTime, function()\n\t\tfor _, c in ipairs(self.combatants) do\n\t\t\tif c.model.Parent then\n\t\t\t\tc.model:SetAttribute(\"Pose\", c == winner and \"Victory\" or \"Defeat\")\n\t\t\tend\n\t\tend\n\tend)\n\ttask.delay(M.ResultsDelay, function()\n\t\tMatchService.ShowResults(self)\n\tend)\nend\n\nfunction Match:Launch()\n\tif self.state ~= \"Intro\" then\n\t\treturn\n\tend\n\tself.state = \"Fight\"\n\tself.launchedAt = now()\n\tself.endTime = self.launchedAt + M.Duration\n\tfor _, c in ipairs(self.combatants) do\n\t\tif c.alive and c.model.Parent then\n\t\t\tRobotSpawner.Release(c.participant, c.model)\n\t\t\tCombat.SetState(c, \"Normal\", 0)\n\t\t\tc.model:SetAttribute(\"Locked\", false)\n\t\t\tif c.mover then\n\t\t\t\tc.mover:SetLocked(false)\n\t\t\tend\n\t\tend\n\tend\n\tself:FireAll(\"Match\", \"Launch\", { endTime = self.endTime })\nend\n\nfunction Match:Step(dt: number)\n\tif self.state == \"Ended\" then\n\t\treturn\n\tend\n\tCombat.Step(self, dt)\n\tfor _, c in ipairs(self.combatants) do\n\t\tif c.ai then\n\t\t\tBotAI.Step(self, c, dt)\n\t\tend\n\tend\n\tif self.state == \"Fight\" and now() >= self.endTime then\n\t\t-- Time up: highest HP% wins.\n\t\tlocal best, bestPct, tie = nil, -1, false\n\t\tfor _, c in ipairs(self.combatants) do\n\t\t\tif c.alive then\n\t\t\t\tlocal pct = c.hp / c.maxHp\n\t\t\t\tif pct > bestPct + 1e-6 then\n\t\t\t\t\tbest, bestPct, tie = c, pct, false\n\t\t\t\telseif math.abs(pct - bestPct) <= 1e-6 then\n\t\t\t\t\ttie = true\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\tself:Finish(\"TIME\", (not tie) and best or nil)\n\tend\nend\n\n----------------------------------------------------------------------------------------------\n-- Creation\n----------------------------------------------------------------------------------------------\nlocal function allocSlot(): number\n\tlocal i = 1\n\twhile slots[i] do\n\t\ti += 1\n\tend\n\tslots[i] = true\n\treturn i\nend\n\n-- specs: list of { kind = \"Player\", player = Player } | { kind = \"Bot\", robotId = string }\nfunction MatchService.Create(specs, mode: string)\n\tnextMatchId += 1\n\tlocal slot = allocSlot()\n\tlocal origin = CFrame.new(M.ArenaBaseX + (slot - 1) * M.ArenaSpacing, M.ArenaHeight, 0)\n\tlocal arena = arenaTemplate:Clone()\n\tarena.Name = \"Arena_\" .. nextMatchId\n\tarena:PivotTo(origin)\n\tarena.Parent = arenasFolder\n\tlocal robots = Instance.new(\"Folder\")\n\trobots.Name = \"Robots\"\n\trobots.Parent = arena\n\n\tlocal rayParams = RaycastParams.new()\n\trayParams.FilterType = Enum.RaycastFilterType.Include\n\trayParams.FilterDescendantsInstances = { arena:WaitForChild(\"Geometry\") }\n\n\tlocal match = setmetatable({\n\t\tid = nextMatchId,\n\t\tslot = slot,\n\t\torigin = origin,\n\t\tarena = arena,\n\t\tmode = mode,\n\t\tfloorY = origin.Y,\n\t\trayParams = rayParams,\n\t\tparticipants = {},\n\t\tcombatants = {},\n\t\tbyModel = {},\n\t\tprojectiles = {},\n\t\tblasts = {},\n\t\tnextProjId = 0,\n\t\tstate = \"Intro\",\n\t\tremotes = Remotes,\n\t\tspecs = specs,\n\t}, Match)\n\tMatchService.matches[match.id] = match\n\n\tfor i, spec in ipairs(specs) do\n\t\tlocal p = {\n\t\t\tkind = spec.kind,\n\t\t\tplayer = spec.player,\n\t\t\tindex = i,\n\t\t\tteam = i,\n\t\t\ttag = \"P\" .. i,\n\t\t}\n\t\tif spec.kind == \"Player\" then\n\t\t\tlocal s = MatchService.GetSession(spec.player)\n\t\t\tp.robotId = s.robotId\n\t\t\tp.name = spec.player.DisplayName\n\t\telse\n\t\t\tp.robotId = spec.robotId\n\t\t\tp.name = spec.name or (\"CPU \" .. (Config.RobotById[spec.robotId] or Config.Robots[1]).DisplayName)\n\t\tend\n\t\ttable.insert(match.participants, p)\n\tend\n\n\tlocal spawns = arena:WaitForChild(\"Spawns\")\n\tfor i, p in ipairs(match.participants) do\n\t\tlocal sp = spawns:FindFirstChild(\"Spawn\" .. i) :: BasePart\n\t\tlocal pos = Vector3.new(sp.Position.X, match.floorY, sp.Position.Z)\n\t\tlocal center = Vector3.new(origin.X, match.floorY, origin.Z)\n\t\tlocal spawnCF = CFrame.lookAt(pos, center)\n\t\tlocal model, info = RobotSpawner.Spawn(p, spawnCF, robots)\n\t\tlocal c = Combat.NewCombatant(match, p, model, info, spawnCF)\n\t\ttable.insert(match.combatants, c)\n\t\tmatch.byModel[model] = c\n\t\tif p.kind == \"Bot\" then\n\t\t\tBotAI.Attach(match, c)\n\t\telse\n\t\t\tlocal s = MatchService.GetSession(p.player)\n\t\t\ts.status = \"Match\"\n\t\t\ts.match = match\n\t\t\ts.combatant = c\n\t\t\ts.rematch = nil\n\t\tend\n\tend\n\n\tmatch.startTime = now()\n\tmatch.launchTime = match.startTime + M.IntroTime\n\tlocal roster = {}\n\tfor _, c in ipairs(match.combatants) do\n\t\ttable.insert(roster, {\n\t\t\tmodel = c.model,\n\t\t\ttag = c.tag,\n\t\t\tname = c.participant.name,\n\t\t\trobotId = c.participant.robotId,\n\t\t\tteam = c.team,\n\t\t\tisBot = c.participant.kind == \"Bot\",\n\t\t\tspawnPos = c.spawnCF.Position,\n\t\t})\n\tend\n\tfor _, c in ipairs(match.combatants) do\n\t\tif c.participant.kind == \"Player\" then\n\t\t\tsend(c.participant.player, \"Start\", {\n\t\t\t\tmatchId = match.id,\n\t\t\t\tmode = mode,\n\t\t\t\tcenter = Vector3.new(origin.X, match.floorY, origin.Z),\n\t\t\t\thalf = Config.Arena.Half,\n\t\t\t\tlocalModel = c.model,\n\t\t\t\troster = roster,\n\t\t\t\tstartTime = match.startTime,\n\t\t\t\tlaunchTime = match.launchTime,\n\t\t\t\tduration = M.Duration,\n\t\t\t})\n\t\tend\n\tend\n\ttask.delay(M.IntroTime, function()\n\t\tmatch:Launch()\n\tend)\n\treturn match\nend\n\n----------------------------------------------------------------------------------------------\n-- Results, cleanup, rematch\n----------------------------------------------------------------------------------------------\nlocal function statsOf(c)\n\treturn {\n\t\tname = c.participant.name,\n\t\ttag = c.tag,\n\t\trobotId = c.participant.robotId,\n\t\thp = c.hp,\n\t\tmaxHp = c.maxHp,\n\t\tdamageDealt = c.stats.damageDealt,\n\t\tdamageTaken = c.stats.damageTaken,\n\t\tdowns = c.stats.downs,\n\t\thits = c.stats.hits,\n\t\tisBot = c.participant.kind == \"Bot\",\n\t\tleft = c.participant.left == true,\n\t}\nend\n\nlocal function cleanup(match)\n\tfor _, c in ipairs(match.combatants) do\n\t\tBotAI.Detach(c)\n\t\tRobotSpawner.Despawn(c.participant, c.model)\n\tend\n\tif match.arena then\n\t\tmatch.arena:Destroy()\n\tend\n\tslots[match.slot] = nil\n\tMatchService.matches[match.id] = nil\nend\n\nfunction MatchService.ShowResults(match)\n\tif match.state == \"Ended\" then\n\t\treturn\n\tend\n\tmatch.state = \"Ended\"\n\tlocal winner = match.winner\n\tlocal duration = (match.finishedAt or now()) - (match.launchedAt or match.startTime)\n\tlocal humans = {}\n\tfor _, c in ipairs(match.combatants) do\n\t\tlocal p = c.participant\n\t\tif p.kind == \"Player\" and not p.left and p.player.Parent then\n\t\t\tlocal s = MatchService.GetSession(p.player)\n\t\t\tif s.match == match then\n\t\t\t\tlocal others = {}\n\t\t\t\tfor _, o in ipairs(match.combatants) do\n\t\t\t\t\tif o ~= c then\n\t\t\t\t\t\ttable.insert(others, statsOf(o))\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tlocal outcome = winner == nil and \"DRAW\" or (winner == c and \"WIN\" or \"LOSE\")\n\t\t\t\tsend(p.player, \"Results\", {\n\t\t\t\t\toutcome = outcome,\n\t\t\t\t\treason = match.reason,\n\t\t\t\t\tperfect = match.perfect and winner == c,\n\t\t\t\t\tyou = statsOf(c),\n\t\t\t\t\tothers = others,\n\t\t\t\t\tduration = duration,\n\t\t\t\t\tmode = match.mode,\n\t\t\t\t})\n\t\t\t\ts.status = \"Results\"\n\t\t\t\ts.match = nil\n\t\t\t\ts.combatant = nil\n\t\t\t\ttable.insert(humans, p.player)\n\t\t\tend\n\t\tend\n\tend\n\tcleanup(match)\n\n\tif #humans > 0 then\n\t\tlocal specs = {}\n\t\tfor _, spec in ipairs(match.specs) do\n\t\t\tif spec.kind == \"Player\" then\n\t\t\t\ttable.insert(specs, { kind = \"Player\", player = spec.player })\n\t\t\telse\n\t\t\t\ttable.insert(specs, { kind = \"Bot\", robotId = spec.robotId, name = spec.name })\n\t\t\tend\n\t\tend\n\t\tlocal group = { mode = match.mode, specs = specs, humans = humans, votes = {}, closed = false }\n\t\t-- every original human must still be here for a rematch\n\t\tfor _, spec in ipairs(match.specs) do\n\t\t\tif spec.kind == \"Player\" and not table.find(humans, spec.player) then\n\t\t\t\tgroup.closed = true\n\t\t\tend\n\t\tend\n\t\tfor _, h in ipairs(humans) do\n\t\t\tMatchService.GetSession(h).rematch = group\n\t\tend\n\t\ttask.delay(M.RematchTimeout, function()\n\t\t\tif not group.closed then\n\t\t\t\tgroup.closed = true\n\t\t\t\tfor _, h in ipairs(group.humans) do\n\t\t\t\t\tlocal s = MatchService.sessions[h]\n\t\t\t\t\tif s and s.rematch == group then\n\t\t\t\t\t\ts.rematch = nil\n\t\t\t\t\t\tsend(h, \"Rematch\", { status = \"closed\", reason = \"Rematch timed out\" })\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend)\n\tend\nend\n\nlocal function closeGroup(group, leaver: Player?, reason: string)\n\tif not group or group.closed then\n\t\treturn\n\tend\n\tgroup.closed = true\n\tfor _, h in ipairs(group.humans) do\n\t\tlocal s = MatchService.sessions[h]\n\t\tif s and s.rematch == group then\n\t\t\ts.rematch = nil\n\t\t\tif h ~= leaver then\n\t\t\t\tsend(h, \"Rematch\", { status = \"closed\", reason = reason })\n\t\t\tend\n\t\tend\n\tend\nend\n\nfunction MatchService.RequestRematch(player: Player)\n\tlocal s = MatchService.GetSession(player)\n\tlocal group = s.rematch\n\tif s.status ~= \"Results\" or not group or group.closed then\n\t\tsend(player, \"Rematch\", { status = \"closed\", reason = \"Rematch unavailable\" })\n\t\treturn\n\tend\n\tgroup.votes[player] = true\n\tlocal count = 0\n\tfor _, h in ipairs(group.humans) do\n\t\tif group.votes[h] then\n\t\t\tcount += 1\n\t\tend\n\tend\n\tif count >= #group.humans then\n\t\tgroup.closed = true\n\t\tfor _, h in ipairs(group.humans) do\n\t\t\tMatchService.GetSession(h).rematch = nil\n\t\t\tsend(h, \"Rematch\", { status = \"starting\" })\n\t\tend\n\t\tMatchService.Create(group.specs, group.mode)\n\telse\n\t\tfor _, h in ipairs(group.humans) do\n\t\t\tsend(h, \"Rematch\", { status = \"waiting\", votes = count, needed = #group.humans })\n\t\tend\n\tend\nend\n\nfunction MatchService.LeaveResults(player: Player)\n\tlocal s = MatchService.GetSession(player)\n\tif s.status == \"Results\" then\n\t\ts.status = \"Menu\"\n\tend\n\tcloseGroup(s.rematch, player, \"Opponent left\")\n\ts.rematch = nil\nend\n\nfunction MatchService.StartBotMatch(player: Player)\n\tlocal s = MatchService.GetSession(player)\n\tif s.status ~= \"Menu\" and s.status ~= \"Results\" then\n\t\treturn\n\tend\n\tcloseGroup(s.rematch, player, \"Opponent left\")\n\tlocal robots = Config.Robots\n\tlocal botRobot = robots[math.random(1, #robots)].Id\n\tMatchService.Create({ { kind = \"Player\", player = player }, { kind = \"Bot\", robotId = botRobot } }, \"Bot\")\nend\n\nfunction MatchService.OnPlayerLeft(player: Player)\n\tlocal s = MatchService.sessions[player]\n\tif not s then\n\t\treturn\n\tend\n\tcloseGroup(s.rematch, player, \"Opponent left\")\n\tlocal match = s.match\n\tif match and match.state ~= \"Ended\" then\n\t\tfor _, c in ipairs(match.combatants) do\n\t\t\tif c.participant.player == player then\n\t\t\t\tc.participant.left = true\n\t\t\t\tif match.state == \"Intro\" or match.state == \"Fight\" then\n\t\t\t\t\tc.alive = false\n\t\t\t\t\tif c.model then\n\t\t\t\t\t\tc.model:Destroy()\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\tif match.state == \"Intro\" or match.state == \"Fight\" then\n\t\t\tlocal alive = aliveTeams(match)\n\t\t\tif #alive <= 1 then\n\t\t\t\tif match.state == \"Intro\" then\n\t\t\t\t\tmatch.state = \"Fight\"\n\t\t\t\tend\n\t\t\t\tmatch:Finish(\"LEFT\", alive[1])\n\t\t\tend\n\t\tend\n\t\t-- No humans left at all: tear down immediately.\n\t\tif #match:Humans() == 0 and match.state ~= \"Ended\" then\n\t\t\tmatch.state = \"Ended\"\n\t\t\tcleanup(match)\n\t\tend\n\tend\n\tMatchService.sessions[player] = nil\nend\n\nfunction MatchService.Step(dt: number)\n\tfor _, match in pairs(MatchService.matches) do\n\t\tlocal ok, err = pcall(match.Step, match, dt)\n\t\tif not ok then\n\t\t\twarn(\"[RoboClash] match step error: \" .. tostring(err))\n\t\tend\n\tend\nend\n\nfunction MatchService.CountActive(): number\n\tlocal n = 0\n\tfor _ in pairs(MatchService.matches) do\n\t\tn += 1\n\tend\n\treturn n\nend\n\nPlayers.PlayerRemoving:Connect(function(player)\n\tMatchService.OnPlayerLeft(player)\nend)\n\nreturn MatchService\n","afterFullFileContent":"-- Match lifecycle. A match clones the arena template into its own slot (offset in Workspace),\n-- spawns N participants (players or bots), runs intro -> fight -> KO/time/leave -> results,\n-- then cleans up and offers a rematch. Nothing here assumes exactly 2 participants.\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal ServerStorage = game:GetService(\"ServerStorage\")\n\nlocal RC = ReplicatedStorage:WaitForChild(\"RoboClash\")\nlocal Config = require(RC.Config)\nlocal Combat = require(script.Parent.CombatService)\nlocal RobotSpawner = require(script.Parent.RobotSpawner)\nlocal BotAI = require(script.Parent.BotAI)\n\nlocal M = Config.Match\nlocal Remotes = {\n\tMatch = RC.Remotes.Match,\n\tFX = RC.Remotes.FX,\n}\n\nlocal MatchService = {}\nMatchService.matches = {}\nMatchService.sessions = {}\n\nlocal arenaTemplate = ServerStorage:WaitForChild(\"RoboClash\"):WaitForChild(\"ArenaTemplate\")\nlocal arenasFolder = workspace:FindFirstChild(\"Arenas\")\nif not arenasFolder then\n\tarenasFolder = Instance.new(\"Folder\")\n\tarenasFolder.Name = \"Arenas\"\n\tarenasFolder.Parent = workspace\nend\n\nlocal slots = {}\nlocal nextMatchId = 0\nlocal now = Combat.now\n\n----------------------------------------------------------------------------------------------\n-- Sessions\n----------------------------------------------------------------------------------------------\nfunction MatchService.GetSession(player: Player)\n\tlocal s = MatchService.sessions[player]\n\tif not s then\n\t\ts = { player = player, robotId = Config.Robots[1].Id, status = \"Menu\", match = nil, combatant = nil, rematch = nil }\n\t\tMatchService.sessions[player] = s\n\tend\n\treturn s\nend\n\nlocal function send(player: Player, ...)\n\tif player.Parent then\n\t\tRemotes.Match:FireClient(player, ...)\n\tend\nend\nMatchService.Send = send\n\n----------------------------------------------------------------------------------------------\n-- Match object\n----------------------------------------------------------------------------------------------\nlocal Match = {}\nMatch.__index = Match\n\nfunction Match:Humans()\n\tlocal list = {}\n\tfor _, p in ipairs(self.participants) do\n\t\tif p.kind == \"Player\" and not p.left and p.player.Parent then\n\t\t\ttable.insert(list, p.player)\n\t\tend\n\tend\n\treturn list\nend\n\nfunction Match:FireAll(remoteName: string, ...)\n\tlocal remote = Remotes[remoteName]\n\tfor _, player in ipairs(self:Humans()) do\n\t\tlocal s = MatchService.sessions[player]\n\t\tif s and s.match == self then\n\t\t\tremote:FireClient(player, ...)\n\t\tend\n\tend\nend\n\nlocal function aliveTeams(match)\n\tlocal teams, list = {}, {}\n\tfor _, c in ipairs(match.combatants) do\n\t\tif c.alive and not teams[c.team] then\n\t\t\tteams[c.team] = true\n\t\t\ttable.insert(list, c)\n\t\tend\n\tend\n\treturn list\nend\n\nfunction Match:OnKO(victim, _attacker)\n\tif self.state ~= \"Fight\" then\n\t\treturn\n\tend\n\tvictim.alive = false\n\tvictim.model:SetAttribute(\"State\", \"KO\")\n\tlocal alive = aliveTeams(self)\n\tif #alive <= 1 then\n\t\tself:Finish(\"KO\", alive[1])\n\tend\nend\n\nfunction Match:Finish(reason: string, winner)\n\tif self.state == \"KO\" or self.state == \"Ended\" then\n\t\treturn\n\tend\n\tself.state = \"KO\"\n\tself.finishedAt = now()\n\tself.reason = reason\n\tself.winner = winner\n\tfor _, c in ipairs(self.combatants) do\n\t\tc.gunHeld = false\n\t\tc.chargeStart = nil\n\t\tc.burstLeft = 0\n\t\tif c.model.Parent then\n\t\t\tc.model:SetAttribute(\"Locked\", true)\n\t\t\tif c.root and c.root.Parent then\n\t\t\t\tc.root.Anchored = true\n\t\t\tend\n\t\tend\n\t\tif c.mover then\n\t\t\tc.mover:SetLocked(true)\n\t\tend\n\tend\n\tCombat.ClearProjectiles(self)\n\tlocal perfect = winner ~= nil and winner.stats.damageTaken == 0\n\tself.perfect = perfect\n\tself:FireAll(\"Match\", \"KO\", {\n\t\twinner = winner and winner.model,\n\t\treason = reason,\n\t\tperfect = perfect,\n\t\tdraw = winner == nil,\n\t})\n\ttask.delay(M.KOFreezeTime, function()\n\t\tfor _, c in ipairs(self.combatants) do\n\t\t\tif c.model.Parent then\n\t\t\t\tc.model:SetAttribute(\"Pose\", c == winner and \"Victory\" or \"Defeat\")\n\t\t\tend\n\t\tend\n\tend)\n\ttask.delay(M.ResultsDelay, function()\n\t\tMatchService.ShowResults(self)\n\tend)\nend\n\nfunction Match:Launch()\n\tif self.state ~= \"Intro\" then\n\t\treturn\n\tend\n\tself.state = \"Fight\"\n\tself.launchedAt = now()\n\tself.endTime = self.launchedAt + M.Duration\n\tfor _, c in ipairs(self.combatants) do\n\t\tif c.alive and c.model.Parent then\n\t\t\tRobotSpawner.Release(c.participant, c.model)\n\t\t\tCombat.SetState(c, \"Normal\", 0)\n\t\t\tc.model:SetAttribute(\"Locked\", false)\n\t\t\tif c.mover then\n\t\t\t\tc.mover:SetLocked(false)\n\t\t\tend\n\t\tend\n\tend\n\tself:FireAll(\"Match\", \"Launch\", { endTime = self.endTime })\nend\n\nfunction Match:Step(dt: number)\n\tif self.state == \"Ended\" then\n\t\treturn\n\tend\n\tCombat.Step(self, dt)\n\tfor _, c in ipairs(self.combatants) do\n\t\tif c.ai then\n\t\t\tBotAI.Step(self, c, dt)\n\t\tend\n\tend\n\tif self.state == \"Fight\" and now() >= self.endTime then\n\t\t-- Time up: highest HP% wins.\n\t\tlocal best, bestPct, tie = nil, -1, false\n\t\tfor _, c in ipairs(self.combatants) do\n\t\t\tif c.alive then\n\t\t\t\tlocal pct = c.hp / c.maxHp\n\t\t\t\tif pct > bestPct + 1e-6 then\n\t\t\t\t\tbest, bestPct, tie = c, pct, false\n\t\t\t\telseif math.abs(pct - bestPct) <= 1e-6 then\n\t\t\t\t\ttie = true\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\tself:Finish(\"TIME\", (not tie) and best or nil)\n\tend\nend\n\n----------------------------------------------------------------------------------------------\n-- Creation\n----------------------------------------------------------------------------------------------\nlocal function allocSlot(): number\n\tlocal i = 1\n\twhile slots[i] do\n\t\ti += 1\n\tend\n\tslots[i] = true\n\treturn i\nend\n\n-- specs: list of { kind = \"Player\", player = Player } | { kind = \"Bot\", robotId = string }\nfunction MatchService.Create(specs, mode: string)\n\tnextMatchId += 1\n\tlocal slot = allocSlot()\n\tlocal origin = CFrame.new(M.ArenaBaseX + (slot - 1) * M.ArenaSpacing, M.ArenaHeight, 0)\n\tlocal arena = arenaTemplate:Clone()\n\tarena.Name = \"Arena_\" .. nextMatchId\n\tarena:PivotTo(origin)\n\tarena.Parent = arenasFolder\n\tlocal robots = Instance.new(\"Folder\")\n\trobots.Name = \"Robots\"\n\trobots.Parent = arena\n\n\tlocal rayParams = RaycastParams.new()\n\trayParams.FilterType = Enum.RaycastFilterType.Include\n\trayParams.FilterDescendantsInstances = { arena:WaitForChild(\"Geometry\") }\n\n\tlocal match = setmetatable({\n\t\tid = nextMatchId,\n\t\tslot = slot,\n\t\torigin = origin,\n\t\tarena = arena,\n\t\tmode = mode,\n\t\tfloorY = origin.Y,\n\t\trayParams = rayParams,\n\t\tparticipants = {},\n\t\tcombatants = {},\n\t\tbyModel = {},\n\t\tprojectiles = {},\n\t\tblasts = {},\n\t\tnextProjId = 0,\n\t\tstate = \"Intro\",\n\t\tremotes = Remotes,\n\t\tspecs = specs,\n\t}, Match)\n\tMatchService.matches[match.id] = match\n\n\tfor i, spec in ipairs(specs) do\n\t\tlocal p = {\n\t\t\tkind = spec.kind,\n\t\t\tplayer = spec.player,\n\t\t\tindex = i,\n\t\t\tteam = i,\n\t\t\ttag = \"P\" .. i,\n\t\t}\n\t\tif spec.kind == \"Player\" then\n\t\t\tlocal s = MatchService.GetSession(spec.player)\n\t\t\tp.robotId = s.robotId\n\t\t\tp.name = spec.player.DisplayName\n\t\telse\n\t\t\tp.robotId = spec.robotId\n\t\t\tp.name = spec.name or (\"CPU \" .. (Config.RobotById[spec.robotId] or Config.Robots[1]).DisplayName)\n\t\tend\n\t\ttable.insert(match.participants, p)\n\tend\n\n\tlocal spawns = arena:WaitForChild(\"Spawns\")\n\tfor i, p in ipairs(match.participants) do\n\t\tlocal sp = spawns:FindFirstChild(\"Spawn\" .. i) :: BasePart\n\t\tlocal pos = Vector3.new(sp.Position.X, match.floorY, sp.Position.Z)\n\t\tlocal center = Vector3.new(origin.X, match.floorY, origin.Z)\n\t\tlocal spawnCF = CFrame.lookAt(pos, center)\n\t\tlocal model, info = RobotSpawner.Spawn(p, spawnCF, robots)\n\t\tlocal c = Combat.NewCombatant(match, p, model, info, spawnCF)\n\t\ttable.insert(match.combatants, c)\n\t\tmatch.byModel[model] = c\n\t\tif p.kind == \"Bot\" then\n\t\t\tBotAI.Attach(match, c)\n\t\telse\n\t\t\tlocal s = MatchService.GetSession(p.player)\n\t\t\ts.status = \"Match\"\n\t\t\ts.match = match\n\t\t\ts.combatant = c\n\t\t\ts.rematch = nil\n\t\tend\n\tend\n\n\tmatch.startTime = now()\n\tmatch.launchTime = match.startTime + M.IntroTime\n\tlocal roster = {}\n\tfor _, c in ipairs(match.combatants) do\n\t\ttable.insert(roster, {\n\t\t\tmodel = c.model,\n\t\t\ttag = c.tag,\n\t\t\tname = c.participant.name,\n\t\t\trobotId = c.participant.robotId,\n\t\t\tteam = c.team,\n\t\t\tisBot = c.participant.kind == \"Bot\",\n\t\t\tspawnPos = c.spawnCF.Position,\n\t\t})\n\tend\n\tfor _, c in ipairs(match.combatants) do\n\t\tif c.participant.kind == \"Player\" then\n\t\t\tsend(c.participant.player, \"Start\", {\n\t\t\t\tmatchId = match.id,\n\t\t\t\tmode = mode,\n\t\t\t\tcenter = Vector3.new(origin.X, match.floorY, origin.Z),\n\t\t\t\thalf = Config.Arena.Half,\n\t\t\t\tlocalModel = c.model,\n\t\t\t\troster = roster,\n\t\t\t\tstartTime = match.startTime,\n\t\t\t\tlaunchTime = match.launchTime,\n\t\t\t\tduration = M.Duration,\n\t\t\t})\n\t\tend\n\tend\n\ttask.delay(M.IntroTime, function()\n\t\tmatch:Launch()\n\tend)\n\treturn match\nend\n\n----------------------------------------------------------------------------------------------\n-- Results, cleanup, rematch\n----------------------------------------------------------------------------------------------\nlocal function statsOf(c)\n\treturn {\n\t\tname = c.participant.name,\n\t\ttag = c.tag,\n\t\trobotId = c.participant.robotId,\n\t\thp = c.hp,\n\t\tmaxHp = c.maxHp,\n\t\tdamageDealt = c.stats.damageDealt,\n\t\tdamageTaken = c.stats.damageTaken,\n\t\tdowns = c.stats.downs,\n\t\thits = c.stats.hits,\n\t\tisBot = c.participant.kind == \"Bot\",\n\t\tleft = c.participant.left == true,\n\t}\nend\n\nlocal function cleanup(match)\n\tfor _, c in ipairs(match.combatants) do\n\t\tBotAI.Detach(c)\n\t\tRobotSpawner.Despawn(c.participant, c.model)\n\tend\n\tif match.arena then\n\t\tmatch.arena:Destroy()\n\tend\n\tslots[match.slot] = nil\n\tMatchService.matches[match.id] = nil\nend\n\nfunction MatchService.ShowResults(match)\n\tif match.state == \"Ended\" then\n\t\treturn\n\tend\n\tmatch.state = \"Ended\"\n\tlocal winner = match.winner\n\tlocal duration = (match.finishedAt or now()) - (match.launchedAt or match.startTime)\n\tlocal humans = {}\n\tfor _, c in ipairs(match.combatants) do\n\t\tlocal p = c.participant\n\t\tif p.kind == \"Player\" and not p.left and p.player.Parent then\n\t\t\tlocal s = MatchService.GetSession(p.player)\n\t\t\tif s.match == match then\n\t\t\t\tlocal others = {}\n\t\t\t\tfor _, o in ipairs(match.combatants) do\n\t\t\t\t\tif o ~= c then\n\t\t\t\t\t\ttable.insert(others, statsOf(o))\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tlocal outcome = winner == nil and \"DRAW\" or (winner == c and \"WIN\" or \"LOSE\")\n\t\t\t\tsend(p.player, \"Results\", {\n\t\t\t\t\toutcome = outcome,\n\t\t\t\t\treason = match.reason,\n\t\t\t\t\tperfect = match.perfect and winner == c,\n\t\t\t\t\tyou = statsOf(c),\n\t\t\t\t\tothers = others,\n\t\t\t\t\tduration = duration,\n\t\t\t\t\tmode = match.mode,\n\t\t\t\t})\n\t\t\t\ts.status = \"Results\"\n\t\t\t\ts.match = nil\n\t\t\t\ts.combatant = nil\n\t\t\t\ttable.insert(humans, p.player)\n\t\t\tend\n\t\tend\n\tend\n\tcleanup(match)\n\n\tif #humans > 0 then\n\t\tlocal specs = {}\n\t\tfor _, spec in ipairs(match.specs) do\n\t\t\tif spec.kind == \"Player\" then\n\t\t\t\ttable.insert(specs, { kind = \"Player\", player = spec.player })\n\t\t\telse\n\t\t\t\ttable.insert(specs, { kind = \"Bot\", robotId = spec.robotId, name = spec.name })\n\t\t\tend\n\t\tend\n\t\tlocal group = { mode = match.mode, specs = specs, humans = humans, votes = {}, closed = false }\n\t\t-- every original human must still be here for a rematch\n\t\tfor _, spec in ipairs(match.specs) do\n\t\t\tif spec.kind == \"Player\" and not table.find(humans, spec.player) then\n\t\t\t\tgroup.closed = true\n\t\t\tend\n\t\tend\n\t\tfor _, h in ipairs(humans) do\n\t\t\tMatchService.GetSession(h).rematch = group\n\t\tend\n\t\ttask.delay(M.RematchTimeout, function()\n\t\t\tif not group.closed then\n\t\t\t\tgroup.closed = true\n\t\t\t\tfor _, h in ipairs(group.humans) do\n\t\t\t\t\tlocal s = MatchService.sessions[h]\n\t\t\t\t\tif s and s.rematch == group then\n\t\t\t\t\t\ts.rematch = nil\n\t\t\t\t\t\tsend(h, \"Rematch\", { status = \"closed\", reason = \"Rematch timed out\" })\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend)\n\tend\nend\n\nlocal function closeGroup(group, leaver: Player?, reason: string)\n\tif not group or group.closed then\n\t\treturn\n\tend\n\tgroup.closed = true\n\tfor _, h in ipairs(group.humans) do\n\t\tlocal s = MatchService.sessions[h]\n\t\tif s and s.rematch == group then\n\t\t\ts.rematch = nil\n\t\t\tif h ~= leaver then\n\t\t\t\tsend(h, \"Rematch\", { status = \"closed\", reason = reason })\n\t\t\tend\n\t\tend\n\tend\nend\n\nfunction MatchService.RequestRematch(player: Player)\n\tlocal s = MatchService.GetSession(player)\n\tlocal group = s.rematch\n\tif s.status ~= \"Results\" or not group or group.closed then\n\t\tsend(player, \"Rematch\", { status = \"closed\", reason = \"Rematch unavailable\" })\n\t\treturn\n\tend\n\tgroup.votes[player] = true\n\tlocal count = 0\n\tfor _, h in ipairs(group.humans) do\n\t\tif group.votes[h] then\n\t\t\tcount += 1\n\t\tend\n\tend\n\tif count >= #group.humans then\n\t\tgroup.closed = true\n\t\tfor _, h in ipairs(group.humans) do\n\t\t\tMatchService.GetSession(h).rematch = nil\n\t\t\tsend(h, \"Rematch\", { status = \"starting\" })\n\t\tend\n\t\tMatchService.Create(group.specs, group.mode)\n\telse\n\t\tfor _, h in ipairs(group.humans) do\n\t\t\tsend(h, \"Rematch\", { status = \"waiting\", votes = count, needed = #group.humans })\n\t\tend\n\tend\nend\n\nfunction MatchService.LeaveResults(player: Player)\n\tlocal s = MatchService.GetSession(player)\n\tif s.status == \"Results\" then\n\t\ts.status = \"Menu\"\n\tend\n\tcloseGroup(s.rematch, player, \"Opponent left\")\n\ts.rematch = nil\nend\n\nfunction MatchService.StartBotMatch(player: Player)\n\tlocal s = MatchService.GetSession(player)\n\tif s.status ~= \"Menu\" and s.status ~= \"Results\" then\n\t\treturn\n\tend\n\tcloseGroup(s.rematch, player, \"Opponent left\")\n\tlocal robots = Config.Robots\n\tlocal botRobot = robots[math.random(1, #robots)].Id\n\tMatchService.Create({ { kind = \"Player\", player = player }, { kind = \"Bot\", robotId = botRobot } }, \"Bot\")\nend\n\nfunction MatchService.OnPlayerLeft(player: Player)\n\tlocal s = MatchService.sessions[player]\n\tif not s then\n\t\treturn\n\tend\n\tcloseGroup(s.rematch, player, \"Opponent left\")\n\tif s.match then\n\t\tMatchService.DropCombatants(s.match, function(c)\n\t\t\treturn c.participant.player == player\n\t\tend)\n\tend\n\tMatchService.sessions[player] = nil\nend\n\n-- Removes the matching combatants from a live match (disconnect / forfeit); the last team standing\n-- wins by \"LEFT\", and a match with no humans left is torn down.\nfunction MatchService.DropCombatants(match, predicate: (any) -> boolean)\n\tif match.state == \"Ended\" then\n\t\treturn\n\tend\n\tfor _, c in ipairs(match.combatants) do\n\t\tif predicate(c) then\n\t\t\tc.participant.left = true\n\t\t\tif match.state == \"Intro\" or match.state == \"Fight\" then\n\t\t\t\tc.alive = false\n\t\t\t\tif c.model then\n\t\t\t\t\tc.model:Destroy()\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\tif match.state == \"Intro\" or match.state == \"Fight\" then\n\t\tlocal alive = aliveTeams(match)\n\t\tif #alive <= 1 then\n\t\t\tif match.state == \"Intro\" then\n\t\t\t\tmatch.state = \"Fight\"\n\t\t\tend\n\t\t\tmatch:Finish(\"LEFT\", alive[1])\n\t\tend\n\tend\n\tif #match:Humans() == 0 and match.state ~= \"Ended\" then\n\t\tmatch.state = \"Ended\"\n\t\tcleanup(match)\n\tend\nend\n\nfunction MatchService.Step(dt: number)\n\tfor _, match in pairs(MatchService.matches) do\n\t\tlocal ok, err = pcall(match.Step, match, dt)\n\t\tif not ok then\n\t\t\twarn(\"[RoboClash] match step error: \" .. tostring(err))\n\t\tend\n\tend\nend\n\nfunction MatchService.CountActive(): number\n\tlocal n = 0\n\tfor _ in pairs(MatchService.matches) do\n\t\tn += 1\n\tend\n\treturn n\nend\n\nPlayers.PlayerRemoving:Connect(function(player)\n\tMatchService.OnPlayerLeft(player)\nend)\n\nreturn MatchService\n","message":"The file /Users/chase-mini/src/rca-work/src/ServerScriptService/RoboClash/MatchService.luau has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"toolu_01Fiwmi4Lp4RvPa8ME2pVoFd","startedAtMs":"1791076369262","completedAtMs":"1791076374125"},"model_call_id":"9f87d2a3-a097-4b92-978f-ec64b826b4ce-109-7mdo","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791076374130}
{"type":"tool_call","subtype":"started","call_id":"toolu_01SetGu2kUdzZxBMpMVWT5c9","tool_call":{"editToolCall":{"args":{"path":"/Users/chase-mini/src/rca-work/src/ServerScriptService/RoboClash/Main.server.luau","streamContent":"\t\telseif cmd == \"leave\" then\n\t\t\tfor _, m in pairs(MatchService.matches) do\n\t\t\t\tMatchService.DropCombatants(m, function(c)\n\t\t\t\t\treturn c.participant.kind == (args[1] == \"player\" and \"Player\" or \"Bot\")\n\t\t\t\tend)\n\t\t\tend\n\t\t\treturn \"ok\"\n\t\telseif cmd == \"botidle\" then"}},"hookAdditionalContexts":[],"toolCallId":"toolu_01SetGu2kUdzZxBMpMVWT5c9","startedAtMs":"1791076374058"},"model_call_id":"9f87d2a3-a097-4b92-978f-ec64b826b4ce-109-7mdo","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791076375811}
{"type":"tool_call","subtype":"completed","call_id":"toolu_01SetGu2kUdzZxBMpMVWT5c9","tool_call":{"editToolCall":{"args":{"path":"/Users/chase-mini/src/rca-work/src/ServerScriptService/RoboClash/Main.server.luau","streamContent":"\t\telseif cmd == \"leave\" then\n\t\t\tfor _, m in pairs(MatchService.matches) do\n\t\t\t\tMatchService.DropCombatants(m, function(c)\n\t\t\t\t\treturn c.participant.kind == (args[1] == \"player\" and \"Player\" or \"Bot\")\n\t\t\t\tend)\n\t\t\tend\n\t\t\treturn \"ok\"\n\t\telseif cmd == \"botidle\" then"},"result":{"success":{"path":"/Users/chase-mini/src/rca-work/src/ServerScriptService/RoboClash/Main.server.luau","linesAdded":7,"linesRemoved":0,"diffString":"--- a//Users/chase-mini/src/rca-work/src/ServerScriptService/RoboClash/Main.server.luau\n+++ b//Users/chase-mini/src/rca-work/src/ServerScriptService/RoboClash/Main.server.luau\n@@ -136,6 +136,13 @@\n \t\t\t\tend\n \t\t\tend\n \t\t\treturn \"ok\"\n+\t\telseif cmd == \"leave\" then\n+\t\t\tfor _, m in pairs(MatchService.matches) do\n+\t\t\t\tMatchService.DropCombatants(m, function(c)\n+\t\t\t\t\treturn c.participant.kind == (args[1] == \"player\" and \"Player\" or \"Bot\")\n+\t\t\t\tend)\n+\t\t\tend\n+\t\t\treturn \"ok\"\n \t\telseif cmd == \"botidle\" then\n \t\t\tfor _, m in pairs(MatchService.matches) do\n \t\t\t\tfor _, c in ipairs(m.combatants) do","beforeFullFileContent":"-- Robo Clash Arena server entry: wires remotes to services and steps matches.\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal RC = ReplicatedStorage:WaitForChild(\"RoboClash\")\nlocal Config = require(RC.Config)\nlocal Remotes = RC:WaitForChild(\"Remotes\")\n\nlocal MatchService = require(script.Parent.MatchService)\nlocal Matchmaking = require(script.Parent.MatchmakingService)\nlocal Combat = require(script.Parent.CombatService)\n\nPlayers.CharacterAutoLoads = false\nworkspace.Gravity = Config.Match.Gravity\n\nlocal VALID_INTENTS = { GunDown = true, GunUp = true, Bomb = true, Pod = true, Dash = true }\n\n-- Per-player intent rate limiting (token bucket).\nlocal buckets = {}\nlocal function allow(player: Player): boolean\n\tlocal t = os.clock()\n\tlocal b = buckets[player]\n\tif not b then\n\t\tb = { tokens = Config.Match.IntentRateLimit, last = t }\n\t\tbuckets[player] = b\n\tend\n\tb.tokens = math.min(Config.Match.IntentRateLimit, b.tokens + (t - b.last) * Config.Match.IntentRateLimit)\n\tb.last = t\n\tif b.tokens < 1 then\n\t\treturn false\n\tend\n\tb.tokens -= 1\n\treturn true\nend\n\nRemotes.Intent.OnServerEvent:Connect(function(player, action, payload)\n\tif typeof(action) ~= \"string\" or not VALID_INTENTS[action] then\n\t\treturn\n\tend\n\tif action ~= \"GunUp\" and not allow(player) then\n\t\treturn\n\tend\n\tlocal s = MatchService.sessions[player]\n\tif not s or not s.match or not s.combatant then\n\t\treturn\n\tend\n\tif payload ~= nil and typeof(payload) ~= \"table\" then\n\t\tpayload = nil\n\tend\n\tCombat.HandleIntent(s.match, s.combatant, action, payload)\nend)\n\nRemotes.Menu.OnServerEvent:Connect(function(player, action, arg)\n\tif typeof(action) ~= \"string\" or not allow(player) then\n\t\treturn\n\tend\n\tlocal s = MatchService.GetSession(player)\n\tif action == \"Select\" then\n\t\tif typeof(arg) == \"string\" and Config.RobotById[arg] and s.status ~= \"Match\" then\n\t\t\ts.robotId = arg\n\t\tend\n\telseif action == \"Queue\" then\n\t\tMatchmaking.Enqueue(player)\n\telseif action == \"CancelQueue\" then\n\t\tMatchmaking.Dequeue(player)\n\telseif action == \"Bot\" then\n\t\tif s.status == \"Queue\" then\n\t\t\tMatchmaking.Dequeue(player)\n\t\tend\n\t\tMatchService.StartBotMatch(player)\n\telseif action == \"Rematch\" then\n\t\tMatchService.RequestRematch(player)\n\telseif action == \"Back\" then\n\t\tif s.status == \"Queue\" then\n\t\t\tMatchmaking.Dequeue(player)\n\t\tend\n\t\tMatchService.LeaveResults(player)\n\tend\nend)\n\nPlayers.PlayerAdded:Connect(function(player)\n\tMatchService.GetSession(player)\nend)\nfor _, p in ipairs(Players:GetPlayers()) do\n\tMatchService.GetSession(p)\nend\nPlayers.PlayerRemoving:Connect(function(player)\n\tbuckets[player] = nil\nend)\n\nRunService.Heartbeat:Connect(function(dt)\n\tMatchService.Step(math.min(dt, 1 / 20))\nend)\n\n-- Studio-only test hook (used by MCP playtests); never active in live servers.\nif RunService:IsStudio() then\n\tlocal hook = Instance.new(\"BindableFunction\")\n\thook.Name = \"RoboClashDebug\"\n\thook.OnInvoke = function(cmd, ...)\n\t\tlocal args = { ... }\n\t\tif cmd == \"fake\" then\n\t\t\tMatchmaking.EnqueueFake(args[1] or \"Crusher\", args[2])\n\t\t\treturn \"fake queued\"\n\t\telseif cmd == \"state\" then\n\t\t\tlocal out = {}\n\t\t\tfor id, m in pairs(MatchService.matches) do\n\t\t\t\tlocal cs = {}\n\t\t\t\tfor _, c in ipairs(m.combatants) do\n\t\t\t\t\ttable.insert(cs, string.format(\"%s %s hp=%d st=%s pips=%d alive=%s\", c.tag, c.participant.robotId, c.hp, c.state, math.ceil(c.endurance / 100), tostring(c.alive)))\n\t\t\t\tend\n\t\t\t\ttable.insert(out, string.format(\"match %d mode=%s state=%s :: %s\", id, m.mode, m.state, table.concat(cs, \" | \")))\n\t\t\tend\n\t\t\tlocal q = {}\n\t\t\tfor _, e in ipairs(Matchmaking.queue) do\n\t\t\t\ttable.insert(q, e.player and e.player.Name or (\"fake:\" .. e.robotId))\n\t\t\tend\n\t\t\tlocal ss = {}\n\t\t\tfor p, s in pairs(MatchService.sessions) do\n\t\t\t\ttable.insert(ss, p.Name .. \"=\" .. s.status .. \"/\" .. s.robotId)\n\t\t\tend\n\t\t\treturn table.concat(out, \"\\n\") .. \"\\nqueue: \" .. table.concat(q, \",\") .. \"\\nsessions: \" .. table.concat(ss, \",\")\n\t\telseif cmd == \"damage\" then\n\t\t\tfor _, m in pairs(MatchService.matches) do\n\t\t\t\tfor _, c in ipairs(m.combatants) do\n\t\t\t\t\tif (args[1] == \"bot\" and c.participant.kind == \"Bot\") or (args[1] == \"player\" and c.participant.kind == \"Player\") then\n\t\t\t\t\t\tCombat.Damage(m, c, args[2] or 100, nil, { downPower = args[3] or 0, knock = 20, up = 10 })\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\treturn \"ok\"\n\t\telseif cmd == \"time\" then\n\t\t\tfor _, m in pairs(MatchService.matches) do\n\t\t\t\tif m.endTime then\n\t\t\t\t\tm.endTime = Combat.now() + (args[1] or 3)\n\t\t\t\tend\n\t\t\tend\n\t\t\treturn \"ok\"\n\t\telseif cmd == \"botidle\" then\n\t\t\tfor _, m in pairs(MatchService.matches) do\n\t\t\t\tfor _, c in ipairs(m.combatants) do\n\t\t\t\t\tif c.ai then\n\t\t\t\t\t\tc.ai.idle = args[1] == true\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\treturn \"ok\"\n\t\tend\n\t\treturn \"unknown\"\n\tend\n\thook.Parent = game:GetService(\"ServerScriptService\")\nend\n","afterFullFileContent":"-- Robo Clash Arena server entry: wires remotes to services and steps matches.\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal RC = ReplicatedStorage:WaitForChild(\"RoboClash\")\nlocal Config = require(RC.Config)\nlocal Remotes = RC:WaitForChild(\"Remotes\")\n\nlocal MatchService = require(script.Parent.MatchService)\nlocal Matchmaking = require(script.Parent.MatchmakingService)\nlocal Combat = require(script.Parent.CombatService)\n\nPlayers.CharacterAutoLoads = false\nworkspace.Gravity = Config.Match.Gravity\n\nlocal VALID_INTENTS = { GunDown = true, GunUp = true, Bomb = true, Pod = true, Dash = true }\n\n-- Per-player intent rate limiting (token bucket).\nlocal buckets = {}\nlocal function allow(player: Player): boolean\n\tlocal t = os.clock()\n\tlocal b = buckets[player]\n\tif not b then\n\t\tb = { tokens = Config.Match.IntentRateLimit, last = t }\n\t\tbuckets[player] = b\n\tend\n\tb.tokens = math.min(Config.Match.IntentRateLimit, b.tokens + (t - b.last) * Config.Match.IntentRateLimit)\n\tb.last = t\n\tif b.tokens < 1 then\n\t\treturn false\n\tend\n\tb.tokens -= 1\n\treturn true\nend\n\nRemotes.Intent.OnServerEvent:Connect(function(player, action, payload)\n\tif typeof(action) ~= \"string\" or not VALID_INTENTS[action] then\n\t\treturn\n\tend\n\tif action ~= \"GunUp\" and not allow(player) then\n\t\treturn\n\tend\n\tlocal s = MatchService.sessions[player]\n\tif not s or not s.match or not s.combatant then\n\t\treturn\n\tend\n\tif payload ~= nil and typeof(payload) ~= \"table\" then\n\t\tpayload = nil\n\tend\n\tCombat.HandleIntent(s.match, s.combatant, action, payload)\nend)\n\nRemotes.Menu.OnServerEvent:Connect(function(player, action, arg)\n\tif typeof(action) ~= \"string\" or not allow(player) then\n\t\treturn\n\tend\n\tlocal s = MatchService.GetSession(player)\n\tif action == \"Select\" then\n\t\tif typeof(arg) == \"string\" and Config.RobotById[arg] and s.status ~= \"Match\" then\n\t\t\ts.robotId = arg\n\t\tend\n\telseif action == \"Queue\" then\n\t\tMatchmaking.Enqueue(player)\n\telseif action == \"CancelQueue\" then\n\t\tMatchmaking.Dequeue(player)\n\telseif action == \"Bot\" then\n\t\tif s.status == \"Queue\" then\n\t\t\tMatchmaking.Dequeue(player)\n\t\tend\n\t\tMatchService.StartBotMatch(player)\n\telseif action == \"Rematch\" then\n\t\tMatchService.RequestRematch(player)\n\telseif action == \"Back\" then\n\t\tif s.status == \"Queue\" then\n\t\t\tMatchmaking.Dequeue(player)\n\t\tend\n\t\tMatchService.LeaveResults(player)\n\tend\nend)\n\nPlayers.PlayerAdded:Connect(function(player)\n\tMatchService.GetSession(player)\nend)\nfor _, p in ipairs(Players:GetPlayers()) do\n\tMatchService.GetSession(p)\nend\nPlayers.PlayerRemoving:Connect(function(player)\n\tbuckets[player] = nil\nend)\n\nRunService.Heartbeat:Connect(function(dt)\n\tMatchService.Step(math.min(dt, 1 / 20))\nend)\n\n-- Studio-only test hook (used by MCP playtests); never active in live servers.\nif RunService:IsStudio() then\n\tlocal hook = Instance.new(\"BindableFunction\")\n\thook.Name = \"RoboClashDebug\"\n\thook.OnInvoke = function(cmd, ...)\n\t\tlocal args = { ... }\n\t\tif cmd == \"fake\" then\n\t\t\tMatchmaking.EnqueueFake(args[1] or \"Crusher\", args[2])\n\t\t\treturn \"fake queued\"\n\t\telseif cmd == \"state\" then\n\t\t\tlocal out = {}\n\t\t\tfor id, m in pairs(MatchService.matches) do\n\t\t\t\tlocal cs = {}\n\t\t\t\tfor _, c in ipairs(m.combatants) do\n\t\t\t\t\ttable.insert(cs, string.format(\"%s %s hp=%d st=%s pips=%d alive=%s\", c.tag, c.participant.robotId, c.hp, c.state, math.ceil(c.endurance / 100), tostring(c.alive)))\n\t\t\t\tend\n\t\t\t\ttable.insert(out, string.format(\"match %d mode=%s state=%s :: %s\", id, m.mode, m.state, table.concat(cs, \" | \")))\n\t\t\tend\n\t\t\tlocal q = {}\n\t\t\tfor _, e in ipairs(Matchmaking.queue) do\n\t\t\t\ttable.insert(q, e.player and e.player.Name or (\"fake:\" .. e.robotId))\n\t\t\tend\n\t\t\tlocal ss = {}\n\t\t\tfor p, s in pairs(MatchService.sessions) do\n\t\t\t\ttable.insert(ss, p.Name .. \"=\" .. s.status .. \"/\" .. s.robotId)\n\t\t\tend\n\t\t\treturn table.concat(out, \"\\n\") .. \"\\nqueue: \" .. table.concat(q, \",\") .. \"\\nsessions: \" .. table.concat(ss, \",\")\n\t\telseif cmd == \"damage\" then\n\t\t\tfor _, m in pairs(MatchService.matches) do\n\t\t\t\tfor _, c in ipairs(m.combatants) do\n\t\t\t\t\tif (args[1] == \"bot\" and c.participant.kind == \"Bot\") or (args[1] == \"player\" and c.participant.kind == \"Player\") then\n\t\t\t\t\t\tCombat.Damage(m, c, args[2] or 100, nil, { downPower = args[3] or 0, knock = 20, up = 10 })\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\treturn \"ok\"\n\t\telseif cmd == \"time\" then\n\t\t\tfor _, m in pairs(MatchService.matches) do\n\t\t\t\tif m.endTime then\n\t\t\t\t\tm.endTime = Combat.now() + (args[1] or 3)\n\t\t\t\tend\n\t\t\tend\n\t\t\treturn \"ok\"\n\t\telseif cmd == \"leave\" then\n\t\t\tfor _, m in pairs(MatchService.matches) do\n\t\t\t\tMatchService.DropCombatants(m, function(c)\n\t\t\t\t\treturn c.participant.kind == (args[1] == \"player\" and \"Player\" or \"Bot\")\n\t\t\t\tend)\n\t\t\tend\n\t\t\treturn \"ok\"\n\t\telseif cmd == \"botidle\" then\n\t\t\tfor _, m in pairs(MatchService.matches) do\n\t\t\t\tfor _, c in ipairs(m.combatants) do\n\t\t\t\t\tif c.ai then\n\t\t\t\t\t\tc.ai.idle = args[1] == true\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\treturn \"ok\"\n\t\tend\n\t\treturn \"unknown\"\n\tend\n\thook.Parent = game:GetService(\"ServerScriptService\")\nend\n","message":"The file /Users/chase-mini/src/rca-work/src/ServerScriptService/RoboClash/Main.server.luau has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"toolu_01SetGu2kUdzZxBMpMVWT5c9","startedAtMs":"1791076374058","completedAtMs":"1791076375867"},"model_call_id":"9f87d2a3-a097-4b92-978f-ec64b826b4ce-109-7mdo","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791076375955}
