{"type":"tool_call","subtype":"completed","call_id":"toolu_01SzcGByKX6Z3KU9gxfptSjg","tool_call":{"editToolCall":{"args":{"path":"/Users/chase-mini/src/rca-work/src/ServerScriptService/RoboClash/MatchService.luau","streamContent":"\t\t\tBotAI.Attach(match, c)"},"result":{"success":{"path":"/Users/chase-mini/src/rca-work/src/ServerScriptService/RoboClash/MatchService.luau","linesAdded":1,"linesRemoved":1,"diffString":"--- a//Users/chase-mini/src/rca-work/src/ServerScriptService/RoboClash/MatchService.luau\n+++ b//Users/chase-mini/src/rca-work/src/ServerScriptService/RoboClash/MatchService.luau\n@@ -270,7 +270,7 @@\n \t\ttable.insert(match.combatants, c)\n \t\tmatch.byModel[model] = c\n \t\tif p.kind == \"Bot\" then\n-\t\t\tBotAI.Attach(match, c, spec_difficulty)\n+\t\t\tBotAI.Attach(match, c)\n \t\telse\n \t\t\tlocal s = MatchService.GetSession(p.player)\n \t\t\ts.status = \"Match\"","beforeFullFileContent":"-- Match lifecycle. A match clones the arena template into its own slot (offset in Workspace),\n-- spawns N participants (players or bots), runs intro -> fight -> KO/time/leave -> results,\n-- then cleans up and offers a rematch. Nothing here assumes exactly 2 participants.\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal ServerStorage = game:GetService(\"ServerStorage\")\n\nlocal RC = ReplicatedStorage:WaitForChild(\"RoboClash\")\nlocal Config = require(RC.Config)\nlocal Combat = require(script.Parent.CombatService)\nlocal RobotSpawner = require(script.Parent.RobotSpawner)\nlocal BotAI = require(script.Parent.BotAI)\n\nlocal M = Config.Match\nlocal Remotes = {\n\tMatch = RC.Remotes.Match,\n\tFX = RC.Remotes.FX,\n}\n\nlocal MatchService = {}\nMatchService.matches = {}\nMatchService.sessions = {}\n\nlocal arenaTemplate = ServerStorage:WaitForChild(\"RoboClash\"):WaitForChild(\"ArenaTemplate\")\nlocal arenasFolder = workspace:FindFirstChild(\"Arenas\")\nif not arenasFolder then\n\tarenasFolder = Instance.new(\"Folder\")\n\tarenasFolder.Name = \"Arenas\"\n\tarenasFolder.Parent = workspace\nend\n\nlocal slots = {}\nlocal nextMatchId = 0\nlocal now = Combat.now\n\n----------------------------------------------------------------------------------------------\n-- Sessions\n----------------------------------------------------------------------------------------------\nfunction MatchService.GetSession(player: Player)\n\tlocal s = MatchService.sessions[player]\n\tif not s then\n\t\ts = { player = player, robotId = Config.Robots[1].Id, status = \"Menu\", match = nil, combatant = nil, rematch = nil }\n\t\tMatchService.sessions[player] = s\n\tend\n\treturn s\nend\n\nlocal function send(player: Player, ...)\n\tif player.Parent then\n\t\tRemotes.Match:FireClient(player, ...)\n\tend\nend\nMatchService.Send = send\n\n----------------------------------------------------------------------------------------------\n-- Match object\n----------------------------------------------------------------------------------------------\nlocal Match = {}\nMatch.__index = Match\n\nfunction Match:Humans()\n\tlocal list = {}\n\tfor _, p in ipairs(self.participants) do\n\t\tif p.kind == \"Player\" and not p.left and p.player.Parent then\n\t\t\ttable.insert(list, p.player)\n\t\tend\n\tend\n\treturn list\nend\n\nfunction Match:FireAll(remoteName: string, ...)\n\tlocal remote = Remotes[remoteName]\n\tfor _, player in ipairs(self:Humans()) do\n\t\tlocal s = MatchService.sessions[player]\n\t\tif s and s.match == self then\n\t\t\tremote:FireClient(player, ...)\n\t\tend\n\tend\nend\n\nlocal function aliveTeams(match)\n\tlocal teams, list = {}, {}\n\tfor _, c in ipairs(match.combatants) do\n\t\tif c.alive and not teams[c.team] then\n\t\t\tteams[c.team] = true\n\t\t\ttable.insert(list, c)\n\t\tend\n\tend\n\treturn list\nend\n\nfunction Match:OnKO(victim, _attacker)\n\tif self.state ~= \"Fight\" then\n\t\treturn\n\tend\n\tvictim.alive = false\n\tvictim.model:SetAttribute(\"State\", \"KO\")\n\tlocal alive = aliveTeams(self)\n\tif #alive <= 1 then\n\t\tself:Finish(\"KO\", alive[1])\n\tend\nend\n\nfunction Match:Finish(reason: string, winner)\n\tif self.state == \"KO\" or self.state == \"Ended\" then\n\t\treturn\n\tend\n\tself.state = \"KO\"\n\tself.finishedAt = now()\n\tself.reason = reason\n\tself.winner = winner\n\tfor _, c in ipairs(self.combatants) do\n\t\tc.gunHeld = false\n\t\tc.chargeStart = nil\n\t\tc.burstLeft = 0\n\t\tif c.model.Parent then\n\t\t\tc.model:SetAttribute(\"Locked\", true)\n\t\t\tif c.root and c.root.Parent then\n\t\t\t\tc.root.Anchored = true\n\t\t\tend\n\t\tend\n\t\tif c.mover then\n\t\t\tc.mover:SetLocked(true)\n\t\tend\n\tend\n\tCombat.ClearProjectiles(self)\n\tlocal perfect = winner ~= nil and winner.stats.damageTaken == 0\n\tself.perfect = perfect\n\tself:FireAll(\"Match\", \"KO\", {\n\t\twinner = winner and winner.model,\n\t\treason = reason,\n\t\tperfect = perfect,\n\t\tdraw = winner == nil,\n\t})\n\ttask.delay(M.KOFreezeTime, function()\n\t\tfor _, c in ipairs(self.combatants) do\n\t\t\tif c.model.Parent then\n\t\t\t\tc.model:SetAttribute(\"Pose\", c == winner and \"Victory\" or \"Defeat\")\n\t\t\tend\n\t\tend\n\tend)\n\ttask.delay(M.ResultsDelay, function()\n\t\tMatchService.ShowResults(self)\n\tend)\nend\n\nfunction Match:Launch()\n\tif self.state ~= \"Intro\" then\n\t\treturn\n\tend\n\tself.state = \"Fight\"\n\tself.launchedAt = now()\n\tself.endTime = self.launchedAt + M.Duration\n\tfor _, c in ipairs(self.combatants) do\n\t\tif c.alive and c.model.Parent then\n\t\t\tRobotSpawner.Release(c.participant, c.model)\n\t\t\tCombat.SetState(c, \"Normal\", 0)\n\t\t\tc.model:SetAttribute(\"Locked\", false)\n\t\t\tif c.mover then\n\t\t\t\tc.mover:SetLocked(false)\n\t\t\tend\n\t\tend\n\tend\n\tself:FireAll(\"Match\", \"Launch\", { endTime = self.endTime })\nend\n\nfunction Match:Step(dt: number)\n\tif self.state == \"Ended\" then\n\t\treturn\n\tend\n\tCombat.Step(self, dt)\n\tfor _, c in ipairs(self.combatants) do\n\t\tif c.ai then\n\t\t\tBotAI.Step(self, c, dt)\n\t\tend\n\tend\n\tif self.state == \"Fight\" and now() >= self.endTime then\n\t\t-- Time up: highest HP% wins.\n\t\tlocal best, bestPct, tie = nil, -1, false\n\t\tfor _, c in ipairs(self.combatants) do\n\t\t\tif c.alive then\n\t\t\t\tlocal pct = c.hp / c.maxHp\n\t\t\t\tif pct > bestPct + 1e-6 then\n\t\t\t\t\tbest, bestPct, tie = c, pct, false\n\t\t\t\telseif math.abs(pct - bestPct) <= 1e-6 then\n\t\t\t\t\ttie = true\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\tself:Finish(\"TIME\", (not tie) and best or nil)\n\tend\nend\n\n----------------------------------------------------------------------------------------------\n-- Creation\n----------------------------------------------------------------------------------------------\nlocal function allocSlot(): number\n\tlocal i = 1\n\twhile slots[i] do\n\t\ti += 1\n\tend\n\tslots[i] = true\n\treturn i\nend\n\n-- specs: list of { kind = \"Player\", player = Player } | { kind = \"Bot\", robotId = string }\nfunction MatchService.Create(specs, mode: string)\n\tnextMatchId += 1\n\tlocal slot = allocSlot()\n\tlocal origin = CFrame.new(M.ArenaBaseX + (slot - 1) * M.ArenaSpacing, M.ArenaHeight, 0)\n\tlocal arena = arenaTemplate:Clone()\n\tarena.Name = \"Arena_\" .. nextMatchId\n\tarena:PivotTo(origin)\n\tarena.Parent = arenasFolder\n\tlocal robots = Instance.new(\"Folder\")\n\trobots.Name = \"Robots\"\n\trobots.Parent = arena\n\n\tlocal rayParams = RaycastParams.new()\n\trayParams.FilterType = Enum.RaycastFilterType.Include\n\trayParams.FilterDescendantsInstances = { arena:WaitForChild(\"Geometry\") }\n\n\tlocal match = setmetatable({\n\t\tid = nextMatchId,\n\t\tslot = slot,\n\t\torigin = origin,\n\t\tarena = arena,\n\t\tmode = mode,\n\t\tfloorY = origin.Y,\n\t\trayParams = rayParams,\n\t\tparticipants = {},\n\t\tcombatants = {},\n\t\tbyModel = {},\n\t\tprojectiles = {},\n\t\tblasts = {},\n\t\tnextProjId = 0,\n\t\tstate = \"Intro\",\n\t\tremotes = Remotes,\n\t\tspecs = specs,\n\t}, Match)\n\tMatchService.matches[match.id] = match\n\n\tfor i, spec in ipairs(specs) do\n\t\tlocal p = {\n\t\t\tkind = spec.kind,\n\t\t\tplayer = spec.player,\n\t\t\tindex = i,\n\t\t\tteam = i,\n\t\t\ttag = \"P\" .. i,\n\t\t}\n\t\tif spec.kind == \"Player\" then\n\t\t\tlocal s = MatchService.GetSession(spec.player)\n\t\t\tp.robotId = s.robotId\n\t\t\tp.name = spec.player.DisplayName\n\t\telse\n\t\t\tp.robotId = spec.robotId\n\t\t\tp.name = spec.name or (\"CPU \" .. (Config.RobotById[spec.robotId] or Config.Robots[1]).DisplayName)\n\t\tend\n\t\ttable.insert(match.participants, p)\n\tend\n\n\tlocal spawns = arena:WaitForChild(\"Spawns\")\n\tfor i, p in ipairs(match.participants) do\n\t\tlocal sp = spawns:FindFirstChild(\"Spawn\" .. i) :: BasePart\n\t\tlocal pos = Vector3.new(sp.Position.X, match.floorY, sp.Position.Z)\n\t\tlocal center = Vector3.new(origin.X, match.floorY, origin.Z)\n\t\tlocal spawnCF = CFrame.lookAt(pos, center)\n\t\tlocal model, info = RobotSpawner.Spawn(p, spawnCF, robots)\n\t\tlocal c = Combat.NewCombatant(match, p, model, info, spawnCF)\n\t\ttable.insert(match.combatants, c)\n\t\tmatch.byModel[model] = c\n\t\tif p.kind == \"Bot\" then\n\t\t\tBotAI.Attach(match, c, spec_difficulty)\n\t\telse\n\t\t\tlocal s = MatchService.GetSession(p.player)\n\t\t\ts.status = \"Match\"\n\t\t\ts.match = match\n\t\t\ts.combatant = c\n\t\t\ts.rematch = nil\n\t\tend\n\tend\n\n\tmatch.startTime = now()\n\tmatch.launchTime = match.startTime + M.IntroTime\n\tlocal roster = {}\n\tfor _, c in ipairs(match.combatants) do\n\t\ttable.insert(roster, {\n\t\t\tmodel = c.model,\n\t\t\ttag = c.tag,\n\t\t\tname = c.participant.name,\n\t\t\trobotId = c.participant.robotId,\n\t\t\tteam = c.team,\n\t\t\tisBot = c.participant.kind == \"Bot\",\n\t\t\tspawnPos = c.spawnCF.Position,\n\t\t})\n\tend\n\tfor _, c in ipairs(match.combatants) do\n\t\tif c.participant.kind == \"Player\" then\n\t\t\tsend(c.participant.player, \"Start\", {\n\t\t\t\tmatchId = match.id,\n\t\t\t\tmode = mode,\n\t\t\t\tcenter = Vector3.new(origin.X, match.floorY, origin.Z),\n\t\t\t\thalf = Config.Arena.Half,\n\t\t\t\tlocalModel = c.model,\n\t\t\t\troster = roster,\n\t\t\t\tstartTime = match.startTime,\n\t\t\t\tlaunchTime = match.launchTime,\n\t\t\t\tduration = M.Duration,\n\t\t\t})\n\t\tend\n\tend\n\ttask.delay(M.IntroTime, function()\n\t\tmatch:Launch()\n\tend)\n\treturn match\nend\n\n----------------------------------------------------------------------------------------------\n-- Results, cleanup, rematch\n----------------------------------------------------------------------------------------------\nlocal function statsOf(c)\n\treturn {\n\t\tname = c.participant.name,\n\t\ttag = c.tag,\n\t\trobotId = c.participant.robotId,\n\t\thp = c.hp,\n\t\tmaxHp = c.maxHp,\n\t\tdamageDealt = c.stats.damageDealt,\n\t\tdamageTaken = c.stats.damageTaken,\n\t\tdowns = c.stats.downs,\n\t\thits = c.stats.hits,\n\t\tisBot = c.participant.kind == \"Bot\",\n\t\tleft = c.participant.left == true,\n\t}\nend\n\nlocal function cleanup(match)\n\tfor _, c in ipairs(match.combatants) do\n\t\tBotAI.Detach(c)\n\t\tRobotSpawner.Despawn(c.participant, c.model)\n\tend\n\tif match.arena then\n\t\tmatch.arena:Destroy()\n\tend\n\tslots[match.slot] = nil\n\tMatchService.matches[match.id] = nil\nend\n\nfunction MatchService.ShowResults(match)\n\tif match.state == \"Ended\" then\n\t\treturn\n\tend\n\tmatch.state = \"Ended\"\n\tlocal winner = match.winner\n\tlocal duration = (match.finishedAt or now()) - (match.launchedAt or match.startTime)\n\tlocal humans = {}\n\tfor _, c in ipairs(match.combatants) do\n\t\tlocal p = c.participant\n\t\tif p.kind == \"Player\" and not p.left and p.player.Parent then\n\t\t\tlocal s = MatchService.GetSession(p.player)\n\t\t\tif s.match == match then\n\t\t\t\tlocal others = {}\n\t\t\t\tfor _, o in ipairs(match.combatants) do\n\t\t\t\t\tif o ~= c then\n\t\t\t\t\t\ttable.insert(others, statsOf(o))\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tlocal outcome = winner == nil and \"DRAW\" or (winner == c and \"WIN\" or \"LOSE\")\n\t\t\t\tsend(p.player, \"Results\", {\n\t\t\t\t\toutcome = outcome,\n\t\t\t\t\treason = match.reason,\n\t\t\t\t\tperfect = match.perfect and winner == c,\n\t\t\t\t\tyou = statsOf(c),\n\t\t\t\t\tothers = others,\n\t\t\t\t\tduration = duration,\n\t\t\t\t\tmode = match.mode,\n\t\t\t\t})\n\t\t\t\ts.status = \"Results\"\n\t\t\t\ts.match = nil\n\t\t\t\ts.combatant = nil\n\t\t\t\ttable.insert(humans, p.player)\n\t\t\tend\n\t\tend\n\tend\n\tcleanup(match)\n\n\tif #humans > 0 then\n\t\tlocal specs = {}\n\t\tfor _, spec in ipairs(match.specs) do\n\t\t\tif spec.kind == \"Player\" then\n\t\t\t\ttable.insert(specs, { kind = \"Player\", player = spec.player })\n\t\t\telse\n\t\t\t\ttable.insert(specs, { kind = \"Bot\", robotId = spec.robotId, name = spec.name })\n\t\t\tend\n\t\tend\n\t\tlocal group = { mode = match.mode, specs = specs, humans = humans, votes = {}, closed = false }\n\t\t-- every original human must still be here for a rematch\n\t\tfor _, spec in ipairs(match.specs) do\n\t\t\tif spec.kind == \"Player\" and not table.find(humans, spec.player) then\n\t\t\t\tgroup.closed = true\n\t\t\tend\n\t\tend\n\t\tfor _, h in ipairs(humans) do\n\t\t\tMatchService.GetSession(h).rematch = group\n\t\tend\n\t\ttask.delay(M.RematchTimeout, function()\n\t\t\tif not group.closed then\n\t\t\t\tgroup.closed = true\n\t\t\t\tfor _, h in ipairs(group.humans) do\n\t\t\t\t\tlocal s = MatchService.sessions[h]\n\t\t\t\t\tif s and s.rematch == group then\n\t\t\t\t\t\ts.rematch = nil\n\t\t\t\t\t\tsend(h, \"Rematch\", { status = \"closed\", reason = \"Rematch timed out\" })\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend)\n\tend\nend\n\nlocal function closeGroup(group, leaver: Player?, reason: string)\n\tif not group or group.closed then\n\t\treturn\n\tend\n\tgroup.closed = true\n\tfor _, h in ipairs(group.humans) do\n\t\tlocal s = MatchService.sessions[h]\n\t\tif s and s.rematch == group then\n\t\t\ts.rematch = nil\n\t\t\tif h ~= leaver then\n\t\t\t\tsend(h, \"Rematch\", { status = \"closed\", reason = reason })\n\t\t\tend\n\t\tend\n\tend\nend\n\nfunction MatchService.RequestRematch(player: Player)\n\tlocal s = MatchService.GetSession(player)\n\tlocal group = s.rematch\n\tif s.status ~= \"Results\" or not group or group.closed then\n\t\tsend(player, \"Rematch\", { status = \"closed\", reason = \"Rematch unavailable\" })\n\t\treturn\n\tend\n\tgroup.votes[player] = true\n\tlocal count = 0\n\tfor _, h in ipairs(group.humans) do\n\t\tif group.votes[h] then\n\t\t\tcount += 1\n\t\tend\n\tend\n\tif count >= #group.humans then\n\t\tgroup.closed = true\n\t\tfor _, h in ipairs(group.humans) do\n\t\t\tMatchService.GetSession(h).rematch = nil\n\t\t\tsend(h, \"Rematch\", { status = \"starting\" })\n\t\tend\n\t\tMatchService.Create(group.specs, group.mode)\n\telse\n\t\tfor _, h in ipairs(group.humans) do\n\t\t\tsend(h, \"Rematch\", { status = \"waiting\", votes = count, needed = #group.humans })\n\t\tend\n\tend\nend\n\nfunction MatchService.LeaveResults(player: Player)\n\tlocal s = MatchService.GetSession(player)\n\tif s.status == \"Results\" then\n\t\ts.status = \"Menu\"\n\tend\n\tcloseGroup(s.rematch, player, \"Opponent left\")\n\ts.rematch = nil\nend\n\nfunction MatchService.StartBotMatch(player: Player)\n\tlocal s = MatchService.GetSession(player)\n\tif s.status ~= \"Menu\" and s.status ~= \"Results\" then\n\t\treturn\n\tend\n\tcloseGroup(s.rematch, player, \"Opponent left\")\n\tlocal robots = Config.Robots\n\tlocal botRobot = robots[math.random(1, #robots)].Id\n\tMatchService.Create({ { kind = \"Player\", player = player }, { kind = \"Bot\", robotId = botRobot } }, \"Bot\")\nend\n\nfunction MatchService.OnPlayerLeft(player: Player)\n\tlocal s = MatchService.sessions[player]\n\tif not s then\n\t\treturn\n\tend\n\tcloseGroup(s.rematch, player, \"Opponent left\")\n\tlocal match = s.match\n\tif match and match.state ~= \"Ended\" then\n\t\tfor _, c in ipairs(match.combatants) do\n\t\t\tif c.participant.player == player then\n\t\t\t\tc.participant.left = true\n\t\t\t\tif match.state == \"Intro\" or match.state == \"Fight\" then\n\t\t\t\t\tc.alive = false\n\t\t\t\t\tif c.model then\n\t\t\t\t\t\tc.model:Destroy()\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\tif match.state == \"Intro\" or match.state == \"Fight\" then\n\t\t\tlocal alive = aliveTeams(match)\n\t\t\tif #alive <= 1 then\n\t\t\t\tif match.state == \"Intro\" then\n\t\t\t\t\tmatch.state = \"Fight\"\n\t\t\t\tend\n\t\t\t\tmatch:Finish(\"LEFT\", alive[1])\n\t\t\tend\n\t\tend\n\t\t-- No humans left at all: tear down immediately.\n\t\tif #match:Humans() == 0 and match.state ~= \"Ended\" then\n\t\t\tmatch.state = \"Ended\"\n\t\t\tcleanup(match)\n\t\tend\n\tend\n\tMatchService.sessions[player] = nil\nend\n\nfunction MatchService.Step(dt: number)\n\tfor _, match in pairs(MatchService.matches) do\n\t\tlocal ok, err = pcall(match.Step, match, dt)\n\t\tif not ok then\n\t\t\twarn(\"[RoboClash] match step error: \" .. tostring(err))\n\t\tend\n\tend\nend\n\nfunction MatchService.CountActive(): number\n\tlocal n = 0\n\tfor _ in pairs(MatchService.matches) do\n\t\tn += 1\n\tend\n\treturn n\nend\n\nPlayers.PlayerRemoving:Connect(function(player)\n\tMatchService.OnPlayerLeft(player)\nend)\n\nreturn MatchService\n","afterFullFileContent":"-- Match lifecycle. A match clones the arena template into its own slot (offset in Workspace),\n-- spawns N participants (players or bots), runs intro -> fight -> KO/time/leave -> results,\n-- then cleans up and offers a rematch. Nothing here assumes exactly 2 participants.\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal ServerStorage = game:GetService(\"ServerStorage\")\n\nlocal RC = ReplicatedStorage:WaitForChild(\"RoboClash\")\nlocal Config = require(RC.Config)\nlocal Combat = require(script.Parent.CombatService)\nlocal RobotSpawner = require(script.Parent.RobotSpawner)\nlocal BotAI = require(script.Parent.BotAI)\n\nlocal M = Config.Match\nlocal Remotes = {\n\tMatch = RC.Remotes.Match,\n\tFX = RC.Remotes.FX,\n}\n\nlocal MatchService = {}\nMatchService.matches = {}\nMatchService.sessions = {}\n\nlocal arenaTemplate = ServerStorage:WaitForChild(\"RoboClash\"):WaitForChild(\"ArenaTemplate\")\nlocal arenasFolder = workspace:FindFirstChild(\"Arenas\")\nif not arenasFolder then\n\tarenasFolder = Instance.new(\"Folder\")\n\tarenasFolder.Name = \"Arenas\"\n\tarenasFolder.Parent = workspace\nend\n\nlocal slots = {}\nlocal nextMatchId = 0\nlocal now = Combat.now\n\n----------------------------------------------------------------------------------------------\n-- Sessions\n----------------------------------------------------------------------------------------------\nfunction MatchService.GetSession(player: Player)\n\tlocal s = MatchService.sessions[player]\n\tif not s then\n\t\ts = { player = player, robotId = Config.Robots[1].Id, status = \"Menu\", match = nil, combatant = nil, rematch = nil }\n\t\tMatchService.sessions[player] = s\n\tend\n\treturn s\nend\n\nlocal function send(player: Player, ...)\n\tif player.Parent then\n\t\tRemotes.Match:FireClient(player, ...)\n\tend\nend\nMatchService.Send = send\n\n----------------------------------------------------------------------------------------------\n-- Match object\n----------------------------------------------------------------------------------------------\nlocal Match = {}\nMatch.__index = Match\n\nfunction Match:Humans()\n\tlocal list = {}\n\tfor _, p in ipairs(self.participants) do\n\t\tif p.kind == \"Player\" and not p.left and p.player.Parent then\n\t\t\ttable.insert(list, p.player)\n\t\tend\n\tend\n\treturn list\nend\n\nfunction Match:FireAll(remoteName: string, ...)\n\tlocal remote = Remotes[remoteName]\n\tfor _, player in ipairs(self:Humans()) do\n\t\tlocal s = MatchService.sessions[player]\n\t\tif s and s.match == self then\n\t\t\tremote:FireClient(player, ...)\n\t\tend\n\tend\nend\n\nlocal function aliveTeams(match)\n\tlocal teams, list = {}, {}\n\tfor _, c in ipairs(match.combatants) do\n\t\tif c.alive and not teams[c.team] then\n\t\t\tteams[c.team] = true\n\t\t\ttable.insert(list, c)\n\t\tend\n\tend\n\treturn list\nend\n\nfunction Match:OnKO(victim, _attacker)\n\tif self.state ~= \"Fight\" then\n\t\treturn\n\tend\n\tvictim.alive = false\n\tvictim.model:SetAttribute(\"State\", \"KO\")\n\tlocal alive = aliveTeams(self)\n\tif #alive <= 1 then\n\t\tself:Finish(\"KO\", alive[1])\n\tend\nend\n\nfunction Match:Finish(reason: string, winner)\n\tif self.state == \"KO\" or self.state == \"Ended\" then\n\t\treturn\n\tend\n\tself.state = \"KO\"\n\tself.finishedAt = now()\n\tself.reason = reason\n\tself.winner = winner\n\tfor _, c in ipairs(self.combatants) do\n\t\tc.gunHeld = false\n\t\tc.chargeStart = nil\n\t\tc.burstLeft = 0\n\t\tif c.model.Parent then\n\t\t\tc.model:SetAttribute(\"Locked\", true)\n\t\t\tif c.root and c.root.Parent then\n\t\t\t\tc.root.Anchored = true\n\t\t\tend\n\t\tend\n\t\tif c.mover then\n\t\t\tc.mover:SetLocked(true)\n\t\tend\n\tend\n\tCombat.ClearProjectiles(self)\n\tlocal perfect = winner ~= nil and winner.stats.damageTaken == 0\n\tself.perfect = perfect\n\tself:FireAll(\"Match\", \"KO\", {\n\t\twinner = winner and winner.model,\n\t\treason = reason,\n\t\tperfect = perfect,\n\t\tdraw = winner == nil,\n\t})\n\ttask.delay(M.KOFreezeTime, function()\n\t\tfor _, c in ipairs(self.combatants) do\n\t\t\tif c.model.Parent then\n\t\t\t\tc.model:SetAttribute(\"Pose\", c == winner and \"Victory\" or \"Defeat\")\n\t\t\tend\n\t\tend\n\tend)\n\ttask.delay(M.ResultsDelay, function()\n\t\tMatchService.ShowResults(self)\n\tend)\nend\n\nfunction Match:Launch()\n\tif self.state ~= \"Intro\" then\n\t\treturn\n\tend\n\tself.state = \"Fight\"\n\tself.launchedAt = now()\n\tself.endTime = self.launchedAt + M.Duration\n\tfor _, c in ipairs(self.combatants) do\n\t\tif c.alive and c.model.Parent then\n\t\t\tRobotSpawner.Release(c.participant, c.model)\n\t\t\tCombat.SetState(c, \"Normal\", 0)\n\t\t\tc.model:SetAttribute(\"Locked\", false)\n\t\t\tif c.mover then\n\t\t\t\tc.mover:SetLocked(false)\n\t\t\tend\n\t\tend\n\tend\n\tself:FireAll(\"Match\", \"Launch\", { endTime = self.endTime })\nend\n\nfunction Match:Step(dt: number)\n\tif self.state == \"Ended\" then\n\t\treturn\n\tend\n\tCombat.Step(self, dt)\n\tfor _, c in ipairs(self.combatants) do\n\t\tif c.ai then\n\t\t\tBotAI.Step(self, c, dt)\n\t\tend\n\tend\n\tif self.state == \"Fight\" and now() >= self.endTime then\n\t\t-- Time up: highest HP% wins.\n\t\tlocal best, bestPct, tie = nil, -1, false\n\t\tfor _, c in ipairs(self.combatants) do\n\t\t\tif c.alive then\n\t\t\t\tlocal pct = c.hp / c.maxHp\n\t\t\t\tif pct > bestPct + 1e-6 then\n\t\t\t\t\tbest, bestPct, tie = c, pct, false\n\t\t\t\telseif math.abs(pct - bestPct) <= 1e-6 then\n\t\t\t\t\ttie = true\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\tself:Finish(\"TIME\", (not tie) and best or nil)\n\tend\nend\n\n----------------------------------------------------------------------------------------------\n-- Creation\n----------------------------------------------------------------------------------------------\nlocal function allocSlot(): number\n\tlocal i = 1\n\twhile slots[i] do\n\t\ti += 1\n\tend\n\tslots[i] = true\n\treturn i\nend\n\n-- specs: list of { kind = \"Player\", player = Player } | { kind = \"Bot\", robotId = string }\nfunction MatchService.Create(specs, mode: string)\n\tnextMatchId += 1\n\tlocal slot = allocSlot()\n\tlocal origin = CFrame.new(M.ArenaBaseX + (slot - 1) * M.ArenaSpacing, M.ArenaHeight, 0)\n\tlocal arena = arenaTemplate:Clone()\n\tarena.Name = \"Arena_\" .. nextMatchId\n\tarena:PivotTo(origin)\n\tarena.Parent = arenasFolder\n\tlocal robots = Instance.new(\"Folder\")\n\trobots.Name = \"Robots\"\n\trobots.Parent = arena\n\n\tlocal rayParams = RaycastParams.new()\n\trayParams.FilterType = Enum.RaycastFilterType.Include\n\trayParams.FilterDescendantsInstances = { arena:WaitForChild(\"Geometry\") }\n\n\tlocal match = setmetatable({\n\t\tid = nextMatchId,\n\t\tslot = slot,\n\t\torigin = origin,\n\t\tarena = arena,\n\t\tmode = mode,\n\t\tfloorY = origin.Y,\n\t\trayParams = rayParams,\n\t\tparticipants = {},\n\t\tcombatants = {},\n\t\tbyModel = {},\n\t\tprojectiles = {},\n\t\tblasts = {},\n\t\tnextProjId = 0,\n\t\tstate = \"Intro\",\n\t\tremotes = Remotes,\n\t\tspecs = specs,\n\t}, Match)\n\tMatchService.matches[match.id] = match\n\n\tfor i, spec in ipairs(specs) do\n\t\tlocal p = {\n\t\t\tkind = spec.kind,\n\t\t\tplayer = spec.player,\n\t\t\tindex = i,\n\t\t\tteam = i,\n\t\t\ttag = \"P\" .. i,\n\t\t}\n\t\tif spec.kind == \"Player\" then\n\t\t\tlocal s = MatchService.GetSession(spec.player)\n\t\t\tp.robotId = s.robotId\n\t\t\tp.name = spec.player.DisplayName\n\t\telse\n\t\t\tp.robotId = spec.robotId\n\t\t\tp.name = spec.name or (\"CPU \" .. (Config.RobotById[spec.robotId] or Config.Robots[1]).DisplayName)\n\t\tend\n\t\ttable.insert(match.participants, p)\n\tend\n\n\tlocal spawns = arena:WaitForChild(\"Spawns\")\n\tfor i, p in ipairs(match.participants) do\n\t\tlocal sp = spawns:FindFirstChild(\"Spawn\" .. i) :: BasePart\n\t\tlocal pos = Vector3.new(sp.Position.X, match.floorY, sp.Position.Z)\n\t\tlocal center = Vector3.new(origin.X, match.floorY, origin.Z)\n\t\tlocal spawnCF = CFrame.lookAt(pos, center)\n\t\tlocal model, info = RobotSpawner.Spawn(p, spawnCF, robots)\n\t\tlocal c = Combat.NewCombatant(match, p, model, info, spawnCF)\n\t\ttable.insert(match.combatants, c)\n\t\tmatch.byModel[model] = c\n\t\tif p.kind == \"Bot\" then\n\t\t\tBotAI.Attach(match, c)\n\t\telse\n\t\t\tlocal s = MatchService.GetSession(p.player)\n\t\t\ts.status = \"Match\"\n\t\t\ts.match = match\n\t\t\ts.combatant = c\n\t\t\ts.rematch = nil\n\t\tend\n\tend\n\n\tmatch.startTime = now()\n\tmatch.launchTime = match.startTime + M.IntroTime\n\tlocal roster = {}\n\tfor _, c in ipairs(match.combatants) do\n\t\ttable.insert(roster, {\n\t\t\tmodel = c.model,\n\t\t\ttag = c.tag,\n\t\t\tname = c.participant.name,\n\t\t\trobotId = c.participant.robotId,\n\t\t\tteam = c.team,\n\t\t\tisBot = c.participant.kind == \"Bot\",\n\t\t\tspawnPos = c.spawnCF.Position,\n\t\t})\n\tend\n\tfor _, c in ipairs(match.combatants) do\n\t\tif c.participant.kind == \"Player\" then\n\t\t\tsend(c.participant.player, \"Start\", {\n\t\t\t\tmatchId = match.id,\n\t\t\t\tmode = mode,\n\t\t\t\tcenter = Vector3.new(origin.X, match.floorY, origin.Z),\n\t\t\t\thalf = Config.Arena.Half,\n\t\t\t\tlocalModel = c.model,\n\t\t\t\troster = roster,\n\t\t\t\tstartTime = match.startTime,\n\t\t\t\tlaunchTime = match.launchTime,\n\t\t\t\tduration = M.Duration,\n\t\t\t})\n\t\tend\n\tend\n\ttask.delay(M.IntroTime, function()\n\t\tmatch:Launch()\n\tend)\n\treturn match\nend\n\n----------------------------------------------------------------------------------------------\n-- Results, cleanup, rematch\n----------------------------------------------------------------------------------------------\nlocal function statsOf(c)\n\treturn {\n\t\tname = c.participant.name,\n\t\ttag = c.tag,\n\t\trobotId = c.participant.robotId,\n\t\thp = c.hp,\n\t\tmaxHp = c.maxHp,\n\t\tdamageDealt = c.stats.damageDealt,\n\t\tdamageTaken = c.stats.damageTaken,\n\t\tdowns = c.stats.downs,\n\t\thits = c.stats.hits,\n\t\tisBot = c.participant.kind == \"Bot\",\n\t\tleft = c.participant.left == true,\n\t}\nend\n\nlocal function cleanup(match)\n\tfor _, c in ipairs(match.combatants) do\n\t\tBotAI.Detach(c)\n\t\tRobotSpawner.Despawn(c.participant, c.model)\n\tend\n\tif match.arena then\n\t\tmatch.arena:Destroy()\n\tend\n\tslots[match.slot] = nil\n\tMatchService.matches[match.id] = nil\nend\n\nfunction MatchService.ShowResults(match)\n\tif match.state == \"Ended\" then\n\t\treturn\n\tend\n\tmatch.state = \"Ended\"\n\tlocal winner = match.winner\n\tlocal duration = (match.finishedAt or now()) - (match.launchedAt or match.startTime)\n\tlocal humans = {}\n\tfor _, c in ipairs(match.combatants) do\n\t\tlocal p = c.participant\n\t\tif p.kind == \"Player\" and not p.left and p.player.Parent then\n\t\t\tlocal s = MatchService.GetSession(p.player)\n\t\t\tif s.match == match then\n\t\t\t\tlocal others = {}\n\t\t\t\tfor _, o in ipairs(match.combatants) do\n\t\t\t\t\tif o ~= c then\n\t\t\t\t\t\ttable.insert(others, statsOf(o))\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tlocal outcome = winner == nil and \"DRAW\" or (winner == c and \"WIN\" or \"LOSE\")\n\t\t\t\tsend(p.player, \"Results\", {\n\t\t\t\t\toutcome = outcome,\n\t\t\t\t\treason = match.reason,\n\t\t\t\t\tperfect = match.perfect and winner == c,\n\t\t\t\t\tyou = statsOf(c),\n\t\t\t\t\tothers = others,\n\t\t\t\t\tduration = duration,\n\t\t\t\t\tmode = match.mode,\n\t\t\t\t})\n\t\t\t\ts.status = \"Results\"\n\t\t\t\ts.match = nil\n\t\t\t\ts.combatant = nil\n\t\t\t\ttable.insert(humans, p.player)\n\t\t\tend\n\t\tend\n\tend\n\tcleanup(match)\n\n\tif #humans > 0 then\n\t\tlocal specs = {}\n\t\tfor _, spec in ipairs(match.specs) do\n\t\t\tif spec.kind == \"Player\" then\n\t\t\t\ttable.insert(specs, { kind = \"Player\", player = spec.player })\n\t\t\telse\n\t\t\t\ttable.insert(specs, { kind = \"Bot\", robotId = spec.robotId, name = spec.name })\n\t\t\tend\n\t\tend\n\t\tlocal group = { mode = match.mode, specs = specs, humans = humans, votes = {}, closed = false }\n\t\t-- every original human must still be here for a rematch\n\t\tfor _, spec in ipairs(match.specs) do\n\t\t\tif spec.kind == \"Player\" and not table.find(humans, spec.player) then\n\t\t\t\tgroup.closed = true\n\t\t\tend\n\t\tend\n\t\tfor _, h in ipairs(humans) do\n\t\t\tMatchService.GetSession(h).rematch = group\n\t\tend\n\t\ttask.delay(M.RematchTimeout, function()\n\t\t\tif not group.closed then\n\t\t\t\tgroup.closed = true\n\t\t\t\tfor _, h in ipairs(group.humans) do\n\t\t\t\t\tlocal s = MatchService.sessions[h]\n\t\t\t\t\tif s and s.rematch == group then\n\t\t\t\t\t\ts.rematch = nil\n\t\t\t\t\t\tsend(h, \"Rematch\", { status = \"closed\", reason = \"Rematch timed out\" })\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend)\n\tend\nend\n\nlocal function closeGroup(group, leaver: Player?, reason: string)\n\tif not group or group.closed then\n\t\treturn\n\tend\n\tgroup.closed = true\n\tfor _, h in ipairs(group.humans) do\n\t\tlocal s = MatchService.sessions[h]\n\t\tif s and s.rematch == group then\n\t\t\ts.rematch = nil\n\t\t\tif h ~= leaver then\n\t\t\t\tsend(h, \"Rematch\", { status = \"closed\", reason = reason })\n\t\t\tend\n\t\tend\n\tend\nend\n\nfunction MatchService.RequestRematch(player: Player)\n\tlocal s = MatchService.GetSession(player)\n\tlocal group = s.rematch\n\tif s.status ~= \"Results\" or not group or group.closed then\n\t\tsend(player, \"Rematch\", { status = \"closed\", reason = \"Rematch unavailable\" })\n\t\treturn\n\tend\n\tgroup.votes[player] = true\n\tlocal count = 0\n\tfor _, h in ipairs(group.humans) do\n\t\tif group.votes[h] then\n\t\t\tcount += 1\n\t\tend\n\tend\n\tif count >= #group.humans then\n\t\tgroup.closed = true\n\t\tfor _, h in ipairs(group.humans) do\n\t\t\tMatchService.GetSession(h).rematch = nil\n\t\t\tsend(h, \"Rematch\", { status = \"starting\" })\n\t\tend\n\t\tMatchService.Create(group.specs, group.mode)\n\telse\n\t\tfor _, h in ipairs(group.humans) do\n\t\t\tsend(h, \"Rematch\", { status = \"waiting\", votes = count, needed = #group.humans })\n\t\tend\n\tend\nend\n\nfunction MatchService.LeaveResults(player: Player)\n\tlocal s = MatchService.GetSession(player)\n\tif s.status == \"Results\" then\n\t\ts.status = \"Menu\"\n\tend\n\tcloseGroup(s.rematch, player, \"Opponent left\")\n\ts.rematch = nil\nend\n\nfunction MatchService.StartBotMatch(player: Player)\n\tlocal s = MatchService.GetSession(player)\n\tif s.status ~= \"Menu\" and s.status ~= \"Results\" then\n\t\treturn\n\tend\n\tcloseGroup(s.rematch, player, \"Opponent left\")\n\tlocal robots = Config.Robots\n\tlocal botRobot = robots[math.random(1, #robots)].Id\n\tMatchService.Create({ { kind = \"Player\", player = player }, { kind = \"Bot\", robotId = botRobot } }, \"Bot\")\nend\n\nfunction MatchService.OnPlayerLeft(player: Player)\n\tlocal s = MatchService.sessions[player]\n\tif not s then\n\t\treturn\n\tend\n\tcloseGroup(s.rematch, player, \"Opponent left\")\n\tlocal match = s.match\n\tif match and match.state ~= \"Ended\" then\n\t\tfor _, c in ipairs(match.combatants) do\n\t\t\tif c.participant.player == player then\n\t\t\t\tc.participant.left = true\n\t\t\t\tif match.state == \"Intro\" or match.state == \"Fight\" then\n\t\t\t\t\tc.alive = false\n\t\t\t\t\tif c.model then\n\t\t\t\t\t\tc.model:Destroy()\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\tif match.state == \"Intro\" or match.state == \"Fight\" then\n\t\t\tlocal alive = aliveTeams(match)\n\t\t\tif #alive <= 1 then\n\t\t\t\tif match.state == \"Intro\" then\n\t\t\t\t\tmatch.state = \"Fight\"\n\t\t\t\tend\n\t\t\t\tmatch:Finish(\"LEFT\", alive[1])\n\t\t\tend\n\t\tend\n\t\t-- No humans left at all: tear down immediately.\n\t\tif #match:Humans() == 0 and match.state ~= \"Ended\" then\n\t\t\tmatch.state = \"Ended\"\n\t\t\tcleanup(match)\n\t\tend\n\tend\n\tMatchService.sessions[player] = nil\nend\n\nfunction MatchService.Step(dt: number)\n\tfor _, match in pairs(MatchService.matches) do\n\t\tlocal ok, err = pcall(match.Step, match, dt)\n\t\tif not ok then\n\t\t\twarn(\"[RoboClash] match step error: \" .. tostring(err))\n\t\tend\n\tend\nend\n\nfunction MatchService.CountActive(): number\n\tlocal n = 0\n\tfor _ in pairs(MatchService.matches) do\n\t\tn += 1\n\tend\n\treturn n\nend\n\nPlayers.PlayerRemoving:Connect(function(player)\n\tMatchService.OnPlayerLeft(player)\nend)\n\nreturn MatchService\n","message":"The file /Users/chase-mini/src/rca-work/src/ServerScriptService/RoboClash/MatchService.luau has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"toolu_01SzcGByKX6Z3KU9gxfptSjg","startedAtMs":"1791073891250","completedAtMs":"1791073891833"},"model_call_id":"f6f75537-51d9-46fb-a6c9-81f06ac674d8-44-vv9j","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791073891839}
{"type":"tool_call","subtype":"started","call_id":"toolu_01MCGUydj3VLovbUFAzD9Ae2","tool_call":{"editToolCall":{"args":{"path":"/Users/chase-mini/src/rca-work/src/ServerScriptService/RoboClash/MatchmakingService.luau","streamContent":"-- In-server matchmaking: a FIFO queue of humans; the first two are paired into a PvP match.\n-- (Later: cross-server via MemoryStoreService + TeleportService:ReserveServer.)\nlocal Players = game:GetService(\"Players\")\n\nlocal MatchService = require(script.Parent.MatchService)\n\nlocal Matchmaking = {}\nMatchmaking.queue = {} -- list of entries { player = Player } (or { fake = true, robotId } in tests)\n\nlocal function indexOf(player: Player): number?\n\tfor i, e in ipairs(Matchmaking.queue) do\n\t\tif e.player == player then\n\t\t\treturn i\n\t\tend\n\tend\n\treturn nil\nend\n\nfunction Matchmaking.Broadcast()\n\tlocal count = #Matchmaking.queue\n\tlocal online = #Players:GetPlayers()\n\tfor i, e in ipairs(Matchmaking.queue) do\n\t\tif e.player then\n\t\t\tMatchService.Send(e.player, \"Queue\", { inQueue = true, position = i, count = count, online = online })\n\t\tend\n\tend\nend\n\nlocal function tryPair()\n\twhile #Matchmaking.queue >= 2 do\n\t\tlocal a = table.remove(Matchmaking.queue, 1)\n\t\tlocal b = table.remove(Matchmaking.queue, 1)\n\t\tlocal specs = {}\n\t\tfor _, e in ipairs({ a, b }) do\n\t\t\tif e.fake then\n\t\t\t\ttable.insert(specs, { kind = \"Bot\", robotId = e.robotId, name = e.name or \"TEST RIVAL\" })\n\t\t\telse\n\t\t\t\ttable.insert(specs, { kind = \"Player\", player = e.player })\n\t\t\tend\n\t\tend\n\t\tfor _, e in ipairs({ a, b }) do\n\t\t\tif e.player then\n\t\t\t\tMatchService.Send(e.player, \"Queue\", { inQueue = false, matched = true })\n\t\t\tend\n\t\tend\n\t\tMatchmaking.lastPair = { a, b }\n\t\tMatchService.Create(specs, \"PvP\")\n\tend\n\tMatchmaking.Broadcast()\nend\n\nfunction Matchmaking.Enqueue(player: Player): boolean\n\tlocal s = MatchService.GetSession(player)\n\tif s.status ~= \"Menu\" and s.status ~= \"Results\" then\n\t\treturn false\n\tend\n\tif s.status == \"Results\" then\n\t\tMatchService.LeaveResults(player)\n\tend\n\tif indexOf(player) then\n\t\treturn true\n\tend\n\ts.status = \"Queue\"\n\ttable.insert(Matchmaking.queue, { player = player })\n\ttryPair()\n\treturn true\nend\n\nfunction Matchmaking.Dequeue(player: Player)\n\tlocal i = indexOf(player)\n\tif i then\n\t\ttable.remove(Matchmaking.queue, i)\n\tend\n\tlocal s = MatchService.sessions[player]\n\tif s and s.status == \"Queue\" then\n\t\ts.status = \"Menu\"\n\tend\n\tMatchService.Send(player, \"Queue\", { inQueue = false })\n\tMatchmaking.Broadcast()\nend\n\n-- Test harness only: enqueue a fake opponent that becomes a bot participant in a PvP-mode match.\nfunction Matchmaking.EnqueueFake(robotId: string, name: string?)\n\ttable.insert(Matchmaking.queue, { fake = true, robotId = robotId, name = name })\n\ttryPair()\nend\n\nPlayers.PlayerRemoving:Connect(function(player)\n\tlocal i = indexOf(player)\n\tif i then\n\t\ttable.remove(Matchmaking.queue, i)\n\t\tMatchmaking.Broadcast()\n\tend\nend)\n\nreturn Matchmaking\n"}},"hookAdditionalContexts":[],"toolCallId":"toolu_01MCGUydj3VLovbUFAzD9Ae2","startedAtMs":"1791073891260"},"model_call_id":"f6f75537-51d9-46fb-a6c9-81f06ac674d8-44-vv9j","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791073898531}
