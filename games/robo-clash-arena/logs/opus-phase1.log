{"type":"tool_call","subtype":"started","call_id":"toolu_013LevKPBdMnuj2kdewiA8C6","tool_call":{"editToolCall":{"args":{"path":"/Users/chase-mini/src/rca-work/src/ServerScriptService/RoboClash/CombatService.luau","streamContent":"-- Server-authoritative combat: weapon intents, projectile simulation, blasts, damage,\n-- endurance -> DOWN -> REBIRTH, body dash attacks, pits. Operates on match objects owned by\n-- MatchService; works for any number of combatants (nearest enemy = lock-on target).\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal RC = ReplicatedStorage:WaitForChild(\"RoboClash\")\nlocal Config = require(RC.Config)\nlocal Util = require(RC.Shared.Util)\nlocal Sim = require(RC.Shared.ProjectileSim)\n\nlocal M = Config.Match\nlocal Combat = {}\n\nlocal function now(): number\n\treturn workspace:GetServerTimeNow()\nend\nCombat.now = now\n\nlocal POD_KINDS = { Seeker = true, Mine = true, Orbit = true }\n\n----------------------------------------------------------------------------------------------\n-- Combatant setup\n----------------------------------------------------------------------------------------------\nfunction Combat.NewCombatant(match, participant, model: Model, info, spawnCF: CFrame)\n\tlocal loadout = Config.GetLoadout(participant.robotId)\n\tlocal c = {\n\t\tmatch = match,\n\t\tparticipant = participant,\n\t\tindex = participant.index,\n\t\tteam = participant.team,\n\t\ttag = participant.tag,\n\t\tmodel = model,\n\t\troot = model:FindFirstChild(\"HumanoidRootPart\"),\n\t\thum = model:FindFirstChildOfClass(\"Humanoid\"),\n\t\tloadout = loadout,\n\t\tinfo = info,\n\t\tspawnCF = spawnCF,\n\t\thp = M.MaxHP,\n\t\tmaxHp = M.MaxHP,\n\t\tendurance = M.EnduranceMax,\n\t\tstate = \"Normal\",\n\t\tstateUntil = 0,\n\t\tinvulnUntil = 0,\n\t\tgunReadyAt = 0,\n\t\tammo = loadout.Gun.Clip or 0,\n\t\treloadUntil = 0,\n\t\tgunHeld = false,\n\t\tchargeStart = nil,\n\t\tburstLeft = 0,\n\t\tnextShotAt = 0,\n\t\tbombReadyAt = 0,\n\t\tpodReadyAt = 0,\n\t\tdashUntil = 0,\n\t\tdashDir = Vector3.zero,\n\t\tdashHit = {},\n\t\tlastDashIntent = 0,\n\t\tlastDashHitAt = 0,\n\t\tlastHitAt = 0,\n\t\tcomboDamage = 0,\n\t\tcomboUntil = 0,\n\t\talive = true,\n\t\tstats = { damageDealt = 0, damageTaken = 0, downs = 0, hits = 0 },\n\t}\n\tCombat.SyncAttributes(c)\n\treturn c\nend\n\nfunction Combat.SyncAttributes(c)\n\tlocal m = c.model\n\tif not m or not m.Parent then\n\t\treturn\n\tend\n\tm:SetAttribute(\"HP\", c.hp)\n\tm:SetAttribute(\"MaxHP\", c.maxHp)\n\tm:SetAttribute(\"Pips\", math.clamp(math.ceil(c.endurance / M.EndurancePerPip - 1e-6), 0, 3))\n\tm:SetAttribute(\"Ammo\", c.ammo)\n\tm:SetAttribute(\"Clip\", c.loadout.Gun.Clip or 0)\n\tm:SetAttribute(\"ReloadUntil\", c.reloadUntil)\n\tm:SetAttribute(\"GunReadyAt\", c.gunReadyAt)\n\tm:SetAttribute(\"BombReadyAt\", c.bombReadyAt)\n\tm:SetAttribute(\"PodReadyAt\", c.podReadyAt)\nend\n\nlocal function setState(c, state: string, untilT: number)\n\tc.state = state\n\tc.stateUntil = untilT\n\tif c.model and c.model.Parent then\n\t\tc.model:SetAttribute(\"State\", state)\n\t\tc.model:SetAttribute(\"StateUntil\", untilT)\n\tend\nend\nCombat.SetState = setState\n\nfunction Combat.AimPoint(c): Vector3\n\treturn c.root.Position + Vector3.new(0, c.info.aimY, 0)\nend\n\nfunction Combat.GetTarget(match, c)\n\tlocal best, bestD = nil, math.huge\n\tfor _, o in ipairs(match.combatants) do\n\t\tif o ~= c and o.alive and o.team ~= c.team and o.root then\n\t\t\tlocal d = (o.root.Position - c.root.Position).Magnitude\n\t\t\tif d < bestD then\n\t\t\t\tbest, bestD = o, d\n\t\t\tend\n\t\tend\n\tend\n\treturn best, bestD\nend\n\nlocal function isInvulnerable(c, t: number): boolean\n\treturn c.state == \"Rebirth\" or t < c.invulnUntil or not c.alive\nend\nCombat.IsInvulnerable = isInvulnerable\n\nlocal function canAct(match, c): boolean\n\treturn match.state == \"Fight\" and c.alive and c.state ~= \"Down\"\nend\n\n----------------------------------------------------------------------------------------------\n-- Knockback / state changes\n----------------------------------------------------------------------------------------------\nlocal function applyKnock(c, dir: Vector3, speed: number, up: number, dur: number)\n\tspeed *= c.loadout.Body.KnockbackMult\n\tlocal vel = Util.flatUnit(dir, c.root.CFrame.LookVector * -1) * speed\n\tif c.participant.kind == \"Player\" then\n\t\tlocal p = c.participant.player\n\t\tif p.Parent then\n\t\t\tc.match.remotes.Match:FireClient(p, \"Knock\", vel, up, dur)\n\t\tend\n\telseif c.mover then\n\t\tc.mover:Knockback(vel, up, dur)\n\tend\nend\nCombat.ApplyKnock = applyKnock\n\nfunction Combat.KnockDown(match, victim, attacker, dir: Vector3)\n\tlocal t = now()\n\tsetState(victim, \"Down\", t + M.DownTime)\n\tvictim.endurance = M.EnduranceMax\n\tvictim.gunHeld = false\n\tvictim.chargeStart = nil\n\tvictim.burstLeft = 0\n\tvictim.dashUntil = 0\n\tif attacker then\n\t\tattacker.stats.downs += 1\n\tend\n\tapplyKnock(victim, dir, 48, 26, 0.45)\n\tmatch:FireAll(\"FX\", \"Down\", { model = victim.model })\nend\n\n----------------------------------------------------------------------------------------------\n-- Damage\n----------------------------------------------------------------------------------------------\n-- info: { downPower, knock, up, forceDown, dir (Vector3), pos (Vector3), source }\nfunction Combat.Damage(match, victim, amount: number, attacker, info)\n\tif match.state ~= \"Fight\" or not victim.alive then\n\t\treturn false\n\tend\n\tlocal t = now()\n\tif isInvulnerable(victim, t) then\n\t\treturn false\n\tend\n\tlocal wasDown = victim.state == \"Down\"\n\tif wasDown then\n\t\tamount *= M.DownDamageMult\n\tend\n\tamount = math.max(1, math.floor(amount + 0.5))\n\tvictim.hp = math.max(0, victim.hp - amount)\n\tvictim.stats.damageTaken += amount\n\tvictim.lastHitAt = t\n\tif attacker then\n\t\tattacker.stats.damageDealt += amount\n\t\tattacker.stats.hits += 1\n\tend\n\n\tlocal dir = info.dir or (attacker and Util.flat(victim.root.Position - attacker.root.Position)) or Vector3.zAxis\n\tlocal heavy = false\n\tif not wasDown then\n\t\tvictim.endurance -= info.downPower or 0\n\t\tif victim.hp > 0 and (info.forceDown or victim.endurance <= 0) then\n\t\t\tCombat.KnockDown(match, victim, attacker, dir)\n\t\t\theavy = true\n\t\telse\n\t\t\tif (info.knock or 0) > 0 or (info.up or 0) > 0 then\n\t\t\t\tapplyKnock(victim, dir, info.knock or 0, info.up or 0, 0.22)\n\t\t\tend\n\t\t\theavy = amount >= 70\n\t\tend\n\tend\n\n\tif t < victim.comboUntil then\n\t\tvictim.comboDamage += amount\n\telse\n\t\tvictim.comboDamage = amount\n\tend\n\tvictim.comboUntil = t + M.ComboWindow\n\n\tCombat.SyncAttributes(victim)\n\tmatch:FireAll(\"FX\", \"Hit\", {\n\t\tvictim = victim.model,\n\t\tattacker = attacker and attacker.model,\n\t\tpos = info.pos or Combat.AimPoint(victim),\n\t\tamount = amount,\n\t\tcombo = victim.comboDamage,\n\t\theavy = heavy,\n\t\tdown = wasDown,\n\t\tsource = info.source,\n\t})\n\n\tif victim.hp <= 0 then\n\t\tmatch:OnKO(victim, attacker)\n\tend\n\treturn true\nend\n\n----------------------------------------------------------------------------------------------\n-- Projectiles\n----------------------------------------------------------------------------------------------\nlocal function tipPos(c, attName: string): Vector3\n\tlocal att = c.model:FindFirstChild(attName, true)\n\tif att and att:IsA(\"Attachment\") then\n\t\treturn att.WorldPosition\n\tend\n\treturn c.root.Position\nend\n\nlocal function serializeProj(p)\n\treturn {\n\t\tid = p.id,\n\t\tkind = p.kind,\n\t\tstyle = p.style,\n\t\tpos = p.pos,\n\t\tdir = p.dir,\n\t\tspeed = p.speed,\n\t\tturn = p.turn,\n\t\taccel = p.accel,\n\t\tlife = p.life,\n\t\tsize = p.size,\n\t\tcolor = p.color,\n\t\ttarget = p.target and p.target.model,\n\t\towner = p.owner.model,\n\t\thoming = p.homing,\n\t\tstart = p.start,\n\t\tfinish = p.finish,\n\t\tflight = p.flight,\n\t\tapex = p.apex,\n\t\tfloorY = p.floorY,\n\t\thover = p.hover,\n\t\tclimb = p.climb,\n\t\tlaunchDir = p.launchDir,\n\t\tlaunchTime = p.launchTime,\n\t\tlaunchSpeed = p.launchSpeed,\n\t\tthrowTime = p.throwTime,\n\t\tarmTime = p.armTime,\n\t\tradius = p.blastRadius,\n\t\tt0 = p.t0,\n\t}\nend\n\nlocal function spawnProj(match, owner, p)\n\tmatch.nextProjId += 1\n\tp.id = match.nextProjId\n\tp.owner = owner\n\tp.age = 0\n\tp.t0 = now()\n\tmatch.projectiles[p.id] = p\n\tmatch:FireAll(\"FX\", \"Proj\", serializeProj(p))\n\treturn p\nend\n\nlocal function endProj(match, p, reason: string, pos: Vector3?)\n\tmatch.projectiles[p.id] = nil\n\tmatch:FireAll(\"FX\", \"ProjEnd\", { id = p.id, pos = pos or p.pos, reason = reason })\nend\n\nlocal function spawnBlast(match, owner, pos: Vector3, w, color: Color3)\n\tlocal b = {\n\t\towner = owner,\n\t\tpos = pos,\n\t\tradius = w.Radius,\n\t\tt0 = now(),\n\t\tuntilT = now() + (w.Linger or 0.6),\n\t\tdamage = w.Damage,\n\t\tdownPower = w.DownPower,\n\t\tknock = w.Knock,\n\t\tup = w.Up,\n\t\thit = {},\n\t\tsource = w.Name,\n\t}\n\ttable.insert(match.blasts, b)\n\tmatch:FireAll(\"FX\", \"Blast\", { pos = pos, radius = w.Radius, linger = w.Linger or 0.6, color = color, big = w.Radius >= 12 })\nend\n\nlocal function aimDir(c, from: Vector3, target): Vector3\n\tif target then\n\t\tlocal to = Combat.AimPoint(target) - from\n\t\tif to.Magnitude > 0.1 then\n\t\t\treturn to.Unit\n\t\tend\n\tend\n\treturn c.root.CFrame.LookVector\nend\n\nlocal function jitter(dir: Vector3, deg: number): Vector3\n\tif deg <= 0 then\n\t\treturn dir\n\tend\n\tlocal yaw = math.rad((math.random() * 2 - 1) * deg)\n\tlocal pitch = math.rad((math.random() * 2 - 1) * deg * 0.4)\n\treturn (CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0) * dir).Unit\nend\n\nlocal function fireBullet(match, c, target, spec, color: Color3, dir: Vector3, style: string?)\n\tlocal turnMul = c.aiTurnMul or 1\n\tspawnProj(match, c, {\n\t\tkind = \"Bullet\",\n\t\tstyle = style or \"Bullet\",\n\t\tpos = tipPos(c, \"GunTip\"),\n\t\tdir = dir,\n\t\tspeed = spec.Speed,\n\t\tturn = math.rad(spec.Turn) * turnMul,\n\t\taccel = spec.Accel,\n\t\tlife = spec.Life,\n\t\tradius = spec.Radius,\n\t\tsize = spec.Size or 0.9,\n\t\tcolor = color,\n\t\ttarget = target,\n\t\thoming = true,\n\t\tdamage = spec.Damage,\n\t\tdownPower = spec.DownPower,\n\t\tknock = spec.Knock,\n\t\tup = spec.Up,\n\t\tforceDown = spec.ForceDown,\n\t\tsource = style,\n\t})\nend\n\nlocal function onGunFired(match, c, gun)\n\tmatch:FireAll(\"FX\", \"Fire\", { model = c.model, weapon = \"Gun\", gunType = gun.Type, slow = gun.MoveSlow, slowTime = gun.SlowTime })\nend\n\nlocal function triggerGun(match, c)\n\tlocal gun = c.loadout.Gun\n\tlocal t = now()\n\tif gun.Type == \"Charge\" then\n\t\treturn\n\tend\n\tif t < c.gunReadyAt or t < c.reloadUntil or c.burstLeft > 0 then\n\t\treturn\n\tend\n\tif c.ammo <= 0 then\n\t\tc.ammo = gun.Clip\n\tend\n\tc.ammo -= 1\n\tc.gunReadyAt = t + gun.Cooldown\n\tif c.ammo <= 0 then\n\t\tc.reloadUntil = t + gun.Cooldown + gun.Reload\n\t\tc.ammo = gun.Clip\n\t\tc.gunReadyAt = c.reloadUntil\n\tend\n\tlocal target = Combat.GetTarget(match, c)\n\tif gun.Type == \"Burst\" then\n\t\tc.burstLeft = gun.Shots\n\t\tc.nextShotAt = t\n\telseif gun.Type == \"Spread\" then\n\t\tlocal from = tipPos(c, \"GunTip\")\n\t\tlocal base = jitter(aimDir(c, from, target), c.aiAimError or 0)\n\t\tlocal n = gun.Pellets\n\t\tfor i = 1, n do\n\t\t\tlocal a = math.rad(-gun.SpreadDeg / 2 + gun.SpreadDeg * (i - 1) / math.max(1, n - 1))\n\t\t\tfireBullet(match, c, target, gun, gun.Color, (CFrame.Angles(0, a, 0) * base).Unit, \"Pellet\")\n\t\tend\n\t\tonGunFired(match, c, gun)\n\tend\n\tCombat.SyncAttributes(c)\nend\n\nlocal function releaseCharge(match, c)\n\tlocal gun = c.loadout.Gun\n\tlocal t = now()\n\tlocal started = c.chargeStart\n\tc.chargeStart = nil\n\tmatch:FireAll(\"FX\", \"Charge\", { model = c.model, on = false })\n\tif not started or t < c.gunReadyAt then\n\t\treturn\n\tend\n\tlocal full = (t - started) >= gun.ChargeTime\n\tlocal spec = full and gun.Full or gun.Tap\n\tlocal target = Combat.GetTarget(match, c)\n\tlocal from = tipPos(c, \"GunTip\")\n\tfireBullet(match, c, target, spec, gun.Color, jitter(aimDir(c, from, target), c.aiAimError or 0), full and \"Beam\" or \"Bolt\")\n\tc.gunReadyAt = t + gun.Cooldown\n\tonGunFired(match, c, gun)\n\tCombat.SyncAttributes(c)\nend\n\nlocal function fireBomb(match, c)\n\tlocal bomb = c.loadout.Bomb\n\tlocal t = now()\n\tif t < c.bombReadyAt then\n\t\treturn\n\tend\n\tc.bombReadyAt = t + bomb.Cooldown\n\tlocal target = Combat.GetTarget(match, c)\n\tlocal from = tipPos(c, \"BombTip\")\n\tlocal myFlat = Util.flat(c.root.Position)\n\tlocal aim\n\tif target then\n\t\tlocal tv = Util.flat(target.root.AssemblyLinearVelocity)\n\t\taim = Util.flat(target.root.Position) + tv * bomb.FlightTime * bomb.Lead\n\t\tif c.aiAimError then\n\t\t\taim += Vector3.new(math.random() * 2 - 1, 0, math.random() * 2 - 1) * c.aiAimError * 0.6\n\t\tend\n\telse\n\t\taim = myFlat + Util.flatUnit(c.root.CFrame.LookVector) * 30\n\tend\n\tlocal off = aim - myFlat\n\tlocal dist = math.clamp(off.Magnitude, bomb.MinRange, bomb.MaxRange)\n\tlocal fwd = Util.flatUnit(off, Util.flatUnit(c.root.CFrame.LookVector))\n\tlocal right = Vector3.new(-fwd.Z, 0, fwd.X)\n\tfor i = 1, bomb.Count do\n\t\tlocal lateral = (i - (bomb.Count + 1) / 2) * bomb.Spread\n\t\tlocal land = myFlat + fwd * dist + right * lateral\n\t\tland = Vector3.new(land.X, match.floorY, land.Z)\n\t\tlocal hit = workspace:Raycast(land + Vector3.new(0, 40, 0), Vector3.new(0, -60, 0), match.rayParams)\n\t\tif hit then\n\t\t\tland = hit.Position\n\t\tend\n\t\tspawnProj(match, c, {\n\t\t\tkind = \"Bomb\",\n\t\t\tpos = from,\n\t\t\tstart = from,\n\t\t\tfinish = land,\n\t\t\tflight = bomb.FlightTime * (0.85 + 0.15 * dist / bomb.MaxRange),\n\t\t\tapex = bomb.Apex + math.max(0, from.Y - land.Y) * 0.25,\n\t\t\tlife = bomb.FlightTime + 1,\n\t\t\tsize = 1.6 + bomb.Radius * 0.06,\n\t\t\tcolor = bomb.Color,\n\t\t\tradius = 2.2,\n\t\t\tblast = bomb,\n\t\t})\n\tend\n\tmatch:FireAll(\"FX\", \"Fire\", { model = c.model, weapon = \"Bomb\", slow = 0.2, slowTime = bomb.Stall })\n\tCombat.SyncAttributes(c)\nend\n\nlocal function activePods(match, c): number\n\tlocal n = 0\n\tfor _, p in pairs(match.projectiles) do\n\t\tif p.owner == c and POD_KINDS[p.kind] then\n\t\t\tn += 1\n\t\tend\n\tend\n\treturn n\nend\n\nlocal function firePod(match, c)\n\tlocal pod = c.loadout.Pod\n\tlocal t = now()\n\tif t < c.podReadyAt or activePods(match, c) + pod.Count > pod.MaxActive then\n\t\treturn\n\tend\n\tc.podReadyAt = t + pod.Cooldown\n\tlocal target = Combat.GetTarget(match, c)\n\tlocal from = tipPos(c, \"PodTip\")\n\tlocal fwd = target and Util.flatUnit(target.root.Position - c.root.Position) or Util.flatUnit(c.root.CFrame.LookVector)\n\tlocal right = Vector3.new(-fwd.Z, 0, fwd.X)\n\tlocal common = {\n\t\tsize = pod.Size,\n\t\tcolor = pod.Color,\n\t\ttarget = target,\n\t\tlife = pod.Life,\n\t\tradius = pod.TriggerRadius,\n\t\tblast = pod,\n\t\tblastRadius = pod.Radius,\n\t}\n\tlocal function spawnOne(extra)\n\t\tlocal p = table.clone(common)\n\t\tfor k, v in pairs(extra) do\n\t\t\tp[k] = v\n\t\tend\n\t\tspawnProj(match, c, p)\n\tend\n\tif pod.Type == \"Seeker\" then\n\t\tspawnOne({\n\t\t\tkind = \"Seeker\",\n\t\t\tpos = from,\n\t\t\tdir = fwd,\n\t\t\tspeed = pod.Speed,\n\t\t\tturn = math.rad(pod.Turn),\n\t\t\tfloorY = match.floorY,\n\t\t\thover = pod.HoverHeight,\n\t\t\tclimb = pod.ClimbRate,\n\t\t})\n\telseif pod.Type == \"Mine\" then\n\t\tlocal land = Util.flat(c.root.Position) + fwd * pod.ThrowDist\n\t\tland = Vector3.new(land.X, match.floorY + 0.9, land.Z)\n\t\tlocal hit = workspace:Raycast(land + Vector3.new(0, 30, 0), Vector3.new(0, -50, 0), match.rayParams)\n\t\tif hit then\n\t\t\tland = hit.Position + Vector3.new(0, 0.9, 0)\n\t\tend\n\t\tspawnOne({\n\t\t\tkind = \"Mine\",\n\t\t\tpos = from,\n\t\t\tstart = from,\n\t\t\tfinish = land,\n\t\t\tthrowTime = pod.ThrowTime,\n\t\t\tarmTime = pod.ArmTime,\n\t\t})\n\telseif pod.Type == \"Orbit\" then\n\t\tfor _, s in ipairs({ -1, 1 }) do\n\t\t\tspawnOne({\n\t\t\t\tkind = \"Orbit\",\n\t\t\t\tpos = from,\n\t\t\t\tdir = fwd,\n\t\t\t\tspeed = pod.Speed,\n\t\t\t\tturn = math.rad(pod.Turn),\n\t\t\t\tlaunchDir = (right * s + Vector3.new(0, 0.35, 0)).Unit,\n\t\t\t\tlaunchTime = pod.LaunchTime,\n\t\t\t\tlaunchSpeed = pod.LaunchSide / pod.LaunchTime,\n\t\t\t})\n\t\tend\n\tend\n\tmatch:FireAll(\"FX\", \"Fire\", { model = c.model, weapon = \"Pod\", slow = 0.6, slowTime = 0.2 })\n\tCombat.SyncAttributes(c)\nend\n\n----------------------------------------------------------------------------------------------\n-- Intents (from player clients via Main, or from BotAI)\n----------------------------------------------------------------------------------------------\nfunction Combat.HandleIntent(match, c, action: string, payload)\n\tif not match or not c or not c.alive then\n\t\treturn\n\tend\n\tif action == \"GunUp\" then\n\t\tc.gunHeld = false\n\t\tif c.chargeStart then\n\t\t\tif canAct(match, c) then\n\t\t\t\treleaseCharge(match, c)\n\t\t\telse\n\t\t\t\tc.chargeStart = nil\n\t\t\tend\n\t\tend\n\t\treturn\n\tend\n\tif not canAct(match, c) then\n\t\treturn\n\tend\n\tlocal t = now()\n\tif action == \"GunDown\" then\n\t\tc.gunHeld = true\n\t\tif c.loadout.Gun.Type == \"Charge\" then\n\t\t\tif not c.chargeStart and t >= c.gunReadyAt - 0.05 then\n\t\t\t\tc.chargeStart = t\n\t\t\t\tmatch:FireAll(\"FX\", \"Charge\", { model = c.model, on = true, chargeTime = c.loadout.Gun.ChargeTime })\n\t\t\tend\n\t\telse\n\t\t\ttriggerGun(match, c)\n\t\tend\n\telseif action == \"Bomb\" then\n\t\tfireBomb(match, c)\n\telseif action == \"Pod\" then\n\t\tfirePod(match, c)\n\telseif action == \"Dash\" then\n\t\tif t - c.lastDashIntent < 0.18 then\n\t\t\treturn\n\t\tend\n\t\tc.lastDashIntent = t\n\t\tlocal dir = typeof(payload) == \"table\" and typeof(payload.dir) == \"Vector3\" and payload.dir or c.root.CFrame.LookVector\n\t\tc.dashDir = Util.flatUnit(dir, Util.flatUnit(c.root.CFrame.LookVector))\n\t\tc.dashUntil = t + math.max(c.loadout.Legs.DashTime, c.loadout.Legs.AirDashTime) + 0.08\n\t\tc.dashHit = {}\n\t\tmatch:FireAll(\"FX\", \"Dash\", { model = c.model, air = typeof(payload) == \"table\" and payload.air == true })\n\tend\nend\n\n----------------------------------------------------------------------------------------------\n-- Per-frame step\n----------------------------------------------------------------------------------------------\nlocal function capsule(c): (Vector3, Vector3)\n\tlocal p = c.root.Position\n\treturn p - Vector3.new(0, c.info.capDown, 0), p + Vector3.new(0, c.info.capUp, 0)\nend\n\nlocal function distToCapsule(c, a: Vector3, b: Vector3): number\n\tlocal lo, hi = capsule(c)\n\treturn Util.segSegDist(a, b, lo, hi) - c.info.hitRadius\nend\n\nlocal function explodePod(match, p)\n\tendProj(match, p, \"explode\", p.pos)\n\tspawnBlast(match, p.owner, p.pos, p.blast, p.color)\nend\n\nlocal function stepProjectiles(match, dt: number, t: number)\n\tfor _, p in pairs(match.projectiles) do\n\t\tlocal target = p.target\n\t\tlocal tpos = (target and target.alive and target.root) and Combat.AimPoint(target) or nil\n\t\tlocal prev = Sim.step(p, dt, tpos)\n\t\tlocal kind = p.kind\n\t\tlocal owner = p.owner\n\n\t\tif kind == \"Bullet\" then\n\t\t\tlocal seg = p.pos - prev\n\t\t\tlocal wall = seg.Magnitude > 0 and workspace:Raycast(prev, seg, match.rayParams)\n\t\t\tlocal hitC, hitDist = nil, math.huge\n\t\t\tfor _, e in ipairs(match.combatants) do\n\t\t\t\tif e ~= owner and e.alive and e.team ~= owner.team and not isInvulnerable(e, t) then\n\t\t\t\t\tlocal d = distToCapsule(e, prev, p.pos) - p.radius\n\t\t\t\t\tif d <= 0 then\n\t\t\t\t\t\tlocal along = (e.root.Position - prev).Magnitude\n\t\t\t\t\t\tif along < hitDist then\n\t\t\t\t\t\t\thitC, hitDist = e, along\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\tif hitC and (not wall or (wall.Position - prev).Magnitude >= hitDist - 1) then\n\t\t\t\tendProj(match, p, \"hit\", p.pos)\n\t\t\t\tCombat.Damage(match, hitC, p.damage, owner, {\n\t\t\t\t\tdownPower = p.downPower,\n\t\t\t\t\tknock = p.knock,\n\t\t\t\t\tup = p.up,\n\t\t\t\t\tforceDown = p.forceDown,\n\t\t\t\t\tdir = Util.flat(p.dir),\n\t\t\t\t\tpos = p.pos,\n\t\t\t\t\tsource = p.source,\n\t\t\t\t})\n\t\t\telseif wall then\n\t\t\t\tendProj(match, p, \"wall\", wall.Position)\n\t\t\telseif p.age >= p.life then\n\t\t\t\tendProj(match, p, \"expire\", p.pos)\n\t\t\tend\n\t\telseif kind == \"Bomb\" then\n\t\t\tlocal direct = false\n\t\t\tfor _, e in ipairs(match.combatants) do\n\t\t\t\tif e ~= owner and e.alive and e.team ~= owner.team and not isInvulnerable(e, t) then\n\t\t\t\t\tif distToCapsule(e, prev, p.pos) <= p.radius then\n\t\t\t\t\t\tdirect = true\n\t\t\t\t\t\tbreak\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\tif direct or p.landed then\n\t\t\t\tendProj(match, p, \"explode\", p.pos)\n\t\t\t\tspawnBlast(match, owner, p.pos, p.blast, p.color)\n\t\t\tend\n\t\telseif kind == \"Seeker\" or kind == \"Orbit\" then\n\t\t\tlocal seg = p.pos - prev\n\t\t\tlocal wall = seg.Magnitude > 0 and workspace:Raycast(prev, seg, match.rayParams)\n\t\t\tlocal triggered = false\n\t\t\tfor _, e in ipairs(match.combatants) do\n\t\t\t\tif e ~= owner and e.alive and e.team ~= owner.team and not isInvulnerable(e, t) then\n\t\t\t\t\tif distToCapsule(e, prev, p.pos) <= p.radius then\n\t\t\t\t\t\ttriggered = true\n\t\t\t\t\t\tbreak\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\tif wall and not triggered then\n\t\t\t\tp.pos = wall.Position + wall.Normal * 0.5\n\t\t\tend\n\t\t\tif triggered or wall or p.age >= p.life then\n\t\t\t\texplodePod(match, p)\n\t\t\tend\n\t\telseif kind == \"Mine\" then\n\t\t\tlocal armed = p.landed and p.age >= p.throwTime + p.armTime\n\t\t\tlocal triggered = false\n\t\t\tif armed then\n\t\t\t\tfor _, e in ipairs(match.combatants) do\n\t\t\t\t\tif e ~= owner and e.alive and e.team ~= owner.team and not isInvulnerable(e, t) then\n\t\t\t\t\t\tif (e.root.Position - p.pos).Magnitude - e.info.hitRadius <= p.radius then\n\t\t\t\t\t\t\ttriggered = true\n\t\t\t\t\t\t\tbreak\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\tif triggered or p.age >= p.life then\n\t\t\t\texplodePod(match, p)\n\t\t\tend\n\t\tend\n\tend\n\n\t-- Periodic position sync for slow, long-lived pods so client visuals don't drift.\n\tif t - (match.lastPodSync or 0) > 0.25 then\n\t\tmatch.lastPodSync = t\n\t\tlocal sync = {}\n\t\tfor id, p in pairs(match.projectiles) do\n\t\t\tif p.kind == \"Seeker\" or p.kind == \"Orbit\" then\n\t\t\t\ttable.insert(sync, { id, p.pos, p.dir })\n\t\t\tend\n\t\tend\n\t\tif #sync > 0 then\n\t\t\tmatch:FireAll(\"FX\", \"ProjSync\", sync)\n\t\tend\n\tend\nend\n\nlocal function stepBlasts(match, t: number)\n\tlocal i = 1\n\tlocal blasts = match.blasts\n\twhile i <= #blasts do\n\t\tlocal b = blasts[i]\n\t\tif t >= b.untilT then\n\t\t\ttable.remove(blasts, i)\n\t\telse\n\t\t\tlocal grow = math.clamp((t - b.t0) / 0.15, 0.45, 1)\n\t\t\tlocal r = b.radius * grow\n\t\t\tfor _, e in ipairs(match.combatants) do\n\t\t\t\tif not b.hit[e] and e ~= b.owner and e.alive and e.team ~= b.owner.team and not isInvulnerable(e, t) then\n\t\t\t\t\tlocal lo, hi = capsule(e)\n\t\t\t\t\tlocal d = Util.segSegDist(b.pos, b.pos, lo, hi) - e.info.hitRadius\n\t\t\t\t\tif d <= r then\n\t\t\t\t\t\tb.hit[e] = true\n\t\t\t\t\t\tCombat.Damage(match, e, b.damage, b.owner, {\n\t\t\t\t\t\t\tdownPower = b.downPower,\n\t\t\t\t\t\t\tknock = b.knock,\n\t\t\t\t\t\t\tup = b.up,\n\t\t\t\t\t\t\tdir = Util.flat(e.root.Position - b.pos),\n\t\t\t\t\t\t\tpos = Combat.AimPoint(e),\n\t\t\t\t\t\t\tsource = b.source,\n\t\t\t\t\t\t})\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\ti += 1\n\t\tend\n\tend\nend\n\nlocal function stepCombatant(match, c, dt: number, t: number)\n\tif not c.alive or not c.root or not c.root.Parent then\n\t\treturn\n\tend\n\tlocal gun = c.loadout.Gun\n\n\t-- Down -> Rebirth -> Normal\n\tif c.state == \"Down\" and t >= c.stateUntil then\n\t\tsetState(c, \"Rebirth\", t + M.RebirthTime)\n\t\tc.invulnUntil = t + M.RebirthTime\n\t\tCombat.SyncAttributes(c)\n\t\tmatch:FireAll(\"FX\", \"Rebirth\", { model = c.model })\n\telseif c.state == \"Rebirth\" and t >= c.stateUntil then\n\t\tsetState(c, \"Normal\", 0)\n\tend\n\n\t-- Endurance regen\n\tif c.state ~= \"Down\" and c.endurance < M.EnduranceMax and t - c.lastHitAt > M.EnduranceRegenDelay then\n\t\tlocal before = math.ceil(c.endurance / M.EndurancePerPip)\n\t\tc.endurance = math.min(M.EnduranceMax, c.endurance + M.EnduranceRegenRate * dt)\n\t\tif math.ceil(c.endurance / M.EndurancePerPip) ~= before then\n\t\t\tCombat.SyncAttributes(c)\n\t\tend\n\tend\n\n\tif match.state ~= \"Fight\" then\n\t\treturn\n\tend\n\n\t-- Burst fire + held trigger auto-repeat\n\tif c.burstLeft > 0 and t >= c.nextShotAt and c.state ~= \"Down\" then\n\t\tlocal target = Combat.GetTarget(match, c)\n\t\tlocal from = tipPos(c, \"GunTip\")\n\t\tfireBullet(match, c, target, gun, gun.Color, jitter(aimDir(c, from, target), c.aiAimError or 0), \"Bullet\")\n\t\tif c.burstLeft == gun.Shots then\n\t\t\tonGunFired(match, c, gun)\n\t\tend\n\t\tc.burstLeft -= 1\n\t\tc.nextShotAt = t + gun.ShotInterval\n\tend\n\tif c.gunHeld and gun.Type ~= \"Charge\" and c.state ~= \"Down\" then\n\t\ttriggerGun(match, c)\n\tend\n\n\t-- Body dash attack\n\tif t < c.dashUntil and t - c.lastDashHitAt > 0.6 then\n\t\tfor _, e in ipairs(match.combatants) do\n\t\t\tif e ~= c and e.alive and e.team ~= c.team and not c.dashHit[e] and not isInvulnerable(e, t) then\n\t\t\t\tlocal d = (Util.flat(e.root.Position - c.root.Position)).Magnitude\n\t\t\t\tlocal dy = math.abs(e.root.Position.Y - c.root.Position.Y)\n\t\t\t\tif d <= c.info.hitRadius + e.info.hitRadius + 1.0 and dy < 5 then\n\t\t\t\t\tc.dashHit[e] = true\n\t\t\t\t\tc.lastDashHitAt = t\n\t\t\t\t\tlocal da = c.loadout.Body.DashAttack\n\t\t\t\t\tCombat.Damage(match, e, da.Damage, c, {\n\t\t\t\t\t\tdownPower = da.DownPower,\n\t\t\t\t\t\tknock = da.Knock,\n\t\t\t\t\t\tup = da.Up,\n\t\t\t\t\t\tdir = c.dashDir,\n\t\t\t\t\t\tpos = Combat.AimPoint(e),\n\t\t\t\t\t\tsource = da.Name,\n\t\t\t\t\t})\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\n\t-- Pits\n\tif c.root.Position.Y < match.floorY - M.PitFallDepth then\n\t\tc.hp = math.max(0, c.hp - M.PitDamage)\n\t\tc.stats.damageTaken += M.PitDamage\n\t\tc.invulnUntil = t + M.PitInvuln\n\t\tc.model:PivotTo(c.spawnCF * CFrame.new(0, c.info.rootY + 8, 0))\n\t\tc.root.AssemblyLinearVelocity = Vector3.zero\n\t\tif c.participant.kind == \"Player\" and c.participant.player.Parent then\n\t\t\tmatch.remotes.Match:FireClient(c.participant.player, \"Teleported\")\n\t\telseif c.mover then\n\t\t\tc.mover:ResetVelocity()\n\t\tend\n\t\tCombat.SyncAttributes(c)\n\t\tmatch:FireAll(\"FX\", \"Pit\", { model = c.model, amount = M.PitDamage })\n\t\tif c.hp <= 0 then\n\t\t\tmatch:OnKO(c, nil)\n\t\tend\n\tend\nend\n\nfunction Combat.Step(match, dt: number)\n\tlocal t = now()\n\tfor _, c in ipairs(match.combatants) do\n\t\tstepCombatant(match, c, dt, t)\n\tend\n\tif match.state == \"Fight\" then\n\t\tstepProjectiles(match, dt, t)\n\t\tstepBlasts(match, t)\n\tend\nend\n\nfunction Combat.ClearProjectiles(match)\n\tmatch.projectiles = {}\n\tmatch.blasts = {}\n\tmatch:FireAll(\"FX\", \"ClearProj\", {})\nend\n\nreturn Combat\n"}},"hookAdditionalContexts":[],"toolCallId":"toolu_013LevKPBdMnuj2kdewiA8C6","startedAtMs":"1791073728541"},"model_call_id":"f6f75537-51d9-46fb-a6c9-81f06ac674d8-42-boz8","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791073809671}
{"type":"tool_call","subtype":"completed","call_id":"toolu_013LevKPBdMnuj2kdewiA8C6","tool_call":{"editToolCall":{"args":{"path":"/Users/chase-mini/src/rca-work/src/ServerScriptService/RoboClash/CombatService.luau","streamContent":"-- Server-authoritative combat: weapon intents, projectile simulation, blasts, damage,\n-- endurance -> DOWN -> REBIRTH, body dash attacks, pits. Operates on match objects owned by\n-- MatchService; works for any number of combatants (nearest enemy = lock-on target).\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal RC = ReplicatedStorage:WaitForChild(\"RoboClash\")\nlocal Config = require(RC.Config)\nlocal Util = require(RC.Shared.Util)\nlocal Sim = require(RC.Shared.ProjectileSim)\n\nlocal M = Config.Match\nlocal Combat = {}\n\nlocal function now(): number\n\treturn workspace:GetServerTimeNow()\nend\nCombat.now = now\n\nlocal POD_KINDS = { Seeker = true, Mine = true, Orbit = true }\n\n----------------------------------------------------------------------------------------------\n-- Combatant setup\n----------------------------------------------------------------------------------------------\nfunction Combat.NewCombatant(match, participant, model: Model, info, spawnCF: CFrame)\n\tlocal loadout = Config.GetLoadout(participant.robotId)\n\tlocal c = {\n\t\tmatch = match,\n\t\tparticipant = participant,\n\t\tindex = participant.index,\n\t\tteam = participant.team,\n\t\ttag = participant.tag,\n\t\tmodel = model,\n\t\troot = model:FindFirstChild(\"HumanoidRootPart\"),\n\t\thum = model:FindFirstChildOfClass(\"Humanoid\"),\n\t\tloadout = loadout,\n\t\tinfo = info,\n\t\tspawnCF = spawnCF,\n\t\thp = M.MaxHP,\n\t\tmaxHp = M.MaxHP,\n\t\tendurance = M.EnduranceMax,\n\t\tstate = \"Normal\",\n\t\tstateUntil = 0,\n\t\tinvulnUntil = 0,\n\t\tgunReadyAt = 0,\n\t\tammo = loadout.Gun.Clip or 0,\n\t\treloadUntil = 0,\n\t\tgunHeld = false,\n\t\tchargeStart = nil,\n\t\tburstLeft = 0,\n\t\tnextShotAt = 0,\n\t\tbombReadyAt = 0,\n\t\tpodReadyAt = 0,\n\t\tdashUntil = 0,\n\t\tdashDir = Vector3.zero,\n\t\tdashHit = {},\n\t\tlastDashIntent = 0,\n\t\tlastDashHitAt = 0,\n\t\tlastHitAt = 0,\n\t\tcomboDamage = 0,\n\t\tcomboUntil = 0,\n\t\talive = true,\n\t\tstats = { damageDealt = 0, damageTaken = 0, downs = 0, hits = 0 },\n\t}\n\tCombat.SyncAttributes(c)\n\treturn c\nend\n\nfunction Combat.SyncAttributes(c)\n\tlocal m = c.model\n\tif not m or not m.Parent then\n\t\treturn\n\tend\n\tm:SetAttribute(\"HP\", c.hp)\n\tm:SetAttribute(\"MaxHP\", c.maxHp)\n\tm:SetAttribute(\"Pips\", math.clamp(math.ceil(c.endurance / M.EndurancePerPip - 1e-6), 0, 3))\n\tm:SetAttribute(\"Ammo\", c.ammo)\n\tm:SetAttribute(\"Clip\", c.loadout.Gun.Clip or 0)\n\tm:SetAttribute(\"ReloadUntil\", c.reloadUntil)\n\tm:SetAttribute(\"GunReadyAt\", c.gunReadyAt)\n\tm:SetAttribute(\"BombReadyAt\", c.bombReadyAt)\n\tm:SetAttribute(\"PodReadyAt\", c.podReadyAt)\nend\n\nlocal function setState(c, state: string, untilT: number)\n\tc.state = state\n\tc.stateUntil = untilT\n\tif c.model and c.model.Parent then\n\t\tc.model:SetAttribute(\"State\", state)\n\t\tc.model:SetAttribute(\"StateUntil\", untilT)\n\tend\nend\nCombat.SetState = setState\n\nfunction Combat.AimPoint(c): Vector3\n\treturn c.root.Position + Vector3.new(0, c.info.aimY, 0)\nend\n\nfunction Combat.GetTarget(match, c)\n\tlocal best, bestD = nil, math.huge\n\tfor _, o in ipairs(match.combatants) do\n\t\tif o ~= c and o.alive and o.team ~= c.team and o.root then\n\t\t\tlocal d = (o.root.Position - c.root.Position).Magnitude\n\t\t\tif d < bestD then\n\t\t\t\tbest, bestD = o, d\n\t\t\tend\n\t\tend\n\tend\n\treturn best, bestD\nend\n\nlocal function isInvulnerable(c, t: number): boolean\n\treturn c.state == \"Rebirth\" or t < c.invulnUntil or not c.alive\nend\nCombat.IsInvulnerable = isInvulnerable\n\nlocal function canAct(match, c): boolean\n\treturn match.state == \"Fight\" and c.alive and c.state ~= \"Down\"\nend\n\n----------------------------------------------------------------------------------------------\n-- Knockback / state changes\n----------------------------------------------------------------------------------------------\nlocal function applyKnock(c, dir: Vector3, speed: number, up: number, dur: number)\n\tspeed *= c.loadout.Body.KnockbackMult\n\tlocal vel = Util.flatUnit(dir, c.root.CFrame.LookVector * -1) * speed\n\tif c.participant.kind == \"Player\" then\n\t\tlocal p = c.participant.player\n\t\tif p.Parent then\n\t\t\tc.match.remotes.Match:FireClient(p, \"Knock\", vel, up, dur)\n\t\tend\n\telseif c.mover then\n\t\tc.mover:Knockback(vel, up, dur)\n\tend\nend\nCombat.ApplyKnock = applyKnock\n\nfunction Combat.KnockDown(match, victim, attacker, dir: Vector3)\n\tlocal t = now()\n\tsetState(victim, \"Down\", t + M.DownTime)\n\tvictim.endurance = M.EnduranceMax\n\tvictim.gunHeld = false\n\tvictim.chargeStart = nil\n\tvictim.burstLeft = 0\n\tvictim.dashUntil = 0\n\tif attacker then\n\t\tattacker.stats.downs += 1\n\tend\n\tapplyKnock(victim, dir, 48, 26, 0.45)\n\tmatch:FireAll(\"FX\", \"Down\", { model = victim.model })\nend\n\n----------------------------------------------------------------------------------------------\n-- Damage\n----------------------------------------------------------------------------------------------\n-- info: { downPower, knock, up, forceDown, dir (Vector3), pos (Vector3), source }\nfunction Combat.Damage(match, victim, amount: number, attacker, info)\n\tif match.state ~= \"Fight\" or not victim.alive then\n\t\treturn false\n\tend\n\tlocal t = now()\n\tif isInvulnerable(victim, t) then\n\t\treturn false\n\tend\n\tlocal wasDown = victim.state == \"Down\"\n\tif wasDown then\n\t\tamount *= M.DownDamageMult\n\tend\n\tamount = math.max(1, math.floor(amount + 0.5))\n\tvictim.hp = math.max(0, victim.hp - amount)\n\tvictim.stats.damageTaken += amount\n\tvictim.lastHitAt = t\n\tif attacker then\n\t\tattacker.stats.damageDealt += amount\n\t\tattacker.stats.hits += 1\n\tend\n\n\tlocal dir = info.dir or (attacker and Util.flat(victim.root.Position - attacker.root.Position)) or Vector3.zAxis\n\tlocal heavy = false\n\tif not wasDown then\n\t\tvictim.endurance -= info.downPower or 0\n\t\tif victim.hp > 0 and (info.forceDown or victim.endurance <= 0) then\n\t\t\tCombat.KnockDown(match, victim, attacker, dir)\n\t\t\theavy = true\n\t\telse\n\t\t\tif (info.knock or 0) > 0 or (info.up or 0) > 0 then\n\t\t\t\tapplyKnock(victim, dir, info.knock or 0, info.up or 0, 0.22)\n\t\t\tend\n\t\t\theavy = amount >= 70\n\t\tend\n\tend\n\n\tif t < victim.comboUntil then\n\t\tvictim.comboDamage += amount\n\telse\n\t\tvictim.comboDamage = amount\n\tend\n\tvictim.comboUntil = t + M.ComboWindow\n\n\tCombat.SyncAttributes(victim)\n\tmatch:FireAll(\"FX\", \"Hit\", {\n\t\tvictim = victim.model,\n\t\tattacker = attacker and attacker.model,\n\t\tpos = info.pos or Combat.AimPoint(victim),\n\t\tamount = amount,\n\t\tcombo = victim.comboDamage,\n\t\theavy = heavy,\n\t\tdown = wasDown,\n\t\tsource = info.source,\n\t})\n\n\tif victim.hp <= 0 then\n\t\tmatch:OnKO(victim, attacker)\n\tend\n\treturn true\nend\n\n----------------------------------------------------------------------------------------------\n-- Projectiles\n----------------------------------------------------------------------------------------------\nlocal function tipPos(c, attName: string): Vector3\n\tlocal att = c.model:FindFirstChild(attName, true)\n\tif att and att:IsA(\"Attachment\") then\n\t\treturn att.WorldPosition\n\tend\n\treturn c.root.Position\nend\n\nlocal function serializeProj(p)\n\treturn {\n\t\tid = p.id,\n\t\tkind = p.kind,\n\t\tstyle = p.style,\n\t\tpos = p.pos,\n\t\tdir = p.dir,\n\t\tspeed = p.speed,\n\t\tturn = p.turn,\n\t\taccel = p.accel,\n\t\tlife = p.life,\n\t\tsize = p.size,\n\t\tcolor = p.color,\n\t\ttarget = p.target and p.target.model,\n\t\towner = p.owner.model,\n\t\thoming = p.homing,\n\t\tstart = p.start,\n\t\tfinish = p.finish,\n\t\tflight = p.flight,\n\t\tapex = p.apex,\n\t\tfloorY = p.floorY,\n\t\thover = p.hover,\n\t\tclimb = p.climb,\n\t\tlaunchDir = p.launchDir,\n\t\tlaunchTime = p.launchTime,\n\t\tlaunchSpeed = p.launchSpeed,\n\t\tthrowTime = p.throwTime,\n\t\tarmTime = p.armTime,\n\t\tradius = p.blastRadius,\n\t\tt0 = p.t0,\n\t}\nend\n\nlocal function spawnProj(match, owner, p)\n\tmatch.nextProjId += 1\n\tp.id = match.nextProjId\n\tp.owner = owner\n\tp.age = 0\n\tp.t0 = now()\n\tmatch.projectiles[p.id] = p\n\tmatch:FireAll(\"FX\", \"Proj\", serializeProj(p))\n\treturn p\nend\n\nlocal function endProj(match, p, reason: string, pos: Vector3?)\n\tmatch.projectiles[p.id] = nil\n\tmatch:FireAll(\"FX\", \"ProjEnd\", { id = p.id, pos = pos or p.pos, reason = reason })\nend\n\nlocal function spawnBlast(match, owner, pos: Vector3, w, color: Color3)\n\tlocal b = {\n\t\towner = owner,\n\t\tpos = pos,\n\t\tradius = w.Radius,\n\t\tt0 = now(),\n\t\tuntilT = now() + (w.Linger or 0.6),\n\t\tdamage = w.Damage,\n\t\tdownPower = w.DownPower,\n\t\tknock = w.Knock,\n\t\tup = w.Up,\n\t\thit = {},\n\t\tsource = w.Name,\n\t}\n\ttable.insert(match.blasts, b)\n\tmatch:FireAll(\"FX\", \"Blast\", { pos = pos, radius = w.Radius, linger = w.Linger or 0.6, color = color, big = w.Radius >= 12 })\nend\n\nlocal function aimDir(c, from: Vector3, target): Vector3\n\tif target then\n\t\tlocal to = Combat.AimPoint(target) - from\n\t\tif to.Magnitude > 0.1 then\n\t\t\treturn to.Unit\n\t\tend\n\tend\n\treturn c.root.CFrame.LookVector\nend\n\nlocal function jitter(dir: Vector3, deg: number): Vector3\n\tif deg <= 0 then\n\t\treturn dir\n\tend\n\tlocal yaw = math.rad((math.random() * 2 - 1) * deg)\n\tlocal pitch = math.rad((math.random() * 2 - 1) * deg * 0.4)\n\treturn (CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0) * dir).Unit\nend\n\nlocal function fireBullet(match, c, target, spec, color: Color3, dir: Vector3, style: string?)\n\tlocal turnMul = c.aiTurnMul or 1\n\tspawnProj(match, c, {\n\t\tkind = \"Bullet\",\n\t\tstyle = style or \"Bullet\",\n\t\tpos = tipPos(c, \"GunTip\"),\n\t\tdir = dir,\n\t\tspeed = spec.Speed,\n\t\tturn = math.rad(spec.Turn) * turnMul,\n\t\taccel = spec.Accel,\n\t\tlife = spec.Life,\n\t\tradius = spec.Radius,\n\t\tsize = spec.Size or 0.9,\n\t\tcolor = color,\n\t\ttarget = target,\n\t\thoming = true,\n\t\tdamage = spec.Damage,\n\t\tdownPower = spec.DownPower,\n\t\tknock = spec.Knock,\n\t\tup = spec.Up,\n\t\tforceDown = spec.ForceDown,\n\t\tsource = style,\n\t})\nend\n\nlocal function onGunFired(match, c, gun)\n\tmatch:FireAll(\"FX\", \"Fire\", { model = c.model, weapon = \"Gun\", gunType = gun.Type, slow = gun.MoveSlow, slowTime = gun.SlowTime })\nend\n\nlocal function triggerGun(match, c)\n\tlocal gun = c.loadout.Gun\n\tlocal t = now()\n\tif gun.Type == \"Charge\" then\n\t\treturn\n\tend\n\tif t < c.gunReadyAt or t < c.reloadUntil or c.burstLeft > 0 then\n\t\treturn\n\tend\n\tif c.ammo <= 0 then\n\t\tc.ammo = gun.Clip\n\tend\n\tc.ammo -= 1\n\tc.gunReadyAt = t + gun.Cooldown\n\tif c.ammo <= 0 then\n\t\tc.reloadUntil = t + gun.Cooldown + gun.Reload\n\t\tc.ammo = gun.Clip\n\t\tc.gunReadyAt = c.reloadUntil\n\tend\n\tlocal target = Combat.GetTarget(match, c)\n\tif gun.Type == \"Burst\" then\n\t\tc.burstLeft = gun.Shots\n\t\tc.nextShotAt = t\n\telseif gun.Type == \"Spread\" then\n\t\tlocal from = tipPos(c, \"GunTip\")\n\t\tlocal base = jitter(aimDir(c, from, target), c.aiAimError or 0)\n\t\tlocal n = gun.Pellets\n\t\tfor i = 1, n do\n\t\t\tlocal a = math.rad(-gun.SpreadDeg / 2 + gun.SpreadDeg * (i - 1) / math.max(1, n - 1))\n\t\t\tfireBullet(match, c, target, gun, gun.Color, (CFrame.Angles(0, a, 0) * base).Unit, \"Pellet\")\n\t\tend\n\t\tonGunFired(match, c, gun)\n\tend\n\tCombat.SyncAttributes(c)\nend\n\nlocal function releaseCharge(match, c)\n\tlocal gun = c.loadout.Gun\n\tlocal t = now()\n\tlocal started = c.chargeStart\n\tc.chargeStart = nil\n\tmatch:FireAll(\"FX\", \"Charge\", { model = c.model, on = false })\n\tif not started or t < c.gunReadyAt then\n\t\treturn\n\tend\n\tlocal full = (t - started) >= gun.ChargeTime\n\tlocal spec = full and gun.Full or gun.Tap\n\tlocal target = Combat.GetTarget(match, c)\n\tlocal from = tipPos(c, \"GunTip\")\n\tfireBullet(match, c, target, spec, gun.Color, jitter(aimDir(c, from, target), c.aiAimError or 0), full and \"Beam\" or \"Bolt\")\n\tc.gunReadyAt = t + gun.Cooldown\n\tonGunFired(match, c, gun)\n\tCombat.SyncAttributes(c)\nend\n\nlocal function fireBomb(match, c)\n\tlocal bomb = c.loadout.Bomb\n\tlocal t = now()\n\tif t < c.bombReadyAt then\n\t\treturn\n\tend\n\tc.bombReadyAt = t + bomb.Cooldown\n\tlocal target = Combat.GetTarget(match, c)\n\tlocal from = tipPos(c, \"BombTip\")\n\tlocal myFlat = Util.flat(c.root.Position)\n\tlocal aim\n\tif target then\n\t\tlocal tv = Util.flat(target.root.AssemblyLinearVelocity)\n\t\taim = Util.flat(target.root.Position) + tv * bomb.FlightTime * bomb.Lead\n\t\tif c.aiAimError then\n\t\t\taim += Vector3.new(math.random() * 2 - 1, 0, math.random() * 2 - 1) * c.aiAimError * 0.6\n\t\tend\n\telse\n\t\taim = myFlat + Util.flatUnit(c.root.CFrame.LookVector) * 30\n\tend\n\tlocal off = aim - myFlat\n\tlocal dist = math.clamp(off.Magnitude, bomb.MinRange, bomb.MaxRange)\n\tlocal fwd = Util.flatUnit(off, Util.flatUnit(c.root.CFrame.LookVector))\n\tlocal right = Vector3.new(-fwd.Z, 0, fwd.X)\n\tfor i = 1, bomb.Count do\n\t\tlocal lateral = (i - (bomb.Count + 1) / 2) * bomb.Spread\n\t\tlocal land = myFlat + fwd * dist + right * lateral\n\t\tland = Vector3.new(land.X, match.floorY, land.Z)\n\t\tlocal hit = workspace:Raycast(land + Vector3.new(0, 40, 0), Vector3.new(0, -60, 0), match.rayParams)\n\t\tif hit then\n\t\t\tland = hit.Position\n\t\tend\n\t\tspawnProj(match, c, {\n\t\t\tkind = \"Bomb\",\n\t\t\tpos = from,\n\t\t\tstart = from,\n\t\t\tfinish = land,\n\t\t\tflight = bomb.FlightTime * (0.85 + 0.15 * dist / bomb.MaxRange),\n\t\t\tapex = bomb.Apex + math.max(0, from.Y - land.Y) * 0.25,\n\t\t\tlife = bomb.FlightTime + 1,\n\t\t\tsize = 1.6 + bomb.Radius * 0.06,\n\t\t\tcolor = bomb.Color,\n\t\t\tradius = 2.2,\n\t\t\tblast = bomb,\n\t\t})\n\tend\n\tmatch:FireAll(\"FX\", \"Fire\", { model = c.model, weapon = \"Bomb\", slow = 0.2, slowTime = bomb.Stall })\n\tCombat.SyncAttributes(c)\nend\n\nlocal function activePods(match, c): number\n\tlocal n = 0\n\tfor _, p in pairs(match.projectiles) do\n\t\tif p.owner == c and POD_KINDS[p.kind] then\n\t\t\tn += 1\n\t\tend\n\tend\n\treturn n\nend\n\nlocal function firePod(match, c)\n\tlocal pod = c.loadout.Pod\n\tlocal t = now()\n\tif t < c.podReadyAt or activePods(match, c) + pod.Count > pod.MaxActive then\n\t\treturn\n\tend\n\tc.podReadyAt = t + pod.Cooldown\n\tlocal target = Combat.GetTarget(match, c)\n\tlocal from = tipPos(c, \"PodTip\")\n\tlocal fwd = target and Util.flatUnit(target.root.Position - c.root.Position) or Util.flatUnit(c.root.CFrame.LookVector)\n\tlocal right = Vector3.new(-fwd.Z, 0, fwd.X)\n\tlocal common = {\n\t\tsize = pod.Size,\n\t\tcolor = pod.Color,\n\t\ttarget = target,\n\t\tlife = pod.Life,\n\t\tradius = pod.TriggerRadius,\n\t\tblast = pod,\n\t\tblastRadius = pod.Radius,\n\t}\n\tlocal function spawnOne(extra)\n\t\tlocal p = table.clone(common)\n\t\tfor k, v in pairs(extra) do\n\t\t\tp[k] = v\n\t\tend\n\t\tspawnProj(match, c, p)\n\tend\n\tif pod.Type == \"Seeker\" then\n\t\tspawnOne({\n\t\t\tkind = \"Seeker\",\n\t\t\tpos = from,\n\t\t\tdir = fwd,\n\t\t\tspeed = pod.Speed,\n\t\t\tturn = math.rad(pod.Turn),\n\t\t\tfloorY = match.floorY,\n\t\t\thover = pod.HoverHeight,\n\t\t\tclimb = pod.ClimbRate,\n\t\t})\n\telseif pod.Type == \"Mine\" then\n\t\tlocal land = Util.flat(c.root.Position) + fwd * pod.ThrowDist\n\t\tland = Vector3.new(land.X, match.floorY + 0.9, land.Z)\n\t\tlocal hit = workspace:Raycast(land + Vector3.new(0, 30, 0), Vector3.new(0, -50, 0), match.rayParams)\n\t\tif hit then\n\t\t\tland = hit.Position + Vector3.new(0, 0.9, 0)\n\t\tend\n\t\tspawnOne({\n\t\t\tkind = \"Mine\",\n\t\t\tpos = from,\n\t\t\tstart = from,\n\t\t\tfinish = land,\n\t\t\tthrowTime = pod.ThrowTime,\n\t\t\tarmTime = pod.ArmTime,\n\t\t})\n\telseif pod.Type == \"Orbit\" then\n\t\tfor _, s in ipairs({ -1, 1 }) do\n\t\t\tspawnOne({\n\t\t\t\tkind = \"Orbit\",\n\t\t\t\tpos = from,\n\t\t\t\tdir = fwd,\n\t\t\t\tspeed = pod.Speed,\n\t\t\t\tturn = math.rad(pod.Turn),\n\t\t\t\tlaunchDir = (right * s + Vector3.new(0, 0.35, 0)).Unit,\n\t\t\t\tlaunchTime = pod.LaunchTime,\n\t\t\t\tlaunchSpeed = pod.LaunchSide / pod.LaunchTime,\n\t\t\t})\n\t\tend\n\tend\n\tmatch:FireAll(\"FX\", \"Fire\", { model = c.model, weapon = \"Pod\", slow = 0.6, slowTime = 0.2 })\n\tCombat.SyncAttributes(c)\nend\n\n----------------------------------------------------------------------------------------------\n-- Intents (from player clients via Main, or from BotAI)\n----------------------------------------------------------------------------------------------\nfunction Combat.HandleIntent(match, c, action: string, payload)\n\tif not match or not c or not c.alive then\n\t\treturn\n\tend\n\tif action == \"GunUp\" then\n\t\tc.gunHeld = false\n\t\tif c.chargeStart then\n\t\t\tif canAct(match, c) then\n\t\t\t\treleaseCharge(match, c)\n\t\t\telse\n\t\t\t\tc.chargeStart = nil\n\t\t\tend\n\t\tend\n\t\treturn\n\tend\n\tif not canAct(match, c) then\n\t\treturn\n\tend\n\tlocal t = now()\n\tif action == \"GunDown\" then\n\t\tc.gunHeld = true\n\t\tif c.loadout.Gun.Type == \"Charge\" then\n\t\t\tif not c.chargeStart and t >= c.gunReadyAt - 0.05 then\n\t\t\t\tc.chargeStart = t\n\t\t\t\tmatch:FireAll(\"FX\", \"Charge\", { model = c.model, on = true, chargeTime = c.loadout.Gun.ChargeTime })\n\t\t\tend\n\t\telse\n\t\t\ttriggerGun(match, c)\n\t\tend\n\telseif action == \"Bomb\" then\n\t\tfireBomb(match, c)\n\telseif action == \"Pod\" then\n\t\tfirePod(match, c)\n\telseif action == \"Dash\" then\n\t\tif t - c.lastDashIntent < 0.18 then\n\t\t\treturn\n\t\tend\n\t\tc.lastDashIntent = t\n\t\tlocal dir = typeof(payload) == \"table\" and typeof(payload.dir) == \"Vector3\" and payload.dir or c.root.CFrame.LookVector\n\t\tc.dashDir = Util.flatUnit(dir, Util.flatUnit(c.root.CFrame.LookVector))\n\t\tc.dashUntil = t + math.max(c.loadout.Legs.DashTime, c.loadout.Legs.AirDashTime) + 0.08\n\t\tc.dashHit = {}\n\t\tmatch:FireAll(\"FX\", \"Dash\", { model = c.model, air = typeof(payload) == \"table\" and payload.air == true })\n\tend\nend\n\n----------------------------------------------------------------------------------------------\n-- Per-frame step\n----------------------------------------------------------------------------------------------\nlocal function capsule(c): (Vector3, Vector3)\n\tlocal p = c.root.Position\n\treturn p - Vector3.new(0, c.info.capDown, 0), p + Vector3.new(0, c.info.capUp, 0)\nend\n\nlocal function distToCapsule(c, a: Vector3, b: Vector3): number\n\tlocal lo, hi = capsule(c)\n\treturn Util.segSegDist(a, b, lo, hi) - c.info.hitRadius\nend\n\nlocal function explodePod(match, p)\n\tendProj(match, p, \"explode\", p.pos)\n\tspawnBlast(match, p.owner, p.pos, p.blast, p.color)\nend\n\nlocal function stepProjectiles(match, dt: number, t: number)\n\tfor _, p in pairs(match.projectiles) do\n\t\tlocal target = p.target\n\t\tlocal tpos = (target and target.alive and target.root) and Combat.AimPoint(target) or nil\n\t\tlocal prev = Sim.step(p, dt, tpos)\n\t\tlocal kind = p.kind\n\t\tlocal owner = p.owner\n\n\t\tif kind == \"Bullet\" then\n\t\t\tlocal seg = p.pos - prev\n\t\t\tlocal wall = seg.Magnitude > 0 and workspace:Raycast(prev, seg, match.rayParams)\n\t\t\tlocal hitC, hitDist = nil, math.huge\n\t\t\tfor _, e in ipairs(match.combatants) do\n\t\t\t\tif e ~= owner and e.alive and e.team ~= owner.team and not isInvulnerable(e, t) then\n\t\t\t\t\tlocal d = distToCapsule(e, prev, p.pos) - p.radius\n\t\t\t\t\tif d <= 0 then\n\t\t\t\t\t\tlocal along = (e.root.Position - prev).Magnitude\n\t\t\t\t\t\tif along < hitDist then\n\t\t\t\t\t\t\thitC, hitDist = e, along\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\tif hitC and (not wall or (wall.Position - prev).Magnitude >= hitDist - 1) then\n\t\t\t\tendProj(match, p, \"hit\", p.pos)\n\t\t\t\tCombat.Damage(match, hitC, p.damage, owner, {\n\t\t\t\t\tdownPower = p.downPower,\n\t\t\t\t\tknock = p.knock,\n\t\t\t\t\tup = p.up,\n\t\t\t\t\tforceDown = p.forceDown,\n\t\t\t\t\tdir = Util.flat(p.dir),\n\t\t\t\t\tpos = p.pos,\n\t\t\t\t\tsource = p.source,\n\t\t\t\t})\n\t\t\telseif wall then\n\t\t\t\tendProj(match, p, \"wall\", wall.Position)\n\t\t\telseif p.age >= p.life then\n\t\t\t\tendProj(match, p, \"expire\", p.pos)\n\t\t\tend\n\t\telseif kind == \"Bomb\" then\n\t\t\tlocal direct = false\n\t\t\tfor _, e in ipairs(match.combatants) do\n\t\t\t\tif e ~= owner and e.alive and e.team ~= owner.team and not isInvulnerable(e, t) then\n\t\t\t\t\tif distToCapsule(e, prev, p.pos) <= p.radius then\n\t\t\t\t\t\tdirect = true\n\t\t\t\t\t\tbreak\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\tif direct or p.landed then\n\t\t\t\tendProj(match, p, \"explode\", p.pos)\n\t\t\t\tspawnBlast(match, owner, p.pos, p.blast, p.color)\n\t\t\tend\n\t\telseif kind == \"Seeker\" or kind == \"Orbit\" then\n\t\t\tlocal seg = p.pos - prev\n\t\t\tlocal wall = seg.Magnitude > 0 and workspace:Raycast(prev, seg, match.rayParams)\n\t\t\tlocal triggered = false\n\t\t\tfor _, e in ipairs(match.combatants) do\n\t\t\t\tif e ~= owner and e.alive and e.team ~= owner.team and not isInvulnerable(e, t) then\n\t\t\t\t\tif distToCapsule(e, prev, p.pos) <= p.radius then\n\t\t\t\t\t\ttriggered = true\n\t\t\t\t\t\tbreak\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\tif wall and not triggered then\n\t\t\t\tp.pos = wall.Position + wall.Normal * 0.5\n\t\t\tend\n\t\t\tif triggered or wall or p.age >= p.life then\n\t\t\t\texplodePod(match, p)\n\t\t\tend\n\t\telseif kind == \"Mine\" then\n\t\t\tlocal armed = p.landed and p.age >= p.throwTime + p.armTime\n\t\t\tlocal triggered = false\n\t\t\tif armed then\n\t\t\t\tfor _, e in ipairs(match.combatants) do\n\t\t\t\t\tif e ~= owner and e.alive and e.team ~= owner.team and not isInvulnerable(e, t) then\n\t\t\t\t\t\tif (e.root.Position - p.pos).Magnitude - e.info.hitRadius <= p.radius then\n\t\t\t\t\t\t\ttriggered = true\n\t\t\t\t\t\t\tbreak\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\tif triggered or p.age >= p.life then\n\t\t\t\texplodePod(match, p)\n\t\t\tend\n\t\tend\n\tend\n\n\t-- Periodic position sync for slow, long-lived pods so client visuals don't drift.\n\tif t - (match.lastPodSync or 0) > 0.25 then\n\t\tmatch.lastPodSync = t\n\t\tlocal sync = {}\n\t\tfor id, p in pairs(match.projectiles) do\n\t\t\tif p.kind == \"Seeker\" or p.kind == \"Orbit\" then\n\t\t\t\ttable.insert(sync, { id, p.pos, p.dir })\n\t\t\tend\n\t\tend\n\t\tif #sync > 0 then\n\t\t\tmatch:FireAll(\"FX\", \"ProjSync\", sync)\n\t\tend\n\tend\nend\n\nlocal function stepBlasts(match, t: number)\n\tlocal i = 1\n\tlocal blasts = match.blasts\n\twhile i <= #blasts do\n\t\tlocal b = blasts[i]\n\t\tif t >= b.untilT then\n\t\t\ttable.remove(blasts, i)\n\t\telse\n\t\t\tlocal grow = math.clamp((t - b.t0) / 0.15, 0.45, 1)\n\t\t\tlocal r = b.radius * grow\n\t\t\tfor _, e in ipairs(match.combatants) do\n\t\t\t\tif not b.hit[e] and e ~= b.owner and e.alive and e.team ~= b.owner.team and not isInvulnerable(e, t) then\n\t\t\t\t\tlocal lo, hi = capsule(e)\n\t\t\t\t\tlocal d = Util.segSegDist(b.pos, b.pos, lo, hi) - e.info.hitRadius\n\t\t\t\t\tif d <= r then\n\t\t\t\t\t\tb.hit[e] = true\n\t\t\t\t\t\tCombat.Damage(match, e, b.damage, b.owner, {\n\t\t\t\t\t\t\tdownPower = b.downPower,\n\t\t\t\t\t\t\tknock = b.knock,\n\t\t\t\t\t\t\tup = b.up,\n\t\t\t\t\t\t\tdir = Util.flat(e.root.Position - b.pos),\n\t\t\t\t\t\t\tpos = Combat.AimPoint(e),\n\t\t\t\t\t\t\tsource = b.source,\n\t\t\t\t\t\t})\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\ti += 1\n\t\tend\n\tend\nend\n\nlocal function stepCombatant(match, c, dt: number, t: number)\n\tif not c.alive or not c.root or not c.root.Parent then\n\t\treturn\n\tend\n\tlocal gun = c.loadout.Gun\n\n\t-- Down -> Rebirth -> Normal\n\tif c.state == \"Down\" and t >= c.stateUntil then\n\t\tsetState(c, \"Rebirth\", t + M.RebirthTime)\n\t\tc.invulnUntil = t + M.RebirthTime\n\t\tCombat.SyncAttributes(c)\n\t\tmatch:FireAll(\"FX\", \"Rebirth\", { model = c.model })\n\telseif c.state == \"Rebirth\" and t >= c.stateUntil then\n\t\tsetState(c, \"Normal\", 0)\n\tend\n\n\t-- Endurance regen\n\tif c.state ~= \"Down\" and c.endurance < M.EnduranceMax and t - c.lastHitAt > M.EnduranceRegenDelay then\n\t\tlocal before = math.ceil(c.endurance / M.EndurancePerPip)\n\t\tc.endurance = math.min(M.EnduranceMax, c.endurance + M.EnduranceRegenRate * dt)\n\t\tif math.ceil(c.endurance / M.EndurancePerPip) ~= before then\n\t\t\tCombat.SyncAttributes(c)\n\t\tend\n\tend\n\n\tif match.state ~= \"Fight\" then\n\t\treturn\n\tend\n\n\t-- Burst fire + held trigger auto-repeat\n\tif c.burstLeft > 0 and t >= c.nextShotAt and c.state ~= \"Down\" then\n\t\tlocal target = Combat.GetTarget(match, c)\n\t\tlocal from = tipPos(c, \"GunTip\")\n\t\tfireBullet(match, c, target, gun, gun.Color, jitter(aimDir(c, from, target), c.aiAimError or 0), \"Bullet\")\n\t\tif c.burstLeft == gun.Shots then\n\t\t\tonGunFired(match, c, gun)\n\t\tend\n\t\tc.burstLeft -= 1\n\t\tc.nextShotAt = t + gun.ShotInterval\n\tend\n\tif c.gunHeld and gun.Type ~= \"Charge\" and c.state ~= \"Down\" then\n\t\ttriggerGun(match, c)\n\tend\n\n\t-- Body dash attack\n\tif t < c.dashUntil and t - c.lastDashHitAt > 0.6 then\n\t\tfor _, e in ipairs(match.combatants) do\n\t\t\tif e ~= c and e.alive and e.team ~= c.team and not c.dashHit[e] and not isInvulnerable(e, t) then\n\t\t\t\tlocal d = (Util.flat(e.root.Position - c.root.Position)).Magnitude\n\t\t\t\tlocal dy = math.abs(e.root.Position.Y - c.root.Position.Y)\n\t\t\t\tif d <= c.info.hitRadius + e.info.hitRadius + 1.0 and dy < 5 then\n\t\t\t\t\tc.dashHit[e] = true\n\t\t\t\t\tc.lastDashHitAt = t\n\t\t\t\t\tlocal da = c.loadout.Body.DashAttack\n\t\t\t\t\tCombat.Damage(match, e, da.Damage, c, {\n\t\t\t\t\t\tdownPower = da.DownPower,\n\t\t\t\t\t\tknock = da.Knock,\n\t\t\t\t\t\tup = da.Up,\n\t\t\t\t\t\tdir = c.dashDir,\n\t\t\t\t\t\tpos = Combat.AimPoint(e),\n\t\t\t\t\t\tsource = da.Name,\n\t\t\t\t\t})\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\n\t-- Pits\n\tif c.root.Position.Y < match.floorY - M.PitFallDepth then\n\t\tc.hp = math.max(0, c.hp - M.PitDamage)\n\t\tc.stats.damageTaken += M.PitDamage\n\t\tc.invulnUntil = t + M.PitInvuln\n\t\tc.model:PivotTo(c.spawnCF * CFrame.new(0, c.info.rootY + 8, 0))\n\t\tc.root.AssemblyLinearVelocity = Vector3.zero\n\t\tif c.participant.kind == \"Player\" and c.participant.player.Parent then\n\t\t\tmatch.remotes.Match:FireClient(c.participant.player, \"Teleported\")\n\t\telseif c.mover then\n\t\t\tc.mover:ResetVelocity()\n\t\tend\n\t\tCombat.SyncAttributes(c)\n\t\tmatch:FireAll(\"FX\", \"Pit\", { model = c.model, amount = M.PitDamage })\n\t\tif c.hp <= 0 then\n\t\t\tmatch:OnKO(c, nil)\n\t\tend\n\tend\nend\n\nfunction Combat.Step(match, dt: number)\n\tlocal t = now()\n\tfor _, c in ipairs(match.combatants) do\n\t\tstepCombatant(match, c, dt, t)\n\tend\n\tif match.state == \"Fight\" then\n\t\tstepProjectiles(match, dt, t)\n\t\tstepBlasts(match, t)\n\tend\nend\n\nfunction Combat.ClearProjectiles(match)\n\tmatch.projectiles = {}\n\tmatch.blasts = {}\n\tmatch:FireAll(\"FX\", \"ClearProj\", {})\nend\n\nreturn Combat\n"},"result":{"success":{"path":"/Users/chase-mini/src/rca-work/src/ServerScriptService/RoboClash/CombatService.luau","linesAdded":837,"linesRemoved":0,"diffString":"--- /dev/null\n+++ b//Users/chase-mini/src/rca-work/src/ServerScriptService/RoboClash/CombatService.luau\n@@ -1,0 +1,837 @@\n+-- Server-authoritative combat: weapon intents, projectile simulation, blasts, damage,\n+-- endurance -> DOWN -> REBIRTH, body dash attacks, pits. Operates on match objects owned by\n+-- MatchService; works for any number of combatants (nearest enemy = lock-on target).\n+local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n+\n+local RC = ReplicatedStorage:WaitForChild(\"RoboClash\")\n+local Config = require(RC.Config)\n+local Util = require(RC.Shared.Util)\n+local Sim = require(RC.Shared.ProjectileSim)\n+\n+local M = Config.Match\n+local Combat = {}\n+\n+local function now(): number\n+\treturn workspace:GetServerTimeNow()\n+end\n+Combat.now = now\n+\n+local POD_KINDS = { Seeker = true, Mine = true, Orbit = true }\n+\n+----------------------------------------------------------------------------------------------\n+-- Combatant setup\n+----------------------------------------------------------------------------------------------\n+function Combat.NewCombatant(match, participant, model: Model, info, spawnCF: CFrame)\n+\tlocal loadout = Config.GetLoadout(participant.robotId)\n+\tlocal c = {\n+\t\tmatch = match,\n+\t\tparticipant = participant,\n+\t\tindex = participant.index,\n+\t\tteam = participant.team,\n+\t\ttag = participant.tag,\n+\t\tmodel = model,\n+\t\troot = model:FindFirstChild(\"HumanoidRootPart\"),\n+\t\thum = model:FindFirstChildOfClass(\"Humanoid\"),\n+\t\tloadout = loadout,\n+\t\tinfo = info,\n+\t\tspawnCF = spawnCF,\n+\t\thp = M.MaxHP,\n+\t\tmaxHp = M.MaxHP,\n+\t\tendurance = M.EnduranceMax,\n+\t\tstate = \"Normal\",\n+\t\tstateUntil = 0,\n+\t\tinvulnUntil = 0,\n+\t\tgunReadyAt = 0,\n+\t\tammo = loadout.Gun.Clip or 0,\n+\t\treloadUntil = 0,\n+\t\tgunHeld = false,\n+\t\tchargeStart = nil,\n+\t\tburstLeft = 0,\n+\t\tnextShotAt = 0,\n+\t\tbombReadyAt = 0,\n+\t\tpodReadyAt = 0,\n+\t\tdashUntil = 0,\n+\t\tdashDir = Vector3.zero,\n+\t\tdashHit = {},\n+\t\tlastDashIntent = 0,\n+\t\tlastDashHitAt = 0,\n+\t\tlastHitAt = 0,\n+\t\tcomboDamage = 0,\n+\t\tcomboUntil = 0,\n+\t\talive = true,\n+\t\tstats = { damageDealt = 0, damageTaken = 0, downs = 0, hits = 0 },\n+\t}\n+\tCombat.SyncAttributes(c)\n+\treturn c\n+end\n+\n+function Combat.SyncAttributes(c)\n+\tlocal m = c.model\n+\tif not m or not m.Parent then\n+\t\treturn\n+\tend\n+\tm:SetAttribute(\"HP\", c.hp)\n+\tm:SetAttribute(\"MaxHP\", c.maxHp)\n+\tm:SetAttribute(\"Pips\", math.clamp(math.ceil(c.endurance / M.EndurancePerPip - 1e-6), 0, 3))\n+\tm:SetAttribute(\"Ammo\", c.ammo)\n+\tm:SetAttribute(\"Clip\", c.loadout.Gun.Clip or 0)\n+\tm:SetAttribute(\"ReloadUntil\", c.reloadUntil)\n+\tm:SetAttribute(\"GunReadyAt\", c.gunReadyAt)\n+\tm:SetAttribute(\"BombReadyAt\", c.bombReadyAt)\n+\tm:SetAttribute(\"PodReadyAt\", c.podReadyAt)\n+end\n+\n+local function setState(c, state: string, untilT: number)\n+\tc.state = state\n+\tc.stateUntil = untilT\n+\tif c.model and c.model.Parent then\n+\t\tc.model:SetAttribute(\"State\", state)\n+\t\tc.model:SetAttribute(\"StateUntil\", untilT)\n+\tend\n+end\n+Combat.SetState = setState\n+\n+function Combat.AimPoint(c): Vector3\n+\treturn c.root.Position + Vector3.new(0, c.info.aimY, 0)\n+end\n+\n+function Combat.GetTarget(match, c)\n+\tlocal best, bestD = nil, math.huge\n+\tfor _, o in ipairs(match.combatants) do\n+\t\tif o ~= c and o.alive and o.team ~= c.team and o.root then\n+\t\t\tlocal d = (o.root.Position - c.root.Position).Magnitude\n+\t\t\tif d < bestD then\n+\t\t\t\tbest, bestD = o, d\n+\t\t\tend\n+\t\tend\n+\tend\n+\treturn best, bestD\n+end\n+\n+local function isInvulnerable(c, t: number): boolean\n+\treturn c.state == \"Rebirth\" or t < c.invulnUntil or not c.alive\n+end\n+Combat.IsInvulnerable = isInvulnerable\n+\n+local function canAct(match, c): boolean\n+\treturn match.state == \"Fight\" and c.alive and c.state ~= \"Down\"\n+end\n+\n+----------------------------------------------------------------------------------------------\n+-- Knockback / state changes\n+----------------------------------------------------------------------------------------------\n+local function applyKnock(c, dir: Vector3, speed: number, up: number, dur: number)\n+\tspeed *= c.loadout.Body.KnockbackMult\n+\tlocal vel = Util.flatUnit(dir, c.root.CFrame.LookVector * -1) * speed\n+\tif c.participant.kind == \"Player\" then\n+\t\tlocal p = c.participant.player\n+\t\tif p.Parent then\n+\t\t\tc.match.remotes.Match:FireClient(p, \"Knock\", vel, up, dur)\n+\t\tend\n+\telseif c.mover then\n+\t\tc.mover:Knockback(vel, up, dur)\n+\tend\n+end\n+Combat.ApplyKnock = applyKnock\n+\n+function Combat.KnockDown(match, victim, attacker, dir: Vector3)\n+\tlocal t = now()\n+\tsetState(victim, \"Down\", t + M.DownTime)\n+\tvictim.endurance = M.EnduranceMax\n+\tvictim.gunHeld = false\n+\tvictim.chargeStart = nil\n+\tvictim.burstLeft = 0\n+\tvictim.dashUntil = 0\n+\tif attacker then\n+\t\tattacker.stats.downs += 1\n+\tend\n+\tapplyKnock(victim, dir, 48, 26, 0.45)\n+\tmatch:FireAll(\"FX\", \"Down\", { model = victim.model })\n+end\n+\n+----------------------------------------------------------------------------------------------\n+-- Damage\n+----------------------------------------------------------------------------------------------\n+-- info: { downPower, knock, up, forceDown, dir (Vector3), pos (Vector3), source }\n+function Combat.Damage(match, victim, amount: number, attacker, info)\n+\tif match.state ~= \"Fight\" or not victim.alive then\n+\t\treturn false\n+\tend\n+\tlocal t = now()\n+\tif isInvulnerable(victim, t) then\n+\t\treturn false\n+\tend\n+\tlocal wasDown = victim.state == \"Down\"\n+\tif wasDown then\n+\t\tamount *= M.DownDamageMult\n+\tend\n+\tamount = math.max(1, math.floor(amount + 0.5))\n+\tvictim.hp = math.max(0, victim.hp - amount)\n+\tvictim.stats.damageTaken += amount\n+\tvictim.lastHitAt = t\n+\tif attacker then\n+\t\tattacker.stats.damageDealt += amount\n+\t\tattacker.stats.hits += 1\n+\tend\n+\n+\tlocal dir = info.dir or (attacker and Util.flat(victim.root.Position - attacker.root.Position)) or Vector3.zAxis\n+\tlocal heavy = false\n+\tif not wasDown then\n+\t\tvictim.endurance -= info.downPower or 0\n+\t\tif victim.hp > 0 and (info.forceDown or victim.endurance <= 0) then\n+\t\t\tCombat.KnockDown(match, victim, attacker, dir)\n+\t\t\theavy = true\n+\t\telse\n+\t\t\tif (info.knock or 0) > 0 or (info.up or 0) > 0 then\n+\t\t\t\tapplyKnock(victim, dir, info.knock or 0, info.up or 0, 0.22)\n+\t\t\tend\n+\t\t\theavy = amount >= 70\n+\t\tend\n+\tend\n+\n+\tif t < victim.comboUntil then\n+\t\tvictim.comboDamage += amount\n+\telse\n+\t\tvictim.comboDamage = amount\n+\tend\n+\tvictim.comboUntil = t + M.ComboWindow\n+\n+\tCombat.SyncAttributes(victim)\n+\tmatch:FireAll(\"FX\", \"Hit\", {\n+\t\tvictim = victim.model,\n+\t\tattacker = attacker and attacker.model,\n+\t\tpos = info.pos or Combat.AimPoint(victim),\n+\t\tamount = amount,\n+\t\tcombo = victim.comboDamage,\n+\t\theavy = heavy,\n+\t\tdown = wasDown,\n+\t\tsource = info.source,\n+\t})\n+\n+\tif victim.hp <= 0 then\n+\t\tmatch:OnKO(victim, attacker)\n+\tend\n+\treturn true\n+end\n+\n+----------------------------------------------------------------------------------------------\n+-- Projectiles\n+----------------------------------------------------------------------------------------------\n+local function tipPos(c, attName: string): Vector3\n+\tlocal att = c.model:FindFirstChild(attName, true)\n+\tif att and att:IsA(\"Attachment\") then\n+\t\treturn att.WorldPosition\n+\tend\n+\treturn c.root.Position\n+end\n+\n+local function serializeProj(p)\n+\treturn {\n+\t\tid = p.id,\n+\t\tkind = p.kind,\n+\t\tstyle = p.style,\n+\t\tpos = p.pos,\n+\t\tdir = p.dir,\n+\t\tspeed = p.speed,\n+\t\tturn = p.turn,\n+\t\taccel = p.accel,\n+\t\tlife = p.life,\n+\t\tsize = p.size,\n+\t\tcolor = p.color,\n+\t\ttarget = p.target and p.target.model,\n+\t\towner = p.owner.model,\n+\t\thoming = p.homing,\n+\t\tstart = p.start,\n+\t\tfinish = p.finish,\n+\t\tflight = p.flight,\n+\t\tapex = p.apex,\n+\t\tfloorY = p.floorY,\n+\t\thover = p.hover,\n+\t\tclimb = p.climb,\n+\t\tlaunchDir = p.launchDir,\n+\t\tlaunchTime = p.launchTime,\n+\t\tlaunchSpeed = p.launchSpeed,\n+\t\tthrowTime = p.throwTime,\n+\t\tarmTime = p.armTime,\n+\t\tradius = p.blastRadius,\n+\t\tt0 = p.t0,\n+\t}\n+end\n+\n+local function spawnProj(match, owner, p)\n+\tmatch.nextProjId += 1\n+\tp.id = match.nextProjId\n+\tp.owner = owner\n+\tp.age = 0\n+\tp.t0 = now()\n+\tmatch.projectiles[p.id] = p\n+\tmatch:FireAll(\"FX\", \"Proj\", serializeProj(p))\n+\treturn p\n+end\n+\n+local function endProj(match, p, reason: string, pos: Vector3?)\n+\tmatch.projectiles[p.id] = nil\n+\tmatch:FireAll(\"FX\", \"ProjEnd\", { id = p.id, pos = pos or p.pos, reason = reason })\n+end\n+\n+local function spawnBlast(match, owner, pos: Vector3, w, color: Color3)\n+\tlocal b = {\n+\t\towner = owner,\n+\t\tpos = pos,\n+\t\tradius = w.Radius,\n+\t\tt0 = now(),\n+\t\tuntilT = now() + (w.Linger or 0.6),\n+\t\tdamage = w.Damage,\n+\t\tdownPower = w.DownPower,\n+\t\tknock = w.Knock,\n+\t\tup = w.Up,\n+\t\thit = {},\n+\t\tsource = w.Name,\n+\t}\n+\ttable.insert(match.blasts, b)\n+\tmatch:FireAll(\"FX\", \"Blast\", { pos = pos, radius = w.Radius, linger = w.Linger or 0.6, color = color, big = w.Radius >= 12 })\n+end\n+\n+local function aimDir(c, from: Vector3, target): Vector3\n+\tif target then\n+\t\tlocal to = Combat.AimPoint(target) - from\n+\t\tif to.Magnitude > 0.1 then\n+\t\t\treturn to.Unit\n+\t\tend\n+\tend\n+\treturn c.root.CFrame.LookVector\n+end\n+\n+local function jitter(dir: Vector3, deg: number): Vector3\n+\tif deg <= 0 then\n+\t\treturn dir\n+\tend\n+\tlocal yaw = math.rad((math.random() * 2 - 1) * deg)\n+\tlocal pitch = math.rad((math.random() * 2 - 1) * deg * 0.4)\n+\treturn (CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0) * dir).Unit\n+end\n+\n+local function fireBullet(match, c, target, spec, color: Color3, dir: Vector3, style: string?)\n+\tlocal turnMul = c.aiTurnMul or 1\n+\tspawnProj(match, c, {\n+\t\tkind = \"Bullet\",\n+\t\tstyle = style or \"Bullet\",\n+\t\tpos = tipPos(c, \"GunTip\"),\n+\t\tdir = dir,\n+\t\tspeed = spec.Speed,\n+\t\tturn = math.rad(spec.Turn) * turnMul,\n+\t\taccel = spec.Accel,\n+\t\tlife = spec.Life,\n+\t\tradius = spec.Radius,\n+\t\tsize = spec.Size or 0.9,\n+\t\tcolor = color,\n+\t\ttarget = target,\n+\t\thoming = true,\n+\t\tdamage = spec.Damage,\n+\t\tdownPower = spec.DownPower,\n+\t\tknock = spec.Knock,\n+\t\tup = spec.Up,\n+\t\tforceDown = spec.ForceDown,\n+\t\tsource = style,\n+\t})\n+end\n+\n+local function onGunFired(match, c, gun)\n+\tmatch:FireAll(\"FX\", \"Fire\", { model = c.model, weapon = \"Gun\", gunType = gun.Type, slow = gun.MoveSlow, slowTime = gun.SlowTime })\n+end\n+\n+local function triggerGun(match, c)\n+\tlocal gun = c.loadout.Gun\n+\tlocal t = now()\n+\tif gun.Type == \"Charge\" then\n+\t\treturn\n+\tend\n+\tif t < c.gunReadyAt or t < c.reloadUntil or c.burstLeft > 0 then\n+\t\treturn\n+\tend\n+\tif c.ammo <= 0 then\n+\t\tc.ammo = gun.Clip\n+\tend\n+\tc.ammo -= 1\n+\tc.gunReadyAt = t + gun.Cooldown\n+\tif c.ammo <= 0 then\n+\t\tc.reloadUntil = t + gun.Cooldown + gun.Reload\n+\t\tc.ammo = gun.Clip\n+\t\tc.gunReadyAt = c.reloadUntil\n+\tend\n+\tlocal target = Combat.GetTarget(match, c)\n+\tif gun.Type == \"Burst\" then\n+\t\tc.burstLeft = gun.Shots\n+\t\tc.nextShotAt = t\n+\telseif gun.Type == \"Spread\" then\n+\t\tlocal from = tipPos(c, \"GunTip\")\n+\t\tlocal base = jitter(aimDir(c, from, target), c.aiAimError or 0)\n+\t\tlocal n = gun.Pellets\n+\t\tfor i = 1, n do\n+\t\t\tlocal a = math.rad(-gun.SpreadDeg / 2 + gun.SpreadDeg * (i - 1) / math.max(1, n - 1))\n+\t\t\tfireBullet(match, c, target, gun, gun.Color, (CFrame.Angles(0, a, 0) * base).Unit, \"Pellet\")\n+\t\tend\n+\t\tonGunFired(match, c, gun)\n+\tend\n+\tCombat.SyncAttributes(c)\n+end\n+\n+local function releaseCharge(match, c)\n+\tlocal gun = c.loadout.Gun\n+\tlocal t = now()\n+\tlocal started = c.chargeStart\n+\tc.chargeStart = nil\n+\tmatch:FireAll(\"FX\", \"Charge\", { model = c.model, on = false })\n+\tif not started or t < c.gunReadyAt then\n+\t\treturn\n+\tend\n+\tlocal full = (t - started) >= gun.ChargeTime\n+\tlocal spec = full and gun.Full or gun.Tap\n+\tlocal target = Combat.GetTarget(match, c)\n+\tlocal from = tipPos(c, \"GunTip\")\n+\tfireBullet(match, c, target, spec, gun.Color, jitter(aimDir(c, from, target), c.aiAimError or 0), full and \"Beam\" or \"Bolt\")\n+\tc.gunReadyAt = t + gun.Cooldown\n+\tonGunFired(match, c, gun)\n+\tCombat.SyncAttributes(c)\n+end\n+\n+local function fireBomb(match, c)\n+\tlocal bomb = c.loadout.Bomb\n+\tlocal t = now()\n+\tif t < c.bombReadyAt then\n+\t\treturn\n+\tend\n+\tc.bombReadyAt = t + bomb.Cooldown\n+\tlocal target = Combat.GetTarget(match, c)\n+\tlocal from = tipPos(c, \"BombTip\")\n+\tlocal myFlat = Util.flat(c.root.Position)\n+\tlocal aim\n+\tif target then\n+\t\tlocal tv = Util.flat(target.root.AssemblyLinearVelocity)\n+\t\taim = Util.flat(target.root.Position) + tv * bomb.FlightTime * bomb.Lead\n+\t\tif c.aiAimError then\n+\t\t\taim += Vector3.new(math.random() * 2 - 1, 0, math.random() * 2 - 1) * c.aiAimError * 0.6\n+\t\tend\n+\telse\n+\t\taim = myFlat + Util.flatUnit(c.root.CFrame.LookVector) * 30\n+\tend\n+\tlocal off = aim - myFlat\n+\tlocal dist = math.clamp(off.Magnitude, bomb.MinRange, bomb.MaxRange)\n+\tlocal fwd = Util.flatUnit(off, Util.flatUnit(c.root.CFrame.LookVector))\n+\tlocal right = Vector3.new(-fwd.Z, 0, fwd.X)\n+\tfor i = 1, bomb.Count do\n+\t\tlocal lateral = (i - (bomb.Count + 1) / 2) * bomb.Spread\n+\t\tlocal land = myFlat + fwd * dist + right * lateral\n+\t\tland = Vector3.new(land.X, match.floorY, land.Z)\n+\t\tlocal hit = workspace:Raycast(land + Vector3.new(0, 40, 0), Vector3.new(0, -60, 0), match.rayParams)\n+\t\tif hit then\n+\t\t\tland = hit.Position\n+\t\tend\n+\t\tspawnProj(match, c, {\n+\t\t\tkind = \"Bomb\",\n+\t\t\tpos = from,\n+\t\t\tstart = from,\n+\t\t\tfinish = land,\n+\t\t\tflight = bomb.FlightTime * (0.85 + 0.15 * dist / bomb.MaxRange),\n+\t\t\tapex = bomb.Apex + math.max(0, from.Y - land.Y) * 0.25,\n+\t\t\tlife = bomb.FlightTime + 1,\n+\t\t\tsize = 1.6 + bomb.Radius * 0.06,\n+\t\t\tcolor = bomb.Color,\n+\t\t\tradius = 2.2,\n+\t\t\tblast = bomb,\n+\t\t})\n+\tend\n+\tmatch:FireAll(\"FX\", \"Fire\", { model = c.model, weapon = \"Bomb\", slow = 0.2, slowTime = bomb.Stall })\n+\tCombat.SyncAttributes(c)\n+end\n+\n+local function activePods(match, c): number\n+\tlocal n = 0\n+\tfor _, p in pairs(match.projectiles) do\n+\t\tif p.owner == c and POD_KINDS[p.kind] then\n+\t\t\tn += 1\n+\t\tend\n+\tend\n+\treturn n\n+end\n+\n+local function firePod(match, c)\n+\tlocal pod = c.loadout.Pod\n+\tlocal t = now()\n+\tif t < c.podReadyAt or activePods(match, c) + pod.Count > pod.MaxActive then\n+\t\treturn\n+\tend\n+\tc.podReadyAt = t + pod.Cooldown\n+\tlocal target = Combat.GetTarget(match, c)\n+\tlocal from = tipPos(c, \"PodTip\")\n+\tlocal fwd = target and Util.flatUnit(target.root.Position - c.root.Position) or Util.flatUnit(c.root.CFrame.LookVector)\n+\tlocal right = Vector3.new(-fwd.Z, 0, fwd.X)\n+\tlocal common = {\n+\t\tsize = pod.Size,\n+\t\tcolor = pod.Color,\n+\t\ttarget = target,\n+\t\tlife = pod.Life,\n+\t\tradius = pod.TriggerRadius,\n+\t\tblast = pod,\n+\t\tblastRadius = pod.Radius,\n+\t}\n+\tlocal function spawnOne(extra)\n+\t\tlocal p = table.clone(common)\n+\t\tfor k, v in pairs(extra) do\n+\t\t\tp[k] = v\n+\t\tend\n+\t\tspawnProj(match, c, p)\n+\tend\n+\tif pod.Type == \"Seeker\" then\n+\t\tspawnOne({\n+\t\t\tkind = \"Seeker\",\n+\t\t\tpos = from,\n+\t\t\tdir = fwd,\n+\t\t\tspeed = pod.Speed,\n+\t\t\tturn = math.rad(pod.Turn),\n+\t\t\tfloorY = match.floorY,\n+\t\t\thover = pod.HoverHeight,\n+\t\t\tclimb = pod.ClimbRate,\n+\t\t})\n+\telseif pod.Type == \"Mine\" then\n+\t\tlocal land = Util.flat(c.root.Position) + fwd * pod.ThrowDist\n+\t\tland = Vector3.new(land.X, match.floorY + 0.9, land.Z)\n+\t\tlocal hit = workspace:Raycast(land + Vector3.new(0, 30, 0), Vector3.new(0, -50, 0), match.rayParams)\n+\t\tif hit then\n+\t\t\tland = hit.Position + Vector3.new(0, 0.9, 0)\n+\t\tend\n+\t\tspawnOne({\n+\t\t\tkind = \"Mine\",\n+\t\t\tpos = from,\n+\t\t\tstart = from,\n+\t\t\tfinish = land,\n+\t\t\tthrowTime = pod.ThrowTime,\n+\t\t\tarmTime = pod.ArmTime,\n+\t\t})\n+\telseif pod.Type == \"Orbit\" then\n+\t\tfor _, s in ipairs({ -1, 1 }) do\n+\t\t\tspawnOne({\n+\t\t\t\tkind = \"Orbit\",\n+\t\t\t\tpos = from,\n+\t\t\t\tdir = fwd,\n+\t\t\t\tspeed = pod.Speed,\n+\t\t\t\tturn = math.rad(pod.Turn),\n+\t\t\t\tlaunchDir = (right * s + Vector3.new(0, 0.35, 0)).Unit,\n+\t\t\t\tlaunchTime = pod.LaunchTime,\n+\t\t\t\tlaunchSpeed = pod.LaunchSide / pod.LaunchTime,\n+\t\t\t})\n+\t\tend\n+\tend\n+\tmatch:FireAll(\"FX\", \"Fire\", { model = c.model, weapon = \"Pod\", slow = 0.6, slowTime = 0.2 })\n+\tCombat.SyncAttributes(c)\n+end\n+\n+----------------------------------------------------------------------------------------------\n+-- Intents (from player clients via Main, or from BotAI)\n+----------------------------------------------------------------------------------------------\n+function Combat.HandleIntent(match, c, action: string, payload)\n+\tif not match or not c or not c.alive then\n+\t\treturn\n+\tend\n+\tif action == \"GunUp\" then\n+\t\tc.gunHeld = false\n+\t\tif c.chargeStart then\n+\t\t\tif canAct(match, c) then\n+\t\t\t\treleaseCharge(match, c)\n+\t\t\telse\n+\t\t\t\tc.chargeStart = nil\n+\t\t\tend\n+\t\tend\n+\t\treturn\n+\tend\n+\tif not canAct(match, c) then\n+\t\treturn\n+\tend\n+\tlocal t = now()\n+\tif action == \"GunDown\" then\n+\t\tc.gunHeld = true\n+\t\tif c.loadout.Gun.Type == \"Charge\" then\n+\t\t\tif not c.chargeStart and t >= c.gunReadyAt - 0.05 then\n+\t\t\t\tc.chargeStart = t\n+\t\t\t\tmatch:FireAll(\"FX\", \"Charge\", { model = c.model, on = true, chargeTime = c.loadout.Gun.ChargeTime })\n+\t\t\tend\n+\t\telse\n+\t\t\ttriggerGun(match, c)\n+\t\tend\n+\telseif action == \"Bomb\" then\n+\t\tfireBomb(match, c)\n+\telseif action == \"Pod\" then\n+\t\tfirePod(match, c)\n+\telseif action == \"Dash\" then\n+\t\tif t - c.lastDashIntent < 0.18 then\n+\t\t\treturn\n+\t\tend\n+\t\tc.lastDashIntent = t\n+\t\tlocal dir = typeof(payload) == \"table\" and typeof(payload.dir) == \"Vector3\" and payload.dir or c.root.CFrame.LookVector\n+\t\tc.dashDir = Util.flatUnit(dir, Util.flatUnit(c.root.CFrame.LookVector))\n+\t\tc.dashUntil = t + math.max(c.loadout.Legs.DashTime, c.loadout.Legs.AirDashTime) + 0.08\n+\t\tc.dashHit = {}\n+\t\tmatch:FireAll(\"FX\", \"Dash\", { model = c.model, air = typeof(payload) == \"table\" and payload.air == true })\n+\tend\n+end\n+\n+----------------------------------------------------------------------------------------------\n+-- Per-frame step\n+----------------------------------------------------------------------------------------------\n+local function capsule(c): (Vector3, Vector3)\n+\tlocal p = c.root.Position\n+\treturn p - Vector3.new(0, c.info.capDown, 0), p + Vector3.new(0, c.info.capUp, 0)\n+end\n+\n+local function distToCapsule(c, a: Vector3, b: Vector3): number\n+\tlocal lo, hi = capsule(c)\n+\treturn Util.segSegDist(a, b, lo, hi) - c.info.hitRadius\n+end\n+\n+local function explodePod(match, p)\n+\tendProj(match, p, \"explode\", p.pos)\n+\tspawnBlast(match, p.owner, p.pos, p.blast, p.color)\n+end\n+\n+local function stepProjectiles(match, dt: number, t: number)\n+\tfor _, p in pairs(match.projectiles) do\n+\t\tlocal target = p.target\n+\t\tlocal tpos = (target and target.alive and target.root) and Combat.AimPoint(target) or nil\n+\t\tlocal prev = Sim.step(p, dt, tpos)\n+\t\tlocal kind = p.kind\n+\t\tlocal owner = p.owner\n+\n+\t\tif kind == \"Bullet\" then\n+\t\t\tlocal seg = p.pos - prev\n+\t\t\tlocal wall = seg.Magnitude > 0 and workspace:Raycast(prev, seg, match.rayParams)\n+\t\t\tlocal hitC, hitDist = nil, math.huge\n+\t\t\tfor _, e in ipairs(match.combatants) do\n+\t\t\t\tif e ~= owner and e.alive and e.team ~= owner.team and not isInvulnerable(e, t) then\n+\t\t\t\t\tlocal d = distToCapsule(e, prev, p.pos) - p.radius\n+\t\t\t\t\tif d <= 0 then\n+\t\t\t\t\t\tlocal along = (e.root.Position - prev).Magnitude\n+\t\t\t\t\t\tif along < hitDist then\n+\t\t\t\t\t\t\thitC, hitDist = e, along\n+\t\t\t\t\t\tend\n+\t\t\t\t\tend\n+\t\t\t\tend\n+\t\t\tend\n+\t\t\tif hitC and (not wall or (wall.Position - prev).Magnitude >= hitDist - 1) then\n+\t\t\t\tendProj(match, p, \"hit\", p.pos)\n+\t\t\t\tCombat.Damage(match, hitC, p.damage, owner, {\n+\t\t\t\t\tdownPower = p.downPower,\n+\t\t\t\t\tknock = p.knock,\n+\t\t\t\t\tup = p.up,\n+\t\t\t\t\tforceDown = p.forceDown,\n+\t\t\t\t\tdir = Util.flat(p.dir),\n+\t\t\t\t\tpos = p.pos,\n+\t\t\t\t\tsource = p.source,\n+\t\t\t\t})\n+\t\t\telseif wall then\n+\t\t\t\tendProj(match, p, \"wall\", wall.Position)\n+\t\t\telseif p.age >= p.life then\n+\t\t\t\tendProj(match, p, \"expire\", p.pos)\n+\t\t\tend\n+\t\telseif kind == \"Bomb\" then\n+\t\t\tlocal direct = false\n+\t\t\tfor _, e in ipairs(match.combatants) do\n+\t\t\t\tif e ~= owner and e.alive and e.team ~= owner.team and not isInvulnerable(e, t) then\n+\t\t\t\t\tif distToCapsule(e, prev, p.pos) <= p.radius then\n+\t\t\t\t\t\tdirect = true\n+\t\t\t\t\t\tbreak\n+\t\t\t\t\tend\n+\t\t\t\tend\n+\t\t\tend\n+\t\t\tif direct or p.landed then\n+\t\t\t\tendProj(match, p, \"explode\", p.pos)\n+\t\t\t\tspawnBlast(match, owner, p.pos, p.blast, p.color)\n+\t\t\tend\n+\t\telseif kind == \"Seeker\" or kind == \"Orbit\" then\n+\t\t\tlocal seg = p.pos - prev\n+\t\t\tlocal wall = seg.Magnitude > 0 and workspace:Raycast(prev, seg, match.rayParams)\n+\t\t\tlocal triggered = false\n+\t\t\tfor _, e in ipairs(match.combatants) do\n+\t\t\t\tif e ~= owner and e.alive and e.team ~= owner.team and not isInvulnerable(e, t) then\n+\t\t\t\t\tif distToCapsule(e, prev, p.pos) <= p.radius then\n+\t\t\t\t\t\ttriggered = true\n+\t\t\t\t\t\tbreak\n+\t\t\t\t\tend\n+\t\t\t\tend\n+\t\t\tend\n+\t\t\tif wall and not triggered then\n+\t\t\t\tp.pos = wall.Position + wall.Normal * 0.5\n+\t\t\tend\n+\t\t\tif triggered or wall or p.age >= p.life then\n+\t\t\t\texplodePod(match, p)\n+\t\t\tend\n+\t\telseif kind == \"Mine\" then\n+\t\t\tlocal armed = p.landed and p.age >= p.throwTime + p.armTime\n+\t\t\tlocal triggered = false\n+\t\t\tif armed then\n+\t\t\t\tfor _, e in ipairs(match.combatants) do\n+\t\t\t\t\tif e ~= owner and e.alive and e.team ~= owner.team and not isInvulnerable(e, t) then\n+\t\t\t\t\t\tif (e.root.Position - p.pos).Magnitude - e.info.hitRadius <= p.radius then\n+\t\t\t\t\t\t\ttriggered = true\n+\t\t\t\t\t\t\tbreak\n+\t\t\t\t\t\tend\n+\t\t\t\t\tend\n+\t\t\t\tend\n+\t\t\tend\n+\t\t\tif triggered or p.age >= p.life then\n+\t\t\t\texplodePod(match, p)\n+\t\t\tend\n+\t\tend\n+\tend\n+\n+\t-- Periodic position sync for slow, long-lived pods so client visuals don't drift.\n+\tif t - (match.lastPodSync or 0) > 0.25 then\n+\t\tmatch.lastPodSync = t\n+\t\tlocal sync = {}\n+\t\tfor id, p in pairs(match.projectiles) do\n+\t\t\tif p.kind == \"Seeker\" or p.kind == \"Orbit\" then\n+\t\t\t\ttable.insert(sync, { id, p.pos, p.dir })\n+\t\t\tend\n+\t\tend\n+\t\tif #sync > 0 then\n+\t\t\tmatch:FireAll(\"FX\", \"ProjSync\", sync)\n+\t\tend\n+\tend\n+end\n+\n+local function stepBlasts(match, t: number)\n+\tlocal i = 1\n+\tlocal blasts = match.blasts\n+\twhile i <= #blasts do\n+\t\tlocal b = blasts[i]\n+\t\tif t >= b.untilT then\n+\t\t\ttable.remove(blasts, i)\n+\t\telse\n+\t\t\tlocal grow = math.clamp((t - b.t0) / 0.15, 0.45, 1)\n+\t\t\tlocal r = b.radius * grow\n+\t\t\tfor _, e in ipairs(match.combatants) do\n+\t\t\t\tif not b.hit[e] and e ~= b.owner and e.alive and e.team ~= b.owner.team and not isInvulnerable(e, t) then\n+\t\t\t\t\tlocal lo, hi = capsule(e)\n+\t\t\t\t\tlocal d = Util.segSegDist(b.pos, b.pos, lo, hi) - e.info.hitRadius\n+\t\t\t\t\tif d <= r then\n+\t\t\t\t\t\tb.hit[e] = true\n+\t\t\t\t\t\tCombat.Damage(match, e, b.damage, b.owner, {\n+\t\t\t\t\t\t\tdownPower = b.downPower,\n+\t\t\t\t\t\t\tknock = b.knock,\n+\t\t\t\t\t\t\tup = b.up,\n+\t\t\t\t\t\t\tdir = Util.flat(e.root.Position - b.pos),\n+\t\t\t\t\t\t\tpos = Combat.AimPoint(e),\n+\t\t\t\t\t\t\tsource = b.source,\n+\t\t\t\t\t\t})\n+\t\t\t\t\tend\n+\t\t\t\tend\n+\t\t\tend\n+\t\t\ti += 1\n+\t\tend\n+\tend\n+end\n+\n+local function stepCombatant(match, c, dt: number, t: number)\n+\tif not c.alive or not c.root or not c.root.Parent then\n+\t\treturn\n+\tend\n+\tlocal gun = c.loadout.Gun\n+\n+\t-- Down -> Rebirth -> Normal\n+\tif c.state == \"Down\" and t >= c.stateUntil then\n+\t\tsetState(c, \"Rebirth\", t + M.RebirthTime)\n+\t\tc.invulnUntil = t + M.RebirthTime\n+\t\tCombat.SyncAttributes(c)\n+\t\tmatch:FireAll(\"FX\", \"Rebirth\", { model = c.model })\n+\telseif c.state == \"Rebirth\" and t >= c.stateUntil then\n+\t\tsetState(c, \"Normal\", 0)\n+\tend\n+\n+\t-- Endurance regen\n+\tif c.state ~= \"Down\" and c.endurance < M.EnduranceMax and t - c.lastHitAt > M.EnduranceRegenDelay then\n+\t\tlocal before = math.ceil(c.endurance / M.EndurancePerPip)\n+\t\tc.endurance = math.min(M.EnduranceMax, c.endurance + M.EnduranceRegenRate * dt)\n+\t\tif math.ceil(c.endurance / M.EndurancePerPip) ~= before then\n+\t\t\tCombat.SyncAttributes(c)\n+\t\tend\n+\tend\n+\n+\tif match.state ~= \"Fight\" then\n+\t\treturn\n+\tend\n+\n+\t-- Burst fire + held trigger auto-repeat\n+\tif c.burstLeft > 0 and t >= c.nextShotAt and c.state ~= \"Down\" then\n+\t\tlocal target = Combat.GetTarget(match, c)\n+\t\tlocal from = tipPos(c, \"GunTip\")\n+\t\tfireBullet(match, c, target, gun, gun.Color, jitter(aimDir(c, from, target), c.aiAimError or 0), \"Bullet\")\n+\t\tif c.burstLeft == gun.Shots then\n+\t\t\tonGunFired(match, c, gun)\n+\t\tend\n+\t\tc.burstLeft -= 1\n+\t\tc.nextShotAt = t + gun.ShotInterval\n+\tend\n+\tif c.gunHeld and gun.Type ~= \"Charge\" and c.state ~= \"Down\" then\n+\t\ttriggerGun(match, c)\n+\tend\n+\n+\t-- Body dash attack\n+\tif t < c.dashUntil and t - c.lastDashHitAt > 0.6 then\n+\t\tfor _, e in ipairs(match.combatants) do\n+\t\t\tif e ~= c and e.alive and e.team ~= c.team and not c.dashHit[e] and not isInvulnerable(e, t) then\n+\t\t\t\tlocal d = (Util.flat(e.root.Position - c.root.Position)).Magnitude\n+\t\t\t\tlocal dy = math.abs(e.root.Position.Y - c.root.Position.Y)\n+\t\t\t\tif d <= c.info.hitRadius + e.info.hitRadius + 1.0 and dy < 5 then\n+\t\t\t\t\tc.dashHit[e] = true\n+\t\t\t\t\tc.lastDashHitAt = t\n+\t\t\t\t\tlocal da = c.loadout.Body.DashAttack\n+\t\t\t\t\tCombat.Damage(match, e, da.Damage, c, {\n+\t\t\t\t\t\tdownPower = da.DownPower,\n+\t\t\t\t\t\tknock = da.Knock,\n+\t\t\t\t\t\tup = da.Up,\n+\t\t\t\t\t\tdir = c.dashDir,\n+\t\t\t\t\t\tpos = Combat.AimPoint(e),\n+\t\t\t\t\t\tsource = da.Name,\n+\t\t\t\t\t})\n+\t\t\t\tend\n+\t\t\tend\n+\t\tend\n+\tend\n+\n+\t-- Pits\n+\tif c.root.Position.Y < match.floorY - M.PitFallDepth then\n+\t\tc.hp = math.max(0, c.hp - M.PitDamage)\n+\t\tc.stats.damageTaken += M.PitDamage\n+\t\tc.invulnUntil = t + M.PitInvuln\n+\t\tc.model:PivotTo(c.spawnCF * CFrame.new(0, c.info.rootY + 8, 0))\n+\t\tc.root.AssemblyLinearVelocity = Vector3.zero\n+\t\tif c.participant.kind == \"Player\" and c.participant.player.Parent then\n+\t\t\tmatch.remotes.Match:FireClient(c.participant.player, \"Teleported\")\n+\t\telseif c.mover then\n+\t\t\tc.mover:ResetVelocity()\n+\t\tend\n+\t\tCombat.SyncAttributes(c)\n+\t\tmatch:FireAll(\"FX\", \"Pit\", { model = c.model, amount = M.PitDamage })\n+\t\tif c.hp <= 0 then\n+\t\t\tmatch:OnKO(c, nil)\n+\t\tend\n+\tend\n+end\n+\n+function Combat.Step(match, dt: number)\n+\tlocal t = now()\n+\tfor _, c in ipairs(match.combatants) do\n+\t\tstepCombatant(match, c, dt, t)\n+\tend\n+\tif match.state == \"Fight\" then\n+\t\tstepProjectiles(match, dt, t)\n+\t\tstepBlasts(match, t)\n+\tend\n+end\n+\n+function Combat.ClearProjectiles(match)\n+\tmatch.projectiles = {}\n+\tmatch.blasts = {}\n+\tmatch:FireAll(\"FX\", \"ClearProj\", {})\n+end\n+\n+return Combat","afterFullFileContent":"-- Server-authoritative combat: weapon intents, projectile simulation, blasts, damage,\n-- endurance -> DOWN -> REBIRTH, body dash attacks, pits. Operates on match objects owned by\n-- MatchService; works for any number of combatants (nearest enemy = lock-on target).\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal RC = ReplicatedStorage:WaitForChild(\"RoboClash\")\nlocal Config = require(RC.Config)\nlocal Util = require(RC.Shared.Util)\nlocal Sim = require(RC.Shared.ProjectileSim)\n\nlocal M = Config.Match\nlocal Combat = {}\n\nlocal function now(): number\n\treturn workspace:GetServerTimeNow()\nend\nCombat.now = now\n\nlocal POD_KINDS = { Seeker = true, Mine = true, Orbit = true }\n\n----------------------------------------------------------------------------------------------\n-- Combatant setup\n----------------------------------------------------------------------------------------------\nfunction Combat.NewCombatant(match, participant, model: Model, info, spawnCF: CFrame)\n\tlocal loadout = Config.GetLoadout(participant.robotId)\n\tlocal c = {\n\t\tmatch = match,\n\t\tparticipant = participant,\n\t\tindex = participant.index,\n\t\tteam = participant.team,\n\t\ttag = participant.tag,\n\t\tmodel = model,\n\t\troot = model:FindFirstChild(\"HumanoidRootPart\"),\n\t\thum = model:FindFirstChildOfClass(\"Humanoid\"),\n\t\tloadout = loadout,\n\t\tinfo = info,\n\t\tspawnCF = spawnCF,\n\t\thp = M.MaxHP,\n\t\tmaxHp = M.MaxHP,\n\t\tendurance = M.EnduranceMax,\n\t\tstate = \"Normal\",\n\t\tstateUntil = 0,\n\t\tinvulnUntil = 0,\n\t\tgunReadyAt = 0,\n\t\tammo = loadout.Gun.Clip or 0,\n\t\treloadUntil = 0,\n\t\tgunHeld = false,\n\t\tchargeStart = nil,\n\t\tburstLeft = 0,\n\t\tnextShotAt = 0,\n\t\tbombReadyAt = 0,\n\t\tpodReadyAt = 0,\n\t\tdashUntil = 0,\n\t\tdashDir = Vector3.zero,\n\t\tdashHit = {},\n\t\tlastDashIntent = 0,\n\t\tlastDashHitAt = 0,\n\t\tlastHitAt = 0,\n\t\tcomboDamage = 0,\n\t\tcomboUntil = 0,\n\t\talive = true,\n\t\tstats = { damageDealt = 0, damageTaken = 0, downs = 0, hits = 0 },\n\t}\n\tCombat.SyncAttributes(c)\n\treturn c\nend\n\nfunction Combat.SyncAttributes(c)\n\tlocal m = c.model\n\tif not m or not m.Parent then\n\t\treturn\n\tend\n\tm:SetAttribute(\"HP\", c.hp)\n\tm:SetAttribute(\"MaxHP\", c.maxHp)\n\tm:SetAttribute(\"Pips\", math.clamp(math.ceil(c.endurance / M.EndurancePerPip - 1e-6), 0, 3))\n\tm:SetAttribute(\"Ammo\", c.ammo)\n\tm:SetAttribute(\"Clip\", c.loadout.Gun.Clip or 0)\n\tm:SetAttribute(\"ReloadUntil\", c.reloadUntil)\n\tm:SetAttribute(\"GunReadyAt\", c.gunReadyAt)\n\tm:SetAttribute(\"BombReadyAt\", c.bombReadyAt)\n\tm:SetAttribute(\"PodReadyAt\", c.podReadyAt)\nend\n\nlocal function setState(c, state: string, untilT: number)\n\tc.state = state\n\tc.stateUntil = untilT\n\tif c.model and c.model.Parent then\n\t\tc.model:SetAttribute(\"State\", state)\n\t\tc.model:SetAttribute(\"StateUntil\", untilT)\n\tend\nend\nCombat.SetState = setState\n\nfunction Combat.AimPoint(c): Vector3\n\treturn c.root.Position + Vector3.new(0, c.info.aimY, 0)\nend\n\nfunction Combat.GetTarget(match, c)\n\tlocal best, bestD = nil, math.huge\n\tfor _, o in ipairs(match.combatants) do\n\t\tif o ~= c and o.alive and o.team ~= c.team and o.root then\n\t\t\tlocal d = (o.root.Position - c.root.Position).Magnitude\n\t\t\tif d < bestD then\n\t\t\t\tbest, bestD = o, d\n\t\t\tend\n\t\tend\n\tend\n\treturn best, bestD\nend\n\nlocal function isInvulnerable(c, t: number): boolean\n\treturn c.state == \"Rebirth\" or t < c.invulnUntil or not c.alive\nend\nCombat.IsInvulnerable = isInvulnerable\n\nlocal function canAct(match, c): boolean\n\treturn match.state == \"Fight\" and c.alive and c.state ~= \"Down\"\nend\n\n----------------------------------------------------------------------------------------------\n-- Knockback / state changes\n----------------------------------------------------------------------------------------------\nlocal function applyKnock(c, dir: Vector3, speed: number, up: number, dur: number)\n\tspeed *= c.loadout.Body.KnockbackMult\n\tlocal vel = Util.flatUnit(dir, c.root.CFrame.LookVector * -1) * speed\n\tif c.participant.kind == \"Player\" then\n\t\tlocal p = c.participant.player\n\t\tif p.Parent then\n\t\t\tc.match.remotes.Match:FireClient(p, \"Knock\", vel, up, dur)\n\t\tend\n\telseif c.mover then\n\t\tc.mover:Knockback(vel, up, dur)\n\tend\nend\nCombat.ApplyKnock = applyKnock\n\nfunction Combat.KnockDown(match, victim, attacker, dir: Vector3)\n\tlocal t = now()\n\tsetState(victim, \"Down\", t + M.DownTime)\n\tvictim.endurance = M.EnduranceMax\n\tvictim.gunHeld = false\n\tvictim.chargeStart = nil\n\tvictim.burstLeft = 0\n\tvictim.dashUntil = 0\n\tif attacker then\n\t\tattacker.stats.downs += 1\n\tend\n\tapplyKnock(victim, dir, 48, 26, 0.45)\n\tmatch:FireAll(\"FX\", \"Down\", { model = victim.model })\nend\n\n----------------------------------------------------------------------------------------------\n-- Damage\n----------------------------------------------------------------------------------------------\n-- info: { downPower, knock, up, forceDown, dir (Vector3), pos (Vector3), source }\nfunction Combat.Damage(match, victim, amount: number, attacker, info)\n\tif match.state ~= \"Fight\" or not victim.alive then\n\t\treturn false\n\tend\n\tlocal t = now()\n\tif isInvulnerable(victim, t) then\n\t\treturn false\n\tend\n\tlocal wasDown = victim.state == \"Down\"\n\tif wasDown then\n\t\tamount *= M.DownDamageMult\n\tend\n\tamount = math.max(1, math.floor(amount + 0.5))\n\tvictim.hp = math.max(0, victim.hp - amount)\n\tvictim.stats.damageTaken += amount\n\tvictim.lastHitAt = t\n\tif attacker then\n\t\tattacker.stats.damageDealt += amount\n\t\tattacker.stats.hits += 1\n\tend\n\n\tlocal dir = info.dir or (attacker and Util.flat(victim.root.Position - attacker.root.Position)) or Vector3.zAxis\n\tlocal heavy = false\n\tif not wasDown then\n\t\tvictim.endurance -= info.downPower or 0\n\t\tif victim.hp > 0 and (info.forceDown or victim.endurance <= 0) then\n\t\t\tCombat.KnockDown(match, victim, attacker, dir)\n\t\t\theavy = true\n\t\telse\n\t\t\tif (info.knock or 0) > 0 or (info.up or 0) > 0 then\n\t\t\t\tapplyKnock(victim, dir, info.knock or 0, info.up or 0, 0.22)\n\t\t\tend\n\t\t\theavy = amount >= 70\n\t\tend\n\tend\n\n\tif t < victim.comboUntil then\n\t\tvictim.comboDamage += amount\n\telse\n\t\tvictim.comboDamage = amount\n\tend\n\tvictim.comboUntil = t + M.ComboWindow\n\n\tCombat.SyncAttributes(victim)\n\tmatch:FireAll(\"FX\", \"Hit\", {\n\t\tvictim = victim.model,\n\t\tattacker = attacker and attacker.model,\n\t\tpos = info.pos or Combat.AimPoint(victim),\n\t\tamount = amount,\n\t\tcombo = victim.comboDamage,\n\t\theavy = heavy,\n\t\tdown = wasDown,\n\t\tsource = info.source,\n\t})\n\n\tif victim.hp <= 0 then\n\t\tmatch:OnKO(victim, attacker)\n\tend\n\treturn true\nend\n\n----------------------------------------------------------------------------------------------\n-- Projectiles\n----------------------------------------------------------------------------------------------\nlocal function tipPos(c, attName: string): Vector3\n\tlocal att = c.model:FindFirstChild(attName, true)\n\tif att and att:IsA(\"Attachment\") then\n\t\treturn att.WorldPosition\n\tend\n\treturn c.root.Position\nend\n\nlocal function serializeProj(p)\n\treturn {\n\t\tid = p.id,\n\t\tkind = p.kind,\n\t\tstyle = p.style,\n\t\tpos = p.pos,\n\t\tdir = p.dir,\n\t\tspeed = p.speed,\n\t\tturn = p.turn,\n\t\taccel = p.accel,\n\t\tlife = p.life,\n\t\tsize = p.size,\n\t\tcolor = p.color,\n\t\ttarget = p.target and p.target.model,\n\t\towner = p.owner.model,\n\t\thoming = p.homing,\n\t\tstart = p.start,\n\t\tfinish = p.finish,\n\t\tflight = p.flight,\n\t\tapex = p.apex,\n\t\tfloorY = p.floorY,\n\t\thover = p.hover,\n\t\tclimb = p.climb,\n\t\tlaunchDir = p.launchDir,\n\t\tlaunchTime = p.launchTime,\n\t\tlaunchSpeed = p.launchSpeed,\n\t\tthrowTime = p.throwTime,\n\t\tarmTime = p.armTime,\n\t\tradius = p.blastRadius,\n\t\tt0 = p.t0,\n\t}\nend\n\nlocal function spawnProj(match, owner, p)\n\tmatch.nextProjId += 1\n\tp.id = match.nextProjId\n\tp.owner = owner\n\tp.age = 0\n\tp.t0 = now()\n\tmatch.projectiles[p.id] = p\n\tmatch:FireAll(\"FX\", \"Proj\", serializeProj(p))\n\treturn p\nend\n\nlocal function endProj(match, p, reason: string, pos: Vector3?)\n\tmatch.projectiles[p.id] = nil\n\tmatch:FireAll(\"FX\", \"ProjEnd\", { id = p.id, pos = pos or p.pos, reason = reason })\nend\n\nlocal function spawnBlast(match, owner, pos: Vector3, w, color: Color3)\n\tlocal b = {\n\t\towner = owner,\n\t\tpos = pos,\n\t\tradius = w.Radius,\n\t\tt0 = now(),\n\t\tuntilT = now() + (w.Linger or 0.6),\n\t\tdamage = w.Damage,\n\t\tdownPower = w.DownPower,\n\t\tknock = w.Knock,\n\t\tup = w.Up,\n\t\thit = {},\n\t\tsource = w.Name,\n\t}\n\ttable.insert(match.blasts, b)\n\tmatch:FireAll(\"FX\", \"Blast\", { pos = pos, radius = w.Radius, linger = w.Linger or 0.6, color = color, big = w.Radius >= 12 })\nend\n\nlocal function aimDir(c, from: Vector3, target): Vector3\n\tif target then\n\t\tlocal to = Combat.AimPoint(target) - from\n\t\tif to.Magnitude > 0.1 then\n\t\t\treturn to.Unit\n\t\tend\n\tend\n\treturn c.root.CFrame.LookVector\nend\n\nlocal function jitter(dir: Vector3, deg: number): Vector3\n\tif deg <= 0 then\n\t\treturn dir\n\tend\n\tlocal yaw = math.rad((math.random() * 2 - 1) * deg)\n\tlocal pitch = math.rad((math.random() * 2 - 1) * deg * 0.4)\n\treturn (CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0) * dir).Unit\nend\n\nlocal function fireBullet(match, c, target, spec, color: Color3, dir: Vector3, style: string?)\n\tlocal turnMul = c.aiTurnMul or 1\n\tspawnProj(match, c, {\n\t\tkind = \"Bullet\",\n\t\tstyle = style or \"Bullet\",\n\t\tpos = tipPos(c, \"GunTip\"),\n\t\tdir = dir,\n\t\tspeed = spec.Speed,\n\t\tturn = math.rad(spec.Turn) * turnMul,\n\t\taccel = spec.Accel,\n\t\tlife = spec.Life,\n\t\tradius = spec.Radius,\n\t\tsize = spec.Size or 0.9,\n\t\tcolor = color,\n\t\ttarget = target,\n\t\thoming = true,\n\t\tdamage = spec.Damage,\n\t\tdownPower = spec.DownPower,\n\t\tknock = spec.Knock,\n\t\tup = spec.Up,\n\t\tforceDown = spec.ForceDown,\n\t\tsource = style,\n\t})\nend\n\nlocal function onGunFired(match, c, gun)\n\tmatch:FireAll(\"FX\", \"Fire\", { model = c.model, weapon = \"Gun\", gunType = gun.Type, slow = gun.MoveSlow, slowTime = gun.SlowTime })\nend\n\nlocal function triggerGun(match, c)\n\tlocal gun = c.loadout.Gun\n\tlocal t = now()\n\tif gun.Type == \"Charge\" then\n\t\treturn\n\tend\n\tif t < c.gunReadyAt or t < c.reloadUntil or c.burstLeft > 0 then\n\t\treturn\n\tend\n\tif c.ammo <= 0 then\n\t\tc.ammo = gun.Clip\n\tend\n\tc.ammo -= 1\n\tc.gunReadyAt = t + gun.Cooldown\n\tif c.ammo <= 0 then\n\t\tc.reloadUntil = t + gun.Cooldown + gun.Reload\n\t\tc.ammo = gun.Clip\n\t\tc.gunReadyAt = c.reloadUntil\n\tend\n\tlocal target = Combat.GetTarget(match, c)\n\tif gun.Type == \"Burst\" then\n\t\tc.burstLeft = gun.Shots\n\t\tc.nextShotAt = t\n\telseif gun.Type == \"Spread\" then\n\t\tlocal from = tipPos(c, \"GunTip\")\n\t\tlocal base = jitter(aimDir(c, from, target), c.aiAimError or 0)\n\t\tlocal n = gun.Pellets\n\t\tfor i = 1, n do\n\t\t\tlocal a = math.rad(-gun.SpreadDeg / 2 + gun.SpreadDeg * (i - 1) / math.max(1, n - 1))\n\t\t\tfireBullet(match, c, target, gun, gun.Color, (CFrame.Angles(0, a, 0) * base).Unit, \"Pellet\")\n\t\tend\n\t\tonGunFired(match, c, gun)\n\tend\n\tCombat.SyncAttributes(c)\nend\n\nlocal function releaseCharge(match, c)\n\tlocal gun = c.loadout.Gun\n\tlocal t = now()\n\tlocal started = c.chargeStart\n\tc.chargeStart = nil\n\tmatch:FireAll(\"FX\", \"Charge\", { model = c.model, on = false })\n\tif not started or t < c.gunReadyAt then\n\t\treturn\n\tend\n\tlocal full = (t - started) >= gun.ChargeTime\n\tlocal spec = full and gun.Full or gun.Tap\n\tlocal target = Combat.GetTarget(match, c)\n\tlocal from = tipPos(c, \"GunTip\")\n\tfireBullet(match, c, target, spec, gun.Color, jitter(aimDir(c, from, target), c.aiAimError or 0), full and \"Beam\" or \"Bolt\")\n\tc.gunReadyAt = t + gun.Cooldown\n\tonGunFired(match, c, gun)\n\tCombat.SyncAttributes(c)\nend\n\nlocal function fireBomb(match, c)\n\tlocal bomb = c.loadout.Bomb\n\tlocal t = now()\n\tif t < c.bombReadyAt then\n\t\treturn\n\tend\n\tc.bombReadyAt = t + bomb.Cooldown\n\tlocal target = Combat.GetTarget(match, c)\n\tlocal from = tipPos(c, \"BombTip\")\n\tlocal myFlat = Util.flat(c.root.Position)\n\tlocal aim\n\tif target then\n\t\tlocal tv = Util.flat(target.root.AssemblyLinearVelocity)\n\t\taim = Util.flat(target.root.Position) + tv * bomb.FlightTime * bomb.Lead\n\t\tif c.aiAimError then\n\t\t\taim += Vector3.new(math.random() * 2 - 1, 0, math.random() * 2 - 1) * c.aiAimError * 0.6\n\t\tend\n\telse\n\t\taim = myFlat + Util.flatUnit(c.root.CFrame.LookVector) * 30\n\tend\n\tlocal off = aim - myFlat\n\tlocal dist = math.clamp(off.Magnitude, bomb.MinRange, bomb.MaxRange)\n\tlocal fwd = Util.flatUnit(off, Util.flatUnit(c.root.CFrame.LookVector))\n\tlocal right = Vector3.new(-fwd.Z, 0, fwd.X)\n\tfor i = 1, bomb.Count do\n\t\tlocal lateral = (i - (bomb.Count + 1) / 2) * bomb.Spread\n\t\tlocal land = myFlat + fwd * dist + right * lateral\n\t\tland = Vector3.new(land.X, match.floorY, land.Z)\n\t\tlocal hit = workspace:Raycast(land + Vector3.new(0, 40, 0), Vector3.new(0, -60, 0), match.rayParams)\n\t\tif hit then\n\t\t\tland = hit.Position\n\t\tend\n\t\tspawnProj(match, c, {\n\t\t\tkind = \"Bomb\",\n\t\t\tpos = from,\n\t\t\tstart = from,\n\t\t\tfinish = land,\n\t\t\tflight = bomb.FlightTime * (0.85 + 0.15 * dist / bomb.MaxRange),\n\t\t\tapex = bomb.Apex + math.max(0, from.Y - land.Y) * 0.25,\n\t\t\tlife = bomb.FlightTime + 1,\n\t\t\tsize = 1.6 + bomb.Radius * 0.06,\n\t\t\tcolor = bomb.Color,\n\t\t\tradius = 2.2,\n\t\t\tblast = bomb,\n\t\t})\n\tend\n\tmatch:FireAll(\"FX\", \"Fire\", { model = c.model, weapon = \"Bomb\", slow = 0.2, slowTime = bomb.Stall })\n\tCombat.SyncAttributes(c)\nend\n\nlocal function activePods(match, c): number\n\tlocal n = 0\n\tfor _, p in pairs(match.projectiles) do\n\t\tif p.owner == c and POD_KINDS[p.kind] then\n\t\t\tn += 1\n\t\tend\n\tend\n\treturn n\nend\n\nlocal function firePod(match, c)\n\tlocal pod = c.loadout.Pod\n\tlocal t = now()\n\tif t < c.podReadyAt or activePods(match, c) + pod.Count > pod.MaxActive then\n\t\treturn\n\tend\n\tc.podReadyAt = t + pod.Cooldown\n\tlocal target = Combat.GetTarget(match, c)\n\tlocal from = tipPos(c, \"PodTip\")\n\tlocal fwd = target and Util.flatUnit(target.root.Position - c.root.Position) or Util.flatUnit(c.root.CFrame.LookVector)\n\tlocal right = Vector3.new(-fwd.Z, 0, fwd.X)\n\tlocal common = {\n\t\tsize = pod.Size,\n\t\tcolor = pod.Color,\n\t\ttarget = target,\n\t\tlife = pod.Life,\n\t\tradius = pod.TriggerRadius,\n\t\tblast = pod,\n\t\tblastRadius = pod.Radius,\n\t}\n\tlocal function spawnOne(extra)\n\t\tlocal p = table.clone(common)\n\t\tfor k, v in pairs(extra) do\n\t\t\tp[k] = v\n\t\tend\n\t\tspawnProj(match, c, p)\n\tend\n\tif pod.Type == \"Seeker\" then\n\t\tspawnOne({\n\t\t\tkind = \"Seeker\",\n\t\t\tpos = from,\n\t\t\tdir = fwd,\n\t\t\tspeed = pod.Speed,\n\t\t\tturn = math.rad(pod.Turn),\n\t\t\tfloorY = match.floorY,\n\t\t\thover = pod.HoverHeight,\n\t\t\tclimb = pod.ClimbRate,\n\t\t})\n\telseif pod.Type == \"Mine\" then\n\t\tlocal land = Util.flat(c.root.Position) + fwd * pod.ThrowDist\n\t\tland = Vector3.new(land.X, match.floorY + 0.9, land.Z)\n\t\tlocal hit = workspace:Raycast(land + Vector3.new(0, 30, 0), Vector3.new(0, -50, 0), match.rayParams)\n\t\tif hit then\n\t\t\tland = hit.Position + Vector3.new(0, 0.9, 0)\n\t\tend\n\t\tspawnOne({\n\t\t\tkind = \"Mine\",\n\t\t\tpos = from,\n\t\t\tstart = from,\n\t\t\tfinish = land,\n\t\t\tthrowTime = pod.ThrowTime,\n\t\t\tarmTime = pod.ArmTime,\n\t\t})\n\telseif pod.Type == \"Orbit\" then\n\t\tfor _, s in ipairs({ -1, 1 }) do\n\t\t\tspawnOne({\n\t\t\t\tkind = \"Orbit\",\n\t\t\t\tpos = from,\n\t\t\t\tdir = fwd,\n\t\t\t\tspeed = pod.Speed,\n\t\t\t\tturn = math.rad(pod.Turn),\n\t\t\t\tlaunchDir = (right * s + Vector3.new(0, 0.35, 0)).Unit,\n\t\t\t\tlaunchTime = pod.LaunchTime,\n\t\t\t\tlaunchSpeed = pod.LaunchSide / pod.LaunchTime,\n\t\t\t})\n\t\tend\n\tend\n\tmatch:FireAll(\"FX\", \"Fire\", { model = c.model, weapon = \"Pod\", slow = 0.6, slowTime = 0.2 })\n\tCombat.SyncAttributes(c)\nend\n\n----------------------------------------------------------------------------------------------\n-- Intents (from player clients via Main, or from BotAI)\n----------------------------------------------------------------------------------------------\nfunction Combat.HandleIntent(match, c, action: string, payload)\n\tif not match or not c or not c.alive then\n\t\treturn\n\tend\n\tif action == \"GunUp\" then\n\t\tc.gunHeld = false\n\t\tif c.chargeStart then\n\t\t\tif canAct(match, c) then\n\t\t\t\treleaseCharge(match, c)\n\t\t\telse\n\t\t\t\tc.chargeStart = nil\n\t\t\tend\n\t\tend\n\t\treturn\n\tend\n\tif not canAct(match, c) then\n\t\treturn\n\tend\n\tlocal t = now()\n\tif action == \"GunDown\" then\n\t\tc.gunHeld = true\n\t\tif c.loadout.Gun.Type == \"Charge\" then\n\t\t\tif not c.chargeStart and t >= c.gunReadyAt - 0.05 then\n\t\t\t\tc.chargeStart = t\n\t\t\t\tmatch:FireAll(\"FX\", \"Charge\", { model = c.model, on = true, chargeTime = c.loadout.Gun.ChargeTime })\n\t\t\tend\n\t\telse\n\t\t\ttriggerGun(match, c)\n\t\tend\n\telseif action == \"Bomb\" then\n\t\tfireBomb(match, c)\n\telseif action == \"Pod\" then\n\t\tfirePod(match, c)\n\telseif action == \"Dash\" then\n\t\tif t - c.lastDashIntent < 0.18 then\n\t\t\treturn\n\t\tend\n\t\tc.lastDashIntent = t\n\t\tlocal dir = typeof(payload) == \"table\" and typeof(payload.dir) == \"Vector3\" and payload.dir or c.root.CFrame.LookVector\n\t\tc.dashDir = Util.flatUnit(dir, Util.flatUnit(c.root.CFrame.LookVector))\n\t\tc.dashUntil = t + math.max(c.loadout.Legs.DashTime, c.loadout.Legs.AirDashTime) + 0.08\n\t\tc.dashHit = {}\n\t\tmatch:FireAll(\"FX\", \"Dash\", { model = c.model, air = typeof(payload) == \"table\" and payload.air == true })\n\tend\nend\n\n----------------------------------------------------------------------------------------------\n-- Per-frame step\n----------------------------------------------------------------------------------------------\nlocal function capsule(c): (Vector3, Vector3)\n\tlocal p = c.root.Position\n\treturn p - Vector3.new(0, c.info.capDown, 0), p + Vector3.new(0, c.info.capUp, 0)\nend\n\nlocal function distToCapsule(c, a: Vector3, b: Vector3): number\n\tlocal lo, hi = capsule(c)\n\treturn Util.segSegDist(a, b, lo, hi) - c.info.hitRadius\nend\n\nlocal function explodePod(match, p)\n\tendProj(match, p, \"explode\", p.pos)\n\tspawnBlast(match, p.owner, p.pos, p.blast, p.color)\nend\n\nlocal function stepProjectiles(match, dt: number, t: number)\n\tfor _, p in pairs(match.projectiles) do\n\t\tlocal target = p.target\n\t\tlocal tpos = (target and target.alive and target.root) and Combat.AimPoint(target) or nil\n\t\tlocal prev = Sim.step(p, dt, tpos)\n\t\tlocal kind = p.kind\n\t\tlocal owner = p.owner\n\n\t\tif kind == \"Bullet\" then\n\t\t\tlocal seg = p.pos - prev\n\t\t\tlocal wall = seg.Magnitude > 0 and workspace:Raycast(prev, seg, match.rayParams)\n\t\t\tlocal hitC, hitDist = nil, math.huge\n\t\t\tfor _, e in ipairs(match.combatants) do\n\t\t\t\tif e ~= owner and e.alive and e.team ~= owner.team and not isInvulnerable(e, t) then\n\t\t\t\t\tlocal d = distToCapsule(e, prev, p.pos) - p.radius\n\t\t\t\t\tif d <= 0 then\n\t\t\t\t\t\tlocal along = (e.root.Position - prev).Magnitude\n\t\t\t\t\t\tif along < hitDist then\n\t\t\t\t\t\t\thitC, hitDist = e, along\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\tif hitC and (not wall or (wall.Position - prev).Magnitude >= hitDist - 1) then\n\t\t\t\tendProj(match, p, \"hit\", p.pos)\n\t\t\t\tCombat.Damage(match, hitC, p.damage, owner, {\n\t\t\t\t\tdownPower = p.downPower,\n\t\t\t\t\tknock = p.knock,\n\t\t\t\t\tup = p.up,\n\t\t\t\t\tforceDown = p.forceDown,\n\t\t\t\t\tdir = Util.flat(p.dir),\n\t\t\t\t\tpos = p.pos,\n\t\t\t\t\tsource = p.source,\n\t\t\t\t})\n\t\t\telseif wall then\n\t\t\t\tendProj(match, p, \"wall\", wall.Position)\n\t\t\telseif p.age >= p.life then\n\t\t\t\tendProj(match, p, \"expire\", p.pos)\n\t\t\tend\n\t\telseif kind == \"Bomb\" then\n\t\t\tlocal direct = false\n\t\t\tfor _, e in ipairs(match.combatants) do\n\t\t\t\tif e ~= owner and e.alive and e.team ~= owner.team and not isInvulnerable(e, t) then\n\t\t\t\t\tif distToCapsule(e, prev, p.pos) <= p.radius then\n\t\t\t\t\t\tdirect = true\n\t\t\t\t\t\tbreak\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\tif direct or p.landed then\n\t\t\t\tendProj(match, p, \"explode\", p.pos)\n\t\t\t\tspawnBlast(match, owner, p.pos, p.blast, p.color)\n\t\t\tend\n\t\telseif kind == \"Seeker\" or kind == \"Orbit\" then\n\t\t\tlocal seg = p.pos - prev\n\t\t\tlocal wall = seg.Magnitude > 0 and workspace:Raycast(prev, seg, match.rayParams)\n\t\t\tlocal triggered = false\n\t\t\tfor _, e in ipairs(match.combatants) do\n\t\t\t\tif e ~= owner and e.alive and e.team ~= owner.team and not isInvulnerable(e, t) then\n\t\t\t\t\tif distToCapsule(e, prev, p.pos) <= p.radius then\n\t\t\t\t\t\ttriggered = true\n\t\t\t\t\t\tbreak\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\tif wall and not triggered then\n\t\t\t\tp.pos = wall.Position + wall.Normal * 0.5\n\t\t\tend\n\t\t\tif triggered or wall or p.age >= p.life then\n\t\t\t\texplodePod(match, p)\n\t\t\tend\n\t\telseif kind == \"Mine\" then\n\t\t\tlocal armed = p.landed and p.age >= p.throwTime + p.armTime\n\t\t\tlocal triggered = false\n\t\t\tif armed then\n\t\t\t\tfor _, e in ipairs(match.combatants) do\n\t\t\t\t\tif e ~= owner and e.alive and e.team ~= owner.team and not isInvulnerable(e, t) then\n\t\t\t\t\t\tif (e.root.Position - p.pos).Magnitude - e.info.hitRadius <= p.radius then\n\t\t\t\t\t\t\ttriggered = true\n\t\t\t\t\t\t\tbreak\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\tif triggered or p.age >= p.life then\n\t\t\t\texplodePod(match, p)\n\t\t\tend\n\t\tend\n\tend\n\n\t-- Periodic position sync for slow, long-lived pods so client visuals don't drift.\n\tif t - (match.lastPodSync or 0) > 0.25 then\n\t\tmatch.lastPodSync = t\n\t\tlocal sync = {}\n\t\tfor id, p in pairs(match.projectiles) do\n\t\t\tif p.kind == \"Seeker\" or p.kind == \"Orbit\" then\n\t\t\t\ttable.insert(sync, { id, p.pos, p.dir })\n\t\t\tend\n\t\tend\n\t\tif #sync > 0 then\n\t\t\tmatch:FireAll(\"FX\", \"ProjSync\", sync)\n\t\tend\n\tend\nend\n\nlocal function stepBlasts(match, t: number)\n\tlocal i = 1\n\tlocal blasts = match.blasts\n\twhile i <= #blasts do\n\t\tlocal b = blasts[i]\n\t\tif t >= b.untilT then\n\t\t\ttable.remove(blasts, i)\n\t\telse\n\t\t\tlocal grow = math.clamp((t - b.t0) / 0.15, 0.45, 1)\n\t\t\tlocal r = b.radius * grow\n\t\t\tfor _, e in ipairs(match.combatants) do\n\t\t\t\tif not b.hit[e] and e ~= b.owner and e.alive and e.team ~= b.owner.team and not isInvulnerable(e, t) then\n\t\t\t\t\tlocal lo, hi = capsule(e)\n\t\t\t\t\tlocal d = Util.segSegDist(b.pos, b.pos, lo, hi) - e.info.hitRadius\n\t\t\t\t\tif d <= r then\n\t\t\t\t\t\tb.hit[e] = true\n\t\t\t\t\t\tCombat.Damage(match, e, b.damage, b.owner, {\n\t\t\t\t\t\t\tdownPower = b.downPower,\n\t\t\t\t\t\t\tknock = b.knock,\n\t\t\t\t\t\t\tup = b.up,\n\t\t\t\t\t\t\tdir = Util.flat(e.root.Position - b.pos),\n\t\t\t\t\t\t\tpos = Combat.AimPoint(e),\n\t\t\t\t\t\t\tsource = b.source,\n\t\t\t\t\t\t})\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\ti += 1\n\t\tend\n\tend\nend\n\nlocal function stepCombatant(match, c, dt: number, t: number)\n\tif not c.alive or not c.root or not c.root.Parent then\n\t\treturn\n\tend\n\tlocal gun = c.loadout.Gun\n\n\t-- Down -> Rebirth -> Normal\n\tif c.state == \"Down\" and t >= c.stateUntil then\n\t\tsetState(c, \"Rebirth\", t + M.RebirthTime)\n\t\tc.invulnUntil = t + M.RebirthTime\n\t\tCombat.SyncAttributes(c)\n\t\tmatch:FireAll(\"FX\", \"Rebirth\", { model = c.model })\n\telseif c.state == \"Rebirth\" and t >= c.stateUntil then\n\t\tsetState(c, \"Normal\", 0)\n\tend\n\n\t-- Endurance regen\n\tif c.state ~= \"Down\" and c.endurance < M.EnduranceMax and t - c.lastHitAt > M.EnduranceRegenDelay then\n\t\tlocal before = math.ceil(c.endurance / M.EndurancePerPip)\n\t\tc.endurance = math.min(M.EnduranceMax, c.endurance + M.EnduranceRegenRate * dt)\n\t\tif math.ceil(c.endurance / M.EndurancePerPip) ~= before then\n\t\t\tCombat.SyncAttributes(c)\n\t\tend\n\tend\n\n\tif match.state ~= \"Fight\" then\n\t\treturn\n\tend\n\n\t-- Burst fire + held trigger auto-repeat\n\tif c.burstLeft > 0 and t >= c.nextShotAt and c.state ~= \"Down\" then\n\t\tlocal target = Combat.GetTarget(match, c)\n\t\tlocal from = tipPos(c, \"GunTip\")\n\t\tfireBullet(match, c, target, gun, gun.Color, jitter(aimDir(c, from, target), c.aiAimError or 0), \"Bullet\")\n\t\tif c.burstLeft == gun.Shots then\n\t\t\tonGunFired(match, c, gun)\n\t\tend\n\t\tc.burstLeft -= 1\n\t\tc.nextShotAt = t + gun.ShotInterval\n\tend\n\tif c.gunHeld and gun.Type ~= \"Charge\" and c.state ~= \"Down\" then\n\t\ttriggerGun(match, c)\n\tend\n\n\t-- Body dash attack\n\tif t < c.dashUntil and t - c.lastDashHitAt > 0.6 then\n\t\tfor _, e in ipairs(match.combatants) do\n\t\t\tif e ~= c and e.alive and e.team ~= c.team and not c.dashHit[e] and not isInvulnerable(e, t) then\n\t\t\t\tlocal d = (Util.flat(e.root.Position - c.root.Position)).Magnitude\n\t\t\t\tlocal dy = math.abs(e.root.Position.Y - c.root.Position.Y)\n\t\t\t\tif d <= c.info.hitRadius + e.info.hitRadius + 1.0 and dy < 5 then\n\t\t\t\t\tc.dashHit[e] = true\n\t\t\t\t\tc.lastDashHitAt = t\n\t\t\t\t\tlocal da = c.loadout.Body.DashAttack\n\t\t\t\t\tCombat.Damage(match, e, da.Damage, c, {\n\t\t\t\t\t\tdownPower = da.DownPower,\n\t\t\t\t\t\tknock = da.Knock,\n\t\t\t\t\t\tup = da.Up,\n\t\t\t\t\t\tdir = c.dashDir,\n\t\t\t\t\t\tpos = Combat.AimPoint(e),\n\t\t\t\t\t\tsource = da.Name,\n\t\t\t\t\t})\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\n\t-- Pits\n\tif c.root.Position.Y < match.floorY - M.PitFallDepth then\n\t\tc.hp = math.max(0, c.hp - M.PitDamage)\n\t\tc.stats.damageTaken += M.PitDamage\n\t\tc.invulnUntil = t + M.PitInvuln\n\t\tc.model:PivotTo(c.spawnCF * CFrame.new(0, c.info.rootY + 8, 0))\n\t\tc.root.AssemblyLinearVelocity = Vector3.zero\n\t\tif c.participant.kind == \"Player\" and c.participant.player.Parent then\n\t\t\tmatch.remotes.Match:FireClient(c.participant.player, \"Teleported\")\n\t\telseif c.mover then\n\t\t\tc.mover:ResetVelocity()\n\t\tend\n\t\tCombat.SyncAttributes(c)\n\t\tmatch:FireAll(\"FX\", \"Pit\", { model = c.model, amount = M.PitDamage })\n\t\tif c.hp <= 0 then\n\t\t\tmatch:OnKO(c, nil)\n\t\tend\n\tend\nend\n\nfunction Combat.Step(match, dt: number)\n\tlocal t = now()\n\tfor _, c in ipairs(match.combatants) do\n\t\tstepCombatant(match, c, dt, t)\n\tend\n\tif match.state == \"Fight\" then\n\t\tstepProjectiles(match, dt, t)\n\t\tstepBlasts(match, t)\n\tend\nend\n\nfunction Combat.ClearProjectiles(match)\n\tmatch.projectiles = {}\n\tmatch.blasts = {}\n\tmatch:FireAll(\"FX\", \"ClearProj\", {})\nend\n\nreturn Combat\n","message":"Wrote contents to /Users/chase-mini/src/rca-work/src/ServerScriptService/RoboClash/CombatService.luau"}}},"hookAdditionalContexts":[],"toolCallId":"toolu_013LevKPBdMnuj2kdewiA8C6","startedAtMs":"1791073728541","completedAtMs":"1791073809797"},"model_call_id":"f6f75537-51d9-46fb-a6c9-81f06ac674d8-42-boz8","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791073809846}
