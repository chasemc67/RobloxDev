hen\n\t\tMatchService.LeaveResults(player)\n\tend\n\tif indexOf(player) then\n\t\treturn true\n\tend\n\ts.status = \"Queue\"\n\ttable.insert(Matchmaking.queue, { player = player })\n\ttryPair()\n\treturn true\nend\n\nfunction Matchmaking.Dequeue(player: Player)\n\tlocal i = indexOf(player)\n\tif i then\n\t\ttable.remove(Matchmaking.queue, i)\n\tend\n\tlocal s = MatchService.sessions[player]\n\tif s and s.status == \"Queue\" then\n\t\ts.status = \"Menu\"\n\tend\n\tMatchService.Send(player, \"Queue\", { inQueue = false })\n\tMatchmaking.Broadcast()\nend\n\n-- Test harness only: enqueue a fake opponent that becomes a bot participant in a PvP-mode match.\nPlayers.PlayerRemoving:Connect(function(player)\n\tlocal i = indexOf(player)\n\tif i then\n\t\ttable.remove(Matchmaking.queue, i)\n\t\tMatchmaking.Broadcast()\n\tend\nend)\n\nreturn Matchmaking\n","message":"The file /Users/chase-mini/src/rca-work/src/ServerScriptService/RoboClash/MatchmakingService.luau has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"toolu_01YVSsN4qhEmBncZzmTveCCT","startedAtMs":"1791076652938","completedAtMs":"1791076655912"},"model_call_id":"9f87d2a3-a097-4b92-978f-ec64b826b4ce-131-s8zp","session_id":"cdeac534-366f-4359-ab90-975d2829fcb2","timestamp_ms":1791076655917}
